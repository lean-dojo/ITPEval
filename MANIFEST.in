prune data
prune eval/data
prune eval/subsets
prune corpus-extension
prune images
prune itpeval/_toolchains
prune itpeval/.downloads
prune itpeval/.runs
recursive-include docs *.md
recursive-include examples/prover-adapters/sprig *.py *.sh *.json
recursive-include examples/prover-adapters/drat *.py *.json *.cnf *.drat
recursive-include benchmarks/runtime *.py
include benchmarks/runtime/linux-x86_64.jsonl benchmarks/runtime/library-linux-x86_64.jsonl
include benchmarks/runtime/cache-latency.json benchmarks/runtime/metamath-verifiers.json benchmarks/runtime/hol4-theories.json
include benchmarks/runtime/scalability-*.json
include benchmarks/runtime/document-checkpoints.jsonl
include benchmarks/runtime/atp-pilot.json benchmarks/runtime/lock-validation-optimization.json
include benchmarks/runtime/retrieval-index-optimization.json
include benchmarks/runtime/metamath-compact-extraction.json
include benchmarks/runtime/hol-light-branch-fork-pilot.json benchmarks/runtime/stable-extraction.json
include benchmarks/runtime/hol-light-worker.json
include benchmarks/runtime/external-adapter-sprig.json
include benchmarks/runtime/detached-drat.json benchmarks/runtime/mixed-scheduler.json
include benchmarks/runtime/pvs-proof-sessions.json
include benchmarks/runtime/lean-horn-auto.json
include benchmarks/runtime/rocq-horn-auto.json benchmarks/runtime/native-proof-driver.json benchmarks/runtime/pvs-action-restore.json
include benchmarks/runtime/atp-from-session.json benchmarks/runtime/acl2-metamath-action-restore.json
include benchmarks/runtime/rocq-action-restore.json
include benchmarks/runtime/lean-action-restore.json benchmarks/runtime/hol-automation.json
include benchmarks/runtime/native-search.json
include benchmarks/runtime/metamath-search-forks.json
include benchmarks/runtime/agda-horn.json benchmarks/runtime/lean-rocq-forks.json benchmarks/runtime/proof-portfolios.json
include benchmarks/runtime/interaction-capabilities.jsonl
recursive-include benchmarks/runtime/startup-linux-x86_64 *.json
prune benchmarks/runtime/evidence
exclude benchmarks/runtime/qualification.jsonl
recursive-include scripts *.py
include eval/benchmark-lock.json
global-exclude *.pyc
