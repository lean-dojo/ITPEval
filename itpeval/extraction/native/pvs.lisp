(in-package :pvs)

;; Each row is a list of UTF-8 strings. Hex encoding preserves multiline PVS
;; expressions without depending on a JSON library in the saved Lisp image.
(defun itpeval-row (stream &rest fields)
  (loop for field in fields for i from 0 do
    (unless (zerop i) (write-char #\Tab stream))
    (loop for octet across (sb-ext:string-to-octets (princ-to-string field)
                                                   :external-format :utf-8)
          do (format stream "~2,'0x" octet)))
  (terpri stream))

(defun itpeval-position (obj)
  (let ((position (and obj (or (place obj)
                               (and (tcc-decl? obj) (origin obj) (place (origin obj)))))))
    (if position (format nil "~{~d ~}" (coerce position 'list)) "")))

(defun itpeval-theory (theory seen stream)
  (unless (or (gethash theory seen) (from-prelude? theory)
              (lib-datatype-or-theory? theory))
    (setf (gethash theory seen) t)
    (let* ((*current-context* (saved-context theory))
           (name (id theory))
           (file (filename theory))
           (parents (get-immediate-usings theory)))
      (dolist (use parents)
        (let ((th (get-theory use)))
          (when th (itpeval-theory th seen stream))))
      (apply #'itpeval-row stream "theory" name file
             (mapcan (lambda (use)
                       ;; Preserve both the instantiated import and its resolved
                       ;; declaring theory. They can have different spellings.
                       (let ((parent (get-theory use)))
                         (list (unparse use :string t) (if parent (id parent) "") (itpeval-position use))))
                     parents))
      ;; Evaluate each parent's EXPORTING clause from the receiving theory.
      ;; The default re-exports its transitive imports. Formal parameters,
      ;; variables and generated TCCs stay local.
      (let ((candidates (remove-if-not (lambda (d) (and (declaration? d) (id d)
                                  (not (formal-decl? d)) (not (var-decl? d)) (not (tcc-decl? d))))
                              (all-decls theory))))
        (dolist (use parents)
          (let* ((parent (get-theory use)) (seen-decls (and parent (gethash parent seen))))
            (when (listp seen-decls)
              (dolist (d seen-decls)
                (when (exportable? d parent)
                  (pushnew d candidates :test #'eq)
                  (itpeval-row stream "visible-import" name (unparse use :string t)
                               (id (module d)) (id d) (itpeval-position d)))))))
        (setf (gethash theory seen) candidates))
      (dolist (formal (formals-sans-usings theory))
        (itpeval-row stream "parameter" name (id formal) (class-name (class-of formal))
                     (unparse-decl formal) (itpeval-position formal)))
      (dolist (decl (all-decls theory))
        (when (and (declaration? decl) (id decl))
          (let* ((tcc (tcc-decl? decl))
                 (origin (and tcc (origin decl)))
                 (pos (or (place decl) (and origin (place origin))))
                 (owner (and tcc (generated-by decl))))
            (apply #'itpeval-row stream "decl" name (id decl)
                         (class-name (class-of decl)) (unparse-decl decl)
                         (if (and (formula-decl? decl) (spelling decl))
                             (spelling decl) "")
                         (if pos (format nil "~{~d ~}" (coerce pos 'list)) "")
                         (cond ((and owner (declaration? owner)) (id owner))
                               ((and origin (root origin)) (root origin)) (t ""))
                         (itpeval-position (and (declaration? owner) owner))
                         (mapcar (lambda (arg) (unparse arg :string t))
                                 (append (decl-formals decl) (apply #'append (formals decl)))))
            (dolist (ref (refers-to decl))
              (when (and (declaration? ref) (id ref) (module ref))
                (itpeval-row stream "reference" name (id decl) (itpeval-position decl)
                             (id (module ref)) (id ref) (itpeval-position ref))))))))))

(defun itpeval-extract ()
  (let ((seen (make-hash-table :test #'eq)))
    (with-open-file (stream (sb-ext:posix-getenv "ITPEVAL_OUTPUT") :direction :output
                            :if-exists :error)
      (dolist (theory (typecheck-file (sb-ext:posix-getenv "ITPEVAL_ENTRY") t))
        (itpeval-theory theory seen stream))
      (itpeval-row stream "done"))))
