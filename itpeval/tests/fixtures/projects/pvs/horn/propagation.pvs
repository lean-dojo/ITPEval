propagation: THEORY
BEGIN
  % This subtype generates a separate type-correctness condition.
  twice(n: int): {x: int | x = 2*n} = n + n
  %|- twice_TCC1 : PROOF
  %|- (grind)
  %|- QED

  % Either conclusion follows from the local facts alone.
  transitive_local: LEMMA FORALL (p,q,r: bool):
    ((p IMPLIES q) AND (q IMPLIES r) AND p) IMPLIES (q AND r)
  %|- transitive_local : PROOF
  %|- (then (skosimp) (split 1) (grind))
  %|- QED
END propagation
