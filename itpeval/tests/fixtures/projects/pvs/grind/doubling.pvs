doubling: THEORY
BEGIN
  % The subtype checks that the implementation returns exactly twice n.
  twice(n: int): {x: int | x = 2*n} = n + n
  %|- twice_TCC1 : PROOF
  %|- (grind)
  %|- QED

  nonnegative_twice: LEMMA FORALL (n: int):
    n >= 0 IMPLIES twice(n) >= 0 AND twice(n)+1 > 0
  %|- nonnegative_twice : PROOF
  %|- (then (skosimp) (split) (grind))
  %|- QED
END doubling
