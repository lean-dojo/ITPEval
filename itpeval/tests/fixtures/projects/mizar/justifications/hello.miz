environ
 vocabularies TARSKI, XBOOLE_0;
 notations TARSKI, XBOOLE_0;
 constructors TARSKI, XBOOLE_0;
 theorems TARSKI, XBOOLE_1;

begin

:: Name the library rule so the following theorem can refer to it locally.
theorem Th1: for X,Y,Z being set holds
  X c= Y & Y c= Z implies X c= Z by XBOOLE_1:1;

theorem Th2: for X,Y,Z being set holds
  X c= Y & Y c= Z implies X c= Z by Th1;
