:: Statement-only formalization of the Babel-formal topic lattice_like. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, ZFMISC_1,
    FUNCT_1, FUNCT_2, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

reserve C for non empty set;
reserve R for Relation of C;
reserve o,o9 for BinOp of C;
reserve a,b,c,x,y,z for Element of C;

:: inf_comm
::$P-
theorem
  for C being non empty set,
      R being Relation of C,
      o,o9 being BinOp of C,
      a,b being Element of C
  st
    (for x being Element of C holds [x,x] in R) &
    (for x,y,z being Element of C
      st [x,y] in R & [y,z] in R
      holds [x,z] in R) &
    (for x,y being Element of C
      st [x,y] in R & [y,x] in R
      holds x = y) &
    (for a,b being Element of C holds [o.(a,b),a] in R) &
    (for a,b being Element of C holds [o.(a,b),b] in R) &
    (for c,a,b being Element of C
      st [c,a] in R & [c,b] in R
      holds [c,o.(a,b)] in R) &
    (for a,b being Element of C holds [a,o9.(a,b)] in R) &
    (for a,b being Element of C holds [b,o9.(a,b)] in R) &
    (for a,b,c being Element of C
      st [a,c] in R & [b,c] in R
      holds [o9.(a,b),c] in R)
  holds o.(a,b) = o.(b,a)
proof
end;
::$P+

:: sup_comm
::$P-
theorem
  for C being non empty set,
      R being Relation of C,
      o,o9 being BinOp of C,
      a,b being Element of C
  st
    (for x being Element of C holds [x,x] in R) &
    (for x,y,z being Element of C
      st [x,y] in R & [y,z] in R
      holds [x,z] in R) &
    (for x,y being Element of C
      st [x,y] in R & [y,x] in R
      holds x = y) &
    (for x,y being Element of C holds [o.(x,y),x] in R) &
    (for x,y being Element of C holds [o.(x,y),y] in R) &
    (for z,x,y being Element of C
      st [z,x] in R & [z,y] in R
      holds [z,o.(x,y)] in R) &
    (for x,y being Element of C holds [x,o9.(x,y)] in R) &
    (for x,y being Element of C holds [y,o9.(x,y)] in R) &
    (for x,y,z being Element of C
      st [x,z] in R & [y,z] in R
      holds [o9.(x,y),z] in R)
  holds o9.(a,b) = o9.(b,a)
proof
end;
::$P+

:: inf_assoc
::$P-
theorem
  for C being non empty set,
      R being Relation of C,
      o,o9 being BinOp of C,
      a,b,c being Element of C
  st
    (for x being Element of C holds [x,x] in R) &
    (for x,y,z being Element of C
      st [x,y] in R & [y,z] in R
      holds [x,z] in R) &
    (for x,y being Element of C
      st [x,y] in R & [y,x] in R
      holds x = y) &
    (for x,y being Element of C holds [o.(x,y),x] in R) &
    (for x,y being Element of C holds [o.(x,y),y] in R) &
    (for z,x,y being Element of C
      st [z,x] in R & [z,y] in R
      holds [z,o.(x,y)] in R) &
    (for x,y being Element of C holds [x,o9.(x,y)] in R) &
    (for x,y being Element of C holds [y,o9.(x,y)] in R) &
    (for x,y,z being Element of C
      st [x,z] in R & [y,z] in R
      holds [o9.(x,y),z] in R)
  holds o.(o.(a,b),c) = o.(a,o.(b,c))
proof
end;
::$P+

:: sup_assoc
::$P-
theorem
  for C being non empty set,
      R being Relation of C,
      o,o9 being BinOp of C,
      a,b,c being Element of C
  st
    (for x being Element of C holds [x,x] in R) &
    (for x,y,z being Element of C
      st [x,y] in R & [y,z] in R
      holds [x,z] in R) &
    (for x,y being Element of C
      st [x,y] in R & [y,x] in R
      holds x = y) &
    (for x,y being Element of C holds [o.(x,y),x] in R) &
    (for x,y being Element of C holds [o.(x,y),y] in R) &
    (for z,x,y being Element of C
      st [z,x] in R & [z,y] in R
      holds [z,o.(x,y)] in R) &
    (for x,y being Element of C holds [x,o9.(x,y)] in R) &
    (for x,y being Element of C holds [y,o9.(x,y)] in R) &
    (for x,y,z being Element of C
      st [x,z] in R & [y,z] in R
      holds [o9.(x,y),z] in R)
  holds o9.(o9.(a,b),c) = o9.(a,o9.(b,c))
proof
end;
::$P+

:: inf_absorption
::$P-
theorem
  for C being non empty set,
      R being Relation of C,
      o,o9 being BinOp of C,
      a,b being Element of C
  st
    (for x being Element of C holds [x,x] in R) &
    (for x,y,z being Element of C
      st [x,y] in R & [y,z] in R
      holds [x,z] in R) &
    (for x,y being Element of C
      st [x,y] in R & [y,x] in R
      holds x = y) &
    (for x,y being Element of C holds [o.(x,y),x] in R) &
    (for x,y being Element of C holds [o.(x,y),y] in R) &
    (for z,x,y being Element of C
      st [z,x] in R & [z,y] in R
      holds [z,o.(x,y)] in R) &
    (for x,y being Element of C holds [x,o9.(x,y)] in R) &
    (for x,y being Element of C holds [y,o9.(x,y)] in R) &
    (for x,y,z being Element of C
      st [x,z] in R & [y,z] in R
      holds [o9.(x,y),z] in R)
  holds o.(a,o9.(a,b)) = a
proof
end;
::$P+

:: sup_absorption
::$P-
theorem
  for C being non empty set,
      R being Relation of C,
      o,o9 being BinOp of C,
      a,b being Element of C
  st
    (for x being Element of C holds [x,x] in R) &
    (for x,y,z being Element of C
      st [x,y] in R & [y,z] in R
      holds [x,z] in R) &
    (for x,y being Element of C
      st [x,y] in R & [y,x] in R
      holds x = y) &
    (for x,y being Element of C holds [o.(x,y),x] in R) &
    (for x,y being Element of C holds [o.(x,y),y] in R) &
    (for z,x,y being Element of C
      st [z,x] in R & [z,y] in R
      holds [z,o.(x,y)] in R) &
    (for x,y being Element of C holds [x,o9.(x,y)] in R) &
    (for x,y being Element of C holds [y,o9.(x,y)] in R) &
    (for x,y,z being Element of C
      st [x,z] in R & [y,z] in R
      holds [o9.(x,y),z] in R)
  holds o9.(a,o.(a,b)) = a
proof
end;
::$P+
