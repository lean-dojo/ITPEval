:: Statement-only formalization of the Babel-formal topic set_algebra. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, ZFMISC_1,
    FUNCT_1, FUNCT_2, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

:: inter_distrib_left
::$P-
theorem
  for X being set,
      A,B,C being Subset of X,
      x being object st x in X
  holds
    (x in (A /\ (B \/ C)) iff
     x in ((A /\ B) \/ (A /\ C)))
proof
end;
::$P+

:: inter_distrib_right
::$P-
theorem
  for X being set,
      A,B,C being Subset of X,
      x being object st x in X
  holds
    (x in ((A \/ B) /\ C) iff
     x in ((A /\ C) \/ (B /\ C)))
proof
end;
::$P+

:: de_morgan_union
::$P-
theorem
  for X being set,
      A,B being Subset of X,
      x being object st x in X
  holds
    (x in (X \ (A \/ B)) iff
     x in ((X \ A) /\ (X \ B)))
proof
end;
::$P+

:: de_morgan_inter
::$P-
theorem
  for X being set,
      A,B being Subset of X,
      x being object st x in X
  holds
    (x in (X \ (A /\ B)) iff
     x in ((X \ A) \/ (X \ B)))
proof
end;
::$P+
