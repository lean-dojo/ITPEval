:: Statement-only formalization of the Babel-formal corpus artifact probability:
:: event algebra, probability identities, conditional probability,
:: independence, and finite disjoint unions. This file contains no proof.

environ

 vocabularies BINOP_1, VECTSP_1, XBOOLE_0, ALGSTR_0, SUBSET_1, MESFUNC1,
      RELAT_1, LATTICES, ARYTM_3, FUNCSDOM, VECTSP_2, SUPINF_2, CARD_1,
      STRUCT_0, RLVECT_1, ARYTM_1, GROUP_1, EQREL_1, TARSKI, SETFAM_1,
      MSSUBFAM, INT_2, GCD_1, FUNCT_7, NUMBERS, ZFMISC_1, FUNCT_1, FUNCT_2,
      PARTFUN1, FINSEQ_1, NAT_1, CARD_3;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, PARTFUN1, ORDINAL1, NUMBERS, NAT_1, FINSEQ_1, STRUCT_0,
      ALGSTR_0, RLVECT_1, GROUP_1, VECTSP_2, VECTSP_1;
 constructors BINOP_2, VECTSP_2, MONOID_0, RELSET_1;
 registrations XBOOLE_0, SUBSET_1, MEMBERED, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, ORDINAL1, NAT_1, FINSEQ_1, STRUCT_0, VECTSP_1, MONOID_0,
      XREAL_0;
 requirements SUBSET, BOOLE;
 definitions VECTSP_1, VECTSP_2, XBOOLE_0;
 equalities VECTSP_1;
 expansions VECTSP_1, XBOOLE_0;

begin

:: Events are represented extensionally by subsets of Omega. Thus the
:: source's probability extensionality law is built into equality here.

:: ev_inter_comm
::$P-
theorem
  for Omega being set,
      A,B being Subset of Omega
  holds A /\ B = B /\ A
proof
end;
::$P+

:: ev_union_comm
::$P-
theorem
  for Omega being set,
      A,B being Subset of Omega
  holds A \/ B = B \/ A
proof
end;
::$P+

:: ev_inter_assoc
::$P-
theorem
  for Omega being set,
      A,B,C being Subset of Omega
  holds (A /\ B) /\ C = A /\ (B /\ C)
proof
end;
::$P+

:: ev_union_assoc
::$P-
theorem
  for Omega being set,
      A,B,C being Subset of Omega
  holds (A \/ B) \/ C = A \/ (B \/ C)
proof
end;
::$P+

:: ev_inter_distrib_left
::$P-
theorem
  for Omega being set,
      A,B,C being Subset of Omega
  holds A /\ (B \/ C) = (A /\ B) \/ (A /\ C)
proof
end;
::$P+

:: prob_union_comm
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y)
  holds prob/.(A \/ B) = prob/.(B \/ A)
proof
end;
::$P+

:: prob_union_idem
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y)
  holds prob/.(A \/ A) = prob/.A
proof
end;
::$P+

:: prob_diff
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y)
  holds prob/.(A \ B) = prob/.A - prob/.(A /\ B)
proof
end;
::$P+

:: bayes_symm
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y)
  holds cprob/.[A,B] * prob/.B = cprob/.[B,A] * prob/.A
proof
end;
::$P+

:: law_total_prob
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y)
  holds prob/.A =
    cprob/.[A,B] * prob/.B +
      cprob/.[A,B`] * prob/.(B`)
proof
end;
::$P+

:: prob_union_indep
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     prob/.(A /\ B) = prob/.A * prob/.B
  holds prob/.(A \/ B) =
    prob/.A + (prob/.B + -(prob/.A * prob/.B))
proof
end;
::$P+

:: indep_compl_right
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     prob/.(A /\ B) = prob/.A * prob/.B
  holds prob/.(A /\ B`) = prob/.A * prob/.(B`)
proof
end;
::$P+

:: indep_symm
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     prob/.(A /\ B) = prob/.A * prob/.B
  holds prob/.(B /\ A) = prob/.B * prob/.A
proof
end;
::$P+

:: indep_compl_left
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     prob/.(A /\ B) = prob/.A * prob/.B
  holds prob/.(A` /\ B) = prob/.(A`) * prob/.B
proof
end;
::$P+

:: indep_compl_both
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     prob/.(A /\ B) = prob/.A * prob/.B
  holds prob/.(A` /\ B`) = prob/.(A`) * prob/.(B`)
proof
end;
::$P+

:: prob_bigUnion_disjoint
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      xs being FinSequence of bool Omega,
      ys being FinSequence of R
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     (for i,j being Nat st
        i in dom xs & j in dom xs & i <> j
      holds xs.i misses xs.j) &
     ys = prob * xs
  holds prob/.(union rng xs) = Sum ys
proof
end;
::$P+

:: prob_bigUnion_disjoint_zero
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      xs being FinSequence of bool Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y) &
     (for i,j being Nat st
        i in dom xs & j in dom xs & i <> j
      holds xs.i misses xs.j) &
     (for X being Subset of Omega st X in rng xs
      holds prob/.X = 0.R)
  holds prob/.(union rng xs) = 0.R
proof
end;
::$P+

:: inclusion_exclusion_three
::$P-
theorem
  for Omega being set,
      R being domRing,
      prob being Function of bool Omega, R,
      cprob being Function of [:bool Omega,bool Omega:], R,
      A,B,C being Subset of Omega
  st prob/.({} Omega) = 0.R &
     prob/.Omega = 1.R &
     (for X,Y being Subset of Omega holds
       prob/.(X \/ Y) =
         prob/.X + (prob/.Y + -(prob/.(X /\ Y)))) &
     (for X being Subset of Omega holds
       prob/.(X`) = 1.R + -(prob/.X)) &
     (for X,Y being Subset of Omega holds
       prob/.(X /\ Y) = cprob/.[X,Y] * prob/.Y) &
     (for X,Y being Subset of Omega st X misses Y holds
       prob/.(X \/ Y) = prob/.X + prob/.Y)
  holds prob/.((A \/ B) \/ C) =
    prob/.A +
      (prob/.B +
        (prob/.C +
          -(prob/.(A /\ B) +
            (prob/.(A /\ C) +
              (prob/.(B /\ C) +
                -(prob/.((A /\ B) /\ C)))))))
proof
end;
::$P+
