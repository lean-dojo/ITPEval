:: Statement-only formalization of the Babel-formal topic limits_uniqueness. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, FUNCT_2, PARTFUN1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    RELSET_1, PARTFUN1, FUNCT_1, FUNCT_2, BINOP_1;
  constructors RELSET_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for R,N being non empty set,
      zero,one being Element of R,
      add,mul being BinOp of R,
      opp,absV being Function of R,R,
      leR,ltR being Relation of R,R,
      q being Relation of N,N,
      j being BinOp of N,
      u being Function of N,R,
      l,m being Element of R
  st
    (for x,y being Element of N holds
      [x,j.(x,y)] in q) &
    (for x,y being Element of N holds
      [y,j.(x,y)] in q) &
    (for x,y being Element of R holds
      add.(x,y) = add.(y,x)) &
    (for x,y,z being Element of R holds
      add.(add.(x,y),z) = add.(x,add.(y,z))) &
    (for x being Element of R holds
      add.(x,zero) = x) &
    (for x being Element of R holds
      add.(x,opp.x) = zero) &
    (for x,y being Element of R holds
      opp.(add.(x,y)) = add.(opp.x,opp.y)) &
    (for x,y being Element of R holds
      mul.(x,y) = mul.(y,x)) &
    (for x,y,z being Element of R holds
      mul.(mul.(x,y),z) = mul.(x,mul.(y,z))) &
    (for x being Element of R holds
      mul.(x,one) = x) &
    (for x being Element of R holds
      [x,x] in leR) &
    (for x,y,z being Element of R holds
      [x,y] in leR & [y,z] in leR implies [x,z] in leR) &
    (for a,b,c,d being Element of R holds
      [a,b] in leR & [c,d] in leR implies
        [add.(a,c),add.(b,d)] in leR) &
    (for x being Element of R holds
      [zero,absV.x] in leR) &
    (for x,y being Element of R holds
      [absV.(add.(x,y)),add.(absV.x,absV.y)] in leR) &
    (for x being Element of R holds
      absV.(opp.x) = absV.x) &
    (for x,y being Element of R holds
      absV.(add.(x,opp.y)) = absV.(add.(y,opp.x))) &
    (for x,y,z being Element of R holds
      add.(x,opp.z) =
        add.(add.(x,opp.y),add.(y,opp.z))) &
    (for x,y being Element of R holds
      add.(x,opp.y) = zero implies x = y) &
    (for x being Element of R holds
      ((for eps being Element of R holds
          [zero,eps] in ltR implies
            [absV.x,add.(eps,eps)] in leR)
        implies x = zero))
  holds
    (for x,y,z being Element of R holds
      [absV.(add.(x,opp.z)),
        add.(absV.(add.(x,opp.y)),absV.(add.(y,opp.z)))] in leR) &
    (((for eps being Element of R holds
        [zero,eps] in ltR implies
          ex b being Element of N st
            for n being Element of N holds
              [b,n] in q implies
                [absV.(add.(u.n,opp.l)),eps] in leR) &
      (for eps being Element of R holds
        [zero,eps] in ltR implies
          ex b being Element of N st
            for n being Element of N holds
              [b,n] in q implies
                [absV.(add.(u.n,opp.m)),eps] in leR))
      implies l = m)
proof
end;
::$P+
