:: Statement-only formalization of the Babel-formal topic circle_average. This file contains no
:: proof.

environ
  vocabularies FUNCT_1, FUNCT_2, RELAT_1, XBOOLE_0, ZFMISC_1,
    SUBSET_1, TARSKI, PARTFUN1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, BINOP_1;
  constructors FUNCT_2, RELSET_1, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for R being non empty set,
      zero being Element of R,
      add being BinOp of R,
      integral being Function of Funcs(R,R),R,
      circleMap being BinOp of R,
      circleAverage being Function of [:Funcs(R,R),R:],R
  st
    (for x being Element of R holds add.(x,zero) = x) &
    (for x,y being Element of R holds add.(x,y) = add.(y,x)) &
    (for x,y,z being Element of R holds
      add.(add.(x,y),z) = add.(x,add.(y,z))) &
    (for g,h being Function of R,R st
      (for t being Element of R holds g.t = h.t)
      holds integral.g = integral.h) &
    (for k being Element of R, f being Function of R,R st
      (for t being Element of R holds f.t = k)
      holds integral.f = k) &
    (for f,g,s being Function of R,R st
      (for t being Element of R holds
        s.t = add.(f.t,g.t))
      holds integral.s = add.(integral.f,integral.g)) &
    (for f,s being Function of R,R, c being Element of R st
      (for t being Element of R holds
        s.t = f.(add.(t,c)))
      holds integral.s = integral.f) &
    (for c,t being Element of R holds
      circleMap.(c,t) = add.(t,c)) &
    (for f,h being Function of R,R, c being Element of R st
      (for t being Element of R holds
        h.t = f.(circleMap.(c,t)))
      holds circleAverage.(f,c) = integral.h)
  holds
    (for t being Element of R holds
      circleMap.(zero,t) = t) &
    (for f being Function of R,R holds
      circleAverage.(f,zero) = integral.f) &
    (for f,g,s being Function of R,R, c being Element of R st
      (for z being Element of R holds
        s.z = add.(f.z,g.z))
      holds circleAverage.(s,c) =
        add.(circleAverage.(f,c),circleAverage.(g,c))) &
    (for f,s being Function of R,R, c being Element of R st
      (for z being Element of R holds
        s.z = f.(add.(z,c)))
      holds circleAverage.(s,zero) = circleAverage.(f,c)) &
    (for c,d,t being Element of R holds
      circleMap.(add.(c,d),t) =
        circleMap.(c,circleMap.(d,t))) &
    (for f,s being Function of R,R, c,d being Element of R st
      (for z being Element of R holds
        s.z = f.(add.(z,d)))
      holds circleAverage.(f,add.(c,d)) =
        circleAverage.(s,c)) &
    (for s being Function of R,R, k,c being Element of R st
      (for z being Element of R holds s.z = k)
      holds circleAverage.(s,c) = k) &
    (for f,s being Function of R,R, k,c being Element of R st
      (for z being Element of R holds
        s.z = add.(f.z,k))
      holds circleAverage.(s,c) =
        add.(circleAverage.(f,c),k)) &
    (for f,g,s,u being Function of R,R, c being Element of R st
      (for z being Element of R holds
        s.z = add.(f.z,g.z)) &
      (for z being Element of R holds
        u.z = add.(g.z,f.z))
      holds circleAverage.(s,c) = circleAverage.(u,c)) &
    (for f,g,h,s being Function of R,R, c being Element of R st
      (for z being Element of R holds
        s.z = add.(add.(f.z,g.z),h.z))
      holds circleAverage.(s,c) =
        add.(circleAverage.(f,c),
          add.(circleAverage.(g,c),circleAverage.(h,c)))) &
    (for f being Function of R,R, c,d being Element of R holds
      circleAverage.(f,add.(c,d)) =
        circleAverage.(f,add.(d,c))) &
    (for f being Function of R,R, c being Element of R holds
      circleAverage.(f,c) = integral.f) &
    (for f being Function of R,R, c,d being Element of R holds
      circleAverage.(f,c) = circleAverage.(f,d)) &
    (for f,s being Function of R,R, c being Element of R st
      (for z being Element of R holds
        s.z = circleAverage.(f,z))
      holds circleAverage.(s,c) = circleAverage.(f,c)) &
    (for f being Function of R,R, c being Element of R st
      integral.f = zero
      holds circleAverage.(f,c) = zero) &
    (for f,g,s being Function of R,R, c being Element of R st
      (for z being Element of R holds
        s.z = add.(f.z,g.z))
      holds circleAverage.(s,c) =
        add.(circleAverage.(f,c),circleAverage.(g,c))) &
    (for f,s being Function of R,R, c,d being Element of R st
      (for z being Element of R holds
        s.z = f.(circleMap.(d,z)))
      holds circleAverage.(s,c) =
        circleAverage.(f,add.(c,d)))
proof
end;
::$P+
