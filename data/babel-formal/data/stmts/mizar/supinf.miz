:: Statement-only formalization of the Babel-formal topic supinf. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, FUNCT_2, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for R,N being non empty set,
      zeroNat being Element of N,
      succ being UnOp of N,
      natLe being Relation of N,N,
      zeroR,oneR being Element of R,
      addR,mulR being BinOp of R,
      oppR,invR,absR being UnOp of R,
      rle,rlt being Relation of R,R,
      ofNat being Function of N,R
  st
    (for n being Element of N holds [n,n] in natLe) &
    (for n,m being Element of N st [n,m] in natLe
      holds [n,succ.m] in natLe) &
    (for n being Element of N holds [n,succ.n] in natLe) &
    (for x,y being Element of R holds addR.(x,y) = addR.(y,x)) &
    (for x,y,z being Element of R holds
      addR.(addR.(x,y),z) = addR.(x,addR.(y,z))) &
    (for x being Element of R holds addR.(x,zeroR) = x) &
    (for x being Element of R holds addR.(oppR.x,x) = zeroR) &
    (for x,y being Element of R holds mulR.(x,y) = mulR.(y,x)) &
    (for x,y,z being Element of R holds
      mulR.(mulR.(x,y),z) = mulR.(x,mulR.(y,z))) &
    (for x being Element of R holds mulR.(x,oneR) = x) &
    (for x,y,z being Element of R holds
      mulR.(x,addR.(y,z)) = addR.(mulR.(x,y),mulR.(x,z))) &
    (for x being Element of R holds addR.(x,oppR.zeroR) = x) &
    (for x being Element of R holds [x,x] in rle) &
    (for x,y,z being Element of R st
      [x,y] in rle & [y,z] in rle holds [x,z] in rle) &
    (for x,y being Element of R st
      [x,y] in rle & [y,x] in rle holds x = y) &
    (for x,y being Element of R holds
      ([x,y] in rlt iff [x,y] in rle & x <> y)) &
    (for x being Element of R holds
      [addR.(x,oppR.zeroR),absR.x] in rle) &
    (for x being Element of R st [zeroR,x] in rlt
      holds [zeroR,invR.x] in rlt) &
    (for x,y,z being Element of R st [y,z] in rle
      holds [addR.(x,y),addR.(x,z)] in rle) &
    (for x being Element of R st [zeroR,x] in rlt
      holds invR.(invR.x) = x) &
    (for n being Element of N holds
      [zeroR,ofNat.(succ.n)] in rlt) &
    (for m,n being Element of N st [m,n] in natLe
      holds [ofNat.m,ofNat.n] in rle) &
    ofNat.zeroNat = zeroR &
    (for n being Element of N holds
      ofNat.(succ.n) = addR.(ofNat.n,oneR)) &
    (for x,y being Element of R holds
      [x,y] in rlt or x = y or [y,x] in rlt) &
    (for a,b being Element of R st
      [zeroR,a] in rlt & [zeroR,b] in rlt & [a,b] in rle
      holds [invR.b,invR.a] in rle) &
    (for x,y being Element of R st [x,y] in rlt
      holds ex eps being Element of R st
        [zeroR,eps] in rlt & [addR.(x,eps),y] in rlt) &
    (for x being Element of R holds
      ex n being Element of N st [x,ofNat.n] in rle) &
    (for B being Subset of R holds
      ((ex ub being Element of R st
          (for a being Element of R st a in B
            holds [ub,a] in rle))
       implies
       ex s being Element of R st
         (for a being Element of R st a in B
           holds [a,s] in rle) &
         (for y being Element of R holds
           ((for a being Element of R st a in B
              holds [a,y] in rle)
            implies [s,y] in rle))))
  holds
    (for a,b being Element of R holds
      addR.(a,addR.(b,oppR.a)) = b) &
    (for t being Element of R holds [t,absR.t] in rle) &
    (for A being Subset of R, x,y being Element of R st
      x in A &
      (for a being Element of R st a in A
        holds [a,x] in rle) &
      y in A &
      (for a being Element of R st a in A
        holds [a,y] in rle)
      holds x = y) &
    (for A being Subset of R, x,y being Element of R st
      (for a being Element of R st a in A
        holds [x,a] in rle) &
      (for z being Element of R st
        (for a being Element of R st a in A
          holds [z,a] in rle)
        holds [z,x] in rle) &
      [x,y] in rlt
      holds ex a being Element of R st
        a in A & [a,y] in rlt) &
    (for x,y being Element of R st
      (for eps being Element of R st [zeroR,eps] in rlt
        holds [y,addR.(x,eps)] in rle)
      holds [y,x] in rle) &
    (for u being Function of N,R, x,y being Element of R st
      (for eps being Element of R st [zeroR,eps] in rlt
        holds ex k being Element of N st
          for n being Element of N st [k,n] in natLe
            holds [absR.(addR.(u.n,oppR.x)),eps] in rle) &
      (for n being Element of N holds [y,u.n] in rle)
      holds [y,x] in rle) &
    (for n being Element of N holds
      [zeroR,invR.(ofNat.(succ.n))] in rlt) &
    (for eps being Element of R st [zeroR,eps] in rlt
      holds ex k being Element of N st
        for n being Element of N st [k,n] in natLe
          holds [invR.(ofNat.(succ.n)),eps] in rle)
proof
end;
::$P+
