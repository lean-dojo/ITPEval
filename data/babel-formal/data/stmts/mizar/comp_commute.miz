:: Statement-only formalization of the Babel-formal topic comp_commute. This file contains no
:: proof.

environ
  vocabularies RELAT_1, FUNCT_1, FUNCT_2;
  notations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2;
  constructors RELAT_1, FUNCT_1, FUNCT_2;
  registrations RELAT_1, FUNCT_1, FUNCT_2;

begin

::$P-
theorem
  for A,B,C,D being set,
      f being Function of A,B,
      g being Function of B,C,
      h being Function of C,D
  holds (f*g)*h = f*(g*h)
proof
end;
::$P+

::$P-
theorem
  for A,B being set, f being Function of A,B
  holds f*(id B) = f
proof
end;
::$P+

::$P-
theorem
  for A,B being set, f being Function of A,B
  holds (id A)*f = f
proof
end;
::$P+

::$P-
theorem
  for A being set, f,g being Function of A,A
  holds g*f = f*g implies f*g = g*f
proof
end;
::$P+

::$P-
theorem
  for A being set, f being Function of A,A
  holds (id A)*f = f*(id A)
proof
end;
::$P+

::$P-
theorem
  for A being set, f being Function of A,A
  holds f*(id A) = (id A)*f
proof
end;
::$P+

::$P-
theorem
  for A being set, f being Function of A,A
  holds f*f = f*f
proof
end;
::$P+

::$P-
theorem
  for A being set, f1,f2,g1,g2 being Function of A,A
  holds f1 = f2 implies
    (g1 = g2 implies
      (g1*f1 = f1*g1 implies
        g2*f2 = f2*g2))
proof
end;
::$P+

::$P-
theorem
  for A being set, f,g being Function of A,A
  holds g*f = f*g implies
    g*(f*(id A)) = (f*(id A))*g
proof
end;
::$P+

::$P-
theorem
  for A being set, f,g being Function of A,A
  holds g*f = f*g implies
    (g*(id A))*f = f*(g*(id A))
proof
end;
::$P+
