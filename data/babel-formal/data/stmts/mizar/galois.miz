:: Statement-only formalization of the Babel-formal artifact galois: field
:: cancellation laws and solvability along polynomial and splitting-field maps.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, FUNCT_2, RELAT_1,
    ZFMISC_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
    FUNCT_1, FUNCT_2, BINOP_1;
  constructors TARSKI, ZFMISC_1, XTUPLE_0, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1, FUNCT_2;

begin

reserve C for non empty set;
reserve z,o,x,y,w for Element of C;
reserve add,mul for BinOp of C;
reserve neg,inv for UnOp of C;

:: add_cancel_l
::$P-
theorem
  (for a,b being Element of C holds add.(a,b) = add.(b,a)) &
  (for a,b,c being Element of C holds
    add.(add.(a,b),c) = add.(a,add.(b,c))) &
  (for a being Element of C holds add.(a,z) = a) &
  (for a being Element of C holds add.(neg.a,a) = z) &
  (for a,b being Element of C holds mul.(a,b) = mul.(b,a)) &
  (for a,b,c being Element of C holds
    mul.(mul.(a,b),c) = mul.(a,mul.(b,c))) &
  (for a being Element of C holds mul.(o,a) = a) &
  (for a being Element of C st a <> z holds mul.(inv.a,a) = o) &
  (for a,b,c being Element of C holds
    mul.(a,add.(b,c)) = add.(mul.(a,b),mul.(a,c))) &
  z <> o &
  (for a being Element of C st a <> z holds inv.a <> z) &
  add.(x,y) = add.(x,w)
  implies y = w
proof
end;
::$P+

:: add_cancel_r
::$P-
theorem
  (for a,b being Element of C holds add.(a,b) = add.(b,a)) &
  (for a,b,c being Element of C holds
    add.(add.(a,b),c) = add.(a,add.(b,c))) &
  (for a being Element of C holds add.(a,z) = a) &
  (for a being Element of C holds add.(neg.a,a) = z) &
  (for a,b being Element of C holds mul.(a,b) = mul.(b,a)) &
  (for a,b,c being Element of C holds
    mul.(mul.(a,b),c) = mul.(a,mul.(b,c))) &
  (for a being Element of C holds mul.(o,a) = a) &
  (for a being Element of C st a <> z holds mul.(inv.a,a) = o) &
  (for a,b,c being Element of C holds
    mul.(a,add.(b,c)) = add.(mul.(a,b),mul.(a,c))) &
  z <> o &
  (for a being Element of C st a <> z holds inv.a <> z) &
  add.(y,x) = add.(w,x)
  implies y = w
proof
end;
::$P+

:: mul_cancel_l
::$P-
theorem
  (for a,b being Element of C holds add.(a,b) = add.(b,a)) &
  (for a,b,c being Element of C holds
    add.(add.(a,b),c) = add.(a,add.(b,c))) &
  (for a being Element of C holds add.(a,z) = a) &
  (for a being Element of C holds add.(neg.a,a) = z) &
  (for a,b being Element of C holds mul.(a,b) = mul.(b,a)) &
  (for a,b,c being Element of C holds
    mul.(mul.(a,b),c) = mul.(a,mul.(b,c))) &
  (for a being Element of C holds mul.(o,a) = a) &
  (for a being Element of C st a <> z holds mul.(inv.a,a) = o) &
  (for a,b,c being Element of C holds
    mul.(a,add.(b,c)) = add.(mul.(a,b),mul.(a,c))) &
  z <> o &
  (for a being Element of C st a <> z holds inv.a <> z) &
  x <> z & mul.(x,y) = mul.(x,w)
  implies y = w
proof
end;
::$P+

:: mul_cancel_r
::$P-
theorem
  (for a,b being Element of C holds add.(a,b) = add.(b,a)) &
  (for a,b,c being Element of C holds
    add.(add.(a,b),c) = add.(a,add.(b,c))) &
  (for a being Element of C holds add.(a,z) = a) &
  (for a being Element of C holds add.(neg.a,a) = z) &
  (for a,b being Element of C holds mul.(a,b) = mul.(b,a)) &
  (for a,b,c being Element of C holds
    mul.(mul.(a,b),c) = mul.(a,mul.(b,c))) &
  (for a being Element of C holds mul.(o,a) = a) &
  (for a being Element of C st a <> z holds mul.(inv.a,a) = o) &
  (for a,b,c being Element of C holds
    mul.(a,add.(b,c)) = add.(mul.(a,b),mul.(a,c))) &
  z <> o &
  (for a being Element of C st a <> z holds inv.a <> z) &
  x <> z & mul.(y,x) = mul.(w,x)
  implies y = w
proof
end;
::$P+

:: inv_unique
::$P-
theorem
  (for a,b being Element of C holds add.(a,b) = add.(b,a)) &
  (for a,b,c being Element of C holds
    add.(add.(a,b),c) = add.(a,add.(b,c))) &
  (for a being Element of C holds add.(a,z) = a) &
  (for a being Element of C holds add.(neg.a,a) = z) &
  (for a,b being Element of C holds mul.(a,b) = mul.(b,a)) &
  (for a,b,c being Element of C holds
    mul.(mul.(a,b),c) = mul.(a,mul.(b,c))) &
  (for a being Element of C holds mul.(o,a) = a) &
  (for a being Element of C st a <> z holds mul.(inv.a,a) = o) &
  (for a,b,c being Element of C holds
    mul.(a,add.(b,c)) = add.(mul.(a,b),mul.(a,c))) &
  z <> o &
  (for a being Element of C st a <> z holds inv.a <> z) &
  x <> z & mul.(x,y) = o
  implies y = inv.x
proof
end;
::$P+

:: inv_involutive
::$P-
theorem
  (for a,b being Element of C holds add.(a,b) = add.(b,a)) &
  (for a,b,c being Element of C holds
    add.(add.(a,b),c) = add.(a,add.(b,c))) &
  (for a being Element of C holds add.(a,z) = a) &
  (for a being Element of C holds add.(neg.a,a) = z) &
  (for a,b being Element of C holds mul.(a,b) = mul.(b,a)) &
  (for a,b,c being Element of C holds
    mul.(mul.(a,b),c) = mul.(a,mul.(b,c))) &
  (for a being Element of C holds mul.(o,a) = a) &
  (for a being Element of C st a <> z holds mul.(inv.a,a) = o) &
  (for a,b,c being Element of C holds
    mul.(a,add.(b,c)) = add.(mul.(a,b),mul.(a,c))) &
  z <> o &
  (for a being Element of C st a <> z holds inv.a <> z) &
  x <> z
  implies inv.(inv.x) = x
proof
end;
::$P+

:: The four polymorphic source axiom schemes are represented below as
:: explicit antecedents at each concrete tower instance.

:: gal_isSolvable_tower
::$P-
theorem
  for F,Sp being set,
      PF,PSp being non empty set,
      mapFSp being Function of [:PF,Funcs(F,Sp):],PSp,
      aFSp being Function of F,Sp,
      solvF being Subset of PF,
      solvSp being Subset of PSp,
      p,q being Element of PF
  holds
    (for a,b being Element of PF st
      a in solvF & mapFSp.(b,aFSp) in solvSp
    holds b in solvF) &
    p in solvF & mapFSp.(q,aFSp) in solvSp
    implies q in solvF
proof
end;
::$P+

:: gal_isSolvable_double_tower
::$P-
theorem
  for F,Sp,Sq being set,
      PF,PSp,PSq being non empty set,
      mapFSp being Function of [:PF,Funcs(F,Sp):],PSp,
      mapFSq being Function of [:PF,Funcs(F,Sq):],PSq,
      aFSp being Function of F,Sp,
      aFSq being Function of F,Sq,
      solvF being Subset of PF,
      solvSp being Subset of PSp,
      solvSq being Subset of PSq,
      p,q,r being Element of PF
  holds
    (for a,b being Element of PF st
      a in solvF & mapFSp.(b,aFSp) in solvSp
    holds b in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSq.(b,aFSq) in solvSq
    holds b in solvF) &
    p in solvF &
    mapFSp.(q,aFSp) in solvSp &
    mapFSq.(r,aFSq) in solvSq
    implies r in solvF
proof
end;
::$P+

:: gal_isSolvable_triple_tower
::$P-
theorem
  for F,Sp,Sq,Sr being set,
      PF,PSp,PSq,PSr being non empty set,
      mapFSp being Function of [:PF,Funcs(F,Sp):],PSp,
      mapFSq being Function of [:PF,Funcs(F,Sq):],PSq,
      mapFSr being Function of [:PF,Funcs(F,Sr):],PSr,
      aFSp being Function of F,Sp,
      aFSq being Function of F,Sq,
      aFSr being Function of F,Sr,
      solvF being Subset of PF,
      solvSp being Subset of PSp,
      solvSq being Subset of PSq,
      solvSr being Subset of PSr,
      p,q,r,s being Element of PF
  holds
    (for a,b being Element of PF st
      a in solvF & mapFSp.(b,aFSp) in solvSp
    holds b in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSq.(b,aFSq) in solvSq
    holds b in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSr.(b,aFSr) in solvSr
    holds b in solvF) &
    p in solvF &
    mapFSp.(q,aFSp) in solvSp &
    mapFSq.(r,aFSq) in solvSq &
    mapFSr.(s,aFSr) in solvSr
    implies s in solvF
proof
end;
::$P+

:: gal_isSolvable_quadruple_tower
::$P-
theorem
  for F,Sp,Sq,Sr,Ss being set,
      PF,PSp,PSq,PSr,PSs being non empty set,
      mapFSp being Function of [:PF,Funcs(F,Sp):],PSp,
      mapFSq being Function of [:PF,Funcs(F,Sq):],PSq,
      mapFSr being Function of [:PF,Funcs(F,Sr):],PSr,
      mapFSs being Function of [:PF,Funcs(F,Ss):],PSs,
      aFSp being Function of F,Sp,
      aFSq being Function of F,Sq,
      aFSr being Function of F,Sr,
      aFSs being Function of F,Ss,
      solvF being Subset of PF,
      solvSp being Subset of PSp,
      solvSq being Subset of PSq,
      solvSr being Subset of PSr,
      solvSs being Subset of PSs,
      p,q,r,s,t being Element of PF
  holds
    (for a,b being Element of PF st
      a in solvF & mapFSp.(b,aFSp) in solvSp
    holds b in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSq.(b,aFSq) in solvSq
    holds b in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSr.(b,aFSr) in solvSr
    holds b in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSs.(b,aFSs) in solvSs
    holds b in solvF) &
    p in solvF &
    mapFSp.(q,aFSp) in solvSp &
    mapFSq.(r,aFSq) in solvSq &
    mapFSr.(s,aFSr) in solvSr &
    mapFSs.(t,aFSs) in solvSs
    implies t in solvF
proof
end;
::$P+

:: gal_isSolvable_map_poly
::$P-
theorem
  for F,K being set,
      PF,PK being non empty set,
      mapFK being Function of [:PF,Funcs(F,K):],PK,
      aFK being Function of F,K,
      solvF being Subset of PF,
      solvK being Subset of PK,
      p being Element of PF
  holds
    (for a being Element of PF st a in solvF
    holds mapFK.(a,aFK) in solvK) &
    p in solvF
    implies mapFK.(p,aFK) in solvK
proof
end;
::$P+

:: gal_isSolvable_of_split
::$P-
theorem
  for F,Sp being set,
      PF being non empty set,
      splitsFSp being Subset of [:PF,Funcs(F,Sp):],
      aFSp being Function of F,Sp,
      solvF being Subset of PF,
      p being Element of PF
  holds
    (for a being Element of PF, f being Function of F,Sp st
      [a,f] in splitsFSp
    holds a in solvF) &
    [p,aFSp] in splitsFSp
    implies p in solvF
proof
end;
::$P+

:: gal_isSolvable_split_tower
::$P-
theorem
  for F,Sp being set,
      PF being non empty set,
      splitsFSp being Subset of [:PF,Funcs(F,Sp):],
      aFSp being Function of F,Sp,
      solvF being Subset of PF,
      p,q being Element of PF
  holds
    (for a being Element of PF, f being Function of F,Sp st
      [a,f] in splitsFSp
    holds a in solvF) &
    [q,aFSp] in splitsFSp
    implies q in solvF
proof
end;
::$P+

:: gal_isSolvable_two_step_map
::$P-
theorem
  for F,K,L being set,
      PF,PK,PL being non empty set,
      mapFK being Function of [:PF,Funcs(F,K):],PK,
      mapKL being Function of [:PK,Funcs(K,L):],PL,
      aFK being Function of F,K,
      aKL being Function of K,L,
      solvF being Subset of PF,
      solvK being Subset of PK,
      solvL being Subset of PL,
      p being Element of PF
  holds
    (for a being Element of PF st a in solvF
    holds mapFK.(a,aFK) in solvK) &
    (for a being Element of PK st a in solvK
    holds mapKL.(a,aKL) in solvL) &
    p in solvF
    implies mapKL.(mapFK.(p,aFK),aKL) in solvL
proof
end;
::$P+

:: gal_isSolvable_three_step_map
::$P-
theorem
  for F,K,L,M being set,
      PF,PK,PL,PM being non empty set,
      mapFK being Function of [:PF,Funcs(F,K):],PK,
      mapKL being Function of [:PK,Funcs(K,L):],PL,
      mapLM being Function of [:PL,Funcs(L,M):],PM,
      aFK being Function of F,K,
      aKL being Function of K,L,
      aLM being Function of L,M,
      solvF being Subset of PF,
      solvK being Subset of PK,
      solvL being Subset of PL,
      solvM being Subset of PM,
      p being Element of PF
  holds
    (for a being Element of PF st a in solvF
    holds mapFK.(a,aFK) in solvK) &
    (for a being Element of PK st a in solvK
    holds mapKL.(a,aKL) in solvL) &
    (for a being Element of PL st a in solvL
    holds mapLM.(a,aLM) in solvM) &
    p in solvF
    implies mapLM.(mapKL.(mapFK.(p,aFK),aKL),aLM) in solvM
proof
end;
::$P+

:: gal_isSolvable_map_poly_comp
::$P-
theorem
  for F,K,L being set,
      PF,PK,PL being non empty set,
      mapFK being Function of [:PF,Funcs(F,K):],PK,
      mapKL being Function of [:PK,Funcs(K,L):],PL,
      aFK being Function of F,K,
      aKL being Function of K,L,
      solvF being Subset of PF,
      solvK being Subset of PK,
      solvL being Subset of PL,
      p being Element of PF
  holds
    (for a being Element of PF st a in solvF
    holds mapFK.(a,aFK) in solvK) &
    (for a being Element of PK st a in solvK
    holds mapKL.(a,aKL) in solvL) &
    p in solvF
    implies mapKL.(mapFK.(p,aFK),aKL) in solvL
proof
end;
::$P+

:: gal_isSolvable_mutual_split
::$P-
theorem
  for F,Sp,Sq being set,
      PF being non empty set,
      splitsFSp being Subset of [:PF,Funcs(F,Sp):],
      splitsFSq being Subset of [:PF,Funcs(F,Sq):],
      aFSp being Function of F,Sp,
      aFSq being Function of F,Sq,
      solvF being Subset of PF,
      p,q being Element of PF
  holds
    (for a being Element of PF, f being Function of F,Sp st
      [a,f] in splitsFSp
    holds a in solvF) &
    (for a being Element of PF, f being Function of F,Sq st
      [a,f] in splitsFSq
    holds a in solvF) &
    [p,aFSq] in splitsFSq &
    [q,aFSp] in splitsFSp
    implies p in solvF & q in solvF
proof
end;
::$P+

:: gal_isSolvable_tower_split
::$P-
theorem
  for F,Sp,Sq being set,
      PF,PSq being non empty set,
      splitsFSp being Subset of [:PF,Funcs(F,Sp):],
      mapFSq being Function of [:PF,Funcs(F,Sq):],PSq,
      aFSp being Function of F,Sp,
      aFSq being Function of F,Sq,
      solvF being Subset of PF,
      solvSq being Subset of PSq,
      p,q,r being Element of PF
  holds
    (for a being Element of PF, f being Function of F,Sp st
      [a,f] in splitsFSp
    holds a in solvF) &
    (for a,b being Element of PF st
      a in solvF & mapFSq.(b,aFSq) in solvSq
    holds b in solvF) &
    [q,aFSp] in splitsFSp &
    mapFSq.(r,aFSq) in solvSq
    implies r in solvF
proof
end;
::$P+

:: gal_isSolvable_map_after_split
::$P-
theorem
  for F,K,Sp being set,
      PF,PK being non empty set,
      splitsFSp being Subset of [:PF,Funcs(F,Sp):],
      mapFK being Function of [:PF,Funcs(F,K):],PK,
      aFSp being Function of F,Sp,
      aFK being Function of F,K,
      solvF being Subset of PF,
      solvK being Subset of PK,
      p being Element of PF
  holds
    (for a being Element of PF, f being Function of F,Sp st
      [a,f] in splitsFSp
    holds a in solvF) &
    (for a being Element of PF st a in solvF
    holds mapFK.(a,aFK) in solvK) &
    [p,aFSp] in splitsFSp
    implies mapFK.(p,aFK) in solvK
proof
end;
::$P+
