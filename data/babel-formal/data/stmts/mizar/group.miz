:: Statement-only formalization of the Babel-formal topic group. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, SUBSET_1, BINOP_1,
      ORDINAL4, GROUP_1, GROUP_2, GROUP_3, GROUP_10, ALGSTR_0, STRUCT_0;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, STRUCT_0, ALGSTR_0, GROUP_1, GROUP_2, GROUP_3, GROUP_10;
 constructors RELSET_1, GROUP_10;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, STRUCT_0,
      GROUP_1, GROUP_2, GROUP_3, FUNCT_2, GROUP_10;
 requirements SUBSET, BOOLE;
 definitions GROUP_10;
 equalities STRUCT_0, ALGSTR_0;
 expansions STRUCT_0, GROUP_10;

begin

::$P-
theorem
  for G being commutative Group,
      a,b,c being Element of G
  holds a * (b * c) = b * (c * a)
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      a,b,c being Element of G
  holds a * b = a * c implies b = c
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      a,b,c being Element of G
  holds b * a = c * a implies b = c
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      a being Element of G
  holds (a")" = a
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      a,b being Element of G
  holds (a * b)" = b" * a"
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      a,b being Element of G
  holds a * b = 1_G implies b = a"
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      g being Element of G,
      x being Element of E
  holds (T^(g")).((T^g).x) = x
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      g being Element of G,
      x being Element of E
  holds (T^g).((T^(g")).x) = x
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x being Element of E
  holds x,x are_conjugated_under T
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x,y being Element of E
  holds x,y are_conjugated_under T implies
        y,x are_conjugated_under T
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x,y,z being Element of E
  holds x,y are_conjugated_under T &
        y,z are_conjugated_under T implies
        x,z are_conjugated_under T
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x,y,z being Element of E
  holds x,y are_conjugated_under T implies
        (x,z are_conjugated_under T iff
         y,z are_conjugated_under T)
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x being Element of E,
      g,h being Element of G
  holds g in the_strict_stabilizer_of(x,T) &
        h in the_strict_stabilizer_of(x,T) implies
        g * h in the_strict_stabilizer_of(x,T)
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x being Element of E,
      g being Element of G
  holds g in the_strict_stabilizer_of(x,T) implies
        g" in the_strict_stabilizer_of(x,T)
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x being Element of E
  holds 1_G in the_strict_stabilizer_of(x,T)
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x being Element of E,
      g,h being Element of G
  holds h in the_strict_stabilizer_of(x,T) implies
        g * h * g" in the_strict_stabilizer_of((T^g).x,T)
proof
end;
::$P+

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      x,y being Element of E,
      g,h being Element of G
  st (T^g).x = y
  holds h in the_strict_stabilizer_of(y,T) iff
        g" * h * g in the_strict_stabilizer_of(x,T)
proof
end;
::$P+
