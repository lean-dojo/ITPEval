:: Statement-only formalization of the Babel-formal topic graph_paths. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELAT_2,
      REWRITE1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
      RELAT_2, REWRITE1;
  constructors RELAT_1, RELSET_1, RELAT_2, REWRITE1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, REWRITE1;
  requirements BOOLE, SUBSET;

begin

:: Path reflexivity.
::$P-
theorem
  for V being set, E being Relation of V
  for v being Element of V
  holds E reduces v,v
proof
end;
::$P+

:: Path transitivity.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v,w being Element of V
  st E reduces u,v & E reduces v,w
  holds E reduces u,w
proof
end;
::$P+

:: Reversing a path in an undirected graph.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v being Element of V
  st E is symmetric & E reduces u,v
  holds E reduces v,u
proof
end;
::$P+

:: Concatenating an edge on the right.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v,w being Element of V
  st E reduces u,v & [v,w] in E
  holds E reduces u,w
proof
end;
::$P+

:: Concatenating two paths.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v,w being Element of V
  st E reduces u,v & E reduces v,w
  holds E reduces u,w
proof
end;
::$P+

:: Every edge is a path.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v being Element of V
  st [u,v] in E
  holds E reduces u,v
proof
end;
::$P+

:: Concatenating an edge on the left.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v,w being Element of V
  st [u,v] in E & E reduces v,w
  holds E reduces u,w
proof
end;
::$P+

:: Concatenating three paths.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v,w,t being Element of V
  st E reduces u,v & E reduces v,w & E reduces w,t
  holds E reduces u,t
proof
end;
::$P+

:: Reversing a path gives a path in the converse edge relation.
::$P-
theorem
  for V being set, E being Relation of V
  for u,v being Element of V
  st E reduces u,v
  holds E~ reduces v,u
proof
end;
::$P+

:: A round trip yields a reflexive path.
::$P-
theorem
  for V being set, E being Relation of V
  for v,w being Element of V
  st E reduces v,w & E reduces w,v
  holds E reduces v,v
proof
end;
::$P+
