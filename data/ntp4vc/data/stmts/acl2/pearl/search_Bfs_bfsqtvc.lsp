;; Statement-only formalization of NTP4VC corpus artifact
;; pearl/search_Bfs_bfsqtvc: the breadth-first-search verification condition
;; for preserving frontier path lengths and detecting success. This file
;; contains no proof.

(in-package "ACL2")

(set-inhibit-output-lst '(prove proof-tree event summary))

;; The source state type is an arbitrary inhabited carrier.  These
;; conservative interfaces represent its moves function, distinguished start
;; state, and success predicate.  Their source typing requirements are made
;; explicit in the statement predicate.

(defstub bfs-state-p (x) t)
(defstub bfs-default-state () t)
(defstub bfs-moves (node) t)
(defstub bfs-start () t)
(defstub bfs-success (node) t)

(defun bfs-state-list-p (xs)
  (if (consp xs)
      (and
       (bfs-state-p (car xs))
       (bfs-state-list-p (cdr xs)))
    (equal xs nil)))

(defun-sk bfs-moves-typed-p ()
  (forall (node)
    (implies
     (bfs-state-p node)
     (bfs-state-list-p (bfs-moves node)))))

(defun bfs-interface-p ()
  (and
   (bfs-state-p (bfs-default-state))
   (bfs-state-p (bfs-start))
   (bfs-moves-typed-p)))

;; This is the source conversion from an integer to a natural index, followed
;; by total list indexing with the source's fixed inhabited default.

(defun bfs-int-to-nat (value)
  (if (and
       (integerp value)
       (< value 0))
      0
    (nfix value)))

(defun bfs-nth-state (xs index)
  (let ((tail
         (nthcdr
          (bfs-int-to-nat index)
          xs)))
    (if (consp tail)
        (car tail)
      (bfs-default-state))))

;; The source one-step move relation is preserved literally through its
;; existential sequence index.

(defun-sk bfs-move-p (source target)
  (exists (index)
    (and
     (bfs-state-p source)
     (bfs-state-p target)
     (integerp index)
     (<= 0 index)
     (< index (len (bfs-moves source)))
     (equal
      target
      (bfs-nth-state
       (bfs-moves source)
       index)))))

;; A finite walk lists its successive states.  Existence of a walk containing
;; n edges is definitionally equivalent to the least relation generated by
;; the source constructors Path0, Path1, and Patht.

(defun bfs-walk-p (states)
  (if (consp states)
      (if (consp (cdr states))
          (and
           (bfs-move-p
            (car states)
            (car (cdr states)))
           (bfs-walk-p (cdr states)))
        (equal (cdr states) nil))
    (equal states nil)))

(defun-sk bfs-path-p (source target length)
  (exists (states)
    (and
     (bfs-state-p source)
     (bfs-state-p target)
     (integerp length)
     (<= 0 length)
     (bfs-state-list-p states)
     (equal (len states) (+ length 1))
     (consp states)
     (equal (car states) source)
     (equal (car (last states)) target)
     (bfs-walk-p states))))

;; The following predicates reproduce the four breadth-first-search loop
;; invariants at a frontier depth.

(defun-sk bfs-frontier-paths-p (frontier depth)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (<= 0 index)
       (< index (len frontier)))
      (bfs-path-p
       (bfs-start)
       (bfs-nth-state frontier index)
       depth)))))

(defun-sk bfs-frontier-complete-p (frontier depth)
  (forall (node)
    (implies
     (bfs-state-p node)
     (implies
      (bfs-path-p
       (bfs-start)
       node
       depth)
      (member-equal node frontier)))))

(defun-sk bfs-success-lower-bound-p (depth)
  (forall (node length)
    (implies
     (and
      (bfs-state-p node)
      (integerp length))
     (implies
      (bfs-path-p
       (bfs-start)
       node
       length)
      (implies
       (bfs-success node)
       (<= depth length))))))

(defun bfs-level-invariant-p (depth frontier)
  (and
   (integerp depth)
   (bfs-state-list-p frontier)
   (<= 0 depth)
   (bfs-frontier-paths-p frontier depth)
   (bfs-frontier-complete-p frontier depth)
   (bfs-success-lower-bound-p depth)))

;; The initial singleton construction retains the source's explicit length,
;; head, and shifted-index antecedent.

(defun-sk bfs-cons-shift-p (extended original)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (< 0 index)
       (<= index (len original)))
      (equal
       (bfs-nth-state extended index)
       (bfs-nth-state original (- index 1)))))))

(defun bfs-cons-spec-p (original head extended)
  (and
   (equal
    (len extended)
    (+ 1 (len original)))
   (equal
    (bfs-nth-state extended 0)
    head)
   (bfs-cons-shift-p extended original)))

;; These three predicates are exactly the inner for-loop invariants: every
;; next-frontier element has an earlier predecessor, all moves of processed
;; states occur in the next frontier, and no processed state is successful.

(defun-sk bfs-has-earlier-predecessor-p
    (current target limit)
  (exists (index)
    (and
     (integerp index)
     (<= 0 index)
     (< index limit)
     (bfs-move-p
      (bfs-nth-state current index)
      target))))

(defun-sk bfs-next-elements-covered-p
    (current next limit)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (<= 0 index)
       (< index (len next)))
      (bfs-has-earlier-predecessor-p
       current
       (bfs-nth-state next index)
       limit)))))

(defun-sk bfs-processed-moves-present-p
    (current next limit)
  (forall (current-index move-index)
    (implies
     (and
      (integerp current-index)
      (integerp move-index))
     (implies
      (and
       (<= 0 current-index)
       (< current-index limit))
      (implies
       (and
        (<= 0 move-index)
        (< move-index
           (len
            (bfs-moves
             (bfs-nth-state
              current
              current-index)))))
       (member-equal
        (bfs-nth-state
         (bfs-moves
          (bfs-nth-state
           current
           current-index))
         move-index)
        next))))))

(defun-sk bfs-processed-unsuccessful-p
    (current limit)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (<= 0 index)
       (< index limit))
      (not
       (bfs-success
        (bfs-nth-state current index)))))))

(defun bfs-inner-invariant-p
    (current next limit)
  (and
   (bfs-state-list-p current)
   (bfs-state-list-p next)
   (integerp limit)
   (bfs-next-elements-covered-p
    current next limit)
   (bfs-processed-moves-present-p
    current next limit)
   (bfs-processed-unsuccessful-p
    current limit)))

;; The source append verification condition keeps its explicit length and
;; pointwise prefix/suffix equations as the antecedent for invariant
;; preservation.

(defun-sk bfs-append-prefix-p
    (combined prefix)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (<= 0 index)
       (< index (len prefix)))
      (equal
       (bfs-nth-state combined index)
       (bfs-nth-state prefix index))))))

(defun-sk bfs-append-suffix-p
    (combined prefix suffix)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (<= (len prefix) index)
       (< index (len combined)))
      (equal
       (bfs-nth-state combined index)
       (bfs-nth-state
        suffix
        (- index (len prefix))))))))

(defun bfs-append-spec-p
    (combined prefix suffix)
  (and
   (equal
    (len combined)
    (+ (len prefix) (len suffix)))
   (bfs-append-prefix-p combined prefix)
   (bfs-append-suffix-p
    combined prefix suffix)))

(defun bfs-inner-step-p
    (depth current next index)
  (let ((node
         (bfs-nth-state current index)))
    (if (bfs-success node)
        (bfs-path-p
         (bfs-start)
         node
         depth)
      (let* ((moves
              (bfs-moves node))
             (combined
              (append moves next)))
        (implies
         (bfs-append-spec-p
          combined moves next)
         (bfs-inner-invariant-p
          current
          combined
          (+ index 1)))))))

(defun-sk bfs-all-inner-steps-p
    (depth current next last-index)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (and
        (<= 0 index)
        (<= index last-index))
       (bfs-inner-invariant-p
        current next index))
      (bfs-inner-step-p
       depth current next index)))))

;; The next frontier remains universally quantified inside the outer loop
;; conclusion, as in the source verification condition.

(defun-sk bfs-all-next-frontiers-p
    (depth current last-index)
  (forall (next)
    (implies
     (bfs-state-list-p next)
     (and
      (bfs-all-inner-steps-p
       depth current next last-index)
      (implies
       (bfs-inner-invariant-p
        current
        next
        (+ last-index 1))
       (bfs-level-invariant-p
        (+ depth 1)
        next))))))

(defun bfs-nonempty-frontier-case-p
    (depth current)
  (let ((last-index
         (- (len current) 1)))
    (and
     (implies
      (<= 0 (+ last-index 1))
      (and
       (bfs-inner-invariant-p
        current nil 0)
       (bfs-all-next-frontiers-p
        depth current last-index)))
     (implies
      (< (+ last-index 1) 0)
      (bfs-level-invariant-p
       (+ depth 1)
       nil)))))

(defun-sk bfs-no-solution-p ()
  (forall (node length)
    (implies
     (and
      (bfs-state-p node)
      (integerp length))
     (implies
      (bfs-success node)
      (not
       (bfs-path-p
        (bfs-start)
        node
        length))))))

(defun-sk bfs-all-outer-steps-p ()
  (forall (depth current)
    (implies
     (and
      (integerp depth)
      (bfs-state-list-p current))
     (implies
      (bfs-level-invariant-p
       depth current)
      (if (< 0 (len current))
          (bfs-nonempty-frontier-case-p
           depth current)
        (bfs-no-solution-p))))))

(defun ntp4vc-pearl-search-bfs-bfsqtvc-statement ()
  (implies
   (bfs-interface-p)
   (let* ((original nil)
          (head (bfs-start))
          (extended (cons head original)))
     (implies
      (bfs-cons-spec-p
       original head extended)
      (and
       (bfs-level-invariant-p
        0 extended)
       (bfs-all-outer-steps-p))))))

(set-inhibit-output-lst nil)
(value-triple :itpeval-statement-checked)
:q
