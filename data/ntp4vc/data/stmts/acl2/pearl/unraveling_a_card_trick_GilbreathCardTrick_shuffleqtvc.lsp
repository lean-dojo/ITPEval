;; Statement-only formalization of NTP4VC corpus artifact
;; pearl/unraveling_a_card_trick_GilbreathCardTrick_shuffleqtvc: the
;; card-shuffle loop verification condition over integer stacks, preserving
;; riffle-shuffle invariants through either pop-and-push branch. This file
;; contains no proof.

(in-package "ACL2")

(set-inhibit-output-lst '(prove proof-tree event summary))

;; The verification condition observes stacks only through their finite lists
;; of integer elements, as in the repository's other translation from this
;; Why3 module.

(defun gct-shuffle-int-list-p (xs)
  (declare (xargs :measure (acl2-count xs)))
  (if (consp xs)
      (and
       (integerp (car xs))
       (gct-shuffle-int-list-p (cdr xs)))
    (equal xs nil)))

;; This is the least finite-list relation generated by the four source
;; constructors for a riffle shuffle.

(defun gct-shuffle-p (left right shuffled)
  (declare (xargs :measure (acl2-count shuffled)))
  (if (consp shuffled)
      (or
       (and
        (consp left)
        (equal (car left) (car shuffled))
        (gct-shuffle-p
         (cdr left)
         right
         (cdr shuffled)))
       (and
        (consp right)
        (equal (car right) (car shuffled))
        (gct-shuffle-p
         left
         (cdr right)
         (cdr shuffled))))
    (and
     (equal shuffled nil)
     (equal left nil)
     (equal right nil))))

;; Innermost continuation for the branch that pops from A1.

(defun gct-shuffle-left-c2-result-p
    (a b a-prime1 b-prime1 c1 a1 b1
       a-prime2 a2 o4 c2)
  (declare (ignore a-prime1))
  (implies
   (equal c2 (cons o4 c1))
   (and
    (and
     (<= 0 (+ (len a1) (len b1)))
     (< (+ (len a2) (len b1))
        (+ (len a1) (len b1))))
    (equal
     (reverse a)
     (append (reverse a2) a-prime2))
    (equal
     (reverse b)
     (append (reverse b1) b-prime1))
    (gct-shuffle-p
     a-prime2
     b-prime1
     c2))))

(defun-sk gct-shuffle-left-all-c2-p
    (a b a-prime1 b-prime1 c1 a1 b1
       a-prime2 a2 o4)
  (forall (c2)
    (implies
     (gct-shuffle-int-list-p c2)
     (gct-shuffle-left-c2-result-p
      a b a-prime1 b-prime1 c1 a1 b1
      a-prime2 a2 o4 c2))))

;; The source match on A1 is false for NIL and otherwise exposes its head O4
;; and tail stack A2.

(defun gct-shuffle-left-pop-result-p
    (a b a-prime1 b-prime1 c1 a1 b1
       a-prime2 a2 o4)
  (implies
   (and
    (consp a1)
    (equal o4 (car a1))
    (equal a2 (cdr a1)))
   (gct-shuffle-left-all-c2-p
    a b a-prime1 b-prime1 c1 a1 b1
    a-prime2 a2 o4)))

(defun-sk gct-shuffle-left-all-pop-results-p
    (a b a-prime1 b-prime1 c1 a1 b1
       a-prime2)
  (forall (a2 o4)
    (implies
     (and
      (gct-shuffle-int-list-p a2)
      (integerp o4))
     (gct-shuffle-left-pop-result-p
      a b a-prime1 b-prime1 c1 a1 b1
      a-prime2 a2 o4))))

(defun gct-shuffle-left-push-result-p
    (a b a-prime1 b-prime1 c1 a1 b1
       o3 a-prime2)
  (implies
   (equal a-prime2 (cons o3 a-prime1))
   (and
    (not (equal a1 nil))
    (gct-shuffle-left-all-pop-results-p
     a b a-prime1 b-prime1 c1 a1 b1
     a-prime2))))

(defun-sk gct-shuffle-left-all-push-results-p
    (a b a-prime1 b-prime1 c1 a1 b1
       o3)
  (forall (a-prime2)
    (implies
     (gct-shuffle-int-list-p a-prime2)
     (gct-shuffle-left-push-result-p
      a b a-prime1 b-prime1 c1 a1 b1
      o3 a-prime2))))

;; The outer match on A1 exposes its head O3.

(defun gct-shuffle-left-head-result-p
    (a b a-prime1 b-prime1 c1 a1 b1 o3)
  (implies
   (and
    (consp a1)
    (equal o3 (car a1)))
   (gct-shuffle-left-all-push-results-p
    a b a-prime1 b-prime1 c1 a1 b1 o3)))

(defun-sk gct-shuffle-left-all-heads-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (forall (o3)
    (implies
     (integerp o3)
     (gct-shuffle-left-head-result-p
      a b a-prime1 b-prime1 c1 a1 b1 o3))))

(defun gct-shuffle-left-branch-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (and
   (not (equal a1 nil))
   (gct-shuffle-left-all-heads-p
    a b a-prime1 b-prime1 c1 a1 b1)))

;; Symmetric innermost continuation for the branch that pops from B1.

(defun gct-shuffle-right-c2-result-p
    (a b a-prime1 b-prime1 c1 a1 b1
       b-prime2 b2 o4 c2)
  (declare (ignore b-prime1))
  (implies
   (equal c2 (cons o4 c1))
   (and
    (and
     (<= 0 (+ (len a1) (len b1)))
     (< (+ (len a1) (len b2))
        (+ (len a1) (len b1))))
    (equal
     (reverse a)
     (append (reverse a1) a-prime1))
    (equal
     (reverse b)
     (append (reverse b2) b-prime2))
    (gct-shuffle-p
     a-prime1
     b-prime2
     c2))))

(defun-sk gct-shuffle-right-all-c2-p
    (a b a-prime1 b-prime1 c1 a1 b1
       b-prime2 b2 o4)
  (forall (c2)
    (implies
     (gct-shuffle-int-list-p c2)
     (gct-shuffle-right-c2-result-p
      a b a-prime1 b-prime1 c1 a1 b1
      b-prime2 b2 o4 c2))))

;; The source match on B1 is false for NIL and otherwise exposes its head O4
;; and tail stack B2.

(defun gct-shuffle-right-pop-result-p
    (a b a-prime1 b-prime1 c1 a1 b1
       b-prime2 b2 o4)
  (implies
   (and
    (consp b1)
    (equal o4 (car b1))
    (equal b2 (cdr b1)))
   (gct-shuffle-right-all-c2-p
    a b a-prime1 b-prime1 c1 a1 b1
    b-prime2 b2 o4)))

(defun-sk gct-shuffle-right-all-pop-results-p
    (a b a-prime1 b-prime1 c1 a1 b1
       b-prime2)
  (forall (b2 o4)
    (implies
     (and
      (gct-shuffle-int-list-p b2)
      (integerp o4))
     (gct-shuffle-right-pop-result-p
      a b a-prime1 b-prime1 c1 a1 b1
      b-prime2 b2 o4))))

(defun gct-shuffle-right-push-result-p
    (a b a-prime1 b-prime1 c1 a1 b1
       o3 b-prime2)
  (implies
   (equal b-prime2 (cons o3 b-prime1))
   (and
    (not (equal b1 nil))
    (gct-shuffle-right-all-pop-results-p
     a b a-prime1 b-prime1 c1 a1 b1
     b-prime2))))

(defun-sk gct-shuffle-right-all-push-results-p
    (a b a-prime1 b-prime1 c1 a1 b1
       o3)
  (forall (b-prime2)
    (implies
     (gct-shuffle-int-list-p b-prime2)
     (gct-shuffle-right-push-result-p
      a b a-prime1 b-prime1 c1 a1 b1
      o3 b-prime2))))

;; The outer match on B1 exposes its head O3.

(defun gct-shuffle-right-head-result-p
    (a b a-prime1 b-prime1 c1 a1 b1 o3)
  (implies
   (and
    (consp b1)
    (equal o3 (car b1)))
   (gct-shuffle-right-all-push-results-p
    a b a-prime1 b-prime1 c1 a1 b1 o3)))

(defun-sk gct-shuffle-right-all-heads-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (forall (o3)
    (implies
     (integerp o3)
     (gct-shuffle-right-head-result-p
      a b a-prime1 b-prime1 c1 a1 b1 o3))))

(defun gct-shuffle-right-branch-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (and
   (not (equal b1 nil))
   (gct-shuffle-right-all-heads-p
    a b a-prime1 b-prime1 c1 a1 b1)))

;; O2 selects the same source conditional between the two pop branches.

(defun gct-shuffle-o2-constraint-p (a1 b1 o2)
  (if (not (equal a1 nil))
      (implies
       (equal b1 nil)
       (equal o2 t))
    (equal o2 nil)))

(defun gct-shuffle-o2-result-p
    (a b a-prime1 b-prime1 c1 a1 b1 o2)
  (implies
   (gct-shuffle-o2-constraint-p a1 b1 o2)
   (if (equal o2 t)
       (gct-shuffle-left-branch-p
        a b a-prime1 b-prime1 c1 a1 b1)
     (gct-shuffle-right-branch-p
      a b a-prime1 b-prime1 c1 a1 b1))))

(defun-sk gct-shuffle-all-o2-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (forall (o2)
    (implies
     (booleanp o2)
     (gct-shuffle-o2-result-p
      a b a-prime1 b-prime1 c1 a1 b1 o2))))

;; O1 is exactly the loop guard's Boolean value.  If it is false, the VC
;; continues to O2; if it is true, both stacks are empty and the final shuffle
;; postcondition is required.

(defun gct-shuffle-o1-constraint-p (a1 b1 o1)
  (if (equal a1 nil)
      (equal
       o1
       (if (equal b1 nil) t nil))
    (equal o1 nil)))

(defun gct-shuffle-o1-result-p
    (a b a-prime1 b-prime1 c1 a1 b1 o1)
  (implies
   (gct-shuffle-o1-constraint-p a1 b1 o1)
   (if (not (equal o1 t))
       (gct-shuffle-all-o2-p
        a b a-prime1 b-prime1 c1 a1 b1)
     (and
      (equal a1 nil)
      (equal b1 nil)
      (gct-shuffle-p
       (reverse a)
       (reverse b)
       c1)))))

(defun-sk gct-shuffle-all-o1-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (forall (o1)
    (implies
     (booleanp o1)
     (gct-shuffle-o1-result-p
      a b a-prime1 b-prime1 c1 a1 b1 o1))))

;; Preserve the universally quantified loop state and its full invariant
;; antecedent.

(defun gct-shuffle-loop-state-result-p
    (a b a-prime1 b-prime1 c1 a1 b1)
  (implies
   (and
    (equal
     (reverse a)
     (append (reverse a1) a-prime1))
    (equal
     (reverse b)
     (append (reverse b1) b-prime1))
    (gct-shuffle-p
     a-prime1
     b-prime1
     c1))
   (gct-shuffle-all-o1-p
    a b a-prime1 b-prime1 c1 a1 b1)))

(defun-sk gct-shuffle-all-loop-states-p (a b)
  (forall (b-prime1 a-prime1 c1 b1 a1)
    (implies
     (and
      (gct-shuffle-int-list-p b-prime1)
      (gct-shuffle-int-list-p a-prime1)
      (gct-shuffle-int-list-p c1)
      (gct-shuffle-int-list-p b1)
      (gct-shuffle-int-list-p a1))
     (gct-shuffle-loop-state-result-p
      a b a-prime1 b-prime1 c1 a1 b1))))

;; This predicate is the complete unproved verification condition.

(defun
  ntp4vc-pearl-unraveling-a-card-trick-gilbreathcardtrick-shuffleqtvc-statement
  (c a-prime b-prime a b)
  (implies
   (and
    (gct-shuffle-int-list-p c)
    (gct-shuffle-int-list-p a-prime)
    (gct-shuffle-int-list-p b-prime)
    (gct-shuffle-int-list-p a)
    (gct-shuffle-int-list-p b)
    (equal c nil)
    (equal a-prime nil)
    (equal b-prime nil))
   (and
    (equal
     (reverse a)
     (append (reverse a) a-prime))
    (equal
     (reverse b)
     (append (reverse b) b-prime))
    (gct-shuffle-p
     a-prime
     b-prime
     c)
    (gct-shuffle-all-loop-states-p
     a b))))

(set-inhibit-output-lst nil)
(value-triple :itpeval-statement-checked)
:q
