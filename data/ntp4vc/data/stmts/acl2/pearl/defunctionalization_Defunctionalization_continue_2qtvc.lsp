;; Statement-only formalization of NTP4VC corpus artifact
;; pearl/defunctionalization_Defunctionalization_continue_2qtvc: the
;; continuation-evaluation verification condition, relating constructor-specific
;; size decrease to preservation of the inductively generated evaluation relation.
;; This file contains no proof.

(in-package "ACL2")

(set-inhibit-output-lst '(prove proof-tree event summary))

;; Expressions are exact finite constructor records:
;; (:DFC-CTE integer) and (:DFC-SUB expression expression).

(defun dfc-cte-shape-p (expression)
  (and
   (true-listp expression)
   (equal (len expression) 2)
   (equal (car expression) :dfc-cte)))

(defun dfc-sub-shape-p (expression)
  (and
   (true-listp expression)
   (equal (len expression) 3)
   (equal (car expression) :dfc-sub)))

(defun dfc-expr-p (expression)
  (declare (xargs :measure (acl2-count expression)))
  (cond
   ((dfc-cte-shape-p expression)
    (integerp (cadr expression)))
   ((dfc-sub-shape-p expression)
    (and
     (dfc-expr-p (cadr expression))
     (dfc-expr-p (caddr expression))))
   (t nil)))

(defun dfc-cte-value (expression)
  (cadr expression))

(defun dfc-sub-left (expression)
  (cadr expression))

(defun dfc-sub-right (expression)
  (caddr expression))

(defun dfc-eval-0 (expression)
  (declare (xargs :measure (acl2-count expression)))
  (cond
   ((dfc-cte-shape-p expression)
    (dfc-cte-value expression))
   ((dfc-sub-shape-p expression)
    (-
     (dfc-eval-0 (dfc-sub-left expression))
     (dfc-eval-0 (dfc-sub-right expression))))
   (t 0)))

(defun dfc-size-e (expression)
  (declare (xargs :measure (acl2-count expression)))
  (cond
   ((dfc-cte-shape-p expression)
    1)
   ((dfc-sub-shape-p expression)
    (+
     3
     (dfc-size-e (dfc-sub-left expression))
     (dfc-size-e (dfc-sub-right expression))))
   (t 0)))

;; Continuations are exact finite constructor records:
;; (:DFC-A1 expression continuation), (:DFC-A2 integer continuation), and
;; (:DFC-I).

(defun dfc-a1-shape-p (continuation)
  (and
   (true-listp continuation)
   (equal (len continuation) 3)
   (equal (car continuation) :dfc-a1)))

(defun dfc-a2-shape-p (continuation)
  (and
   (true-listp continuation)
   (equal (len continuation) 3)
   (equal (car continuation) :dfc-a2)))

(defun dfc-i-shape-p (continuation)
  (equal continuation (list :dfc-i)))

(defun dfc-cont-p (continuation)
  (declare (xargs :measure (acl2-count continuation)))
  (cond
   ((dfc-a1-shape-p continuation)
    (and
     (dfc-expr-p (cadr continuation))
     (dfc-cont-p (caddr continuation))))
   ((dfc-a2-shape-p continuation)
    (and
     (integerp (cadr continuation))
     (dfc-cont-p (caddr continuation))))
   ((dfc-i-shape-p continuation)
    t)
   (t nil)))

(defun dfc-cont-a1-expression (continuation)
  (cadr continuation))

(defun dfc-cont-a2-value (continuation)
  (cadr continuation))

(defun dfc-cont-tail (continuation)
  (caddr continuation))

(defun dfc-cont-a2 (value continuation)
  (list :dfc-a2 value continuation))

(defun dfc-size-c (continuation)
  (declare (xargs :measure (acl2-count continuation)))
  (cond
   ((dfc-a1-shape-p continuation)
    (+
     2
     (dfc-size-e
      (dfc-cont-a1-expression continuation))
     (dfc-size-c
      (dfc-cont-tail continuation))))
   ((dfc-a2-shape-p continuation)
    (+
     1
     (dfc-size-c
      (dfc-cont-tail continuation))))
   ((dfc-i-shape-p continuation)
    0)
   (t 0)))

;; A derivation is a finite tree whose outer tag records one of the source
;; inductive rules. Existence of such a tree is bidirectionally equivalent to
;; membership in the least relation generated by rules a1, a2, and a3.

(defun dfc-unary-derivation-shape-p (tag derivation)
  (and
   (true-listp derivation)
   (equal (len derivation) 2)
   (equal (car derivation) tag)))

(defun dfc-a3-derivation-shape-p (derivation)
  (equal derivation (list :dfc-eval-a3)))

(defun dfc-eval-cont-derivation-p
    (derivation continuation value result)
  (declare (xargs :measure (acl2-count derivation)))
  (and
   (dfc-cont-p continuation)
   (integerp value)
   (integerp result)
   (cond
    ((dfc-unary-derivation-shape-p
      :dfc-eval-a1 derivation)
     (and
      (dfc-a1-shape-p continuation)
      (dfc-eval-cont-derivation-p
       (cadr derivation)
       (dfc-cont-a2
        value
        (dfc-cont-tail continuation))
       (dfc-eval-0
        (dfc-cont-a1-expression continuation))
       result)))
    ((dfc-unary-derivation-shape-p
      :dfc-eval-a2 derivation)
     (and
      (dfc-a2-shape-p continuation)
      (dfc-eval-cont-derivation-p
       (cadr derivation)
       (dfc-cont-tail continuation)
       (-
        (dfc-cont-a2-value continuation)
        value)
       result)))
    ((dfc-a3-derivation-shape-p derivation)
     (and
      (dfc-i-shape-p continuation)
      (equal result value)))
    (t nil))))

(defun-sk dfc-eval-cont-p
    (continuation value result)
  (exists (derivation)
    (dfc-eval-cont-derivation-p
     derivation continuation value result)))

;; This is the first matched conjunct of the source verification condition.

(defun dfc-size-obligation-p (continuation value)
  (cond
   ((dfc-a1-shape-p continuation)
    (and
     (<= 0 (dfc-size-c continuation))
     (<
      (+
       (dfc-size-c
        (dfc-cont-a2
         value
         (dfc-cont-tail continuation)))
       (dfc-size-e
        (dfc-cont-a1-expression continuation)))
      (dfc-size-c continuation))))
   ((dfc-a2-shape-p continuation)
    (and
     (<= 0 (dfc-size-c continuation))
     (<
      (dfc-size-c
       (dfc-cont-tail continuation))
      (dfc-size-c continuation))))
   ((dfc-i-shape-p continuation)
    t)
   (t nil)))

;; This is the matched antecedent of the universally quantified continuation
;; result implication.

(defun dfc-result-premise-p
    (continuation value result)
  (cond
   ((dfc-a1-shape-p continuation)
    (dfc-eval-cont-p
     (dfc-cont-a2
      value
      (dfc-cont-tail continuation))
     (dfc-eval-0
      (dfc-cont-a1-expression continuation))
     result))
   ((dfc-a2-shape-p continuation)
    (dfc-eval-cont-p
     (dfc-cont-tail continuation)
     (-
      (dfc-cont-a2-value continuation)
      value)
     result))
   ((dfc-i-shape-p continuation)
    (equal result value))
   (t nil)))

(defun-sk dfc-all-results-p (continuation value)
  (forall (result)
    (implies
     (integerp result)
     (implies
      (dfc-result-premise-p
       continuation value result)
      (dfc-eval-cont-p
       continuation value result)))))

(defun
  ntp4vc-pearl-defunctionalization-defunctionalization-continue-2qtvc-statement
  (continuation value)
  (implies
   (and
    (dfc-cont-p continuation)
    (integerp value))
   (and
    (dfc-size-obligation-p continuation value)
    (dfc-all-results-p continuation value))))

(set-inhibit-output-lst nil)
(value-triple :itpeval-statement-checked)
:q
