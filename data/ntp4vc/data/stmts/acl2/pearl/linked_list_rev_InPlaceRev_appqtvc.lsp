;; Statement-only formalization of NTP4VC corpus artifact
;; pearl/linked_list_rev_InPlaceRev_appqtvc: the linked-list append
;; verification condition for disjoint list segments and the final pointer
;; update joining the first segment to the second. This file contains no proof.

(in-package "ACL2")

(set-inhibit-output-lst '(prove proof-tree event summary))

;; LOC-P relativizes ACL2's universe to the source's arbitrary inhabited
;; location type. NULL and NEXT are conservative generic interfaces for the
;; source constant and the universally arbitrary loc -> loc function. Their
;; source typing laws are explicit in the statement predicate.

(defstub ll-app-loc-p (x) t)
(defstub ll-app-null () t)
(defstub ll-app-next (x) t)

(defun-sk ll-app-next-typed-p ()
  (forall (x)
    (implies
     (ll-app-loc-p x)
     (ll-app-loc-p (ll-app-next x)))))

(defun ll-app-interface-p ()
  (and
   (ll-app-loc-p (ll-app-null))
   (ll-app-next-typed-p)))

(defun ll-app-loc-list-p (xs)
  (if (consp xs)
      (and
       (ll-app-loc-p (car xs))
       (ll-app-loc-list-p (cdr xs)))
    (equal xs nil)))

;; The source Boolean equality is completely characterized by eq_loc'spec, so
;; ACL2 equality is a definitionally equivalent implementation.

(defun ll-app-eq-loc (left right)
  (equal left right))

(defun ll-app-disjoint-core-p (left right)
  (if (consp left)
      (and
       (not (member-equal (car left) right))
       (ll-app-disjoint-core-p (cdr left) right))
    (equal left nil)))

(defun ll-app-disjoint-p (left right)
  (and
   (ll-app-loc-list-p left)
   (ll-app-loc-list-p right)
   (ll-app-disjoint-core-p left right)))

;; This structural recursion is exactly the least relation generated by the
;; source list_seg_nil and list_seg_cons constructors.

(defun ll-app-list-seg-core-p (p xs q)
  (declare (xargs :measure (acl2-count xs)))
  (if (consp xs)
      (and
       (equal (car xs) p)
       (not (equal p (ll-app-null)))
       (ll-app-list-seg-core-p
        (ll-app-next p)
        (cdr xs)
        q))
    (and
     (equal xs nil)
     (equal p q))))

(defun ll-app-list-seg-p (p xs q)
  (and
   (ll-app-loc-p p)
   (ll-app-loc-list-p xs)
   (ll-app-loc-p q)
   (ll-app-list-seg-core-p p xs q)))

;; This is the source functional update next(p := l2).

(defun ll-app-updated-next (update-key update-value location)
  (if (equal location update-key)
      update-value
    (ll-app-next location)))

(defun ll-app-updated-list-seg-core-p
    (update-key update-value p xs q)
  (declare (xargs :measure (acl2-count xs)))
  (if (consp xs)
      (and
       (equal (car xs) p)
       (not (equal p (ll-app-null)))
       (ll-app-updated-list-seg-core-p
        update-key
        update-value
        (ll-app-updated-next
         update-key update-value p)
        (cdr xs)
        q))
    (and
     (equal xs nil)
     (equal p q))))

(defun ll-app-updated-list-seg-p
    (update-key update-value p xs q)
  (and
   (ll-app-loc-p update-key)
   (ll-app-loc-p update-value)
   (ll-app-loc-p p)
   (ll-app-loc-list-p xs)
   (ll-app-loc-p q)
   (ll-app-updated-list-seg-core-p
    update-key update-value p xs q)))

;; This is the nonempty PM branch of the source pattern match. The repeated
;; match contributes the explicit tail equality retained below.

(defun ll-app-nonempty-step-p
    (l1 l1m l1pm pm p)
  (if (consp pm)
      (let ((head (car pm))
            (tail (cdr pm)))
        (and
         (not (equal p (ll-app-null)))
         (equal (cdr pm) tail)
         (not
          (equal
           (ll-app-next p)
           (ll-app-null)))
         (ll-app-list-seg-p
          l1
          (append l1pm (list head))
          (ll-app-next p))
         (ll-app-list-seg-p
          (ll-app-next p)
          tail
          (ll-app-null))
         (equal
          (append
           (append l1pm (list head))
           tail)
          l1m)
         (ll-app-disjoint-p
          (append l1pm (list head))
          tail)))
    nil))

;; The implication preserves the local equality-test specification antecedent
;; and the exact split between advancing through PM and updating NEXT at P.

(defun ll-app-loop-case-p
    (l1 l1m l2 l2m l1pm pm p)
  (implies
   (and
    (not (equal p (ll-app-null)))
    (ll-app-list-seg-p l1 l1pm p)
    (ll-app-list-seg-p
     p pm (ll-app-null))
    (equal (append l1pm pm) l1m)
    (ll-app-disjoint-p l1pm pm))
   (and
    (not (equal p (ll-app-null)))
    (let* ((o3 (ll-app-null))
           (o4 (ll-app-next p))
           (o5 (ll-app-eq-loc o4 o3)))
      (implies
       (equal
        (equal o5 t)
        (equal o4 o3))
       (if (not (equal o5 t))
           (ll-app-nonempty-step-p
            l1 l1m l1pm pm p)
         (and
          (not (equal p (ll-app-null)))
          (ll-app-updated-list-seg-p
           p
           l2
           l1
           (append l1m l2m)
           (ll-app-null)))))))))

(defun-sk ll-app-all-loop-cases-p
    (l1 l1m l2 l2m)
  (forall (l1pm pm p)
    (ll-app-loop-case-p
     l1 l1m l2 l2m l1pm pm p)))

(defun
  ntp4vc-pearl-linked-list-rev-inplacerev-appqtvc-statement
  (l1 l1m l2 l2m)
  (implies
   (and
    (ll-app-interface-p)
    (ll-app-list-seg-p
     l1 l1m (ll-app-null))
    (ll-app-list-seg-p
     l2 l2m (ll-app-null))
    (ll-app-disjoint-p l1m l2m))
   (let* ((o1 (ll-app-null))
          (o2 (ll-app-eq-loc l1 o1)))
     (implies
      (equal
       (equal o2 t)
       (equal l1 o1))
      (if (equal o2 t)
          (ll-app-list-seg-p
           l2
           (append l1m l2m)
           (ll-app-null))
        (and
         (not (equal l1 (ll-app-null)))
         (ll-app-list-seg-p l1 nil l1)
         (ll-app-list-seg-p
          l1 l1m (ll-app-null))
         (equal (append nil l1m) l1m)
         (ll-app-disjoint-p nil l1m)
         (ll-app-all-loop-cases-p
          l1 l1m l2 l2m)))))))

(set-inhibit-output-lst nil)
(value-triple :itpeval-statement-checked)
:q
