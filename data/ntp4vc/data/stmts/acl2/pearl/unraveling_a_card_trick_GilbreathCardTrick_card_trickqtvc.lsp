;; Statement-only formalization of NTP4VC corpus artifact
;; pearl/unraveling_a_card_trick_GilbreathCardTrick_card_trickqtvc: the
;; card-trick cut-loop verification condition over integer stacks, riffle
;; shuffles, and suit-order invariants. This file contains no proof.

(in-package "ACL2")

(set-inhibit-output-lst '(prove proof-tree event summary))

;; This verification condition observes each source stack only through its
;; finite list of integer elements; its length is therefore ACL2 LEN.

(defun gct-card-int-list-p (xs)
  (declare (xargs :measure (acl2-count xs)))
  (if (consp xs)
      (and
       (integerp (car xs))
       (gct-card-int-list-p (cdr xs)))
    (equal xs nil)))

;; Why3 list lookup returns an option, including NONE for every invalid
;; mathematical-integer index.

(defun gct-card-nth-option (xs index)
  (if (and
       (integerp index)
       (<= 0 index)
       (< index (len xs)))
      (cons :some (nth index xs))
    :none))

;; This recursive relation is the least finite-list relation generated by the
;; four source shuffle constructors.

(defun gct-card-shuffle-p (left right shuffled)
  (declare (xargs :measure (acl2-count shuffled)))
  (if (consp shuffled)
      (or
       (and
        (consp left)
        (equal (car left) (car shuffled))
        (gct-card-shuffle-p
         (cdr left)
         right
         (cdr shuffled)))
       (and
        (consp right)
        (equal (car right) (car shuffled))
        (gct-card-shuffle-p
         left
         (cdr right)
         (cdr shuffled))))
    (and
     (equal shuffled nil)
     (equal left nil)
     (equal right nil))))

;; The source's ordered-deck predicate: N blocks, each containing
;; 0, 1, ..., M-1 in that order.

(defun-sk gct-card-suit-ordered-p (xs n m)
  (forall (i j)
    (implies
     (and
      (integerp i)
      (integerp j))
     (implies
      (and
       (<= 0 i)
       (< i n))
      (implies
       (and
        (<= 0 j)
       (< j m))
       (equal
        (gct-card-nth-option xs (+ (* i m) j))
        (cons :some j)))))))

;; These two quantified clauses use the corrected SUIT_SORTED specification.
;; Pairwise option inequality is required only for distinct bounded indices;
;; the pinned source accidentally omitted this necessary premise.

(defun-sk gct-card-suit-values-p (xs m)
  (forall (i value)
    (implies
     (and
      (integerp i)
      (integerp value))
     (implies
      (equal
       (gct-card-nth-option xs i)
       (cons :some value))
      (and
       (<= 0 value)
       (< value m))))))

(defun-sk gct-card-suit-distinct-p (xs n m)
  (forall (i j1 j2)
    (implies
     (and
      (integerp i)
      (integerp j1)
      (integerp j2))
     (implies
      (and
       (<= 0 i)
       (< i n))
      (implies
       (and
        (<= 0 j1)
        (< j1 m))
       (implies
        (and
         (<= 0 j2)
         (< j2 m)
         (not (equal j1 j2)))
        (not
         (equal
          (gct-card-nth-option xs (+ (* i m) j1))
          (gct-card-nth-option xs (+ (* i m) j2))))))))))

(defun gct-card-suit-sorted-p (xs n m)
  (and
   (gct-card-suit-values-p xs m)
   (gct-card-suit-distinct-p xs n m)))

;; The nondeterministic cut result remains existentially quantified inside the
;; statement, with exactly the source interval.

(defun-sk gct-card-cut-result-exists-p (n m)
  (exists (result)
    (and
     (integerp result)
     (<= 0 result)
     (<= result (* n m)))))

;; Continuation after pushing the popped card O1 onto D1.

(defun-sk gct-card-all-push-results-p (a n m d1 a2 o1 i)
  (forall (d2)
    (implies
     (gct-card-int-list-p d2)
     (implies
      (equal d2 (cons o1 d1))
      (and
       (equal
        (len a2)
        (+ (- (* n m) (+ i 1)) 1))
       (equal
        (len d2)
        (- (+ i 1) 1))
       (equal
        a
        (append (reverse d2) a2)))))))

;; The source stack pop match is false on NIL and otherwise exposes the head
;; card and tail stack.

(defun-sk gct-card-all-pop-results-p (a n m d1 a1 i)
  (forall (a2 o1)
    (implies
     (and
      (gct-card-int-list-p a2)
      (integerp o1))
     (implies
      (and
       (consp a1)
       (equal o1 (car a1))
       (equal a2 (cdr a1)))
      (gct-card-all-push-results-p
       a n m d1 a2 o1 i)))))

(defun gct-card-iteration-step-p (a n m cut d1 a1 i)
  (implies
   (and
    (integerp i)
    (<= 1 i)
    (<= i cut)
    (equal
     (len a1)
     (+ (- (* n m) i) 1))
    (equal
     (len d1)
     (- i 1))
    (equal
     a
     (append (reverse d1) a1)))
   (and
    (not (equal a1 nil))
    (gct-card-all-pop-results-p
     a n m d1 a1 i))))

(defun-sk gct-card-all-iterations-p (a n m cut d1 a1)
  (forall (i)
    (gct-card-iteration-step-p
     a n m cut d1 a1 i)))

;; Every possible result of the source shuffle call retains its universal
;; scope. The emptied input stacks A2 and D2 are also kept explicitly.

(defun-sk gct-card-all-shuffle-results-p (left right n m)
  (forall (d2 a2 result)
    (implies
     (and
      (gct-card-int-list-p d2)
      (gct-card-int-list-p a2)
      (gct-card-int-list-p result))
     (implies
      (and
       (equal a2 nil)
       (equal d2 nil)
       (gct-card-shuffle-p
        (reverse left)
        (reverse right)
        result))
      (and
       (equal (len result) (* n m))
       (gct-card-suit-sorted-p result n m))))))

(defun gct-card-loop-state-p (a n m cut d1 a1)
  (and
   (gct-card-all-iterations-p
    a n m cut d1 a1)
   (implies
    (and
     (equal
      (len a1)
      (+ (- (* n m) (+ cut 1)) 1))
     (equal
      (len d1)
      (- (+ cut 1) 1))
     (equal
      a
      (append (reverse d1) a1)))
    (gct-card-all-shuffle-results-p
     a1 d1 n m))))

(defun-sk gct-card-all-loop-states-p (a n m cut)
  (forall (d1 a1)
    (implies
     (and
      (gct-card-int-list-p d1)
      (gct-card-int-list-p a1))
     (gct-card-loop-state-p
      a n m cut d1 a1))))

(defun gct-card-initial-state-p (a dprime n m)
  (and
   (equal
    (len a)
    (+ (- (* n m) 1) 1))
   (equal
    (len dprime)
    (- 1 1))
   (equal
    a
    (append (reverse dprime) a))))

(defun gct-card-cut-case-p (a dprime n m cut)
  (and
   (implies
    (<= 1 (+ cut 1))
    (and
     (gct-card-initial-state-p
      a dprime n m)
     (gct-card-all-loop-states-p
      a n m cut)))
   (implies
    (< (+ cut 1) 1)
    (gct-card-all-shuffle-results-p
     a dprime n m))))

(defun-sk gct-card-all-cuts-p (a dprime n m)
  (forall (cut)
    (implies
     (integerp cut)
     (implies
      (and
       (<= 0 cut)
       (<= cut (* n m)))
      (gct-card-cut-case-p
       a dprime n m cut)))))

(defun
  ntp4vc-pearl-unraveling-a-card-trick-gilbreathcardtrick-card-trickqtvc-statement
  (m n a dprime)
  (implies
   (and
    (integerp m)
    (< 0 m)
    (integerp n)
    (<= 0 n)
    (gct-card-int-list-p a)
    (gct-card-int-list-p dprime)
    (equal (len a) (* n m))
    (gct-card-suit-ordered-p a n m)
    (equal dprime nil))
   (and
    (gct-card-cut-result-exists-p n m)
    (gct-card-all-cuts-p a dprime n m))))

(set-inhibit-output-lst nil)
(value-triple :itpeval-statement-checked)
:q
