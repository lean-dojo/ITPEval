;; Statement-only formalization of NTP4VC corpus artifact
;; pearl/search_Dfs_dfsqtvc: the depth-first-search verification condition
;; for bounded successful paths and preservation of the child-search loop
;; invariant. This file contains no proof.

(in-package "ACL2")

(set-inhibit-output-lst '(prove proof-tree event summary))

;; The source state type is an arbitrary inhabited carrier.  These
;; conservative interfaces preserve its moves function and success predicate;
;; their source typing requirements are explicit in the statement predicate.

(defstub dfs-state-p (x) t)
(defstub dfs-default-state () t)
(defstub dfs-moves (node) t)
(defstub dfs-success (node) t)

(defun dfs-state-list-p (xs)
  (if (consp xs)
      (and
       (dfs-state-p (car xs))
       (dfs-state-list-p (cdr xs)))
    (equal xs nil)))

(defun-sk dfs-moves-typed-p ()
  (forall (node)
    (implies
     (dfs-state-p node)
     (dfs-state-list-p (dfs-moves node)))))

(defun dfs-interface-p ()
  (and
   (dfs-state-p (dfs-default-state))
   (dfs-moves-typed-p)))

;; This is the source conversion from an integer to a natural index, followed
;; by total list indexing with the source's fixed inhabited default.

(defun dfs-int-to-nat (value)
  (if (and
       (integerp value)
       (< value 0))
      0
    (nfix value)))

(defun dfs-nth-state (xs index)
  (let ((tail
         (nthcdr
          (dfs-int-to-nat index)
          xs)))
    (if (consp tail)
        (car tail)
      (dfs-default-state))))

;; One source edge is exactly selection of an in-bounds element of moves.

(defun-sk dfs-edge-p (source target)
  (exists (index)
    (and
     (dfs-state-p source)
     (dfs-state-p target)
     (integerp index)
     (<= 0 index)
     (< index (len (dfs-moves source)))
     (equal
      target
      (dfs-nth-state
       (dfs-moves source)
       index)))))

;; A finite walk lists its successive states.  Existence of a walk containing
;; n edges is equivalent to the least relation generated by the source
;; constructors Path0, Path1, and Patht.

(defun dfs-walk-p (states)
  (if (consp states)
      (if (consp (cdr states))
          (and
           (dfs-edge-p
            (car states)
            (car (cdr states)))
           (dfs-walk-p (cdr states)))
        (equal (cdr states) nil))
    (equal states nil)))

(defun-sk dfs-path-p (source target length)
  (exists (states)
    (and
     (dfs-state-p source)
     (dfs-state-p target)
     (integerp length)
     (<= 0 length)
     (dfs-state-list-p states)
     (equal (len states) (+ length 1))
     (consp states)
     (equal (car states) source)
     (equal (car (last states)) target)
     (dfs-walk-p states))))

;; This is the NoSolution postcondition at a source state and remaining depth.

(defun-sk dfs-no-bounded-success-path-p
    (source bound)
  (forall (target length)
    (implies
     (and
      (dfs-state-p target)
      (integerp length))
     (implies
      (and
       (<= 0 length)
       (<= length bound))
      (implies
       (dfs-success target)
       (not
        (dfs-path-p
         source target length)))))))

;; The for-loop invariant excludes successful paths of length below m-p from
;; every child with an index strictly below the current loop position.

(defun-sk dfs-processed-children-clear-p
    (moves limit p m)
  (forall (index target length)
    (implies
     (and
      (integerp index)
      (dfs-state-p target)
      (integerp length))
     (implies
      (and
       (<= 0 index)
       (< index limit))
      (implies
       (dfs-path-p
        (dfs-nth-state moves index)
        target
        length)
       (implies
        (dfs-success target)
        (not
         (and
          (<= 0 length)
          (< length (- m p))))))))))

;; For a recursive child result Solution(target,length), the source
;; postcondition must extend its path by one edge from the current state.

(defun dfs-solution-result-preserved-p
    (source child p m target length)
  (let* ((next-depth (+ p 1))
         (extended-length (+ length 1)))
    (implies
     (and
      (dfs-path-p child target length)
      (dfs-success target)
      (<= 0 length)
      (<= length (- m next-depth)))
     (and
      (dfs-path-p
       source target extended-length)
      (dfs-success target)
      (<= 0 extended-length)
      (<= extended-length (- m p))))))

(defun-sk dfs-all-solution-results-preserved-p
    (source child p m)
  (forall (target length)
    (implies
     (and
      (dfs-state-p target)
      (integerp length))
     (dfs-solution-result-preserved-p
      source child p m target length))))

;; The source outcome datatype has exactly NoSolution and
;; Solution(state,integer).  This conjunction is therefore exactly its
;; universally quantified case split.

(defun dfs-all-outcomes-preserved-p
    (source child moves index p m)
  (let ((next-depth (+ p 1)))
    (and
     (implies
      (dfs-no-bounded-success-path-p
       child
       (- m next-depth))
      (dfs-processed-children-clear-p
       moves
       (+ index 1)
       p
       m))
     (dfs-all-solution-results-preserved-p
      source child p m))))

;; This is the complete body required after selecting one in-bounds child.

(defun dfs-child-step-p
    (p m source moves index)
  (let* ((next-depth (+ p 1))
         (child
          (dfs-nth-state moves index)))
    (and
     (and
      (and
       (<= 0 (- m p))
       (< (- m next-depth)
          (- m p)))
      (<= 0 next-depth)
      (<= next-depth (+ m 1)))
     (dfs-all-outcomes-preserved-p
      source child moves index p m))))

(defun-sk dfs-all-child-steps-p
    (p m source moves last-index)
  (forall (index)
    (implies
     (integerp index)
     (implies
      (and
       (and
        (<= 0 index)
        (<= index last-index))
       (dfs-processed-children-clear-p
        moves index p m))
      (dfs-child-step-p
       p m source moves index)))))

;; This reproduces the generated verification condition for the moves loop,
;; including its explicit empty-range and loop-exit implications.

(defun dfs-moves-loop-p (p m source)
  (let* ((moves (dfs-moves source))
         (last-index (- (len moves) 1))
         (after-last (+ last-index 1)))
    (and
     (implies
      (<= 0 after-last)
      (and
       (dfs-processed-children-clear-p
        moves 0 p m)
       (dfs-all-child-steps-p
        p m source moves last-index)))
     (implies
      (dfs-processed-children-clear-p
       moves after-last p m)
      (dfs-no-bounded-success-path-p
       source
       (- m p)))
     (implies
      (< after-last 0)
      (dfs-no-bounded-success-path-p
       source
       (- m p))))))

;; The outer conditionals are preserved in source order: exhausted depth,
;; immediate success, and otherwise traversal of all children.

(defun dfs-vc-body-p (p m source)
  (if (< m p)
      (dfs-no-bounded-success-path-p
       source
       (- m p))
    (if (dfs-success source)
        (and
         (dfs-path-p source source 0)
         (dfs-success source)
         (<= 0 0)
         (<= 0 (- m p)))
      (dfs-moves-loop-p p m source))))

(defun-sk ntp4vc-pearl-search-dfs-dfsqtvc-statement ()
  (forall (p m source)
    (implies
     (and
      (integerp p)
      (integerp m)
      (dfs-state-p source))
     (implies
      (and
       (dfs-interface-p)
       (<= 0 p)
       (<= p (+ m 1)))
      (dfs-vc-body-p p m source)))))

(set-inhibit-output-lst nil)
(value-triple :itpeval-statement-checked)
:q
