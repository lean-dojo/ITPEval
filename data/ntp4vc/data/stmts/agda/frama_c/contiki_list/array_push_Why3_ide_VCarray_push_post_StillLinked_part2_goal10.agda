      array-start = shift a4 zeroZ
      next-index = addInt oneZ i3
      a8 =
        update
          (havoc t2 t3 (shift a4 next-index) i1)
          (shift a4 i3)
          (addr zeroZ zeroZ)
    in
    i1 ≠ zeroZ →
    Iff (total ≡ i3) (i ≡ zeroZ) →
    Iff (i3 <Z total) (i ≡ oneZ) →
    a5 a1 ≡ a6 →
    i3 ≤Z i2 →
    i2 ≤Z i3 →
    i3 ≤Z total →
    region (base a) ≤Z zeroZ →
    region (base a1) ≤Z zeroZ →
    region (base a3) ≤Z zeroZ →
    region (base a4) ≤Z zeroZ →
    total ≤Z maximumArrayIndexMinusOne →
    Framed t3 →
    linked allocation →
    IsSint32 i →
