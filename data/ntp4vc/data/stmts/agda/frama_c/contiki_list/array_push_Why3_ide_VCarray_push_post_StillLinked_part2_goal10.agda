    PLinkedN
      allocation a5 a a4 i2
      (subtractInt i3 i2) a2 →
    PLinkedN
      allocation a5 a2 a4 next-index
      (subtractInt (addInt i1 i2) i3) a3 →
    PUnchanged
      allocation a5 float-memory
      allocation t3 float-memory
      a4 i2 i3 →
    ((index : Int) →
