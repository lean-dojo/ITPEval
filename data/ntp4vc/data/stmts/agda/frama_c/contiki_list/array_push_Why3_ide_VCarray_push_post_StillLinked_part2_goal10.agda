      i2 ≤Z right-index →
      i2 ≤Z left-index →
      right-index <Z total →
      left-index <Z total →
      t3 (shift a4 left-index) ≠
      t3 (shift a4 right-index)) →
    ((left-index right-index : Int) →
      left-index ≠ right-index →
      i2 ≤Z right-index →
      i2 ≤Z left-index →
      right-index <Z total →
      left-index <Z total →
      Separated
        (t3 (shift a4 left-index)) fourZ
        (t3 (shift a4 right-index)) fourZ) →
    ((index : Int) →
      i3 <Z index →
      index ≤Z total →
      Separated a1 oneZ (a5 (shift a4 index)) fourZ) →
    ((index : Int) →
      i2 ≤Z index →
      index <Z addInt (addInt i i1) i2 →
      Separated
        (a5 (shift a4 index)) fourZ
        array-start maximumArrayIndex) →
    PLinkedN allocation a8 a a4 next-index i1 a3

array-push-post-still-linked-part2-goal10 : Set₂
