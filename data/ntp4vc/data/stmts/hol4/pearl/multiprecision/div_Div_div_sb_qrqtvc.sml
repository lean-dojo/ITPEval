val sbqr_radix_def = Define `
  sbqr_radix = (18446744073709551616 : int)`;

val sbqr_to_num_def = Define `
  sbqr_to_num (z : int) = if z < (0 : int) then 0 else Num z`;

val sbqr_int32_in_bounds_def = Define `
  sbqr_int32_in_bounds (z : int) <=>
    -(2147483648 : int) <= z /\ z <= (2147483647 : int)`;

val sbqr_uint64_in_bounds_def = Define `
  sbqr_uint64_in_bounds (z : int) <=>
    (0 : int) <= z /\ z <= (18446744073709551615 : int)`;

val sbqr_uint_def = Define `
  sbqr_uint (w : word64) = &(w2n w)`;

val sbqr_uint64_max_def = Define `
  sbqr_uint64_max = (n2w 18446744073709551615 : word64)`;

val _ = set_fixity "sbqr_ipow" (Infixr 700);

val sbqr_ipow_def = Define `
  (base : int) sbqr_ipow (exponent : int) =
    base ** sbqr_to_num exponent`;

(* The observation tuple is exactly (data, offset, min, max, writable, zone). *)
val sbqr_data_def = Define `
  sbqr_data
      (obs :
        'p -> word64 list # (int # (int # (int # (bool # 'z)))))
      (p : 'p) =
    FST (obs p)`;

val sbqr_offset_def = Define `
  sbqr_offset obs (p : 'p) =
    FST (SND (obs p))`;

val sbqr_minimum_def = Define `
  sbqr_minimum obs (p : 'p) =
    FST (SND (SND (obs p)))`;

val sbqr_maximum_def = Define `
  sbqr_maximum obs (p : 'p) =
    FST (SND (SND (SND (obs p))))`;

val sbqr_writable_def = Define `
  sbqr_writable obs (p : 'p) =
    FST (SND (SND (SND (SND (obs p)))))`;

val sbqr_zone_def = Define `
  sbqr_zone obs (p : 'p) =
    SND (SND (SND (SND (SND (obs p)))))`;

val sbqr_pelts_def = Define `
  sbqr_pelts obs (p : 'p) (index : int) =
    if index < (0 : int) then
      (0w : word64)
    else if sbqr_to_num index < LENGTH (sbqr_data obs p) then
      EL (sbqr_to_num index) (sbqr_data obs p)
    else
      (0w : word64)`;

val sbqr_plength_def = Define `
  sbqr_plength obs (p : 'p) = &(LENGTH (sbqr_data obs p))`;

val sbqr_nth_def = Define `
  sbqr_nth (xs : word64 list) (index : int) =
    if sbqr_to_num index < LENGTH xs then
      EL (sbqr_to_num index) xs
    else
      (0w : word64)`;

val sbqr_valid_def = Define `
  sbqr_valid obs (p : 'p) (size : int) <=>
    sbqr_int32_in_bounds size /\
    (0 : int) <= size /\
    ((0 : int) <= sbqr_minimum obs p /\
     sbqr_minimum obs p <= sbqr_offset obs p) /\
    sbqr_offset obs p + size <= sbqr_maximum obs p /\
    sbqr_maximum obs p <= sbqr_plength obs p`;

val sbqr_update_def = Define `
  sbqr_update (f : int -> word64) (index : int) (limb : word64) =
    \query. if query = index then limb else f query`;

val sbqr_value_from_def = Define `
  (sbqr_value_from (f : int -> word64) (index : int) 0 = (0 : int)) /\
  (sbqr_value_from f index (SUC count) =
     sbqr_uint (f index) +
       sbqr_radix *
         sbqr_value_from f (index + (1 : int)) count)`;

val sbqr_value_sub_def = Define `
  sbqr_value_sub (f : int -> word64) (lower : int) (upper : int) =
    sbqr_value_from f lower (sbqr_to_num (upper - lower))`;

val sbqr_value_def = Define `
  sbqr_value obs (p : 'p) (size : int) =
    sbqr_value_sub
      (sbqr_pelts obs p)
      (sbqr_offset obs p)
      (sbqr_offset obs p + size)`;

val sbqr_compare_int_def = Define `
  sbqr_compare_int (x : int) (y : int) =
    if x < y then -(1 : int) else if x = y then (0 : int) else (1 : int)`;

val sbqr_reciprocal_3by2_def = Define `
  sbqr_reciprocal_3by2
      (v : word64) (dh : word64) (dl : word64) <=>
    sbqr_uint v =
      (sbqr_radix * sbqr_radix * sbqr_radix - (1 : int)) /
        (sbqr_uint dl + sbqr_radix * sbqr_uint dh) -
      sbqr_radix`;

val sbqr_normalized_def = Define `
  sbqr_normalized obs (p : 'p) (size : word32) <=>
    sbqr_valid obs p (w2i size) /\
    sbqr_radix / (2 : int) <=
      sbqr_uint
        (sbqr_pelts obs p
          (sbqr_offset obs p + w2i size - (1 : int)))`;

