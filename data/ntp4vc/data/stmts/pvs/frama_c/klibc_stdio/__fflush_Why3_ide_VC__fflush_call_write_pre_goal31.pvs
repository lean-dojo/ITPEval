% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/klibc_stdio/__fflush_Why3_ide_VC__fflush_call_write_pre_goal31:
% nonnegativity of the buffered-output count under the FILE representation,
% pointer-order, allocation-validity, and integer-range preconditions for write.
% This file contains no proof.

fflush_Why3_ide_VC_fflush_call_write_pre_goal31: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  framed(
      region: [int -> int],
      memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  address_order_axioms(
      addr_le: address_relation,
      addr_lt: address_relation): bool =
    (FORALL (p, q: addr):
       base(p) = base(q) IMPLIES
         (addr_le(p, q) IFF offset(p) <= offset(q)))
      AND
    (FORALL (p, q: addr):
       base(p) = base(q) IMPLIES
         (addr_lt(p, q) IFF offset(p) < offset(q)))

  p_valid_file(
      malloc: allocation_table,
      mint: integer_memory,
      file: addr): bool =
    0 <= mint(shift(file, 0))
      AND valid_rw(malloc, file, 3)

  p_valid_io_file_pvt_norec(
      malloc: allocation_table,
      mptr: pointer_memory,
      mint: integer_memory,
      addr_le: address_relation,
      addr_lt: address_relation,
      file: addr): bool =
    LET x: int = mint(shift(file, 9)) IN
    LET x_1: int = mint(shift(file, 7)) IN
    LET x_2: int = mint(shift(file, 8)) IN
    LET a: addr = mptr(shift(file, 5)) IN
    LET a_1: addr = mptr(shift(file, 6)) IN
    LET a_2: addr = mptr(shift(file, 4)) IN
    LET a_3: addr = mptr(shift(file, 3)) IN
    LET a_4: addr = shift(a, 0) IN
    LET x_3: int = 32 + x IN
      x = 16384
        AND 0 <= x_1
        AND x_1 < x
        AND 0 <= x_2
        AND x_2 < x
        AND valid_rw(malloc, file, 11)
        AND addr_le(a, a_1)
        AND p_valid_file(malloc, mint, shift(file, 0))
        AND valid_rw(malloc, a_2, 11)
        AND valid_rw(malloc, a_3, 11)
        AND separated(file, 11, a_2, 11)
        AND separated(file, 11, a_3, 11)
        AND separated(a_2, 11, a_3, 11)
        AND valid_rw(malloc, a_4, x_3)
        AND separated(file, 11, a_4, x_3)
        AND separated(a_2, 11, a_4, x_3)
        AND separated(a_3, 11, a_4, x_3)
        AND addr_lt(a_1, shift(a, x_3))

  p_valid_io_file_pvt(
      malloc: allocation_table,
      mptr: pointer_memory,
      mint: integer_memory,
      addr_le: address_relation,
      addr_lt: address_relation,
      file: addr): bool =
    LET x: int = mint(shift(file, 9)) IN
    LET a: addr = mptr(shift(file, 6)) IN
    LET a_1: addr = mptr(shift(file, 5)) IN
    LET a_2: addr = mptr(shift(file, 3)) IN
    LET a_3: addr = mptr(shift(file, 4)) IN
    LET x_1: int = mint(shift(file, 7)) IN
    LET x_2: int = mint(shift(file, 8)) IN
    LET a_4: addr = shift(a_1, 0) IN
    LET x_3: int = 32 + x IN
      x = 16384
        AND base(a) = base(a_1)
        AND mptr(shift(a_2, 4)) = file
        AND mptr(shift(a_3, 3)) = file
        AND 0 <= x_1
        AND x_1 < x
        AND 0 <= x_2
        AND x_2 < x
        AND valid_rw(malloc, file, 11)
        AND addr_le(a_1, a)
        AND p_valid_file(malloc, mint, shift(file, 0))
        AND separated(file, 11, a_3, 11)
        AND separated(file, 11, a_2, 11)
        AND separated(a_3, 11, a_2, 11)
        AND p_valid_io_file_pvt_norec(
          malloc, mptr, mint, addr_le, addr_lt, a_3)
        AND p_valid_io_file_pvt_norec(
          malloc, mptr, mint, addr_le, addr_lt, a_2)
        AND valid_rw(malloc, a_4, x_3)
        AND separated(file, 11, a_4, x_3)
        AND separated(a_3, 11, a_4, x_3)
        AND separated(a_2, 11, a_4, x_3)
        AND addr_lt(a, shift(a_1, x_3))

  goal31: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (addr_le: address_relation),
      (addr_lt: address_relation),
      (t_2: pointer_memory),
      (a_1, a: addr),
      (t_1: integer_memory),
      (i, i_1: int),
      (t: allocation_table):
      address_order_axioms(addr_le, addr_lt) IMPLIES
      LET a_2: addr = t_2(shift(a_1, 5)) IN
      LET x: int = base(a_2) IN
      LET x_1: int = base(a) IN
      LET x_2: int = base(t_2(shift(a_1, 6))) IN
      LET x_3: int = t_1(shift(a_1, 9)) IN
      LET x_4: int = t_1(shift(shift(a_1, 0), 0)) IN
        i /= 0 IMPLIES
        t_1(shift(a_1, 7)) = 0 IMPLIES
        x = x_1 IMPLIES
        x_2 = x_1 IMPLIES
        x_2 = x IMPLIES
        0 <= i IMPLIES
        i_1 <= i IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        -1 <= i_1 IMPLIES
        framed(region, t_2) IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_sint32(i_1) IMPLIES
        is_uint32(x_3) IMPLIES
        is_uint32(t_1(shift(a_1, 8))) IMPLIES
        p_valid_io_file_pvt(t, t_2, t_1, addr_le, addr_lt, a_1)
          IMPLIES
        addr_le(a_2, a) IMPLIES
        valid_rw(t, shift(a, 0), i) IMPLIES
        is_sint32(x_4) IMPLIES
        addr_le(a, shift(a_2, 32 + x_3)) IMPLIES
        0 <= x_4
END fflush_Why3_ide_VC_fflush_call_write_pre_goal31
