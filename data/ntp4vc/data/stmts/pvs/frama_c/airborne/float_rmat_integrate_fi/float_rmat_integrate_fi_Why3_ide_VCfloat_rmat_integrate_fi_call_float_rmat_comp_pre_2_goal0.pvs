% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/airborne/float_rmat_integrate_fi/float_rmat_integrate_fi_Why3_ide_VCfloat_rmat_integrate_fi_call_float_rmat_comp_pre_2_goal0:
% the validity precondition that a writable nine-real matrix memory block is
% readable and finite in the Why3 real floating-point model. This file contains no proof.

float_rmat_integrate_fi_Why3_ide_VCfloat_rmat_integrate_fi_call_float_rmat_comp_pre_2_goal0[
  region: [int -> int],
  linked: [[int -> int] -> bool]
]: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  real_memory: TYPE = [addr -> real]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + n <= malloc(base(p))

  valid_rd(malloc: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= malloc(base(p))

  % The official Why3 real model makes these predicates true for every real value.
  is_float32(value: real): bool = TRUE
  is_finite32(value: real): bool = TRUE

  p_finite_floatrmat(memory: real_memory, rm: addr): bool =
    LET start: addr = shift(rm, 0)
    IN
      is_finite32(memory(shift(start, 0)))
        AND is_finite32(memory(shift(start, 1)))
        AND is_finite32(memory(shift(start, 2)))
        AND is_finite32(memory(shift(start, 3)))
        AND is_finite32(memory(shift(start, 4)))
        AND is_finite32(memory(shift(start, 5)))
        AND is_finite32(memory(shift(start, 6)))
        AND is_finite32(memory(shift(start, 7)))
        AND is_finite32(memory(shift(start, 8)))

  p_rvalid_floatrmat(
      malloc: allocation_table,
      memory: real_memory,
      rm: addr): bool =
    p_finite_floatrmat(memory, rm)
      AND valid_rd(malloc, rm, 9)

  p_finite_floatrates(memory: real_memory, rates: addr): bool =
    is_finite32(memory(shift(rates, 0)))
      AND is_finite32(memory(shift(rates, 1)))
      AND is_finite32(memory(shift(rates, 2)))

  p_rvalid_floatrates(
      malloc: allocation_table,
      memory: real_memory,
      rates: addr): bool =
    p_finite_floatrates(memory, rates)
      AND valid_rd(malloc, rates, 3)

  goal0: bool =
    FORALL (a, a_1: addr),
           (t: allocation_table),
           (t_1: real_memory):
      (region(base(a)) <= 0
        AND region(base(a_1)) <= 0
        AND linked(t)
        AND valid_rw(t, a, 9)
        AND p_rvalid_floatrates(t, t_1, a_1)
        AND is_float32(t_1(shift(a_1, 0)))
        AND is_float32(t_1(shift(a_1, 1)))
        AND is_float32(t_1(shift(a_1, 2))))
      IMPLIES
        p_rvalid_floatrmat(t, t_1, a)
END float_rmat_integrate_fi_Why3_ide_VCfloat_rmat_integrate_fi_call_float_rmat_comp_pre_2_goal0
