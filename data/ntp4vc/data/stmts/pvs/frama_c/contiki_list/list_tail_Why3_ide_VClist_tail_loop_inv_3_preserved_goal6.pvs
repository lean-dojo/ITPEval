% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_list/list_tail_Why3_ide_VClist_tail_loop_inv_3_preserved_goal6:
% preservation of a linked-list tail loop invariant over pointer memory and
% integer-indexed list segments. This file contains no proof.

list_tail_Why3_ide_VClist_tail_loop_inv_3_preserved_goal6[
  region: [int -> int],
  linked: [[int -> int] -> bool]
]: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  linked_candidate: TYPE =
    [allocation_table, pointer_memory, addr, addr, int, int, addr -> bool]

  p_linked_n(
      malloc: allocation_table,
      ptr_memory: pointer_memory,
      root, array_base: addr,
      index, count: int,
      bound: addr): bool =
    FORALL (candidate: linked_candidate):
      ((FORALL (base_index: int),
               (candidate_malloc: allocation_table),
               (candidate_memory: pointer_memory),
               (candidate_bound, candidate_array: addr):
          (0 <= base_index AND base_index <= 2147483646)
            IMPLIES
              candidate(
                candidate_malloc,
                candidate_memory,
                candidate_bound,
                candidate_array,
                base_index,
                0,
                candidate_bound))
        AND
        (FORALL (base_index, positive_count: int),
                (candidate_memory: pointer_memory),
                (candidate_array, candidate_root: addr),
                (candidate_malloc: allocation_table),
                (candidate_bound: addr):
          (candidate_memory(shift(candidate_array, base_index))
              = candidate_root
            AND 0 < positive_count
            AND 0 <= base_index
            AND 0 <= base_index + positive_count
            AND base_index + positive_count <= 2147483646
            AND valid_rw(candidate_malloc, candidate_root, 4)
            AND candidate(
              candidate_malloc,
              candidate_memory,
              candidate_memory(shift(candidate_root, 0)),
              candidate_array,
              1 + base_index,
              positive_count - 1,
              candidate_bound))
          IMPLIES
            candidate(
              candidate_malloc,
              candidate_memory,
              candidate_root,
              candidate_array,
              base_index,
              positive_count,
              candidate_bound)))
      IMPLIES
        candidate(malloc, ptr_memory, root, array_base, index, count, bound)

  goal6: bool =
    FORALL (t_1: pointer_memory),
           (a: addr),
           (i_1, i_2: int),
           (a_1: addr),
           (i: int),
           (t: allocation_table):
      LET a_2: addr = t_1(a),
          x: int = i_1 + i_2,
          a_3: addr = t_1(shift(a_1, x)),
          a_4: addr = t_1(shift(a_3, 0)),
          x_1: int = 1 + i_2,
          null_addr: addr = (# base := 0, offset := 0 #)
      IN
        (a_2 /= null_addr
          AND a_4 /= null_addr
          AND 0 <= i_2
          AND i_2 < i
          AND region(base(a)) <= 0
          AND region(base(a_1)) <= 0
          AND framed(t_1)
          AND linked(t)
          AND is_sint32(i)
          AND is_sint32(i_1)
          AND is_sint32(i_2)
          AND valid_rw(t, a, 1)
          AND is_sint32(x_1)
          AND valid_rw(t, shift(a_1, 0), 2147483646)
          AND p_linked_n(
            t, t_1, a_2, a_1, i_1, i, null_addr)
          AND p_linked_n(
            t, t_1, a_2, a_1, i_1, i_2, a_3)
          AND p_linked_n(
            t, t_1, a_3, a_1, x, i - i_2, null_addr))
        IMPLIES
          p_linked_n(t, t_1, a_2, a_1, i_1, x_1, a_4)
END list_tail_Why3_ide_VClist_tail_loop_inv_3_preserved_goal6
