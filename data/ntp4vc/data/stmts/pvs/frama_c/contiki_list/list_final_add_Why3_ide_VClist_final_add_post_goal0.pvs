% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_list/list_final_add_Why3_ide_VClist_final_add_post_goal0:
% preservation of a linked-list segment after final pointer-memory updates,
% under allocation, framing, and separation invariants. This file contains no proof.

list_final_add_Why3_ide_VClist_final_add_post_goal0[
  region: [int -> int],
  linked: [[int -> int] -> bool]
]: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  linked_candidate: TYPE =
    [[int -> int], pointer_memory, addr, addr, int, int, addr -> bool]

  p_linked_n(
      malloc: allocation_table,
      ptr_memory: pointer_memory,
      root, array_base: addr,
      index, count: int,
      bound: addr): bool =
    FORALL (candidate: linked_candidate):
      ((FORALL (base_index: int),
               (candidate_malloc: allocation_table),
               (candidate_memory: pointer_memory),
               (candidate_bound, candidate_array: addr):
          (0 <= base_index AND base_index <= 2147483646)
            IMPLIES
              candidate(
                candidate_malloc,
                candidate_memory,
                candidate_bound,
                candidate_array,
                base_index,
                0,
                candidate_bound))
        AND
        (FORALL (base_index, positive_count: int),
                (candidate_memory: pointer_memory),
                (candidate_array, candidate_root: addr),
                (candidate_malloc: allocation_table),
                (candidate_bound: addr):
          (candidate_memory(shift(candidate_array, base_index))
              = candidate_root
            AND 0 < positive_count
            AND 0 <= base_index
            AND 0 <= base_index + positive_count
            AND base_index + positive_count <= 2147483646
            AND valid_rw(candidate_malloc, candidate_root, 4)
            AND candidate(
              candidate_malloc,
              candidate_memory,
              candidate_memory(shift(candidate_root, 0)),
              candidate_array,
              1 + base_index,
              positive_count - 1,
              candidate_bound))
          IMPLIES
            candidate(
              candidate_malloc,
              candidate_memory,
              candidate_root,
              candidate_array,
              base_index,
              positive_count,
              candidate_bound)))
      IMPLIES
        candidate(malloc, ptr_memory, root, array_base, index, count, bound)

  goal0: bool =
    FORALL (t_1: pointer_memory),
           (a_1: addr),
           (i, i_1: int),
           (a_3, a, a_2: addr),
           (t: allocation_table):
      LET a_4: addr = t_1(shift(a_1, 0)),
          x: int = i + i_1,
          a_5: addr = shift(a_3, 0),
          a_6: addr = t_1(a),
          a_7: addr = shift(a_2, 0),
          m: pointer_memory =
            (t_1 WITH [(shift(a_3, x)) := a_1])
              WITH [(a_7) := a_1]
      IN
        (a_4 = (# base := 0, offset := 0 #)
          AND 0 < x
          AND region(base(a)) <= 0
          AND region(base(a_1)) <= 0
          AND region(base(a_2)) <= 0
          AND region(base(a_3)) <= 0
          AND x <= 2147483645
          AND framed(t_1)
          AND linked(t)
          AND is_sint32(i)
          AND is_sint32(i_1)
          AND valid_rw(t, a, 1)
          AND valid_rw(t, a_1, 4)
          AND valid_rw(t, a_2, 4)
          AND separated(a, 1, a_1, 4)
          AND separated(a, 1, a_2, 4)
          AND separated(a_2, 4, a_1, 4)
          AND valid_rw(t, a_5, 2147483646)
          AND separated(a, 1, a_5, 2147483646)
          AND separated(a_1, 4, a_5, 2147483646)
          AND separated(a_6, 4, a_5, 2147483646)
          AND p_linked_n(t, t_1, a_6, a_3, i_1, i - 1, a_2)
          AND p_linked_n(
            t,
            t_1,
            a_2,
            a_3,
            i + i_1 - 1,
            1,
            t_1(a_7))
          AND
            (FORALL (i_2: int):
              (i_1 <= i_2 AND i_2 < x)
                IMPLIES
                  separated(a, 1, t_1(shift(a_3, i_2)), 4))
          AND
            (FORALL (i_2: int):
              (i_1 <= i_2 AND i_2 < x)
                IMPLIES
                  separated(a_1, 4, t_1(shift(a_3, i_2)), 4))
          AND
            (FORALL (i_2: int):
              (i_1 <= i_2 AND i_2 < x)
                IMPLIES
                  separated(
                    t_1(shift(a_3, i_2)),
                    4,
                    a_5,
                    2147483646))
          AND
            (FORALL (i_3, i_2: int):
              (i_3 /= i_2
                AND i_1 <= i_2
                AND i_1 <= i_3
                AND i_2 < x
                AND i_3 < x)
              IMPLIES
                t_1(shift(a_3, i_3)) /= t_1(shift(a_3, i_2)))
          AND
            (FORALL (i_3, i_2: int):
              (i_3 /= i_2
                AND i_1 <= i_2
                AND i_1 <= i_3
                AND i_2 < x
                AND i_3 < x)
              IMPLIES
                separated(
                  t_1(shift(a_3, i_3)),
                  4,
                  t_1(shift(a_3, i_2)),
                  4)))
        IMPLIES
          p_linked_n(t, m, m(a), a_3, i_1, 1 + i, a_4)
END list_final_add_Why3_ide_VClist_final_add_post_goal0
