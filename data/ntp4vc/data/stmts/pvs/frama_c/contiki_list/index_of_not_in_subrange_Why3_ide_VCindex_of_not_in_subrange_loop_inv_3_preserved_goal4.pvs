% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_list/index_of_not_in_subrange_Why3_ide_VCindex_of_not_in_subrange_loop_inv_3_preserved_goal4:
% preservation of a pointer-array index-search loop invariant after advancing
% past an element that differs from the sought address. This file contains no proof.

index_of_not_in_subrange_Why3_ide_VCindex_of_not_in_subrange_loop_inv_3_preserved_goal4[
  region: [int -> int]
]: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  index_function: TYPE =
    [pointer_memory, addr, addr, int, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  framed(memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  index_axioms(l_index_of: index_function): bool =
    (FORALL (up_0, down_0: int),
            (mptr_0: pointer_memory),
            (item_0, array_0: addr):
       (up_0 <= down_0 AND 0 <= up_0)
         IMPLIES
           l_index_of(mptr_0, item_0, array_0, down_0, up_0) = up_0)
      AND
    (FORALL (down_0, up_0: int),
            (mptr_0: pointer_memory),
            (array_0, item_0: addr):
       (mptr_0(shift(array_0, down_0)) = item_0
         AND 0 <= down_0
         AND down_0 < up_0)
         IMPLIES
           l_index_of(mptr_0, item_0, array_0, down_0, up_0) = down_0)
      AND
    (FORALL (down_0, up_0: int),
            (mptr_0: pointer_memory),
            (array_0, item_0: addr):
       (mptr_0(shift(array_0, down_0)) /= item_0
         AND 0 <= down_0
         AND down_0 < up_0)
         IMPLIES
           l_index_of(mptr_0, item_0, array_0, 1 + down_0, up_0)
             = l_index_of(mptr_0, item_0, array_0, down_0, up_0))

  goal4: bool =
    FORALL (l_index_of: index_function):
      index_axioms(l_index_of)
        IMPLIES
          (FORALL (i_2: int),
                  (t: pointer_memory),
                  (a, a_1: addr),
                  (i_4, i, i_1, i_3: int):
             LET x: int = 1 + i_2,
                 x_1: int = l_index_of(t, a, a_1, i_4, i)
             IN
               (t(shift(a_1, i_2)) /= a
                 AND 0 <= i
                 AND i_2 <= i_1
                 AND i_4 <= i_1
                 AND i_2 < i_1
                 AND i_3 <= i_2
                 AND i_4 <= i_2
                 AND i_4 <= i_3
                 AND 0 <= i_4
                 AND region(base(a)) <= 0
                 AND region(base(a_1)) <= 0
                 AND framed(t)
                 AND is_sint32(i)
                 AND is_sint32(i_1)
                 AND is_sint32(i_2)
                 AND is_sint32(i_3)
                 AND is_sint32(i_4)
                 AND is_sint32(x)
                 AND
                   (FORALL (i_5: int):
                     i_5 < i_1 IMPLIES
                       i_4 <= i_5 IMPLIES
                         t(shift(a_1, i_5)) /= a)
                 AND
                   (FORALL (i_5: int):
                     i_5 < i_2 IMPLIES
                       i_4 <= i_5 IMPLIES
                         x_1 = l_index_of(t, a, a_1, i_2, i)))
                 IMPLIES
                   l_index_of(t, a, a_1, x, i) = x_1)
END index_of_not_in_subrange_Why3_ide_VCindex_of_not_in_subrange_loop_inv_3_preserved_goal4
