% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_list/list_push_Why3_ide_VClist_push_does_not_contain_item_post_Separation_part1_goal54:
% the separation postcondition for the updated pointer array in the Contiki
% list-push verification condition. This file contains no proof.

list_push_Why3_ide_VClist_push_does_not_contain_item_post_Separation_part1_goal54[
  region: [int -> int],
  linked: [[int -> int] -> bool]
]: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  ptr_memory: TYPE = [addr -> addr]
  real_memory: TYPE = [addr -> real]
  allocation_table: TYPE = [int -> int]
  index_function: TYPE =
    [ptr_memory, addr, addr, int, int -> int]
  linked_candidate: TYPE =
    [allocation_table, ptr_memory, addr, addr, int, int, addr -> bool]

  s1_list: TYPE =
    [# list_next: addr, list_x: real, list_y: real, list_z: real #]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  update_ptr(memory: ptr_memory, p: addr, value: addr): ptr_memory =
    memory WITH [(p) := value]

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, changed: ptr_memory,
      p: addr,
      size: int): ptr_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, p, size) THEN changed(q) ELSE original(q) ENDIF

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(memory: ptr_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  load_s1_list(
      p: addr,
      real_mem: real_memory,
      ptr_mem: ptr_memory): s1_list =
    (# list_next := ptr_mem(shift(p, 0)),
       list_x := real_mem(shift(p, 1)),
       list_y := real_mem(shift(p, 2)),
       list_z := real_mem(shift(p, 3)) #)

  eqs1_list(left, right: s1_list): bool =
    list_next(right) = list_next(left)
      AND list_x(right) = list_x(left)
      AND list_y(right) = list_y(left)
      AND list_z(right) = list_z(left)

  p_unchanged(
      malloc_0: allocation_table,
      mptr_0: ptr_memory,
      float_memory_0: real_memory,
      malloc_1: allocation_table,
      mptr_1: ptr_memory,
      float_memory_1: real_memory,
      array_base: addr,
      down, up: int): bool =
    FORALL (j: int):
      LET array_cell: addr = shift(array_base, j),
          old_item: addr = mptr_0(array_cell),
          new_item: addr = mptr_1(array_cell)
      IN
        down <= j IMPLIES
          j < up IMPLIES
            old_item = new_item
              AND eqs1_list(
                load_s1_list(new_item, float_memory_1, mptr_1),
                load_s1_list(old_item, float_memory_0, mptr_0))
              AND (valid_rw(malloc_1, new_item, 4)
                IMPLIES valid_rw(malloc_0, old_item, 4))

  p_array_swipe_right(
      left_memory, right_memory: ptr_memory,
      array_base: addr,
      lower, upper: int): bool =
    FORALL (position: int):
      lower <= position IMPLIES
        position < upper IMPLIES
          right_memory(shift(array_base, position - 1))
            = left_memory(shift(array_base, position))

  p_linked_n(
      malloc: allocation_table,
      mptr: ptr_memory,
      root, array_base: addr,
      index, count: int,
      bound: addr): bool =
    FORALL (relation: linked_candidate):
      ((FORALL (index_0: int),
               (malloc_0: allocation_table),
               (mptr_0: ptr_memory),
               (bound_0, array_0: addr):
          0 <= index_0
            AND index_0 <= 2147483646
            IMPLIES relation(
              malloc_0, mptr_0, bound_0, array_0,
              index_0, 0, bound_0))
        AND
        (FORALL (index_0, n: int),
                (mptr_0: ptr_memory),
                (array_0, root_0: addr),
                (malloc_0: allocation_table),
                (bound_0: addr):
          mptr_0(shift(array_0, index_0)) = root_0
            AND 0 < n
            AND 0 <= index_0
            AND 0 <= index_0 + n
            AND index_0 + n <= 2147483646
            AND valid_rw(malloc_0, root_0, 4)
            AND relation(
              malloc_0,
              mptr_0,
              mptr_0(shift(root_0, 0)),
              array_0,
              1 + index_0,
              n - 1,
              bound_0)
            IMPLIES relation(
              malloc_0, mptr_0, root_0, array_0,
              index_0, n, bound_0)))
      IMPLIES relation(
        malloc, mptr, root, array_base, index, count, bound)

  index_of_spec(l_index_of: index_function): bool =
    (FORALL (up_0, down_0: int),
            (mptr_0: ptr_memory),
            (item_0, array_0: addr):
      up_0 <= down_0
        AND 0 <= up_0
        IMPLIES
          l_index_of(mptr_0, item_0, array_0, down_0, up_0) = up_0)
      AND
    (FORALL (down_0: int),
            (mptr_0: ptr_memory),
            (array_0: addr),
            (item_0: addr),
            (up_0: int):
      mptr_0(shift(array_0, down_0)) = item_0
        AND 0 <= down_0
        AND down_0 < up_0
        IMPLIES
          l_index_of(mptr_0, item_0, array_0, down_0, up_0) = down_0)
      AND
    (FORALL (down_0: int),
            (mptr_0: ptr_memory),
            (array_0: addr),
            (item_0: addr),
            (up_0: int):
      mptr_0(shift(array_0, down_0)) /= item_0
        AND 0 <= down_0
        AND down_0 < up_0
        IMPLIES
          l_index_of(
            mptr_0, item_0, array_0, 1 + down_0, up_0)
            = l_index_of(
              mptr_0, item_0, array_0, down_0, up_0))

  goal54: bool =
    FORALL (l_index_of: index_function),
           (i, i_1: int),
           (t_3: ptr_memory),
           (a_3, a_4, a_2: addr),
           (t_2: ptr_memory),
           (t_4: ptr_memory),
           (a, a_1: addr),
           (i_2: int),
           (t: allocation_table),
           (t_1: real_memory):
      index_of_spec(l_index_of) IMPLIES
        LET x: int = i - 1,
            x_1: int = i + i_1 - 1,
            x_2: int = l_index_of(t_3, a_3, a_4, x, x_1),
            x_3: int = 1 + x_2,
            x_4: int = i + i_1,
            a_5: addr = shift(a_4, 0),
            a_6: addr = t_3(a_2),
            a_7: addr = shift(a_4, x),
            updated_t_3: ptr_memory =
              update_ptr(
                update_ptr(t_3, a_2, a),
                shift(t_3(shift(a_4, x_2 - 1)), 0),
                a_1),
            a_8: ptr_memory =
              havoc(
                t_2,
                updated_t_3,
                shift(a_4, x_2),
                i + i_1 - 1 - x_2),
            a_9: addr = a_8(a_2),
            a_13: ptr_memory =
              havoc(t_4, a_8, shift(a_4, x), 1 + i_1),
            a_10: ptr_memory =
              update_ptr(
                update_ptr(a_13, shift(a_3, 0), a_9),
                a_7,
                a_3),
            a_11: ptr_memory = update_ptr(a_10, a_2, a_3)
        IN
          ((# base := 0, offset := 0 #) /= a_3
            AND x_3 = x_4
            AND 0 < i
            AND 0 <= i_1
            AND i_2 < x_4
            AND region(base(a_2)) <= 0
            AND region(base(a_3)) <= 0
            AND region(base(a_4)) <= 0
            AND x_2 < x_4
            AND i_1 <= 2147483645
            AND x_4 <= 2147483646
            AND i <= 1 + i_2
            AND i <= x_3
            AND framed(t_3)
            AND linked(t)
            AND is_sint32(i)
            AND is_sint32(i_1)
            AND valid_rw(t, a_2, 1)
            AND valid_rw(t, a_3, 4)
            AND separated(a_2, 1, a_3, 4)
            AND is_sint32(x)
            AND valid_rw(t, a_5, 2147483646)
            AND separated(a_2, 1, a_5, 2147483646)
            AND separated(a_3, 4, a_5, 2147483646)
            AND separated(a_6, 4, a_5, 2147483646)
            AND valid_rw(t, a_7, i_1)
            AND p_linked_n(
              t, t_3, a_6, a_4, x, i_1,
              (# base := 0, offset := 0 #))
            AND is_sint32(x_2)
            AND separated(a_9, 4, a_5, 2147483646)
            AND eqs1_list(
              load_s1_list(a_3, t_1, a_8),
              load_s1_list(a_3, t_1, t_3))
            AND p_linked_n(
              t, a_8, a_9, a_4, x, i_1,
              (# base := 0, offset := 0 #))
            AND p_unchanged(
              t, a_8, t_1, t, t_3, t_1, a_4, x, x_1)
            AND p_unchanged(
              t, a_11, t_1, t, a_10, t_1, a_4, x, x_4)
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  t_3(shift(a_4, i_3)) /= a_3)
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  is_sint32(i_3) IMPLIES
                    t_3(shift(a_4, i_3)) /= a_3)
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  separated(
                    a_2, 1, t_3(shift(a_4, i_3)), 4))
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  separated(
                    t_3(shift(a_4, i_3)), 4,
                    a_5, 2147483646))
            AND (FORALL (i_3: int):
              LET a_12: addr = t_3(shift(a_4, i_3))
              IN
                a_12 /= a_3 IMPLIES
                  i <= 1 + i_3 IMPLIES
                    2 + i_3 <= x_4 IMPLIES
                      separated(a_3, 4, a_12, 4))
            AND (FORALL (i_4, i_3: int):
              i_4 /= i_3 IMPLIES
                i <= 1 + i_3 IMPLIES
                  i <= 1 + i_4 IMPLIES
                    2 + i_3 <= x_4 IMPLIES
                      2 + i_4 <= x_4 IMPLIES
                        t_3(shift(a_4, i_4))
                          /= t_3(shift(a_4, i_3)))
            AND (FORALL (i_4, i_3: int):
              i_4 /= i_3 IMPLIES
                i <= 1 + i_3 IMPLIES
                  i <= 1 + i_4 IMPLIES
                    2 + i_3 <= x_4 IMPLIES
                      2 + i_4 <= x_4 IMPLIES
                        separated(
                          t_3(shift(a_4, i_4)), 4,
                          t_3(shift(a_4, i_3)), 4))
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  a_8(shift(a_4, i_3)) /= a_3)
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  separated(
                    a_2, 1, a_8(shift(a_4, i_3)), 4))
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  separated(
                    a_3, 4, a_8(shift(a_4, i_3)), 4))
            AND (FORALL (i_3: int):
              i <= 1 + i_3 IMPLIES
                2 + i_3 <= x_4 IMPLIES
                  separated(
                    a_8(shift(a_4, i_3)), 4,
                    a_5, 2147483646))
            AND (FORALL (i_4, i_3: int):
              i_4 /= i_3 IMPLIES
                i <= 1 + i_3 IMPLIES
                  i <= 1 + i_4 IMPLIES
                    2 + i_3 <= x_4 IMPLIES
                      2 + i_4 <= x_4 IMPLIES
                        a_8(shift(a_4, i_4))
                          /= a_8(shift(a_4, i_3)))
            AND (FORALL (i_4, i_3: int):
              i_4 /= i_3 IMPLIES
                i <= 1 + i_3 IMPLIES
                  i <= 1 + i_4 IMPLIES
                    2 + i_3 <= x_4 IMPLIES
                      2 + i_4 <= x_4 IMPLIES
                        separated(
                          a_8(shift(a_4, i_4)), 4,
                          a_8(shift(a_4, i_3)), 4))
            AND a_13(a_2) = a_9
            AND separated(a_13(a_2), 4, a_5, 2147483646)
            AND (FORALL (j: int):
              i <= j IMPLIES
                j < x_4 IMPLIES
                  separated(a_2, 1, a_13(shift(a_4, j)), 4))
            AND (FORALL (j: int):
              i <= j IMPLIES
                j < x_4 IMPLIES
                  separated(
                    a_13(shift(a_4, j)), 4,
                    a_5, 2147483646))
            AND (FORALL (k, j: int):
              k /= j IMPLIES
                i <= j IMPLIES
                  i <= k IMPLIES
                    j < x_4 IMPLIES
                      k < x_4 IMPLIES
                        separated(
                          a_13(shift(a_4, k)), 4,
                          a_13(shift(a_4, j)), 4))
            AND (FORALL (k, j: int):
              k /= j IMPLIES
                x <= j IMPLIES
                  x <= k IMPLIES
                    j < x_4 IMPLIES
                      k < x_4 IMPLIES
                        a_13(shift(a_4, k))
                          /= a_13(shift(a_4, j)))
            AND p_array_swipe_right(a_13, a_8, a_4, i, x_4)
            AND p_linked_n(
              t, a_13, a_9, a_4, i, i_1,
              (# base := 0, offset := 0 #)))
          IMPLIES
            separated(
              a_11(shift(a_4, i_2)), 4,
              a_5, 2147483646)
END list_push_Why3_ide_VClist_push_does_not_contain_item_post_Separation_part1_goal54
