                       a_11,
                       t_1,
                       t,
                       t_3,
                       t_1,
                       a_3,
                       x,
                       x_5))
                 AND
                   (item_absent IMPLIES
                     (FORALL (i_4: int):
                       i_4 < x_1 IMPLIES
                         i_1 <= 1 + i_4 IMPLIES
                           separated(
                             a_2,
                             1,
                             a_11(shift(a_3, i_4)),
                             4)))
                 AND
                   (item_occurs IMPLIES
                     (FORALL (i_4: int):
                       i_1 <= 1 + i_4 IMPLIES
                         2 + i_4 <= x_1 IMPLIES
                           separated(
                             a_2,
                             1,
                             a_11(shift(a_3, i_4)),
                             4)))
                 AND
                   (item_absent IMPLIES
                     (FORALL (i_4: int):
                       i_4 < x_1 IMPLIES
                         i_1 <= 1 + i_4 IMPLIES
                           separated(
                             a_4,
                             4,
                             a_11(shift(a_3, i_4)),
                             4)))
                 AND
                   (item_occurs IMPLIES
                     (FORALL (i_4: int):
                       i_1 <= 1 + i_4 IMPLIES
                         2 + i_4 <= x_1 IMPLIES
                           separated(
                             a_4,
                             4,
                             a_11(shift(a_3, i_4)),
                             4)))
                 AND
                   (item_absent IMPLIES
                     (FORALL (i_4: int):
                       i_4 < x_1 IMPLIES
                         i_1 <= 1 + i_4 IMPLIES
                           separated(
                             a_11(shift(a_3, i_4)),
                             4,
                             a_6,
                             2147483646)))
                 AND
                   (item_occurs IMPLIES
                     (FORALL (i_4: int):
                       i_1 <= 1 + i_4 IMPLIES
                         2 + i_4 <= x_1 IMPLIES
                           separated(
                             a_11(shift(a_3, i_4)),
                             4,
                             a_6,
                             2147483646)))
                 AND
                   (item_occurs IMPLIES
                     (FORALL (i_4: int):
                       x_2 <= i_4 IMPLIES
                         2 + i_4 <= x_1 IMPLIES
                           eqs1_list(
                             load_s1_list(
                               a_11(shift(a_3, i_4)),
                               t_1,
                               a_11),
