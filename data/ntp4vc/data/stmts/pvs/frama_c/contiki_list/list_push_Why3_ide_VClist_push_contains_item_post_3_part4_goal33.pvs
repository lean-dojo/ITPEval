                 x_3: int =
                   l_index_of(t_3, a_5, a_3, x, x_1),
                 x_4: int = 1 + i,
                 a_6: addr = shift(a_3, 0),
                 a_7: addr = t_3(a_2),
                 a_8: addr = shift(a_3, x),
                 x_5: int = x_2 - 1,
                 a_9: addr = shift(a_3, x_5),
                 a_10: addr = t_3(a_9),
                 updated_memory: pointer_memory =
                   (t_3 WITH [(a_2) := a])
                     WITH [(shift(a_10, 0)) := a_1],
                 a_11: pointer_memory =
                   havoc(
                     t_2,
                     updated_memory,
                     shift(a_3, x_2),
                     i + i_1 - x_2),
                 a_12: addr = a_11(a_2),
                 a_16: pointer_memory =
                   havoc(
                     t_4,
                     a_11,
                     shift(a_3, x),
                     x_4),
                 a_13: pointer_memory =
                   (a_16 WITH [(shift(a_4, 0)) := a_12])
                     WITH [(a_8) := a_4],
                 a_14: pointer_memory =
                   a_13 WITH [(a_2) := a_4],
                 item_occurs: bool =
                   EXISTS (i_4: int):
                     a_4 = t_3(shift(a_3, i_4))
                       AND i_4 < x_1
                       AND i_1 <= 1 + i_4,
                 item_absent: bool =
                   FORALL (i_4: int):
                     i_4 < x_1 IMPLIES
                       i_1 <= 1 + i_4 IMPLIES
                         a_4 /= t_3(shift(a_3, i_4))
             IN
               (a_4 /= (# base := 0, offset := 0 #)
                 AND a_4 = a_5
                 AND x_2 = x_3
                 AND x_1 /= x_2
                 AND 0 < i_1
                 AND i_2 < x_1
                 AND i_3 < x_1
                 AND region(base(a_2)) <= 0
                 AND region(base(a_3)) <= 0
                 AND region(base(a_4)) <= 0
                 AND x_2 < x_1
                 AND x_2 <= x_1
                 AND -1 <= i
                 AND i <= 2147483644
                 AND x_1 <= 2147483645
                 AND i_1 <= 1 + i_2
                 AND i_1 <= 1 + i_3
                 AND i_1 <= 1 + x_2
                 AND framed(t_3)
                 AND linked(t)
                 AND is_sint32(i)
                 AND is_sint32(i_1)
                 AND valid_rw(t, a_2, 1)
                 AND is_sint32(x)
                 AND is_sint32(x_4)
                 AND valid_rw(t, a_6, 2147483646)
                 AND valid_rw(t, a_5, 4)
                 AND separated(a_2, 1, a_6, 2147483646)
                 AND separated(a_7, 4, a_6, 2147483646)
                 AND separated(a_2, 1, a_5, 4)
                 AND separated(a_5, 4, a_6, 2147483646)
                 AND valid_rw(t, a_8, x_4)
                 AND p_linked_n(
                   t,
                   t_3,
                   a_7,
                   a_3,
                   x,
                   x_4,
                   (# base := 0, offset := 0 #))
                 AND is_sint32(x_3)
                 AND is_sint32(x_2)
                 AND separated(a_12, 4, a_6, 2147483646)
                 AND eqs1_list(
                   load_s1_list(a_4, t_1, a_11),
                   load_s1_list(a_4, t_1, t_3))
                 AND p_unchanged(
                   t,
                   a_14,
                   t_1,
                   t,
                   a_13,
                   t_1,
                   a_3,
                   x,
                   x_1)
                 AND
                   (i_1 <= x_2 IMPLIES
                     item_occurs IMPLIES
                       a_11(a_9) = a_10)
                 AND
                   (item_occurs IMPLIES
                     p_array_swipe_left(
                       a_11,
                       t_3,
                       a_3,
                       x_2,
                       i + i_1 - 1))
                 AND
                   (item_absent IMPLIES
                     (FORALL (i_4: int):
                       i_4 < x_1 IMPLIES
                         i_1 <= 1 + i_4 IMPLIES
                           a_11(shift(a_3, i_4)) /= a_4))
                 AND
                   (item_occurs IMPLIES
                     (FORALL (i_4: int):
                       i_1 <= 1 + i_4 IMPLIES
                         2 + i_4 <= x_1 IMPLIES
                           a_11(shift(a_3, i_4)) /= a_4))
                 AND
                   (item_occurs IMPLIES
                     p_linked_n(
                       t,
                       a_11,
                       a_12,
                       a_3,
                       x,
                       i,
                       (# base := 0, offset := 0 #)))
                 AND
                   (item_absent IMPLIES
                     p_linked_n(
                       t,
                       a_11,
                       a_12,
