                 AND
                   (item_absent IMPLIES
                     (FORALL (i_5, i_4: int):
                       i_5 /= i_4 IMPLIES
                         i_4 < x_1 IMPLIES
                           i_5 < x_1 IMPLIES
                             i_1 <= 1 + i_4 IMPLIES
                               i_1 <= 1 + i_5 IMPLIES
                                 a_11(shift(a_3, i_5))
                                   /= a_11(shift(a_3, i_4))))
                 AND
                   (item_occurs IMPLIES
                     (FORALL (i_5, i_4: int):
                       i_5 /= i_4 IMPLIES
                         i_1 <= 1 + i_4 IMPLIES
                           i_1 <= 1 + i_5 IMPLIES
                             2 + i_4 <= x_1 IMPLIES
                               2 + i_5 <= x_1 IMPLIES
                                 a_11(shift(a_3, i_5))
                                   /= a_11(shift(a_3, i_4))))
                 AND
                   (item_absent IMPLIES
                     (FORALL (i_5, i_4: int):
                       i_5 /= i_4 IMPLIES
                         i_4 < x_1 IMPLIES
                           i_5 < x_1 IMPLIES
                             i_1 <= 1 + i_4 IMPLIES
                               i_1 <= 1 + i_5 IMPLIES
                                 separated(
