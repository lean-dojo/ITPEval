% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_list/list_pop_Why3_ide_VClist_pop_more_post_3_part1_goal16:
% preservation of the linked-list segment after replacing the popped list
% pointer in memory and decreasing the segment length. This file contains no proof.

list_pop_Why3_ide_VClist_pop_more_post_3_part1_goal16[
  region: [int -> int],
  linked: [[int -> int] -> bool]
]: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  linked_candidate: TYPE =
    [[int -> int], pointer_memory, addr, addr, int, int, addr -> bool]

  p_linked_n(
      malloc: allocation_table,
      ptr_memory: pointer_memory,
      root, array_base: addr,
      index, count: int,
      bound: addr): bool =
    FORALL (candidate: linked_candidate):
      ((FORALL (base_index: int),
               (candidate_malloc: allocation_table),
               (candidate_memory: pointer_memory),
               (candidate_bound, candidate_array: addr):
          (0 <= base_index AND base_index <= 2147483646)
            IMPLIES
              candidate(
                candidate_malloc,
                candidate_memory,
                candidate_bound,
                candidate_array,
                base_index,
                0,
                candidate_bound))
        AND
        (FORALL (base_index, positive_count: int),
                (candidate_memory: pointer_memory),
                (candidate_array, candidate_root: addr),
                (candidate_malloc: allocation_table),
                (candidate_bound: addr):
          (candidate_memory(shift(candidate_array, base_index))
              = candidate_root
            AND 0 < positive_count
            AND 0 <= base_index
            AND 0 <= base_index + positive_count
            AND base_index + positive_count <= 2147483646
            AND valid_rw(candidate_malloc, candidate_root, 4)
            AND candidate(
              candidate_malloc,
              candidate_memory,
              candidate_memory(shift(candidate_root, 0)),
              candidate_array,
              1 + base_index,
              positive_count - 1,
              candidate_bound))
          IMPLIES
            candidate(
              candidate_malloc,
              candidate_memory,
              candidate_root,
              candidate_array,
              base_index,
              positive_count,
              candidate_bound)))
      IMPLIES
        candidate(malloc, ptr_memory, root, array_base, index, count, bound)

  goal16: bool =
    FORALL (t_1, t_2: pointer_memory),
           (a, a_1: addr),
           (i, i_1: int),
           (t: allocation_table):
      LET a_2: addr = t_1(a),
          a_3: addr = shift(a_1, 0),
          x: int = i + i_1,
          a_4: addr = t_1(shift(a_2, 0)),
          null_addr: addr = (# base := 0, offset := 0 #),
          updated_memory: pointer_memory = t_2 WITH [(a) := a_4]
      IN
        (a_2 /= null_addr
          AND 0 < i
          AND 0 <= i_1
          AND region(base(a)) <= 0
          AND region(base(a_1)) <= 0
          AND framed(t_1)
          AND linked(t)
          AND is_sint32(i)
          AND is_sint32(i_1)
          AND valid_rw(t, a, 1)
          AND valid_rw(t, a_3, 2147483646)
          AND separated(a, 1, a_3, 2147483646)
          AND separated(a_2, 4, a_3, 2147483646)
          AND p_linked_n(t, t_1, a_2, a_1, i_1, i, null_addr)
          AND
            (FORALL (i_2: int):
              i_1 <= i_2 IMPLIES
                i_2 < x IMPLIES
                  separated(a, 1, t_1(shift(a_1, i_2)), 4))
          AND
            (FORALL (i_2: int):
              i_1 <= i_2 IMPLIES
                i_2 < x IMPLIES
                  separated(
                    t_1(shift(a_1, i_2)),
                    4,
                    a_3,
                    2147483646))
          AND
            (FORALL (i_3, i_2: int):
              i_3 /= i_2 IMPLIES
                i_1 <= i_2 IMPLIES
                  i_1 <= i_3 IMPLIES
                    i_2 < x IMPLIES
                      i_3 < x IMPLIES
                        t_1(shift(a_1, i_3))
                          /= t_1(shift(a_1, i_2)))
          AND
            (FORALL (i_3, i_2: int):
              i_3 /= i_2 IMPLIES
                i_1 <= i_2 IMPLIES
                  i_1 <= i_3 IMPLIES
                    i_2 < x IMPLIES
                      i_3 < x IMPLIES
                        separated(
                          t_1(shift(a_1, i_3)),
                          4,
                          t_1(shift(a_1, i_2)),
                          4)))
          AND
            p_linked_n(
              t,
              t_2,
              a_4,
              a_1,
              i_1,
              i - 1,
              null_addr)
          AND
            (FORALL (i_2: int):
              i_1 <= i_2 IMPLIES
                i_2 < i_1 + (i - 1) IMPLIES
                  separated(a, 1, t_2(shift(a_1, i_2)), 4))
        IMPLIES
          p_linked_n(
            t,
            updated_memory,
            a_4,
            a_1,
            i_1,
            i - 1,
            null_addr)
END list_pop_Why3_ide_VClist_pop_more_post_3_part1_goal16
