% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/x509_parser/check_utf8_string_Why3_ide_VCcheck_utf8_string_assert_rte_mem_access_9_part03_goal29:
% an X.509 UTF-8 validation verification condition concluding one-byte read
% validity at the fourth byte under byte-pattern, integer-range, linkage,
% region, and prior memory-validity assumptions. This file contains no proof.

check_utf8_string_Why3_ide_VCcheck_utf8_string_assert_rte_mem_access_9_part03_goal29: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  is_uint16(value: int): bool =
    0 <= value AND value < 65536

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  land_192(value: int): int =
    64 * mod(floor((value :: real) / 64), 2)
      + 128 * mod(floor((value :: real) / 128), 2)

  goal29: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (a_1: addr),
      (t_1: integer_memory),
      (i, i_1: int),
      (a: addr),
      (t: allocation_table):
      LET a_2: addr = shift(a_1, 0),
          a_3: addr = shift(a_1, 1),
          x: int = t_1(a_3),
          a_4: addr = shift(a_1, 2),
          x_1: int = t_1(a_4),
          a_5: addr = shift(a_1, 3)
      IN
        i /= 0 IMPLIES
        i_1 /= 0 IMPLIES
        (# base := 0, offset := 0 #) /= a IMPLIES
        t_1(a_2) = 244 IMPLIES
        land_192(x) = 128 IMPLIES
        land_192(x_1) = 128 IMPLIES
        0 <= i_1 IMPLIES
        region(base(a)) <= 0 IMPLIES
        4 <= i IMPLIES
        128 <= x IMPLIES
        x <= 143 IMPLIES
        linked(t) IMPLIES
        is_uint16(i) IMPLIES
        is_uint16(i_1) IMPLIES
        is_uint8(x) IMPLIES
        is_uint8(x_1) IMPLIES
        is_uint8(t_1(a_5)) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        valid_rd(t, a_2, i) IMPLIES
        valid_rd(t, a_3, 1) IMPLIES
        valid_rd(t, a_4, 1) IMPLIES
        (0 < i_1 IMPLIES valid_rd(t, shift(a, 0), i_1)) IMPLIES
        valid_rd(t, a_5, 1)
END check_utf8_string_Why3_ide_VCcheck_utf8_string_assert_rte_mem_access_9_part03_goal29
