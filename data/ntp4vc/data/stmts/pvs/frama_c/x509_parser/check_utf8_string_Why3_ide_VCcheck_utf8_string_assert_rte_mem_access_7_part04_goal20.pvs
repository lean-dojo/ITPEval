% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/x509_parser/check_utf8_string_Why3_ide_VCcheck_utf8_string_assert_rte_mem_access_7_part04_goal20:
% an X.509 UTF-8 validation verification condition concluding one-byte read
% validity at the next address under integer-range and memory-model assumptions.
% This file contains no proof.

check_utf8_string_Why3_ide_VCcheck_utf8_string_assert_rte_mem_access_7_part04_goal20: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  is_uint16(value: int): bool =
    0 <= value AND value < 65536

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  goal20: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (a_1: addr),
      (t_1: integer_memory),
      (i, i_1: int),
      (a: addr),
      (t: allocation_table):
      LET a_2: addr = shift(a_1, 0),
          x: int = t_1(a_2)
      IN
        i /= 0 IMPLIES
        i_1 /= 0 IMPLIES
        (# base := 0, offset := 0 #) /= a IMPLIES
        x /= 240 IMPLIES
        x /= 244 IMPLIES
        0 <= i_1 IMPLIES
        region(base(a)) <= 0 IMPLIES
        4 <= i IMPLIES
        128 <= x IMPLIES
        194 <= x IMPLIES
        224 <= x IMPLIES
        240 <= x IMPLIES
        x <= 244 IMPLIES
        linked(t) IMPLIES
        is_uint16(i) IMPLIES
        is_uint16(i_1) IMPLIES
        is_uint8(x) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        valid_rd(t, a_2, i) IMPLIES
        (0 < i_1 IMPLIES valid_rd(t, shift(a, 0), i_1)) IMPLIES
        valid_rd(t, shift(a_1, 1), 1)
END check_utf8_string_Why3_ide_VCcheck_utf8_string_assert_rte_mem_access_7_part04_goal20
