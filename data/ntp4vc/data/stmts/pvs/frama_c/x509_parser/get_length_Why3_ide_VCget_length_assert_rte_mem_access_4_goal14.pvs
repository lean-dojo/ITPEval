% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/x509_parser/get_length_Why3_ide_VCget_length_assert_rte_mem_access_4_goal14:
% an X.509 length-parsing verification condition concluding one-byte read
% validity at byte offset two under bit-pattern, integer-range, linkage,
% region, and prior memory-validity assumptions. This file contains no proof.

get_length_Why3_ide_VCget_length_assert_rte_mem_access_4_goal14: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  is_uint16(value: int): bool =
    0 <= value AND value < 65536

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  land_127(value: int): int =
    mod(value, 128)

  bit_test_7(value: int): bool =
    mod(floor((value :: real) / 128), 2) = 1

  goal14: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (a_1, a, a_2: addr),
      (t_1: integer_memory),
      (i: int),
      (t: allocation_table):
      LET x: int = base(a_1),
          x_1: int = base(a),
          x_2: int = base(a_2),
          a_3: addr = shift(a_1, 0),
          x_3: int = t_1(a_3)
      IN
        i /= 0 IMPLIES
        a_2 /= a IMPLIES
        (# base := 0, offset := 0 #) /= a_1 IMPLIES
        x /= x_1 IMPLIES
        x_2 /= x IMPLIES
        x_3 /= 128 IMPLIES
        land_127(x_3) = 2 IMPLIES
        0 <= i IMPLIES
        region(x_1) <= 0 IMPLIES
        region(x) <= 0 IMPLIES
        region(x_2) <= 0 IMPLIES
        3 <= i IMPLIES
        linked(t) IMPLIES
        is_uint16(i) IMPLIES
        valid_rw(t, a, 1) IMPLIES
        valid_rw(t, a_2, 1) IMPLIES
        is_uint8(x_3) IMPLIES
        bit_test_7(x_3) IMPLIES
        valid_rd(t, a_3, 1) IMPLIES
        (0 < i IMPLIES valid_rd(t, a_3, i)) IMPLIES
        valid_rd(t, shift(a_1, 2), 1)
END get_length_Why3_ide_VCget_length_assert_rte_mem_access_4_goal14
