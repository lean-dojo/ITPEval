% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/x509_parser/parse_NoticeReference_Why3_ide_VCparse_NoticeReference_loop_inv_preserved_goal1:
% an X.509 NoticeReference parsing verification condition preserving a loop
% invariant for read validity under integer-range, linkage, region, and prior
% memory-validity assumptions. This file contains no proof.

parse_NoticeReference_Why3_ide_VCparse_NoticeReference_loop_inv_preserved_goal1: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  is_uint16(value: int): bool =
    0 <= value AND value < 65536

  goal1: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (a_1, a: addr),
      (i_4, i_5, i, i_1, i_2, i_3: int),
      (a_2: addr),
      (i_6: int),
      (t: allocation_table):
      LET x: int = base(a_1),
          x_1: int = base(a),
          a_3: addr = shift(a_1, i_4),
          a_4: addr = shift(a_1, i_4 + i_5 - i),
          x_3: int = i_4 + i_5,
          x_4: int = i_1 - i_2
      IN
        i /= 0 IMPLIES
        i_1 /= 0 IMPLIES
        i_3 /= 0 IMPLIES
        i_5 /= 0 IMPLIES
        (# base := 0, offset := 0 #) /= a_1 IMPLIES
        (# base := 0, offset := 0 #) /= a_2 IMPLIES
        x /= x_1 IMPLIES
        a_3 /= (# base := 0, offset := 0 #) IMPLIES
        a_4 /= (# base := 0, offset := 0 #) IMPLIES
        0 <= i IMPLIES
        i_6 <= i IMPLIES
        0 <= i_1 IMPLIES
        i_2 <= i_1 IMPLIES
        0 <= i_3 IMPLIES
        i_4 <= i_3 IMPLIES
        i_5 <= i_3 IMPLIES
        0 <= i_5 IMPLIES
        0 <= i_6 IMPLIES
        x_3 <= i_3 IMPLIES
        0 <= x_3 IMPLIES
        region(x_1) <= 0 IMPLIES
        region(x) <= 0 IMPLIES
        -2147483648 <= i IMPLIES
        -2147483648 <= i_6 IMPLIES
        2 <= i_4 IMPLIES
        3 <= i_2 IMPLIES
        i <= 65535 IMPLIES
        i_6 <= 65535 IMPLIES
        i <= 2147483647 IMPLIES
        i_6 <= 2147483647 IMPLIES
        -2147483648 <= x_3 IMPLIES
        x_3 <= 65535 IMPLIES
        x_3 <= 2147483647 IMPLIES
        2 + i_6 <= i IMPLIES
        i_1 <= 65535 + i_2 IMPLIES
        i_1 <= 2147483647 + i_2 IMPLIES
        i_2 <= 2147483648 + i_1 IMPLIES
        linked(t) IMPLIES
        is_uint16(i) IMPLIES
        is_uint16(i_1) IMPLIES
        is_uint16(i_2) IMPLIES
        is_uint16(i_3) IMPLIES
        is_uint16(i_4) IMPLIES
        is_uint16(i_5) IMPLIES
        is_uint16(i_6) IMPLIES
        valid_rw(t, a, 1) IMPLIES
        is_uint16(i - i_6) IMPLIES
        is_uint16(x_4) IMPLIES
        is_uint16(i_5 - i) IMPLIES
        valid_rd(t, shift(a_2, 0), i_1) IMPLIES
        (0 < i_3 IMPLIES valid_rd(t, shift(a_1, 0), i_3)) IMPLIES
        (0 < i_5 IMPLIES valid_rd(t, a_3, i_5)) IMPLIES
        (0 < i IMPLIES valid_rd(t, a_4, i)) IMPLIES
        valid_rd(t, shift(a_2, i_2), x_4)
END parse_NoticeReference_Why3_ide_VCparse_NoticeReference_loop_inv_preserved_goal1
