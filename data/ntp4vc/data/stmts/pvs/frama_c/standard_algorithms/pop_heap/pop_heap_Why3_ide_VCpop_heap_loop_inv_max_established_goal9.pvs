% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/pop_heap/pop_heap_Why3_ide_VCpop_heap_loop_inv_max_established_goal9:
% a pop_heap loop-invariant verification condition establishing that the heap
% root value upper-bounds every element in the active prefix, under the source
% memory-validity, integer-range, heap, and maximum-child assumptions. This
% file contains no proof.

pop_heap_Why3_ide_VCpop_heap_loop_inv_max_established_goal9: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  to_uint32(x: int): int =
    mod(x, 4294967296)

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  heap_parent(i: int): int =
    trunc_div(i - 1, 2)

  heap_left(i: int): int =
    1 + 2 * i

  heap_right(i: int): int =
    2 + 2 * i

  p_upperbound(
      memory: integer_memory,
      a: addr,
      lower, upper, value: int): bool =
    FORALL (j: int):
      lower <= j IMPLIES
      j < upper IMPLIES
      memory(shift(a, j)) <= value

  p_isheap(
      memory: integer_memory,
      a: addr,
      n: int): bool =
    FORALL (j: int):
      0 < j IMPLIES
      j < n IMPLIES
      memory(shift(a, j)) <=
        memory(shift(a, heap_parent(j)))

  p_heapmaximumchild(
      memory: integer_memory,
      a: addr,
      n, parent, child: int): bool =
    LET left: int = heap_left(parent),
        child_value: int = memory(shift(a, child)),
        right: int = heap_right(parent)
    IN
      0 <= parent
        AND 2 + parent <= n
        AND (parent <= 2147483646 IMPLIES
          heap_parent(child) = parent)
        AND (2 + left <= n IMPLIES
          memory(shift(a, left)) <= child_value)
        AND (2 + right <= n IMPLIES
          memory(shift(a, right)) <= child_value)

  goal9: bool =
    FORALL
      (i: int),
      (t_1: integer_memory),
      (a: addr),
      (i_1: int),
      (t: allocation_table),
      (region: [int -> int]),
      (linked: [allocation_table -> bool]):
      LET x: int = i - 1,
          x_1: int = t_1(shift(a, x)),
          a_1: addr = shift(a, 0),
          x_2: int = t_1(a_1)
      IN
        0 < i IMPLIES
        0 < i_1 IMPLIES
        region(base(a)) <= 0 IMPLIES
        x_1 < x_2 IMPLIES
        2 <= i IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        p_isheap(t_1, a, i) IMPLIES
        is_sint32(x_2) IMPLIES
        p_heapmaximumchild(t_1, a, i, 0, i_1) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        valid_rw(t, a_1, i) IMPLIES
        is_sint32(t_1(shift(a, heap_parent(0)))) IMPLIES
        is_sint32(x_1) IMPLIES
        valid_rd(t, shift(a, to_uint32(x)), 1) IMPLIES
        (2 + i_1 <= i IMPLIES heap_parent(i_1) = 0) IMPLIES
        p_upperbound(t_1, a, 0, i, x_2)
END pop_heap_Why3_ide_VCpop_heap_loop_inv_max_established_goal9
