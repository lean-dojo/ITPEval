% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/search_n/search_n_Why3_ide_VCsearch_n_loop_inv_not_found_preserved_goal4:
% preservation of the search_n loop invariant asserting that no constant
% subrange has been found after advancing the search index. This file contains no proof.

search_n_Why3_ide_VCsearch_n_loop_inv_not_found_preserved_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  p_constantrange(
      memory: integer_memory,
      a: addr,
      first, last, value: int): bool =
    FORALL (j: int):
      first <= j IMPLIES
      j < last IMPLIES
      memory(shift(a, j)) = value

  p_hasconstantsubrange(
      memory: integer_memory,
      a: addr,
      m, n, value: int): bool =
    EXISTS (j: int):
      LET last: int = n + j IN
        0 <= j
          AND last <= m
          AND p_constantrange(memory, a, j, last, value)

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (i_4: int),
      (a: addr),
      (t_1: integer_memory),
      (i, i_2, i_3: int),
      (t: allocation_table),
      (i_1, i_5: int):
      LET x: int = 1 + i_4,
          a_1: addr = shift(a, i_4),
          x_1: int = t_1(a_1),
          x_2: int = t_1(shift(a, i - 1))
      IN
        0 < i_2 IMPLIES
        i_2 <= i_3 IMPLIES
        i_4 < i_3 IMPLIES
        region(base(a)) <= 0 IMPLIES
        i_4 <= 4294967294 IMPLIES
        i <= x IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        is_uint32(i_4) IMPLIES
        is_sint32(i_5) IMPLIES
        is_uint32(x) IMPLIES
        is_sint32(x_1) IMPLIES
        p_constantrange(t_1, a, i, i_4, i_5) IMPLIES
        NOT p_hasconstantsubrange(t_1, a, i_4, i_2, i_5) IMPLIES
        valid_rd(t, shift(a, 0), i_3) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        is_sint32(x_2) IMPLIES
        (0 < i IMPLIES x_2 /= i_5) IMPLIES
        (x_1 /= i_5
          OR
            (i_1 = i
              AND i_1 + i_2 /= x
              AND i_1 <= x
              AND i_4 <= 4294967294 + i_1)) IMPLIES
        NOT p_hasconstantsubrange(t_1, a, x, i_2, i_5)
END search_n_Why3_ide_VCsearch_n_loop_inv_not_found_preserved_goal4
