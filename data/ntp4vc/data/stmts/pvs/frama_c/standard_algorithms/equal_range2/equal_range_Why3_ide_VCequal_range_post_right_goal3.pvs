% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/equal_range2/equal_range_Why3_ide_VCequal_range_post_right_goal3:
% an equal-range verification condition asserting a strict lower bound on the
% right suffix after the returned interval. This file contains no proof.

equal_range_Why3_ide_VCequal_range_post_right_goal3: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  size_type_pair: TYPE =
    [# pair_first: int, pair_second: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  shift_sint32(p: addr, k: int): addr =
    shift(p, k)

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  is_size_type_pair(s: size_type_pair): bool =
    is_uint32(pair_first(s))
      AND is_uint32(pair_second(s))

  to_uint32(x: int): int =
    mod(x, 4294967296)

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  p_sorted(
      mint_0: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (i_1, i: int):
      i < n IMPLIES
      m <= i_1 IMPLIES
      i_1 < i IMPLIES
      mint_0(shift(a, i_1)) <=
        mint_0(shift(a, i))

  p_lowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v <= mint_0(shift(a, j))

  p_strictlowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v < mint_0(shift(a, j))

  p_strictupperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) < v

  p_upperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) <= v

  goal3: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (s: size_type_pair),
      (i_8, i_10: int),
      (a: addr),
      (t_1: integer_memory),
      (i_7, i_11: int),
      (t: allocation_table),
      (i_1, i_2, i_3, i_4, i_5, i_6, i_9, i: int),
      (p_1, p_2, p_3, p: bool):
      LET x: int = pair_first(s),
          x_1: int = -i_10,
          x_2: int = i_8 - i_10,
          x_3: int = trunc_div(x_2, 2),
          x_4: int = i_10 + x_3,
          x_5: int = pair_second(s),
          a_1: addr = shift_sint32(a, x_4),
          x_6: int = t_1(a_1),
          x_7: int =
            i_10 + to_uint32(trunc_div(to_uint32(x_2), 2)),
          a_2: addr = shift_sint32(a, i_10),
          a_3: addr = shift_sint32(a, 1 + i_10 + x_3),
          x_8: int = -x_3,
          x_9: int = i_8 - 1 - i_10 - x_3,
          x_10: int = x - i_10,
          x_11: int = x_5 - 1 - i_10 - x_3
      IN
        i_8 <= i_7 IMPLIES
        i_11 <= i_8 IMPLIES
        0 <= i_11 IMPLIES
        region(base(a)) <= 0 IMPLIES
        is_size_type_pair(s) IMPLIES
        linked(t) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        is_uint32(i_4) IMPLIES
        is_uint32(i_5) IMPLIES
        is_uint32(i_6) IMPLIES
        is_uint32(i_7) IMPLIES
        is_uint32(i_8) IMPLIES
        is_uint32(i_9) IMPLIES
        is_uint32(i_10) IMPLIES
        is_uint32(i_11) IMPLIES
        is_sint32(i) IMPLIES
        p_sorted(t_1, a, 0, i_7) IMPLIES
        p_strictupperbound(t_1, a, 0, i_11, i) IMPLIES
        p_strictlowerbound(t_1, a, i_8, i_7, i) IMPLIES
        valid_rd(t, shift_sint32(a, 0), i_7) IMPLIES
        (IF i_11 < i_8 THEN
           p_1 = FALSE
             AND p_2 = FALSE
             AND p_3 = FALSE
             AND i_2 = i_1
             AND i_5 = i_4
             AND i_10 = i_9
             AND i_11 = i_10
             AND x = i_3 + i_10
             AND x = i_6 + i_10
             AND x_4 = i_4
             AND x_4 = i_5
             AND x_5 = 1 + i_1 + i_10 + x_3
             AND x_5 = 1 + i_2 + i_10 + x_3
             AND x_5 <= i_8
             AND 0 <= x
             AND i_10 <= x
             AND 0 <= x_5
             AND 0 <= x_3
             AND x_4 < i_8
             AND x <= x_4
             AND x_4 < x_5
             AND x_6 <= i
             AND 0 <= x_7
             AND i <= x_6
             AND x <= 4294967295
             AND x_5 <= 4294967295
             AND i_8 <= 4294967295 + i_10
             AND x_3 <= 4294967295
             AND x_4 <= 4294967294
             AND i_8 <= 4294967296 + i_10 + x_3
             AND x_7 <= 4294967295
             AND valid_rd(t, a_2, x_3)
             AND p_sorted(t_1, a_2, 0, x_3)
             AND valid_rd(t, a_1, 1)
             AND valid_rd(t, a_3, x_9)
             AND p_sorted(t_1, a_3, 0, x_9)
             AND p_strictupperbound(t_1, a_2, 0, x_10, x_6)
             AND p_strictlowerbound(t_1, a_3, x_11, x_9, x_6)
             AND p_lowerbound(t_1, a_2, x_10, x_3, x_6)
             AND p_upperbound(t_1, a_3, 0, x_11, x_6)
         ELSE
           p = FALSE
             AND x = i_11
             AND x_5 = x
         ENDIF)
        IMPLIES
        p_strictlowerbound(t_1, a, x_5, i_7, i)
END equal_range_Why3_ide_VCequal_range_post_right_goal3
