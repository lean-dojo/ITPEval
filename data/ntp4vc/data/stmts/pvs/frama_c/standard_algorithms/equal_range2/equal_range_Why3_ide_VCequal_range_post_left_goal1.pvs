% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/equal_range2/equal_range_Why3_ide_VCequal_range_post_left_goal1:
% an equal-range postcondition VC asserting a strict upper bound on the left
% prefix around the computed midpoint. This file contains no proof.

equal_range_Why3_ide_VCequal_range_post_left_goal1: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  size_type_pair: TYPE =
    [# pair_first: int, pair_second: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  shift_sint32(p: addr, k: int): addr =
    shift(p, k)

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  is_size_type_pair(s: size_type_pair): bool =
    is_uint32(pair_first(s))
      AND is_uint32(pair_second(s))

  to_uint32(x: int): int =
    mod(x, 4294967296)

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  p_sorted(
      mint_0: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (i_1, i: int):
      i < n IMPLIES
      m <= i_1 IMPLIES
      i_1 < i IMPLIES
      mint_0(shift(a, i_1)) <=
        mint_0(shift(a, i))

  p_lowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v <= mint_0(shift(a, j))

  p_strictlowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v < mint_0(shift(a, j))

  p_upperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) <= v

  p_strictupperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) < v

  goal1: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (s: size_type_pair),
      (i_1, i_3: int),
      (a: addr),
      (t_1: integer_memory),
      (i_2, i: int),
      (t: allocation_table):
      LET x: int = pair_second(s),
          x_1: int = pair_first(s),
          x_2: int = i_1 + i_3,
          x_4: int = i_1 + i_3 - x_1,
          x_5: int = trunc_div(x_4, 2),
          x_6: int = x_1 + x_5,
          x_7: int =
            x_1 + to_uint32(trunc_div(to_uint32(x_4), 2)),
          x_9: int = x_1 + x_5 - i_1,
          a_1: addr = shift_sint32(a, x_9),
          x_10: int = t_1(a_1),
          x_11: int = x_1 - i_1,
          a_2: addr = shift_sint32(a, x_11),
          x_12: int = 1 + x_1 + x_5 - i_1,
          x_14: int = i_1 + x - 1 - x_1 - x_5,
          a_3: addr = shift_sint32(a, x_12),
          x_15: int = i_1 + i_3 - 1 - x_1 - x_5
      IN
        0 <= i_1 IMPLIES
        i_3 <= i_2 IMPLIES
        x <= i_3 IMPLIES
        0 <= x_1 IMPLIES
        i_1 <= x_1 IMPLIES
        0 <= x IMPLIES
        x_1 < x_2 IMPLIES
        region(base(a)) <= 0 IMPLIES
        0 <= x_5 IMPLIES
        i_1 <= x_5 IMPLIES
        x_6 < x_2 IMPLIES
        x_6 < i_1 + x IMPLIES
        i_1 <= x_7 IMPLIES
        x_10 <= i IMPLIES
        i <= x_10 IMPLIES
        x_1 <= 4294967295 IMPLIES
        x <= 4294967295 IMPLIES
        x_2 <= 4294967295 + x_1 IMPLIES
        x_5 <= 4294967295 IMPLIES
        x_6 <= 4294967294 + i_1 IMPLIES
        x_2 <= 4294967296 + x_1 + x_5 IMPLIES
        x_7 <= 4294967295 + i_1 IMPLIES
        is_size_type_pair(s) IMPLIES
        linked(t) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        is_sint32(i) IMPLIES
        is_uint32(x_1) IMPLIES
        is_uint32(x) IMPLIES
        p_sorted(t_1, a, 0, i_2) IMPLIES
        is_uint32(x_11) IMPLIES
        p_strictlowerbound(t_1, a, i_3, i_2, i) IMPLIES
        valid_rd(t, shift_sint32(a, 0), i_2) IMPLIES
        p_strictupperbound(t_1, a, 0, x_11, i) IMPLIES
        valid_rd(t, a_2, x_5) IMPLIES
        p_sorted(t_1, a_2, 0, x_5) IMPLIES
        is_uint32(x_9) IMPLIES
        is_uint32(x_12) IMPLIES
        is_uint32(x_14) IMPLIES
        is_sint32(x_10) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        valid_rd(t, a_3, x_15) IMPLIES
        p_sorted(t_1, a_3, 0, x_15) IMPLIES
        p_strictupperbound(t_1, a_2, 0, i_1, x_10) IMPLIES
        p_strictlowerbound(t_1, a_3, x_14, x_15, x_10) IMPLIES
        p_lowerbound(t_1, a_2, i_1, x_5, x_10) IMPLIES
        p_upperbound(t_1, a_3, 0, x_14, x_10) IMPLIES
        p_strictupperbound(t_1, a, 0, x_1, x_10)
END equal_range_Why3_ide_VCequal_range_post_left_goal1
