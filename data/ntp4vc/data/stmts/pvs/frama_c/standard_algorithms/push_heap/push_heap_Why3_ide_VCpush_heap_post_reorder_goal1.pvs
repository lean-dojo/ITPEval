% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/push_heap/push_heap_Why3_ide_VCpush_heap_post_reorder_goal1:
% a push-heap post-reordering verification condition stating that the resulting
% memory preserves all multiset occurrence counts. This file contains no proof.

push_heap_Why3_ide_VCpush_heap_post_reorder_goal1: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  occurrence_counter: TYPE =
    [integer_memory, addr, int, int, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  update(
      memory: integer_memory,
      location: addr,
      value: int): integer_memory =
    LAMBDA (q: addr):
      IF q = location THEN value ELSE memory(q) ENDIF

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size) THEN
        outside(q)
      ELSE
        original(q)
      ENDIF

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  to_uint32(x: int): int =
    mod(x, 4294967296)

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  heap_parent(i: int): int =
    trunc_div(i - 1, 2)

  p_unchanged(
      mint_0, mint_1: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_1(shift(a, j)) = mint_0(shift(a, j))

  p_isheap(
      mint_0: integer_memory,
      a: addr,
      n: int): bool =
    FORALL (j: int):
      0 < j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) <=
        mint_0(shift(a, heap_parent(j)))

  count_axioms(l_count: occurrence_counter): bool =
    (FORALL
      (n, m, v: int),
      (mint_0: integer_memory),
      (a: addr):
        n <= m IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n, v) = 0)
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) = v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        1 + l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) /= v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (v: int),
      (mint_0, mint_1: integer_memory),
      (a: addr),
      (m, n: int):
        is_sint32(v) IMPLIES
        p_unchanged(mint_0, mint_1, a, m, n) IMPLIES
        l_count(mint_1, a, m, n, v) =
          l_count(mint_0, a, m, n, v))

  p_multisetadd(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      n, value: int): bool =
    1 + l_count(mint_1, a, 0, n, value) =
      l_count(mint_0, a, 0, n, value)

  p_multisetminus(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      n, value: int): bool =
    1 + l_count(mint_0, a, 0, n, value) =
      l_count(mint_1, a, 0, n, value)

  p_multisetretain(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      n, value: int): bool =
    l_count(mint_1, a, 0, n, value) =
      l_count(mint_0, a, 0, n, value)

  p_multisetretainrest(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      n, excluded_1, excluded_2: int): bool =
    FORALL (value: int):
      value /= excluded_1 IMPLIES
      value /= excluded_2 IMPLIES
      is_sint32(value) IMPLIES
      p_multisetretain(
        l_count, mint_0, mint_1, a, n, value)

  p_multisetunchanged(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      first, last: int): bool =
    FORALL (value: int):
      is_sint32(value) IMPLIES
      l_count(mint_1, a, first, last, value) =
        l_count(mint_0, a, first, last, value)

  goal1: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_count: occurrence_counter),
      (a: addr),
      (i_1, i_5: int),
      (t_4: integer_memory),
      (i_3: int),
      (t_2: integer_memory),
      (i: int),
      (t: allocation_table),
      (i_2, i_4: int),
      (p_1: bool),
      (t_3: integer_memory),
      (p: bool),
      (t_1: integer_memory):
      LET a_1: addr = shift(a, 0),
          x: int = i_1 - 1,
          a_2: addr = shift(a, i_5),
          a_3: addr = shift(a, to_uint32(x)),
          x_1: int = t_4(a_2),
          a_4: addr = shift(a, x),
          x_2: int = t_4(a_4),
          a_5: addr = shift(a, i_3),
          m: integer_memory = update(t_4, a_4, x_1),
          x_3: int = t_2(a_5),
          a_6: addr = shift(a, i)
      IN
        count_axioms(l_count) IMPLIES
        0 < i_1 IMPLIES
        region(base(a)) <= 0 IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        is_uint32(i_4) IMPLIES
        is_uint32(i_5) IMPLIES
        valid_rw(t, a_1, i_1) IMPLIES
        p_isheap(t_4, a, x) IMPLIES
        (IF 2 <= i_1 THEN
          p_1 = FALSE
            AND heap_parent(x) = i_5
            AND valid_rd(t, a_2, 1)
            AND valid_rd(t, a_3, 1)
            AND
              (IF x_1 < x_2 THEN
                update(t_2, a_5, x_2) = t_3
                  AND valid_rw(t, a_5, 1)
                  AND valid_rw(t, a_3, 1)
                  AND
                    (IF 0 < i_5 THEN
                      p = FALSE
                        AND i_3 = i_2
                        AND i_4 = i_2
                        AND i_4 = i_3
                        AND heap_parent(i_3) = i
                        AND havoc(t_1, m, a_1, i_1) = t_2
                        AND 0 <= i_3
                        AND x_3 < x_2
                        AND 2 + i_3 <= i_1
                        AND p_isheap(t_2, a, i_1)
                        AND p_multisetadd(
                          l_count, t_2, t_4, a, i_1, x_3)
                        AND p_multisetminus(
                          l_count, t_2, t_4, a, i_1, x_2)
                        AND p_multisetretainrest(
                          l_count, t_2, t_4, a, i_1, x_2, x_3)
                        AND
                          (i_3 <= 0
                            OR
                              (x_2 <= t_2(a_6)
                                AND valid_rd(t, a_6, 1)))
                    ELSE
                      i_5 = i_3 AND m = t_2
                    ENDIF)
              ELSE
                t_4 = t_3
              ENDIF)
        ELSE
          t_4 = t_3
        ENDIF) IMPLIES
        p_multisetunchanged(
          l_count, t_3, t_4, a, 0, i_1)
END push_heap_Why3_ide_VCpush_heap_post_reorder_goal1
