% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/max_element/max_element_Why3_ide_VCmax_element_post_result_goal2:
% a max-element postcondition verification condition asserting nonnegativity
% from the source unsigned bound and memory-model assumptions. This file contains no proof.

max_element_Why3_ide_VCmax_element_post_result_goal2: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  goal2: bool =
    FORALL
      (i: int),
      (a: addr),
      (t: allocation_table),
      (region: [int -> int]),
      (linked: [allocation_table -> bool]):
      i <= 0 IMPLIES
      region(base(a)) <= 0 IMPLIES
      linked(t) IMPLIES
      is_uint32(i) IMPLIES
      valid_rd(t, shift(a, 0), i) IMPLIES
      0 <= i
END max_element_Why3_ide_VCmax_element_post_result_goal2
