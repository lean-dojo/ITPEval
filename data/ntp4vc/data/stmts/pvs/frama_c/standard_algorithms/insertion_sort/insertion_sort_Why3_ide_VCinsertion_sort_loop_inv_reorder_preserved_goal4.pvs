% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/insertion_sort/insertion_sort_Why3_ide_VCinsertion_sort_loop_inv_reorder_preserved_goal4:
% preservation of the insertion-sort multiset invariant after shifting the
% reordered interval by one position. This file contains no proof.

insertion_sort_Why3_ide_VCinsertion_sort_loop_inv_reorder_preserved_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  occurrence_counter: TYPE =
    [integer_memory, addr, int, int, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size) THEN
        outside(q)
      ELSE
        original(q)
      ENDIF

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  to_uint32(x: int): int =
    mod(x, 4294967296)

  p_unchanged(
      mint_0, mint_1: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_1(shift(a, j)) = mint_0(shift(a, j))

  p_equalranges(
      mint_0, mint_1: integer_memory,
      a: addr,
      m, n, p: int): bool =
    FORALL (j: int):
      0 <= j IMPLIES
      j < n - m IMPLIES
      mint_1(shift(shift(a, m), j)) =
        mint_0(shift(shift(a, p), j))

  p_sorted(
      mint_0: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (i_1, i: int):
      i < n IMPLIES
      m <= i_1 IMPLIES
      i_1 < i IMPLIES
      mint_0(shift(a, i_1)) <= mint_0(shift(a, i))

  p_upperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) <= v

  p_strictlowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v < mint_0(shift(a, j))

  count_axioms(l_count: occurrence_counter): bool =
    (FORALL
      (n, m, v: int),
      (mint_0: integer_memory),
      (a: addr):
        n <= m IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n, v) = 0)
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) = v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        1 + l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) /= v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (v: int),
      (mint_0, mint_1: integer_memory),
      (a: addr),
      (m, n: int):
        is_sint32(v) IMPLIES
        p_unchanged(mint_0, mint_1, a, m, n) IMPLIES
        l_count(mint_1, a, m, n, v) =
          l_count(mint_0, a, m, n, v))

  p_multisetunchanged(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      first, last: int): bool =
    FORALL (value: int):
      is_sint32(value) IMPLIES
      l_count(mint_1, a, first, last, value) =
        l_count(mint_0, a, first, last, value)

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_count: occurrence_counter),
      (i_2, i_1: int),
      (a: addr),
      (t_1, t_3: integer_memory),
      (i: int),
      (t_2: integer_memory),
      (t: allocation_table):
      LET x_1: int = i_2 - i_1,
          x_2: int = 1 + i_2,
          a_1: addr = shift(a, 0),
          a_2: addr = shift(a, i_2),
          a_3: addr = shift(a, i_1),
          x_3: int = 1 + i_2 - i_1,
          a_4: integer_memory = havoc(t_1, t_3, a_1, i),
          a_5: int = a_4(a_2),
          a_6: integer_memory = havoc(t_2, a_4, a_3, x_3)
      IN
        count_axioms(l_count) IMPLIES
        i_2 <= i IMPLIES
        0 <= i_1 IMPLIES
        0 <= i_2 IMPLIES
        i_2 < i IMPLIES
        i_1 <= i_2 IMPLIES
        region(base(a)) <= 0 IMPLIES
        i_2 <= 4294967294 IMPLIES
        i_2 <= 4294967295 + i_1 IMPLIES
        to_uint32(x_1) <= 4294967294 IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(x_2) IMPLIES
        valid_rd(t, a_1, i_2) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        valid_rw(t, a_1, i) IMPLIES
        valid_rw(t, a_3, x_3) IMPLIES
        is_sint32(a_5) IMPLIES
        p_sorted(a_4, a, 0, i_2) IMPLIES
        p_unchanged(a_4, t_3, a, i_2, i) IMPLIES
        p_multisetunchanged(l_count, a_4, t_3, a, 0, i_2) IMPLIES
        p_upperbound(a_4, a, 0, i_1, a_5) IMPLIES
        p_strictlowerbound(a_4, a, i_1, i_2, a_5) IMPLIES
        p_equalranges(a_6, a_4, a_3, 0, x_1, 1) IMPLIES
        p_equalranges(a_6, a_4, a_3, x_1, x_3, 0) IMPLIES
        p_multisetunchanged(l_count, a_6, t_3, a, 0, x_2)
END insertion_sort_Why3_ide_VCinsertion_sort_loop_inv_reorder_preserved_goal4
