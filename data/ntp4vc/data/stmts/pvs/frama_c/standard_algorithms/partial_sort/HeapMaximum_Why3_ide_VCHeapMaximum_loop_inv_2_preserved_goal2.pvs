% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/partial_sort/HeapMaximum_Why3_ide_VCHeapMaximum_loop_inv_2_preserved_goal2:
% preservation of a HeapMaximum loop upper-bound invariant, concluding that
% the value at index i_2 does not exceed the heap root value under the source
% index bounds, unsigned-range conditions, and heap-prefix assumption. This
% file contains no proof.

HeapMaximum_Why3_ide_VCHeapMaximum_loop_inv_2_preserved_goal2: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  heap_parent(i: int): int =
    trunc_div(i - 1, 2)

  p_isheap(
      memory: integer_memory,
      a: addr,
      n: int): bool =
    FORALL (j: int):
      0 < j IMPLIES
      j < n IMPLIES
      memory(shift(a, j)) <=
        memory(shift(a, heap_parent(j)))

  goal2: bool =
    FORALL
      (region: [int -> int]),
      (t: integer_memory),
      (a: addr),
      (i, i_1, i_2: int):
      LET x: int = t(shift(a, 0))
      IN
        0 < i IMPLIES
        i_1 <= i IMPLIES
        0 <= i_1 IMPLIES
        i_1 < i IMPLIES
        i_2 <= i_1 IMPLIES
        0 <= i_2 IMPLIES
        region(base(a)) <= 0 IMPLIES
        i_1 <= 4294967294 IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        p_isheap(t, a, i) IMPLIES
        is_uint32(1 + i_1) IMPLIES
        (FORALL (i_3: int):
          0 <= i_3 IMPLIES
          i_3 < i_1 IMPLIES
          t(shift(a, i_3)) <= x) IMPLIES
        t(shift(a, i_2)) <= x
END HeapMaximum_Why3_ide_VCHeapMaximum_loop_inv_2_preserved_goal2
