% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/partial_sort/partial_sort_Why3_ide_VCpartial_sort_stmt_post_5_goal24:
% a partial-sort verification condition asserting preservation of the
% multiset on the prefix through index i_3 after a swap and a subsequent
% havoc update, under the source memory, heap, ordering, and range assumptions.
% This file contains no proof.

partial_sort_Why3_ide_VCpartial_sort_stmt_post_5_goal24: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  occurrence_counter: TYPE =
    [integer_memory, addr, int, int, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size) THEN
        outside(q)
      ELSE
        original(q)
      ENDIF

  fun_update(
      f: integer_memory,
      key: addr,
      value: int): integer_memory =
    LAMBDA (q: addr):
      IF q = key THEN value ELSE f(q) ENDIF

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  heap_parent(i: int): int =
    trunc_div(i - 1, 2)

  p_unchanged(
      mint_0, mint_1: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_1(shift(a, j)) = mint_0(shift(a, j))

  p_isheap(
      mint_0: integer_memory,
      a: addr,
      n: int): bool =
    FORALL (j: int):
      0 < j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) <=
        mint_0(shift(a, heap_parent(j)))

  count_axioms(l_count: occurrence_counter): bool =
    (FORALL
      (n, m, v: int),
      (mint_0: integer_memory),
      (a: addr):
        n <= m IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n, v) = 0)
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) = v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        1 + l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) /= v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (v: int),
      (mint_0, mint_1: integer_memory),
      (a: addr),
      (m, n: int):
        is_sint32(v) IMPLIES
        p_unchanged(mint_0, mint_1, a, m, n) IMPLIES
        l_count(mint_1, a, m, n, v) =
          l_count(mint_0, a, m, n, v))

  p_multisetunchanged(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      first, last: int): bool =
    FORALL (value: int):
      is_sint32(value) IMPLIES
      l_count(mint_1, a, first, last, value) =
        l_count(mint_0, a, first, last, value)

  p_upperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) <= v

  p_lowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v <= mint_0(shift(a, j))

  p_maxelement(
      mint_0: integer_memory,
      a: addr,
      n, max_index: int): bool =
    0 <= max_index
      AND max_index < n
      AND p_upperbound(
        mint_0, a, 0, n, mint_0(shift(a, max_index)))

  p_swappedinside(
      mint_0, mint_1: integer_memory,
      a: addr,
      swap_index, other_index, n: int): bool =
    LET a_1: addr = shift(a, swap_index),
        a_2: addr = shift(a, other_index)
    IN
      mint_1(a_1) = mint_0(a_2)
        AND mint_1(a_2) = mint_0(a_1)
        AND 0 <= swap_index
        AND swap_index < other_index
        AND other_index < n
        AND p_unchanged(mint_0, mint_1, a, 0, swap_index)
        AND p_unchanged(
          mint_0, mint_1, a, 1 + swap_index, other_index)
        AND p_unchanged(
          mint_0, mint_1, a, 1 + other_index, n)

  goal24: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_count: occurrence_counter),
      (a: addr),
      (t_1, t_5: integer_memory),
      (i_2: int),
      (t_2: integer_memory),
      (i_1: int),
      (t_3: integer_memory),
      (i_3, i: int),
      (t_4: integer_memory),
      (t: allocation_table):
      LET a_1: addr = shift(a, 0),
          a_2: integer_memory = havoc(t_1, t_5, a_1, i_2),
          a_3: integer_memory = havoc(t_2, a_2, a_1, i_1),
          a_4: integer_memory = havoc(t_3, a_3, a_1, i_2),
          x: int = i_2 - 1,
          a_5: addr = shift(a, x),
          a_6: int = a_4(a_5),
          a_7: int = a_3(a_1),
          a_8: addr = shift(a, i_3),
          a_9: int = a_4(a_8),
          a_10: integer_memory =
            fun_update(fun_update(a_4, a_8, i), a_5, a_9),
          a_11: int = a_10(a_8),
          a_12: int = a_3(a_8),
          x_1: int = 1 + i_3,
          a_13: integer_memory = havoc(t_4, a_10, a_1, i_2),
          a_14: int = a_13(a_1)
      IN
        count_axioms(l_count) IMPLIES
        a_6 = a_7 IMPLIES
        a_11 = a_6 IMPLIES
        0 < i_2 IMPLIES
        i_2 <= i_1 IMPLIES
        i_3 <= i_1 IMPLIES
        0 <= i_2 IMPLIES
        i_3 < i_1 IMPLIES
        i_2 <= i_3 IMPLIES
        region(base(a)) <= 0 IMPLIES
        a_12 < a_7 IMPLIES
        linked(t) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        valid_rd(t, a_8, 1) IMPLIES
        valid_rw(t, a_1, i_1) IMPLIES
        valid_rw(t, a_1, i_2) IMPLIES
        valid_rw(t, a_8, 1) IMPLIES
        valid_rw(t, a_5, 1) IMPLIES
        p_isheap(a_2, a, i_2) IMPLIES
        p_multisetunchanged(
          l_count, a_2, t_5, a, 0, i_2) IMPLIES
        is_sint32(a_7) IMPLIES
        is_sint32(a_12) IMPLIES
        p_isheap(a_3, a, i_2) IMPLIES
        p_multisetunchanged(
          l_count, a_3, t_5, a, 0, i_3) IMPLIES
        p_unchanged(a_3, t_5, a, i_3, i_1) IMPLIES
        p_upperbound(a_3, a, 0, i_2, a_7) IMPLIES
        p_lowerbound(a_3, a, i_2, i_3, a_7) IMPLIES
        is_sint32(a_9) IMPLIES
        is_sint32(a_6) IMPLIES
        p_isheap(a_4, a, x) IMPLIES
        is_sint32(a_11) IMPLIES
        p_multisetunchanged(
          l_count, a_4, t_5, a, 0, x_1) IMPLIES
        p_multisetunchanged(
          l_count, a_4, a_3, a, 0, i_2) IMPLIES
        p_maxelement(a_4, a, i_2, x) IMPLIES
        p_isheap(a_10, a, x) IMPLIES
        p_multisetunchanged(
          l_count, a_10, a_4, a, 0, x_1) IMPLIES
        p_unchanged(a_10, a_4, a, x_1, i_1) IMPLIES
        p_swappedinside(a_10, a_4, a, x, i_3, x_1) IMPLIES
        is_sint32(a_14) IMPLIES
        p_isheap(a_13, a, i_2) IMPLIES
        p_multisetunchanged(
          l_count, a_13, a_10, a, 0, i_2) IMPLIES
        p_lowerbound(a_13, a, i_2, x_1, a_14) IMPLIES
        p_multisetunchanged(
          l_count, a_13, a_10, a, 0, x_1)
END partial_sort_Why3_ide_VCpartial_sort_stmt_post_5_goal24
