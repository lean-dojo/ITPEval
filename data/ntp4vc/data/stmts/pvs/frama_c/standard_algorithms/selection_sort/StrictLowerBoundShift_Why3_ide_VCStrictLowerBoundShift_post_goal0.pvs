% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/selection_sort/StrictLowerBoundShift_Why3_ide_VCStrictLowerBoundShift_post_goal0:
% a selection-sort verification condition transporting a strict integer lower
% bound from a shifted half-open memory range to the corresponding original
% range. This file contains no proof.

StrictLowerBoundShift_Why3_ide_VCStrictLowerBoundShift_post_goal0: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  p_strictlowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v < mint_0(shift(a, j))

  goal0: bool =
    FORALL
      (region: [int -> int]),
      (i_1, i_3: int),
      (a: addr),
      (i_2, i: int),
      (t: integer_memory):
      LET x: int = i_1 + i_3
      IN
        region(base(a)) <= 0 IMPLIES
        x <= 4294967295 IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        is_sint32(i) IMPLIES
        p_strictlowerbound(t, shift(a, i_3), i_2, i_1, i) IMPLIES
        p_strictlowerbound(t, a, i_2 + i_3, x, i)
END StrictLowerBoundShift_Why3_ide_VCStrictLowerBoundShift_post_goal0
