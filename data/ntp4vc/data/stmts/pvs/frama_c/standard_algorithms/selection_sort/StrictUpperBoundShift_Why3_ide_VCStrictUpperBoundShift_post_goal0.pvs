% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/selection_sort/StrictUpperBoundShift_Why3_ide_VCStrictUpperBoundShift_post_goal0:
% a selection-sort verification condition transporting a strict integer upper
% bound from a shifted zero-based half-open memory range to the corresponding
% original range. This file contains no proof.

StrictUpperBoundShift_Why3_ide_VCStrictUpperBoundShift_post_goal0: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  p_strictupperbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_0(shift(a, j)) < v

  goal0: bool =
    FORALL
      (region: [int -> int]),
      (i_2, i_1: int),
      (a: addr),
      (i: int),
      (t: integer_memory):
      i_2 <= i_1 IMPLIES
      region(base(a)) <= 0 IMPLIES
      is_uint32(i_1) IMPLIES
      is_uint32(i_2) IMPLIES
      is_sint32(i) IMPLIES
      p_strictupperbound(t, shift(a, i_2), 0, i_1 - i_2, i) IMPLIES
      p_strictupperbound(t, a, i_2, i_1, i)
END StrictUpperBoundShift_Why3_ide_VCStrictUpperBoundShift_post_goal0
