% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/selection_sort/SortedShift_Why3_ide_VCSortedShift_post_goal0:
% a selection-sort verification condition transporting sortedness of an
% integer-valued half-open memory range to its shifted zero-based view.
% This file contains no proof.

SortedShift_Why3_ide_VCSortedShift_post_goal0: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  p_sorted(
      mint_0: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (j, k: int):
      k < n IMPLIES
      m <= j IMPLIES
      j < k IMPLIES
      mint_0(shift(a, j)) <= mint_0(shift(a, k))

  goal0: bool =
    FORALL
      (region: [int -> int]),
      (i_1, i: int),
      (a: addr),
      (t: integer_memory):
      i_1 <= i IMPLIES
      region(base(a)) <= 0 IMPLIES
      is_uint32(i) IMPLIES
      is_uint32(i_1) IMPLIES
      p_sorted(t, a, i_1, i) IMPLIES
      p_sorted(t, shift(a, i_1), 0, i - i_1)
END SortedShift_Why3_ide_VCSortedShift_post_goal0
