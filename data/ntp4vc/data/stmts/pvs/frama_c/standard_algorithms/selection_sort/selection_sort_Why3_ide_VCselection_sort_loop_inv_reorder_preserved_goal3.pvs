% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/standard_algorithms/selection_sort/selection_sort_Why3_ide_VCselection_sort_loop_inv_reorder_preserved_goal3:
% a selection-sort loop verification condition preserving multiset counts
% after swapping two integer array cells under the source range invariants.
% This file contains no proof.

selection_sort_Why3_ide_VCselection_sort_loop_inv_reorder_preserved_goal3: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  occurrence_counter: TYPE =
    [integer_memory, addr, int, int, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size) THEN
        outside(q)
      ELSE
        original(q)
      ENDIF

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    0 < n IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + n <= m(base(p))

  is_uint32(x: int): bool =
    0 <= x AND x < 4294967296

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  p_unchanged(
      mint_0, mint_1: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      mint_1(shift(a, j)) = mint_0(shift(a, j))

  p_sorted(
      mint_0: integer_memory,
      a: addr,
      m, n: int): bool =
    FORALL (j, k: int):
      k < n IMPLIES
      m <= j IMPLIES
      j < k IMPLIES
      mint_0(shift(a, j)) <= mint_0(shift(a, k))

  p_lowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v <= mint_0(shift(a, j))

  p_strictlowerbound(
      mint_0: integer_memory,
      a: addr,
      m, n, v: int): bool =
    FORALL (j: int):
      m <= j IMPLIES
      j < n IMPLIES
      v < mint_0(shift(a, j))

  p_minelement(
      mint_0: integer_memory,
      a: addr,
      n, min_index: int): bool =
    0 <= min_index
      AND min_index < n
      AND p_lowerbound(
        mint_0,
        a,
        0,
        n,
        mint_0(shift(a, min_index)))

  count_axioms(l_count: occurrence_counter): bool =
    (FORALL
      (n, m, v: int),
      (mint_0: integer_memory),
      (a: addr):
        n <= m IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n, v) = 0)
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) = v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        1 + l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (n: int),
      (mint_0: integer_memory),
      (a: addr),
      (v, m: int):
        mint_0(shift(a, n - 1)) /= v IMPLIES
        m < n IMPLIES
        is_sint32(v) IMPLIES
        l_count(mint_0, a, m, n - 1, v) =
          l_count(mint_0, a, m, n, v))
    AND
    (FORALL
      (v: int),
      (mint_0, mint_1: integer_memory),
      (a: addr),
      (m, n: int):
        is_sint32(v) IMPLIES
        p_unchanged(mint_0, mint_1, a, m, n) IMPLIES
        l_count(mint_1, a, m, n, v) =
          l_count(mint_0, a, m, n, v))

  p_multisetunchanged(
      l_count: occurrence_counter,
      mint_0, mint_1: integer_memory,
      a: addr,
      first, last: int): bool =
    FORALL (value: int):
      is_sint32(value) IMPLIES
      l_count(mint_1, a, first, last, value) =
        l_count(mint_0, a, first, last, value)

  goal3: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_count: occurrence_counter),
      (a: addr),
      (t_1, t_2: integer_memory),
      (i_2, i_3, i_1, i: int),
      (t: allocation_table):
      LET a_1: addr = shift(a, 0),
          a_2: integer_memory = havoc(t_1, t_2, a_1, i_2),
          a_3: addr = shift(a, i_3),
          a_4: addr = shift(a, i_1),
          a_5: int = a_2(a_3),
          a_6: integer_memory =
            (a_2 WITH [(a_3) := i]) WITH [(a_4) := a_5],
          a_7: int = a_6(a_3),
          a_8: int = a_2(a_4),
          x_1: int = i_1 - i_3,
          x_2: int = i_2 - i_3,
          a_9: int = a_2(shift(a, i_3 - 1))
      IN
        count_axioms(l_count) IMPLIES
        a_7 = a_8 IMPLIES
        0 <= i_1 IMPLIES
        i_1 < i_2 IMPLIES
        i_3 <= i_1 IMPLIES
        i_1 <= i_2 IMPLIES
        i_3 <= i_2 IMPLIES
        0 <= i_3 IMPLIES
        i_3 < i_2 IMPLIES
        region(base(a)) <= 0 IMPLIES
        i_3 <= 4294967294 IMPLIES
        i_1 <= 4294967295 IMPLIES
        i_2 <= 4294967295 + i_3 IMPLIES
        linked(t) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint32(i_3) IMPLIES
        is_uint32(x_1) IMPLIES
        is_sint32(t_2(shift(a, -1))) IMPLIES
        valid_rw(t, a_1, i_2) IMPLIES
        valid_rd(t, a_3, x_2) IMPLIES
        is_sint32(a_8) IMPLIES
        is_sint32(a_5) IMPLIES
        is_sint32(a_9) IMPLIES
        p_sorted(a_2, a, 0, i_3) IMPLIES
        is_sint32(a_7) IMPLIES
        p_multisetunchanged(l_count, a_2, t_2, a, 0, i_2) IMPLIES
        p_minelement(a_2, a_3, x_2, x_1) IMPLIES
        p_strictlowerbound(a_2, a_3, 0, x_1, a_8) IMPLIES
        p_unchanged(a_6, a_2, a, 0, i_3) IMPLIES
        p_unchanged(a_6, a_2, a, 1 + i_1, i_2) IMPLIES
        p_unchanged(a_6, a_2, a, 1 + i_3, i_1) IMPLIES
        (0 < i_3 IMPLIES
          p_lowerbound(a_2, a, i_3, i_2, a_9)) IMPLIES
        p_multisetunchanged(l_count, a_6, t_2, a, 0, i_2)
END selection_sort_Why3_ide_VCselection_sort_loop_inv_reorder_preserved_goal3
