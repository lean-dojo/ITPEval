% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strim_Why3_ide_VCstrim_len_assign_exit_part6_goal19:
% a string-trimming length-assignment exit verification condition concluding
% that the byte after the inspected address is included in the original
% string region under the stated memory, address-order, byte-range,
% string-validity, and intervening-whitespace assumptions.
% This file contains no proof.

strim_Why3_ide_VCstrim_len_assign_exit_part6_goal19: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  invalid(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      malloc_0(base(p)) <= offset(p)
        OR offset(p) + size <= 0

  included(
      p: addr,
      p_size: int,
      q: addr,
      q_size: int): bool =
    0 < p_size IMPLIES
      0 <= q_size
        AND base(p) = base(q)
        AND offset(q) <= offset(p)
        AND offset(p) + p_size <= offset(q) + q_size

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  p_isspace(value: int): bool =
    value = 9
      OR value = 10
      OR value = 12
      OR value = 13
      OR value = 32

  address_order_laws(
      addr_le, addr_lt: address_relation): bool =
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q)))
      AND
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_lt(p, q) IFF offset(p) < offset(q)))

  uint64_conversion_laws(to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  goal19: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le, addr_lt: address_relation),
      (to_uint64: integer_conversion),
      (l_strlen: string_length_function),
      (t_1: integer_memory),
      (a: addr),
      (p: bool),
      (a_1: addr),
      (t: allocation_table):
      address_order_laws(addr_le, addr_lt) IMPLIES
      uint64_conversion_laws(to_uint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      LET x: int = l_strlen(t_1, a),
          a_2: addr = shift(a, x - 1),
          x_1: int = t_1(a_2),
          x_2: int = t_1(a_1),
          a_3: addr = shift(a, -1),
          a_4: addr = shift(a_1, 1)
      IN
        NOT (x = 0) IMPLIES
        t_1(shift(a, x)) = 0 IMPLIES
        NOT (x_1 = 0) IMPLIES
        0 < x IMPLIES
        region(base(a)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_sint8(x_2) IMPLIES
        p_valid_str(t, t_1, a) IMPLIES
        is_uint64(x) IMPLIES
        addr_le(a_3, a_1) IMPLIES
        NOT invalid(t, a_4, 1) IMPLIES
        addr_le(a_1, a_2) IMPLIES
        is_sint8(x_1) IMPLIES
        (IF addr_le(a, a_1)
         THEN
           p = FALSE AND NOT p_isspace(x_2)
         ELSE
           a_3 = a_1 OR NOT p_isspace(x_2)
         ENDIF) IMPLIES
        (FORALL (i: int):
          0 <= i IMPLIES
          i < x IMPLIES
          NOT (t_1(shift(a, i)) = 0)) IMPLIES
        (FORALL (a_5: addr):
          addr_lt(a_1, a_5) IMPLIES
          addr_le(a_5, a_2) IMPLIES
          p_isspace(t_1(a_5))) IMPLIES
        included(a_4, 1, shift(a, 0), 1 + x)
END strim_Why3_ide_VCstrim_len_assign_exit_part6_goal19
