% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strchr_Why3_ide_VCstrchr_loop_inv_preserved_goal1:
% a strchr loop-invariant preservation condition showing that advancing the
% current address by one preserves validity as a string pointer.
% This file contains no proof.

strchr_Why3_ide_VCstrchr_loop_inv_preserved_goal1: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]
  string_search_function: TYPE = [integer_memory, addr, int -> addr]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  address_order_laws(
      addr_le, addr_lt: address_relation): bool =
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q)))
      AND
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_lt(p, q) IFF offset(p) < offset(q)))

  conversion_laws(
      to_sint8, to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_sint8(to_sint8(value)))
      AND
    (FORALL (value: int):
      is_sint8(value) IMPLIES to_sint8(value) = value)
      AND
    (FORALL (value: int):
      to_sint8(to_sint8(value)) = to_sint8(value))
      AND
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  strchr_law(l_strchr: string_search_function): bool =
    FORALL
      (mchar_0: integer_memory),
      (str_0: addr),
      (c: int):
      IF mchar_0(str_0) = c
      THEN l_strchr(mchar_0, str_0, c) = str_0
      ELSIF mchar_0(str_0) = 0
      THEN
        l_strchr(mchar_0, str_0, c) =
          (# base := 0, offset := 0 #)
      ELSE
        l_strchr(mchar_0, shift(str_0, 1), c) =
          l_strchr(mchar_0, str_0, c)
      ENDIF

  goal1: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le, addr_lt: address_relation),
      (to_sint8, to_uint64: integer_conversion),
      (l_strlen: string_length_function),
      (l_strchr: string_search_function),
      (t_1: integer_memory),
      (a: addr),
      (i: int),
      (a_1: addr),
      (t: allocation_table):
      address_order_laws(addr_le, addr_lt) IMPLIES
      conversion_laws(to_sint8, to_uint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      strchr_law(l_strchr) IMPLIES
      LET x: int = t_1(a),
          x_1: int = to_sint8(i)
      IN
        NOT (x = 0) IMPLIES
        NOT (x = x_1) IMPLIES
        l_strchr(t_1, a_1, x_1) = l_strchr(t_1, a, x_1) IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_sint32(i) IMPLIES
        addr_le(a_1, a) IMPLIES
        is_sint8(x) IMPLIES
        p_valid_str(t, t_1, a) IMPLIES
        p_valid_str(t, t_1, a_1) IMPLIES
        addr_le(a, shift(a_1, l_strlen(t_1, a_1))) IMPLIES
        (FORALL (a_2: addr):
          addr_lt(a_2, a) IMPLIES
          addr_le(a_1, a_2) IMPLIES
          NOT (t_1(a_2) = x_1)) IMPLIES
        p_valid_str(t, t_1, shift(a, 1))
END strchr_Why3_ide_VCstrchr_loop_inv_preserved_goal1
