% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strim_Why3_ide_VCstrim_loop_inv_2_preserved_goal6:
% preservation of a string-trimming loop invariant concluding that the byte
% at the next scan address is whitespace under the stated memory, address,
% byte-range, string-validity, and intervening-whitespace assumptions.
% This file contains no proof.

strim_Why3_ide_VCstrim_loop_inv_2_preserved_goal6: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_sint64(value: int): bool =
    -9223372036854775808 <= value AND value < 9223372036854775808

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  p_isspace(value: int): bool =
    value = 9
      OR value = 10
      OR value = 12
      OR value = 13
      OR value = 32

  address_order_laws(
      addr_le, addr_lt: address_relation): bool =
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q)))
      AND
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_lt(p, q) IFF offset(p) < offset(q)))

  int64_conversion_laws(
      to_uint64, to_sint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))
      AND
    (FORALL (value: int):
      is_sint64(to_sint64(value)))
      AND
    (FORALL (value: int):
      is_sint64(value) IMPLIES to_sint64(value) = value)
      AND
    (FORALL (value: int):
      to_sint64(to_sint64(value)) = to_sint64(value))
      AND
    (FORALL (value: int):
      to_sint64(to_uint64(value)) = to_sint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  goal6: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le, addr_lt: address_relation),
      (to_uint64, to_sint64: integer_conversion),
      (l_strlen: string_length_function),
      (t_1: integer_memory),
      (a, a_1: addr),
      (i: int),
      (t: allocation_table),
      (a_2: addr):
      address_order_laws(addr_le, addr_lt) IMPLIES
      int64_conversion_laws(to_uint64, to_sint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      LET x: int = l_strlen(t_1, a),
          a_3: addr = shift(a, x - 1),
          x_1: int = t_1(a_3),
          x_2: int = t_1(a_1)
      IN
        NOT (i = 0) IMPLIES
        NOT (x = 0) IMPLIES
        t_1(shift(a, x)) = 0 IMPLIES
        NOT (x_1 = 0) IMPLIES
        0 < x IMPLIES
        region(base(a)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_uint8(i) IMPLIES
        addr_le(a, a_1) IMPLIES
        is_sint8(x_2) IMPLIES
        p_isspace(x_2) IMPLIES
        p_valid_str(t, t_1, a) IMPLIES
        is_uint64(x) IMPLIES
        addr_lt(shift(a_1, -1), a_2) IMPLIES
        addr_le(shift(a, -1), a_1) IMPLIES
        addr_le(a_1, a_3) IMPLIES
        addr_le(a_2, a_3) IMPLIES
        is_sint8(x_1) IMPLIES
        (FORALL (i_1: int):
          0 <= i_1 IMPLIES
          i_1 < x IMPLIES
          NOT (t_1(shift(a, i_1)) = 0)) IMPLIES
        (FORALL (a_4: addr):
          addr_lt(a_1, a_4) IMPLIES
          addr_le(a_4, a_3) IMPLIES
          p_isspace(t_1(a_4))) IMPLIES
        p_isspace(t_1(a_2))
END strim_Why3_ide_VCstrim_loop_inv_2_preserved_goal6
