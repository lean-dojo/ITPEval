% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strcmp_Why3_ide_VCstrcmp_loop_inv_6_preserved_goal8:
% preservation of the strcmp loop length relation after advancing the second
% string address, under the valid-string, byte, and comparison invariants.
% This file contains no proof.

strcmp_Why3_ide_VCstrcmp_loop_inv_6_preserved_goal8: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]
  bounded_string_compare: TYPE =
    [integer_memory, addr, addr, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  address_order_law(addr_le: address_relation): bool =
    FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q))

  uint8_conversion_laws(to_uint8: integer_conversion): bool =
    (FORALL (value: int):
      is_uint8(to_uint8(value)))
      AND
    (FORALL (value: int):
      is_uint8(value) IMPLIES to_uint8(value) = value)
      AND
    (FORALL (value: int):
      to_uint8(to_uint8(value)) = to_uint8(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  uint64_conversion_laws(to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  l_cmp(a, b: int): int =
    IF b = a THEN 0 ELSE IF a < b THEN -1 ELSE 1 ENDIF ENDIF

  strncmp_law(
      to_uint8: integer_conversion,
      l_strncmp_1: bounded_string_compare): bool =
    FORALL
      (mchar_0: integer_memory),
      (cs_0, ct_0: addr),
      (n: int):
      IF n = -1
      THEN l_strncmp_1(mchar_0, cs_0, ct_0, n) = 0
      ELSIF mchar_0(shift(ct_0, 0)) = mchar_0(shift(cs_0, 0))
      THEN
        l_strncmp_1(
          mchar_0, shift(cs_0, 1), shift(ct_0, 1), n - 1) =
            l_strncmp_1(mchar_0, cs_0, ct_0, n)
      ELSE
        l_cmp(
          to_uint8(mchar_0(shift(cs_0, 0))),
          to_uint8(mchar_0(shift(ct_0, 0)))) =
            l_strncmp_1(mchar_0, cs_0, ct_0, n)
      ENDIF

  l_strcmp(
      l_strncmp_1: bounded_string_compare,
      l_strlen: string_length_function,
      mchar_0: integer_memory,
      cs_0, ct_0: addr): int =
    l_strncmp_1(mchar_0, cs_0, ct_0, l_strlen(mchar_0, cs_0))

  goal8: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le: address_relation),
      (to_uint8, to_uint64: integer_conversion),
      (l_strlen: string_length_function),
      (l_strncmp_1: bounded_string_compare),
      (t_1: integer_memory),
      (a, a_2, a_3, a_1: addr),
      (t: allocation_table):
      address_order_law(addr_le) IMPLIES
      uint8_conversion_laws(to_uint8) IMPLIES
      uint64_conversion_laws(to_uint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      strncmp_law(to_uint8, l_strncmp_1) IMPLIES
      LET x: int = t_1(a),
          x_1: int = to_uint8(x),
          x_2: int = t_1(a_2),
          x_3: int = offset(a_2),
          x_4: int = offset(a_3),
          x_5: int = l_strlen(t_1, a_3),
          x_6: int = x_4 + x_5,
          x_7: int = x_3 - x_4,
          x_8: int = t_1(shift(a_3, x_7)),
          x_9: int = t_1(shift(a_1, x_7))
      IN
        NOT (x_1 = 0) IMPLIES
        to_uint8(x_2) = x_1 IMPLIES
        l_strcmp(l_strncmp_1, l_strlen, t_1, a_3, a_1) =
          l_strcmp(l_strncmp_1, l_strlen, t_1, a_2, a) IMPLIES
        offset(a_1) + x_3 = offset(a) + x_4 IMPLIES
        x_6 = x_3 + l_strlen(t_1, a_2) IMPLIES
        x_8 = x_9 IMPLIES
        ((FORALL (i: int):
          0 <= i IMPLIES
          i <= x_5 IMPLIES
          to_uint8(t_1(shift(a_3, i))) =
            to_uint8(t_1(shift(a_1, i))))
          IFF
         (FORALL (i: int):
          0 <= i IMPLIES
          i <= x_5 IMPLIES
          t_1(shift(a_3, i)) = t_1(shift(a_1, i)))) IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        region(base(a_3)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        addr_le(a_1, a) IMPLIES
        addr_le(a_3, a_2) IMPLIES
        is_sint8(x) IMPLIES
        is_sint8(x_2) IMPLIES
        p_valid_str(t, t_1, a) IMPLIES
        p_valid_str(t, t_1, a_1) IMPLIES
        p_valid_str(t, t_1, a_2) IMPLIES
        p_valid_str(t, t_1, a_3) IMPLIES
        addr_le(a, shift(a_1, l_strlen(t_1, a_1))) IMPLIES
        addr_le(a_2, shift(a_3, x_5)) IMPLIES
        is_sint8(x_9) IMPLIES
        is_sint8(x_8) IMPLIES
        (FORALL (i: int):
          0 <= i IMPLIES
          i + x_4 < x_3 IMPLIES
          t_1(shift(a_3, i)) = t_1(shift(a_1, i))) IMPLIES
        1 + x_3 + l_strlen(t_1, shift(a_2, 1)) = x_6
END strcmp_Why3_ide_VCstrcmp_loop_inv_6_preserved_goal8
