% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strreplace_Why3_ide_VCstrreplace_loop_inv_preserved_goal4:
% preservation of a strreplace loop invariant stating that, after a conditional
% byte replacement, the updated memory is a valid string at the next address.
% This file contains no proof.

strreplace_Why3_ide_VCstrreplace_loop_inv_preserved_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(
      p: addr,
      p_size: int,
      q: addr,
      q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size)
      THEN outside(q)
      ELSE original(q)
      ENDIF

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  address_order_laws(
      addr_le, addr_lt: address_relation): bool =
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q)))
      AND
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_lt(p, q) IFF offset(p) < offset(q)))

  uint64_conversion_laws(to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le, addr_lt: address_relation),
      (to_uint64: integer_conversion),
      (l_strlen: string_length_function),
      (t_2: integer_memory),
      (a_1: addr),
      (t_1: integer_memory),
      (a: addr),
      (t: allocation_table),
      (i, i_1: int),
      (t_3: integer_memory):
      address_order_laws(addr_le, addr_lt) IMPLIES
      uint64_conversion_laws(to_uint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      LET x: int = l_strlen(t_2, a_1),
          a_2: addr = shift(a_1, x),
          a_3: integer_memory =
            havoc(t_1, t_2, shift(a_1, 0), x),
          a_4: int = a_3(a)
      IN
        t_2(a_2) = 0 IMPLIES
        a_4 /= 0 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_2) IMPLIES
        is_sint8(i) IMPLIES
        is_sint8(i_1) IMPLIES
        addr_le(a_1, a) IMPLIES
        p_valid_str(t, t_2, a_1) IMPLIES
        is_uint64(x) IMPLIES
        addr_le(a, a_2) IMPLIES
        is_sint8(a_4) IMPLIES
        p_valid_str(t, a_3, a) IMPLIES
        p_valid_str(t, a_3, a_1) IMPLIES
        (IF a_4 = i
         THEN a_3 WITH [(a) := i_1] = t_3
         ELSE a_3 = t_3
         ENDIF) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < x IMPLIES
          t_2(shift(a_1, i_2)) /= 0) IMPLIES
        (FORALL (a_5: addr):
          addr_le(a, a_5) IMPLIES
          addr_lt(a_5, a_2) IMPLIES
          a_3(a_5) = t_2(a_5)) IMPLIES
        (FORALL (a_5: addr):
          t_2(a_5) = i IMPLIES
          addr_lt(a_5, a) IMPLIES
          addr_le(a_1, a_5) IMPLIES
          a_3(a_5) = i_1) IMPLIES
        (FORALL (a_5: addr):
          LET x_1: int = t_2(a_5)
          IN
            x_1 /= i IMPLIES
            addr_lt(a_5, a) IMPLIES
            addr_le(a_1, a_5) IMPLIES
            a_3(a_5) = x_1) IMPLIES
        p_valid_str(t, t_3, shift(a, 1))
END strreplace_Why3_ide_VCstrreplace_loop_inv_preserved_goal4
