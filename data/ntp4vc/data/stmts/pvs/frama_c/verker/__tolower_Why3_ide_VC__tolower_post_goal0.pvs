% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/__tolower_Why3_ide_VC__tolower_post_goal0:
% the C tolower postcondition relating an unsigned byte, its signed-byte
% uppercase test, and the unchanged or case-shifted output. This file contains no proof.

tolower_Why3_ide_VC_tolower_post_goal0: THEORY
BEGIN
  integer_conversion: TYPE = [int -> int]

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  p_isupper(c: int): bool =
    65 <= c AND c <= 90

  byte_conversion_axioms(
      to_sint8, to_uint8: integer_conversion): bool =
    (FORALL (value: int):
      is_sint8(to_sint8(value)))
      AND
    (FORALL (value: int):
      is_sint8(value) IMPLIES to_sint8(value) = value)
      AND
    (FORALL (value: int):
      is_uint8(to_uint8(value)))
      AND
    (FORALL (value: int):
      is_uint8(value) IMPLIES to_uint8(value) = value)
      AND
    (FORALL (value: int):
      to_sint8(to_sint8(value)) = to_sint8(value))
      AND
    (FORALL (value: int):
      to_uint8(to_uint8(value)) = to_uint8(value))
      AND
    (FORALL (value: int):
      to_sint8(to_uint8(value)) = to_sint8(value))

  tolower_axioms(l_tolower: integer_conversion): bool =
    l_tolower(65) = 97
      AND l_tolower(66) = 98
      AND l_tolower(67) = 99
      AND l_tolower(68) = 100
      AND l_tolower(69) = 101
      AND l_tolower(70) = 102
      AND l_tolower(71) = 103
      AND l_tolower(72) = 104
      AND l_tolower(73) = 105
      AND l_tolower(74) = 106
      AND l_tolower(75) = 107
      AND l_tolower(76) = 108
      AND l_tolower(77) = 109
      AND l_tolower(78) = 110
      AND l_tolower(79) = 111
      AND l_tolower(80) = 112
      AND l_tolower(81) = 113
      AND l_tolower(82) = 114
      AND l_tolower(83) = 115
      AND l_tolower(84) = 116
      AND l_tolower(85) = 117
      AND l_tolower(86) = 118
      AND l_tolower(87) = 119
      AND l_tolower(88) = 120
      AND l_tolower(89) = 121
      AND l_tolower(90) = 122
      AND
    (FORALL (c: int):
      NOT p_isupper(c) IMPLIES l_tolower(c) = c)

  goal0: bool =
    FORALL
      (to_sint8, to_uint8, l_tolower: integer_conversion),
      (i_1, i, i_2: int):
      byte_conversion_axioms(to_sint8, to_uint8) IMPLIES
      tolower_axioms(l_tolower) IMPLIES
      (p_isupper(to_sint8(i_1)) IFF NOT (i = 0)) IMPLIES
      is_uint8(i) IMPLIES
      is_uint8(i_1) IMPLIES
      is_uint8(i_2) IMPLIES
      (IF i = 0 THEN
         i_2 = i_1
       ELSE
         to_uint8(32 + i_1) = i_2
       ENDIF) IMPLIES
      l_tolower(i_1) = i_2
END tolower_Why3_ide_VC_tolower_post_goal0
