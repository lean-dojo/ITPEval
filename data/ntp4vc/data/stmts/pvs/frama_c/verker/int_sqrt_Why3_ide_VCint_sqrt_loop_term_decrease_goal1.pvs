% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/int_sqrt_Why3_ide_VCint_sqrt_loop_term_decrease_goal1:
% the integer-square-root loop variant strictly decreases when a nonzero
% unsigned 64-bit value is logically shifted right by two bits.
% This file contains no proof.

int_sqrt_Why3_ide_VCint_sqrt_loop_term_decrease_goal1: THEORY
BEGIN
  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  logical_right_shift_two(value: int): int =
    floor((value :: real) / 4)

  goal1: bool =
    FORALL (i_1, i: int):
      LET x: int = logical_right_shift_two(i_1)
      IN
        i_1 /= 0 IMPLIES
        2 <= i IMPLIES
        is_uint64(i) IMPLIES
        is_uint64(i_1) IMPLIES
        is_uint64(x) IMPLIES
        x < i_1
END int_sqrt_Why3_ide_VCint_sqrt_loop_term_decrease_goal1
