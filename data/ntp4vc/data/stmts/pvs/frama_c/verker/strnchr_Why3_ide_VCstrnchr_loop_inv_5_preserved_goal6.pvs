% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strnchr_Why3_ide_VCstrnchr_loop_inv_5_preserved_goal6:
% preservation of the strnchr loop's offset-and-bounded-length equality after
% advancing the current address by one byte. This file contains no proof.

strnchr_Why3_ide_VCstrnchr_loop_inv_5_preserved_goal6: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  bounded_string_length_function: TYPE =
    [integer_memory, addr, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  p_valid_strn(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr,
      count: int): bool =
    LET start: addr = shift(s, 0)
    IN
      valid_rw(malloc_0, start, 1 + count)
        OR
          ((EXISTS (terminator: int):
            mchar_0(shift(s, terminator)) = 0
              AND terminator < count
              AND is_uint64(terminator)
              AND valid_rw(
                malloc_0, start, 1 + terminator))
            AND (FORALL (j: int):
              j <= count IMPLIES
                is_sint8(mchar_0(shift(s, j)))))

  address_order_laws(
      addr_le, addr_lt: address_relation): bool =
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q)))
      AND
    (FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_lt(p, q) IFF offset(p) < offset(q)))

  conversion_laws(
      to_sint8, to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_sint8(to_sint8(value)))
      AND
    (FORALL (value: int):
      is_sint8(value) IMPLIES to_sint8(value) = value)
      AND
    (FORALL (value: int):
      to_sint8(to_sint8(value)) = to_sint8(value))
      AND
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  strnlen_laws(
      to_uint64: integer_conversion,
      l_strnlen: bounded_string_length_function): bool =
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      IF count = 0 OR mchar_0(shift(s, 0)) = 0
      THEN l_strnlen(mchar_0, s, count) = 0
      ELSE
        to_uint64(
          1 + l_strnlen(
            mchar_0,
            shift(s, 1),
            to_uint64(count - 1))) =
          l_strnlen(mchar_0, s, count)
      ENDIF)
      AND
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      is_uint64(l_strnlen(mchar_0, s, count)))

  goal6: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le, addr_lt: address_relation),
      (to_sint8, to_uint64: integer_conversion),
      (l_strnlen: bounded_string_length_function),
      (t_1: integer_memory),
      (a: addr),
      (i_1: int),
      (a_1: addr),
      (i: int),
      (t: allocation_table):
      address_order_laws(addr_le, addr_lt) IMPLIES
      conversion_laws(to_sint8, to_uint64) IMPLIES
      strnlen_laws(to_uint64, l_strnlen) IMPLIES
      LET x: int = t_1(a),
          x_1: int = to_sint8(i_1),
          x_2: int = offset(a_1),
          x_3: int = offset(a),
          x_4: int = i + x_3 - x_2,
          x_5: int = l_strnlen(t_1, a_1, x_4),
          x_6: int = x_2 + x_5
      IN
        i /= 0 IMPLIES
        x /= 0 IMPLIES
        x /= x_1 IMPLIES
        x_6 = x_3 + l_strnlen(t_1, a, i) IMPLIES
        0 <= i IMPLIES
        x_2 <= x_3 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_sint32(i_1) IMPLIES
        is_uint64(i) IMPLIES
        addr_le(a_1, a) IMPLIES
        is_sint8(x) IMPLIES
        p_valid_strn(t, t_1, a, i) IMPLIES
        is_uint64(x_4) IMPLIES
        p_valid_strn(t, t_1, a_1, x_4) IMPLIES
        addr_le(a, shift(a_1, x_5)) IMPLIES
        (FORALL (a_2: addr):
          addr_lt(a_2, a) IMPLIES
          addr_le(a_1, a_2) IMPLIES
          t_1(a_2) /= x_1) IMPLIES
        x_6 =
          1 + x_3
            + l_strnlen(
              t_1,
              shift(a, 1),
              to_uint64(i - 1))
END strnchr_Why3_ide_VCstrnchr_loop_inv_5_preserved_goal6
