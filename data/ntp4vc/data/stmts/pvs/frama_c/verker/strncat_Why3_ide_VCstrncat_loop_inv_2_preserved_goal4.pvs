% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strncat_Why3_ide_VCstrncat_loop_inv_2_preserved_goal4:
% preservation of the strncat valid-string loop invariant after advancing the
% destination address by one byte. This file contains no proof.

strncat_Why3_ide_VCstrncat_loop_inv_2_preserved_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]
  bounded_string_length_function: TYPE =
    [integer_memory, addr, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  p_valid_strn(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr,
      count: int): bool =
    LET start: addr = shift(s, 0)
    IN
      valid_rw(malloc_0, start, 1 + count)
        OR
          ((EXISTS (terminator: int):
            mchar_0(shift(s, terminator)) = 0
              AND terminator < count
              AND is_uint64(terminator)
              AND valid_rw(
                malloc_0, start, 1 + terminator))
            AND (FORALL (j: int):
              j <= count IMPLIES
                is_sint8(mchar_0(shift(s, j)))))

  address_order_law(addr_le: address_relation): bool =
    FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q))

  uint64_conversion_laws(to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  strnlen_laws(
      to_uint64: integer_conversion,
      l_strnlen: bounded_string_length_function): bool =
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      IF count = 0 OR mchar_0(shift(s, 0)) = 0
      THEN l_strnlen(mchar_0, s, count) = 0
      ELSE
        to_uint64(
          1 + l_strnlen(
            mchar_0,
            shift(s, 1),
            to_uint64(count - 1))) =
          l_strnlen(mchar_0, s, count)
      ENDIF)
      AND
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      is_uint64(l_strnlen(mchar_0, s, count)))

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le: address_relation),
      (to_uint64: integer_conversion),
      (l_strlen: string_length_function),
      (l_strnlen: bounded_string_length_function),
      (t_1: integer_memory),
      (a_2, a, a_1: addr),
      (i: int),
      (t: allocation_table):
      address_order_law(addr_le) IMPLIES
      uint64_conversion_laws(to_uint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      strnlen_laws(to_uint64, l_strnlen) IMPLIES
      LET x: int = t_1(a_2),
          x_1: int = l_strlen(t_1, a),
          a_3: addr = shift(a, x_1),
          x_2: int = l_strnlen(t_1, a_1, i),
          x_3: int = t_1(shift(a_1, x_2))
      IN
        i /= 0 IMPLIES
        x /= 0 IMPLIES
        t_1(a_3) = 0 IMPLIES
        region(base(a)) <= 0 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        i + x_1 <= 18446744073709551615 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_uint64(i) IMPLIES
        addr_le(a, a_2) IMPLIES
        is_sint8(x) IMPLIES
        p_valid_str(t, t_1, a) IMPLIES
        p_valid_str(t, t_1, a_2) IMPLIES
        is_uint64(x_1) IMPLIES
        p_valid_strn(t, t_1, a_1, i) IMPLIES
        is_uint64(x_2) IMPLIES
        addr_le(a_2, a_3) IMPLIES
        is_sint8(x_3) IMPLIES
        valid_rw(t, shift(a, 0), 1 + i + x_1) IMPLIES
        ((FORALL (i_1: int):
          0 <= i_1 IMPLIES
          i_1 <= i IMPLIES
          t_1(shift(a_1, i_1)) /= 0)
          IMPLIES x_2 = i) IMPLIES
        ((EXISTS (i_1: int):
          t_1(shift(a_1, i_1)) = 0
            AND 0 <= i_1
            AND i_1 <= i)
          IMPLIES x_3 = 0) IMPLIES
        ((EXISTS (i_1: int):
          t_1(shift(a_1, i_1)) = 0
            AND 0 <= i_1
            AND i_1 <= i)
          IMPLIES
            (FORALL (i_1: int):
              0 <= i_1 IMPLIES
              i_1 < x_2 IMPLIES
              t_1(shift(a_1, i_1)) /= 0)) IMPLIES
        (FORALL (i_1: int):
          0 <= i_1 IMPLIES
          i_1 < x_1 IMPLIES
          t_1(shift(a, i_1)) /= 0) IMPLIES
        p_valid_str(t, t_1, shift(a_2, 1))
END strncat_Why3_ide_VCstrncat_loop_inv_2_preserved_goal4
