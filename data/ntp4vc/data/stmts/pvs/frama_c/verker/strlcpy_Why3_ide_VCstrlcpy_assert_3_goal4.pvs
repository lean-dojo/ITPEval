% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strlcpy_Why3_ide_VCstrlcpy_assert_3_goal4:
% a strlcpy verification condition concluding that the null-terminated updated
% destination memory has string length equal to the copied-prefix length.
% This file contains no proof.

strlcpy_Why3_ide_VCstrlcpy_assert_3_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  string_length_function: TYPE = [integer_memory, addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(
      p: addr,
      p_size: int,
      q: addr,
      q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size)
      THEN outside(q)
      ELSE original(q)
      ENDIF

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  valid_rd(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 /= base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  uint64_conversion_laws(to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (to_uint64: integer_conversion),
      (l_strlen: string_length_function),
      (a_1, a: addr),
      (t_2, t_1: integer_memory),
      (i_1, i: int),
      (t: allocation_table):
      uint64_conversion_laws(to_uint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      LET x: int = base(a_1),
          x_1: int = base(a),
          x_2: int = l_strlen(t_2, a),
          a_2: addr = shift(a_1, 0),
          a_3: integer_memory = havoc(t_1, t_2, a_2, i_1),
          a_4: integer_memory =
            a_3 WITH [(shift(a_1, i_1)) := 0]
      IN
        i /= 0 IMPLIES
        x /= x_1 IMPLIES
        t_2(shift(a, x_2)) = 0 IMPLIES
        region(x_1) <= 0 IMPLIES
        region(x) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_2) IMPLIES
        is_uint64(i) IMPLIES
        is_uint64(i_1) IMPLIES
        p_valid_str(t, t_2, a) IMPLIES
        is_uint64(x_2) IMPLIES
        valid_rd(t, shift(a, 0), i_1) IMPLIES
        valid_rw(t, a_2, i) IMPLIES
        valid_rw(t, a_2, i_1) IMPLIES
        p_valid_str(t, a_4, a_1) IMPLIES
        (IF i <= x_2
         THEN to_uint64(i - 1) = i_1
         ELSE x_2 = i_1
         ENDIF) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < x_2 IMPLIES
          t_2(shift(a, i_2)) /= 0) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < i_1 IMPLIES
          a_3(shift(a_1, i_2)) = a_3(shift(a, i_2))) IMPLIES
        l_strlen(a_4, a_1) = i_1
END strlcpy_Why3_ide_VCstrlcpy_assert_3_goal4
