% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strncmp_Why3_ide_VCstrncmp_loop_inv_3_preserved_goal8:
% preservation of the strncmp loop address-order invariant after advancing
% the first string address. This file contains no proof.

strncmp_Why3_ide_VCstrncmp_loop_inv_3_preserved_goal8: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  bounded_string_length_function: TYPE =
    [integer_memory, addr, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  is_sint64(value: int): bool =
    -9223372036854775808 <= value
      AND value < 9223372036854775808

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  p_valid_strn(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr,
      count: int): bool =
    LET start: addr = shift(s, 0)
    IN
      valid_rw(malloc_0, start, 1 + count)
        OR
          ((EXISTS (terminator: int):
            mchar_0(shift(s, terminator)) = 0
              AND terminator < count
              AND is_uint64(terminator)
              AND valid_rw(
                malloc_0, start, 1 + terminator))
            AND (FORALL (j: int):
              j <= count IMPLIES
                is_sint8(mchar_0(shift(s, j)))))

  address_order_law(addr_le: address_relation): bool =
    FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q))

  uint8_conversion_laws(to_uint8: integer_conversion): bool =
    (FORALL (value: int):
      is_uint8(to_uint8(value)))
      AND
    (FORALL (value: int):
      is_uint8(value) IMPLIES to_uint8(value) = value)
      AND
    (FORALL (value: int):
      to_uint8(to_uint8(value)) = to_uint8(value))

  uint64_conversion_laws(to_uint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))

  sint8_conversion_laws(to_sint8: integer_conversion): bool =
    (FORALL (value: int):
      is_sint8(to_sint8(value)))
      AND
    (FORALL (value: int):
      is_sint8(value) IMPLIES to_sint8(value) = value)
      AND
    (FORALL (value: int):
      to_sint8(to_sint8(value)) = to_sint8(value))

  sint64_conversion_laws(to_sint64: integer_conversion): bool =
    (FORALL (value: int):
      is_sint64(to_sint64(value)))
      AND
    (FORALL (value: int):
      is_sint64(value) IMPLIES to_sint64(value) = value)
      AND
    (FORALL (value: int):
      to_sint64(to_sint64(value)) = to_sint64(value))

  integer_conversion_laws(
      to_uint8, to_sint8, to_uint64, to_sint64:
        integer_conversion): bool =
    uint8_conversion_laws(to_uint8)
      AND sint8_conversion_laws(to_sint8)
      AND uint64_conversion_laws(to_uint64)
      AND sint64_conversion_laws(to_sint64)
      AND (FORALL (value: int):
        to_sint8(to_uint8(value)) = to_sint8(value))
      AND (FORALL (value: int):
        to_sint64(to_uint64(value)) = to_sint64(value))

  strnlen_laws(
      to_uint64: integer_conversion,
      l_strnlen: bounded_string_length_function): bool =
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      IF count = 0 OR mchar_0(shift(s, 0)) = 0
      THEN l_strnlen(mchar_0, s, count) = 0
      ELSE
        to_uint64(
          1 + l_strnlen(
            mchar_0,
            shift(s, 1),
            to_uint64(count - 1))) =
          l_strnlen(mchar_0, s, count)
      ENDIF)
      AND
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      is_uint64(l_strnlen(mchar_0, s, count)))

  goal8: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le: address_relation),
      (to_uint8, to_sint8, to_uint64, to_sint64:
        integer_conversion),
      (l_strnlen: bounded_string_length_function),
      (t_1: integer_memory),
      (a_1, a_3, a_2, a: addr),
      (i: int),
      (t: allocation_table):
      address_order_law(addr_le) IMPLIES
      integer_conversion_laws(
        to_uint8, to_sint8, to_uint64, to_sint64) IMPLIES
      strnlen_laws(to_uint64, l_strnlen) IMPLIES
      LET x: int = t_1(a_1),
          x_1: int = to_uint8(x),
          x_2: int = t_1(a_3),
          x_3: int = offset(a_1),
          x_4: int = offset(a_2),
          x_5: int = offset(a),
          x_6: int = offset(a_3),
          x_7: int = x_6 - x_4,
          x_8: int = t_1(shift(a_2, x_7)),
          x_9: int = t_1(shift(a, x_7)),
          x_10: int = i + x_3 - x_5,
          x_11: int = l_strnlen(t_1, a, x_10),
          x_12: int = l_strnlen(t_1, a_2, x_10),
          a_4: addr = shift(a, x_11),
          a_5: addr = shift(a_1, 1)
      IN
        NOT (i = 0) IMPLIES
        NOT (x_1 = 0) IMPLIES
        to_uint8(x_2) = x_1 IMPLIES
        x_3 + x_4 = x_5 + x_6 IMPLIES
        x_8 = x_9 IMPLIES
        x_5 + x_11 =
          x_3 + l_strnlen(t_1, a_1, i) IMPLIES
        x_4 + x_12 =
          x_6 + l_strnlen(t_1, a_3, i) IMPLIES
        0 <= i IMPLIES
        x_5 <= x_3 IMPLIES
        region(base(a)) <= 0 IMPLIES
        region(base(a_2)) <= 0 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_uint64(i) IMPLIES
        addr_le(a, a_1) IMPLIES
        addr_le(a_2, a_3) IMPLIES
        is_sint8(x) IMPLIES
        is_sint8(x_2) IMPLIES
        p_valid_strn(t, t_1, a_1, i) IMPLIES
        p_valid_strn(t, t_1, a_3, i) IMPLIES
        is_uint64(x_10) IMPLIES
        is_sint8(x_9) IMPLIES
        is_sint8(x_8) IMPLIES
        p_valid_strn(t, t_1, a, x_10) IMPLIES
        p_valid_strn(t, t_1, a_2, x_10) IMPLIES
        addr_le(a_1, a_4) IMPLIES
        addr_le(a_3, shift(a_2, x_12)) IMPLIES
        (FORALL (i_1: int):
          0 <= i_1 IMPLIES
          i_1 + x_5 < x_3 IMPLIES
          t_1(shift(a_2, i_1)) = t_1(shift(a, i_1))) IMPLIES
        (FORALL (i_1: int):
          LET x_13: int = t_1(shift(a_2, i_1)),
              x_14: int = t_1(shift(a, i_1))
          IN
            0 <= i_1 IMPLIES
            i_1 < x_12 IMPLIES
            (to_uint8(x_13) = to_uint8(x_14) IFF
              x_13 = x_14)) IMPLIES
        addr_le(a, a_5) AND addr_le(a_5, a_4)
END strncmp_Why3_ide_VCstrncmp_loop_inv_3_preserved_goal8
