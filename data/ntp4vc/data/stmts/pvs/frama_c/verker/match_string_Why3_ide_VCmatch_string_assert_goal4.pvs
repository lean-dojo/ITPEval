% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/match_string_Why3_ide_VCmatch_string_assert_goal4:
% a match_string verification condition propagating string validity to the
% selected non-null pointer at the current bounded index. This file contains no proof.

match_string_Why3_ide_VCmatch_string_assert_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  string_length_function: TYPE = [integer_memory, addr -> int]
  bounded_string_compare: TYPE =
    [integer_memory, addr, addr, int -> int]
  real_length_function: TYPE =
    [pointer_memory, addr, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(region: [int -> int], mptr: pointer_memory): bool =
    FORALL (p: addr): region(base(mptr(p))) <= 0

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  is_sint64(value: int): bool =
    -9223372036854775808 <= value AND value < 9223372036854775808

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  p_valid_str(
      malloc: allocation_table,
      mchar: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES is_sint8(mchar(shift(s, j))))

  l_cmp(a, b: int): int =
    IF b = a THEN 0 ELSE IF a < b THEN -1 ELSE 1 ENDIF ENDIF

  l_strcmp(
      l_strncmp_1: bounded_string_compare,
      l_strlen: string_length_function,
      mchar: integer_memory,
      cs, ct: addr): int =
    l_strncmp_1(mchar, cs, ct, l_strlen(mchar, cs))

  conversion_axioms(
      to_uint8, to_sint8, to_uint64, to_sint64: integer_conversion): bool =
    (FORALL (value: int): is_uint8(to_uint8(value)))
      AND
    (FORALL (value: int):
      is_uint8(value) IMPLIES to_uint8(value) = value)
      AND
    (FORALL (value: int): is_sint8(to_sint8(value)))
      AND
    (FORALL (value: int):
      is_sint8(value) IMPLIES to_sint8(value) = value)
      AND
    (FORALL (value: int): is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int): is_sint64(to_sint64(value)))
      AND
    (FORALL (value: int):
      is_sint64(value) IMPLIES to_sint64(value) = value)
      AND
    (FORALL (value: int):
      to_sint8(to_uint8(value)) = to_sint8(value))
      AND
    (FORALL (value: int):
      to_sint64(to_uint64(value)) = to_sint64(value))

  strlen_axioms(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar: integer_memory), (s: addr):
      IF mchar(shift(s, 0)) = 0
      THEN l_strlen(mchar, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar, shift(s, 1))) =
          l_strlen(mchar, s)
      ENDIF)
      AND
    (FORALL (mchar: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar, s)))

  strncmp_axiom(
      to_uint8: integer_conversion,
      l_strncmp_1: bounded_string_compare): bool =
    FORALL
      (mchar: integer_memory),
      (cs, ct: addr),
      (n: int):
      IF n = -1
      THEN l_strncmp_1(mchar, cs, ct, n) = 0
      ELSIF mchar(shift(ct, 0)) = mchar(shift(cs, 0))
      THEN
        l_strncmp_1(mchar, shift(cs, 1), shift(ct, 1), n - 1) =
          l_strncmp_1(mchar, cs, ct, n)
      ELSE
        l_cmp(
          to_uint8(mchar(shift(cs, 0))),
          to_uint8(mchar(shift(ct, 0)))) =
            l_strncmp_1(mchar, cs, ct, n)
      ENDIF

  real_length_axioms(
      to_uint64: integer_conversion,
      l_real_len: real_length_function): bool =
    (FORALL
      (mptr: pointer_memory),
      (a: addr),
      (n: int):
      IF n = 0 OR mptr(shift(a, 0)) = (# base := 0, offset := 0 #)
      THEN l_real_len(mptr, a, n) = 0
      ELSE
        to_uint64(
          1 + l_real_len(mptr, shift(a, 1), to_uint64(n - 1))) =
            l_real_len(mptr, a, n)
      ENDIF)
      AND
    (FORALL
      (mptr: pointer_memory),
      (a: addr),
      (n: int):
      is_uint64(l_real_len(mptr, a, n)))

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (to_uint8, to_sint8, to_uint64, to_sint64: integer_conversion),
      (l_strlen: string_length_function),
      (l_strncmp_1: bounded_string_compare),
      (l_real_len: real_length_function),
      (t_2: pointer_memory),
      (a_1: addr),
      (i_1: int),
      (i: int),
      (a: addr),
      (t: allocation_table),
      (t_1: integer_memory):
      conversion_axioms(
        to_uint8, to_sint8, to_uint64, to_sint64) IMPLIES
      strlen_axioms(to_uint64, l_strlen) IMPLIES
      strncmp_axiom(to_uint8, l_strncmp_1) IMPLIES
      real_length_axioms(to_uint64, l_real_len) IMPLIES
      LET a_2: addr = t_2(shift(a_1, i_1)),
          x: int = l_real_len(t_2, a_1, i),
          a_3: addr = shift(a_1, 0)
      IN
        a_2 /= (# base := 0, offset := 0 #) IMPLIES
        0 <= i_1 IMPLIES
        to_uint64(i_1) < i IMPLIES
        region(base(a)) <= 0 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        x <= i IMPLIES
        i_1 <= x IMPLIES
        i <= 2147483647 IMPLIES
        framed(region, t_2) IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_sint32(i_1) IMPLIES
        is_uint64(i) IMPLIES
        p_valid_str(t, t_1, a) IMPLIES
        (x = i IMPLIES valid_rw(t, a_3, i)) IMPLIES
        (x < i IMPLIES valid_rw(t, a_3, 1 + x)) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < i_1 IMPLIES
          p_valid_str(t, t_1, t_2(shift(a_1, i_2)))) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < i_1 IMPLIES
          l_strcmp(
            l_strncmp_1,
            l_strlen,
            t_1,
            t_2(shift(a_1, i_2)),
            a) /= 0) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < x IMPLIES
          is_uint64(i_2) IMPLIES
          p_valid_str(t, t_1, t_2(shift(a_1, i_2)))) IMPLIES
        p_valid_str(t, t_1, a_2)
END match_string_Why3_ide_VCmatch_string_assert_goal4
