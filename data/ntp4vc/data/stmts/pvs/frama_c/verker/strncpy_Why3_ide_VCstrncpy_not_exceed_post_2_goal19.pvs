% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/verker/strncpy_Why3_ide_VCstrncpy_not_exceed_post_2_goal19:
% a strncpy verification condition concluding bounded string validity at the
% destination start under memory, address-order, length, and copied-prefix
% assumptions. This file contains no proof.

strncpy_Why3_ide_VCstrncpy_not_exceed_post_2_goal19: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  allocation_table: TYPE = [int -> int]
  integer_memory: TYPE = [addr -> int]
  integer_conversion: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  string_length_function: TYPE = [integer_memory, addr -> int]
  bounded_string_length_function: TYPE =
    [integer_memory, addr, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(
      p: addr,
      p_size: int,
      q: addr,
      q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size)
      THEN outside(q)
      ELSE original(q)
      ENDIF

  valid_rw(
      malloc_0: allocation_table,
      p: addr,
      size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc_0(base(p))

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_sint64(value: int): bool =
    -9223372036854775808 <= value AND value < 9223372036854775808

  is_uint64(value: int): bool =
    0 <= value AND value < 18446744073709551616

  p_valid_str(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr): bool =
    EXISTS (terminator: int):
      mchar_0(shift(s, terminator)) = 0
        AND is_uint64(terminator)
        AND valid_rw(malloc_0, shift(s, 0), 1 + terminator)
        AND (FORALL (j: int):
          j <= terminator IMPLIES
            is_sint8(mchar_0(shift(s, j))))

  p_valid_strn(
      malloc_0: allocation_table,
      mchar_0: integer_memory,
      s: addr,
      count: int): bool =
    LET start: addr = shift(s, 0)
    IN
      valid_rw(malloc_0, start, 1 + count)
        OR
          ((EXISTS (terminator: int):
            mchar_0(shift(s, terminator)) = 0
              AND terminator < count
              AND is_uint64(terminator)
              AND valid_rw(
                malloc_0, start, 1 + terminator))
            AND (FORALL (j: int):
              j <= count IMPLIES
                is_sint8(mchar_0(shift(s, j)))))

  address_order_law(addr_le: address_relation): bool =
    FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q))

  int64_conversion_laws(
      to_uint64, to_sint64: integer_conversion): bool =
    (FORALL (value: int):
      is_uint64(to_uint64(value)))
      AND
    (FORALL (value: int):
      is_uint64(value) IMPLIES to_uint64(value) = value)
      AND
    (FORALL (value: int):
      to_uint64(to_uint64(value)) = to_uint64(value))
      AND
    (FORALL (value: int):
      is_sint64(to_sint64(value)))
      AND
    (FORALL (value: int):
      is_sint64(value) IMPLIES to_sint64(value) = value)
      AND
    (FORALL (value: int):
      to_sint64(to_sint64(value)) = to_sint64(value))
      AND
    (FORALL (value: int):
      to_sint64(to_uint64(value)) = to_sint64(value))

  strlen_laws(
      to_uint64: integer_conversion,
      l_strlen: string_length_function): bool =
    (FORALL (mchar_0: integer_memory), (s: addr):
      IF mchar_0(shift(s, 0)) = 0
      THEN l_strlen(mchar_0, s) = 0
      ELSE
        to_uint64(1 + l_strlen(mchar_0, shift(s, 1))) =
          l_strlen(mchar_0, s)
      ENDIF)
      AND
    (FORALL (mchar_0: integer_memory), (s: addr):
      is_uint64(l_strlen(mchar_0, s)))

  strnlen_laws(
      to_uint64: integer_conversion,
      l_strnlen: bounded_string_length_function): bool =
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      IF count = 0 OR mchar_0(shift(s, 0)) = 0
      THEN l_strnlen(mchar_0, s, count) = 0
      ELSE
        to_uint64(
          1 + l_strnlen(
            mchar_0,
            shift(s, 1),
            to_uint64(count - 1))) =
          l_strnlen(mchar_0, s, count)
      ENDIF)
      AND
    (FORALL
        (mchar_0: integer_memory),
        (s: addr),
        (count: int):
      is_uint64(l_strnlen(mchar_0, s, count)))

  goal19: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le: address_relation),
      (to_uint64, to_sint64: integer_conversion),
      (l_strlen: string_length_function),
      (l_strnlen: bounded_string_length_function),
      (a_3, a_1, a: addr),
      (t_1, t_2, t_3: integer_memory),
      (t: allocation_table),
      (a_2: addr):
      address_order_law(addr_le) IMPLIES
      int64_conversion_laws(to_uint64, to_sint64) IMPLIES
      strlen_laws(to_uint64, l_strlen) IMPLIES
      strnlen_laws(to_uint64, l_strnlen) IMPLIES
      LET x: int = base(a_3),
          x_1: int = base(a_1),
          a_4: addr = shift(a_1, 0),
          x_2: int = offset(a_1),
          x_3: int = offset(a),
          x_4: int = x_3 - x_2
      IN
        x /= x_1 IMPLIES
        havoc(t_1, t_2, a_4, 1 + l_strnlen(t_3, a_3, 0)) = t_3
          IMPLIES
        x_2 <= x_3 IMPLIES
        region(x_1) <= 0 IMPLIES
        region(x) <= 0 IMPLIES
        x_3 < x_2 + l_strlen(t_2, a_3) IMPLIES
        linked(t) IMPLIES
        sconst(t_2) IMPLIES
        addr_le(a_1, a) IMPLIES
        addr_le(a_3, a_2) IMPLIES
        p_valid_str(t, t_2, a_3) IMPLIES
        p_valid_str(t, t_3, a_2) IMPLIES
        is_uint64(x_4) IMPLIES
        p_valid_strn(t, t_2, a_3, x_4) IMPLIES
        p_valid_strn(t, t_3, a, x_4) IMPLIES
        addr_le(a, shift(a_1, x_4)) IMPLIES
        addr_le(
          a_2,
          shift(a_3, l_strnlen(t_3, a_3, x_4))) IMPLIES
        valid_rw(
          t,
          a_4,
          1 + l_strnlen(t_2, a_3, x_4)) IMPLIES
        (FORALL (i: int):
          0 <= i IMPLIES
          i + offset(a_3) < offset(a_2) IMPLIES
          t_3(shift(a_3, i)) = t_3(shift(a_1, i))) IMPLIES
        p_valid_strn(t, t_3, a_1, x_4)
END strncpy_Why3_ide_VCstrncpy_not_exceed_post_2_goal19
