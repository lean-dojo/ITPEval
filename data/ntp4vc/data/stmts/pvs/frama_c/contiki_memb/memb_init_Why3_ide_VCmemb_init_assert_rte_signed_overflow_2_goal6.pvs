% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_memb/memb_init_Why3_ide_VCmemb_init_assert_rte_signed_overflow_2_goal6:
% a Contiki memb-initialization verification condition asserting that the
% product of two unsigned 16-bit descriptor fields does not exceed the signed
% 32-bit maximum under the source memory-model assumptions. This file contains
% no proof.

memb_init_Why3_ide_VCmemb_init_assert_rte_signed_overflow_2_goal6: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    n > 0 IMPLIES
      base(p) > 0 AND
      offset(p) >= 0 AND
      offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    n > 0 IMPLIES
      base(p) /= 0 AND
      offset(p) >= 0 AND
      offset(p) + n <= m(base(p))

  separated(p: addr, a: int, q: addr, b: int): bool =
    a <= 0 OR
    b <= 0 OR
    base(p) /= base(q) OR
    offset(q) + b <= offset(p) OR
    offset(p) + a <= offset(q)

  framed(
      region: [int -> int],
      m: pointer_memory): bool =
    FORALL (p: addr): region(base(m(p))) <= 0

  havoc(
      old_memory, outside_memory: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size) THEN
        outside_memory(q)
      ELSE
        old_memory(q)
      ENDIF

  is_uint16(x: int): bool =
    0 <= x AND x < 65536

  p_valid_memb(
      malloc_0: allocation_table,
      mptr_0: pointer_memory,
      mint_0: integer_memory,
      m: addr): bool =
    LET x: int = mint_0(shift(m, 0)) IN
    LET x_1: int = mint_0(shift(m, 1)) IN
    LET x_2: int = x_1 * x IN
    LET a: addr = mptr_0(shift(m, 2)) IN
    LET a_1: addr = mptr_0(shift(m, 3)) IN
    LET a_2: addr = shift(a, 0) IN
    LET a_3: addr = shift(a_1, 0) IN
      x > 0 AND
      x_2 <= 2147483647 AND
      valid_rw(malloc_0, m, 4) AND
      valid_rw(malloc_0, a, 1) AND
      valid_rw(malloc_0, a_1, 1) AND
      valid_rw(malloc_0, a_2, x_1) AND
      valid_rw(malloc_0, a_3, x_2) AND
      separated(a_2, x_1, a_3, x_2)

  p_empty_block(malloc_0: allocation_table, s: addr): bool =
    malloc_0(base(s)) = 0 AND offset(s) = 0

  p_valid_or_empty(
      malloc_0: allocation_table,
      s: addr,
      n: int): bool =
    valid_rw(malloc_0, shift(s, 0), n) AND
      (p_empty_block(malloc_0, s) OR valid_rd(malloc_0, s, 1))

  l_memset(
      memory: integer_memory,
      start: addr,
      value, size: int): bool =
    FORALL (i: int):
      0 <= i IMPLIES
      i < size IMPLIES
      memory(shift(start, i)) = value

  goal6: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (a: addr),
      (t_1: integer_memory),
      (t_4: pointer_memory),
      (t: allocation_table),
      (t_3, t_2: integer_memory):
      LET a_1: addr = shift(a, 1) IN
      LET x: int = t_1(a_1) IN
      LET x_1: int = t_1(shift(a, 0)) IN
      LET a_2: addr = shift(a, 2) IN
      LET a_3: addr = t_4(a_2) IN
        region(base(a)) <= 0 IMPLIES
        framed(region, t_4) IMPLIES
        linked(t) IMPLIES
        sconst(t_3) IMPLIES
        is_uint16(x) IMPLIES
        is_uint16(x_1) IMPLIES
        p_valid_memb(t, t_4, t_1, a) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        p_valid_or_empty(t, a_3, x) IMPLIES
        l_memset(
          havoc(t_2, t_3, shift(a_3, 0), x),
          a_3,
          0,
          x) = TRUE IMPLIES
        x * x_1 <= 2147483647
END memb_init_Why3_ide_VCmemb_init_assert_rte_signed_overflow_2_goal6
