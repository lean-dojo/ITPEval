% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_memb/memb_free_Why3_ide_VCmemb_free_assert_rte_mem_access_4_goal11:
% a Contiki memb-free verification condition asserting read validity for the
% memb status-array pointer field under the source memory-model assumptions.
% This file contains no proof.

memb_free_Why3_ide_VCmemb_free_assert_rte_mem_access_4_goal11: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    n > 0 IMPLIES
      base(p) > 0 AND
      offset(p) >= 0 AND
      offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    n > 0 IMPLIES
      base(p) /= 0 AND
      offset(p) >= 0 AND
      offset(p) + n <= m(base(p))

  separated(p: addr, a: int, q: addr, b: int): bool =
    a <= 0 OR
    b <= 0 OR
    base(p) /= base(q) OR
    offset(q) + b <= offset(p) OR
    offset(p) + a <= offset(q)

  framed(
      region: [int -> int],
      m: pointer_memory): bool =
    FORALL (p: addr): region(base(m(p))) <= 0

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  is_uint16(x: int): bool =
    0 <= x AND x < 65536

  p_valid_memb(
      malloc_0: allocation_table,
      mptr_0: pointer_memory,
      mint_0: integer_memory,
      m: addr): bool =
    LET x: int = mint_0(shift(m, 0)) IN
    LET x_1: int = mint_0(shift(m, 1)) IN
    LET x_2: int = x_1 * x IN
    LET a: addr = mptr_0(shift(m, 2)) IN
    LET a_1: addr = mptr_0(shift(m, 3)) IN
    LET a_2: addr = shift(a, 0) IN
    LET a_3: addr = shift(a_1, 0) IN
      x > 0 AND
      x_2 <= 2147483647 AND
      valid_rw(malloc_0, m, 4) AND
      valid_rw(malloc_0, a, 1) AND
      valid_rw(malloc_0, a_1, 1) AND
      valid_rw(malloc_0, a_2, x_1) AND
      valid_rw(malloc_0, a_3, x_2) AND
      separated(a_2, x_1, a_3, x_2)

  trunc_div(n, d: int): int =
    IF d = 0 THEN
      0
    ELSIF n * d >= 0 THEN
      floor((n :: real) / (d :: real))
    ELSE
      -floor(-((n :: real) / (d :: real)))
    ENDIF

  l__memb_index(
      mptr_0: pointer_memory,
      mint_0: integer_memory,
      m: addr,
      ptr_0: addr): int =
    trunc_div(
      offset(ptr_0) - offset(mptr_0(shift(m, 3))),
      mint_0(shift(m, 0)))

  l__memb_ptr(
      mptr_0: pointer_memory,
      mint_0: integer_memory,
      m: addr,
      index_0: int): addr =
    shift(
      mptr_0(shift(m, 3)),
      index_0 * mint_0(shift(m, 0)))

  goal11: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (t_3: pointer_memory),
      (t_1: integer_memory),
      (a_1, a: addr),
      (t: allocation_table),
      (t_2: integer_memory):
      LET x: int = l__memb_index(t_3, t_1, a_1, a) IN
      LET a_2: addr = shift(a_1, 1) IN
      LET x_1: int = t_1(a_2) IN
      LET a_3: addr = shift(a_1, 3) IN
        l__memb_ptr(t_3, t_1, a_1, x) = a IMPLIES
        region(base(a)) <= 0 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        0 <= x IMPLIES
        x < x_1 IMPLIES
        x <= x_1 IMPLIES
        framed(region, t_3) IMPLIES
        linked(t) IMPLIES
        sconst(t_2) IMPLIES
        is_uint16(x_1) IMPLIES
        p_valid_memb(t, t_3, t_1, a_1) IMPLIES
        valid_rd(t, a_3, 1) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        is_sint32(x) IMPLIES
        (FORALL (i: int):
          0 <= i IMPLIES
          i < x IMPLIES
          shift(
            t_3(a_3),
            i * t_1(shift(a_1, 0))) /= a) IMPLIES
        valid_rd(t, shift(a_1, 2), 1)
END memb_free_Why3_ide_VCmemb_free_assert_rte_mem_access_4_goal11
