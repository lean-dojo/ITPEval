% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_memb/memb_alloc_Why3_ide_VCmemb_alloc_loop_inv_2_preserved_goal4:
% a Contiki memb-allocation verification condition asserting preservation of
% the loop invariant that every previously inspected status slot is occupied.
% This file contains no proof.

memb_alloc_Why3_ide_VCmemb_alloc_loop_inv_2_preserved_goal4: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(m: allocation_table, p: addr, n: int): bool =
    n > 0 IMPLIES
      base(p) > 0 AND
      offset(p) >= 0 AND
      offset(p) + n <= m(base(p))

  valid_rd(m: allocation_table, p: addr, n: int): bool =
    n > 0 IMPLIES
      base(p) /= 0 AND
      offset(p) >= 0 AND
      offset(p) + n <= m(base(p))

  separated(p: addr, a: int, q: addr, b: int): bool =
    a <= 0 OR
    b <= 0 OR
    base(p) /= base(q) OR
    offset(q) + b <= offset(p) OR
    offset(p) + a <= offset(q)

  framed(
      region: [int -> int],
      m: pointer_memory): bool =
    FORALL (p: addr): region(base(m(p))) <= 0

  is_sint8(x: int): bool =
    -128 <= x AND x < 128

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  is_uint16(x: int): bool =
    0 <= x AND x < 65536

  p_valid_memb(
      malloc_0: allocation_table,
      mptr_0: pointer_memory,
      mint_0: integer_memory,
      m: addr): bool =
    LET x: int = mint_0(shift(m, 0)) IN
    LET x_1: int = mint_0(shift(m, 1)) IN
    LET x_2: int = x_1 * x IN
    LET a: addr = mptr_0(shift(m, 2)) IN
    LET a_1: addr = mptr_0(shift(m, 3)) IN
    LET a_2: addr = shift(a, 0) IN
    LET a_3: addr = shift(a_1, 0) IN
      x > 0 AND
      x_2 <= 2147483647 AND
      valid_rw(malloc_0, m, 4) AND
      valid_rw(malloc_0, a, 1) AND
      valid_rw(malloc_0, a_1, 1) AND
      valid_rw(malloc_0, a_2, x_1) AND
      valid_rw(malloc_0, a_3, x_2) AND
      separated(a_2, x_1, a_3, x_2)

  goal4: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (a: addr),
      (t_3: pointer_memory),
      (i: int),
      (t_2: integer_memory),
      (t_1: integer_memory),
      (i_1: int),
      (t: allocation_table):
      LET a_1: addr = shift(a, 2) IN
      LET a_2: addr = t_3(a_1) IN
      LET a_3: addr = shift(a_2, i) IN
      LET x: int = t_2(a_3) IN
      LET a_4: addr = shift(a, 1) IN
      LET x_1: int = t_1(a_4) IN
        x /= 0 IMPLIES
        0 <= i IMPLIES
        i_1 <= i IMPLIES
        0 <= i_1 IMPLIES
        i < x_1 IMPLIES
        i <= x_1 IMPLIES
        region(base(a)) <= 0 IMPLIES
        i <= 2147483646 IMPLIES
        framed(region, t_3) IMPLIES
        linked(t) IMPLIES
        sconst(t_2) IMPLIES
        is_sint32(i) IMPLIES
        is_sint32(i_1) IMPLIES
        is_uint16(x_1) IMPLIES
        is_sint32(1 + i) IMPLIES
        p_valid_memb(t, t_3, t_1, a) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        valid_rd(t, a_4, 1) IMPLIES
        is_sint8(x) IMPLIES
        valid_rd(t, a_3, 1) IMPLIES
        (FORALL (i_2: int):
          0 <= i_2 IMPLIES
          i_2 < i IMPLIES
          t_2(shift(a_2, i_2)) /= 0) IMPLIES
        t_2(shift(a_2, i_1)) /= 0
END memb_alloc_Why3_ide_VCmemb_alloc_loop_inv_2_preserved_goal4
