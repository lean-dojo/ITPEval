% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/contiki_memb/occ_a_split_Why3_ide_VCocc_a_split_loop_inv_2_preserved_goal1:
% a Contiki occurrence-count split verification condition preserving the loop
% invariant when the upper index advances by one. This file contains no proof.

occ_a_split_Why3_ide_VCocc_a_split_loop_inv_2_preserved_goal1: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  occurrence_counter: TYPE =
    [integer_memory, int, addr, int, int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  is_sint32(x: int): bool =
    -2147483648 <= x AND x < 2147483648

  occurrence_axioms(l_occ_a: occurrence_counter): bool =
    (FORALL
      (to_0, from_0: int),
      (mchar_0: integer_memory),
      (e: int),
      (start: addr):
        to_0 <= from_0 IMPLIES
        l_occ_a(mchar_0, e, start, from_0, to_0) = 0)
    AND
    (FORALL
      (to_0: int),
      (mchar_0: integer_memory),
      (start: addr),
      (e, from_0: int):
        mchar_0(shift(start, to_0 - 1)) = e IMPLIES
        from_0 < to_0 IMPLIES
        1 + l_occ_a(mchar_0, e, start, from_0, to_0 - 1) =
          l_occ_a(mchar_0, e, start, from_0, to_0))
    AND
    (FORALL
      (to_0: int),
      (mchar_0: integer_memory),
      (start: addr),
      (e, from_0: int):
        mchar_0(shift(start, to_0 - 1)) /= e IMPLIES
        from_0 < to_0 IMPLIES
        l_occ_a(mchar_0, e, start, from_0, to_0 - 1) =
          l_occ_a(mchar_0, e, start, from_0, to_0))

  goal1: bool =
    FORALL
      (l_occ_a: occurrence_counter),
      (region: [int -> int]),
      (sconst: [integer_memory -> bool]),
      (t: integer_memory),
      (i_3: int),
      (a: addr),
      (i_2, i_4, i_1, i: int):
      LET x: int = l_occ_a(t, i_3, a, i_2, i_4) IN
      LET x_1: int = 1 + i_1 IN
        occurrence_axioms(l_occ_a) IMPLIES
        x + l_occ_a(t, i_3, a, i_4, i_1) =
          l_occ_a(t, i_3, a, i_2, i_1) IMPLIES
        i_1 <= i IMPLIES
        i_4 <= i IMPLIES
        i_1 < i IMPLIES
        i_4 <= i_1 IMPLIES
        i_2 <= i_4 IMPLIES
        region(base(a)) <= 0 IMPLIES
        i_1 <= 2147483646 IMPLIES
        sconst(t) IMPLIES
        is_sint32(i) IMPLIES
        is_sint32(i_1) IMPLIES
        is_sint32(i_2) IMPLIES
        is_sint32(i_3) IMPLIES
        is_sint32(i_4) IMPLIES
        is_sint32(x_1) IMPLIES
        x + l_occ_a(t, i_3, a, i_4, x_1) =
          l_occ_a(t, i_3, a, i_2, x_1)
END occ_a_split_Why3_ide_VCocc_a_split_loop_inv_2_preserved_goal1
