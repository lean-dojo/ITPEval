% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/klibc_string/memmem_Why3_ide_VCmemmem_disjoint_occr_not_occur_err_part1_goal1:
% a disjoint-memory memmem verification condition classifying zero and
% length-order cases, with an offset-alignment condition. This file contains no proof.

memmem_Why3_ide_VCmemmem_disjoint_occr_not_occur_err_part1_goal1: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  goal1: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (a_2, a_3: addr),
      (i, i_1: int),
      (t: allocation_table),
      (t_1: integer_memory),
      (a_1, a: addr):
      LET a_4: addr = shift(a_2, 0),
          a_5: addr = shift(a_3, 0)
      IN
        0 <= i IMPLIES
        0 <= i_1 IMPLIES
        region(base(a_2)) <= 0 IMPLIES
        region(base(a_3)) <= 0 IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        valid_rw(t, a_4, i_1) IMPLIES
        valid_rw(t, a_5, i) IMPLIES
        separated(a_5, i, a_4, i_1) IMPLIES
        i = 0
          OR i_1 = 0
          OR i < i_1
          OR (i /= 0 AND i_1 /= 0 AND i_1 <= i)
          OR (EXISTS (i_2: int):
            0 <= i_2
              AND i_2 + i_1 <= i
              AND (FORALL (i_3: int):
                t_1(shift(a_1, i_3 + i_2)) = t_1(shift(a, i_3))
                  OR i_3 < 0
                  OR i_1 <= i_3))
END memmem_Why3_ide_VCmemmem_disjoint_occr_not_occur_err_part1_goal1
