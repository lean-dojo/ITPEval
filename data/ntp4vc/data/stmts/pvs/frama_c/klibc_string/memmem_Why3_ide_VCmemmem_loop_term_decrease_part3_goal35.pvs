% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/klibc_string/memmem_Why3_ide_VCmemmem_loop_term_decrease_part3_goal35:
% decrease of the memmem loop variant after advancing the candidate offset,
% under memory-validity, separation, and mismatch invariants. This file contains no proof.

memmem_Why3_ide_VCmemmem_loop_term_decrease_part3_goal35: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  integer_conversion: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  uint32_conversion_axioms(to_uint32: integer_conversion): bool =
    (FORALL (value: int): is_uint32(to_uint32(value)))
      AND
    (FORALL (value: int):
      is_uint32(value) IMPLIES to_uint32(value) = value)

  goal35: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (to_uint32: integer_conversion),
      (a_8: addr),
      (a_9: addr),
      (t_1: integer_memory),
      (a_1: addr),
      (a: addr),
      (i_2: int),
      (a_6: addr),
      (i_1: int),
      (a_7: addr),
      (i: int),
      (t: allocation_table),
      (a_5: addr),
      (a_4: addr),
      (a_3: addr),
      (a_2: addr):
      uint32_conversion_axioms(to_uint32) IMPLIES
      LET x: int = base(a_8),
          x_1: int = base(a_9),
          x_2: int = t_1(shift(a_1, 0)),
          x_3: int = t_1(shift(a, i_2)),
          x_4: int = t_1(shift(a_1, 1)),
          x_5: int = to_uint32(1 + i_2),
          x_6: int = t_1(shift(a, x_5)),
          a_10: addr = shift(a_8, 0),
          a_11: addr = shift(a_9, 0),
          a_12: addr = shift(a_6, 0),
          x_7: int = to_uint32(i_1 - 2),
          a_13: addr = shift(a_7, 0)
      IN
        i /= 0 IMPLIES
        i_1 /= 0 IMPLIES
        i_1 /= 1 IMPLIES
        x = base(a_1) IMPLIES
        x_1 = base(a) IMPLIES
        x_2 /= x_3 IMPLIES
        x_4 = x_2 IMPLIES
        x_6 = x_4 IMPLIES
        0 <= i IMPLIES
        i_1 <= i IMPLIES
        0 <= i_1 IMPLIES
        0 <= i_2 IMPLIES
        region(x) <= 0 IMPLIES
        region(x_1) <= 0 IMPLIES
        i_2 <= to_uint32(i - i_1) IMPLIES
        i_1 + i_2 <= 2 + i IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint8(x_3) IMPLIES
        is_uint8(x_2) IMPLIES
        is_uint8(x_4) IMPLIES
        valid_rw(t, a_10, i_1) IMPLIES
        valid_rw(t, a_11, i) IMPLIES
        separated(a_11, i, a_10, i_1) IMPLIES
        valid_rw(t, a_12, x_7) IMPLIES
        valid_rw(t, a_13, x_7) IMPLIES
        separated(a_13, x_7, a_12, x_7) IMPLIES
        is_uint8(x_6) IMPLIES
        (0 < x_7 IMPLIES
          NOT (EXISTS (i_3: int):
            t_1(shift(a_5, i_3)) /= t_1(shift(a_4, i_3))
              AND 0 <= i_3
              AND i_3 < x_7)) IMPLIES
        (FORALL (i_3: int):
          0 <= i_3 IMPLIES
          i_3 < i_2 IMPLIES
          (EXISTS (i_4: int):
            0 <= i_4 IMPLIES
            3 + i_4 <= i_1 IMPLIES
            t_1(shift(a_3, 2 + i_4 + i_3))
              /= t_1(shift(a_2, 2 + i_4)))) IMPLIES
        i_2 < x_5
END memmem_Why3_ide_VCmemmem_loop_term_decrease_part3_goal35
