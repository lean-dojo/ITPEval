% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/klibc_string/strcasecmp_Why3_ide_VCstrcasecmp_not_eq_post_part2_goal19:
% a strcasecmp verification condition deriving failure of universal
% case-insensitive prefix equality from a witnessed mismatch. This file contains no proof.

strcasecmp_Why3_ide_VCstrcasecmp_not_eq_post_part2_goal19: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  address_relation: TYPE = [addr, addr -> bool]
  integer_conversion: TYPE = [int -> int]
  string_length_function: TYPE = [integer_memory, addr -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_sint8(value: int): bool =
    -128 <= value AND value < 128

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  p_is_lower(c: int): bool =
    97 <= c AND c <= 122

  p_is_upper(c: int): bool =
    65 <= c AND c <= 90

  p_length_of_str_is(
      malloc: allocation_table,
      mchar: integer_memory,
      s: addr,
      n: int): bool =
    mchar(shift(s, n)) = 0
      AND 0 <= n
      AND valid_rw(malloc, shift(s, 0), 1 + n)
      AND (FORALL (j: int):
        0 <= j IMPLIES
        j < n IMPLIES
        mchar(shift(s, j)) /= 0)

  address_order_axiom(addr_le: address_relation): bool =
    FORALL (p, q: addr):
      base(p) = base(q) IMPLIES
        (addr_le(p, q) IFF offset(p) <= offset(q))

  uint8_conversion_axioms(to_uint8: integer_conversion): bool =
    (FORALL (value: int): is_uint8(to_uint8(value)))
      AND
    (FORALL (value: int):
      is_uint8(value) IMPLIES to_uint8(value) = value)

  string_length_axiom(l_length: string_length_function): bool =
    FORALL
      (malloc: allocation_table),
      (mchar: integer_memory),
      (s: addr),
      (n: int):
      p_length_of_str_is(malloc, mchar, s, n) IMPLIES
        l_length(mchar, s) = n

  uppercase_axioms(l_toupper: integer_conversion): bool =
    (FORALL (c: int):
      is_uint8(c) IMPLIES is_sint8(l_toupper(c)))
      AND
    (FORALL (c: int):
      is_uint8(c) IMPLIES
      p_is_lower(c) IMPLIES
      (32 + l_toupper(c) = c
        AND (FORALL (upper_char: int):
          is_uint8(upper_char) IMPLIES
          p_is_upper(upper_char) IMPLIES
          (l_toupper(upper_char) = upper_char
            AND (FORALL (other_char: int):
              is_uint8(other_char) IMPLIES
              NOT p_is_lower(other_char) IMPLIES
              NOT p_is_upper(other_char) IMPLIES
              l_toupper(other_char) = other_char)))))

  goal19: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (sconst: [integer_memory -> bool]),
      (addr_le: address_relation),
      (to_uint8, l_toupper: integer_conversion),
      (l_length: string_length_function),
      (a, a_1, a_2: addr),
      (t_1: integer_memory),
      (i_5, i_6: int),
      (t: allocation_table),
      (i, i_1, i_4, i_2, i_3: int):
      address_order_axiom(addr_le) IMPLIES
      uint8_conversion_axioms(to_uint8) IMPLIES
      string_length_axiom(l_length) IMPLIES
      uppercase_axioms(l_toupper) IMPLIES
      LET x: int = base(a),
          x_1: int = offset(a_1),
          x_2: int = offset(a),
          a_3: addr = shift(a_2, x_1 - x_2),
          x_3: int = t_1(a_1),
          x_4: int = l_length(t_1, a),
          x_5: int = l_length(t_1, a_2),
          x_6: int = to_uint8(x_3)
      IN
        base(a_1) = x IMPLIES
        l_toupper(to_uint8(t_1(shift(a_2, i_5))))
          /= l_toupper(to_uint8(t_1(shift(a, i_5)))) IMPLIES
        t_1(a_3) = 0 IMPLIES
        0 <= i_5 IMPLIES
        i_5 <= i_6 IMPLIES
        0 <= x_3 IMPLIES
        region(x) <= 0 IMPLIES
        region(base(a_2)) <= 0 IMPLIES
        x_3 <= 255 IMPLIES
        linked(t) IMPLIES
        sconst(t_1) IMPLIES
        is_sint32(i) IMPLIES
        addr_le(a, a_1) IMPLIES
        is_sint8(x_3) IMPLIES
        p_length_of_str_is(t, t_1, a, i_1) IMPLIES
        p_length_of_str_is(t, t_1, a, i_4) IMPLIES
        p_length_of_str_is(t, t_1, a, i_6) IMPLIES
        p_length_of_str_is(t, t_1, a_2, i_2) IMPLIES
        p_length_of_str_is(t, t_1, a_2, i_3) IMPLIES
        p_length_of_str_is(t, t_1, a_2, i_6) IMPLIES
        addr_le(a_1, shift(a, x_4)) IMPLIES
        separated(shift(a_2, 0), 1 + x_5, shift(a, 0), 1 + x_4) IMPLIES
        addr_le(a_2, a_3) IMPLIES
        addr_le(a_3, shift(a_2, x_5)) IMPLIES
        (p_is_lower(0) IMPLIES i = -32) IMPLIES
        (p_is_upper(0) IMPLIES i = 0) IMPLIES
        (NOT p_is_lower(0) IMPLIES
          NOT p_is_upper(0) IMPLIES
          i = 0) IMPLIES
        (p_is_upper(x_6) IMPLIES x_3 = i) IMPLIES
        (p_is_lower(x_6) IMPLIES x_3 = 32 + i) IMPLIES
        (NOT p_is_lower(x_6) IMPLIES
          NOT p_is_upper(x_6) IMPLIES
          x_3 = i) IMPLIES
        NOT (FORALL (i_7: int):
          0 <= i_7 IMPLIES
          i_7 + x_2 < x_1 IMPLIES
          l_toupper(to_uint8(t_1(shift(a_2, i_7))))
            = l_toupper(to_uint8(t_1(shift(a, i_7)))))
END strcasecmp_Why3_ide_VCstrcasecmp_not_eq_post_part2_goal19
