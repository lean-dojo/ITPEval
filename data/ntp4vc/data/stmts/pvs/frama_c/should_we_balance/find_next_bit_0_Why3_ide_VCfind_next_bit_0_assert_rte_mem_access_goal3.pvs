% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/should_we_balance/find_next_bit_0_Why3_ide_VCfind_next_bit_0_assert_rte_mem_access_goal3:
% a find_next_bit_0 verification condition asserting validity of a one-cell
% read at a shifted address under the source bounds, allocation validity,
% linkedness, and preceding-zero invariant. This file contains no proof.

find_next_bit_0_Why3_ide_VCfind_next_bit_0_assert_rte_mem_access_goal3: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  size_axiom(l_size: int): bool =
    0 < l_size AND l_size <= 2147483647

  goal3: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_size: int),
      (a: addr),
      (i_2, i, i_1: int),
      (t: allocation_table),
      (t_1: integer_memory):
      size_axiom(l_size) IMPLIES
      LET a_1: addr = shift(a, i_2) IN
        i_2 < i IMPLIES
        i_1 <= i_2 IMPLIES
        i <= l_size IMPLIES
        region(base(a)) <= 0 IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_uint32(i_1) IMPLIES
        is_uint32(i_2) IMPLIES
        is_uint8(t_1(a_1)) IMPLIES
        valid_rd(t, shift(a, 0), i) IMPLIES
        (FORALL (i_3: int):
          i_1 <= i_3 IMPLIES
          i_3 < i_2 IMPLIES
          t_1(shift(a, i_3)) = 0) IMPLIES
        valid_rd(t, a_1, 1)
END find_next_bit_0_Why3_ide_VCfind_next_bit_0_assert_rte_mem_access_goal3
