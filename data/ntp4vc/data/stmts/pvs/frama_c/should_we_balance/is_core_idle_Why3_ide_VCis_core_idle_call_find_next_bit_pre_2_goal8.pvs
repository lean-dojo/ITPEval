% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/should_we_balance/is_core_idle_Why3_ide_VCis_core_idle_call_find_next_bit_pre_2_goal8:
% an is_core_idle verification condition asserting validity of the SMT-mask
% read passed to find_next_bit under the source bounds, memory-validity,
% framing, linkedness, idle-CPU, and separation assumptions. This file
% contains no proof.

is_core_idle_Why3_ide_VCis_core_idle_call_find_next_bit_pre_2_goal8: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(region: [int -> int], memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  size_axiom(l_size: int): bool =
    0 < l_size AND l_size <= 2147483647

  scheduler_axioms(
      l_size: int,
      l_idle_cpu: [int -> int],
      l_cpu_smt_mask: [int -> addr]): bool =
    (FORALL (cpu: int):
      is_uint8(l_idle_cpu(cpu)))
      AND
    (FORALL
      (i: int),
      (integer_mem: integer_memory),
      (pointer_mem: pointer_memory):
      0 <= i IMPLIES
      i < l_size IMPLIES
      integer_mem(
        shift(
          pointer_mem(shift(l_cpu_smt_mask(i), 0)),
          i)) /= 0)
      AND
    (FORALL
      (integer_mem: integer_memory),
      (pointer_mem: pointer_memory),
      (j, i: int):
      integer_mem(
        shift(
          pointer_mem(shift(l_cpu_smt_mask(j), 0)),
          i)) /= 0
      IMPLIES 0 <= i
      IMPLIES i < l_size
      IMPLIES 0 <= j
      IMPLIES j < l_size
      IMPLIES
        integer_mem(
          shift(
            pointer_mem(shift(l_cpu_smt_mask(i), 0)),
            j)) /= 0)
      AND
    (FORALL
      (pointer_mem: pointer_memory),
      (i: int),
      (integer_mem: integer_memory),
      (j, k: int):
      integer_mem(
        shift(
          pointer_mem(shift(l_cpu_smt_mask(i), 0)),
          j)) /= 0
      IMPLIES
        integer_mem(
          shift(
            pointer_mem(shift(l_cpu_smt_mask(j), 0)),
            k)) /= 0
      IMPLIES 0 <= i
      IMPLIES i < l_size
      IMPLIES 0 <= j
      IMPLIES j < l_size
      IMPLIES 0 <= k
      IMPLIES k < l_size
      IMPLIES
        integer_mem(
          shift(
            pointer_mem(shift(l_cpu_smt_mask(i), 0)),
            k)) /= 0)

  goal8: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_size: int),
      (l_idle_cpu: [int -> int]),
      (l_sched_group_cpus: [addr -> addr]),
      (l_sched_group_mask: [addr -> addr]),
      (l_group_balance_mask: [addr -> addr]),
      (l_cpu_smt_mask: [int -> addr]),
      (i_2: int),
      (t_2: pointer_memory),
      (i, i_1: int),
      (a: addr),
      (t: allocation_table),
      (t_1: integer_memory):
      size_axiom(l_size) IMPLIES
      scheduler_axioms(
        l_size,
        l_idle_cpu,
        l_cpu_smt_mask) IMPLIES
      LET a_1: addr = shift(l_cpu_smt_mask(i_2), 0),
          a_2: addr = t_2(a_1)
      IN
        l_idle_cpu(i_2) /= 0 IMPLIES
        0 <= i IMPLIES
        i < l_size IMPLIES
        0 <= i_1 IMPLIES
        0 <= i_2 IMPLIES
        i_2 < l_size IMPLIES
        i_1 <= l_size IMPLIES
        region(base(a)) <= 0 IMPLIES
        framed(region, t_2) IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        is_sint32(i_1) IMPLIES
        is_sint32(i_2) IMPLIES
        valid_rd(t, a_1, 1) IMPLIES
        (FORALL (i_3: int):
          t_1(shift(a_2, i_3)) /= 0 IMPLIES
          0 <= i_3 IMPLIES
          i_3 < i_1 IMPLIES
          l_idle_cpu(i_3) /= 0) IMPLIES
        (FORALL (i_3: int):
          LET a_3: addr = shift(a, i_3) IN
            0 <= i_3 IMPLIES
            i_3 < l_size IMPLIES
            valid_rd(t, a_3, 1)
              AND valid_rw(
                t,
                shift(t_2(shift(a_3, 0)), 0),
                l_size)) IMPLIES
        (FORALL (a_3: addr):
          LET a_4: addr = l_sched_group_cpus(a_3),
              a_5: addr = shift(t_2(shift(a_4, 0)), 0)
          IN
            valid_rd(t, a_4, 1)
              AND valid_rd(t, a_5, l_size)
              AND
            (FORALL (i_3: int):
              0 <= i_3 IMPLIES
              i_3 < l_size IMPLIES
              separated(
                a_5,
                l_size,
                shift(t_2(shift(shift(a, i_3), 0)), 0),
                l_size))) IMPLIES
        (FORALL (a_3: addr):
          LET a_4: addr = l_sched_group_mask(a_3),
              a_5: addr = shift(t_2(shift(a_4, 0)), 0)
          IN
            valid_rd(t, a_4, 1)
              AND valid_rd(t, a_5, l_size)
              AND
            (FORALL (i_3: int):
              0 <= i_3 IMPLIES
              i_3 < l_size IMPLIES
              separated(
                a_5,
                l_size,
                shift(t_2(shift(shift(a, i_3), 0)), 0),
                l_size))) IMPLIES
        (FORALL (a_3: addr):
          LET a_4: addr = l_group_balance_mask(a_3),
              a_5: addr = shift(t_2(shift(a_4, 0)), 0)
          IN
            valid_rd(t, a_4, 1)
              AND valid_rd(t, a_5, l_size)
              AND
            (FORALL (i_3: int):
              0 <= i_3 IMPLIES
              i_3 < l_size IMPLIES
              separated(
                a_5,
                l_size,
                shift(t_2(shift(shift(a, i_3), 0)), 0),
                l_size))) IMPLIES
        (FORALL (i_3: int):
          LET a_3: addr = l_cpu_smt_mask(i_3),
              a_4: addr = shift(t_2(shift(a_3, 0)), 0)
          IN
            0 <= i_3 IMPLIES
            i_3 < l_size IMPLIES
            valid_rd(t, a_3, 1)
              AND valid_rd(t, a_4, l_size)
              AND
            (FORALL (i_4: int):
              0 <= i_4 IMPLIES
              i_4 < l_size IMPLIES
              separated(
                a_4,
                l_size,
                shift(t_2(shift(shift(a, i_4), 0)), 0),
                l_size))) IMPLIES
        valid_rd(t, shift(a_2, 0), l_size)
END is_core_idle_Why3_ide_VCis_core_idle_call_find_next_bit_pre_2_goal8
