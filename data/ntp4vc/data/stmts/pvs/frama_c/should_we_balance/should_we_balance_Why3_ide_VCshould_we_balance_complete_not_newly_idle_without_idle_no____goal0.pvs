% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_complete_not_newly_idle_without_idle_no____goal0:
% a should_we_balance verification condition classifying the completed
% scheduling decision by idle-CPU, idle-core, and balance-mask conditions under
% the source bounds, memory-validity, framing, linkedness, and separation
% assumptions. This file contains no proof.

should_we_balance_Why3_ide_VCshould_we_balance_complete_not_newly_idle_without_idle_no____goal0: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(region: [int -> int], memory: pointer_memory): bool =
    FORALL (p: addr): region(base(memory(p))) <= 0

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  low_three_bits(value: int): int =
    mod(value, 8)

  size_axiom(l_size: int): bool =
    0 < l_size AND l_size <= 2147483647

  scheduler_axioms(
      l_size: int,
      l_idle_cpu: [int -> int],
      l_cpu_smt_mask: [int -> addr]): bool =
    (FORALL (cpu: int):
      is_uint8(l_idle_cpu(cpu)))
      AND
    (FORALL
      (i: int),
      (integer_mem: integer_memory),
      (pointer_mem: pointer_memory):
      0 <= i IMPLIES
      i < l_size IMPLIES
      integer_mem(
        shift(
          pointer_mem(shift(l_cpu_smt_mask(i), 0)),
          i)) /= 0)
      AND
    (FORALL
      (integer_mem: integer_memory),
      (pointer_mem: pointer_memory),
      (j, i: int):
      integer_mem(
        shift(
          pointer_mem(shift(l_cpu_smt_mask(j), 0)),
          i)) /= 0
      IMPLIES 0 <= i
      IMPLIES i < l_size
      IMPLIES 0 <= j
      IMPLIES j < l_size
      IMPLIES
        integer_mem(
          shift(
            pointer_mem(shift(l_cpu_smt_mask(i), 0)),
            j)) /= 0)
      AND
    (FORALL
      (pointer_mem: pointer_memory),
      (i: int),
      (integer_mem: integer_memory),
      (j, k: int):
      integer_mem(
        shift(
          pointer_mem(shift(l_cpu_smt_mask(i), 0)),
          j)) /= 0
      IMPLIES
        integer_mem(
          shift(
            pointer_mem(shift(l_cpu_smt_mask(j), 0)),
            k)) /= 0
      IMPLIES 0 <= i
      IMPLIES i < l_size
      IMPLIES 0 <= j
      IMPLIES j < l_size
      IMPLIES 0 <= k
      IMPLIES k < l_size
      IMPLIES
        integer_mem(
          shift(
            pointer_mem(shift(l_cpu_smt_mask(i), 0)),
            k)) /= 0)

  p_idle_core(
      l_size: int,
      l_cpu_smt_mask: [int -> addr],
      l_idle_cpu: [int -> int],
      pointer_mem: pointer_memory,
      integer_mem: integer_memory,
      cpu: int): bool =
    FORALL (j: int):
      integer_mem(
        shift(pointer_mem(shift(l_cpu_smt_mask(cpu), 0)), j)) /= 0
      IMPLIES 0 <= j
      IMPLIES j < l_size
      IMPLIES l_idle_cpu(j) /= 0

  goal0: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (l_size: int),
      (l_idle_cpu: [int -> int]),
      (l_sched_group_cpus: [addr -> addr]),
      (l_sched_group_mask: [addr -> addr]),
      (l_group_balance_mask: [addr -> addr]),
      (l_cpu_smt_mask: [int -> addr]),
      (t_1: integer_memory),
      (a_1: addr),
      (t_2: pointer_memory),
      (i: int),
      (a: addr),
      (t: allocation_table):
      size_axiom(l_size) IMPLIES
      scheduler_axioms(
        l_size,
        l_idle_cpu,
        l_cpu_smt_mask) IMPLIES
      LET x: int = t_1(shift(a_1, 1)),
          x_1: int = t_1(shift(a_1, 3)),
          a_2: addr = t_2(shift(a_1, 4)),
          a_3: addr = t_2(shift(a_1, 0)),
          x_2: int = t_1(shift(a_3, 1)),
          a_4: addr = t_2(shift(a_3, 0)),
          a_5: addr = t_2(shift(a_2, 0)),
          x_3: int = t_1(shift(a_5, x)),
          a_6: addr = shift(a_5, 0),
          a_7: addr =
            t_2(shift(l_group_balance_mask(a_4), 0)),
          x_4: int = low_three_bits(x_2)
      IN
        0 <= i IMPLIES
        i < l_size IMPLIES
        0 <= x IMPLIES
        x < l_size IMPLIES
        region(base(a)) <= 0 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        framed(region, t_2) IMPLIES
        linked(t) IMPLIES
        is_uint32(i) IMPLIES
        valid_rd(t, a_1, 5) IMPLIES
        is_uint32(x_1) IMPLIES
        is_sint32(x) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        valid_rd(t, t_2(shift(a_1, 2)), 2) IMPLIES
        valid_rd(t, a_3, 2) IMPLIES
        is_sint32(x_2) IMPLIES
        valid_rd(t, a_4, 1) IMPLIES
        is_uint8(x_3) IMPLIES
        valid_rd(t, a_6, l_size) IMPLIES
        (FORALL (i_1: int):
          0 <= i_1 IMPLIES
          i_1 < l_size IMPLIES
          separated(
            a_6,
            l_size,
            shift(t_2(shift(shift(a, i_1), 0)), 0),
            l_size)) IMPLIES
        (FORALL (i_1: int):
          LET a_8: addr = shift(a, i_1)
          IN
            0 <= i_1 IMPLIES
            i_1 < l_size IMPLIES
            valid_rd(t, a_8, 1)
              AND valid_rw(
                t,
                shift(t_2(shift(a_8, 0)), 0),
                l_size)) IMPLIES
        (FORALL (a_8: addr):
          LET a_9: addr = l_sched_group_cpus(a_8),
              a_10: addr = shift(t_2(shift(a_9, 0)), 0)
          IN
            valid_rd(t, a_9, 1)
              AND valid_rd(t, a_10, l_size)
              AND
            (FORALL (i_1: int):
              0 <= i_1 IMPLIES
              i_1 < l_size IMPLIES
              separated(
                a_10,
                l_size,
                shift(t_2(shift(shift(a, i_1), 0)), 0),
                l_size))) IMPLIES
        (FORALL (a_8: addr):
          LET a_9: addr = l_sched_group_mask(a_8),
              a_10: addr = shift(t_2(shift(a_9, 0)), 0)
          IN
            valid_rd(t, a_9, 1)
              AND valid_rd(t, a_10, l_size)
              AND
            (FORALL (i_1: int):
              0 <= i_1 IMPLIES
              i_1 < l_size IMPLIES
              separated(
                a_10,
                l_size,
                shift(t_2(shift(shift(a, i_1), 0)), 0),
                l_size))) IMPLIES
        (FORALL (a_8: addr):
          LET a_9: addr = l_group_balance_mask(a_8),
              a_10: addr = shift(t_2(shift(a_9, 0)), 0)
          IN
            valid_rd(t, a_9, 1)
              AND valid_rd(t, a_10, l_size)
              AND
            (FORALL (i_1: int):
              0 <= i_1 IMPLIES
              i_1 < l_size IMPLIES
              separated(
                a_10,
                l_size,
                shift(t_2(shift(shift(a, i_1), 0)), 0),
                l_size))) IMPLIES
        (FORALL (i_1: int):
          LET a_8: addr = l_cpu_smt_mask(i_1),
              a_9: addr = shift(t_2(shift(a_8, 0)), 0)
          IN
            0 <= i_1 IMPLIES
            i_1 < l_size IMPLIES
            valid_rd(t, a_8, 1)
              AND valid_rd(t, a_9, l_size)
              AND
            (FORALL (i_2: int):
              0 <= i_2 IMPLIES
              i_2 < l_size IMPLIES
              separated(
                a_9,
                l_size,
                shift(t_2(shift(shift(a, i_2), 0)), 0),
                l_size))) IMPLIES
        x_3 = 0
          OR
        (x_1 = 2
          AND x_3 /= 0)
          OR
        (x_1 /= 2
          AND x_3 /= 0
          AND
        (FORALL (i_1: int):
          t_1(shift(a_5, i_1)) /= 0 IMPLIES
          t_1(shift(a_7, i_1)) /= 0 IMPLIES
          0 <= i_1 IMPLIES
          i_1 < l_size IMPLIES
          l_idle_cpu(i_1) = 0))
          OR
        (x_1 /= 2
          AND x_4 = 0
          AND x_3 /= 0
          AND
        (EXISTS (i_1: int):
          t_1(shift(a_5, i_1)) /= 0
            AND t_1(shift(a_7, i_1)) /= 0
            AND 0 <= i_1
            AND i_1 < l_size
            AND p_idle_core(
              l_size,
              l_cpu_smt_mask,
              l_idle_cpu,
              t_2,
              t_1,
              i_1)))
          OR
        (x_1 /= 2
          AND x_4 /= 0
          AND x_3 /= 0
          AND
        (EXISTS (i_1: int):
          l_idle_cpu(i_1) /= 0
            AND t_1(shift(a_5, i_1)) /= 0
            AND t_1(shift(a_7, i_1)) /= 0
            AND 0 <= i_1
            AND i_1 < l_size))
          OR
        (x_1 /= 2
          AND x_4 = 0
          AND x_3 /= 0
          AND
        (FORALL (i_1: int):
          t_1(shift(a_5, i_1)) /= 0 IMPLIES
          t_1(shift(a_7, i_1)) /= 0 IMPLIES
          0 <= i_1 IMPLIES
          i_1 < l_size IMPLIES
          NOT p_idle_core(
            l_size,
            l_cpu_smt_mask,
            l_idle_cpu,
            t_2,
            t_1,
            i_1))
          AND
        (EXISTS (i_1: int):
          l_idle_cpu(i_1) /= 0
            AND t_1(shift(a_5, i_1)) /= 0
            AND t_1(shift(a_7, i_1)) /= 0
            AND 0 <= i_1
            AND i_1 < l_size))
END should_we_balance_Why3_ide_VCshould_we_balance_complete_not_newly_idle_without_idle_no____goal0
