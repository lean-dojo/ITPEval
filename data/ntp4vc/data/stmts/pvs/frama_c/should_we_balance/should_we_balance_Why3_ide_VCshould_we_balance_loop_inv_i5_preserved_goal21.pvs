% Statement-only formalization of the NTP4VC corpus artifact
% frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_loop_inv_i5_preserved_goal21:
% preservation of the should_we_balance loop invariant excluding an idle core
% at the current CPU index, under the source search, integer-bound,
% memory-validity, framing, linkedness, scheduling, and separation assumptions.
% This file contains no proof.

should_we_balance_Why3_ide_VCshould_we_balance_loop_inv_i5_preserved_goal21: THEORY
BEGIN
  addr: TYPE = [# base: int, offset: int #]
  pointer_memory: TYPE = [addr -> addr]
  integer_memory: TYPE = [addr -> int]
  allocation_table: TYPE = [int -> int]
  integer_conversion: TYPE = [int -> int]

  shift(p: addr, k: int): addr =
    (# base := base(p), offset := offset(p) + k #)

  separated(p: addr, p_size: int, q: addr, q_size: int): bool =
    p_size <= 0
      OR q_size <= 0
      OR base(p) /= base(q)
      OR offset(q) + q_size <= offset(p)
      OR offset(p) + p_size <= offset(q)

  havoc(
      original, outside: integer_memory,
      start: addr,
      size: int): integer_memory =
    LAMBDA (q: addr):
      IF separated(q, 1, start, size) THEN
        outside(q)
      ELSE
        original(q)
      ENDIF

  valid_rw(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      0 < base(p)
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  valid_rd(malloc: allocation_table, p: addr, size: int): bool =
    0 < size IMPLIES
      base(p) /= 0
        AND 0 <= offset(p)
        AND offset(p) + size <= malloc(base(p))

  framed(region: [int -> int], memory: pointer_memory): bool =
    FORALL (q: addr): region(base(memory(q))) <= 0

  is_uint8(value: int): bool =
    0 <= value AND value < 256

  is_uint32(value: int): bool =
    0 <= value AND value < 4294967296

  is_sint32(value: int): bool =
    -2147483648 <= value AND value < 2147483648

  low_three_bits(value: int): int =
    mod(value, 8)

  uint32_conversion_axioms(to_uint32: integer_conversion): bool =
    (FORALL (value: int): is_uint32(to_uint32(value)))
      AND
    (FORALL (value: int):
      is_uint32(value) IMPLIES to_uint32(value) = value)

  size_axiom(l_size: int): bool =
    0 < l_size AND l_size <= 2147483647

  mask_member(
      l_cpu_smt_mask: [int -> addr],
      pointer_mem: pointer_memory,
      integer_mem: integer_memory,
      cpu, member: int): bool =
    integer_mem(
      shift(pointer_mem(shift(l_cpu_smt_mask(cpu), 0)), member)) /= 0

  q_tl_idle_cpu(l_idle_cpu: [int -> int]): bool =
    FORALL (cpu: int): is_uint8(l_idle_cpu(cpu))

  q_mask_refl(
      l_size: int,
      l_cpu_smt_mask: [int -> addr]): bool =
    FORALL
      (i: int),
      (integer_mem: integer_memory),
      (pointer_mem: pointer_memory):
      0 <= i IMPLIES
      i < l_size IMPLIES
      mask_member(
        l_cpu_smt_mask,
        pointer_mem,
        integer_mem,
        i,
        i)

  q_mask_symm(
      l_size: int,
      l_cpu_smt_mask: [int -> addr]): bool =
    FORALL
      (integer_mem: integer_memory),
      (pointer_mem: pointer_memory),
      (j, i: int):
      mask_member(
        l_cpu_smt_mask,
        pointer_mem,
        integer_mem,
        j,
        i) IMPLIES
      0 <= i IMPLIES
      i < l_size IMPLIES
      0 <= j IMPLIES
      j < l_size IMPLIES
      mask_member(
        l_cpu_smt_mask,
        pointer_mem,
        integer_mem,
        i,
        j)

  q_mask_trans(
      l_size: int,
      l_cpu_smt_mask: [int -> addr]): bool =
    FORALL
      (pointer_mem: pointer_memory),
      (i: int),
      (integer_mem: integer_memory),
      (j, k: int):
      mask_member(
        l_cpu_smt_mask,
        pointer_mem,
        integer_mem,
        i,
        j) IMPLIES
      mask_member(
        l_cpu_smt_mask,
        pointer_mem,
        integer_mem,
        j,
        k) IMPLIES
      0 <= i IMPLIES
      i < l_size IMPLIES
      0 <= j IMPLIES
      j < l_size IMPLIES
      0 <= k IMPLIES
      k < l_size IMPLIES
      mask_member(
        l_cpu_smt_mask,
        pointer_mem,
        integer_mem,
        i,
        k)

  p_idle_core(
      l_size: int,
      l_cpu_smt_mask: [int -> addr],
      l_idle_cpu: [int -> int],
      pointer_mem: pointer_memory,
      integer_mem: integer_memory,
      cpu: int): bool =
    FORALL (j: int):
      integer_mem(
        shift(pointer_mem(shift(l_cpu_smt_mask(cpu), 0)), j)) /= 0
      IMPLIES 0 <= j
      IMPLIES j < l_size
      IMPLIES l_idle_cpu(j) /= 0

  goal21: bool =
    FORALL
      (region: [int -> int]),
      (linked: [allocation_table -> bool]),
      (to_uint32: integer_conversion),
      (l_size: int),
      (l_idle_cpu: [int -> int]),
      (l_sched_group_cpus: [addr -> addr]),
      (l_sched_group_mask: [addr -> addr]),
      (l_group_balance_mask: [addr -> addr]),
      (l_cpu_smt_mask: [int -> addr]),
      (i_6: int),
      (a_1: addr),
      (t_3: integer_memory),
      (t_5: pointer_memory),
      (a: addr),
      (i: int),
      (t_2, t_1: integer_memory),
      (i_1, i_7, i_3, i_4, i_5: int),
      (t: allocation_table),
      (i_2: int),
      (p: bool),
      (t_4: integer_memory):
      size_axiom(l_size) IMPLIES
      uint32_conversion_axioms(to_uint32) IMPLIES
      q_tl_idle_cpu(l_idle_cpu) IMPLIES
      q_mask_refl(l_size, l_cpu_smt_mask) IMPLIES
      q_mask_symm(l_size, l_cpu_smt_mask) IMPLIES
      q_mask_trans(l_size, l_cpu_smt_mask) IMPLIES
      LET x: int = l_idle_cpu(i_6),
          a_2: addr = shift(a_1, 3),
          x_1: int = t_3(a_2),
          a_3: addr = shift(a_1, 4),
          a_4: addr = t_5(a_3),
          a_5: addr = shift(a_4, 0),
          a_6: addr = t_5(a_5),
          a_7: addr = shift(a_1, 1),
          x_2: int = t_3(a_7),
          x_3: int = t_3(shift(a_6, x_2)),
          a_8: addr = shift(a, i),
          a_9: addr = shift(a_8, 0),
          a_10: addr = t_5(a_9),
          a_11: addr = shift(a_10, 0),
          a_12: integer_memory = havoc(t_2, t_3, a_11, l_size),
          a_13: addr = shift(a_1, 0),
          a_14: addr = t_5(a_13),
          a_15: addr = shift(a_14, 0),
          a_16: addr = t_5(a_15),
          a_17: addr = l_group_balance_mask(a_16),
          a_18: addr = t_5(shift(a_17, 0)),
          a_19: addr = shift(a_14, 1),
          a_20: addr = shift(a_6, 0),
          a_21: integer_memory = havoc(t_1, t_3, a_11, l_size),
          a_22: int = a_12(shift(a_10, i_6)),
          a_23: int = a_12(shift(a_6, i_1)),
          a_24: int = a_12(shift(a_6, i_6)),
          a_25: int = a_12(shift(a_18, i_1)),
          a_26: int = a_12(a_19),
          a_27: addr = shift(a_18, 0),
          x_4: int = to_uint32(i_7)
      IN
        i_3 /= -1 IMPLIES
        (x /= 0 IFF i_4 /= 0) IMPLIES
        x_1 /= 2 IMPLIES
        x_3 /= 0 IMPLIES
        a_12(shift(a_6, i_5)) /= 0 IMPLIES
        a_12(shift(a_18, i_5)) /= 0 IMPLIES
        0 <= i IMPLIES
        i < l_size IMPLIES
        0 <= i_5 IMPLIES
        i_3 <= i_5 IMPLIES
        i_5 < l_size IMPLIES
        0 <= i_6 IMPLIES
        i_5 <= i_6 IMPLIES
        i_6 < l_size IMPLIES
        0 <= i_7 IMPLIES
        i_7 <= l_size IMPLIES
        to_uint32(i_6) < l_size IMPLIES
        0 <= x_2 IMPLIES
        x_2 < l_size IMPLIES
        region(base(a)) <= 0 IMPLIES
        region(base(a_1)) <= 0 IMPLIES
        framed(region, t_5) IMPLIES
        linked(t) IMPLIES
        is_uint8(i_4) IMPLIES
        is_uint32(i) IMPLIES
        is_sint32(i_1) IMPLIES
        is_sint32(i_2) IMPLIES
        is_sint32(i_3) IMPLIES
        is_sint32(i_6) IMPLIES
        is_sint32(i_7) IMPLIES
        valid_rd(t, a_1, 5) IMPLIES
        is_uint32(x_1) IMPLIES
        is_sint32(1 + i_6) IMPLIES
        is_sint32(x_2) IMPLIES
        valid_rd(t, a_3, 1) IMPLIES
        valid_rd(t, a_7, 1) IMPLIES
        valid_rd(t, a_2, 1) IMPLIES
        valid_rd(t, a_13, 1) IMPLIES
        valid_rd(t, a_8, 1) IMPLIES
        valid_rd(t, a_4, 1) IMPLIES
        valid_rd(t, t_5(shift(a_1, 2)), 2) IMPLIES
        valid_rd(t, a_14, 2) IMPLIES
        is_sint32(t_3(a_19)) IMPLIES
        valid_rd(t, a_9, 1) IMPLIES
        valid_rd(t, a_5, 1) IMPLIES
        valid_rd(t, a_15, 1) IMPLIES
        valid_rd(t, a_16, 1) IMPLIES
        valid_rd(t, a_17, 1) IMPLIES
        is_uint8(x_3) IMPLIES
        valid_rd(t, a_11, l_size) IMPLIES
        valid_rd(t, a_20, l_size) IMPLIES
        valid_rw(t, a_11, l_size) IMPLIES
        is_uint8(a_21(shift(a_6, -1))) IMPLIES
        is_uint8(a_21(shift(a_18, -1))) IMPLIES
        is_uint8(a_22) IMPLIES
        is_uint8(a_23) IMPLIES
        is_uint8(a_12(shift(a_6, i_3))) IMPLIES
        is_uint8(a_24) IMPLIES
        is_uint8(a_25) IMPLIES
        is_uint8(a_12(shift(a_18, i_3))) IMPLIES
        is_sint32(a_21(a_19)) IMPLIES
        is_sint32(a_26) IMPLIES
        valid_rd(t, a_27, l_size) IMPLIES
        separated(a_11, l_size, a_27, l_size) IMPLIES
        (IF i_4 = 0 THEN
          i_3 = i_1
            AND i_6 <= 2147483646
        ELSE
          p = FALSE
            AND i_2 = i_1
            AND x /= 0
            AND low_three_bits(t_4(a_19)) = 0
            AND a_12 = t_4
            AND i_6 <= 2147483646
            AND NOT p_idle_core(
              l_size,
              l_cpu_smt_mask,
              l_idle_cpu,
              t_5,
              t_4,
              i_6)
            AND valid_rd(t, a_19, 1)
            AND
              (IF i_2 = -1 THEN
                i_6 = i_3
              ELSE
                i_3 = i_2
              ENDIF)
        ENDIF) IMPLIES
        (low_three_bits(a_26) /= 0 IMPLIES i_1 = -1) IMPLIES
        (i_1 /= -1 IMPLIES
          l_idle_cpu(i_1) /= 0
            AND a_23 /= 0
            AND a_25 /= 0
            AND 0 <= i_1
            AND i_1 < l_size) IMPLIES
        (i_1 = -1 IMPLIES
          (FORALL (i_8: int):
            a_12(shift(a_18, i_8)) /= 0 IMPLIES
            0 <= i_8 IMPLIES
            i_8 < l_size IMPLIES
            a_12(shift(a_10, i_8)) /= 0)) IMPLIES
        ((EXISTS (i_8: int):
          a_12(shift(a_10, i_8)) /= 0
            AND a_12(shift(a_6, i_8)) /= 0
            AND i_8 < l_size
            AND x_4 <= i_8)
          IMPLIES x_4 <= i_6) IMPLIES
        ((EXISTS (i_8: int):
          a_12(shift(a_10, i_8)) /= 0
            AND a_12(shift(a_6, i_8)) /= 0
            AND i_8 < l_size
            AND x_4 <= i_8)
          IMPLIES a_22 /= 0 AND a_24 /= 0) IMPLIES
        ((FORALL (i_8: int):
          i_8 < l_size IMPLIES
          x_4 <= i_8 IMPLIES
          a_12(shift(a_10, i_8)) = 0
            OR a_12(shift(a_6, i_8)) = 0)
          IMPLIES l_size = i_6) IMPLIES
        (i_1 /= -1 IMPLIES
          (FORALL (i_8: int):
            a_12(shift(a_6, i_8)) /= 0 IMPLIES
            a_12(shift(a_18, i_8)) /= 0 IMPLIES
            0 <= i_8 IMPLIES
            i_8 < i_1 IMPLIES
            i_8 < l_size IMPLIES
            l_idle_cpu(i_8) = 0)) IMPLIES
        (i_1 = -1 IMPLIES
          (FORALL (i_8: int):
            a_12(shift(a_6, i_8)) /= 0 IMPLIES
            a_12(shift(a_18, i_8)) /= 0 IMPLIES
            0 <= i_8 IMPLIES
            i_8 < i_7 IMPLIES
            i_8 < l_size IMPLIES
            l_idle_cpu(i_8) = 0)) IMPLIES
        ((EXISTS (i_8: int):
          a_12(shift(a_10, i_8)) /= 0
            AND a_12(shift(a_6, i_8)) /= 0
            AND i_8 < l_size
            AND x_4 <= i_8)
          IMPLIES
            (FORALL (i_8: int):
              i_8 < i_6 IMPLIES
              x_4 <= i_8 IMPLIES
              a_12(shift(a_10, i_8)) = 0
                OR a_12(shift(a_6, i_8)) = 0)) IMPLIES
        (i_1 /= -1 IMPLIES
          (FORALL (i_8: int):
            a_12(shift(a_6, i_8)) /= 0 IMPLIES
            a_12(shift(a_18, i_8)) /= 0 IMPLIES
            0 <= i_8 IMPLIES
            i_1 <= i_8 IMPLIES
            i_8 < i_7 IMPLIES
            i_8 < l_size IMPLIES
            NOT p_idle_core(
              l_size,
              l_cpu_smt_mask,
              l_idle_cpu,
              t_5,
              a_12,
              i_8))) IMPLIES
        (i_1 /= -1 IMPLIES
          (FORALL (i_8: int):
            a_12(shift(a_18, i_8)) /= 0 IMPLIES
            0 <= i_8 IMPLIES
            i_8 < l_size IMPLIES
            a_12(shift(a_10, i_8)) /= 0
              OR NOT p_idle_core(
                l_size,
                l_cpu_smt_mask,
                l_idle_cpu,
                t_5,
                a_12,
                i_8))) IMPLIES
        (i_4 = 0 OR i_4 = 1) IMPLIES
        (FORALL (i_8: int):
          0 <= i_8 IMPLIES
          i_8 < l_size IMPLIES
          separated(
            a_20,
            l_size,
            shift(t_5(shift(shift(a, i_8), 0)), 0),
            l_size)) IMPLIES
        (FORALL (i_8: int):
          LET a_28: addr = shift(a, i_8)
          IN
            0 <= i_8 IMPLIES
            i_8 < l_size IMPLIES
            valid_rd(t, a_28, 1)
              AND valid_rw(
                t,
                shift(t_5(shift(a_28, 0)), 0),
                l_size)) IMPLIES
        (FORALL (i_8: int):
          0 <= i_8 IMPLIES
          i_8 < l_size IMPLIES
          (a_21(shift(a_18, i_8)) /= 0
            IFF a_21(shift(a_10, i_8)) /= 0)) IMPLIES
        (FORALL (i_8: int):
          a_12(shift(a_10, i_8)) /= 0 IMPLIES
          0 <= i_8 IMPLIES
          i_8 < l_size IMPLIES
          a_12(shift(a_18, i_8)) /= 0) IMPLIES
        (FORALL (a_28: addr):
          LET a_29: addr = l_sched_group_cpus(a_28),
              a_30: addr = shift(t_5(shift(a_29, 0)), 0)
          IN
            valid_rd(t, a_29, 1)
              AND valid_rd(t, a_30, l_size)
              AND
            (FORALL (i_8: int):
              0 <= i_8 IMPLIES
              i_8 < l_size IMPLIES
              separated(
                a_30,
                l_size,
                shift(t_5(shift(shift(a, i_8), 0)), 0),
                l_size))) IMPLIES
        (FORALL (a_28: addr):
          LET a_29: addr = l_sched_group_mask(a_28),
              a_30: addr = shift(t_5(shift(a_29, 0)), 0)
          IN
            valid_rd(t, a_29, 1)
              AND valid_rd(t, a_30, l_size)
              AND
            (FORALL (i_8: int):
              0 <= i_8 IMPLIES
              i_8 < l_size IMPLIES
              separated(
                a_30,
                l_size,
                shift(t_5(shift(shift(a, i_8), 0)), 0),
                l_size))) IMPLIES
        (FORALL (a_28: addr):
          LET a_29: addr = l_group_balance_mask(a_28),
              a_30: addr = shift(t_5(shift(a_29, 0)), 0)
          IN
            valid_rd(t, a_29, 1)
              AND valid_rd(t, a_30, l_size)
              AND
            (FORALL (i_8: int):
              0 <= i_8 IMPLIES
              i_8 < l_size IMPLIES
              separated(
                a_30,
                l_size,
                shift(t_5(shift(shift(a, i_8), 0)), 0),
                l_size))) IMPLIES
        (FORALL (i_8: int):
          LET a_28: addr = l_cpu_smt_mask(i_8),
              a_29: addr = shift(t_5(shift(a_28, 0)), 0)
          IN
            0 <= i_8 IMPLIES
            i_8 < l_size IMPLIES
            valid_rd(t, a_28, 1)
              AND valid_rd(t, a_29, l_size)
              AND
            (FORALL (i_9: int):
              0 <= i_9 IMPLIES
              i_9 < l_size IMPLIES
              separated(
                a_29,
                l_size,
                shift(t_5(shift(shift(a, i_9), 0)), 0),
                l_size))) IMPLIES
        NOT p_idle_core(
          l_size,
          l_cpu_smt_mask,
          l_idle_cpu,
          t_5,
          a_12,
          i_5)
END should_we_balance_Why3_ide_VCshould_we_balance_loop_inv_i5_preserved_goal21
