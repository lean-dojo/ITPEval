% Statement-only formalization of the NTP4VC corpus artifact
% pearl/bignum_BigNum_add_cinqtvc: correctness conditions for adding two
% valid base-b integer digit lists with an incoming carry. This file contains
% no proof.

bignum_BigNum_add_cinqtvc: THEORY
BEGIN
  value(base: int, digits: list[int]): RECURSIVE int =
    CASES digits OF
      null: 0,
      cons(digit, rest):
        digit + base * value(base, rest)
    ENDCASES
  MEASURE digits BY <<

  valid(base: int, digits: list[int]): RECURSIVE bool =
    CASES digits OF
      null: TRUE,
      cons(digit, rest):
        CASES rest OF
          null:
            0 < digit AND digit < base,
          cons(next_digit, remaining_digits):
            (0 <= digit AND digit < base)
              AND valid(base, rest)
        ENDCASES
    ENDCASES
  MEASURE digits BY <<

  add_cin_vc: bool =
    FORALL (base, cin: int), (n1, n2: list[int]):
      (1 < base
        AND valid(base, n1)
        AND valid(base, n2)
        AND 0 <= cin
        AND cin <= 1)
      IMPLIES
        (CASES n2 OF
          null:
            CASES n1 OF
              null:
                valid(base, n2)
                  AND 0 <= cin
                  AND cin < base,
              cons(x, x1):
                valid(base, n1)
                  AND 0 <= cin
                  AND cin < base
            ENDCASES,
          cons(x, x1):
            CASES n1 OF
              null:
                valid(base, n2)
                  AND 0 <= cin
                  AND cin < base,
              cons(x2, x3):
                IF cin + x2 + x < base THEN
                  (CASES n1 OF
                    null: FALSE,
                    cons(ignored, tail): tail = x3
                  ENDCASES)
                    AND valid(base, x3)
                    AND valid(base, x1)
                    AND 0 <= 0
                    AND 0 <= 1
                ELSE
                  (CASES n1 OF
                    null: FALSE,
                    cons(ignored, tail): tail = x3
                  ENDCASES)
                    AND valid(base, x3)
                    AND valid(base, x1)
                    AND 0 <= 1
                    AND 1 <= 1
                ENDIF
            ENDCASES
        ENDCASES)
          AND
        (FORALL (result: list[int]):
          (CASES n2 OF
            null:
              CASES n1 OF
                null:
                  valid(base, result)
                    AND value(base, result)
                      = value(base, n2) + cin,
                cons(x, x1):
                  valid(base, result)
                    AND value(base, result)
                      = value(base, n1) + cin
              ENDCASES,
            cons(x, x1):
              CASES n1 OF
                null:
                  valid(base, result)
                    AND value(base, result)
                      = value(base, n2) + cin,
                cons(x2, x3):
                  LET d: int = cin + x2 + x IN
                    IF d < base THEN
                      EXISTS (o1: list[int]):
                        (valid(base, o1)
                          AND value(base, o1)
                            = value(base, x3) + value(base, x1) + 0)
                          AND result = cons(d, o1)
                    ELSE
                      EXISTS (o1: list[int]):
                        (valid(base, o1)
                          AND value(base, o1)
                            = value(base, x3) + value(base, x1) + 1)
                          AND result = cons(d - base, o1)
                    ENDIF
              ENDCASES
          ENDCASES)
            IMPLIES
              valid(base, result)
                AND value(base, result)
                  = value(base, n1) + value(base, n2) + cin)
END bignum_BigNum_add_cinqtvc
