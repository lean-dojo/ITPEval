% Statement-only formalization of the NTP4VC corpus artifact
% pearl/binomial_heap_BinomialHeap_extract_minqtvc: the binomial-heap
% extract-min verification condition for heap and rank invariants and
% preservation of element occurrences. This file contains no proof.

binomial_heap_BinomialHeap_extract_minqtvc[
  elt: TYPE+,
  heap: TYPE+
]: THEORY
BEGIN

  % This datatype is isomorphic to a list of source trees: each FCons stores
  % one tree's root, child list, rank, and remaining sibling list.
  forest: DATATYPE
  BEGIN
    FNil: FNil?
    FCons(
      root_element: elt,
      child_forest: forest,
      root_rank: int,
      sibling_forest: forest): FCons?
  END forest

  singleton_tree(
      element: elt,
      children: forest,
      rank: int): forest =
    FCons(element, children, rank, FNil)

  preorder_laws(leq: [elt, elt -> bool]): bool =
    (FORALL (x: elt): leq(x, x))
      AND
    (FORALL (x, y, z: elt):
      (leq(x, y) AND leq(y, z)) IMPLIES leq(x, z))
      AND
    (FORALL (x, y: elt): leq(x, y) OR leq(y, x))

  forest_size(values: forest): RECURSIVE int =
    CASES values OF
      FNil:
        0,
      FCons(element, children, rank, siblings):
        1 + forest_size(children) + forest_size(siblings)
    ENDCASES
  MEASURE values BY <<

  forest_length(values: forest): RECURSIVE int =
    CASES values OF
      FNil:
        0,
      FCons(element, children, rank, siblings):
        1 + forest_length(siblings)
    ENDCASES
  MEASURE values BY <<

  forest_append(left, right: forest): RECURSIVE forest =
    CASES left OF
      FNil:
        right,
      FCons(element, children, rank, siblings):
        FCons(
          element,
          children,
          rank,
          forest_append(siblings, right))
    ENDCASES
  MEASURE left BY <<

  forest_reverse(values: forest): RECURSIVE forest =
    CASES values OF
      FNil:
        FNil,
      FCons(element, children, rank, siblings):
        forest_append(
          forest_reverse(siblings),
          singleton_tree(element, children, rank))
    ENDCASES
  MEASURE values BY <<

  le_roots(
      leq: [elt, elt -> bool],
      element: elt,
      values: forest): RECURSIVE bool =
    CASES values OF
      FNil:
        TRUE,
      FCons(root, children, rank, siblings):
        leq(element, root)
          AND le_roots(leq, element, siblings)
    ENDCASES
  MEASURE values BY <<

  heaps(
      leq: [elt, elt -> bool],
      values: forest): RECURSIVE bool =
    CASES values OF
      FNil:
        TRUE,
      FCons(element, children, rank, siblings):
        le_roots(leq, element, children)
          AND heaps(leq, children)
          AND heaps(leq, siblings)
    ENDCASES
  MEASURE values BY <<

  occ(element: elt, values: forest): RECURSIVE int =
    CASES values OF
      FNil:
        0,
      FCons(root, children, rank, siblings):
        (IF element = root THEN 1 ELSE 0 ENDIF)
          + occ(element, children)
          + occ(element, siblings)
    ENDCASES
  MEASURE values BY <<

  forest_mem(element: elt, values: forest): bool =
    0 < occ(element, values)

  has_order(expected_rank: int, values: forest): RECURSIVE bool =
    CASES values OF
      FNil:
        expected_rank = 0,
      FCons(element, children, rank, siblings):
        rank = expected_rank - 1
          AND has_order(expected_rank - 1, children)
          AND has_order(expected_rank - 1, siblings)
    ENDCASES
  MEASURE values BY <<

  binomial_tree(children: forest, rank: int): bool =
    rank = forest_length(children)
      AND has_order(rank, children)

  inv(minimum_rank: int, values: forest): RECURSIVE bool =
    CASES values OF
      FNil:
        TRUE,
      FCons(element, children, rank, siblings):
        minimum_rank <= rank
          AND binomial_tree(children, rank)
          AND inv(rank + 1, siblings)
    ENDCASES
  MEASURE values BY <<

  link_tree(
      leq: [elt, elt -> bool],
      left_element: elt,
      left_children: forest,
      left_rank: int,
      right_element: elt,
      right_children: forest,
      right_rank: int): forest =
    IF leq(left_element, right_element) THEN
      singleton_tree(
        left_element,
        FCons(
          right_element, right_children, right_rank, left_children),
        left_rank + 1)
    ELSE
      singleton_tree(
        right_element,
        FCons(
          left_element, left_children, left_rank, right_children),
        right_rank + 1)
    ENDIF

  extract_min_vc: bool =
    FORALL
        (leq: [elt, elt -> bool]),
        (h: forest):
      (preorder_laws(leq)
        AND heaps(leq, h)
        AND inv(0, h)
        AND NOT FNil?(h))
      IMPLIES
        (heaps(leq, h)
          AND inv(0, h)
          AND NOT FNil?(h)
          AND
            (FORALL
                (selected_element: elt),
                (selected_children: forest),
                (selected_rank: int),
                (remainder: forest):
              (heaps(
                  leq,
                  singleton_tree(
                    selected_element,
                    selected_children,
                    selected_rank))
                AND heaps(leq, remainder)
                AND inv(0, remainder)
                AND le_roots(leq, selected_element, h)
                AND binomial_tree(
                      selected_children,
                      selected_rank)
                AND
                  (FORALL (x: elt):
                    occ(x, h)
                      = occ(
                          x,
                          singleton_tree(
                            selected_element,
                            selected_children,
                            selected_rank))
                        + occ(x, remainder)))
              IMPLIES
                ((heaps(
                    leq,
                    forest_reverse(selected_children))
                    AND inv(
                          0,
                          forest_reverse(selected_children))
                    AND heaps(leq, remainder)
                    AND inv(0, remainder))
                  AND
                    (FORALL (combined: forest):
                      (heaps(leq, combined)
                        AND inv(0, combined)
                        AND
                          (FORALL (x: elt):
                            occ(x, combined)
                              = occ(
                                  x,
                                  forest_reverse(
                                    selected_children))
                                + occ(x, remainder)))
                      IMPLIES
                        (heaps(leq, combined)
                          AND inv(0, combined)
                          AND
                            occ(selected_element, combined)
                              = occ(selected_element, h) - 1
                          AND
                            (FORALL (x: elt):
                              NOT x = selected_element
                              IMPLIES
                                occ(x, combined)
                                  = occ(x, h)))))))

END binomial_heap_BinomialHeap_extract_minqtvc
