% Statement-only formalization of the NTP4VC corpus artifact
% pearl/leftist_heap_LeftistHeap_is_emptyqtvc: the verification condition
% equating a ranked binary tree's Boolean emptiness result with its recursive
% integer size being zero. This file contains no proof.

leftist_heap_LeftistHeap_is_emptyqtvc[
  elt: TYPE+
]: THEORY
BEGIN

  tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      stored_rank: int,
      left_subtree: tree,
      root_element: elt,
      right_subtree: tree): Node?
  END tree

  tree_size(values: tree): RECURSIVE int =
    CASES values OF
      Empty:
        0,
      Node(rank_value, left, root, right):
        1 + tree_size(left) + tree_size(right)
    ENDCASES
  MEASURE values BY <<

  is_empty_vc: bool =
    FORALL (h: tree), (result: bool):
      (CASES h OF
        Empty:
          result = TRUE,
        Node(rank_value, left, root, right):
          result = FALSE
      ENDCASES)
      IMPLIES
        ((result = TRUE) <=> tree_size(h) = 0)

END leftist_heap_LeftistHeap_is_emptyqtvc
