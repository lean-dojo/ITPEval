% Statement-only formalization of the NTP4VC corpus artifact
% pearl/word_common_factor_Top_powerqtvc: the recursive integer-power
% termination condition stating that subtracting one from a nonzero
% nonnegative exponent yields a nonnegative, strictly smaller exponent.
% This file contains no proof.

word_common_factor_Top_powerqtvc: THEORY
BEGIN

  power_vc: bool =
    FORALL (n: int):
      0 <= n IMPLIES
        n /= 0 IMPLIES
          LET o1: int = n - 1
          IN
            ((0 <= n AND o1 < n) AND 0 <= o1)

END word_common_factor_Top_powerqtvc
