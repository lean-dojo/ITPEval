% Statement-only formalization of the NTP4VC corpus artifact
% pearl/tree_of_list_TreeOfList_tree_of_listqtvc: the verification condition
% for constructing a logarithmic-height binary tree from a list while
% preserving inorder traversal and size. This file contains no proof.

tree_of_list_TreeOfList_tree_of_listqtvc[
  Elt: TYPE+
]: THEORY
BEGIN

  tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      left_subtree: tree,
      root_element: Elt,
      right_subtree: tree): Node?
  END tree

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  int_max(left, right: int): int =
    IF left <= right THEN right ELSE left ENDIF

  tree_size(values: tree): RECURSIVE int =
    CASES values OF
      Empty:
        0,
      Node(left, root, right):
        1 + tree_size(left) + tree_size(right)
    ENDCASES
  MEASURE values BY <<

  tree_height(values: tree): RECURSIVE int =
    CASES values OF
      Empty:
        0,
      Node(left, root, right):
        1 + int_max(tree_height(left), tree_height(right))
    ENDCASES
  MEASURE values BY <<

  inorder(values: tree): RECURSIVE list[Elt] =
    CASES values OF
      Empty:
        null,
      Node(left, root, right):
        append(inorder(left), cons(root, inorder(right)))
    ENDCASES
  MEASURE values BY <<

  height_bounds(values: tree, count: int): bool =
    LET h: int = tree_height(values)
    IN
      int_power(2, h - 1) <= count
        AND count < int_power(2, h)

  tree_of_list_vc: bool =
    FORALL (input: list[Elt]):
      LET o1: int = length(input)
      IN
        (0 <= o1 AND o1 <= length(input))
          AND
        (FORALL
            (result_tree: tree),
            (suffix: list[Elt]):
          (append(inorder(result_tree), suffix) = input
            AND tree_size(result_tree) = o1
            AND
              (0 < o1
                IMPLIES height_bounds(result_tree, o1)))
            IMPLIES
              inorder(result_tree) = input
                AND
              (0 < tree_size(result_tree)
                IMPLIES
                  height_bounds(
                    result_tree,
                    tree_size(result_tree))))

END tree_of_list_TreeOfList_tree_of_listqtvc
