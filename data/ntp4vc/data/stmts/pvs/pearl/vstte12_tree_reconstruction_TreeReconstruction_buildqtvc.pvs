% Statement-only formalization of the NTP4VC corpus artifact
% pearl/vstte12_tree_reconstruction_TreeReconstruction_buildqtvc: the
% verification condition for building a finite binary tree from its
% left-to-right list of leaf depths, including success and failure outcomes.
% This file contains no proof.

vstte12_tree_reconstruction_TreeReconstruction_buildqtvc: THEORY
BEGIN

  tree: DATATYPE
  BEGIN
    Leaf: Leaf?
    Node(left_subtree, right_subtree: tree): Node?
  END tree

  depths(root_depth: int, value: tree): RECURSIVE list[int] =
    CASES value OF
      Leaf:
        cons(root_depth, null[int]),
      Node(left, right):
        append(
          depths(root_depth + 1, left),
          depths(root_depth + 1, right))
    ENDCASES
  MEASURE value BY <<

  build_vc(s1: list[int]): bool =
    (FORALL (value: tree), (suffix: list[int]):
      s1 = append(depths(0, value), suffix)
        IMPLIES
          CASES suffix OF
            null:
              depths(0, value) = s1,
            cons(head, tail):
              FORALL (other: tree):
                depths(0, other) /= s1
          ENDCASES)
    AND
      ((FORALL (value: tree), (suffix: list[int]):
          append(depths(0, value), suffix) /= s1)
        IMPLIES
          (FORALL (value: tree):
            depths(0, value) /= s1))

END vstte12_tree_reconstruction_TreeReconstruction_buildqtvc
