% Statement-only formalization of the NTP4VC corpus artifact
% pearl/bitcount_AsciiCode_asciiqtvc: the 32-bit ASCII parity verification
% condition that inserts the population-count parity in the high bit while
% preserving the lower 31 bits. This file contains no proof.

bitcount_AsciiCode_asciiqtvc: THEORY
BEGIN

  bit_index: DATATYPE
  BEGIN
    Bit0: Bit0?
    Bit1: Bit1?
    Bit2: Bit2?
    Bit3: Bit3?
    Bit4: Bit4?
    Bit5: Bit5?
    Bit6: Bit6?
    Bit7: Bit7?
    Bit8: Bit8?
    Bit9: Bit9?
    Bit10: Bit10?
    Bit11: Bit11?
    Bit12: Bit12?
    Bit13: Bit13?
    Bit14: Bit14?
    Bit15: Bit15?
    Bit16: Bit16?
    Bit17: Bit17?
    Bit18: Bit18?
    Bit19: Bit19?
    Bit20: Bit20?
    Bit21: Bit21?
    Bit22: Bit22?
    Bit23: Bit23?
    Bit24: Bit24?
    Bit25: Bit25?
    Bit26: Bit26?
    Bit27: Bit27?
    Bit28: Bit28?
    Bit29: Bit29?
    Bit30: Bit30?
    Bit31: Bit31?
  END bit_index

  word32: TYPE = [bit_index -> bool]

  bit_as_int(value: bool): int =
    IF value THEN 1 ELSE 0 ENDIF

  unsigned(value: word32): int =
      bit_as_int(value(Bit0))
    + 2 * bit_as_int(value(Bit1))
    + 4 * bit_as_int(value(Bit2))
    + 8 * bit_as_int(value(Bit3))
    + 16 * bit_as_int(value(Bit4))
    + 32 * bit_as_int(value(Bit5))
    + 64 * bit_as_int(value(Bit6))
    + 128 * bit_as_int(value(Bit7))
    + 256 * bit_as_int(value(Bit8))
    + 512 * bit_as_int(value(Bit9))
    + 1024 * bit_as_int(value(Bit10))
    + 2048 * bit_as_int(value(Bit11))
    + 4096 * bit_as_int(value(Bit12))
    + 8192 * bit_as_int(value(Bit13))
    + 16384 * bit_as_int(value(Bit14))
    + 32768 * bit_as_int(value(Bit15))
    + 65536 * bit_as_int(value(Bit16))
    + 131072 * bit_as_int(value(Bit17))
    + 262144 * bit_as_int(value(Bit18))
    + 524288 * bit_as_int(value(Bit19))
    + 1048576 * bit_as_int(value(Bit20))
    + 2097152 * bit_as_int(value(Bit21))
    + 4194304 * bit_as_int(value(Bit22))
    + 8388608 * bit_as_int(value(Bit23))
    + 16777216 * bit_as_int(value(Bit24))
    + 33554432 * bit_as_int(value(Bit25))
    + 67108864 * bit_as_int(value(Bit26))
    + 134217728 * bit_as_int(value(Bit27))
    + 268435456 * bit_as_int(value(Bit28))
    + 536870912 * bit_as_int(value(Bit29))
    + 1073741824 * bit_as_int(value(Bit30))
    + 2147483648 * bit_as_int(value(Bit31))

  count_logic(value: word32): int =
      bit_as_int(value(Bit0))
    + bit_as_int(value(Bit1))
    + bit_as_int(value(Bit2))
    + bit_as_int(value(Bit3))
    + bit_as_int(value(Bit4))
    + bit_as_int(value(Bit5))
    + bit_as_int(value(Bit6))
    + bit_as_int(value(Bit7))
    + bit_as_int(value(Bit8))
    + bit_as_int(value(Bit9))
    + bit_as_int(value(Bit10))
    + bit_as_int(value(Bit11))
    + bit_as_int(value(Bit12))
    + bit_as_int(value(Bit13))
    + bit_as_int(value(Bit14))
    + bit_as_int(value(Bit15))
    + bit_as_int(value(Bit16))
    + bit_as_int(value(Bit17))
    + bit_as_int(value(Bit18))
    + bit_as_int(value(Bit19))
    + bit_as_int(value(Bit20))
    + bit_as_int(value(Bit21))
    + bit_as_int(value(Bit22))
    + bit_as_int(value(Bit23))
    + bit_as_int(value(Bit24))
    + bit_as_int(value(Bit25))
    + bit_as_int(value(Bit26))
    + bit_as_int(value(Bit27))
    + bit_as_int(value(Bit28))
    + bit_as_int(value(Bit29))
    + bit_as_int(value(Bit30))
    + bit_as_int(value(Bit31))

  shift_left_31(value: word32): word32 =
    LAMBDA (i: bit_index):
      i = Bit31 AND value(Bit0)

  bitwise_or(left, right: word32): word32 =
    LAMBDA (i: bit_index):
      left(i) OR right(i)

  equal_low_31(left, right: word32): bool =
    FORALL (i: bit_index):
      i /= Bit31 IMPLIES left(i) = right(i)

  valid_ascii(value: word32): bool =
    EXISTS (k: int): count_logic(value) = 2 * k

  ascii_vc: bool =
    FORALL (b, c: word32):
      (NOT b(Bit31)
        AND unsigned(c) = count_logic(b))
      IMPLIES
        ((31 < 32 OR 31 < 32)
          AND
            LET maskbit: word32 = shift_left_31(c)
            IN
              maskbit = shift_left_31(c)
                IMPLIES
                  LET code: word32 = bitwise_or(b, maskbit)
                  IN
                    equal_low_31(code, b)
                      AND valid_ascii(code))

END bitcount_AsciiCode_asciiqtvc
