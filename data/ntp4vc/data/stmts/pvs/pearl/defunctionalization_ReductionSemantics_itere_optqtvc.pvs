% Statement-only formalization of the NTP4VC corpus artifact
% pearl/defunctionalization_ReductionSemantics_itere_optqtvc: the reduction
% semantics verification condition preserves redex evaluation under
% recomposition and returns the direct value in an empty context. This file
% contains no proof.

defunctionalization_ReductionSemantics_itere_optqtvc: THEORY
BEGIN

  expr: DATATYPE
  BEGIN
    Cte(constant_value: int): Cte?
    Sub(left_expression, right_expression: expr): Sub?
  END expr

  context: DATATYPE
  BEGIN
    Empty: Empty?
    Left(previous_context: context, pending_expression: expr): Left?
    Right(saved_value: int, previous_context: context): Right?
  END context

  eval_0(expression: expr): RECURSIVE int =
    CASES expression OF
      Cte(value):
        value,
      Sub(left, right):
        eval_0(left) - eval_0(right)
    ENDCASES
  MEASURE expression BY <<

  size_e(expression: expr): RECURSIVE int =
    CASES expression OF
      Cte(value):
        1,
      Sub(left, right):
        3 + size_e(left) + size_e(right)
    ENDCASES
  MEASURE expression BY <<

  recompose(
      current_context: context,
      expression: expr): RECURSIVE expr =
    CASES current_context OF
      Empty:
        expression,
      Left(previous, right):
        recompose(previous, Sub(expression, right)),
      Right(left_value, previous):
        recompose(previous, Sub(Cte(left_value), expression))
    ENDCASES
  MEASURE current_context BY <<

  is_a_redex(expression: expr): bool =
    CASES expression OF
      Cte(value):
        FALSE,
      Sub(left, right):
        Cte?(left) AND Cte?(right)
    ENDCASES

  is_a_value(expression: expr): bool =
    CASES expression OF
      Cte(value):
        TRUE,
      Sub(left, right):
        FALSE
    ENDCASES

  is_empty_context(current_context: context): bool =
    CASES current_context OF
      Empty:
        TRUE,
      Left(previous, expression):
        FALSE,
      Right(value, previous):
        FALSE
    ENDCASES

  size_c(current_context: context): RECURSIVE int =
    CASES current_context OF
      Empty:
        0,
      Left(previous, expression):
        2 + size_c(previous) + size_e(expression),
      Right(value, previous):
        1 + size_c(previous)
    ENDCASES
  MEASURE current_context BY <<

  itere_opt_vc: bool =
    FORALL (initial_context: context), (expression: expr):
      ((FORALL (decomposition_context: context), (redex: expr):
          (recompose(decomposition_context, redex)
              = recompose(initial_context, expression)
            AND is_a_redex(redex))
            IMPLIES
          (is_a_redex(redex)
            AND
          (FORALL (replacement: expr):
            eval_0(replacement) = eval_0(redex)
              IMPLIES
            eval_0(recompose(decomposition_context, replacement))
              = eval_0(recompose(initial_context, expression)))))
        AND
      ((is_empty_context(initial_context) AND is_a_value(expression))
        IMPLIES
      ((CASES expression OF
          Cte(value):
            TRUE,
          Sub(left, right):
            FALSE
        ENDCASES)
        AND
      (FORALL (result: int):
        (CASES expression OF
          Cte(value):
            result = value,
          Sub(left, right):
            FALSE
        ENDCASES)
          IMPLIES
        result = eval_0(recompose(initial_context, expression))))))

END defunctionalization_ReductionSemantics_itere_optqtvc
