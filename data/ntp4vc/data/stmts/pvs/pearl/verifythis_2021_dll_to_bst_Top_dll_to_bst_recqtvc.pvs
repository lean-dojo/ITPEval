% Statement-only formalization of the NTP4VC corpus artifact
% pearl/verifythis_2021_dll_to_bst_Top_dll_to_bst_recqtvc: the recursive
% verification condition for converting a well-formed doubly linked list
% segment into a balanced binary search tree while preserving map domains
% and cells outside the segment. This file contains no proof.

verifythis_2021_dll_to_bst_Top_dll_to_bst_recqtvc[
  loc: TYPE+,
  loc_default: loc,
  null_loc: loc,
  map_container: TYPE+
]: THEORY
BEGIN

  IMPORTING finite_sets[loc]

  loc_map: TYPE =
    [# map_domain: finite_set[loc],
       map_contents: [loc -> loc] #]

  index_tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      left_subtree: index_tree,
      node_index: int,
      right_subtree: index_tree): Node?
  END index_tree

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_loc_nat(
      values: list[loc],
      index: nat): RECURSIVE loc =
    CASES values OF
      null:
        loc_default,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_loc_nat(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  nth_loc(values: list[loc], index: int): loc =
    nth_loc_nat(values, int_to_nat(index))

  int_max(left, right: int): int =
    IF left <= right THEN right ELSE left ENDIF

  tree_height(value: index_tree): RECURSIVE int =
    CASES value OF
      Empty:
        0,
      Node(left, index, right):
        1 + int_max(tree_height(left), tree_height(right))
    ENDCASES
  MEASURE value BY <<

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  trunc_div(numerator, denominator: int): int =
    IF denominator = 0 THEN
      0
    ELSIF numerator * denominator >= 0 THEN
      floor((numerator :: real) / (denominator :: real))
    ELSE
      -floor(-((numerator :: real) / (denominator :: real)))
    ENDIF

  valid(
      prev_map, next_map: loc_map,
      values: list[loc]): bool =
    FORALL (i: int):
      (0 <= i AND i < length(values))
        IMPLIES
          nth_loc(values, i) /= null_loc
            AND map_domain(prev_map)(nth_loc(values, i))
            AND map_domain(next_map)(nth_loc(values, i))
            AND
              (FORALL (j: int):
                (i < j AND j < length(values))
                  IMPLIES
                    nth_loc(values, i) /= nth_loc(values, j))

  dll(
      prev_map, next_map: loc_map,
      values: list[loc],
      head: loc,
      lo, hi: int): bool =
    valid(prev_map, next_map, values)
      AND (0 <= lo AND lo <= hi AND hi <= length(values))
      AND
        head =
          (IF lo = length(values) THEN
             null_loc
           ELSE
             nth_loc(values, lo)
           ENDIF)
      AND
        (FORALL (i: int):
          (lo <= i AND i < hi - 1)
            IMPLIES
              map_contents(next_map)(nth_loc(values, i))
                = nth_loc(values, i + 1))
      AND
        (FORALL (i: int):
          (lo < i AND i < hi)
            IMPLIES
              map_contents(prev_map)(nth_loc(values, i))
                = nth_loc(values, i - 1))
      AND
        (lo < hi
          IMPLIES
            map_contents(next_map)(nth_loc(values, hi - 1))
              =
                (IF hi = length(values) THEN
                   null_loc
                 ELSE
                   nth_loc(values, hi)
                 ENDIF))
      AND
        (lo < hi
          IMPLIES
            map_contents(prev_map)(nth_loc(values, lo))
              =
                (IF lo = 0 THEN
                   null_loc
                 ELSE
                   nth_loc(values, lo - 1)
                 ENDIF))

  tree_relation(
      prev_map, next_map: loc_map,
      values: list[loc],
      root: loc,
      value: index_tree,
      lo, hi: int): RECURSIVE bool =
    valid(prev_map, next_map, values)
      AND (0 <= lo AND lo <= hi AND hi <= length(values))
      AND
        CASES value OF
          Empty:
            root = null_loc AND lo = hi,
          Node(left, index, right):
            (lo <= index AND index < hi)
              AND root = nth_loc(values, index)
              AND
                tree_relation(
                  prev_map,
                  next_map,
                  values,
                  map_contents(prev_map)(root),
                  left,
                  lo,
                  index)
              AND
                tree_relation(
                  prev_map,
                  next_map,
                  values,
                  map_contents(next_map)(root),
                  right,
                  index + 1,
                  hi)
        ENDCASES
  MEASURE value BY <<

  height_bound(value: index_tree, count: int): bool =
    LET h: int = tree_height(value)
    IN
      int_power(2, h - 1) <= count
        AND count < int_power(2, h)

  boundary_location(values: list[loc], index: int): loc =
    IF index = length(values) THEN
      null_loc
    ELSE
      nth_loc(values, index)
    ENDIF

  same_domain(left, right: loc_map): bool =
    map_domain(left) = map_domain(right)

  unchanged_outside(
      current, original: loc_map,
      values: list[loc],
      lo, hi: int): bool =
    (FORALL (i: int):
      (0 <= i AND i < lo)
        IMPLIES
          map_contents(current)(nth_loc(values, i))
            = map_contents(original)(nth_loc(values, i)))
      AND
        (FORALL (i: int):
          (hi <= i AND i < length(values))
            IMPLIES
              map_contents(current)(nth_loc(values, i))
                = map_contents(original)(nth_loc(values, i)))

  map_update_relation(
      updated, original: loc_map,
      key, value: loc): bool =
    (FORALL (point: loc):
      map_domain(updated)(point)
        IFF (point = key OR map_domain(original)(point)))
      AND
        (FORALL (point: loc):
          map_contents(updated)(point)
            =
              (IF point = key THEN
                 value
               ELSE
                 map_contents(original)(point)
               ENDIF))

  recursive_postconditions(
      to_fmap: [map_container -> loc_map],
      current_prev, current_next: map_container,
      original_prev, original_next: map_container,
      values: list[loc],
      root: loc,
      value: index_tree,
      lo, hi, count: int): bool =
    tree_relation(
      to_fmap(current_prev),
      to_fmap(current_next),
      values,
      root,
      value,
      lo,
      hi)
      AND
        same_domain(
          to_fmap(current_prev),
          to_fmap(original_prev))
      AND
        same_domain(
          to_fmap(current_next),
          to_fmap(original_next))
      AND
        unchanged_outside(
          to_fmap(current_prev),
          to_fmap(original_prev),
          values,
          lo,
          hi)
      AND
        unchanged_outside(
          to_fmap(current_next),
          to_fmap(original_next),
          values,
          lo,
          hi)
      AND (0 < count IMPLIES height_bound(value, count))

  dll_to_bst_rec_vc: bool =
    FORALL
      (to_fmap: [map_container -> loc_map]),
      (prev_table, next_table: map_container),
      (values: list[loc]),
      (head: loc),
      (ihead, n: int):
      dll(
        to_fmap(prev_table),
        to_fmap(next_table),
        values,
        head,
        ihead,
        ihead + n)
        IMPLIES
          IF n = 0 THEN
            head = boundary_location(values, ihead + n)
              AND
                tree_relation(
                  to_fmap(prev_table),
                  to_fmap(next_table),
                  values,
                  null_loc,
                  Empty,
                  ihead,
                  ihead + n)
              AND
                same_domain(
                  to_fmap(prev_table),
                  to_fmap(prev_table))
              AND
                same_domain(
                  to_fmap(next_table),
                  to_fmap(next_table))
              AND (0 < n IMPLIES height_bound(Empty, n))
          ELSE
            2 /= 0
              AND
                (LET nl: int = trunc_div(n, 2)
                 IN
                   ((0 <= n AND nl < n)
                     AND
                       dll(
                         to_fmap(prev_table),
                         to_fmap(next_table),
                         values,
                         head,
                         ihead,
                         ihead + nl))
                   AND
                     (FORALL
                       (next1, prev1: map_container),
                       (left1: loc),
                       (left_tree: index_tree):
                       recursive_postconditions(
                         to_fmap,
                         prev1,
                         next1,
                         prev_table,
                         next_table,
                         values,
                         left1,
                         left_tree,
                         ihead,
                         ihead + nl,
                         nl)
                         IMPLIES
                           map_domain(to_fmap(prev1))(
                             boundary_location(values, ihead + nl))
                           AND
                             (FORALL (prev2: map_container):
                               map_update_relation(
                                 to_fmap(prev2),
                                 to_fmap(prev1),
                                 boundary_location(values, ihead + nl),
                                 left1)
                                 IMPLIES
                                   (LET
                                      right_count: int = n - nl - 1,
                                      right_lo: int = ihead + nl + 1
                                    IN
                                      map_domain(to_fmap(next1))(
                                        boundary_location(
                                          values,
                                          ihead + nl))
                                      AND
                                        (LET right_head: loc =
                                           map_contents(to_fmap(next1))(
                                             boundary_location(
                                               values,
                                               ihead + nl))
                                         IN
                                           right_head
                                             =
                                               map_contents(
                                                 to_fmap(next1))(
                                                 boundary_location(
                                                   values,
                                                   ihead + nl))
                                           IMPLIES
                                             ((0 <= n
                                                 AND right_count < n)
                                               AND
                                                 dll(
                                                   to_fmap(prev2),
                                                   to_fmap(next1),
                                                   values,
                                                   right_head,
                                                   right_lo,
                                                   right_lo
                                                     + right_count))
                                             AND
                                               (FORALL
                                                 (next2,
                                                  prev3: map_container),
                                                 (right_root: loc),
                                                 (right_tree: index_tree):
                                                 recursive_postconditions(
                                                   to_fmap,
                                                   prev3,
                                                   next2,
                                                   prev2,
                                                   next1,
                                                   values,
                                                   right_root,
                                                   right_tree,
                                                   right_lo,
                                                   right_lo
                                                     + right_count,
                                                   right_count)
                                                   IMPLIES
                                                     map_domain(
                                                       to_fmap(next2))(
                                                       boundary_location(
                                                         values,
                                                         ihead + nl))
                                                     AND
                                                       (FORALL
                                                         (next3:
                                                            map_container):
                                                         map_update_relation(
                                                           to_fmap(next3),
                                                           to_fmap(next2),
                                                           boundary_location(
                                                             values,
                                                             ihead + nl),
                                                           right_root)
                                                           IMPLIES
                                                             (LET
                                                                whole_tree:
                                                                  index_tree =
                                                                  Node(
                                                                    left_tree,
                                                                    ihead + nl,
                                                                    right_tree)
                                                              IN
                                                                boundary_location(
                                                                  values,
                                                                  right_lo
                                                                    + right_count)
                                                                  =
                                                                    boundary_location(
                                                                      values,
                                                                      ihead + n)
                                                                AND
                                                                  recursive_postconditions(
                                                                    to_fmap,
                                                                    prev3,
                                                                    next3,
                                                                    prev_table,
                                                                    next_table,
                                                                    values,
                                                                    boundary_location(
                                                                      values,
                                                                      ihead
                                                                        + nl),
                                                                    whole_tree,
                                                                    ihead,
                                                                    ihead + n,
                                                                    n)))))))))
          ENDIF

END verifythis_2021_dll_to_bst_Top_dll_to_bst_recqtvc
