% Statement-only formalization of the NTP4VC corpus artifact
% pearl/vstte12_tree_reconstruction_Harness_harness2qtvc: no finite binary
% tree has left-to-right leaf-depth sequence [1, 3, 2, 2] when its root is
% at depth zero. This file contains no proof.

vstte12_tree_reconstruction_Harness_harness2qtvc: THEORY
BEGIN

  tree: DATATYPE
  BEGIN
    Leaf: Leaf?
    Node(left: tree, right: tree): Node?
  END tree

  depths(d: int, value: tree): RECURSIVE list[int] =
    CASES value OF
      Leaf:
        cons(d, null[int]),
      Node(left_tree, right_tree):
        append(
          depths(d + 1, left_tree),
          depths(d + 1, right_tree))
    ENDCASES
  MEASURE value BY <<

  harness2_vc: bool =
    FORALL (x: tree):
      depths(0, x)
        /= cons(
             1,
             cons(
               3,
               cons(
                 2,
                 cons(2, null[int]))))

END vstte12_tree_reconstruction_Harness_harness2qtvc
