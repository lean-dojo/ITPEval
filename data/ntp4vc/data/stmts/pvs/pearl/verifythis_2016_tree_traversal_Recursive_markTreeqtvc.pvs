% Statement-only formalization of the NTP4VC corpus artifact
% pearl/verifythis_2016_tree_traversal_Recursive_markTreeqtvc: the recursive
% verification condition for Morris-style binary-tree marking, including
% pointer rotations, recursive subtree returns, and final restoration and
% marking properties. This file contains no proof.

verifythis_2016_tree_traversal_Recursive_markTreeqtvc[
  loc: TYPE+,
  null_loc: loc
]: THEORY
BEGIN

  kind: DATATYPE
  BEGIN
    Parent: Parent?
    Left: Left?
    Right: Right?
  END kind

  phase: DATATYPE
  BEGIN
    GoLeft: GoLeft?
    GoRight: GoRight?
    GoBack: GoBack?
    Finish: Finish?
  END phase

  pointer_row: TYPE = [loc -> loc]
  pointer_memory: TYPE = [kind -> pointer_row]
  mark_memory: TYPE = [loc -> bool]

  memory: TYPE =
    [# accessor: pointer_memory,
       mark: mark_memory #]

  tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      left_tree: tree,
      node_location: loc,
      right_tree: tree): Node?
  END tree

  update_marks(
      old_marks: mark_memory,
      point: loc,
      value: bool): mark_memory =
    old_marks WITH [(point) := value]

  update_pointers(
      old_pointers: pointer_memory,
      field: kind,
      point, value: loc): pointer_memory =
    old_pointers WITH
      [(field) := old_pointers(field) WITH [(point) := value]]

  is_tree(
      ptrs: pointer_memory,
      t: tree,
      current, parent_node: loc): RECURSIVE bool =
    CASES t OF
      Empty:
        current = null_loc,
      Node(left, root, right):
        current /= null_loc
          AND current = root
          AND ptrs(Parent)(current) = parent_node
          AND
            (LET left_child: loc = ptrs(Left)(current),
                 right_child: loc = ptrs(Right)(current)
             IN
               ((left_child = null_loc)
                  IFF (right_child = null_loc))
               AND is_tree(ptrs, left, left_child, current)
               AND is_tree(ptrs, right, right_child, current))
    ENDCASES
  MEASURE t BY <<

  in_footprint(node: loc, t: tree): RECURSIVE bool =
    CASES t OF
      Empty:
        FALSE,
      Node(left, root, right):
        node = root
          OR in_footprint(node, left)
          OR in_footprint(node, right)
    ENDCASES
  MEASURE t BY <<

  ext(
      t: tree,
      first, second: pointer_memory): bool =
    FORALL (field: kind), (node: loc):
      in_footprint(node, t)
        IMPLIES first(field)(node) = second(field)(node)

  unchanged(first, second: pointer_memory): bool =
    FORALL (field: kind), (node: loc):
      first(field)(node) = second(field)(node)

  was_marked(
      t: tree,
      old_marks, new_marks: mark_memory): bool =
    (FORALL (node: loc):
      in_footprint(node, t)
        IMPLIES new_marks(node) = TRUE)
    AND
      (FORALL (node: loc):
        NOT in_footprint(node, t)
          IMPLIES new_marks(node) = old_marks(node))

  next_phase(ph: phase): phase =
    CASES ph OF
      GoLeft:
        GoRight,
      GoRight:
        GoBack,
      GoBack:
        GoLeft,
      Finish:
        Finish
    ENDCASES

  rotated(
      first, second: pointer_memory,
      ph: phase,
      current: loc): bool =
    (FORALL (field: kind), (node: loc):
      node /= current
        IMPLIES first(field)(node) = second(field)(node))
    AND (ph /= Finish IMPLIES current /= null_loc)
    AND
      CASES ph OF
        GoLeft:
          unchanged(first, second),
        GoRight:
          second(Left)(current) = first(Right)(current)
            AND second(Right)(current) = first(Parent)(current)
            AND second(Parent)(current) = first(Left)(current),
        GoBack:
          first(Left)(current) = second(Right)(current)
            AND first(Right)(current) = second(Parent)(current)
            AND first(Parent)(current) = second(Left)(current),
        Finish:
          current = null_loc
      ENDCASES

  children_null(ptrs: pointer_memory, current: loc): bool =
    ptrs(Left)(current) = null_loc
      AND null_loc = ptrs(Right)(current)

  single_mark_update(
      old_memory, new_memory: memory,
      current: loc): bool =
    mark(new_memory)(current) = TRUE
      AND
        (FORALL (node: loc):
          node /= current
            IMPLIES
              mark(new_memory)(node) = mark(old_memory)(node))

  bloc_result(
      initial_pointers: pointer_memory,
      old_memory, new_memory: memory,
      ph: phase,
      current: loc): bool =
    single_mark_update(old_memory, new_memory, current)
      AND
        (IF children_null(accessor(old_memory), current) THEN
           accessor(new_memory) = accessor(old_memory)
         ELSE
           rotated(
             initial_pointers,
             accessor(new_memory),
             next_phase(ph),
             current)
         ENDIF)

  entered_guard(
      entered: bool,
      current: loc,
      result: bool): bool =
    IF entered = TRUE THEN
      result =
        (IF current = null_loc THEN TRUE ELSE FALSE ENDIF)
    ELSE
      result = FALSE
    ENDIF

  children_guard(
      ptrs: pointer_memory,
      current: loc,
      result: bool): bool =
    IF ptrs(Left)(current) = null_loc THEN
      result =
        (IF ptrs(Right)(current) = null_loc
         THEN TRUE
         ELSE FALSE
         ENDIF)
    ELSE
      result = FALSE
    ENDIF

  completed_bloc_post(
      initial_pointers: pointer_memory,
      old_memory, new_memory: memory,
      ph: phase,
      current: loc): bool =
    ph /= Finish
      AND bloc_result(
            initial_pointers,
            old_memory,
            new_memory,
            ph,
            current)

  nonleaf_update_obligation(
      initial_pointers: pointer_memory,
      old_memory, marked_memory: memory,
      ph: phase,
      current: loc): bool =
    current /= null_loc
      AND current /= null_loc
      AND
        (LET left_field: kind = Left
         IN
           current /= null_loc
             AND
               (FORALL (left_updated: memory):
                 mark(left_updated) = mark(marked_memory)
                   IMPLIES
                     accessor(left_updated) =
                       update_pointers(
                         accessor(marked_memory),
                         left_field,
                         current,
                         accessor(marked_memory)(Right)(current))
                   IMPLIES
                     current /= null_loc
                       AND
                         (LET right_field: kind = Right
                          IN
                            current /= null_loc
                              AND
                                (FORALL (right_updated: memory):
                                  mark(right_updated) = mark(left_updated)
                                    IMPLIES
                                      accessor(right_updated) =
                                        update_pointers(
                                          accessor(left_updated),
                                          right_field,
                                          current,
                                          accessor(left_updated)(Parent)
                                            (current))
                                    IMPLIES
                                      (LET parent_field: kind = Parent
                                       IN
                                         current /= null_loc
                                           AND
                                             (FORALL
                                                (fully_updated: memory):
                                               mark(fully_updated) =
                                                 mark(right_updated)
                                                 IMPLIES
                                                   accessor(fully_updated) =
                                                     update_pointers(
                                                       accessor(
                                                         right_updated),
                                                       parent_field,
                                                       current,
                                                       accessor(
                                                         marked_memory)
                                                         (Left)(current))
                                                 IMPLIES
                                                   accessor(marked_memory)
                                                       (Left)(current)
                                                     =
                                                       accessor(fully_updated)
                                                         (Parent)(current)
                                                   AND
                                                     completed_bloc_post(
                                                       initial_pointers,
                                                       old_memory,
                                                       fully_updated,
                                                       ph,
                                                       current)))))))

  bloc_obligation: bool =
    FORALL
      (entered: bool),
      (current: loc),
      (current_memory: memory),
      (initial_pointers: pointer_memory),
      (ph: phase):
      (rotated(
         initial_pointers,
         accessor(current_memory),
         ph,
         current)
        AND
          (ph = Finish IMPLIES entered = TRUE))
      IMPLIES
        (FORALL (guard_result: bool):
          entered_guard(entered, current, guard_result)
            IMPLIES
              (IF guard_result = TRUE THEN
                 ph = Finish
               ELSE
                 current /= null_loc
                   AND
                     (FORALL (marked_memory: memory):
                       accessor(marked_memory) =
                         accessor(current_memory)
                         IMPLIES
                           mark(marked_memory) =
                             update_marks(
                               mark(current_memory),
                               current,
                               TRUE)
                           IMPLIES
                             current /= null_loc
                               AND
                                 (LET left_child: loc =
                                        accessor(marked_memory)
                                          (Left)(current)
                                  IN
                                    (left_child = null_loc
                                      IMPLIES current /= null_loc)
                                    AND
                                      (FORALL (children_are_null: bool):
                                        children_guard(
                                          accessor(marked_memory),
                                          current,
                                          children_are_null)
                                          IMPLIES
                                            (IF children_are_null = TRUE
                                             THEN
                                               current /= null_loc
                                                 AND
                                                   completed_bloc_post(
                                                     initial_pointers,
                                                     current_memory,
                                                     marked_memory,
                                                     ph,
                                                     current)
                                             ELSE
                                               nonleaf_update_obligation(
                                                 initial_pointers,
                                                 current_memory,
                                                 marked_memory,
                                                 ph,
                                                 current)
                                             ENDIF))))
               ENDIF))

  nonempty_tree(t: tree): bool =
    CASES t OF
      Empty:
        FALSE,
      Node(left, root, right):
        TRUE
    ENDCASES

  tree_parts(t, left, right: tree): bool =
    CASES t OF
      Empty:
        FALSE,
      Node(actual_left, root, actual_right):
        left = actual_left AND right = actual_right
    ENDCASES

  is_child(t, child: tree): bool =
    CASES t OF
      Empty:
        FALSE,
      Node(left, root, right):
        left = child OR right = child
    ENDCASES

  empty_children_if_null(
      left_pointer, right_pointer: loc,
      left, right: tree): bool =
    (left_pointer = null_loc AND right_pointer = null_loc)
      IMPLIES left = Empty AND right = Empty

  guard_result_obligation(
      left_pointer, right_pointer: loc,
      left, right: tree): bool =
    FORALL (result: bool):
      (IF left_pointer = null_loc THEN
         result =
           (IF right_pointer = null_loc THEN TRUE ELSE FALSE ENDIF)
       ELSE
         result = FALSE
       ENDIF)
      IMPLIES
        ((result = TRUE)
          IFF
            (left_pointer = null_loc
              AND right_pointer = null_loc))
        AND
          (result = TRUE
            IMPLIES left = Empty AND right = Empty)

  after_right_subtree(
      initial_pointers: pointer_memory,
      entry_memory, right_bloc_memory: memory,
      whole_tree, right_tree: tree,
      current, parent_node: loc): bool =
    FORALL (right_return_memory: memory):
      (unchanged(
         accessor(right_bloc_memory),
         accessor(right_return_memory))
        AND
          was_marked(
            right_tree,
            mark(right_bloc_memory),
            mark(right_return_memory)))
      IMPLIES
        rotated(
          initial_pointers,
          accessor(right_return_memory),
          GoBack,
          current)
        AND
          (FORALL (final_memory: memory):
            bloc_result(
              initial_pointers,
              right_return_memory,
              final_memory,
              GoBack,
              current)
              IMPLIES
                unchanged(
                  accessor(entry_memory),
                  accessor(final_memory))
                AND accessor(final_memory)(Parent)(current) = parent_node
                AND
                  was_marked(
                    whole_tree,
                    mark(entry_memory),
                    mark(final_memory)))

  right_subtree_obligation(
      initial_pointers: pointer_memory,
      entry_memory, left_return_memory, right_bloc_memory: memory,
      whole_tree, right_tree: tree,
      current, parent_node, right_pointer: loc): bool =
    (ext(
       right_tree,
       initial_pointers,
       accessor(right_bloc_memory))
      AND
        is_tree(
          initial_pointers,
          right_tree,
          right_pointer,
          current))
    AND
      (is_tree(
         accessor(right_bloc_memory),
         right_tree,
         right_pointer,
         current)
        IMPLIES
          is_child(whole_tree, right_tree)
            AND
              accessor(right_bloc_memory)(Parent)(current)
                /= null_loc
            AND
              is_tree(
                accessor(right_bloc_memory),
                right_tree,
                accessor(right_bloc_memory)(Parent)(current),
                current)
            AND
              after_right_subtree(
                initial_pointers,
                entry_memory,
                right_bloc_memory,
                whole_tree,
                right_tree,
                current,
                parent_node))

  after_left_subtree(
      initial_pointers: pointer_memory,
      entry_memory, first_bloc_memory: memory,
      whole_tree, right_tree: tree,
      current, parent_node, right_pointer: loc): bool =
    FORALL (left_return_memory: memory):
      (unchanged(
         accessor(first_bloc_memory),
         accessor(left_return_memory))
        AND
          was_marked(
            CASES whole_tree OF
              Empty: Empty,
              Node(left, root, right): left
            ENDCASES,
            mark(first_bloc_memory),
            mark(left_return_memory)))
      IMPLIES
        rotated(
          initial_pointers,
          accessor(left_return_memory),
          GoRight,
          current)
        AND
          (FORALL (right_bloc_memory: memory):
            bloc_result(
              initial_pointers,
              left_return_memory,
              right_bloc_memory,
              GoRight,
              current)
              IMPLIES
                right_subtree_obligation(
                  initial_pointers,
                  entry_memory,
                  left_return_memory,
                  right_bloc_memory,
                  whole_tree,
                  right_tree,
                  current,
                  parent_node,
                  right_pointer))

  left_subtree_obligation(
      initial_pointers: pointer_memory,
      entry_memory, first_bloc_memory: memory,
      whole_tree, left_tree, right_tree: tree,
      current, parent_node, left_pointer, right_pointer: loc): bool =
    (ext(
       left_tree,
       initial_pointers,
       accessor(first_bloc_memory))
      AND
        is_tree(
          initial_pointers,
          left_tree,
          left_pointer,
          current))
    AND
      (is_tree(
         accessor(first_bloc_memory),
         left_tree,
         left_pointer,
         current)
        IMPLIES
          is_child(whole_tree, left_tree)
            AND
              accessor(first_bloc_memory)(Parent)(current)
                /= null_loc
            AND
              is_tree(
                accessor(first_bloc_memory),
                left_tree,
                accessor(first_bloc_memory)(Parent)(current),
                current)
            AND
              (FORALL (left_return_memory: memory):
                (unchanged(
                   accessor(first_bloc_memory),
                   accessor(left_return_memory))
                  AND
                    was_marked(
                      left_tree,
                      mark(first_bloc_memory),
                      mark(left_return_memory)))
                IMPLIES
                  rotated(
                    initial_pointers,
                    accessor(left_return_memory),
                    GoRight,
                    current)
                  AND
                    (FORALL (right_bloc_memory: memory):
                      bloc_result(
                        initial_pointers,
                        left_return_memory,
                        right_bloc_memory,
                        GoRight,
                        current)
                        IMPLIES
                          right_subtree_obligation(
                            initial_pointers,
                            entry_memory,
                            left_return_memory,
                            right_bloc_memory,
                            whole_tree,
                            right_tree,
                            current,
                            parent_node,
                            right_pointer))))

  after_first_bloc(
      initial_pointers: pointer_memory,
      entry_memory, first_bloc_memory: memory,
      whole_tree, left_tree, right_tree: tree,
      current, parent_node, left_pointer, right_pointer: loc): bool =
    guard_result_obligation(
      left_pointer,
      right_pointer,
      left_tree,
      right_tree)
    AND
      (empty_children_if_null(
         left_pointer,
         right_pointer,
         left_tree,
         right_tree)
        IMPLIES
          (IF NOT
                (left_pointer = null_loc
                  AND right_pointer = null_loc)
           THEN
             left_subtree_obligation(
               initial_pointers,
               entry_memory,
               first_bloc_memory,
               whole_tree,
               left_tree,
               right_tree,
               current,
               parent_node,
               left_pointer,
               right_pointer)
           ELSE
             unchanged(
               accessor(entry_memory),
               accessor(first_bloc_memory))
               AND
                 accessor(first_bloc_memory)(Parent)(current)
                   = parent_node
               AND
                 was_marked(
                   whole_tree,
                   mark(entry_memory),
                   mark(first_bloc_memory))
           ENDIF))

  recursive_case(
      entry_memory: memory,
      whole_tree, left_tree, right_tree: tree,
      current, parent_node: loc): bool =
    (LET initial_pointers: pointer_memory = accessor(entry_memory),
         left_pointer: loc = accessor(entry_memory)(Left)(current),
         right_pointer: loc = accessor(entry_memory)(Right)(current)
     IN
       is_tree(
         initial_pointers,
         Node(left_tree, current, right_tree),
         current,
         parent_node)
       AND
         ((NOT in_footprint(current, left_tree)
            AND NOT in_footprint(current, right_tree))
          IMPLIES
            rotated(
              initial_pointers,
              accessor(entry_memory),
              GoLeft,
              current)
            AND
              (FORALL (first_bloc_memory: memory):
                bloc_result(
                  initial_pointers,
                  entry_memory,
                  first_bloc_memory,
                  GoLeft,
                  current)
                  IMPLIES
                    after_first_bloc(
                      initial_pointers,
                      entry_memory,
                      first_bloc_memory,
                      whole_tree,
                      left_tree,
                      right_tree,
                      current,
                      parent_node,
                      left_pointer,
                      right_pointer))))

  auxiliary_obligation: bool =
    FORALL
      (parent_node, current: loc),
      (entry_memory: memory),
      (whole_tree: tree):
      (current /= null_loc
        AND
          is_tree(
            accessor(entry_memory),
            whole_tree,
            current,
            parent_node))
      IMPLIES
        current /= null_loc
          AND
            (LET left_pointer: loc =
                   accessor(entry_memory)(Left)(current),
                 right_pointer: loc =
                   accessor(entry_memory)(Right)(current)
             IN
               current /= null_loc
                 AND nonempty_tree(whole_tree)
                 AND
                   (FORALL (left_tree, right_tree: tree):
                     tree_parts(
                       whole_tree,
                       left_tree,
                       right_tree)
                       IMPLIES
                         recursive_case(
                           entry_memory,
                           whole_tree,
                           left_tree,
                           right_tree,
                           current,
                           parent_node)))

  finish_obligation(
      initial_memory: memory,
      t: tree,
      root: loc): bool =
    (LET initial_pointers: pointer_memory =
           accessor(initial_memory)
     IN
       (root /= null_loc
         AND
           is_tree(
             accessor(initial_memory),
             t,
             root,
             null_loc))
       AND
         (FORALL (final_memory: memory):
           (unchanged(
              accessor(initial_memory),
              accessor(final_memory))
             AND
               was_marked(
                 t,
                 mark(initial_memory),
                 mark(final_memory)))
           IMPLIES
             rotated(
               initial_pointers,
               accessor(final_memory),
               Finish,
               null_loc)
             AND
               (FORALL (current: loc):
                 rotated(
                   initial_pointers,
                   accessor(final_memory),
                   Finish,
                   current)
                   IMPLIES
                     rotated(
                       initial_pointers,
                       accessor(final_memory),
                       Finish,
                       current)
                     AND
                       (ext(
                          t,
                          initial_pointers,
                          accessor(final_memory))
                         AND
                           is_tree(
                             initial_pointers,
                             t,
                             root,
                             null_loc))
                     AND
                       (is_tree(
                          accessor(final_memory),
                          t,
                          root,
                          null_loc)
                         IMPLIES
                           is_tree(
                             accessor(final_memory),
                             t,
                             root,
                             null_loc)
                           AND
                             unchanged(
                               accessor(initial_memory),
                               accessor(final_memory))
                           AND
                             was_marked(
                               t,
                               mark(initial_memory),
                               mark(final_memory))))))

  markTree_vc: bool =
    FORALL
      (initial_memory: memory),
      (t: tree),
      (root: loc):
      (is_tree(
         accessor(initial_memory),
         t,
         root,
         null_loc)
        AND root /= null_loc)
      IMPLIES
        bloc_obligation
          AND auxiliary_obligation
          AND finish_obligation(initial_memory, t, root)

END verifythis_2016_tree_traversal_Recursive_markTreeqtvc
