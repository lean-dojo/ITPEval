% Statement-only formalization of the NTP4VC corpus artifact pearl/queens_NQueensSetsTermination_tqtvc: the N-queens finite-set termination condition for cardinality decreases after selecting and removing a minimum element. This file contains no proof.

queens_NQueensSetsTermination_tqtvc: THEORY
BEGIN

  IMPORTING finite_sets[int], finite_sets@finite_sets_minmax[int, <=]

  t_vc: bool =
    FORALL (a, o1, b, o2, c: finite_set[int]):
      a /= emptyset[int]
      IMPLIES o1 = difference(a, b)
      IMPLIES o2 = difference(o1, c)
      IMPLIES
        subset?(o2, difference(difference(a, b), c))
        AND
        (FORALL (f: int), (e: finite_set[int]):
          subset?(e, difference(difference(a, b), c))
          IMPLIES e /= emptyset[int]
          IMPLIES
            e /= emptyset[int]
            AND
            (LET d: int = min(e)
             IN
               FORALL (o3: finite_set[int]):
                 (o3 = add(d, c)
                  AND
                  (IF c(d)
                   THEN card(o3) = card(c)
                   ELSE (card(o3) :: int) = (card(c) :: int) + 1
                   ENDIF))
                 IMPLIES
                   (FORALL (o4: finite_set[int]):
                     (FORALL (i: int):
                       o4(i) IFF (0 <= i AND o3(i + 1)))
                     IMPLIES
                       (FORALL (o5: finite_set[int]):
                         (o5 = add(d, b)
                          AND
                          (IF b(d)
                           THEN card(o5) = card(b)
                           ELSE (card(o5) :: int) = (card(b) :: int) + 1
                           ENDIF))
                         IMPLIES
                           (FORALL (o6: finite_set[int]):
                             (FORALL (i: int):
                               o6(i) IFF (1 <= i AND o5(i - 1)))
                             IMPLIES
                               (FORALL (o7: finite_set[int]):
                                 (o7 = remove(d, a)
                                  AND
                                  (IF a(d)
                                   THEN (card(o7) :: int) =
                                        (card(a) :: int) - 1
                                   ELSE card(o7) = card(a)
                                   ENDIF))
                                 IMPLIES
                                   ((0 <= (card(a) :: int)
                                     AND
                                     (card(o7) :: int) <
                                       (card(a) :: int))
                                    AND
                                    (FORALL (o8: int),
                                            (o9: finite_set[int]):
                                      (o9 = remove(d, e)
                                       AND
                                       (IF e(d)
                                        THEN (card(o9) :: int) =
                                             (card(e) :: int) - 1
                                        ELSE card(o9) = card(e)
                                        ENDIF))
                                      IMPLIES
                                        ((0 <= (card(e) :: int)
                                          AND
                                          (card(o9) :: int) <
                                            (card(e) :: int))
                                         AND
                                         subset?(
                                           o9,
                                           difference(
                                             difference(a, b),
                                             c)))))))))))

END queens_NQueensSetsTermination_tqtvc
