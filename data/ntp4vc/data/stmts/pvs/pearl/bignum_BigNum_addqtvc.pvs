% Statement-only formalization of the NTP4VC corpus artifact
% pearl/bignum_BigNum_addqtvc: validity and numeric-value correctness
% conditions for adding two base-b integer digit lists with zero carry.
% This file contains no proof.

bignum_BigNum_addqtvc: THEORY
BEGIN
  value(base: int, digits: list[int]): RECURSIVE int =
    CASES digits OF
      null: 0,
      cons(digit, rest):
        digit + base * value(base, rest)
    ENDCASES
  MEASURE digits BY <<

  valid(base: int, digits: list[int]): RECURSIVE bool =
    CASES digits OF
      null: TRUE,
      cons(digit, rest):
        CASES rest OF
          null:
            0 < digit AND digit < base,
          cons(next_digit, remaining_digits):
            (0 <= digit AND digit < base)
              AND valid(base, rest)
        ENDCASES
    ENDCASES
  MEASURE digits BY <<

  add_vc: bool =
    FORALL (base: int), (n1, n2: list[int]):
      (1 < base
        AND valid(base, n1)
        AND valid(base, n2))
      IMPLIES
        valid(base, n1)
          AND valid(base, n2)
          AND 0 <= 0
          AND 0 <= 1
          AND
            (FORALL (result: list[int]):
              (valid(base, result)
                AND value(base, result)
                  = value(base, n1) + value(base, n2) + 0)
              IMPLIES
                valid(base, result)
                  AND value(base, result)
                    = value(base, n1) + value(base, n2))
END bignum_BigNum_addqtvc
