% Statement-only formalization of the NTP4VC corpus artifact
% pearl/avl/priority_queue_PQueue_extract_minqtvc: an AVL priority-queue
% verification condition for extracting a minimum element while preserving
% multiplicities, cardinality, and cached-height bounds.
% This file contains no proof.

priority_queue_PQueue_extract_minqtvc[
  item: TYPE+,
  key_value: TYPE+,
  tree_value: TYPE+
]: THEORY
BEGIN
  model: TYPE = [# seq: list[item], hgt: int #]

  key_option: DATATYPE
  BEGIN
    NoKey: NoKey?
    SomeKey(key_datum: key_value): SomeKey?
  END key_option

  item_option: DATATYPE
  BEGIN
    NoItem: NoItem?
    SomeItem(item_datum: item): SomeItem?
  END item_option

  result_option: DATATYPE
  BEGIN
    NoResult: NoResult?
    SomeResult(result_item: item, result_tree: tree_value): SomeResult?
  END result_option

  selection_split: TYPE =
    [# split_left: list[item],
       split_middle: item_option,
       split_right: list[item] #]

  avl_tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      tree_left: avl_tree,
      tree_datum: item,
      tree_right: avl_tree,
      tree_height: nat,
      tree_summary: key_option): Node?
  END avl_tree

  queue_model: TYPE =
    [# model_bag: [item -> int],
       model_minimum: item,
       model_card: int #]

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(
      values: list[item],
      index: nat,
      default_item: item): RECURSIVE item =
    CASES values OF
      null:
        default_item,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1, default_item)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  list_take(count: nat, values: list[item]):
      RECURSIVE list[item] =
    IF count = 0 THEN
      null
    ELSE
      CASES values OF
        null:
          null,
        cons(head, tail):
          cons(head, list_take(count - 1, tail))
      ENDCASES
    ENDIF
  MEASURE count

  list_drop(count: nat, values: list[item]):
      RECURSIVE list[item] =
    IF count = 0 THEN
      values
    ELSE
      CASES values OF
        null:
          null,
        cons(head, tail):
          list_drop(count - 1, tail)
      ENDCASES
    ENDIF
  MEASURE count

  occurrence_count(datum: item, values: list[item]):
      RECURSIVE nat =
    CASES values OF
      null:
        0,
      cons(head, tail):
        (IF datum = head THEN 1 ELSE 0 ENDIF)
          + occurrence_count(datum, tail)
    ENDCASES
  MEASURE values BY <<

  node_model(
      left_values: list[item],
      datum: item,
      right_values: list[item]): list[item] =
    append(left_values, cons(datum, right_values))

  option_to_sequence(option: item_option): list[item] =
    CASES option OF
      NoItem:
        null,
      SomeItem(datum):
        cons(datum, null)
    ENDCASES

  rebuild(parts: selection_split): list[item] =
    append(
      append(
        split_left(parts),
        option_to_sequence(split_middle(parts))),
      split_right(parts))

  seq_model(represented_tree: avl_tree):
      RECURSIVE list[item] =
    CASES represented_tree OF
      Empty:
        null,
      Node(left_tree, datum, right_tree, height, summary):
        node_model(
          seq_model(left_tree),
          datum,
          seq_model(right_tree))
    ENDCASES
  MEASURE represented_tree BY <<

  real_height(represented_tree: avl_tree): RECURSIVE int =
    CASES represented_tree OF
      Empty:
        0,
      Node(left_tree, datum, right_tree, height, summary):
        1
          + (IF real_height(left_tree) < real_height(right_tree)
             THEN real_height(right_tree)
             ELSE real_height(left_tree)
             ENDIF)
    ENDCASES
  MEASURE represented_tree BY <<

  strict_key_order(
      leq: [key_value, key_value -> bool],
      left, right: key_value): bool =
    leq(left, right) AND NOT leq(right, left)

  option_op(
      left, right: key_option,
      leq: [key_value, key_value -> bool]): key_option =
    CASES left OF
      NoKey:
        right,
      SomeKey(left_key):
        CASES right OF
          NoKey:
            left,
          SomeKey(right_key):
            IF strict_key_order(leq, right_key, left_key)
            THEN right
            ELSE left
            ENDIF
        ENDCASES
    ENDCASES

  lower_bound(
      lower_key: key_value,
      values: list[item],
      key: [item -> key_value],
      leq: [key_value, key_value -> bool],
      default_item: item): bool =
    FORALL (index: int):
      (0 <= index AND index < length(values))
        IMPLIES
          leq(
            lower_key,
            key(
              nth_default(
                values, int_to_nat(index), default_item)))

  lower_bound_strict(
      lower_key: key_value,
      values: list[item],
      key: [item -> key_value],
      leq: [key_value, key_value -> bool],
      default_item: item): bool =
    FORALL (index: int):
      (0 <= index AND index < length(values))
        IMPLIES
          strict_key_order(
            leq,
            lower_key,
            key(
              nth_default(
                values, int_to_nat(index), default_item)))

  selected(
      parts: selection_split,
      key: [item -> key_value],
      leq: [key_value, key_value -> bool],
      default_item: item): bool =
    CASES split_middle(parts) OF
      NoItem:
        FALSE,
      SomeItem(datum):
        lower_bound(
          key(datum), split_right(parts),
          key, leq, default_item)
          AND
        lower_bound_strict(
          key(datum), split_left(parts),
          key, leq, default_item)
    ENDCASES

  selection_possible(values: list[item]): bool =
    length(values) /= 0

  balanced(
      represented_tree: avl_tree,
      balancing: nat,
      agg: [[item -> key_option],
            list[item] -> key_option],
      measure_closure: [item -> key_option]):
      RECURSIVE bool =
    CASES represented_tree OF
      Empty:
        TRUE,
      Node(left_tree, datum, right_tree, height, summary):
        (height :: int) = real_height(represented_tree)
          AND summary =
                agg(measure_closure, seq_model(represented_tree))
          AND
            -(balancing :: int)
              <= real_height(right_tree) - real_height(left_tree)
          AND
            real_height(right_tree) - real_height(left_tree)
              <= (balancing :: int)
          AND balanced(
                left_tree, balancing, agg, measure_closure)
          AND balanced(
                right_tree, balancing, agg, measure_closure)
    ENDCASES
  MEASURE represented_tree BY <<

  key_order_laws(
      leq: [key_value, key_value -> bool]): bool =
    (FORALL (x: key_value): leq(x, x))
      AND
    (FORALL (x, y, z: key_value):
      leq(x, y) AND leq(y, z) IMPLIES leq(x, z))
      AND
    (FORALL (x, y: key_value): leq(x, y) OR leq(y, x))

  option_monoid_laws(
      leq: [key_value, key_value -> bool]): bool =
    (FORALL (a, b, c: key_option):
      option_op(a, option_op(b, c, leq), leq)
        = option_op(option_op(a, b, leq), c, leq))
      AND
    (FORALL (x: key_option):
      option_op(x, NoKey, leq) = x
        AND x = option_op(NoKey, x, leq))

  aggregate_definition(
      agg: [[item -> key_option],
            list[item] -> key_option],
      leq: [key_value, key_value -> bool],
      default_item: item): bool =
    FORALL (f: [item -> key_option]), (values: list[item]):
      IF length(values) = 0 THEN
        agg(f, values) = NoKey
      ELSE
        agg(f, values)
          = option_op(
              f(nth_default(values, 0, default_item)),
              agg(f, list_drop(1, values)),
              leq)
      ENDIF

  representation_invariant(
      repr: [tree_value -> avl_tree],
      m1: [tree_value -> model],
      balancing: nat,
      agg: [[item -> key_option],
            list[item] -> key_option],
      measure_closure: [item -> key_option]): bool =
    FORALL (self: tree_value):
      balanced(
        repr(self), balancing, agg, measure_closure)
        AND seq(m1(self)) = seq_model(repr(self))
        AND hgt(m1(self)) = real_height(repr(self))

  representation_injective(
      repr: [tree_value -> avl_tree],
      m1: [tree_value -> model]): bool =
    FORALL (left_tree, right_tree: tree_value):
      (repr(left_tree) = repr(right_tree)
        AND m1(left_tree) = m1(right_tree))
      IMPLIES left_tree = right_tree

  minimum_index_laws(
      minimum_index: [list[item] -> int],
      key: [item -> key_value],
      leq: [key_value, key_value -> bool],
      agg: [[item -> key_option],
            list[item] -> key_option],
      measure_closure: [item -> key_option],
      default_item: item): bool =
    FORALL (values: list[item]):
      length(values) /= 0 IMPLIES
        0 <= minimum_index(values)
          AND minimum_index(values) < length(values)
          AND
            agg(measure_closure, values)
              = SomeKey(
                  key(
                    nth_default(
                      values,
                      int_to_nat(minimum_index(values)),
                      default_item)))
          AND
            lower_bound_strict(
              key(
                nth_default(
                  values,
                  int_to_nat(minimum_index(values)),
                  default_item)),
              list_take(
                int_to_nat(minimum_index(values)),
                values),
              key, leq, default_item)
          AND
            lower_bound(
              key(
                nth_default(
                  values,
                  int_to_nat(minimum_index(values)),
                  default_item)),
              list_drop(
                int_to_nat(minimum_index(values)),
                values),
              key, leq, default_item)

  background_assumptions(
      balancing: nat,
      key: [item -> key_value],
      leq: [key_value, key_value -> bool],
      agg: [[item -> key_option],
            list[item] -> key_option],
      measure_closure: [item -> key_option],
      repr: [tree_value -> avl_tree],
      m1: [tree_value -> model],
      minimum_index: [list[item] -> int],
      default_item: item): bool =
    0 < balancing
      AND key_order_laws(leq)
      AND option_monoid_laws(leq)
      AND aggregate_definition(agg, leq, default_item)
      AND
        (FORALL (datum: item):
          measure_closure(datum) = SomeKey(key(datum)))
      AND
        representation_invariant(
          repr, m1, balancing, agg, measure_closure)
      AND representation_injective(repr, m1)
      AND
        minimum_index_laws(
          minimum_index, key, leq, agg,
          measure_closure, default_item)

  m3(
      tree: tree_value,
      m1: [tree_value -> model],
      minimum_index: [list[item] -> int],
      default_item: item): queue_model =
    LET values: list[item] = seq(m1(tree))
    IN
      (# model_bag :=
           (LAMBDA (datum: item):
             occurrence_count(datum, values) :: int),
         model_minimum :=
           nth_default(
             values,
             int_to_nat(minimum_index(values)),
             default_item),
         model_card := (length(values) :: int) #)

  middle_matches(
      option: item_option,
      parts: selection_split): bool =
    CASES option OF
      NoItem:
        split_middle(parts) = NoItem,
      SomeItem(datum):
        split_middle(parts) = SomeItem(datum)
    ENDCASES

  option_is_some(option: item_option): bool =
    CASES option OF
      NoItem:
        FALSE,
      SomeItem(datum):
        TRUE
    ENDCASES

  result_matches(
      option: item_option,
      result: result_option,
      residual_tree: tree_value): bool =
    CASES option OF
      NoItem:
        FALSE,
      SomeItem(datum):
        result = SomeResult(datum, residual_tree)
    ENDCASES

  empty_model(
      tree: tree_value,
      m1: [tree_value -> model],
      minimum_index: [list[item] -> int],
      default_item: item): bool =
    model_card(m3(tree, m1, minimum_index, default_item)) = 0
      AND
    (FORALL (datum: item):
      model_bag(m3(tree, m1, minimum_index, default_item))(datum)
        = 0)

  extracted_result(
      original: tree_value,
      result: result_option,
      m1: [tree_value -> model],
      minimum_index: [list[item] -> int],
      default_item: item): bool =
    CASES result OF
      NoResult:
        empty_model(
          original, m1, minimum_index, default_item),
      SomeResult(datum, residual_tree):
        model_card(
          m3(original, m1, minimum_index, default_item))
            = model_card(
                m3(
                  residual_tree, m1,
                  minimum_index, default_item))
                + 1
          AND
            model_bag(
              m3(original, m1, minimum_index, default_item))(
                datum)
              = model_bag(
                  m3(
                    residual_tree, m1,
                    minimum_index, default_item))(datum)
                  + 1
          AND
            datum
              = model_minimum(
                  m3(
                    original, m1,
                    minimum_index, default_item))
          AND
            (FORALL (other: item):
              other /= datum IMPLIES
                model_bag(
                  m3(
                    original, m1,
                    minimum_index, default_item))(other)
                  = model_bag(
                      m3(
                        residual_tree, m1,
                        minimum_index, default_item))(other))
    ENDCASES

  nonempty_branch(
      original: tree_value,
      key: [item -> key_value],
      leq: [key_value, key_value -> bool],
      m1: [tree_value -> model],
      minimum_index: [list[item] -> int],
      default_item: item): bool =
    selection_possible(seq(m1(original)))
      AND
    (FORALL
      (parts: selection_split),
      (option: item_option),
      (residual_tree: tree_value):
        ((selected(parts, key, leq, default_item)
            AND rebuild(parts) = seq(m1(original)))
          AND
            seq(m1(residual_tree))
              = append(split_left(parts), split_right(parts))
          AND
            (hgt(m1(original)) - hgt(m1(residual_tree)) <= 1
              AND
             0 <= hgt(m1(original)) - hgt(m1(residual_tree)))
          AND middle_matches(option, parts))
        IMPLIES
          (option_is_some(option)
            AND
              (FORALL (result: result_option):
                result_matches(option, result, residual_tree)
                  IMPLIES
                    extracted_result(
                      original, result, m1,
                      minimum_index, default_item))))

  extract_min_vc: bool =
    FORALL
      (balancing: nat),
      (key: [item -> key_value]),
      (leq: [key_value, key_value -> bool]),
      (agg: [[item -> key_option],
             list[item] -> key_option]),
      (measure_closure: [item -> key_option]),
      (repr: [tree_value -> avl_tree]),
      (m1: [tree_value -> model]),
      (minimum_index: [list[item] -> int]),
      (default_item: item),
      (original: tree_value),
      (is_empty: bool):
        background_assumptions(
          balancing, key, leq, agg, measure_closure,
          repr, m1, minimum_index, default_item)
        IMPLIES
          (((length(seq(m1(original))) = 0)
              IMPLIES is_empty)
            AND
           (is_empty IMPLIES seq(m1(original)) = null))
          IMPLIES
            IF is_empty THEN
              empty_model(
                original, m1, minimum_index, default_item)
            ELSE
              nonempty_branch(
                original, key, leq, m1,
                minimum_index, default_item)
            ENDIF
END priority_queue_PQueue_extract_minqtvc
