% Statement-only formalization of the NTP4VC corpus artifact
% pearl/avl/avl_AVL_joinqtvc: an AVL-tree join verification condition for
% inorder sequences, recursive rebalancing, and cached-height bounds.
% This file contains no proof.

avl_AVL_joinqtvc[
  node_value: TYPE,
  tree_value: TYPE,
  summary_value: TYPE
]: THEORY
BEGIN
  model: TYPE = [# seq: list[node_value], hgt: int #]

  avl_tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      tree_left: avl_tree,
      tree_datum: node_value,
      tree_right: avl_tree,
      tree_height: nat,
      tree_summary: summary_value): Node?
  END avl_tree

  view: DATATYPE
  BEGIN
    AEmpty: AEmpty?
    ANode(
      view_left: tree_value,
      view_datum: node_value,
      view_right: tree_value,
      view_height: nat,
      view_summary: summary_value): ANode?
  END view

  node_model(
      left_sequence: list[node_value],
      node_datum: node_value,
      right_sequence: list[node_value]): list[node_value] =
    append(left_sequence, cons(node_datum, right_sequence))

  seq_model(represented_tree: avl_tree):
      RECURSIVE list[node_value] =
    CASES represented_tree OF
      Empty:
        null,
      Node(left_tree, node_datum, right_tree, height, node_summary):
        node_model(
          seq_model(left_tree),
          node_datum,
          seq_model(right_tree))
    ENDCASES
  MEASURE represented_tree BY <<

  real_height(represented_tree: avl_tree): RECURSIVE int =
    CASES represented_tree OF
      Empty:
        0,
      Node(left_tree, node_datum, right_tree, height, node_summary):
        1
          + (IF real_height(left_tree) < real_height(right_tree)
             THEN real_height(right_tree)
             ELSE real_height(left_tree)
             ENDIF)
    ENDCASES
  MEASURE represented_tree BY <<

  balanced(
      represented_tree: avl_tree,
      balancing: nat,
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value],
      measure_closure: [node_value -> summary_value]):
      RECURSIVE bool =
    CASES represented_tree OF
      Empty:
        TRUE,
      Node(left_tree, node_datum, right_tree, height, node_summary):
        (height :: int) = real_height(represented_tree)
          AND node_summary =
                agg(measure_closure, seq_model(represented_tree))
          AND
            -(balancing :: int)
              <= real_height(right_tree) - real_height(left_tree)
          AND
            real_height(right_tree) - real_height(left_tree)
              <= (balancing :: int)
          AND balanced(
                left_tree, balancing, agg, measure_closure)
          AND balanced(
                right_tree, balancing, agg, measure_closure)
    ENDCASES
  MEASURE represented_tree BY <<

  associative(
      op: [summary_value, summary_value -> summary_value]): bool =
    FORALL (a, b, c: summary_value):
      op(a, op(b, c)) = op(op(a, b), c)

  neutral_laws(
      zero: summary_value,
      op: [summary_value, summary_value -> summary_value]): bool =
    FORALL (x: summary_value):
      op(x, zero) = x AND x = op(zero, x)

  aggregate_laws(
      zero: summary_value,
      op: [summary_value, summary_value -> summary_value],
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value]): bool =
    (FORALL (f: [node_value -> summary_value]):
      agg(f, null) = zero)
      AND
    (FORALL (f: [node_value -> summary_value]),
            (datum: node_value):
      agg(f, cons(datum, null)) = f(datum))
      AND
    (FORALL (f: [node_value -> summary_value]),
            (left_sequence, right_sequence: list[node_value]):
      agg(f, append(left_sequence, right_sequence))
        = op(agg(f, left_sequence), agg(f, right_sequence)))

  representation_invariant(
      repr: [tree_value -> avl_tree],
      m1: [tree_value -> model],
      balancing: nat,
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value],
      measure_closure: [node_value -> summary_value]): bool =
    FORALL (self: tree_value):
      balanced(
        repr(self), balancing, agg, measure_closure)
        AND seq(m1(self)) = seq_model(repr(self))
        AND hgt(m1(self)) = real_height(repr(self))

  representation_injective(
      repr: [tree_value -> avl_tree],
      m1: [tree_value -> model]): bool =
    FORALL (left_tree, right_tree: tree_value):
      (repr(left_tree) = repr(right_tree)
        AND m1(left_tree) = m1(right_tree))
      IMPLIES left_tree = right_tree

  background_assumptions(
      zero: summary_value,
      op: [summary_value, summary_value -> summary_value],
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value],
      element_measure: [node_value -> summary_value],
      balancing: nat,
      measure_closure: [node_value -> summary_value],
      repr: [tree_value -> avl_tree],
      m1: [tree_value -> model]): bool =
    associative(op)
      AND neutral_laws(zero, op)
      AND aggregate_laws(zero, op, agg)
      AND 0 < balancing
      AND
        (FORALL (datum: node_value):
          measure_closure(datum) = element_measure(datum))
      AND
        representation_invariant(
          repr, m1, balancing, agg, measure_closure)
      AND representation_injective(repr, m1)

  height_balanced(
      left_tree, right_tree: tree_value,
      balancing: nat,
      m1: [tree_value -> model]): bool =
    LET difference: int =
      hgt(m1(left_tree)) - hgt(m1(right_tree))
    IN
      -(balancing :: int) <= difference
        AND difference <= (balancing :: int)

  widened_balance(
      left_tree, right_tree: tree_value,
      balancing: nat,
      m1: [tree_value -> model]): bool =
    LET difference: int =
      hgt(m1(left_tree)) - hgt(m1(right_tree))
    IN
      -(balancing :: int) - 1 <= difference
        AND difference <= (balancing :: int) + 1

  absolute_height_difference(
      left_tree, right_tree: tree_value,
      m1: [tree_value -> model]): int =
    IF hgt(m1(right_tree)) < hgt(m1(left_tree))
    THEN hgt(m1(left_tree)) - hgt(m1(right_tree))
    ELSE hgt(m1(right_tree)) - hgt(m1(left_tree))
    ENDIF

  height_approximation(
      left_tree, right_tree, result: tree_value,
      m1: [tree_value -> model]): bool =
    LET left_height: int = hgt(m1(left_tree)),
        right_height: int = hgt(m1(right_tree)),
        expected_height: int =
          1
            + (IF left_height < right_height
               THEN right_height
               ELSE left_height
               ENDIF),
        result_height: int = hgt(m1(result))
    IN
      0 <= expected_height - result_height
        AND expected_height - result_height <= 1

  exact_node(
      result, left_tree: tree_value,
      node_datum: node_value,
      right_tree: tree_value,
      m1: [tree_value -> model]): bool =
    seq(m1(result))
        = node_model(
            seq(m1(left_tree)),
            node_datum,
            seq(m1(right_tree)))
      AND
        hgt(m1(result))
          = 1
              + (IF hgt(m1(left_tree)) < hgt(m1(right_tree))
                 THEN hgt(m1(right_tree))
                 ELSE hgt(m1(left_tree))
                 ENDIF)

  view_matches(
      tree_view: view,
      represented_tree: tree_value,
      balancing: nat,
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value],
      measure_closure: [node_value -> summary_value],
      m1: [tree_value -> model]): bool =
    CASES tree_view OF
      AEmpty:
        hgt(m1(represented_tree)) = 0
          AND seq(m1(represented_tree)) = null,
      ANode(left_tree, node_datum, right_tree, height, node_summary):
        seq(m1(represented_tree))
            = node_model(
                seq(m1(left_tree)),
                node_datum,
                seq(m1(right_tree)))
          AND node_summary =
                agg(measure_closure, seq(m1(represented_tree)))
          AND height_balanced(
                left_tree, right_tree, balancing, m1)
          AND hgt(m1(represented_tree)) = (height :: int)
          AND
            (height :: int)
              = 1
                  + (IF hgt(m1(left_tree)) < hgt(m1(right_tree))
                     THEN hgt(m1(right_tree))
                     ELSE hgt(m1(left_tree))
                     ENDIF)
    ENDCASES

  recursive_obligations(
      left_view: view,
      l, r: tree_value,
      d: node_value,
      balancing: nat,
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value],
      measure_closure: [node_value -> summary_value],
      m1: [tree_value -> model]): bool =
    CASES left_view OF
      AEmpty:
        TRUE,
      ANode(ll, ld, lr, lh, left_summary):
        FORALL (right_view: view):
          view_matches(
            right_view, r, balancing,
            agg, measure_closure, m1)
          IMPLIES
            CASES right_view OF
              AEmpty:
                TRUE,
              ANode(rl, rd, rr, rh, right_summary):
                FORALL (o3: int):
                  o3 = -(rh :: int)
                  IMPLIES
                    (o3 <= (lh :: int) - (rh :: int)
                      AND
                        (lh :: int) - (rh :: int)
                          <= (lh :: int))
                    AND
                      (FORALL (df: int):
                        df = (lh :: int) - (rh :: int)
                        IMPLIES
                          (IF (balancing :: int) < df THEN
                             0 <= absolute_height_difference(l, r, m1)
                               AND
                                 absolute_height_difference(lr, r, m1)
                                   < absolute_height_difference(l, r, m1)
                               AND
                                 (FORALL (o4: tree_value):
                                   (seq(m1(o4))
                                      = node_model(
                                          seq(m1(lr)),
                                          d,
                                          seq(m1(r)))
                                     AND
                                       height_approximation(
                                         lr, r, o4, m1))
                                   IMPLIES
                                     widened_balance(
                                       ll, o4, balancing, m1))
                           ELSE
                             FORALL (o4: int):
                               o4 = -(balancing :: int)
                               IMPLIES
                                 (IF df < o4 THEN
                                    0
                                      <= absolute_height_difference(
                                           l, r, m1)
                                      AND
                                        absolute_height_difference(
                                          l, rl, m1)
                                          < absolute_height_difference(
                                              l, r, m1)
                                      AND
                                        (FORALL (o5: tree_value):
                                          (seq(m1(o5))
                                             = node_model(
                                                 seq(m1(l)),
                                                 d,
                                                 seq(m1(rl)))
                                            AND
                                              height_approximation(
                                                l, rl, o5, m1))
                                          IMPLIES
                                            widened_balance(
                                              o5, rr, balancing, m1))
                                  ELSE
                                    height_balanced(
                                      l, r, balancing, m1)
                                  ENDIF)
                           ENDIF))
            ENDCASES
    ENDCASES

  branch_result(
      left_view: view,
      result, l, r: tree_value,
      d: node_value,
      balancing: nat,
      agg: [[node_value -> summary_value],
            list[node_value] -> summary_value],
      measure_closure: [node_value -> summary_value],
      m1: [tree_value -> model]): bool =
    CASES left_view OF
      AEmpty:
        seq(m1(result)) = cons(d, seq(m1(r)))
          AND hgt(m1(result)) - hgt(m1(r)) <= 1
          AND 0 <= hgt(m1(result)) - hgt(m1(r)),
      ANode(ll, ld, lr, lh, left_summary):
        EXISTS (right_view: view):
          view_matches(
            right_view, r, balancing,
            agg, measure_closure, m1)
          AND
            CASES right_view OF
              AEmpty:
                seq(m1(result))
                    = append(seq(m1(l)), cons(d, null))
                  AND hgt(m1(result)) - hgt(m1(l)) <= 1
                  AND 0 <= hgt(m1(result)) - hgt(m1(l)),
              ANode(rl, rd, rr, rh, right_summary):
                EXISTS (o3: int):
                  o3 = -(rh :: int)
                    AND
                      (EXISTS (df: int):
                        df = (lh :: int) - (rh :: int)
                          AND
                            (IF (balancing :: int) < df THEN
                               EXISTS (o4: tree_value):
                                 (seq(m1(o4))
                                    = node_model(
                                        seq(m1(lr)),
                                        d,
                                        seq(m1(r)))
                                   AND
                                     height_approximation(
                                       lr, r, o4, m1))
                                 AND
                                   seq(m1(result))
                                     = node_model(
                                         seq(m1(ll)),
                                         ld,
                                         seq(m1(o4)))
                                 AND
                                   height_approximation(
                                     ll, o4, result, m1)
                                 AND
                                   (height_balanced(
                                      ll, o4, balancing, m1)
                                    IMPLIES
                                      hgt(m1(result))
                                        = 1
                                            + (IF hgt(m1(ll))
                                                    < hgt(m1(o4))
                                               THEN hgt(m1(o4))
                                               ELSE hgt(m1(ll))
                                               ENDIF))
                             ELSE
                               EXISTS (o4: int):
                                 o4 = -(balancing :: int)
                                   AND
                                     (IF df < o4 THEN
                                        EXISTS (o5: tree_value):
                                          (seq(m1(o5))
                                             = node_model(
                                                 seq(m1(l)),
                                                 d,
                                                 seq(m1(rl)))
                                            AND
                                              height_approximation(
                                                l, rl, o5, m1))
                                          AND
                                            seq(m1(result))
                                              = node_model(
                                                  seq(m1(o5)),
                                                  rd,
                                                  seq(m1(rr)))
                                          AND
                                            height_approximation(
                                              o5, rr, result, m1)
                                          AND
                                            (height_balanced(
                                               o5, rr, balancing, m1)
                                             IMPLIES
                                               hgt(m1(result))
                                                 = 1
                                                     + (IF hgt(m1(o5))
                                                             < hgt(m1(rr))
                                                        THEN hgt(m1(rr))
                                                        ELSE hgt(m1(o5))
                                                        ENDIF))
                                      ELSE
                                        exact_node(
                                          result, l, d, r, m1)
                                      ENDIF)
                             ENDIF))
            ENDCASES
    ENDCASES

  final_condition(
      result, l, r: tree_value,
      d: node_value,
      m1: [tree_value -> model]): bool =
    seq(m1(result))
        = node_model(seq(m1(l)), d, seq(m1(r)))
      AND height_approximation(l, r, result, m1)

  join_vc: bool =
    FORALL
      (zero: summary_value),
      (op: [summary_value, summary_value -> summary_value]),
      (agg: [[node_value -> summary_value],
             list[node_value] -> summary_value]),
      (element_measure: [node_value -> summary_value]),
      (balancing: nat),
      (measure_closure: [node_value -> summary_value]),
      (repr: [tree_value -> avl_tree]),
      (m1: [tree_value -> model]),
      (left_view: view),
      (l, r: tree_value),
      (d: node_value):
        (background_assumptions(
           zero, op, agg, element_measure, balancing,
           measure_closure, repr, m1)
          AND
            view_matches(
              left_view, l, balancing,
              agg, measure_closure, m1))
        IMPLIES
          (recursive_obligations(
             left_view, l, r, d, balancing,
             agg, measure_closure, m1)
            AND
              (FORALL (result: tree_value):
                branch_result(
                  left_view, result, l, r, d, balancing,
                  agg, measure_closure, m1)
                IMPLIES
                  final_condition(result, l, r, d, m1)))
END avl_AVL_joinqtvc
