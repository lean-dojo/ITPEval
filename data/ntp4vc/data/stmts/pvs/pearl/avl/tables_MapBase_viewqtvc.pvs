% Statement-only formalization of the NTP4VC corpus artifact
% pearl/avl/tables_MapBase_viewqtvc: the AVL-backed map view verification
% condition relating empty or node views to map cardinality, height, domains,
% and stored values. This file contains no proof.

tables_MapBase_viewqtvc[
  element: TYPE+,
  key_value: TYPE+,
  avl_value: TYPE+,
  map_value: TYPE+
]: THEORY
BEGIN
  model: TYPE = [# seq: list[element], hgt: int #]

  unit_value: DATATYPE
  BEGIN
    UnitValue: UnitValue?
  END unit_value

  avl_tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      tree_left: avl_tree,
      tree_datum: element,
      tree_right: avl_tree,
      tree_height: nat,
      tree_summary: unit_value): Node?
  END avl_tree

  input_view: DATATYPE
  BEGIN
    InputEmpty: InputEmpty?
    InputNode(
      input_left: avl_value,
      input_datum: element,
      input_right: avl_value,
      input_height: nat,
      input_summary: unit_value): InputNode?
  END input_view

  result_view: DATATYPE
  BEGIN
    ResultEmpty: ResultEmpty?
    ResultNode(
      result_left: map_value,
      result_datum: element,
      result_right: map_value,
      result_height: nat): ResultNode?
  END result_view

  map_model: TYPE =
    [# domain_flag: [key_value -> bool],
       map_function: [key_value -> element],
       model_card: int #]

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(
      values: list[element],
      index: nat,
      default_element: element): RECURSIVE element =
    CASES values OF
      null:
        default_element,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1, default_element)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  node_model(
      left_values: list[element],
      datum: element,
      right_values: list[element]): list[element] =
    append(left_values, cons(datum, right_values))

  seq_model(represented_tree: avl_tree):
      RECURSIVE list[element] =
    CASES represented_tree OF
      Empty:
        null,
      Node(left_tree, datum, right_tree, height, summary):
        node_model(
          seq_model(left_tree),
          datum,
          seq_model(right_tree))
    ENDCASES
  MEASURE represented_tree BY <<

  real_height(represented_tree: avl_tree): RECURSIVE int =
    CASES represented_tree OF
      Empty:
        0,
      Node(left_tree, datum, right_tree, height, summary):
        1
          + (IF real_height(left_tree) < real_height(right_tree)
             THEN real_height(right_tree)
             ELSE real_height(left_tree)
             ENDIF)
    ENDCASES
  MEASURE represented_tree BY <<

  balanced(
      represented_tree: avl_tree,
      balancing: nat): RECURSIVE bool =
    CASES represented_tree OF
      Empty:
        TRUE,
      Node(left_tree, datum, right_tree, height, summary):
        (height :: int) = real_height(represented_tree)
          AND summary = UnitValue
          AND
            -(balancing :: int)
              <= real_height(right_tree) - real_height(left_tree)
          AND
            real_height(right_tree) - real_height(left_tree)
              <= (balancing :: int)
          AND balanced(left_tree, balancing)
          AND balanced(right_tree, balancing)
    ENDCASES
  MEASURE represented_tree BY <<

  strict_key_order(
      leq: [key_value, key_value -> bool],
      left, right: key_value): bool =
    leq(left, right) AND NOT leq(right, left)

  key_equivalent(
      leq: [key_value, key_value -> bool],
      left, right: key_value): bool =
    leq(left, right) AND leq(right, left)

  selection_possible(
      values: list[element],
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      default_element: element): bool =
    FORALL (left_index, right_index: int):
      (0 <= left_index
        AND left_index < right_index
        AND right_index < length(values))
      IMPLIES
        strict_key_order(
          leq,
          key(
            nth_default(
              values,
              int_to_nat(left_index),
              default_element)),
          key(
            nth_default(
              values,
              int_to_nat(right_index),
              default_element)))

  domain(
      values: list[element],
      selected_key: key_value,
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      default_element: element): bool =
    EXISTS (index: int):
      (0 <= index AND index < length(values))
        AND
      key_equivalent(
        leq,
        key(
          nth_default(
            values,
            int_to_nat(index),
            default_element)),
        selected_key)

  order_laws(
      leq: [key_value, key_value -> bool]): bool =
    (FORALL (x: key_value): leq(x, x))
      AND
    (FORALL (x, y, z: key_value):
      leq(x, y) AND leq(y, z) IMPLIES leq(x, z))
      AND
    (FORALL (x, y: key_value):
      leq(x, y) OR leq(y, x))

  representation_invariant(
      repr: [avl_value -> avl_tree],
      m1: [avl_value -> model],
      balancing: nat): bool =
    FORALL (self: avl_value):
      balanced(repr(self), balancing)
        AND seq(m1(self)) = seq_model(repr(self))
        AND hgt(m1(self)) = real_height(repr(self))

  representation_injective(
      repr: [avl_value -> avl_tree],
      m1: [avl_value -> model]): bool =
    FORALL (left_value, right_value: avl_value):
      (repr(left_value) = repr(right_value)
        AND m1(left_value) = m1(right_value))
      IMPLIES left_value = right_value

  map_invariant(
      field: [map_value -> avl_value],
      m1: [avl_value -> model],
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      default_element: element): bool =
    FORALL (self: map_value):
      selection_possible(
        seq(m1(field(self))),
        key, leq, default_element)

  map_injective(
      field: [map_value -> avl_value]): bool =
    FORALL (left_map, right_map: map_value):
      field(left_map) = field(right_map)
        IMPLIES left_map = right_map

  make_function_specification(
      make_function:
        [list[element], key_value -> element],
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      default_element: element): bool =
    FORALL
      (values: list[element]),
      (selected_key: key_value),
      (index: int):
        selection_possible(
          values, key, leq, default_element)
          AND
        domain(
          values, selected_key,
          key, leq, default_element)
          AND 0 <= index
          AND index < length(values)
          AND
            key_equivalent(
              leq,
              key(
                nth_default(
                  values,
                  int_to_nat(index),
                  default_element)),
              selected_key)
        IMPLIES
          make_function(values, selected_key)
            = nth_default(
                values,
                int_to_nat(index),
                default_element)

  closure_definitions(
      domain_closure:
        [list[element], key_value -> bool],
      make_function_closure:
        [list[element], key_value -> element],
      make_function:
        [list[element], key_value -> element],
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      default_element: element): bool =
    (FORALL
      (values: list[element]),
      (selected_key: key_value):
        domain_closure(values, selected_key)
          = domain(
              values, selected_key,
              key, leq, default_element))
      AND
    (FORALL
      (values: list[element]),
      (selected_key: key_value):
        make_function_closure(values, selected_key)
          = make_function(values, selected_key))

  background_assumptions(
      balancing: nat,
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      repr: [avl_value -> avl_tree],
      m1: [avl_value -> model],
      field: [map_value -> avl_value],
      make_function:
        [list[element], key_value -> element],
      domain_closure:
        [list[element], key_value -> bool],
      make_function_closure:
        [list[element], key_value -> element],
      default_element: element): bool =
    0 < balancing
      AND order_laws(leq)
      AND representation_invariant(repr, m1, balancing)
      AND representation_injective(repr, m1)
      AND
        map_invariant(
          field, m1, key, leq, default_element)
      AND map_injective(field)
      AND
        make_function_specification(
          make_function, key, leq, default_element)
      AND
        closure_definitions(
          domain_closure, make_function_closure,
          make_function, key, leq, default_element)

  map_model_of:
    [map_value,
     [map_value -> avl_value],
     [avl_value -> model],
     [list[element], key_value -> bool],
     [list[element], key_value -> element] -> map_model] =
    LAMBDA
      (map_object: map_value),
      (field: [map_value -> avl_value]),
      (m1: [avl_value -> model]),
      (domain_closure:
        [list[element], key_value -> bool]),
      (make_function_closure:
        [list[element], key_value -> element]):
        LET values: list[element] = seq(m1(field(map_object)))
        IN
          (# domain_flag :=
               (LAMBDA (selected_key: key_value):
                 domain_closure(values, selected_key)),
             map_function :=
               (LAMBDA (selected_key: key_value):
                 make_function_closure(values, selected_key)),
             model_card := (length(values) :: int) #)

  input_matches(
      viewed_tree: avl_value,
      viewed: input_view,
      m1: [avl_value -> model],
      balancing: nat): bool =
    CASES viewed OF
      InputEmpty:
        hgt(m1(viewed_tree)) = 0
          AND seq(m1(viewed_tree)) = null,
      InputNode(left_tree, datum, right_tree, height, summary):
        seq(m1(viewed_tree))
          = node_model(
              seq(m1(left_tree)),
              datum,
              seq(m1(right_tree)))
          AND summary = UnitValue
          AND
            LET left_height: int = hgt(m1(left_tree)),
                right_height: int = hgt(m1(right_tree))
            IN
              -(balancing :: int)
                <= left_height - right_height
              AND
                left_height - right_height
                  <= (balancing :: int)
              AND hgt(m1(viewed_tree)) = (height :: int)
              AND
                (height :: int)
                  = 1
                    + (IF left_height < right_height
                       THEN right_height
                       ELSE left_height
                       ENDIF)
    ENDCASES

  subtrees_are_selectable(
      viewed: input_view,
      field: [map_value -> avl_value],
      m1: [avl_value -> model],
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      default_element: element): bool =
    CASES viewed OF
      InputEmpty:
        TRUE,
      InputNode(left_tree, datum, right_tree, height, summary):
        selection_possible(
          seq(m1(right_tree)),
          key, leq, default_element)
          AND
        (FORALL (left_wrapper: map_value):
          field(left_wrapper) = right_tree
          IMPLIES
            selection_possible(
              seq(m1(left_tree)),
              key, leq, default_element))
    ENDCASES

  result_matches(
      viewed: input_view,
      result: result_view,
      field: [map_value -> avl_value]): bool =
    CASES viewed OF
      InputEmpty:
        result = ResultEmpty,
      InputNode(left_tree, datum, right_tree, height, summary):
        EXISTS (right_map: map_value):
          field(right_map) = right_tree
            AND
          EXISTS (left_map: map_value):
            field(left_map) = left_tree
              AND result = ResultNode(left_map, datum, right_map, height)
    ENDCASES

  result_conclusion(
      map_object: map_value,
      result: result_view,
      key: [element -> key_value],
      leq: [key_value, key_value -> bool],
      field: [map_value -> avl_value],
      m1: [avl_value -> model],
      domain_closure:
        [list[element], key_value -> bool],
      make_function_closure:
        [list[element], key_value -> element]): bool =
    CASES result OF
      ResultEmpty:
        model_card(
          map_model_of(
            map_object, field, m1,
            domain_closure,
            make_function_closure)) = 0
          AND
        (FORALL (selected_key: key_value):
          NOT
            domain_flag(
              map_model_of(
                map_object, field, m1,
                domain_closure,
                make_function_closure))(selected_key)),
      ResultNode(left_map, datum, right_map, height):
        model_card(
          map_model_of(
            map_object, field, m1,
            domain_closure,
            make_function_closure))
          =
            1
              + model_card(
                  map_model_of(
                    left_map, field, m1,
                    domain_closure,
                    make_function_closure))
              + model_card(
                  map_model_of(
                    right_map, field, m1,
                    domain_closure,
                    make_function_closure))
          AND
            (height :: int) = hgt(m1(field(map_object)))
          AND
            LET pivot_key: key_value = key(datum)
            IN
              (FORALL (selected_key: key_value):
                strict_key_order(leq, selected_key, pivot_key)
                IMPLIES
                  domain_flag(
                    map_model_of(
                      left_map, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key)
                    =
                  domain_flag(
                    map_model_of(
                      map_object, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key))
              AND
              (FORALL (selected_key: key_value):
                (strict_key_order(leq, selected_key, pivot_key)
                  AND
                 domain_flag(
                   map_model_of(
                     left_map, field, m1,
                     domain_closure,
                     make_function_closure))(selected_key))
                IMPLIES
                  map_function(
                    map_model_of(
                      left_map, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key)
                    =
                  map_function(
                    map_model_of(
                      map_object, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key))
              AND
              (FORALL (selected_key: key_value):
                leq(pivot_key, selected_key)
                IMPLIES
                  NOT
                    domain_flag(
                      map_model_of(
                        left_map, field, m1,
                        domain_closure,
                        make_function_closure))(selected_key))
              AND
              (FORALL (selected_key: key_value):
                strict_key_order(leq, pivot_key, selected_key)
                IMPLIES
                  domain_flag(
                    map_model_of(
                      right_map, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key)
                    =
                  domain_flag(
                    map_model_of(
                      map_object, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key))
              AND
              (FORALL (selected_key: key_value):
                (strict_key_order(leq, pivot_key, selected_key)
                  AND
                 domain_flag(
                   map_model_of(
                     right_map, field, m1,
                     domain_closure,
                     make_function_closure))(selected_key))
                IMPLIES
                  map_function(
                    map_model_of(
                      right_map, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key)
                    =
                  map_function(
                    map_model_of(
                      map_object, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key))
              AND
              (FORALL (selected_key: key_value):
                leq(selected_key, pivot_key)
                IMPLIES
                  NOT
                    domain_flag(
                      map_model_of(
                        right_map, field, m1,
                        domain_closure,
                        make_function_closure))(selected_key))
              AND
              (FORALL (selected_key: key_value):
                key_equivalent(leq, selected_key, pivot_key)
                IMPLIES
                  domain_flag(
                    map_model_of(
                      map_object, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key)
                    AND
                  map_function(
                    map_model_of(
                      map_object, field, m1,
                      domain_closure,
                      make_function_closure))(selected_key)
                    = datum)
              AND
                domain_flag(
                  map_model_of(
                    map_object, field, m1,
                    domain_closure,
                    make_function_closure))(pivot_key)
              AND
                map_function(
                  map_model_of(
                    map_object, field, m1,
                    domain_closure,
                    make_function_closure))(pivot_key)
                  = datum
    ENDCASES

  view_vc: bool =
    FORALL
      (balancing: nat),
      (key: [element -> key_value]),
      (leq: [key_value, key_value -> bool]),
      (repr: [avl_value -> avl_tree]),
      (m1: [avl_value -> model]),
      (field: [map_value -> avl_value]),
      (make_function:
        [list[element], key_value -> element]),
      (domain_closure:
        [list[element], key_value -> bool]),
      (make_function_closure:
        [list[element], key_value -> element]),
      (default_element: element),
      (map_object: map_value):
        background_assumptions(
          balancing, key, leq, repr, m1, field,
          make_function, domain_closure,
          make_function_closure, default_element)
        IMPLIES
          LET viewed_tree: avl_value = field(map_object)
          IN
            FORALL (viewed: input_view):
              input_matches(viewed_tree, viewed, m1, balancing)
              IMPLIES
                subtrees_are_selectable(
                  viewed, field, m1,
                  key, leq, default_element)
                AND
                (FORALL (result: result_view):
                  result_matches(viewed, result, field)
                  IMPLIES
                    result_conclusion(
                      map_object, result, key, leq,
                      field, m1, domain_closure,
                      make_function_closure))
END tables_MapBase_viewqtvc
