% Statement-only formalization of the NTP4VC corpus artifact
% pearl/sumrange_CumulativeTree_update_auxqtvc: the cumulative-tree point-update
% verification condition for recursive-call applicability, preserved bounds,
% and correctness of the updated range-sum tree. This file contains no proof.

sumrange_CumulativeTree_update_auxqtvc: THEORY
BEGIN

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(values: list[int], index: nat): RECURSIVE int =
    CASES values OF
      null:
        0,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  set_at(
      values: list[int],
      index: nat,
      value: int): RECURSIVE list[int] =
    CASES values OF
      null:
        null,
      cons(head, tail):
        IF index = 0 THEN
          cons(value, tail)
        ELSE
          cons(head, set_at(tail, index - 1, value))
        ENDIF
    ENDCASES
  MEASURE values BY <<

  sum_from(
      values: list[int],
      start, count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      nth_default(values, start)
        + sum_from(values, start + 1, count - 1)
    ENDIF
  MEASURE count

  array_sum(
      values: list[int],
      lower, upper: int): int =
    sum_from(
      values,
      int_to_nat(lower),
      int_to_nat(upper - lower))

  why3_computer_div(numerator, denominator: int): int =
    IF denominator = 0 THEN
      0
    ELSIF numerator * denominator >= 0 THEN
      floor((numerator :: real) / (denominator :: real))
    ELSE
      -floor(-((numerator :: real) / (denominator :: real)))
    ENDIF

  indexes: DATATYPE
  BEGIN
    mk_indexes(
      low: int,
      high: int,
      isum: int): mk_indexes?
  END indexes

  tree: DATATYPE
  BEGIN
    Leaf(leaf_indexes: indexes): Leaf?
    Node(
      node_indexes: indexes,
      left_tree: tree,
      right_tree: tree): Node?
  END tree

  indexes1(current: tree): indexes =
    CASES current OF
      Leaf(ind):
        ind,
      Node(ind, left, right):
        ind
    ENDCASES

  is_indexes_for(
      ind: indexes,
      values: list[int],
      lower, upper: int): bool =
    low(ind) = lower
      AND high(ind) = upper
      AND 0 <= lower
      AND lower < upper
      AND upper <= length(values)
      AND isum(ind) = array_sum(values, lower, upper)

  is_tree_for(
      current: tree,
      values: list[int],
      lower, upper: int): RECURSIVE bool =
    CASES current OF
      Leaf(ind):
        is_indexes_for(ind, values, lower, upper)
          AND upper = lower + 1,
      Node(ind, left, right):
        is_indexes_for(ind, values, lower, upper)
          AND lower = low(indexes1(left))
          AND upper = high(indexes1(right))
          AND
            (LET middle: int = high(indexes1(left))
             IN
               middle = low(indexes1(right))
                 AND lower < middle
                 AND middle < upper
                 AND middle
                       = why3_computer_div(lower + upper, 2)
                 AND is_tree_for(
                       left, values, lower, middle)
                 AND is_tree_for(
                       right, values, middle, upper))
    ENDCASES
  MEASURE current BY <<

  child_of(parent, child: tree): bool =
    CASES parent OF
      Leaf(ind):
        FALSE,
      Node(ind, left, right):
        left = child OR right = child
    ENDCASES

  selected_recursive_call(
      current: tree,
      values: list[int],
      index: int): bool =
    CASES current OF
      Leaf(ind):
        TRUE,
      Node(ind, left, right):
        IF index < high(indexes1(left)) THEN
          child_of(current, left)
            AND
          is_tree_for(
            left,
            values,
            low(indexes1(left)),
            high(indexes1(left)))
            AND low(indexes1(left)) <= index
            AND index < high(indexes1(left))
        ELSE
          child_of(current, right)
            AND
          is_tree_for(
            right,
            values,
            low(indexes1(right)),
            high(indexes1(right)))
            AND low(indexes1(right)) <= index
            AND index < high(indexes1(right))
        ENDIF
    ENDCASES

  updated_indexes(
      ind: indexes,
      values: list[int],
      index, value: int): indexes =
    mk_indexes(
      low(ind),
      high(ind),
      isum(ind)
        + (value
           - nth_default(values, int_to_nat(index))))

  same_span_tree(
      updated, original: tree,
      values: list[int]): bool =
    low(indexes1(updated)) = low(indexes1(original))
      AND high(indexes1(updated)) = high(indexes1(original))
      AND
        is_tree_for(
          updated,
          values,
          low(indexes1(updated)),
          high(indexes1(updated)))

  result_premise(
      current, updated: tree,
      values, changed_values: list[int],
      index, value, delta: int): bool =
    CASES current OF
      Leaf(ind):
        updated =
          Leaf(mk_indexes(low(ind), high(ind), value))
          AND delta = value - isum(ind),
      Node(ind, left, right):
        IF index < high(indexes1(left)) THEN
          EXISTS (left_prime: tree):
            same_span_tree(
              left_prime, left, changed_values)
              AND
            updated =
              Node(
                updated_indexes(
                  ind, values, index, value),
                left_prime,
                right)
              AND
            delta =
              value
                - nth_default(values, int_to_nat(index))
        ELSE
          EXISTS (right_prime: tree):
            same_span_tree(
              right_prime, right, changed_values)
              AND
            updated =
              Node(
                updated_indexes(
                  ind, values, index, value),
                left,
                right_prime)
              AND
            delta =
              value
                - nth_default(values, int_to_nat(index))
        ENDIF
    ENDCASES

  update_aux_vc: bool =
    FORALL
      (current: tree),
      (values: list[int]),
      (index, value: int):
      is_tree_for(
        current,
        values,
        low(indexes1(current)),
        high(indexes1(current)))
        IMPLIES
      low(indexes1(current)) <= index
        IMPLIES
      index < high(indexes1(current))
        IMPLIES
          selected_recursive_call(current, values, index)
            AND
          (LET changed_values: list[int] =
                 set_at(values, int_to_nat(index), value)
           IN
             FORALL (updated: tree), (delta: int):
               result_premise(
                 current,
                 updated,
                 values,
                 changed_values,
                 index,
                 value,
                 delta)
                 IMPLIES
                   delta =
                     value
                       - nth_default(
                           values, int_to_nat(index))
                     AND
                   low(indexes1(updated))
                     = low(indexes1(current))
                     AND
                   high(indexes1(updated))
                     = high(indexes1(current))
                     AND
                   is_tree_for(
                     updated,
                     changed_values,
                     low(indexes1(updated)),
                     high(indexes1(updated))))

END sumrange_CumulativeTree_update_auxqtvc
