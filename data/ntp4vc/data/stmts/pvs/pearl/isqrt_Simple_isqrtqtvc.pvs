% Statement-only formalization of the NTP4VC corpus artifact
% pearl/isqrt_Simple_isqrtqtvc: the simple integer-square-root verification
% condition, including initialization and universally quantified loop-step
% and loop-exit obligations. This file contains no proof.

isqrt_Simple_isqrtqtvc: THEORY
BEGIN

  sqr(value: int): int =
    value * value

  isqrt_spec(x, result: int): bool =
    0 <= result
      AND sqr(result) <= x
      AND x < sqr(result + 1)

  isqrt_vc: bool =
    FORALL (x: int):
      0 <= x IMPLIES
        0 <= 0
          AND sqr(0) <= x
          AND 1 = sqr(0 + 1)
          AND
            (FORALL (count: int):
              (0 <= count AND sqr(count) <= x)
                IMPLIES
                  IF sqr(count + 1) <= x THEN
                    (0 <= x - count
                      AND x - (count + 1) < x - count)
                      AND 0 <= count + 1
                      AND sqr(count + 1) <= x
                      AND
                        sqr(count + 1)
                            + (2 * (count + 1) + 1)
                          = sqr(count + 1 + 1)
                  ELSE
                    isqrt_spec(x, count)
                  ENDIF)

END isqrt_Simple_isqrtqtvc
