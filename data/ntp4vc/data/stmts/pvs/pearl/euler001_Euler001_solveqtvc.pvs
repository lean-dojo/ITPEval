% Statement-only formalization of the NTP4VC corpus artifact
% pearl/euler001_Euler001_solveqtvc: the Euler 001 verification condition
% equating the sum of multiples of 3 or 5 below a positive bound with its
% inclusion-exclusion closed formula. This file contains no proof.

euler001_Euler001_solveqtvc: THEORY
BEGIN

  trunc_div(numerator, denominator: int): int =
    IF denominator = 0 THEN
      0
    ELSIF numerator * denominator >= 0 THEN
      floor((numerator :: real) / (denominator :: real))
    ELSE
      -floor(-((numerator :: real) / (denominator :: real)))
    ENDIF

  trunc_mod(numerator, denominator: int): int =
    numerator - denominator * trunc_div(numerator, denominator)

  sum_multiple_specification(
      sum_multiple_3_5_lt: [int -> int]): bool =
    sum_multiple_3_5_lt(0) = 0
      AND
        (FORALL (k: int):
          0 <= k IMPLIES
            ((trunc_mod(k, 3) /= 0
                AND trunc_mod(k, 5) /= 0)
              IMPLIES
                sum_multiple_3_5_lt(k + 1)
                  = sum_multiple_3_5_lt(k))
          AND
            ((trunc_mod(k, 3) = 0
                OR trunc_mod(k, 5) = 0)
              IMPLIES
                sum_multiple_3_5_lt(k + 1)
                  = sum_multiple_3_5_lt(k) + k))

  solve_vc: bool =
    FORALL
        (sum_multiple_3_5_lt: [int -> int]),
        (n: int):
      sum_multiple_specification(sum_multiple_3_5_lt)
        IMPLIES
          1 <= n
        IMPLIES
          3 /= 0
            AND
              LET n3: int = trunc_div(n - 1, 3)
              IN
                5 /= 0
                  AND
                    LET n5: int = trunc_div(n - 1, 5)
                    IN
                      15 /= 0
                        AND
                          LET n15: int =
                                trunc_div(n - 1, 15)
                          IN
                            2 /= 0
                              AND
                                trunc_div(
                                  3 * n3 * (n3 + 1)
                                    + 5 * n5 * (n5 + 1)
                                    - 15 * n15 * (n15 + 1),
                                  2)
                                  = sum_multiple_3_5_lt(n)

END euler001_Euler001_solveqtvc
