% Statement-only formalization of the NTP4VC corpus artifact
% pearl/defunctionalization_SemWithError_eval_4qtvc: the verification
% condition for structural decrease and semantic preservation while evaluating
% an expression with an underflow-aware defunctionalized continuation. This
% file contains no proof.

defunctionalization_SemWithError_eval_4qtvc: THEORY
BEGIN

  expr: DATATYPE
  BEGIN
    Cte(constant_value: int): Cte?
    Sub(left_expression, right_expression: expr): Sub?
  END expr

  value: DATATYPE
  BEGIN
    Vnum(numeric_value: int): Vnum?
    Underflow: Underflow?
  END value

  cont: DATATYPE
  BEGIN
    I: I?
    A(pending_expression: expr, next_continuation: cont): A?
    B(saved_value: int, next_continuation: cont): B?
  END cont

  eval_0(expression: expr): RECURSIVE value =
    CASES expression OF
      Cte(n):
        IF 0 <= n THEN Vnum(n) ELSE Underflow ENDIF,
      Sub(left, right):
        CASES eval_0(left) OF
          Underflow:
            Underflow,
          Vnum(left_value):
            CASES eval_0(right) OF
              Underflow:
                Underflow,
              Vnum(right_value):
                IF right_value <= left_value
                THEN Vnum(left_value - right_value)
                ELSE Underflow
                ENDIF
            ENDCASES
        ENDCASES
    ENDCASES
  MEASURE expression BY <<

  size_e(expression: expr): RECURSIVE int =
    CASES expression OF
      Cte(n):
        1,
      Sub(left, right):
        3 + size_e(left) + size_e(right)
    ENDCASES
  MEASURE expression BY <<

  size_c(continuation: cont): RECURSIVE int =
    CASES continuation OF
      I:
        0,
      A(expression, next):
        2 + size_e(expression) + size_c(next),
      B(saved, next):
        1 + size_c(next)
    ENDCASES
  MEASURE continuation BY <<

  eval_cont_closed(relation: [cont, value, value -> bool]): bool =
    (FORALL (next: cont):
      relation(next, Underflow, Underflow))
      AND
    (FORALL
        (numeric: int),
        (next: cont),
        (expression: expr),
        (result: value):
      relation(B(numeric, next), eval_0(expression), result)
        IMPLIES relation(A(expression, next), Vnum(numeric), result))
      AND
    (FORALL
        (next: cont),
        (numeric, saved: int),
        (result: value):
      relation(
        next,
        IF numeric <= saved
        THEN Vnum(saved - numeric)
        ELSE Underflow
        ENDIF,
        result)
        IMPLIES relation(B(saved, next), Vnum(numeric), result))
      AND
    (FORALL (numeric: int):
      relation(I, Vnum(numeric), Vnum(numeric)))

  eval_cont(
      continuation: cont,
      current, result: value): bool =
    FORALL (relation: [cont, value, value -> bool]):
      eval_cont_closed(relation)
        IMPLIES relation(continuation, current, result)

  decrease_obligation(
      expression: expr,
      continuation: cont): bool =
    CASES expression OF
      Cte(n):
        0 <= n
          IMPLIES
            ((0 <= size_c(continuation) + size_e(expression)
                AND
              size_c(continuation)
                < size_c(continuation) + size_e(expression))
              AND 0 <= n),
      Sub(left, right):
        0 <= size_c(continuation) + size_e(expression)
          AND
        size_c(A(right, continuation)) + size_e(left)
          < size_c(continuation) + size_e(expression)
    ENDCASES

  evaluation_premise(
      expression: expr,
      continuation: cont,
      result: value): bool =
    CASES expression OF
      Cte(n):
        IF 0 <= n
        THEN eval_cont(continuation, Vnum(n), result)
        ELSE result = Underflow
        ENDIF,
      Sub(left, right):
        eval_cont(
          A(right, continuation),
          eval_0(left),
          result)
    ENDCASES

  eval_4_vc: bool =
    FORALL (expression: expr), (continuation: cont):
      decrease_obligation(expression, continuation)
        AND
      (FORALL (result: value):
        evaluation_premise(expression, continuation, result)
          IMPLIES
        eval_cont(
          continuation,
          eval_0(expression),
          result))

END defunctionalization_SemWithError_eval_4qtvc
