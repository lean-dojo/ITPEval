% Statement-only formalization of the NTP4VC corpus artifact
% pearl/power_FastExponentiation_fast_exp_imperativeqtvc: the imperative fast
% exponentiation verification condition for loop initialization, descent,
% invariant preservation, and exit over nonnegative integer exponents.
% This file contains no proof.

power_FastExponentiation_fast_exp_imperativeqtvc: THEORY
BEGIN
  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  trunc_div(numerator, denominator: int): int =
    IF denominator = 0 THEN
      0
    ELSIF numerator * denominator >= 0 THEN
      floor((numerator :: real) / (denominator :: real))
    ELSE
      -floor(-((numerator :: real) / (denominator :: real)))
    ENDIF

  trunc_mod(numerator, denominator: int): int =
    numerator - denominator * trunc_div(numerator, denominator)

  fast_exp_imperative_vc: bool =
    FORALL (n, x: int):
      0 <= n IMPLIES
        0 <= n
          AND 1 * int_power(x, n) = int_power(x, n)
          AND
            (FORALL (e, p, r: int):
              (0 <= e
                AND r * int_power(p, e) = int_power(x, n))
              IMPLIES
                IF 0 < e THEN
                  2 /= 0
                    AND
                      IF trunc_mod(e, 2) = 1 THEN
                        2 /= 0
                          AND
                            (0 <= e
                              AND trunc_div(e, 2) < e)
                          AND 0 <= trunc_div(e, 2)
                          AND
                            r * p
                              * int_power(
                                  p * p,
                                  trunc_div(e, 2))
                              = int_power(x, n)
                      ELSE
                        2 /= 0
                          AND
                            (0 <= e
                              AND trunc_div(e, 2) < e)
                          AND 0 <= trunc_div(e, 2)
                          AND
                            r
                              * int_power(
                                  p * p,
                                  trunc_div(e, 2))
                              = int_power(x, n)
                      ENDIF
                ELSE
                  r = int_power(x, n)
                ENDIF)
END power_FastExponentiation_fast_exp_imperativeqtvc
