% Statement-only formalization of the NTP4VC corpus artifact
% pearl/there_and_back_again_Convolution_convolutionqtvc: the symbolic
% convolution verification condition stating that equal-length inputs and the
% helper's consumed-prefix relation yield the first list paired with the
% reverse of the second. This file contains no proof.

there_and_back_again_Convolution_convolutionqtvc[
    Element: TYPE+]: THEORY
BEGIN

  pair: TYPE = [Element, Element]

  list_reverse(values: list[Element]): RECURSIVE list[Element] =
    CASES values OF
      null:
        null,
      cons(head, tail):
        append(list_reverse(tail), cons(head, null))
    ENDCASES
  MEASURE values BY <<

  list_zip(
      left, right: list[Element]): RECURSIVE list[pair] =
    CASES left OF
      null:
        null,
      cons(left_head, left_tail):
        CASES right OF
          null:
            null,
          cons(right_head, right_tail):
            cons(
              (left_head, right_head),
              list_zip(left_tail, right_tail))
        ENDCASES
    ENDCASES
  MEASURE left BY <<

  convolution_vc: bool =
    FORALL (x, y: list[Element]):
      length(x) = length(y)
        IMPLIES
          length(x) <= length(y)
            AND
          (FORALL
              (o1: list[pair]),
              (o2: list[Element]):
            (EXISTS (y0: list[Element]):
              y = append(y0, o2)
                AND length(y0) = length(x)
                AND o1 = list_zip(x, list_reverse(y0)))
              IMPLIES
                o1 = list_zip(x, list_reverse(y)))

END there_and_back_again_Convolution_convolutionqtvc
