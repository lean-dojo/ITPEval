% Statement-only formalization of the NTP4VC corpus artifact
% pearl/sf_HoareLogic_parityqtvc: initialization, preservation, and exit of
% a parity loop invariant over integers with inductively generated evenness.
% This file contains no proof.

sf_HoareLogic_parityqtvc: THEORY
BEGIN
  even(value: int): INDUCTIVE bool =
    value = 0
      OR
    (EXISTS (predecessor: int):
      even(predecessor)
        AND value = predecessor + 2)

  parity_vc: bool =
    FORALL (x: int):
      0 <= x IMPLIES
        0 <= x
          AND
        (even(x - x)
          OR
        (0 = 1
          AND even(x - x + 1)))
          AND
        (FORALL (y, x1: int):
          (0 <= x1
            AND
          ((y = 0
              AND even(x - x1))
            OR
           (y = 1
              AND even(x - x1 + 1))))
            IMPLIES
          (IF x1 /= 0 THEN
             ((0 <= x1
                 AND x1 - 1 < x1)
               AND
              0 <= x1 - 1
               AND
              (((1 - y = 0)
                   AND even(x - (x1 - 1)))
                OR
               ((1 - y = 1)
                   AND even(x - (x1 - 1) + 1))))
           ELSE
             (y = 0 IFF even(x))
           ENDIF))
END sf_HoareLogic_parityqtvc
