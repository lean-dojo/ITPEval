% Statement-only formalization of the NTP4VC corpus artifact
% pearl/sf_HoareLogic_slow_additionqtvc: the integer verification condition
% for a slow-addition loop, covering invariant initialization, nonnegative
% variant decrease, invariant preservation, and loop exit. This file contains
% no proof.

sf_HoareLogic_slow_additionqtvc: THEORY
BEGIN
  slow_addition_vc: bool =
    FORALL (x, z1: int):
      0 <= x IMPLIES
        0 <= x
          AND
        (FORALL (z, x1: int):
          (0 <= x1
            AND z + x1 = z1 + x)
          IMPLIES
            (IF x1 /= 0 THEN
               ((0 <= x1
                   AND x1 - 1 < x1)
                 AND
                0 <= x1 - 1
                 AND
                z + 1 + (x1 - 1) = z1 + x)
             ELSE
               z = z1 + x
             ENDIF))
END sf_HoareLogic_slow_additionqtvc
