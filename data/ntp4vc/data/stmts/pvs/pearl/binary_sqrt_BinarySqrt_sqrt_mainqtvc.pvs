% Statement-only formalization of the NTP4VC corpus artifact
% pearl/binary_sqrt_BinarySqrt_sqrt_mainqtvc: the initial verification
% condition for binary square root, restating nonnegativity of the radicand,
% positivity of the tolerance, and elementary unit identities.
% This file contains no proof.

binary_sqrt_BinarySqrt_sqrt_mainqtvc: THEORY
BEGIN
  sqrt_main_vc: bool =
    FORALL (r, eps: real):
      (0 <= r AND 0 < eps)
        IMPLIES
          (0 <= r
            AND 0 < eps
            AND (1 :: int) <= (1 :: int)
            AND eps = (1 :: real) * eps)
END binary_sqrt_BinarySqrt_sqrt_mainqtvc
