% Statement-only formalization of the NTP4VC corpus artifact
% pearl/mergesort_array_Merge_merge_usingqtvc: a merge verification condition
% for adjacent sorted list segments, temporary copying, bounds, permutation,
% and preservation outside the merged segment. This file contains no proof.

mergesort_array_Merge_merge_usingqtvc[
  elt: TYPE+,
  elt_default: elt,
  le: [elt, elt -> bool]
]: THEORY
BEGIN

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(values: list[elt], index: nat): RECURSIVE elt =
    CASES values OF
      null:
        elt_default,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  list_take(count: nat, values: list[elt]): RECURSIVE list[elt] =
    IF count = 0 THEN
      null
    ELSE
      CASES values OF
        null:
          null,
        cons(head, tail):
          cons(head, list_take(count - 1, tail))
      ENDCASES
    ENDIF
  MEASURE count

  list_drop(count: nat, values: list[elt]): RECURSIVE list[elt] =
    IF count = 0 THEN
      values
    ELSE
      CASES values OF
        null:
          null,
        cons(head, tail):
          list_drop(count - 1, tail)
      ENDCASES
    ENDIF
  MEASURE count

  nat_minus(left, right: nat): RECURSIVE nat =
    IF left = 0 OR right = 0 THEN
      left
    ELSE
      nat_minus(left - 1, right - 1)
    ENDIF
  MEASURE left + right

  list_slice(
      values: list[elt],
      lower, upper: nat): list[elt] =
    list_take(
      nat_minus(upper, lower),
      list_drop(lower, values))

  occurrence_count(
      value: elt,
      values: list[elt]): RECURSIVE nat =
    CASES values OF
      null:
        0,
      cons(head, tail):
        (IF value = head THEN 1 ELSE 0 ENDIF)
          + occurrence_count(value, tail)
    ENDCASES
  MEASURE values BY <<

  list_permutation(
      left, right: list[elt]): bool =
    FORALL (value: elt):
      occurrence_count(value, left)
        = occurrence_count(value, right)

  permut_sub(
      left, right: list[elt],
      lower, upper: nat): bool =
    length(left) = length(right)
      AND lower <= length(left)
      AND upper <= length(left)
      AND list_permutation(
        list_slice(left, lower, upper),
        list_slice(right, lower, upper))

  order_laws: bool =
    (FORALL (x: elt): le(x, x))
      AND
    (FORALL (x, y, z: elt):
      (le(x, y) AND le(y, z)) IMPLIES le(x, z))
      AND
    (FORALL (x, y: elt): le(x, y) OR le(y, x))

  sorted_sub(
      values: list[elt],
      lower, upper: int): bool =
    FORALL (i1, i2: int):
      (lower <= i1 AND i1 < i2 AND i2 < upper)
        IMPLIES
          le(
            nth_default(values, int_to_nat(i1)),
            nth_default(values, int_to_nat(i2)))

  merge_using_vc: bool =
    order_laws
      IMPLIES
        FORALL
            (l, m, r: int),
            (tmp, a: list[elt]),
            (o1: bool):
          0 <= l IMPLIES
          l <= m IMPLIES
          m <= r IMPLIES
          r <= length(tmp) IMPLIES
          length(tmp) = length(a) IMPLIES
          sorted_sub(a, l, m) IMPLIES
          sorted_sub(a, m, r) IMPLIES
          (IF l < m THEN
             o1 = (IF m < r THEN TRUE ELSE FALSE ENDIF)
           ELSE
             o1 = FALSE
           ENDIF)
            IMPLIES
              IF o1 = TRUE THEN
                (0 <= m AND m < length(a))
                  AND
                LET o2: int = m - 1
                IN
                  (0 <= o2 AND o2 < length(a))
                    AND
                  IF le(
                      nth_default(a, int_to_nat(o2)),
                      nth_default(a, int_to_nat(m))) THEN
                    sorted_sub(a, l, r)
                      AND
                    permut_sub(
                      a,
                      a,
                      int_to_nat(l),
                      int_to_nat(r))
                  ELSE
                    LET o3: int = r - l
                    IN
                      (((0 <= l
                          AND 0 <= o3
                          AND l + o3 <= length(a))
                        AND 0 <= l
                        AND l + o3 <= length(tmp))
                        AND
                      (FORALL (tmp1: list[elt]):
                        length(tmp1) = length(tmp)
                          IMPLIES
                            ((FORALL (i: int):
                              ((0 <= i AND i < l)
                                OR
                              (l + o3 <= i
                                AND i < length(tmp1)))
                                IMPLIES
                                  nth_default(
                                    tmp1,
                                    int_to_nat(i))
                                    =
                                  nth_default(
                                    tmp,
                                    int_to_nat(i)))
                              AND
                            (FORALL (i: int):
                              (l <= i AND i < l + o3)
                                IMPLIES
                                  nth_default(
                                    tmp1,
                                    int_to_nat(i))
                                    =
                                  nth_default(
                                    a,
                                    int_to_nat(l + i - l))))
                              IMPLIES
                                (((0 <= l
                                    AND l <= m
                                    AND m <= r
                                    AND r <= length(tmp1)
                                    AND length(tmp1) = length(a))
                                  AND sorted_sub(tmp1, l, m)
                                  AND sorted_sub(tmp1, m, r))
                                  AND
                                (FORALL (a1: list[elt]):
                                  length(a1) = length(a)
                                    IMPLIES
                                      (sorted_sub(a1, l, r)
                                        AND
                                      permut_sub(
                                        tmp1,
                                        a1,
                                        int_to_nat(l),
                                        int_to_nat(r))
                                        AND
                                      (FORALL (i: int):
                                        ((0 <= i AND i < l)
                                          OR
                                        (r <= i
                                          AND i < length(a1)))
                                          IMPLIES
                                            nth_default(
                                              a1,
                                              int_to_nat(i))
                                              =
                                            nth_default(
                                              a,
                                              int_to_nat(i))))
                                        IMPLIES
                                          (sorted_sub(a1, l, r)
                                            AND
                                          permut_sub(
                                            a,
                                            a1,
                                            int_to_nat(l),
                                            int_to_nat(r))
                                            AND
                                          (FORALL (i: int):
                                            ((0 <= i AND i < l)
                                              OR
                                            (r <= i
                                              AND i < length(a1)))
                                              IMPLIES
                                                nth_default(
                                                  a1,
                                                  int_to_nat(i))
                                                  =
                                                nth_default(
                                                  a,
                                                  int_to_nat(i))))))))
                  ENDIF
              ELSE
                sorted_sub(a, l, r)
                  AND
                permut_sub(
                  a,
                  a,
                  int_to_nat(l),
                  int_to_nat(r))
              ENDIF

END mergesort_array_Merge_merge_usingqtvc
