% Statement-only formalization of NTP4VC corpus artifact
% pearl/binary_sqrt_BinarySqrt_sqrtqtvc: the binary-square-root verification
% condition for doubling an integer step and bracketing a nonnegative real
% between consecutive step-spaced squares. This file contains no proof.

binary_sqrt_BinarySqrt_sqrtqtvc: THEORY
BEGIN

  real_max(x, y: real): real =
    IF x <= y THEN y ELSE x ENDIF

  integer_ceiling(x: real): int =
    -floor(-x)

  sqrtqtvc: bool =
    FORALL (r, eps0: real), (n: int), (o1: bool):
      (0 <= r
        AND 0 < eps0
        AND 1 <= n
        AND
          (IF r < (n :: real) * eps0
           THEN
             o1 =
               (IF 1 < (n :: real) * eps0
                THEN TRUE
                ELSE FALSE
                ENDIF)
           ELSE o1 = FALSE
           ENDIF))
      IMPLIES
        ((NOT (o1 = TRUE)
          IMPLIES
            LET o2: int = 2 * n,
                ceiling_value: int =
                  integer_ceiling(real_max(r, 1) / eps0)
            IN
              (0 <= ceiling_value - n
                AND ceiling_value - o2 < ceiling_value - n)
              AND 0 <= r
              AND (0 < eps0 AND 1 <= o2)
              AND
                (2 :: real) * ((n :: real) * eps0)
                  = (o2 :: real) * eps0)
        AND
          (FORALL (result: real):
            (IF o1 = TRUE
             THEN result = 0
             ELSE
               LET o2: real = 2 * ((n :: real) * eps0)
               IN
                 EXISTS (r_prime: real):
                   (r_prime * r_prime <= r
                     AND r < (r_prime + o2) * (r_prime + o2))
                   AND
                     (IF
                        (r_prime + (n :: real) * eps0)
                          * (r_prime + (n :: real) * eps0)
                          <= r
                      THEN
                        result = r_prime + (n :: real) * eps0
                      ELSE result = r_prime
                      ENDIF)
             ENDIF)
            IMPLIES
              result * result <= r
                AND
                  r
                    < (result + (n :: real) * eps0)
                        * (result + (n :: real) * eps0)))

END binary_sqrt_BinarySqrt_sqrtqtvc
