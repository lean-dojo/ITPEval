% Statement-only formalization of the NTP4VC corpus artifact
% pearl/verifythis_2021_lexicographic_permutations_1_Top_nextqtvc: the
% verification condition for computing the immediate lexicographic successor
% of an integer permutation by locating a pivot, swapping, and reversing the
% descending suffix. This file contains no proof.

verifythis_2021_lexicographic_permutations_1_Top_nextqtvc: THEORY
BEGIN

  int_list_length(values: list[int]): RECURSIVE nat =
    CASES values OF
      null:
        0,
      cons(head, tail):
        int_list_length(tail) + 1
    ENDCASES
  MEASURE values BY <<

  int_list_get(
      values: list[int],
      index: int): RECURSIVE int =
    CASES values OF
      null:
        0,
      cons(head, tail):
        IF index <= 0 THEN
          head
        ELSE
          int_list_get(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  occurrence_count(
      value: int,
      values: list[int]): RECURSIVE nat =
    CASES values OF
      null:
        0,
      cons(head, tail):
        occurrence_count(value, tail)
          + IF head = value THEN 1 ELSE 0 ENDIF
    ENDCASES
  MEASURE values BY <<

  to_seq(a: list[int]): list[int] =
    a

  bounds(index: int, values: list[int]): bool =
    0 <= index AND index < int_list_length(values)

  lex_less(p, q: list[int]): bool =
    int_list_length(p) = int_list_length(q)
      AND 0 < int_list_length(q)
      AND
        EXISTS (i: int):
          bounds(i, p)
            AND
              (FORALL (j: int):
                0 <= j AND j < i IMPLIES
                  int_list_get(p, j) = int_list_get(q, j))
            AND int_list_get(p, i) < int_list_get(q, i)

  is_permutation_of(p, a: list[int]): bool =
    int_list_length(p) = int_list_length(a)
      AND
        (FORALL (x: int):
          occurrence_count(x, p) = occurrence_count(x, a))

  descending(s: list[int], lo, hi: int): bool =
    0 <= lo
      AND lo <= hi
      AND hi <= int_list_length(s)
      AND
        (FORALL (i, j: int):
          lo <= i AND i <= j AND j < hi IMPLIES
            int_list_get(s, j) <= int_list_get(s, i))

  while_invariant(a: list[int], n, i: int): bool =
    -1 <= i
      AND i < n
      AND
        ((i = -1 AND n = 0)
          OR (0 <= i AND descending(to_seq(a), i, n)))

  unchanged_except(
      newer, older: list[int],
      left_index, right_index: int): bool =
    FORALL (k: int):
      bounds(k, newer) IMPLIES
      k /= left_index IMPLIES
      k /= right_index IMPLIES
        int_list_get(newer, k) = int_list_get(older, k)

  swap_contract(
      newer, older: list[int],
      left_index, right_index: int): bool =
    int_list_get(newer, left_index) =
        int_list_get(older, right_index)
      AND int_list_get(newer, right_index) =
        int_list_get(older, left_index)
      AND unchanged_except(
        newer, older, left_index, right_index)
      AND is_permutation_of(to_seq(newer), to_seq(older))

  copy_before(
      newer, original: list[int],
      upper: int): bool =
    FORALL (k: int):
      0 <= k AND k < upper IMPLIES
        int_list_get(newer, k) = int_list_get(original, k)

  mirror_initial(
      a1: list[int],
      i0, i, n: int): bool =
    FORALL (k: int):
      0 < k AND k < i - i0 IMPLIES
        int_list_get(a1, i0 + k) = int_list_get(a1, n - k)
          AND int_list_get(a1, n - k) =
            int_list_get(a1, i0 + k)

  middle_unchanged(
      current, at_loop: list[int],
      lower, upper: int): bool =
    FORALL (k: int):
      lower <= k AND k <= upper IMPLIES
        int_list_get(current, k) = int_list_get(at_loop, k)

  mirror_loop(
      current, at_loop: list[int],
      i0, i1, n: int): bool =
    FORALL (k: int):
      0 < k AND k < i1 - i0 IMPLIES
        int_list_get(current, i0 + k) =
          int_list_get(at_loop, n - k)
          AND int_list_get(current, n - k) =
            int_list_get(at_loop, i0 + k)

  reverse_invariant(
      original, a0, a1, a2: list[int],
      i0, z, n, j1, i1: int): bool =
    i0 < i1
      AND i0 < j1
      AND j1 < n
      AND is_permutation_of(to_seq(a2), a0)
      AND copy_before(a2, original, i0)
      AND int_list_get(a2, i0) = z
      AND i1 - i0 = n - j1
      AND middle_unchanged(a2, a1, i1, j1)
      AND mirror_loop(a2, a1, i0, i1, n)

  reverse_after_step(
      original, a0, a1, a3: list[int],
      i0, z, n, j1, i1: int): bool =
    0 <= j1 - i1
      AND j1 - 1 - (i1 + 1) < j1 - i1
      AND i0 < i1 + 1
      AND i0 < j1 - 1
      AND j1 - 1 < n
      AND is_permutation_of(to_seq(a3), a0)
      AND copy_before(a3, original, i0)
      AND int_list_get(a3, i0) = z
      AND i1 + 1 - i0 = n - (j1 - 1)
      AND middle_unchanged(a3, a1, i1 + 1, j1 - 1)
      AND mirror_loop(a3, a1, i0, i1 + 1, n)

  prefix_equal(
      p, reference: list[int],
      lower, upper: int): bool =
    FORALL (k: int):
      lower <= k AND k < upper IMPLIES
        int_list_get(p, k) = int_list_get(reference, k)

  scan_contradiction(
      p, reference: list[int],
      i0, o6, o7: int): bool =
    (o7 <= o6 + 1 IMPLIES
      prefix_equal(p, reference, i0 + 1, o7)
        AND
          (FORALL (l: int):
            o7 <= l
              AND l <= o6
              AND prefix_equal(p, reference, i0 + 1, l)
            IMPLIES
              int_list_get(p, l) = int_list_get(reference, l)
                AND prefix_equal(
                  p, reference, i0 + 1, l + 1)))
      AND NOT prefix_equal(p, reference, i0 + 1, o6 + 1)
      AND NOT (o6 + 1 < o7)

  between(
      original, a0, current, p: list[int]): bool =
    is_permutation_of(p, a0)
      AND lex_less(to_seq(original), p)
      AND lex_less(p, to_seq(current))

  lemma_branch(
      original, a0, current: list[int],
      i0, x, z, n: int,
      p: list[int]): bool =
    LET a11: list[int] = to_seq(original),
        v: int = int_list_get(p, i0),
        o6: int = n - 1,
        o7: int = i0 + 1
    IN
      IF v = x THEN
        scan_contradiction(p, a11, i0, o6, o7)
      ELSE
        v = z
          AND
            (LET a21: list[int] = to_seq(current)
             IN
               (int_list_length(a21) = int_list_length(current)
                  AND
                    (FORALL (i2: int):
                      bounds(i2, a21) IMPLIES
                        int_list_get(a21, i2) =
                          int_list_get(current, i2)))
               IMPLIES
                 scan_contradiction(p, a21, i0, o6, o7))
      ENDIF

  successor_result(
      original, a0, current: list[int]): bool =
    is_permutation_of(to_seq(current), a0)
      AND lex_less(to_seq(original), to_seq(current))
      AND
        (FORALL (p: list[int]):
          is_permutation_of(p, a0) IMPLIES
            NOT
              (lex_less(to_seq(original), p)
                AND lex_less(p, to_seq(current))))

  reverse_loop_exit(
      original, a0, current: list[int],
      i0, x, z, n: int): bool =
    (FORALL (p: list[int]):
      between(original, a0, current, p) IMPLIES
        lemma_branch(original, a0, current, i0, x, z, n, p))
      AND
        ((FORALL (p: list[int]):
          NOT between(original, a0, current, p))
        IMPLIES
          successor_result(original, a0, current))

  reverse_loop_step(
      original, a0, a1, a2: list[int],
      i0, x, z, n, j1, i1: int): bool =
    IF i1 < j1 THEN
      bounds(i1, a2)
        AND bounds(j1, a2)
        AND
          (FORALL (a3: list[int]):
            int_list_length(a3) = int_list_length(a2) IMPLIES
            swap_contract(a3, a2, i1, j1) IMPLIES
              reverse_after_step(
                original, a0, a1, a3,
                i0, z, n, j1, i1))
    ELSE
      reverse_loop_exit(
        original, a0, a2, i0, x, z, n)
    ENDIF

  reverse_loop_obligations(
      original, a0, a1: list[int],
      i0, x, z, n: int): bool =
    FORALL (j1, i1: int), (a2: list[int]):
      int_list_length(a2) = int_list_length(a1) IMPLIES
      reverse_invariant(
        original, a0, a1, a2, i0, z, n, j1, i1) IMPLIES
        reverse_loop_step(
          original, a0, a1, a2,
          i0, x, z, n, j1, i1)

  initial_reverse_state(
      original, a0, a1: list[int],
      i0, z, n, i: int): bool =
    i0 < i
      AND i0 < n - 1
      AND n - 1 < n
      AND is_permutation_of(to_seq(a1), a0)
      AND copy_before(a1, original, i0)
      AND int_list_get(a1, i0) = z
      AND i - i0 = n - (n - 1)
      AND mirror_initial(a1, i0, i, n)

  after_first_swap(
      original, a0: list[int],
      n, i, i0, x, j: int): bool =
    LET z: int = int_list_get(original, j),
        o5: int = i - 1
    IN
      bounds(o5, original)
        AND bounds(j, original)
        AND
          (FORALL (a1: list[int]):
            int_list_length(a1) = int_list_length(original) IMPLIES
            swap_contract(a1, original, o5, j) IMPLIES
              initial_reverse_state(
                original, a0, a1, i0, z, n, i)
                AND reverse_loop_obligations(
                  original, a0, a1, i0, x, z, n))

  search_j_body(
      original, a0: list[int],
      n, i, i0, x, j: int): bool =
    LET o4: int = i - 1
    IN
      bounds(o4, original)
        AND bounds(j, original)
        AND
          IF int_list_get(original, j) <=
              int_list_get(original, o4) THEN
            0 <= j
              AND j - 1 < j
              AND i <= j - 1
              AND j - 1 < n
              AND
                (FORALL (k: int):
                  j - 1 < k AND k < n IMPLIES
                    int_list_get(original, k) <= x)
          ELSE
            bounds(j, original)
              AND after_first_swap(
                original, a0, n, i, i0, x, j)
          ENDIF

  search_j(
      original, a0: list[int],
      n, i, i0, x, o3: int): bool =
    i <= o3
      AND o3 < n
      AND
        (FORALL (k: int):
          o3 < k AND k < n IMPLIES
            int_list_get(original, k) <= x)
      AND
        (FORALL (j: int):
          i <= j
            AND j < n
            AND
              (FORALL (k: int):
                j < k AND k < n IMPLIES
                  int_list_get(original, k) <= x)
          IMPLIES
            search_j_body(original, a0, n, i, i0, x, j))

  positive_case(
      original, a0: list[int],
      n, i: int): bool =
    LET i0: int = i - 1,
        x: int = int_list_get(original, i0),
        o3: int = n - 1
    IN
      bounds(i0, original)
        AND search_j(original, a0, n, i, i0, x, o3)

  no_successor(
      original, a0: list[int]): bool =
    is_permutation_of(to_seq(original), a0)
      AND
        (FORALL (p: list[int]):
          is_permutation_of(p, a0) IMPLIES
            NOT lex_less(to_seq(original), p))

  loop_condition_true(
      original: list[int],
      n, i: int): bool =
    0 <= i
      AND i - 1 < i
      AND while_invariant(original, n, i - 1)

  loop_body(
      original, a0: list[int],
      n, i: int): bool =
    (0 < i IMPLIES
      bounds(i, original)
        AND bounds(i - 1, original))
      AND
        (FORALL (condition: bool):
          (IF 0 < i THEN
             condition =
               (int_list_get(original, i) <=
                 int_list_get(original, i - 1))
           ELSE
             condition = FALSE
           ENDIF)
          IMPLIES
            IF condition THEN
              loop_condition_true(original, n, i)
            ELSIF i <= 0 THEN
              no_successor(original, a0)
            ELSE
              positive_case(original, a0, n, i)
            ENDIF)

  next_vc: bool =
    FORALL (a, a0: list[int]):
      int_list_length(a) = int_list_length(a0) IMPLIES
      is_permutation_of(to_seq(a), a0) IMPLIES
        LET n: int = int_list_length(a),
            o1: int = n - 1
        IN
          while_invariant(a, n, o1)
            AND
              (FORALL (i: int):
                while_invariant(a, n, i) IMPLIES
                  loop_body(a, a0, n, i))

END verifythis_2021_lexicographic_permutations_1_Top_nextqtvc
