% Statement-only formalization of the NTP4VC corpus artifact
% pearl/linear_probing_LinearProbing_memqtvc: the linear-probing membership
% verification condition relating a probe candidate to the table view and
% preservation of the probing invariant. This file contains no proof.

linear_probing_LinearProbing_memqtvc[
  key, keym, t: TYPE+,
  key_default: key,
  keym1: [key -> keym],
  key_eq: [key, key -> bool],
  hash: [key -> int],
  dummy: key,
  bucket: [key, int -> int],
  size: [t -> int],
  data: [t -> list[key]],
  view: [t -> [keym -> bool]],
  loc: [t -> [keym -> int]]
]: THEORY
BEGIN
  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(
      values: list[key],
      index: nat): RECURSIVE key =
    CASES values OF
      null:
        key_default,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  neq(left, right: key): bool =
    NOT key_eq(left, right)

  between(left, position, right: int): bool =
    (left <= position AND position < right)
      OR (right < left AND left <= position)
      OR (position < right AND right < left)

  count_dummy_span(
      values: list[key],
      lower: int,
      span: nat): RECURSIVE int =
    IF span = 0 THEN
      0
    ELSE
      (IF key_eq(
            nth_default(values, int_to_nat(lower)),
            dummy)
       THEN 1 ELSE 0 ENDIF)
        + count_dummy_span(values, lower + 1, span - 1)
    ENDIF
  MEASURE span

  numof(values: list[key], lower, upper: int): int =
    count_dummy_span(
      values,
      lower,
      int_to_nat(upper - lower))

  valid(
      values: list[key],
      visible: [keym -> bool],
      locations: [keym -> int]): bool =
    NOT (visible(keym1(dummy)) = TRUE)
      AND
    (FORALL (index: int):
      (0 <= index AND index < length(values))
        IMPLIES
          LET x: key =
            nth_default(values, int_to_nat(index))
          IN
            neq(x, dummy)
              IMPLIES
                visible(keym1(x)) = TRUE
                  AND locations(keym1(x)) = index)
      AND
    (LET n: int = length(values)
     IN
       FORALL (x: key):
         visible(keym1(x)) = TRUE
           IMPLIES
             LET index: int = locations(keym1(x))
             IN
               (0 <= index AND index < n)
                 AND key_eq(
                   nth_default(values, int_to_nat(index)),
                   x)
                 AND
               (FORALL (position: int):
                 (0 <= position AND position < n)
                   IMPLIES
                 between(bucket(x, n), position, index)
                   IMPLIES
                     neq(
                       nth_default(
                         values,
                         int_to_nat(position)),
                       x)
                       AND
                     neq(
                       nth_default(
                         values,
                         int_to_nat(position)),
                       dummy)))

  state_invariant(
      state_size: int,
      values: list[key],
      visible: [keym -> bool],
      locations: [keym -> int]): bool =
    0 <= state_size
      AND state_size < length(values)
      AND state_size + numof(values, 0, length(values))
        = length(values)
      AND valid(values, visible, locations)

  state_equal(left, right: t): bool =
    size(left) = size(right)
      AND data(left) = data(right)
      AND view(left) = view(right)
      AND loc(left) = loc(right)

  key_context: bool =
    (FORALL (left, right: key):
      key_eq(left, right)
        IFF keym1(left) = keym1(right))
      AND
    (FORALL (left, right: key):
      neq(left, right)
        IFF NOT (keym1(left) = keym1(right)))
      AND
    (FORALL (x: key):
      0 <= hash(x))
      AND
    (FORALL (left, right: key):
      key_eq(left, right)
        IMPLIES hash(left) = hash(right))

  bucket_context: bool =
    FORALL (n: int), (x: key):
      0 < n
        IMPLIES
          bucket(x, n) = mod(hash(x), n)
            AND 0 <= bucket(x, n)
            AND bucket(x, n) < n

  state_context: bool =
    (FORALL (self: t):
      state_invariant(
        size(self),
        data(self),
        view(self),
        loc(self)))
      AND
    (FORALL (left, right: t):
      state_equal(left, right)
        IMPLIES left = right)

  source_context: bool =
    key_context
      AND bucket_context
      AND state_context

  probe_prefix_clear(
      values: list[key],
      x: key,
      index: int): bool =
    FORALL (position: int):
      (0 <= position AND position < length(values))
        IMPLIES
      between(
        bucket(x, length(values)),
        position,
        index)
        IMPLIES
          neq(
            nth_default(values, int_to_nat(position)),
            x)
            AND
          neq(
            nth_default(values, int_to_nat(position)),
            dummy)

  probe_candidate(
      values: list[key],
      x: key,
      index: int): bool =
    (0 <= index AND index < length(values))
      AND
    (key_eq(
       nth_default(values, int_to_nat(index)),
       dummy)
      OR
     key_eq(
       nth_default(values, int_to_nat(index)),
       x))
      AND probe_prefix_clear(values, x, index)

  membership_postcondition(
      h: t,
      x: key,
      index: int): bool =
    LET selected: key =
      nth_default(data(h), int_to_nat(index))
    IN
      (0 <= index AND index < length(data(h)))
        AND
      ((neq(selected, dummy)
          IFF NOT (keym1(selected) = keym1(dummy)))
        IMPLIES
          (neq(selected, dummy)
            IFF view(h)(keym1(x)) = TRUE))

  mem_vc: bool =
    source_context
      IMPLIES
        FORALL (x: key), (h: t):
          neq(x, dummy)
            IMPLIES
              (neq(x, dummy)
                AND
               (LET n: int = length(data(h))
                IN
                  0 < n
                    AND 0 < numof(data(h), 0, n)))
                AND
              (FORALL (index: int):
                probe_candidate(data(h), x, index)
                  IMPLIES
                    membership_postcondition(h, x, index))
END linear_probing_LinearProbing_memqtvc
