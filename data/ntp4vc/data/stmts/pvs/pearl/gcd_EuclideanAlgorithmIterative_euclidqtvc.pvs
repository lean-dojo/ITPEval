% Statement-only formalization of the NTP4VC corpus artifact
% pearl/gcd_EuclideanAlgorithmIterative_euclidqtvc: the iterative Euclidean
% algorithm verification condition for nonnegative integers, preserving the
% greatest common divisor across a remainder step. This file contains no proof.

gcd_EuclideanAlgorithmIterative_euclidqtvc: THEORY
BEGIN

  trunc_div(numerator, denominator: int): int =
    IF denominator = 0 THEN
      0
    ELSIF numerator * denominator >= 0 THEN
      floor((numerator :: real) / (denominator :: real))
    ELSE
      -floor(-((numerator :: real) / (denominator :: real)))
    ENDIF

  trunc_mod(numerator, denominator: int): int =
    numerator - denominator * trunc_div(numerator, denominator)

  divides(divisor, value: int): bool =
    EXISTS (factor: int): value = divisor * factor

  is_nonnegative_gcd(gcd_value, left, right: int): bool =
    0 <= gcd_value
      AND divides(gcd_value, left)
      AND divides(gcd_value, right)
      AND
        (FORALL (common_divisor: int):
          (0 <= common_divisor
            AND divides(common_divisor, left)
            AND divides(common_divisor, right))
          IMPLIES divides(common_divisor, gcd_value))

  same_gcd(left1, right1, left2, right2: int): bool =
    EXISTS (gcd_value: int):
      is_nonnegative_gcd(gcd_value, left1, right1)
        AND is_nonnegative_gcd(gcd_value, left2, right2)

  euclid_vc: bool =
    FORALL (u0, v0: int):
      0 <= u0 IMPLIES
        0 <= v0 IMPLIES
          0 <= u0
            AND 0 <= v0
            AND
              (FORALL (v, u: int):
                ((0 <= u AND 0 <= v)
                    AND same_gcd(u, v, u0, v0))
                  IMPLIES
                    IF v /= 0 THEN
                      v /= 0
                        AND (0 <= v AND trunc_mod(u, v) < v)
                        AND (0 <= v AND 0 <= trunc_mod(u, v))
                        AND same_gcd(
                          v,
                          trunc_mod(u, v),
                          u0,
                          v0)
                    ELSE
                      is_nonnegative_gcd(u, u0, v0)
                    ENDIF)

END gcd_EuclideanAlgorithmIterative_euclidqtvc
