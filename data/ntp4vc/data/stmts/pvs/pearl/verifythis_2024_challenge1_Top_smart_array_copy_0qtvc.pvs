% Statement-only formalization of the NTP4VC corpus artifact
% pearl/verifythis_2024_challenge1_Top_smart_array_copy_0qtvc: the smart
% array-copy verification condition for shuffled fixed-size subsegments,
% elementwise array updates, nested loop invariants, and the final remainder.
% This file contains no proof.

verifythis_2024_challenge1_Top_smart_array_copy_0qtvc[
  elt: TYPE+
]: THEORY
BEGIN

  elt_array: TYPE =
    [# array_length: nat,
       array_values: [int -> elt] #]

  int_array: TYPE =
    [# int_array_length: nat,
       int_array_values: [int -> int] #]

  array_write(
      values: elt_array,
      index: int,
      value: elt): elt_array =
    (# array_length := array_length(values),
       array_values :=
         array_values(values) WITH [(index) := value] #)

  permutation(l: int, p: int_array): bool =
    (0 <= l AND l <= int_array_length(p))
      AND
    (FORALL (i: int):
      (0 <= i AND i < l)
        IMPLIES
          (0 <= int_array_values(p)(i)
            AND int_array_values(p)(i) < l))
      AND
    (FORALL (i, j: int):
      (0 <= i AND i < l)
        IMPLIES
          (0 <= j AND j < l)
            IMPLIES
              i /= j
                IMPLIES
                  int_array_values(p)(i)
                    /= int_array_values(p)(j))

  permutation_pair(
      l: int,
      p, inverse: int_array): bool =
    permutation(l, p)
      AND permutation(l, inverse)
      AND
    (FORALL (i: int):
      (0 <= i AND i < l)
        IMPLIES
          int_array_values(p)(
            int_array_values(inverse)(i)) = i)
      AND
    (FORALL (i: int):
      (0 <= i AND i < l)
        IMPLIES
          int_array_values(inverse)(
            int_array_values(p)(i)) = i)

  valid_chunk(
      values: elt_array,
      offset, chunk_length: int): bool =
    0 <= offset
      AND offset <= offset + chunk_length
      AND offset + chunk_length <= array_length(values)

  copy(
      source, destination: elt_array,
      offset, chunk_length: int): bool =
    valid_chunk(source, offset, chunk_length)
      AND array_length(source) = array_length(destination)
      AND
    (FORALL (i: int):
      (offset <= i AND i < offset + chunk_length)
        IMPLIES
          array_values(destination)(i)
            = array_values(source)(i))

  copied_permuted_chunks(
      source, destination: elt_array,
      start: int,
      sigma: int_array,
      k, upper: int): bool =
    FORALL (j_prime: int):
      (0 <= j_prime AND j_prime < upper)
        IMPLIES
          copy(
            source,
            destination,
            start + int_array_values(sigma)(j_prime) * k,
            k)

  chunk_loop_invariant(
      source, destination: elt_array,
      start, s, m, k: int,
      sigma: int_array,
      upper: int): bool =
    copy(source, destination, 0, s * m)
      AND
    copied_permuted_chunks(
      source, destination, start, sigma, k, upper)

  element_loop_invariant(
      source, destination: elt_array,
      start, startj, s, m, k: int,
      sigma: int_array,
      j, copied_length: int): bool =
    chunk_loop_invariant(
      source, destination, start, s, m, k, sigma, j)
      AND copy(source, destination, startj, copied_length)

  inner_write_step(
      source, destination: elt_array,
      start, startj, s, m, k: int,
      sigma: int_array,
      j, i: int): bool =
    LET source_index: int = startj + i,
        copied_value: elt = array_values(source)(source_index),
        destination_index: int = startj + i,
        updated: elt_array =
          array_write(destination, destination_index, copied_value)
    IN
      (0 <= source_index
        AND source_index < array_length(source))
        AND
      (0 <= destination_index
        AND destination_index < array_length(destination))
        AND
      (array_length(updated) = array_length(destination)
        IMPLIES
          array_values(updated)
            =
          array_values(destination)
            WITH [(destination_index) := copied_value]
        IMPLIES
          element_loop_invariant(
            source,
            updated,
            start,
            startj,
            s,
            m,
            k,
            sigma,
            j,
            i + 1))

  element_loop_steps(
      source, destination: elt_array,
      start, startj, s, m, k, o3: int,
      sigma: int_array,
      j: int): bool =
    (FORALL (i: int):
      ((0 <= i AND i <= o3)
        AND
       element_loop_invariant(
         source,
         destination,
         start,
         startj,
         s,
         m,
         k,
         sigma,
         j,
         i))
        IMPLIES
          inner_write_step(
            source,
            destination,
            start,
            startj,
            s,
            m,
            k,
            sigma,
            j,
            i))
      AND
    (element_loop_invariant(
       source,
       destination,
       start,
       startj,
       s,
       m,
       k,
       sigma,
       j,
       o3 + 1)
      IMPLIES
        chunk_loop_invariant(
          source,
          destination,
          start,
          s,
          m,
          k,
          sigma,
          j + 1))

  element_loop_nonnegative(
      source, destination: elt_array,
      start, startj, s, m, k, o3: int,
      sigma: int_array,
      j: int): bool =
    element_loop_invariant(
      source,
      destination,
      start,
      startj,
      s,
      m,
      k,
      sigma,
      j,
      0)
      AND
    (FORALL (next_destination: elt_array):
      array_length(next_destination) = array_length(destination)
        IMPLIES
          element_loop_steps(
            source,
            next_destination,
            start,
            startj,
            s,
            m,
            k,
            o3,
            sigma,
            j))

  element_loop_obligation(
      source, destination: elt_array,
      start, startj, s, m, k, o3: int,
      sigma: int_array,
      j: int): bool =
    (0 <= o3 + 1
      IMPLIES
        element_loop_nonnegative(
          source,
          destination,
          start,
          startj,
          s,
          m,
          k,
          o3,
          sigma,
          j))
      AND
    (o3 + 1 < 0
      IMPLIES
        chunk_loop_invariant(
          source,
          destination,
          start,
          s,
          m,
          k,
          sigma,
          j + 1))

  chunk_step(
      source, destination: elt_array,
      start, s, m, k: int,
      sigma: int_array,
      j: int): bool =
    (0 <= j AND j < int_array_length(sigma))
      AND
    (LET startj: int =
       start + int_array_values(sigma)(j) * k,
         o3: int = k - 1
     IN
       element_loop_obligation(
         source,
         destination,
         start,
         startj,
         s,
         m,
         k,
         o3,
         sigma,
         j))

  chunk_loop_steps(
      source, destination: elt_array,
      start, s, m, k, o2: int,
      sigma: int_array): bool =
    (FORALL (j: int):
      ((0 <= j AND j <= o2)
        AND
       chunk_loop_invariant(
         source, destination, start, s, m, k, sigma, j))
        IMPLIES
          chunk_step(
            source,
            destination,
            start,
            s,
            m,
            k,
            sigma,
            j))
      AND
    (chunk_loop_invariant(
       source,
       destination,
       start,
       s,
       m,
       k,
       sigma,
       o2 + 1)
      IMPLIES
        copy(source, destination, 0, (s + 1) * m))

  chunk_loop_nonnegative(
      source, destination: elt_array,
      start, s, m, k, o2: int,
      sigma: int_array): bool =
    chunk_loop_invariant(
      source, destination, start, s, m, k, sigma, 0)
      AND
    (FORALL (next_destination: elt_array):
      array_length(next_destination) = array_length(destination)
        IMPLIES
          chunk_loop_steps(
            source,
            next_destination,
            start,
            s,
            m,
            k,
            o2,
            sigma))

  shuffled_segment_obligation(
      source, destination: elt_array,
      s, m, k, l: int,
      sigma, inverse_sigma: int_array): bool =
    ((int_array_length(sigma) = int_array_length(inverse_sigma)
       AND int_array_length(inverse_sigma) = l)
      AND permutation_pair(l, sigma, inverse_sigma))
      IMPLIES
        (LET start: int = s * m,
             o2: int = l - 1
         IN
           (0 <= o2 + 1
             IMPLIES
               chunk_loop_nonnegative(
                 source,
                 destination,
                 start,
                 s,
                 m,
                 k,
                 o2,
                 sigma))
             AND
           (o2 + 1 < 0
             IMPLIES
               copy(source, destination, 0, (s + 1) * m)))

  outer_step(
      source, destination: elt_array,
      s, m, k, l: int): bool =
    0 < l
      AND
    (FORALL (sigma, inverse_sigma: int_array):
      shuffled_segment_obligation(
        source,
        destination,
        s,
        m,
        k,
        l,
        sigma,
        inverse_sigma))

  remainder_write_step(
      source, destination: elt_array,
      last, q, m, i: int): bool =
    LET source_index: int = last + i,
        copied_value: elt = array_values(source)(source_index),
        destination_index: int = last + i,
        updated: elt_array =
          array_write(destination, destination_index, copied_value)
    IN
      (0 <= source_index
        AND source_index < array_length(source))
        AND
      (0 <= destination_index
        AND destination_index < array_length(destination))
        AND
      (array_length(updated) = array_length(destination)
        IMPLIES
          array_values(updated)
            =
          array_values(destination)
            WITH [(destination_index) := copied_value]
        IMPLIES
          (copy(source, updated, 0, q * m)
            AND copy(source, updated, last, i + 1)))

  remainder_loop_steps(
      source, destination: elt_array,
      last, q, m, o2, total: int): bool =
    (FORALL (i: int):
      ((0 <= i AND i <= o2)
        AND copy(source, destination, 0, q * m)
        AND copy(source, destination, last, i))
        IMPLIES
          remainder_write_step(
            source, destination, last, q, m, i))
      AND
    ((copy(source, destination, 0, q * m)
       AND copy(source, destination, last, o2 + 1))
      IMPLIES
        copy(source, destination, 0, total))

  remainder_loop_nonnegative(
      source, destination: elt_array,
      last, q, m, o2, total: int): bool =
    (copy(source, destination, 0, q * m)
      AND copy(source, destination, last, 0))
      AND
    (FORALL (next_destination: elt_array):
      array_length(next_destination) = array_length(destination)
        IMPLIES
          remainder_loop_steps(
            source,
            next_destination,
            last,
            q,
            m,
            o2,
            total))

  remainder_obligation(
      source, destination: elt_array,
      q, m, r, total: int): bool =
    LET last: int = q * m,
        o2: int = r - 1
    IN
      (0 <= o2 + 1
        IMPLIES
          remainder_loop_nonnegative(
            source,
            destination,
            last,
            q,
            m,
            o2,
            total))
        AND
      (o2 + 1 < 0
        IMPLIES
          copy(source, destination, 0, total))

  outer_destination_obligation(
      source, destination: elt_array,
      m, k, l, q, r, o1, total: int): bool =
    (FORALL (s: int):
      ((0 <= s AND s <= o1)
        AND copy(source, destination, 0, s * m))
        IMPLIES
          outer_step(source, destination, s, m, k, l))
      AND
    (copy(source, destination, 0, (o1 + 1) * m)
      IMPLIES
        remainder_obligation(
          source, destination, q, m, r, total))

  outer_loop_nonnegative(
      source, destination: elt_array,
      m, k, l, q, r, o1: int): bool =
    copy(source, destination, 0, 0 * m)
      AND
    (FORALL (next_destination: elt_array):
      array_length(next_destination) = array_length(destination)
        IMPLIES
          outer_destination_obligation(
            source,
            next_destination,
            m,
            k,
            l,
            q,
            r,
            o1,
            array_length(destination)))

  smart_array_copy_0_vc: bool =
    FORALL
        (source, destination: elt_array),
        (k, l, q, r: int):
      (array_length(source) = array_length(destination)
        AND 0 < array_length(destination)
        AND 0 < k
        AND 0 < l
        AND 0 <= q
        AND 0 <= r
        AND r < k * l
        AND array_length(destination) = q * k * l + r)
      IMPLIES
        (LET m: int = k * l,
             o1: int = q - 1
         IN
           (0 <= o1 + 1
             IMPLIES
               outer_loop_nonnegative(
                 source, destination, m, k, l, q, r, o1))
             AND
           (o1 + 1 < 0
             IMPLIES
               remainder_obligation(
                 source,
                 destination,
                 q,
                 m,
                 r,
                 array_length(destination))))

END verifythis_2024_challenge1_Top_smart_array_copy_0qtvc
