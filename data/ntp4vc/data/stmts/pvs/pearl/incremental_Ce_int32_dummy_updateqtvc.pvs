% Statement-only formalization of the NTP4VC corpus artifact
% pearl/incremental_Ce_int32_dummy_updateqtvc: a dummy 32-bit signed-integer
% update verification condition with overflow bounds and nested update
% equalities. This file contains no proof.

incremental_Ce_int32_dummy_updateqtvc: THEORY
BEGIN

  IMPORTING bv[32], bv_nat[32]

  word32: TYPE = bvec[32]

  signed32(value: word32): int =
    IF value(31) THEN
      bv2nat[32](value) - 4294967296
    ELSE
      bv2nat[32](value)
    ENDIF

  int32_in_bounds(value: int): bool =
    -2147483648 <= value AND value <= 2147483647

  dummy_update_vc: bool =
    FORALL (r: word32):
      signed32(r) = 22
        IMPLIES
          int32_in_bounds(42)
            AND
              (FORALL (o1: word32):
                signed32(o1) = 42
                  IMPLIES
                    int32_in_bounds(signed32(o1) + signed32(o1))
                      AND
                        (FORALL (o2: word32):
                          signed32(o2)
                              = signed32(o1) + signed32(o1)
                            IMPLIES signed32(o2) = 42))

END incremental_Ce_int32_dummy_updateqtvc
