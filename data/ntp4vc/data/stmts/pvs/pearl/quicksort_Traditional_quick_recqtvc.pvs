% Statement-only formalization of the NTP4VC corpus artifact
% pearl/quicksort_Traditional_quick_recqtvc: the traditional two-scan
% quicksort recursion verification condition for partition invariants,
% scan and recursion variants, swaps, sorting, and subrange permutations.
% This file contains no proof.

quicksort_Traditional_quick_recqtvc: THEORY
BEGIN
  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(values: list[int], index: nat): RECURSIVE int =
    CASES values OF
      null: 0,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  list_set(
      values: list[int],
      index: nat,
      value: int): RECURSIVE list[int] =
    CASES values OF
      null: null,
      cons(head, tail):
        IF index = 0 THEN
          cons(value, tail)
        ELSE
          cons(head, list_set(tail, index - 1, value))
        ENDIF
    ENDCASES
  MEASURE values BY <<

  list_take(count: nat, values: list[int]): RECURSIVE list[int] =
    IF count = 0 THEN
      null
    ELSE
      CASES values OF
        null: null,
        cons(head, tail):
          cons(head, list_take(count - 1, tail))
      ENDCASES
    ENDIF
  MEASURE count

  list_drop(count: nat, values: list[int]): RECURSIVE list[int] =
    IF count = 0 THEN
      values
    ELSE
      CASES values OF
        null: null,
        cons(head, tail):
          list_drop(count - 1, tail)
      ENDCASES
    ENDIF
  MEASURE count

  nat_minus(left, right: nat): RECURSIVE nat =
    IF left = 0 OR right = 0 THEN
      left
    ELSE
      nat_minus(left - 1, right - 1)
    ENDIF
  MEASURE left + right

  list_slice(values: list[int], lower, upper: nat): list[int] =
    list_take(nat_minus(upper, lower), list_drop(lower, values))

  occurrence_count(value: int, values: list[int]): RECURSIVE nat =
    CASES values OF
      null: 0,
      cons(head, tail):
        (IF value = head THEN 1 ELSE 0 ENDIF)
          + occurrence_count(value, tail)
    ENDCASES
  MEASURE values BY <<

  list_permutation(left, right: list[int]): bool =
    FORALL (value: int):
      occurrence_count(value, left) = occurrence_count(value, right)

  permut_sub_prime(
      left, right: list[int],
      lower, upper: nat): bool =
    length(left) = length(right)
      AND list_slice(left, 0, lower) = list_slice(right, 0, lower)
      AND list_slice(left, upper, length(left))
        = list_slice(right, upper, length(right))
      AND list_permutation(
        list_slice(left, lower, upper),
        list_slice(right, lower, upper))

  sorted_sub(values: list[int], lower, upper: int): bool =
    FORALL (i1, i2: int):
      (lower <= i1 AND i1 <= i2 AND i2 < upper)
        IMPLIES
          nth_default(values, int_to_nat(i1))
            <= nth_default(values, int_to_nat(i2))

  array_exchange(
      before, after: list[int],
      i, j: int): bool =
    after =
      list_set(
        list_set(
          before,
          int_to_nat(i),
          nth_default(before, int_to_nat(j))),
        int_to_nat(j),
        nth_default(before, int_to_nat(i)))

  bounds(index: int, values: list[int]): bool =
    0 <= index AND index < length(values)

  initial_invariant(
      values: list[int],
      l, r, pivot: int): bool =
    (l <= l AND l < r - 1)
      AND
    (FORALL (k: int):
      (l <= k AND k <= l)
        IMPLIES nth_default(values, int_to_nat(k)) <= pivot)
      AND
    (l < r AND r <= r)
      AND
    (FORALL (k: int):
      (r <= k AND k < r)
        IMPLIES pivot <= nth_default(values, int_to_nat(k)))
      AND
    permut_sub_prime(
      values, values, int_to_nat(l), int_to_nat(r))
      AND
    nth_default(values, int_to_nat(l)) = pivot

  outer_invariant(
      original, current: list[int],
      l, r, i, j, pivot: int): bool =
    (l <= i AND i < r - 1)
      AND
    (FORALL (k: int):
      (l <= k AND k <= i)
        IMPLIES nth_default(current, int_to_nat(k)) <= pivot)
      AND
    (l < j AND j <= r)
      AND
    (FORALL (k: int):
      (j <= k AND k < r)
        IMPLIES pivot <= nth_default(current, int_to_nat(k)))
      AND
    permut_sub_prime(
      original, current, int_to_nat(l), int_to_nat(r))
      AND
    nth_default(current, int_to_nat(l)) = pivot

  increment_i_result(
      current: list[int],
      l, r, i, pivot: int): bool =
    (i < i + 1 AND i + 1 < r)
      AND
    (FORALL (k: int):
      (l <= k AND k < i + 1)
        IMPLIES nth_default(current, int_to_nat(k)) <= pivot)

  i_scan_invariant(
      current: list[int],
      l, r, i, i1, pivot: int): bool =
    (i < i1 AND i1 < r)
      AND
    (FORALL (k: int):
      (l <= k AND k < i1)
        IMPLIES nth_default(current, int_to_nat(k)) <= pivot)

  decrement_j_result(
      current: list[int],
      l, j, r, pivot: int): bool =
    (l <= j - 1 AND j - 1 < j)
      AND
    (FORALL (k: int):
      (j - 1 < k AND k < r)
        IMPLIES pivot <= nth_default(current, int_to_nat(k)))

  j_scan_invariant(
      current: list[int],
      l, j, r, j1, pivot: int): bool =
    (l <= j1 AND j1 < j)
      AND
    (FORALL (k: int):
      (j1 < k AND k < r)
        IMPLIES pivot <= nth_default(current, int_to_nat(k)))

  continue_j_result(
      current: list[int],
      l, j, r, j1, pivot: int): bool =
    (0 <= j1 AND j1 - 1 < j1)
      AND
    (l <= j1 - 1 AND j1 - 1 < j)
      AND
    (FORALL (k: int):
      (j1 - 1 < k AND k < r)
        IMPLIES pivot <= nth_default(current, int_to_nat(k)))

  recursive_calls(
      original, partitioned: list[int],
      l, split, r: int): bool =
    ((0 <= r - l AND split - l < r - l)
      AND 0 <= l
      AND l <= split
      AND split <= length(partitioned))
      AND
    (FORALL (left_sorted: list[int]):
      length(left_sorted) = length(partitioned)
        IMPLIES
      (sorted_sub(left_sorted, l, split)
        AND permut_sub_prime(
          partitioned,
          left_sorted,
          int_to_nat(l),
          int_to_nat(split)))
        IMPLIES
      LET right_start: int = split + 1 IN
        ((0 <= r - l AND r - right_start < r - l)
          AND 0 <= right_start
          AND right_start <= r
          AND r <= length(left_sorted))
          AND
        (FORALL (right_sorted: list[int]):
          length(right_sorted) = length(left_sorted)
            IMPLIES
          (sorted_sub(right_sorted, right_start, r)
            AND permut_sub_prime(
              left_sorted,
              right_sorted,
              int_to_nat(right_start),
              int_to_nat(r)))
            IMPLIES
          (sorted_sub(right_sorted, l, r)
            AND permut_sub_prime(
              original,
              right_sorted,
              int_to_nat(l),
              int_to_nat(r)))))

  final_swap_branch(
      original, current: list[int],
      l, r, split: int): bool =
    (bounds(l, current) AND bounds(split, current))
      AND
    (FORALL (partitioned: list[int]):
      length(partitioned) = length(current)
        IMPLIES
      array_exchange(current, partitioned, l, split)
        IMPLIES
      recursive_calls(original, partitioned, l, split, r))

  middle_swap_result(
      original, updated: list[int],
      l, r, i, j, i1, j1, pivot: int): bool =
    (0 <= j - i AND j1 - i1 < j - i)
      AND
    (l <= i1 AND i1 < r - 1)
      AND
    (FORALL (k: int):
      (l <= k AND k <= i1)
        IMPLIES nth_default(updated, int_to_nat(k)) <= pivot)
      AND
    (l < j1 AND j1 <= r)
      AND
    (FORALL (k: int):
      (j1 <= k AND k < r)
        IMPLIES pivot <= nth_default(updated, int_to_nat(k)))
      AND
    permut_sub_prime(
      original, updated, int_to_nat(l), int_to_nat(r))
      AND
    nth_default(updated, int_to_nat(l)) = pivot

  middle_swap_branch(
      original, current: list[int],
      l, r, i, j, i1, j1, pivot: int): bool =
    (bounds(i1, current) AND bounds(j1, current))
      AND
    (FORALL (updated: list[int]):
      length(updated) = length(current)
        IMPLIES
      array_exchange(current, updated, i1, j1)
        IMPLIES
      middle_swap_result(
        original, updated, l, r, i, j, i1, j1, pivot))

  j_scan_step(
      original, current: list[int],
      l, r, i, j, i1, j1, pivot: int): bool =
    bounds(j1, current)
      AND
    IF pivot < nth_default(current, int_to_nat(j1)) THEN
      IF j1 = l THEN
        IF j1 <= i1 THEN
          final_swap_branch(original, current, l, r, j1)
        ELSE
          middle_swap_branch(
            original, current, l, r, i, j, i1, j1, pivot)
        ENDIF
      ELSE
        continue_j_result(current, l, j, r, j1, pivot)
      ENDIF
    ELSE
      IF j1 <= i1 THEN
        final_swap_branch(original, current, l, r, j1)
      ELSE
        middle_swap_branch(
          original, current, l, r, i, j, i1, j1, pivot)
      ENDIF
    ENDIF

  j_scan_loop(
      original, current: list[int],
      l, r, i, j, i1, pivot: int): bool =
    FORALL (j1: int):
      j_scan_invariant(current, l, j, r, j1, pivot)
        IMPLIES
      j_scan_step(
        original, current, l, r, i, j, i1, j1, pivot)

  i_scan_step(
      original, current: list[int],
      l, r, i, j, i1, pivot: int): bool =
    bounds(i1, current)
      AND
    IF nth_default(current, int_to_nat(i1)) < pivot THEN
      IF i1 = r - 1 THEN
        decrement_j_result(current, l, j, r, pivot)
          AND
        j_scan_loop(
          original, current, l, r, i, j, i1, pivot)
      ELSE
        (0 <= r - i1 AND r - (i1 + 1) < r - i1)
          AND
        (i < i1 + 1 AND i1 + 1 < r)
          AND
        (FORALL (k: int):
          (l <= k AND k < i1 + 1)
            IMPLIES
              nth_default(current, int_to_nat(k)) <= pivot)
      ENDIF
    ELSE
      decrement_j_result(current, l, j, r, pivot)
        AND
      j_scan_loop(
        original, current, l, r, i, j, i1, pivot)
    ENDIF

  i_scan_loop(
      original, current: list[int],
      l, r, i, j, pivot: int): bool =
    FORALL (i1: int):
      i_scan_invariant(current, l, r, i, i1, pivot)
        IMPLIES
      i_scan_step(
        original, current, l, r, i, j, i1, pivot)

  outer_step(
      original, current: list[int],
      l, r, i, j, pivot: int): bool =
    increment_i_result(current, l, r, i, pivot)
      AND
    i_scan_loop(original, current, l, r, i, j, pivot)

  outer_obligation(
      original: list[int],
      l, r, pivot: int): bool =
    FORALL (j, i: int), (current: list[int]):
      length(current) = length(original)
        IMPLIES
      outer_invariant(original, current, l, r, i, j, pivot)
        IMPLIES
      outer_step(original, current, l, r, i, j, pivot)

  base_case(values: list[int], l, r: int): bool =
    sorted_sub(values, l, r)
      AND
    permut_sub_prime(
      values, values, int_to_nat(l), int_to_nat(r))

  quick_rec_vc: bool =
    FORALL (l, r: int), (a: list[int]):
      0 <= l
        IMPLIES
      l <= r
        IMPLIES
      r <= length(a)
        IMPLIES
      IF r <= l + 1 THEN
        base_case(a, l, r)
      ELSE
        bounds(l, a)
          AND
        LET pivot: int = nth_default(a, int_to_nat(l)) IN
          initial_invariant(a, l, r, pivot)
            AND
          outer_obligation(a, l, r, pivot)
      ENDIF
END quicksort_Traditional_quick_recqtvc
