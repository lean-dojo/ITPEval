% Statement-only formalization of the NTP4VC corpus artifact
% pearl/braun_trees_BraunHeaps_addqtvc: the Braun-heap insertion verification
% condition for heap order, Braun balance, element occurrences, and tree size.
% This file contains no proof.

braun_trees_BraunHeaps_addqtvc[
  elt: TYPE+
]: THEORY
BEGIN

  tree: DATATYPE
  BEGIN
    Empty: Empty?
    Node(
      left_subtree: tree,
      root_element: elt,
      right_subtree: tree): Node?
  END tree

  preorder_laws(leq: [elt, elt -> bool]): bool =
    (FORALL (x: elt): leq(x, x))
      AND
    (FORALL (x, y, z: elt):
      (leq(x, y) AND leq(y, z)) IMPLIES leq(x, z))
      AND
    (FORALL (x, y: elt): leq(x, y) OR leq(y, x))

  tree_size(values: tree): RECURSIVE int =
    CASES values OF
      Empty:
        0,
      Node(left, root, right):
        1 + tree_size(left) + tree_size(right)
    ENDCASES
  MEASURE values BY <<

  occ(element: elt, values: tree): RECURSIVE int =
    CASES values OF
      Empty:
        0,
      Node(left, root, right):
        (IF root = element THEN 1 ELSE 0 ENDIF)
          + occ(element, left)
          + occ(element, right)
    ENDCASES
  MEASURE values BY <<

  le_root(
      leq: [elt, elt -> bool],
      element: elt,
      values: tree): bool =
    CASES values OF
      Empty:
        TRUE,
      Node(left, root, right):
        leq(element, root)
    ENDCASES

  heap(
      leq: [elt, elt -> bool],
      values: tree): RECURSIVE bool =
    CASES values OF
      Empty:
        TRUE,
      Node(left, root, right):
        le_root(leq, root, left)
          AND heap(leq, left)
          AND le_root(leq, root, right)
          AND heap(leq, right)
    ENDCASES
  MEASURE values BY <<

  inv(values: tree): RECURSIVE bool =
    CASES values OF
      Empty:
        TRUE,
      Node(left, root, right):
        (tree_size(left) = tree_size(right)
          OR tree_size(left) = tree_size(right) + 1)
          AND inv(left)
          AND inv(right)
    ENDCASES
  MEASURE values BY <<

  right_is_child(values, expected_right: tree): bool =
    CASES values OF
      Empty:
        FALSE,
      Node(left, root, right):
        left = expected_right OR right = expected_right
    ENDCASES

  initial_obligation(
      leq: [elt, elt -> bool],
      values: tree): bool =
    CASES values OF
      Empty:
        TRUE,
      Node(left, root, right):
        right_is_child(values, right)
          AND heap(leq, right)
          AND inv(right)
    ENDCASES

  result_antecedent(
      leq: [elt, elt -> bool],
      values: tree,
      inserted: elt,
      result: tree): bool =
    CASES values OF
      Empty:
        result = Node(Empty, inserted, Empty),
      Node(left, root, right):
        IF leq(inserted, root) THEN
          EXISTS (recursive_result: tree):
            (heap(leq, recursive_result)
              AND inv(recursive_result)
              AND occ(root, recursive_result)
                    = occ(root, right) + 1
              AND
                (FORALL (element: elt):
                  element /= root
                    IMPLIES
                      occ(element, recursive_result)
                        = occ(element, right))
              AND tree_size(recursive_result)
                    = tree_size(right) + 1)
            AND result =
                  Node(recursive_result, inserted, left)
        ELSE
          EXISTS (recursive_result: tree):
            (heap(leq, recursive_result)
              AND inv(recursive_result)
              AND occ(inserted, recursive_result)
                    = occ(inserted, right) + 1
              AND
                (FORALL (element: elt):
                  element /= inserted
                    IMPLIES
                      occ(element, recursive_result)
                        = occ(element, right))
              AND tree_size(recursive_result)
                    = tree_size(right) + 1)
            AND result =
                  Node(recursive_result, root, left)
        ENDIF
    ENDCASES

  result_postcondition(
      leq: [elt, elt -> bool],
      original: tree,
      inserted: elt,
      result: tree): bool =
    heap(leq, result)
      AND inv(result)
      AND occ(inserted, result) = occ(inserted, original) + 1
      AND
        (FORALL (element: elt):
          element /= inserted
            IMPLIES
              occ(element, result) = occ(element, original))
      AND tree_size(result) = tree_size(original) + 1

  add_vc: bool =
    FORALL
        (leq: [elt, elt -> bool]),
        (values: tree),
        (inserted: elt):
      (preorder_laws(leq)
        AND heap(leq, values)
        AND inv(values))
      IMPLIES
        (initial_obligation(leq, values)
          AND
            (FORALL (result: tree):
              result_antecedent(
                leq, values, inserted, result)
              IMPLIES
                result_postcondition(
                  leq, values, inserted, result)))

END braun_trees_BraunHeaps_addqtvc
