% Statement-only formalization of the NTP4VC corpus artifact
% pearl/bellman_ford_BellmanFord_relaxqtvc: the Bellman-Ford verification
% condition that relaxing one unprocessed edge preserves the path-distance
% invariant. This file contains no proof.

bellman_ford_BellmanFord_relaxqtvc[
  vertex: TYPE+,
  map_value: TYPE+
]: THEORY
BEGIN
  edge_pair: TYPE = [vertex, vertex]

  IMPORTING finite_sets[vertex], finite_sets[edge_pair]

  intinf: DATATYPE
  BEGIN
    Finite(finite_value: int): Finite?
    Infinite: Infinite?
  END intinf

  graph_environment: TYPE =
    [# graph_vertices: finite_set[vertex],
       graph_edges: finite_set[edge_pair],
       source_vertex: vertex,
       edge_weight: [vertex, vertex -> int] #]

  map_environment: TYPE =
    [# map_contents_function: [map_value -> [vertex -> intinf]],
       map_read_function: [map_value, vertex -> intinf],
       map_update_function: [map_value, vertex, intinf -> map_value] #]

  edge(graph: graph_environment, x, y: vertex): bool =
    graph_edges(graph)((x, y))

  intinf_add(left, right: intinf): intinf =
    CASES left OF
      Infinite:
        Infinite,
      Finite(left_value):
        CASES right OF
          Infinite:
            Infinite,
          Finite(right_value):
            Finite(left_value + right_value)
        ENDCASES
    ENDCASES

  intinf_lt(left, right: intinf): bool =
    CASES left OF
      Infinite:
        FALSE,
      Finite(left_value):
        CASES right OF
          Infinite:
            TRUE,
          Finite(right_value):
            left_value < right_value
        ENDCASES
    ENDCASES

  path(
      graph: graph_environment,
      start: vertex,
      vertices_list: list[vertex],
      destination: vertex): RECURSIVE bool =
    CASES vertices_list OF
      null:
        start = destination,
      cons(head, tail):
        head = start
          AND
        (EXISTS (next_vertex: vertex):
          edge(graph, start, next_vertex)
            AND path(graph, next_vertex, tail, destination))
    ENDCASES
  MEASURE vertices_list BY <<

  path_weight(
      graph: graph_environment,
      vertices_list: list[vertex],
      destination: vertex): RECURSIVE int =
    CASES vertices_list OF
      null:
        0,
      cons(first_vertex, tail):
        CASES tail OF
          null:
            edge_weight(graph)(first_vertex, destination),
          cons(second_vertex, rest):
            edge_weight(graph)(first_vertex, second_vertex)
              + path_weight(graph, tail, destination)
        ENDCASES
    ENDCASES
  MEASURE vertices_list BY <<

  graph_specification(graph: graph_environment): bool =
    graph_vertices(graph)(source_vertex(graph))
      AND
    (FORALL (x, y: vertex):
      edge(graph, x, y)
        IMPLIES
          graph_vertices(graph)(x)
            AND graph_vertices(graph)(y))

  map_specification(maps: map_environment): bool =
    (FORALL (map_object: map_value), (point: vertex):
      map_read_function(maps)(map_object, point)
        = map_contents_function(maps)(map_object)(point))
      AND
    (FORALL
      (map_object: map_value),
      (updated_point, point: vertex),
      (value: intinf):
        map_contents_function(maps)
          (map_update_function(
            maps)(map_object, updated_point, value))(point)
          =
        (IF point = updated_point THEN
           value
         ELSE
           map_contents_function(maps)(map_object)(point)
         ENDIF))

  inv1(
      graph: graph_environment,
      maps: map_environment,
      map_object: map_value,
      pass: int,
      via: finite_set[edge_pair]): bool =
    FORALL (v: vertex):
      graph_vertices(graph)(v)
      IMPLIES
        CASES map_read_function(maps)(map_object, v) OF
          Finite(distance):
            (EXISTS (route: list[vertex]):
              path(
                graph, source_vertex(graph), route, v)
                AND path_weight(graph, route, v) = distance)
              AND
            (FORALL (route: list[vertex]):
              path(
                graph, source_vertex(graph), route, v)
                IMPLIES
                  (length(route) :: int) < pass
                    IMPLIES
                      distance
                        <= path_weight(graph, route, v))
              AND
            (FORALL (u: vertex), (route: list[vertex]):
              path(
                graph, source_vertex(graph), route, u)
                IMPLIES
                  (length(route) :: int) < pass
                    IMPLIES
                      via((u, v))
                        IMPLIES
                          distance
                            <= path_weight(
                                 graph, route, u)
                              + edge_weight(graph)(u, v)),
          Infinite:
            (FORALL (route: list[vertex]):
              path(
                graph, source_vertex(graph), route, v)
                IMPLIES
                  pass <= (length(route) :: int))
              AND
            (FORALL (u: vertex):
              via((u, v))
                IMPLIES
                  (FORALL (route: list[vertex]):
                    path(
                      graph, source_vertex(graph),
                      route, u)
                      IMPLIES
                        pass <= (length(route) :: int)))
        ENDCASES

  relax_vc: bool =
    FORALL
      (graph: graph_environment),
      (maps: map_environment),
      (pass: int),
      (u, v: vertex),
      (via: finite_set[edge_pair]),
      (map_object: map_value):
        graph_specification(graph)
          AND map_specification(maps)
        IMPLIES
          1 <= pass
        IMPLIES
          edge(graph, u, v)
        IMPLIES
          NOT via((u, v))
        IMPLIES
          inv1(graph, maps, map_object, pass, via)
        IMPLIES
          LET source_value: intinf =
                map_read_function(maps)(map_object, u)
          IN
            source_value
              = map_contents_function(maps)(map_object)(u)
            IMPLIES
              LET candidate_value: intinf =
                    intinf_add(
                      source_value,
                      Finite(edge_weight(graph)(u, v))),
                  destination_value: intinf =
                    map_read_function(maps)(map_object, v)
              IN
                destination_value
                  = map_contents_function(maps)(map_object)(v)
                IMPLIES
                  IF intinf_lt(
                       candidate_value, destination_value)
                  THEN
                    inv1(
                      graph,
                      maps,
                      map_update_function(maps)(
                        map_object, v, candidate_value),
                      pass,
                      add((u, v), via))
                  ELSE
                    inv1(
                      graph,
                      maps,
                      map_object,
                      pass,
                      add((u, v), via))
                  ENDIF
END bellman_ford_BellmanFord_relaxqtvc
