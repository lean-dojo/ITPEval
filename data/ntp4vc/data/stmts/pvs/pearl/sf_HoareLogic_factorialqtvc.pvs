% Statement-only formalization of the NTP4VC corpus artifact
% pearl/sf_HoareLogic_factorialqtvc: the integer factorial-loop verification
% condition under the factorial base and positive-step recurrence laws,
% covering invariant initialization, loop progress, preservation, and exit.
% This file contains no proof.

sf_HoareLogic_factorialqtvc: THEORY
BEGIN

  recurrence_context(f: [int -> int]): bool =
    f(0) = 1
      AND
        (FORALL (n: int):
          0 < n IMPLIES f(n) = n * f(n - 1))

  factorial_vc: bool =
    FORALL (f: [int -> int]), (x: int):
      recurrence_context(f)
        IMPLIES 0 <= x
        IMPLIES
          0 <= x
            AND 1 * f(x) = f(x)
            AND
              (FORALL (z, y: int):
                (0 <= z AND y * f(z) = f(x))
                  IMPLIES
                    IF z /= 0 THEN
                      (0 <= z AND z - 1 < z)
                        AND 0 <= z - 1
                        AND (y * z) * f(z - 1) = f(x)
                    ELSE
                      y = f(x)
                    ENDIF)

END sf_HoareLogic_factorialqtvc
