% Statement-only formalization of the NTP4VC corpus artifact
% pearl/sf_HoareLogic_reduce_to_zeroqtvc: the integer verification condition
% for a decrementing loop that reduces a nonnegative value to zero, including
% invariant preservation and variant decrease. This file contains no proof.

sf_HoareLogic_reduce_to_zeroqtvc: THEORY
BEGIN
  reduce_to_zero_vc: bool =
    FORALL (x: int):
      0 <= x IMPLIES
        0 <= x
          AND
        (FORALL (x1: int):
          0 <= x1 IMPLIES
            (IF x1 /= 0 THEN
               ((0 <= x1
                   AND x1 - 1 < x1)
                 AND
                0 <= x1 - 1)
             ELSE
               x1 = 0
             ENDIF))
END sf_HoareLogic_reduce_to_zeroqtvc
