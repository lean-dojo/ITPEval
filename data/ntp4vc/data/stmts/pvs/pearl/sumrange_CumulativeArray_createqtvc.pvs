% Statement-only formalization of the NTP4VC corpus artifact
% pearl/sumrange_CumulativeArray_createqtvc: the cumulative-sum array
% creation verification condition, including zero initialization, loop
% invariant preservation after each array update, and the final
% cumulative-array specification. This file contains no proof.

sumrange_CumulativeArray_createqtvc: THEORY
BEGIN

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(values: list[int], index: nat): RECURSIVE int =
    CASES values OF
      null:
        0,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  list_set(
      values: list[int],
      index: nat,
      value: int): RECURSIVE list[int] =
    CASES values OF
      null:
        null,
      cons(head, tail):
        IF index = 0 THEN
          cons(value, tail)
        ELSE
          cons(head, list_set(tail, index - 1, value))
        ENDIF
    ENDCASES
  MEASURE values BY <<

  sum_from(
      values: list[int],
      start, count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      nth_default(values, start)
        + sum_from(values, start + 1, count - 1)
    ENDIF
  MEASURE count

  array_sum(
      values: list[int],
      lower, upper: int): int =
    sum_from(
      values,
      int_to_nat(lower),
      int_to_nat(upper - lower))

  nth_function(values: list[int]): [int -> int] =
    LAMBDA (index: int):
      nth_default(values, int_to_nat(index))

  function_update(
      values: [int -> int],
      index, value: int): [int -> int] =
    values WITH [(index) := value]

  prefix_correct(
      cumulative, source: list[int],
      upper: int): bool =
    FORALL (k: int):
      (0 <= k AND k < upper)
        IMPLIES
          nth_default(cumulative, int_to_nat(k))
            = array_sum(source, 0, k)

  is_cumulative_array_for(
      cumulative, source: list[int]): bool =
    length(cumulative) = length(source) + 1
      AND
    (FORALL (i: int):
      (0 <= i AND i < length(cumulative))
        IMPLIES
          nth_default(cumulative, int_to_nat(i))
            = array_sum(source, 0, i))

  zero_initialized(
      values: list[int],
      upper: int): bool =
    FORALL (i: int):
      (0 <= i AND i < upper)
        IMPLIES
          nth_default(values, int_to_nat(i)) = 0

  update_step(
      current, source: list[int],
      i: int): bool =
    LET o2: int = i - 1
    IN
      (0 <= o2 AND o2 < length(source))
        AND
      (LET o3: int = i - 1
       IN
         (0 <= o3 AND o3 < length(current))
           AND
         (LET o4: int =
            nth_default(current, int_to_nat(o3))
              + nth_default(source, int_to_nat(o2))
          IN
            (0 <= i AND i < length(current))
              AND
            (LET updated: list[int] =
               list_set(current, int_to_nat(i), o4)
             IN
               length(updated) = length(current)
                 IMPLIES
               nth_function(updated)
                 = function_update(nth_function(current), i, o4)
                 IMPLIES
               prefix_correct(updated, source, i + 1))))

  loop_obligations(
      current, source: list[int],
      l: int): bool =
    (FORALL (i: int):
      ((1 <= i AND i <= l)
        AND prefix_correct(current, source, i))
        IMPLIES
          update_step(current, source, i))
      AND
    (prefix_correct(current, source, l + 1)
      IMPLIES
        is_cumulative_array_for(current, source))

  create_vc: bool =
    FORALL (a: list[int]):
      LET l: int = length(a),
          o1: int = l + 1
      IN
        0 <= o1
          AND
        (FORALL (s: list[int]):
          (zero_initialized(s, o1)
            AND length(s) = o1)
            IMPLIES
              ((1 <= l + 1)
                IMPLIES
                  (prefix_correct(s, a, 1)
                    AND
                   (FORALL (s1: list[int]):
                     length(s1) = length(s)
                       IMPLIES
                         loop_obligations(s1, a, l))))
              AND
              ((l + 1 < 1)
                IMPLIES
                  is_cumulative_array_for(s, a)))

END sumrange_CumulativeArray_createqtvc
