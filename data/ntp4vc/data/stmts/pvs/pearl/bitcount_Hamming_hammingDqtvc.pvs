% Statement-only formalization of the NTP4VC corpus artifact
% pearl/bitcount_Hamming_hammingDqtvc: the 32-bit verification condition
% relating the population count of bitwise XOR to Hamming distance.
% This file contains no proof.

bitcount_Hamming_hammingDqtvc: THEORY
BEGIN

  IMPORTING bv[32], bv_nat[32]

  word32: TYPE = bvec[32]

  unsigned(value: word32): int =
    bv2nat[32](value)

  nth_bit(value: word32, index: int): bool =
    IF 0 <= index AND index < 32 THEN
      value(index)
    ELSE
      FALSE
    ENDIF

  word_xor(left, right: word32): word32 =
    LAMBDA (index: below(32)):
      left(index) /= right(index)

  bit_as_int(value: bool): int =
    IF value THEN 1 ELSE 0 ENDIF

  numof_0_32(predicate: [int -> bool]): int =
      bit_as_int(predicate(0))
    + bit_as_int(predicate(1))
    + bit_as_int(predicate(2))
    + bit_as_int(predicate(3))
    + bit_as_int(predicate(4))
    + bit_as_int(predicate(5))
    + bit_as_int(predicate(6))
    + bit_as_int(predicate(7))
    + bit_as_int(predicate(8))
    + bit_as_int(predicate(9))
    + bit_as_int(predicate(10))
    + bit_as_int(predicate(11))
    + bit_as_int(predicate(12))
    + bit_as_int(predicate(13))
    + bit_as_int(predicate(14))
    + bit_as_int(predicate(15))
    + bit_as_int(predicate(16))
    + bit_as_int(predicate(17))
    + bit_as_int(predicate(18))
    + bit_as_int(predicate(19))
    + bit_as_int(predicate(20))
    + bit_as_int(predicate(21))
    + bit_as_int(predicate(22))
    + bit_as_int(predicate(23))
    + bit_as_int(predicate(24))
    + bit_as_int(predicate(25))
    + bit_as_int(predicate(26))
    + bit_as_int(predicate(27))
    + bit_as_int(predicate(28))
    + bit_as_int(predicate(29))
    + bit_as_int(predicate(30))
    + bit_as_int(predicate(31))

  count_logic(value: word32): int =
    numof_0_32(
      LAMBDA (index: int):
        nth_bit(value, index))

  nth_diff(a, b: word32, index: int): bool =
    nth_bit(a, index) /= nth_bit(b, index)

  hammingD_logic(a, b: word32): int =
    numof_0_32(
      LAMBDA (index: int):
        nth_diff(a, b, index))

  hammingD_vc: bool =
    FORALL (result, a, b: word32):
      unsigned(result) = count_logic(word_xor(a, b))
        IMPLIES
          unsigned(result) = hammingD_logic(a, b)

END bitcount_Hamming_hammingDqtvc
