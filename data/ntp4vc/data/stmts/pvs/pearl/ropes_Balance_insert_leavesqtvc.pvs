% Statement-only formalization of the NTP4VC corpus artifact
% pearl/ropes_Balance_insert_leavesqtvc: the verification condition for
% recursively inserting a rope's leaves into a balanced-rope queue while
% preserving its invariant and modeled string. This file contains no proof.

ropes_Balance_insert_leavesqtvc[Char, CharString: TYPE+]: THEORY
BEGIN

  string_length_function: TYPE = [CharString -> int]
  string_index_function: TYPE = [CharString, int -> Char]
  string_app_function: TYPE = [CharString, CharString -> CharString]
  string_sub_function: TYPE = [CharString, int, int -> CharString]
  fibonacci_function: TYPE = [int -> int]

  rope: DATATYPE
  BEGIN
    RopeEmp: RopeEmp?
    RopeStr(
        leaf_string: CharString,
        leaf_offset: int,
        leaf_length: int): RopeStr?
    RopeApp(
        app_left: rope,
        app_right: rope,
        stored_length: int): RopeApp?
  END rope

  rope_length(r: rope): int =
    CASES r OF
      RopeEmp:
        0,
      RopeStr(leaf, offset, len):
        len,
      RopeApp(left, right, len):
        len
    ENDCASES

  strings_equal(
      string_length: string_length_function,
      string_index: string_index_function,
      left, right: CharString): bool =
    string_length(left) = string_length(right)
      AND
        (FORALL (index: int):
          0 <= index
            AND index < string_length(left)
            IMPLIES string_index(left, index) = string_index(right, index))

  rope_invariant(
      r: rope,
      string_length: string_length_function): RECURSIVE bool =
    CASES r OF
      RopeEmp:
        TRUE,
      RopeStr(leaf, offset, len):
        0 < len
          AND 0 <= offset
          AND offset < string_length(leaf)
          AND offset + len <= string_length(leaf),
      RopeApp(left, right, len):
        0 < rope_length(left)
          AND rope_invariant(left, string_length)
          AND 0 < rope_length(right)
          AND rope_invariant(right, string_length)
          AND len = rope_length(left) + rope_length(right)
    ENDCASES
  MEASURE r BY <<

  rope_string(
      r: rope,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function): RECURSIVE CharString =
    CASES r OF
      RopeEmp:
        empty_string,
      RopeStr(leaf, offset, len):
        string_sub(leaf, offset, len),
      RopeApp(left, right, len):
        string_app(
          rope_string(left, empty_string, string_app, string_sub),
          rope_string(right, empty_string, string_app, string_sub))
    ENDCASES
  MEASURE r BY <<

  rope_array: TYPE =
    [# queue_length: nat,
       queue_get: [int -> rope] #]

  string_of_array_function: TYPE =
    [rope_array, int, int -> CharString]

  string_context(
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function): bool =
    (FORALL (value: CharString):
      0 <= string_length(value))
      AND string_length(empty_string) = 0
      AND
        (FORALL (left, right: CharString):
          strings_equal(
            string_length,
            string_index,
            left,
            right)
            IMPLIES left = right)
      AND
        (FORALL (left, right: CharString):
          string_length(string_app(left, right))
            = string_length(left) + string_length(right))
      AND
        (FORALL (left, right: CharString), (index: int):
          0 <= index
            AND index < string_length(left)
            IMPLIES
              string_index(string_app(left, right), index)
                = string_index(left, index))
      AND
        (FORALL (left, right: CharString), (index: int):
          string_length(left) <= index
            AND index < string_length(left) + string_length(right)
            IMPLIES
              string_index(string_app(left, right), index)
                = string_index(
                    right,
                    index - string_length(left)))
      AND
        (FORALL (value: CharString), (offset, len: int):
          0 <= len
            AND 0 <= offset
            AND offset <= string_length(value)
            AND offset + len <= string_length(value)
            IMPLIES
              string_length(string_sub(value, offset, len)) = len)
      AND
        (FORALL (value: CharString), (offset, len, index: int):
          0 <= len
            AND 0 <= offset
            AND offset <= string_length(value)
            AND offset + len <= string_length(value)
            AND 0 <= index
            AND index < len
            IMPLIES
              string_index(string_sub(value, offset, len), index)
                = string_index(value, offset + index))

  fibonacci_context(fib: fibonacci_function): bool =
    FORALL (index: int):
      0 <= index
        IMPLIES
          fib(index)
            =
              IF index = 0 THEN
                0
              ELSIF index = 1 THEN
                1
              ELSE
                fib(index - 1) + fib(index - 2)
              ENDIF

  string_of_array_context(
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    (FORALL (q: rope_array), (lower: int):
      0 <= lower
        AND lower <= queue_length(q)
        IMPLIES
          strings_equal(
            string_length,
            string_index,
            string_of_array(q, lower, lower),
            empty_string))
      AND
        (FORALL (q: rope_array), (lower, upper: int):
          0 <= lower
            AND lower < upper
            AND upper <= queue_length(q)
            IMPLIES
              strings_equal(
                string_length,
                string_index,
                string_of_array(q, lower, upper),
                string_app(
                  string_of_array(q, lower + 1, upper),
                  rope_string(
                    queue_get(q)(lower),
                    empty_string,
                    string_app,
                    string_sub))))

  background_context(
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      fib: fibonacci_function,
      maximum: int,
      string_of_array: string_of_array_function): bool =
    string_context(
      string_length,
      string_index,
      empty_string,
      string_app,
      string_sub)
      AND fibonacci_context(fib)
      AND 2 <= maximum
      AND
        string_of_array_context(
          string_length,
          string_index,
          empty_string,
          string_app,
          string_sub,
          string_of_array)

  string_of_queue(
      q: rope_array,
      string_of_array: string_of_array_function): CharString =
    string_of_array(q, 2, queue_length(q))

  all_invariant(
      q: rope_array,
      lower, upper: int,
      string_length: string_length_function): bool =
    FORALL (index: int):
      lower <= index
        AND index <= upper
        IMPLIES rope_invariant(queue_get(q)(index), string_length)

  unchanged_below(
      result, initial: rope_array,
      lower, upper: int): bool =
    FORALL (index: int):
      lower <= index
        AND index < upper
        IMPLIES queue_get(result)(index) = queue_get(initial)(index)

  child_of(source, child: rope): bool =
    CASES source OF
      RopeEmp:
        FALSE,
      RopeStr(leaf, offset, len):
        FALSE,
      RopeApp(left, right, len):
        left = child OR right = child
    ENDCASES

  insert_leaves_vc: bool =
    FORALL
      (string_length: string_length_function),
      (string_index: string_index_function),
      (empty_string: CharString),
      (string_app: string_app_function),
      (string_sub: string_sub_function),
      (fib: fibonacci_function),
      (maximum: int),
      (string_of_array: string_of_array_function):
      background_context(
        string_length,
        string_index,
        empty_string,
        string_app,
        string_sub,
        fib,
        maximum,
        string_of_array)
        IMPLIES
          (FORALL (q: rope_array), (source: rope):
            (2 < queue_length(q)
              AND queue_length(q) = maximum + 1
              AND rope_invariant(source, string_length)
              AND all_invariant(q, 2, maximum, string_length)
              AND
                string_length(string_of_queue(q, string_of_array))
                  + rope_length(source)
                  < fib(maximum + 1))
              IMPLIES
                CASES source OF
                  RopeEmp:
                    all_invariant(q, 2, maximum, string_length)
                      AND
                        strings_equal(
                          string_length,
                          string_index,
                          string_of_queue(q, string_of_array),
                          string_app(
                            string_of_queue(q, string_of_array),
                            rope_string(
                              source,
                              empty_string,
                              string_app,
                              string_sub))),
                  RopeStr(leaf, offset, len):
                    (((2 <= 2
                        AND 2 < queue_length(q)
                        AND queue_length(q) = maximum + 1)
                      AND rope_invariant(source, string_length)
                      AND all_invariant(q, 2, maximum, string_length)
                      AND
                        string_length(
                          string_of_array(q, 2, maximum + 1))
                          + rope_length(source)
                          < fib(maximum + 1))
                      AND
                        (FORALL (q1: rope_array):
                          queue_length(q1) = queue_length(q)
                            IMPLIES
                              ((all_invariant(
                                  q1,
                                  2,
                                  maximum,
                                  string_length)
                                AND unchanged_below(q1, q, 2, 2)
                                AND
                                  strings_equal(
                                    string_length,
                                    string_index,
                                    string_of_array(
                                      q1,
                                      2,
                                      maximum + 1),
                                    string_app(
                                      string_of_array(
                                        q,
                                        2,
                                        maximum + 1),
                                      rope_string(
                                        source,
                                        empty_string,
                                        string_app,
                                        string_sub))))
                                IMPLIES
                                  (all_invariant(
                                    q1,
                                    2,
                                    maximum,
                                    string_length)
                                    AND
                                      strings_equal(
                                        string_length,
                                        string_index,
                                        string_of_queue(
                                          q1,
                                          string_of_array),
                                        string_app(
                                          string_of_queue(
                                            q,
                                            string_of_array),
                                          rope_string(
                                            source,
                                            empty_string,
                                            string_app,
                                            string_sub))))))),
                  RopeApp(left, right, stored):
                    (child_of(source, left)
                      AND
                        ((2 < queue_length(q)
                          AND queue_length(q) = maximum + 1)
                          AND rope_invariant(left, string_length)
                          AND all_invariant(
                            q,
                            2,
                            maximum,
                            string_length)
                          AND
                            string_length(
                              string_of_queue(q, string_of_array))
                              + rope_length(left)
                              < fib(maximum + 1)))
                      AND
                        (FORALL (q1: rope_array):
                          queue_length(q1) = queue_length(q)
                            IMPLIES
                              ((all_invariant(
                                  q1,
                                  2,
                                  maximum,
                                  string_length)
                                AND
                                  strings_equal(
                                    string_length,
                                    string_index,
                                    string_of_queue(
                                      q1,
                                      string_of_array),
                                    string_app(
                                      string_of_queue(
                                        q,
                                        string_of_array),
                                      rope_string(
                                        left,
                                        empty_string,
                                        string_app,
                                        string_sub))))
                                IMPLIES
                                  ((child_of(source, right)
                                    AND
                                      ((2 < queue_length(q1)
                                        AND
                                          queue_length(q1)
                                            = maximum + 1)
                                        AND rope_invariant(
                                          right,
                                          string_length)
                                        AND all_invariant(
                                          q1,
                                          2,
                                          maximum,
                                          string_length)
                                        AND
                                          string_length(
                                            string_of_queue(
                                              q1,
                                              string_of_array))
                                            + rope_length(right)
                                            < fib(maximum + 1)))
                                    AND
                                      (FORALL (q2: rope_array):
                                        queue_length(q2)
                                          = queue_length(q1)
                                          IMPLIES
                                            ((all_invariant(
                                                q2,
                                                2,
                                                maximum,
                                                string_length)
                                              AND
                                                strings_equal(
                                                  string_length,
                                                  string_index,
                                                  string_of_queue(
                                                    q2,
                                                    string_of_array),
                                                  string_app(
                                                    string_of_queue(
                                                      q1,
                                                      string_of_array),
                                                    rope_string(
                                                      right,
                                                      empty_string,
                                                      string_app,
                                                      string_sub))))
                                              IMPLIES
                                                (all_invariant(
                                                  q2,
                                                  2,
                                                  maximum,
                                                  string_length)
                                                  AND
                                                    strings_equal(
                                                      string_length,
                                                      string_index,
                                                      string_of_queue(
                                                        q2,
                                                        string_of_array),
                                                      string_app(
                                                        string_of_queue(
                                                          q,
                                                          string_of_array),
                                                        rope_string(
                                                          source,
                                                          empty_string,
                                                          string_app,
                                                          string_sub)))))))))
                ENDCASES)

END ropes_Balance_insert_leavesqtvc
