% Statement-only formalization of the NTP4VC corpus artifact
% pearl/mergesort_array_NaturalMergesort_naturalrecqtvc: the natural mergesort
% recursive verification condition for sorted runs, subarray permutations,
% run-boundary discovery, merge bounds, and nested loop continuations. This
% file contains no proof.

mergesort_array_NaturalMergesort_naturalrecqtvc[
  elt: TYPE+,
  elt_default: elt,
  le: [elt, elt -> bool]
]: THEORY
BEGIN

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nth_default(values: list[elt], index: nat): RECURSIVE elt =
    CASES values OF
      null:
        elt_default,
      cons(head, tail):
        IF index = 0 THEN
          head
        ELSE
          nth_default(tail, index - 1)
        ENDIF
    ENDCASES
  MEASURE values BY <<

  list_take(count: nat, values: list[elt]): RECURSIVE list[elt] =
    IF count = 0 THEN
      null
    ELSE
      CASES values OF
        null:
          null,
        cons(head, tail):
          cons(head, list_take(count - 1, tail))
      ENDCASES
    ENDIF
  MEASURE count

  list_drop(count: nat, values: list[elt]): RECURSIVE list[elt] =
    IF count = 0 THEN
      values
    ELSE
      CASES values OF
        null:
          null,
        cons(head, tail):
          list_drop(count - 1, tail)
      ENDCASES
    ENDIF
  MEASURE count

  nat_minus(left, right: nat): RECURSIVE nat =
    IF left = 0 OR right = 0 THEN
      left
    ELSE
      nat_minus(left - 1, right - 1)
    ENDIF
  MEASURE left + right

  list_slice(
      values: list[elt],
      lower, upper: nat): list[elt] =
    list_take(
      nat_minus(upper, lower),
      list_drop(lower, values))

  occurrence_count(
      value: elt,
      values: list[elt]): RECURSIVE nat =
    CASES values OF
      null:
        0,
      cons(head, tail):
        (IF value = head THEN 1 ELSE 0 ENDIF)
          + occurrence_count(value, tail)
    ENDCASES
  MEASURE values BY <<

  list_permutation(
      left, right: list[elt]): bool =
    FORALL (value: elt):
      occurrence_count(value, left)
        = occurrence_count(value, right)

  permut_sub(
      left, right: list[elt],
      lower, upper: nat): bool =
    length(left) = length(right)
      AND lower <= length(left)
      AND upper <= length(left)
      AND list_permutation(
        list_slice(left, lower, upper),
        list_slice(right, lower, upper))

  permut_sub_prime(
      left, right: list[elt],
      lower, upper: nat): bool =
    length(left) = length(right)
      AND list_slice(left, 0, lower)
        = list_slice(right, 0, lower)
      AND list_slice(left, upper, length(left))
        = list_slice(right, upper, length(left))
      AND list_permutation(
        list_slice(left, lower, upper),
        list_slice(right, lower, upper))

  order_laws: bool =
    (FORALL (x: elt): le(x, x))
      AND
    (FORALL (x, y, z: elt):
      (le(x, y) AND le(y, z)) IMPLIES le(x, z))
      AND
    (FORALL (x, y: elt): le(x, y) OR le(y, x))

  sorted_sub(
      values: list[elt],
      lower, upper: int): bool =
    FORALL (i1, i2: int):
      (lower <= i1 AND i1 < i2 AND i2 < upper)
        IMPLIES
          le(
            nth_default(values, int_to_nat(i1)),
            nth_default(values, int_to_nat(i2)))

  sorted(values: list[elt]): bool =
    FORALL (i1, i2: int):
      (0 <= i1 AND i1 < i2 AND i2 < length(values))
        IMPLIES
          le(
            nth_default(values, int_to_nat(i1)),
            nth_default(values, int_to_nat(i2)))

  prefix_unchanged(
      current, original: list[elt],
      upper: int): bool =
    FORALL (index: int):
      (0 <= index AND index < upper)
        IMPLIES
          nth_default(current, int_to_nat(index))
            = nth_default(original, int_to_nat(index))

  unchanged_outside(
      current, previous: list[elt],
      lower, upper: int): bool =
    FORALL (index: int):
      ((0 <= index AND index < lower)
        OR
      (upper <= index AND index < length(current)))
        IMPLIES
          nth_default(current, int_to_nat(index))
            = nth_default(previous, int_to_nat(index))

  self_result(
      values: list[elt],
      lo, k, endpoint: int): bool =
    (endpoint = length(values)
      OR
    (lo + k < endpoint AND endpoint < length(values)))
      AND sorted_sub(values, lo, endpoint)
      AND permut_sub_prime(
        values,
        values,
        int_to_nat(lo),
        length(values))

  progress_result(
      original, current: list[elt],
      lo, k, endpoint: int): bool =
    (endpoint = length(current)
      OR
    (lo + k < endpoint AND endpoint < length(current)))
      AND sorted_sub(current, lo, endpoint)
      AND permut_sub_prime(
        original,
        current,
        int_to_nat(lo),
        length(current))
      AND prefix_unchanged(current, original, lo)

  after_a3(
      original, a3: list[elt],
      lo, k, i, hi, n: int): bool =
    IF hi = n THEN
      progress_result(original, a3, lo, k, n)
    ELSE
      (lo + (i + 1) < hi AND hi < n)
        AND sorted_sub(a3, lo, hi)
        AND permut_sub_prime(
          original,
          a3,
          int_to_nat(lo),
          length(a3))
        AND prefix_unchanged(a3, original, lo)
    ENDIF

  all_a3(
      original, a2: list[elt],
      lo, k, i, hi, n: int): bool =
    FORALL (a3: list[elt]):
      length(a3) = length(a2)
        IMPLIES
      (sorted_sub(a3, lo, hi)
        AND permut_sub(
          a2,
          a3,
          int_to_nat(lo),
          int_to_nat(hi))
        AND unchanged_outside(a3, a2, lo, hi))
        IMPLIES
          after_a3(original, a3, lo, k, i, hi, n)

  hi_conclusion(
      original, a2, tmp2: list[elt],
      lo, k, i, mid, hi, n: int): bool =
    ((0 <= lo
        AND lo <= mid
        AND mid <= hi
        AND hi <= length(tmp2)
        AND length(tmp2) = length(a2))
      AND sorted_sub(a2, lo, mid)
      AND sorted_sub(a2, mid, hi))
      AND all_a3(original, a2, lo, k, i, hi, n)

  all_hi(
      original, a1, a2, tmp2: list[elt],
      lo, k, i, mid, n: int): bool =
    FORALL (hi: int):
      ((hi = length(a2)
          OR
        (mid + i < hi AND hi < length(a2)))
        AND sorted_sub(a2, mid, hi)
        AND permut_sub_prime(
          a1,
          a2,
          int_to_nat(mid),
          length(a2))
        AND prefix_unchanged(a2, a1, mid))
        IMPLIES
          hi_conclusion(
            original, a2, tmp2, lo, k, i, mid, hi, n)

  all_a2_tmp2(
      original, a1, tmp1: list[elt],
      lo, k, i, mid, n: int): bool =
    FORALL (a2, tmp2: list[elt]):
      length(a2) = length(a1)
        IMPLIES
      length(tmp2) = length(tmp1)
        IMPLIES
          all_hi(
            original, a1, a2, tmp2, lo, k, i, mid, n)

  i_conclusion(
      original, a1, tmp1: list[elt],
      lo, k, i, mid, n: int): bool =
    (((0 <= k AND i < k)
        AND
      (0 <= mid
        AND mid <= length(a1)
        AND length(a1) = length(tmp1))
        AND 0 <= i)
      AND
        all_a2_tmp2(
          original, a1, tmp1, lo, k, i, mid, n))

  all_i(
      original, a1, tmp1: list[elt],
      lo, k, o2, mid, n: int): bool =
    FORALL (i: int):
      ((0 <= i AND i <= o2)
        AND
      (lo + i < mid AND mid < n)
        AND sorted_sub(a1, lo, mid)
        AND permut_sub_prime(
          original,
          a1,
          int_to_nat(lo),
          length(a1))
        AND prefix_unchanged(a1, original, lo))
        IMPLIES
          i_conclusion(
            original, a1, tmp1, lo, k, i, mid, n)

  mid_closure(
      original, a1, tmp1: list[elt],
      lo, k, o2, mid, n: int): bool =
    all_i(original, a1, tmp1, lo, k, o2, mid, n)
      AND
    (((lo + (o2 + 1) < mid AND mid < n)
        AND sorted_sub(a1, lo, mid)
        AND permut_sub_prime(
          original,
          a1,
          int_to_nat(lo),
          length(a1))
        AND prefix_unchanged(a1, original, lo))
      IMPLIES
        progress_result(original, a1, lo, k, mid))

  all_mid(
      original, tmp: list[elt],
      lo, k, o2, n: int): bool =
    FORALL (mid: int), (a1, tmp1: list[elt]):
      length(a1) = length(original)
        IMPLIES
      length(tmp1) = length(tmp)
        IMPLIES
          mid_closure(
            original, a1, tmp1, lo, k, o2, mid, n)

  o2_nonnegative_result(
      a, tmp: list[elt],
      lo, k, o1, o2, n: int): bool =
    ((lo + 0 < o1 AND o1 < n)
      AND sorted_sub(a, lo, o1)
      AND permut_sub_prime(
        a,
        a,
        int_to_nat(lo),
        length(a)))
      AND all_mid(a, tmp, lo, k, o2, n)

  o1_nonfinal_case(
      a, tmp: list[elt],
      lo, k, o1, n: int): bool =
    LET o2: int = k - 1
    IN
      (0 <= o2 + 1
        IMPLIES
          o2_nonnegative_result(a, tmp, lo, k, o1, o2, n))
        AND
      (o2 + 1 < 0
        IMPLIES
          self_result(a, lo, k, o1))

  o1_case(
      a, tmp: list[elt],
      lo, k, o1, n: int): bool =
    IF o1 = n THEN
      self_result(a, lo, k, n)
    ELSE
      o1_nonfinal_case(a, tmp, lo, k, o1, n)
    ENDIF

  all_o1(
      a, tmp: list[elt],
      lo, k, n: int): bool =
    FORALL (o1: int):
      ((lo < o1 AND o1 <= length(a))
        AND sorted_sub(a, lo, o1)
        AND
      (o1 < length(a)
        IMPLIES
          NOT le(
            nth_default(a, int_to_nat(o1 - 1)),
            nth_default(a, int_to_nat(o1)))))
        IMPLIES
          o1_case(a, tmp, lo, k, o1, n)

  recursive_branch(
      a, tmp: list[elt],
      lo, k, n: int): bool =
    (0 <= lo AND lo < length(a))
      AND all_o1(a, tmp, lo, k, n)

  naturalrec_vc: bool =
    order_laws
      IMPLIES
        FORALL (lo, k: int), (a, tmp: list[elt]):
          0 <= lo
            IMPLIES
          lo <= length(a)
            IMPLIES
          length(a) = length(tmp)
            IMPLIES
          0 <= k
            IMPLIES
              LET n: int = length(a)
              IN
                IF n - 1 <= lo THEN
                  self_result(a, lo, k, n)
                ELSE
                  recursive_branch(a, tmp, lo, k, n)
                ENDIF

END mergesort_array_NaturalMergesort_naturalrecqtvc
