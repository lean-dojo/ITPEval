% Statement-only formalization of the NTP4VC corpus artifact
% pearl/bitcount_BitCounting32_countqtvc: the 32-bit population-count
% verification condition for its mask-and-shift stages and conditional final
% low-six-bit count equality. This file contains no proof.

bitcount_BitCounting32_countqtvc: THEORY
BEGIN

  bit_index: DATATYPE
  BEGIN
    Bit0: Bit0?
    Bit1: Bit1?
    Bit2: Bit2?
    Bit3: Bit3?
    Bit4: Bit4?
    Bit5: Bit5?
    Bit6: Bit6?
    Bit7: Bit7?
    Bit8: Bit8?
    Bit9: Bit9?
    Bit10: Bit10?
    Bit11: Bit11?
    Bit12: Bit12?
    Bit13: Bit13?
    Bit14: Bit14?
    Bit15: Bit15?
    Bit16: Bit16?
    Bit17: Bit17?
    Bit18: Bit18?
    Bit19: Bit19?
    Bit20: Bit20?
    Bit21: Bit21?
    Bit22: Bit22?
    Bit23: Bit23?
    Bit24: Bit24?
    Bit25: Bit25?
    Bit26: Bit26?
    Bit27: Bit27?
    Bit28: Bit28?
    Bit29: Bit29?
    Bit30: Bit30?
    Bit31: Bit31?
  END bit_index

  word32: TYPE = [bit_index -> bool]

  bit_as_int(value: bool): int =
    IF value THEN 1 ELSE 0 ENDIF

  bit_weight(index: bit_index): posnat =
    CASES index OF
      Bit0: 1,
      Bit1: 2,
      Bit2: 4,
      Bit3: 8,
      Bit4: 16,
      Bit5: 32,
      Bit6: 64,
      Bit7: 128,
      Bit8: 256,
      Bit9: 512,
      Bit10: 1024,
      Bit11: 2048,
      Bit12: 4096,
      Bit13: 8192,
      Bit14: 16384,
      Bit15: 32768,
      Bit16: 65536,
      Bit17: 131072,
      Bit18: 262144,
      Bit19: 524288,
      Bit20: 1048576,
      Bit21: 2097152,
      Bit22: 4194304,
      Bit23: 8388608,
      Bit24: 16777216,
      Bit25: 33554432,
      Bit26: 67108864,
      Bit27: 134217728,
      Bit28: 268435456,
      Bit29: 536870912,
      Bit30: 1073741824,
      Bit31: 2147483648
    ENDCASES

  unsigned(value: word32): int =
      bit_as_int(value(Bit0))
    + 2 * bit_as_int(value(Bit1))
    + 4 * bit_as_int(value(Bit2))
    + 8 * bit_as_int(value(Bit3))
    + 16 * bit_as_int(value(Bit4))
    + 32 * bit_as_int(value(Bit5))
    + 64 * bit_as_int(value(Bit6))
    + 128 * bit_as_int(value(Bit7))
    + 256 * bit_as_int(value(Bit8))
    + 512 * bit_as_int(value(Bit9))
    + 1024 * bit_as_int(value(Bit10))
    + 2048 * bit_as_int(value(Bit11))
    + 4096 * bit_as_int(value(Bit12))
    + 8192 * bit_as_int(value(Bit13))
    + 16384 * bit_as_int(value(Bit14))
    + 32768 * bit_as_int(value(Bit15))
    + 65536 * bit_as_int(value(Bit16))
    + 131072 * bit_as_int(value(Bit17))
    + 262144 * bit_as_int(value(Bit18))
    + 524288 * bit_as_int(value(Bit19))
    + 1048576 * bit_as_int(value(Bit20))
    + 2097152 * bit_as_int(value(Bit21))
    + 4194304 * bit_as_int(value(Bit22))
    + 8388608 * bit_as_int(value(Bit23))
    + 16777216 * bit_as_int(value(Bit24))
    + 33554432 * bit_as_int(value(Bit25))
    + 67108864 * bit_as_int(value(Bit26))
    + 134217728 * bit_as_int(value(Bit27))
    + 268435456 * bit_as_int(value(Bit28))
    + 536870912 * bit_as_int(value(Bit29))
    + 1073741824 * bit_as_int(value(Bit30))
    + 2147483648 * bit_as_int(value(Bit31))

  integer_bit(value: int, weight: posnat): bool =
    mod(
      floor(
        (mod(value, 4294967296) :: real)
          / (weight :: real)),
      2)
      = 1

  word_from_int(value: int): word32 =
    LAMBDA (index: bit_index):
      integer_bit(value, bit_weight(index))

  word_add(left, right: word32): word32 =
    word_from_int(unsigned(left) + unsigned(right))

  word_sub(left, right: word32): word32 =
    word_from_int(unsigned(left) - unsigned(right))

  word_and(left, right: word32): word32 =
    LAMBDA (index: bit_index):
      left(index) AND right(index)

  logical_shift_right(value: word32, divisor: posnat): word32 =
    word_from_int(
      floor((unsigned(value) :: real) / (divisor :: real)))

  mask_55555555: word32 = word_from_int(1431655765)
  mask_33333333: word32 = word_from_int(858993459)
  mask_0f0f0f0f: word32 = word_from_int(252645135)
  mask_0000003f: word32 = word_from_int(63)

  count_logic(value: word32): int =
      bit_as_int(value(Bit0))
    + bit_as_int(value(Bit1))
    + bit_as_int(value(Bit2))
    + bit_as_int(value(Bit3))
    + bit_as_int(value(Bit4))
    + bit_as_int(value(Bit5))
    + bit_as_int(value(Bit6))
    + bit_as_int(value(Bit7))
    + bit_as_int(value(Bit8))
    + bit_as_int(value(Bit9))
    + bit_as_int(value(Bit10))
    + bit_as_int(value(Bit11))
    + bit_as_int(value(Bit12))
    + bit_as_int(value(Bit13))
    + bit_as_int(value(Bit14))
    + bit_as_int(value(Bit15))
    + bit_as_int(value(Bit16))
    + bit_as_int(value(Bit17))
    + bit_as_int(value(Bit18))
    + bit_as_int(value(Bit19))
    + bit_as_int(value(Bit20))
    + bit_as_int(value(Bit21))
    + bit_as_int(value(Bit22))
    + bit_as_int(value(Bit23))
    + bit_as_int(value(Bit24))
    + bit_as_int(value(Bit25))
    + bit_as_int(value(Bit26))
    + bit_as_int(value(Bit27))
    + bit_as_int(value(Bit28))
    + bit_as_int(value(Bit29))
    + bit_as_int(value(Bit30))
    + bit_as_int(value(Bit31))

  step0(n, x1: word32): bool =
    x1 =
      word_sub(
        n,
        word_and(logical_shift_right(n, 2), mask_55555555))

  step1(x1, x2: word32): bool =
    x2 =
      word_add(
        word_and(x1, mask_33333333),
        word_and(logical_shift_right(x1, 4), mask_33333333))

  step2(x2, x3: word32): bool =
    x3 =
      word_and(
        word_add(x2, logical_shift_right(x2, 16)),
        mask_0f0f0f0f)

  step3(x3, x4: word32): bool =
    x4 = word_add(x3, logical_shift_right(x3, 256))

  step4(x4, x5: word32): bool =
    x5 = word_add(x4, logical_shift_right(x4, 65536))

  count_vc: bool =
    FORALL (n: word32):
      LET x1: word32 =
        word_sub(
          n,
          word_and(logical_shift_right(n, 2), mask_55555555))
      IN
        LET x2: word32 =
          word_add(
            word_and(x1, mask_33333333),
            word_and(logical_shift_right(x1, 4), mask_33333333))
        IN
          LET x3: word32 =
            word_and(
              word_add(x2, logical_shift_right(x2, 16)),
              mask_0f0f0f0f)
          IN
            LET x4: word32 =
              word_add(x3, logical_shift_right(x3, 256))
            IN
              LET x5: word32 =
                word_add(x4, logical_shift_right(x4, 65536))
              IN
                step0(n, x1)
                  AND step1(x1, x2)
                  AND step2(x2, x3)
                  AND step3(x3, x4)
                  AND step4(x4, x5)
                  AND
                    (unsigned(word_and(x5, mask_0000003f))
                       = count_logic(n)
                     IMPLIES
                       unsigned(word_and(x5, mask_0000003f))
                         = count_logic(n))

END bitcount_BitCounting32_countqtvc
