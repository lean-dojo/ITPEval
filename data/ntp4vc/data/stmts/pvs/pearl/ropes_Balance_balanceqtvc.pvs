% Statement-only formalization of the NTP4VC corpus artifact
% pearl/ropes_Balance_balanceqtvc: the verification condition for initializing
% a rope queue, inserting the leaves of a bounded rope, and reconstructing an
% invariant rope with the same modeled string. This file contains no proof.

ropes_Balance_balanceqtvc[Char, CharString: TYPE+]: THEORY
BEGIN

  string_length_function: TYPE = [CharString -> int]
  string_index_function: TYPE = [CharString, int -> Char]
  string_app_function: TYPE = [CharString, CharString -> CharString]
  string_sub_function: TYPE = [CharString, int, int -> CharString]
  fibonacci_function: TYPE = [int -> int]

  rope: DATATYPE
  BEGIN
    RopeEmp: RopeEmp?
    RopeStr(
        leaf_string: CharString,
        leaf_offset: int,
        leaf_length: int): RopeStr?
    RopeApp(
        app_left: rope,
        app_right: rope,
        stored_length: int): RopeApp?
  END rope

  rope_length(r: rope): int =
    CASES r OF
      RopeEmp:
        0,
      RopeStr(leaf, offset, len):
        len,
      RopeApp(left, right, len):
        len
    ENDCASES

  strings_equal(
      string_length: string_length_function,
      string_index: string_index_function,
      left, right: CharString): bool =
    string_length(left) = string_length(right)
      AND
        (FORALL (index: int):
          0 <= index
            AND index < string_length(left)
            IMPLIES string_index(left, index) = string_index(right, index))

  rope_invariant(
      r: rope,
      string_length: string_length_function): RECURSIVE bool =
    CASES r OF
      RopeEmp:
        TRUE,
      RopeStr(leaf, offset, len):
        0 < len
          AND 0 <= offset
          AND offset < string_length(leaf)
          AND offset + len <= string_length(leaf),
      RopeApp(left, right, len):
        0 < rope_length(left)
          AND rope_invariant(left, string_length)
          AND 0 < rope_length(right)
          AND rope_invariant(right, string_length)
          AND len = rope_length(left) + rope_length(right)
    ENDCASES
  MEASURE r BY <<

  rope_string(
      r: rope,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function): RECURSIVE CharString =
    CASES r OF
      RopeEmp:
        empty_string,
      RopeStr(leaf, offset, len):
        string_sub(leaf, offset, len),
      RopeApp(left, right, len):
        string_app(
          rope_string(left, empty_string, string_app, string_sub),
          rope_string(right, empty_string, string_app, string_sub))
    ENDCASES
  MEASURE r BY <<

  rope_array: TYPE =
    [# queue_length: nat,
       queue_get: [int -> rope] #]

  string_of_array_function: TYPE =
    [rope_array, int, int -> CharString]

  string_context(
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function): bool =
    (FORALL (value: CharString):
      0 <= string_length(value))
      AND string_length(empty_string) = 0
      AND
        (FORALL (left, right: CharString):
          strings_equal(
            string_length,
            string_index,
            left,
            right)
            IMPLIES left = right)
      AND
        (FORALL (left, right: CharString):
          string_length(string_app(left, right))
            = string_length(left) + string_length(right))
      AND
        (FORALL (left, right: CharString), (index: int):
          0 <= index
            AND index < string_length(left)
            IMPLIES
              string_index(string_app(left, right), index)
                = string_index(left, index))
      AND
        (FORALL (left, right: CharString), (index: int):
          string_length(left) <= index
            AND index < string_length(left) + string_length(right)
            IMPLIES
              string_index(string_app(left, right), index)
                = string_index(
                    right,
                    index - string_length(left)))
      AND
        (FORALL (value: CharString), (offset, len: int):
          0 <= len
            AND 0 <= offset
            AND offset <= string_length(value)
            AND offset + len <= string_length(value)
            IMPLIES
              string_length(string_sub(value, offset, len)) = len)
      AND
        (FORALL (value: CharString), (offset, len, index: int):
          0 <= len
            AND 0 <= offset
            AND offset <= string_length(value)
            AND offset + len <= string_length(value)
            AND 0 <= index
            AND index < len
            IMPLIES
              string_index(string_sub(value, offset, len), index)
                = string_index(value, offset + index))

  fibonacci_context(fib: fibonacci_function): bool =
    FORALL (index: int):
      0 <= index
        IMPLIES
          fib(index)
            =
              IF index = 0 THEN
                0
              ELSIF index = 1 THEN
                1
              ELSE
                fib(index - 1) + fib(index - 2)
              ENDIF

  string_of_array_context(
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    (FORALL (q: rope_array), (lower: int):
      0 <= lower
        AND lower <= queue_length(q)
        IMPLIES
          strings_equal(
            string_length,
            string_index,
            string_of_array(q, lower, lower),
            empty_string))
      AND
        (FORALL (q: rope_array), (lower, upper: int):
          0 <= lower
            AND lower < upper
            AND upper <= queue_length(q)
            IMPLIES
              strings_equal(
                string_length,
                string_index,
                string_of_array(q, lower, upper),
                string_app(
                  string_of_array(q, lower + 1, upper),
                  rope_string(
                    queue_get(q)(lower),
                    empty_string,
                    string_app,
                    string_sub))))

  background_context(
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      fib: fibonacci_function,
      maximum: int,
      string_of_array: string_of_array_function): bool =
    string_context(
      string_length,
      string_index,
      empty_string,
      string_app,
      string_sub)
      AND fibonacci_context(fib)
      AND 2 <= maximum
      AND
        string_of_array_context(
          string_length,
          string_index,
          empty_string,
          string_app,
          string_sub,
          string_of_array)

  string_of_queue(
      q: rope_array,
      string_of_array: string_of_array_function): CharString =
    string_of_array(q, 2, queue_length(q))

  all_empty(q: rope_array, upper: int): bool =
    FORALL (index: int):
      0 <= index
        AND index < upper
        IMPLIES queue_get(q)(index) = RopeEmp

  all_invariant(
      q: rope_array,
      lower, upper: int,
      string_length: string_length_function): bool =
    FORALL (index: int):
      lower <= index
        AND index <= upper
        IMPLIES rope_invariant(queue_get(q)(index), string_length)

  concatenation_result_obligation(
      q: rope_array,
      index: int,
      current, item: rope,
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    FORALL (combined: rope):
      rope_invariant(combined, string_length)
        AND
          strings_equal(
            string_length,
            string_index,
            rope_string(
              combined,
              empty_string,
              string_app,
              string_sub),
            string_app(
              rope_string(
                item,
                empty_string,
                string_app,
                string_sub),
              rope_string(
                current,
                empty_string,
                string_app,
                string_sub)))
        IMPLIES
          rope_invariant(combined, string_length)
            AND
              strings_equal(
                string_length,
                string_index,
                rope_string(
                  combined,
                  empty_string,
                  string_app,
                  string_sub),
                string_of_array(q, 2, index + 1))

  loop_index_obligations(
      q: rope_array,
      upper: int,
      current: rope,
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    FORALL (index: int):
      (2 <= index AND index <= upper)
        AND rope_invariant(current, string_length)
        AND
          strings_equal(
            string_length,
            string_index,
            rope_string(
              current,
              empty_string,
              string_app,
              string_sub),
            string_of_array(q, 2, index))
        IMPLIES
          (0 <= index AND index < queue_length(q))
            AND
              LET item: rope = queue_get(q)(index)
              IN
                (rope_invariant(item, string_length)
                  AND rope_invariant(current, string_length))
                  AND
                    concatenation_result_obligation(
                      q,
                      index,
                      current,
                      item,
                      string_length,
                      string_index,
                      empty_string,
                      string_app,
                      string_sub,
                      string_of_array)

  loop_result_obligations(
      q: rope_array,
      source: rope,
      upper: int,
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    FORALL (current: rope):
      loop_index_obligations(
        q,
        upper,
        current,
        string_length,
        string_index,
        empty_string,
        string_app,
        string_sub,
        string_of_array)
        AND
          (rope_invariant(current, string_length)
            AND
              strings_equal(
                string_length,
                string_index,
                rope_string(
                  current,
                  empty_string,
                  string_app,
                  string_sub),
                string_of_array(q, 2, upper + 1))
            IMPLIES
              rope_invariant(current, string_length)
                AND
                  strings_equal(
                    string_length,
                    string_index,
                    rope_string(
                      current,
                      empty_string,
                      string_app,
                      string_sub),
                    rope_string(
                      source,
                      empty_string,
                      string_app,
                      string_sub)))

  fold_obligations(
      q: rope_array,
      source: rope,
      maximum: int,
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    (2 <= maximum + 1
      IMPLIES
        (rope_invariant(RopeEmp, string_length)
          AND
            strings_equal(
              string_length,
              string_index,
              rope_string(
                RopeEmp,
                empty_string,
                string_app,
                string_sub),
              string_of_array(q, 2, 2)))
          AND
            loop_result_obligations(
              q,
              source,
              maximum,
              string_length,
              string_index,
              empty_string,
              string_app,
              string_sub,
              string_of_array))
      AND
        (maximum + 1 < 2
          IMPLIES
            LET result: rope = RopeEmp
            IN
              rope_invariant(result, string_length)
                AND
                  strings_equal(
                    string_length,
                    string_index,
                    rope_string(
                      result,
                      empty_string,
                      string_app,
                      string_sub),
                    rope_string(
                      source,
                      empty_string,
                      string_app,
                      string_sub)))

  insert_leaves_post_obligations(
      q: rope_array,
      source: rope,
      maximum: int,
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      string_of_array: string_of_array_function): bool =
    FORALL (q1: rope_array):
      queue_length(q1) = queue_length(q)
        IMPLIES
          (all_invariant(q1, 2, maximum, string_length)
            AND
              strings_equal(
                string_length,
                string_index,
                string_of_queue(q1, string_of_array),
                string_app(
                  string_of_queue(q, string_of_array),
                  rope_string(
                    source,
                    empty_string,
                    string_app,
                    string_sub))))
            IMPLIES
              fold_obligations(
                q1,
                source,
                maximum,
                string_length,
                string_index,
                empty_string,
                string_app,
                string_sub,
                string_of_array)

  initial_queue_obligations(
      source: rope,
      upper, maximum: int,
      string_length: string_length_function,
      string_index: string_index_function,
      empty_string: CharString,
      string_app: string_app_function,
      string_sub: string_sub_function,
      fib: fibonacci_function,
      string_of_array: string_of_array_function): bool =
    FORALL (q: rope_array):
      (all_empty(q, upper)
        AND queue_length(q) = upper)
        IMPLIES
          (2 < queue_length(q)
            AND queue_length(q) = maximum + 1)
          AND rope_invariant(source, string_length)
          AND all_invariant(q, 2, maximum, string_length)
          AND
            string_length(string_of_queue(q, string_of_array))
              + rope_length(source)
              < fib(maximum + 1)
          AND
            insert_leaves_post_obligations(
              q,
              source,
              maximum,
              string_length,
              string_index,
              empty_string,
              string_app,
              string_sub,
              string_of_array)

  balance_vc: bool =
    FORALL
      (string_length: string_length_function),
      (string_index: string_index_function),
      (empty_string: CharString),
      (string_app: string_app_function),
      (string_sub: string_sub_function),
      (fib: fibonacci_function),
      (maximum: int),
      (string_of_array: string_of_array_function):
      background_context(
        string_length,
        string_index,
        empty_string,
        string_app,
        string_sub,
        fib,
        maximum,
        string_of_array)
        IMPLIES
          (FORALL (source: rope):
            rope_invariant(source, string_length)
              IMPLIES
                rope_length(source) < fib(maximum + 1)
                  IMPLIES
                    LET upper: int = maximum + 1
                    IN
                      0 <= upper
                        AND
                          initial_queue_obligations(
                            source,
                            upper,
                            maximum,
                            string_length,
                            string_index,
                            empty_string,
                            string_app,
                            string_sub,
                            fib,
                            string_of_array))

END ropes_Balance_balanceqtvc
