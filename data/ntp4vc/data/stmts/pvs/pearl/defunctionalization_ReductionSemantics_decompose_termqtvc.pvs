% Statement-only formalization of the NTP4VC corpus artifact
% pearl/defunctionalization_ReductionSemantics_decompose_termqtvc: the
% verification condition for decomposing an arithmetic expression through a
% subtraction evaluation context while preserving recomposition, redex, and
% value invariants and decreasing the structural measure. This file contains
% no proof.

defunctionalization_ReductionSemantics_decompose_termqtvc: THEORY
BEGIN

  expr: DATATYPE
  BEGIN
    Cte(constant_value: int): Cte?
    Sub(left_expression, right_expression: expr): Sub?
  END expr

  context: DATATYPE
  BEGIN
    Empty: Empty?
    Left(previous_context: context, pending_expression: expr): Left?
    Right(saved_value: int, previous_context: context): Right?
  END context

  size_e(expression: expr): RECURSIVE int =
    CASES expression OF
      Cte(value):
        1,
      Sub(left, right):
        3 + size_e(left) + size_e(right)
    ENDCASES
  MEASURE expression BY <<

  recompose(
      current_context: context,
      expression: expr): RECURSIVE expr =
    CASES current_context OF
      Empty:
        expression,
      Left(previous, right):
        recompose(previous, Sub(expression, right)),
      Right(left_value, previous):
        recompose(previous, Sub(Cte(left_value), expression))
    ENDCASES
  MEASURE current_context BY <<

  is_a_redex(expression: expr): bool =
    CASES expression OF
      Cte(value):
        FALSE,
      Sub(left, right):
        Cte?(left) AND Cte?(right)
    ENDCASES

  is_a_value(expression: expr): bool =
    CASES expression OF
      Cte(value):
        TRUE,
      Sub(left, right):
        FALSE
    ENDCASES

  is_empty_context(current_context: context): bool =
    CASES current_context OF
      Empty:
        TRUE,
      Left(previous, expression):
        FALSE,
      Right(value, previous):
        FALSE
    ENDCASES

  size_c(current_context: context): RECURSIVE int =
    CASES current_context OF
      Empty:
        0,
      Left(previous, expression):
        2 + size_c(previous) + size_e(expression),
      Right(value, previous):
        1 + size_c(previous)
    ENDCASES
  MEASURE current_context BY <<

  decompose_term_vc: bool =
    FORALL (expression: expr), (current_context: context):
      CASES expression OF
        Cte(value):
          ((0 <= size_e(expression) + size_c(current_context)
              AND
            size_c(current_context)
              < size_e(expression) + size_c(current_context))
            AND
          (FORALL (decomposition_context: context),
                  (redex: expr):
            (recompose(decomposition_context, redex)
                = recompose(current_context, Cte(value))
              AND is_a_redex(redex))
              IMPLIES
            (recompose(decomposition_context, redex)
                = recompose(current_context, expression)
              AND is_a_redex(redex)))
            AND
          (is_empty_context(current_context)
            IMPLIES
          (is_empty_context(current_context)
            AND is_a_value(expression)))),
        Sub(left, right):
          LET next_context: context = Left(current_context, right) IN
            ((0 <= size_e(expression) + size_c(current_context)
                AND
              size_e(left) + size_c(next_context)
                < size_e(expression) + size_c(current_context))
              AND
            (FORALL (decomposition_context: context),
                    (redex: expr):
              (recompose(decomposition_context, redex)
                  = recompose(next_context, left)
                AND is_a_redex(redex))
                IMPLIES
              (recompose(decomposition_context, redex)
                  = recompose(current_context, expression)
                AND is_a_redex(redex)))
              AND
            ((is_empty_context(next_context) AND is_a_value(left))
              IMPLIES
            (is_empty_context(current_context)
              AND is_a_value(expression))))
      ENDCASES

END defunctionalization_ReductionSemantics_decompose_termqtvc
