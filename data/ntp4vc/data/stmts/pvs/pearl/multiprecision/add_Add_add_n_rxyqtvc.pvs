% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/add_Add_add_n_rxyqtvc: the verification condition for
% doubling a multiprecision integer in place, including carry arithmetic,
% memory framing, and preservation of pointer bounds and storage length.
% This file contains no proof.

add_Add_add_n_rxyqtvc[zone: TYPE+]: THEORY
BEGIN

  IMPORTING
    bv[32], bv[64],
    bv_nat[32], bv_nat[64]

  word32: TYPE = bvec[32]
  word64: TYPE = bvec[64]

  ptr: TYPE =
    [# data_length: nat,
       cells: [int -> word64],
       pointer_offset: int,
       pointer_min: int,
       pointer_max: int,
       is_writable: bool,
       pointer_zone: zone #]

  radix: int = 18446744073709551616

  unsigned64(value1: word64): int =
    bv2nat[64](value1)

  signed32(value1: word32): int =
    IF value1(31) THEN
      bv2nat[32](value1) - 4294967296
    ELSE
      bv2nat[32](value1)
    ENDIF

  int_to_nat(value1: int): nat =
    IF value1 < 0 THEN 0 ELSE value1 ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  value_from(
      values: [int -> word64],
      start: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      unsigned64(values(start))
        + radix * value_from(values, start + 1, count - 1)
    ENDIF
  MEASURE count

  value(p: ptr, count: int): int =
    value_from(
      cells(p),
      pointer_offset(p),
      int_to_nat(count))

  plength(p: ptr): int =
    data_length(p)

  int32_in_bounds(value1: int): bool =
    -2147483648 <= value1 AND value1 <= 2147483647

  valid(p: ptr, count: int): bool =
    int32_in_bounds(count)
      AND 0 <= count
      AND 0 <= pointer_min(p)
      AND pointer_min(p) <= pointer_offset(p)
      AND pointer_offset(p) + count <= pointer_max(p)
      AND pointer_max(p) <= plength(p)

  pelts(p: ptr, index: int): word64 =
    cells(p)(index)

  same_snapshot(new, old: ptr): bool =
    data_length(new) = data_length(old)
      AND pointer_offset(new) = pointer_offset(old)
      AND pointer_min(new) = pointer_min(old)
      AND pointer_max(new) = pointer_max(old)
      AND is_writable(new) = is_writable(old)
      AND pointer_zone(new) = pointer_zone(old)

  carry_in_bounds(result: word64): bool =
    0 <= unsigned64(result)
      AND unsigned64(result) <= 1

  frame(
      new, old: ptr,
      count: int): bool =
    FORALL (j: int):
      j < pointer_offset(new)
        OR pointer_offset(new) + count <= j
      IMPLIES pelts(new, j) = pelts(old, j)

  arithmetic_postcondition(
      new, old: ptr,
      count: int,
      result: word64): bool =
    value(new, count)
        + int_power(radix, count) * unsigned64(result)
      =
    value(old, count) + value(old, count)
      AND carry_in_bounds(result)
      AND frame(new, old, count)

  continuation_postcondition(
      new, old: ptr,
      count: int,
      result: word64): bool =
    arithmetic_postcondition(new, old, count, result)
      AND pointer_min(new) = pointer_min(old)
      AND pointer_max(new) = pointer_max(old)
      AND plength(new) = plength(old)

  add_n_rxy_vc: bool =
    FORALL
        (sx: word32),
        (x: ptr):
      0 <= signed32(sx)
        IMPLIES
          is_writable(x) = TRUE
        IMPLIES
          valid(x, signed32(sx))
        IMPLIES
          0 <= signed32(sx)
            AND valid(x, signed32(sx))
            AND is_writable(x) = TRUE
            AND
              (FORALL (new: ptr):
                same_snapshot(new, x)
                  IMPLIES
                    (FORALL (result: word64):
                      arithmetic_postcondition(
                        new, x, signed32(sx), result)
                        IMPLIES
                          continuation_postcondition(
                            new, x, signed32(sx), result)))

END add_Add_add_n_rxyqtvc
