% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/div_Div_div_sb_qrqtvc: the verification condition for
% normalized multi-limb quotient-and-remainder division, including pointer
% rebasing, pre-adjustment, the division loop, quotient-digit correction,
% borrow and carry arithmetic, memory framing, and the final remainder bound.
% This file contains no proof.

div_Div_div_sb_qrqtvc[zone: TYPE+]: THEORY
BEGIN

  IMPORTING
    bv[32], bv[64],
    bv_nat[32], bv_nat[64]

  word32: TYPE = bvec[32]
  word64: TYPE = bvec[64]

  ptr: TYPE =
    [# data_length: nat,
       cells: [int -> word64],
       pointer_offset: int,
       pointer_min: int,
       pointer_max: int,
       is_writable: bool,
       pointer_zone: zone #]

  radix: int = 18446744073709551616
  half_radix: int = 9223372036854775808
  max_word64: int = 18446744073709551615

  zero64: word64 = fill[64](FALSE)
  one64: word64 = nat2bv[64](1)
  max64: word64 = fill[64](TRUE)

  unsigned64(value1: word64): int =
    bv2nat[64](value1)

  signed32(value1: word32): int =
    IF value1(31) THEN
      bv2nat[32](value1) - 4294967296
    ELSE
      bv2nat[32](value1)
    ENDIF

  int_to_nat(value1: int): nat =
    IF value1 < 0 THEN 0 ELSE value1 ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  value_from(
      values: [int -> word64],
      start: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      unsigned64(values(start))
        + radix * value_from(values, start + 1, count - 1)
    ENDIF
  MEASURE count

  value_sub(
      values: [int -> word64],
      lower, upper: int): int =
    value_from(values, lower, int_to_nat(upper - lower))

  value(p: ptr, count: int): int =
    value_sub(
      cells(p),
      pointer_offset(p),
      pointer_offset(p) + count)

  int32_in_bounds(value1: int): bool =
    -2147483648 <= value1 AND value1 <= 2147483647

  uint64_in_bounds(value1: int): bool =
    0 <= value1 AND value1 <= max_word64

  valid(p: ptr, count: int): bool =
    int32_in_bounds(count)
      AND 0 <= count
      AND 0 <= pointer_min(p)
      AND pointer_min(p) <= pointer_offset(p)
      AND pointer_offset(p) + count <= pointer_max(p)
      AND pointer_max(p) <= data_length(p)

  valid_at(p: ptr, start, count: int): bool =
    int32_in_bounds(count)
      AND 0 <= count
      AND 0 <= pointer_min(p)
      AND pointer_min(p) <= start
      AND start + count <= pointer_max(p)
      AND pointer_max(p) <= data_length(p)

  access_closed(p: ptr, index: int): bool =
    pointer_min(p) <= index AND index <= pointer_max(p)

  access(p: ptr, index: int): bool =
    pointer_min(p) <= index AND index < pointer_max(p)

  same_data(left, right: ptr): bool =
    data_length(left) = data_length(right)
      AND cells(left) = cells(right)

  same_shape(left, right: ptr): bool =
    data_length(left) = data_length(right)
      AND pointer_offset(left) = pointer_offset(right)
      AND pointer_min(left) = pointer_min(right)
      AND pointer_max(left) = pointer_max(right)
      AND is_writable(left) = is_writable(right)
      AND pointer_zone(left) = pointer_zone(right)

  shifted(newer, older: ptr, amount: int): bool =
    pointer_offset(newer) = pointer_offset(older) + amount
      AND same_data(newer, older)
      AND pointer_min(newer) = pointer_min(older)
      AND pointer_max(newer) = pointer_max(older)
      AND pointer_zone(newer) = pointer_zone(older)
      AND is_writable(newer) = is_writable(older)

  rebased_snapshot(
      fresh, shared, old: ptr): bool =
    same_data(fresh, shared)
      AND data_length(shared) = data_length(old)
      AND pointer_offset(fresh) = pointer_offset(old)
      AND pointer_min(fresh) = pointer_min(old)
      AND pointer_max(fresh) = pointer_max(old)
      AND is_writable(fresh) = is_writable(old)
      AND pointer_zone(fresh) = pointer_zone(old)

  update_cells(
      values: [int -> word64],
      index: int,
      replacement: word64): [int -> word64] =
    values WITH [(index) := replacement]

  single_update(
      newer, older: ptr,
      index: int,
      replacement: word64): bool =
    cells(newer) = update_cells(cells(older), index, replacement)
      AND cells(newer)(index) = replacement

  outside_unchanged(
      newer, older: ptr,
      count: int): bool =
    FORALL (j: int):
      j < pointer_offset(newer)
        OR pointer_offset(newer) + count <= j
      IMPLIES cells(newer)(j) = cells(older)(j)

  outside_interval_unchanged(
      newer, older: ptr,
      start, count: int): bool =
    FORALL (j: int):
      j < start OR start + count <= j
      IMPLIES cells(newer)(j) = cells(older)(j)

  compare_int(left, right: int): int =
    IF left < right THEN -1
    ELSIF left = right THEN 0
    ELSE 1
    ENDIF

  reciprocal_3by2(v, dh, dl: word64): bool =
    unsigned64(v)
      =
    floor(
      ((radix * radix * radix - 1) :: real)
        / ((unsigned64(dl) + radix * unsigned64(dh)) :: real))
      - radix

  normalized(p: ptr, count: word32): bool =
    valid(p, signed32(count))
      AND half_radix
        <= unsigned64(
             cells(p)(
               pointer_offset(p) + signed32(count) - 1))

  carry_range(carry: word64): bool =
    0 <= unsigned64(carry) AND unsigned64(carry) <= 1

  zero_flag(limb: word64, flag: bool): bool =
    (unsigned64(limb) = unsigned64(zero64)
      IMPLIES flag = TRUE)
      AND
    (flag = TRUE IMPLIES limb = zero64)

  equal_flag(
      left, right: word64,
      flag: bool): bool =
    (unsigned64(left) = unsigned64(right)
      IMPLIES flag = TRUE)
      AND
    (flag = TRUE IMPLIES left = right)

  subtraction_at(
      newer, older, divisor: ptr,
      start, count: int,
      borrow: word64): bool =
    value_sub(cells(newer), start, start + count)
        - int_power(radix, count) * unsigned64(borrow)
      =
    value_sub(cells(older), start, start + count)
      - value(divisor, count)
      AND carry_range(borrow)
      AND outside_interval_unchanged(newer, older, start, count)

  submul_at(
      newer, older, divisor: ptr,
      start, count: int,
      multiplier, carry: word64): bool =
    value_sub(cells(newer), start, start + count)
        - int_power(radix, count) * unsigned64(carry)
      =
    value_sub(cells(older), start, start + count)
      - value(divisor, count) * unsigned64(multiplier)
      AND outside_interval_unchanged(newer, older, start, count)

  addition_at(
      newer, older, divisor: ptr,
      start, count: int,
      carry: word64): bool =
    carry_range(carry)
      AND
    value_sub(cells(newer), start, start + count)
        + int_power(radix, count) * unsigned64(carry)
      =
    value_sub(cells(older), start, start + count)
      + value(divisor, count)
      AND outside_interval_unchanged(newer, older, start, count)

  quotient_remainder(
      qu, rl, rh, high, middle, low, dh, dl: word64): bool =
    unsigned64(qu) * unsigned64(dl)
        + radix * unsigned64(qu) * unsigned64(dh)
        + unsigned64(rl)
        + radix * unsigned64(rh)
      =
    unsigned64(low)
        + radix * unsigned64(middle)
        + radix * radix * unsigned64(high)
      AND
        unsigned64(rl) + radix * unsigned64(rh)
          < unsigned64(dl) + radix * unsigned64(dh)

  loop_invariant(
      sy, sx, i: word32,
      x, y, q, current_x, current_q, xp, qp: ptr,
      x1, qh, dh, dl: word64,
      vy: int): bool =
    0 <= signed32(i)
      AND signed32(i) <= signed32(sx) - signed32(sy)
      AND pointer_offset(qp) = pointer_offset(current_q) + signed32(i)
      AND
        pointer_offset(xp)
          =
        pointer_offset(current_x)
          + signed32(sy) + signed32(i) - 2
      AND data_length(qp) = data_length(current_q)
      AND pointer_min(qp) = pointer_min(current_q)
      AND pointer_max(qp) = pointer_max(current_q)
      AND data_length(xp) = data_length(current_x)
      AND pointer_min(xp) = pointer_min(current_x)
      AND pointer_max(xp) = pointer_max(current_x)
      AND cells(qp) = cells(current_q)
      AND cells(xp) = cells(current_x)
      AND is_writable(qp) = TRUE
      AND is_writable(xp) = TRUE
      AND
        value(x, signed32(sx))
          =
        (value(qp, signed32(sx) - signed32(sy) - signed32(i))
          + unsigned64(qh)
              * int_power(
                  radix,
                  signed32(sx) - signed32(sy) - signed32(i)))
          * vy * int_power(radix, signed32(i))
          + value(current_x, signed32(sy) + signed32(i) - 1)
          + int_power(
              radix,
              signed32(sy) + signed32(i) - 1) * unsigned64(x1)
      AND
        value_sub(
          cells(current_x),
          pointer_offset(xp) + 2 - signed32(sy),
          pointer_offset(xp) + 1)
          + int_power(radix, signed32(sy) - 1) * unsigned64(x1)
        < vy
      AND
        unsigned64(cells(current_x)(pointer_offset(xp)))
          + radix * unsigned64(x1)
        <= unsigned64(dl) + radix * unsigned64(dh)

  final_postcondition(
      sy, sx: word32,
      x, y, q, final_x, final_q: ptr,
      qh: word64): bool =
    value(x, signed32(sx))
      =
    (value(final_q, signed32(sx) - signed32(sy))
      + int_power(radix, signed32(sx) - signed32(sy))
          * unsigned64(qh))
      * value(y, signed32(sy))
      + value(final_x, signed32(sy))
      AND
    value(final_x, signed32(sy)) < value(y, signed32(sy))
      AND carry_range(qh)

  write_quotient_and_continue(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp: ptr,
      x1, digit, qh, dh, dl: word64,
      vy: int): bool =
    access_closed(qp, pointer_offset(qp) - 1)
      AND
    FORALL (next_qp: ptr):
      shifted(next_qp, qp, -1)
        IMPLIES
      LET lower: int = pointer_offset(next_qp) + 1,
          upper: int =
            pointer_offset(next_qp)
              + signed32(sx) - signed32(sy) - signed32(next_i),
          index: int = pointer_offset(next_qp),
          old_cells: [int -> word64] = cells(current_q)
      IN
        lower <= upper
          AND (index < lower OR upper <= index)
          AND
        (value_sub(old_cells, lower, upper)
            =
          value_sub(
            update_cells(old_cells, index, digit),
            lower, upper)
          IMPLIES
        (FORALL (xp_view, qp_view: ptr):
          rebased_snapshot(xp_view, current_x, xp)
            IMPLIES
          rebased_snapshot(qp_view, current_q, next_qp)
            IMPLIES
          access(qp_view, index)
            AND is_writable(qp_view) = TRUE
            AND
          (FORALL (written_q: ptr):
            same_shape(written_q, current_q)
              IMPLIES
            single_update(written_q, current_q, index, digit)
              IMPLIES
            (FORALL (written_qp: ptr):
              rebased_snapshot(written_qp, written_q, qp_view)
                IMPLIES
              loop_invariant(
                sy, sx, next_i,
                x, y, q, current_x, written_q, xp_view, written_qp,
                x1, qh, dh, dl, vy)))))

  no_correction_branch(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, after_sub: ptr,
      qu, rh, qh, dh, dl: word64,
      vy: int): bool =
    write_quotient_and_continue(
      sy, sx, next_i,
      x, y, q, after_sub, current_q, xp, qp,
      rh, qu, qh, dh, dl, vy)

  corrected_digit_branch(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, after_sub: ptr,
      qu, rh, qh, dh, dl: word64,
      vy: int): bool =
    0 < unsigned64(qu)
      AND
    (0 < unsigned64(qu)
      IMPLIES
      int_power(radix, signed32(sy)) - vy
        <= value_sub(
             cells(after_sub),
             pointer_offset(xp) + 2 - signed32(sy),
             pointer_offset(xp) + 1)
            + int_power(radix, signed32(sy) - 1) * unsigned64(rh)
        AND
      (int_power(radix, signed32(sy)) - vy
          <= value_sub(
               cells(after_sub),
               pointer_offset(xp) + 2 - signed32(sy),
               pointer_offset(xp) + 1)
              + int_power(radix, signed32(sy) - 1) * unsigned64(rh)
        IMPLIES
        int32_in_bounds(signed32(sy) - 1)
          AND
        valid_at(
          after_sub,
          pointer_offset(xp) + 2 - signed32(sy),
          signed32(sy) - 1)
          AND valid(y, signed32(sy) - 1)
          AND is_writable(after_sub) = TRUE
          AND
        (FORALL (after_add: ptr), (carry: word64):
          same_shape(after_add, after_sub)
            IMPLIES
          addition_at(
            after_add, after_sub, y,
            pointer_offset(xp) + 2 - signed32(sy),
            signed32(sy) - 1, carry)
            IMPLIES
          value(after_add, signed32(next_i))
            = value(after_sub, signed32(next_i))
            AND
          (value(after_add, signed32(next_i))
              = value(after_sub, signed32(next_i))
            IMPLIES
            radix /= 0
              AND
            (FORALL (low_carry: word64):
              unsigned64(low_carry)
                  =
                mod(unsigned64(dh) + unsigned64(carry), radix)
                IMPLIES
              (FORALL (new_high: word64):
                unsigned64(new_high)
                    =
                  mod(
                    unsigned64(rh) + unsigned64(low_carry),
                    radix)
                  IMPLIES
                value_sub(
                  cells(after_add),
                  pointer_offset(xp) + 2 - signed32(sy),
                  pointer_offset(xp) + 1)
                    + int_power(radix, signed32(sy) - 1)
                        * unsigned64(new_high)
                  =
                value_sub(
                  cells(after_sub),
                  pointer_offset(xp) + 2 - signed32(sy),
                  pointer_offset(xp) + 1)
                    + int_power(radix, signed32(sy) - 1)
                        * unsigned64(rh)
                    + vy
                    - int_power(radix, signed32(sy))))
              AND
            (FORALL (final_high: word64):
              value_sub(
                cells(after_add),
                pointer_offset(xp) + 2 - signed32(sy),
                pointer_offset(xp) + 1)
                  + int_power(radix, signed32(sy) - 1)
                      * unsigned64(final_high)
                =
              value_sub(
                cells(after_sub),
                pointer_offset(xp) + 2 - signed32(sy),
                pointer_offset(xp) + 1)
                  + int_power(radix, signed32(sy) - 1)
                      * unsigned64(rh)
                  + vy
                  - int_power(radix, signed32(sy))
                IMPLIES
              uint64_in_bounds(unsigned64(qu) - 1)
                AND
              (FORALL (new_digit: word64):
                unsigned64(new_digit) = unsigned64(qu) - 1
                  IMPLIES
                write_quotient_and_continue(
                  sy, sx, next_i,
                  x, y, q, after_add, current_q, xp, qp,
                  final_high, new_digit, qh, dh, dl, vy)))))))

  correction_choice(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, after_sub: ptr,
      qu, rh, borrow2, qh, dh, dl: word64,
      vy: int): bool =
    FORALL (flag: bool):
      zero_flag(borrow2, flag)
        IMPLIES
      IF NOT (flag = TRUE) THEN
        corrected_digit_branch(
          sy, sx, next_i,
          x, y, q, current_x, current_q, xp, qp, after_sub,
          qu, rh, qh, dh, dl, vy)
      ELSE
        no_correction_branch(
          sy, sx, next_i,
          x, y, q, current_x, current_q, xp, qp, after_sub,
          qu, rh, qh, dh, dl, vy)
      ENDIF

  small_digit_after_submul(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, xd: ptr,
      high, qu, rl, rh, qh, dh, dl: word64,
      vy: int): bool =
    LET lower: int = pointer_offset(current_x),
        middle: int = pointer_offset(xd),
        upper: int =
          pointer_offset(current_x)
            + signed32(sy) + signed32(next_i),
        old_cells: [int -> word64] = cells(current_x)
    IN
      lower <= middle
        AND middle <= upper
        AND
      (value_sub(old_cells, lower, upper)
          =
        value_sub(old_cells, lower, middle)
          + value_sub(old_cells, middle, upper)
              * int_power(radix, middle - lower)
        IMPLIES
        int32_in_bounds(signed32(sy) - 2)
          AND valid(y, signed32(sy) - 2)
          AND valid(xd, signed32(sy) - 2)
          AND is_writable(xd) = TRUE
          AND
        (FORALL (after_submul: ptr), (carry: word64):
          same_shape(after_submul, current_x)
            IMPLIES
          submul_at(
            after_submul, current_x, y,
            pointer_offset(xd),
            signed32(sy) - 2, qu, carry)
            IMPLIES
          value(after_submul, signed32(next_i))
            = value(current_x, signed32(next_i))
            AND
          (value(after_submul, signed32(next_i))
              = value(current_x, signed32(next_i))
            IMPLIES
            (FORALL (borrow1, low_after, borrow2, high_after: word64):
              (IF unsigned64(rl) < unsigned64(carry)
               THEN borrow1 = one64 ELSE borrow1 = zero64 ENDIF)
                IMPLIES
              unsigned64(low_after)
                  = mod(unsigned64(rl) - unsigned64(carry), radix)
                IMPLIES
              (IF unsigned64(rh) < unsigned64(borrow1)
               THEN borrow2 = one64 ELSE borrow2 = zero64 ENDIF)
                IMPLIES
              unsigned64(high_after)
                  = mod(unsigned64(rh) - unsigned64(borrow1), radix)
                IMPLIES
              LET index: int = pointer_offset(xp),
                  updated: [int -> word64] =
                    update_cells(cells(after_submul), index, low_after),
                  xd_upper: int =
                    pointer_offset(xd) + signed32(sy) - 1,
                  prefix_upper: int =
                    pointer_offset(after_submul) + signed32(next_i),
                  short_upper: int =
                    pointer_offset(xd) + signed32(sy) - 2
              IN
                pointer_offset(xd) <= index
                  AND index < xd_upper
                  AND
                (value_sub(updated, pointer_offset(xd), xd_upper)
                    =
                  value_sub(
                    cells(after_submul), pointer_offset(xd), xd_upper)
                    + int_power(
                        radix, index - pointer_offset(xd))
                        * (unsigned64(low_after)
                            - unsigned64(cells(after_submul)(index)))
                  IMPLIES
                  pointer_offset(after_submul) <= prefix_upper
                    AND
                      (index < pointer_offset(after_submul)
                        OR prefix_upper <= index)
                    AND
                  (value_sub(
                      cells(after_submul),
                      pointer_offset(after_submul), prefix_upper)
                      =
                    value_sub(
                      updated,
                      pointer_offset(after_submul), prefix_upper)
                    IMPLIES
                    pointer_offset(xd) <= short_upper
                      AND
                        (index < pointer_offset(xd)
                          OR short_upper <= index)
                      AND
                    (value_sub(
                        cells(after_submul),
                        pointer_offset(xd), short_upper)
                        =
                      value_sub(updated, pointer_offset(xd), short_upper)
                      IMPLIES
                      access(xp, index)
                        AND is_writable(xp) = TRUE
                        AND
                      (FORALL (after_store: ptr):
                        same_shape(after_store, after_submul)
                          IMPLIES
                        single_update(
                          after_store, after_submul,
                          index, low_after)
                          IMPLIES
                        value_sub(
                          cells(after_store),
                          pointer_offset(xd),
                          pointer_offset(xd) + signed32(sy) - 1)
                            + int_power(radix, signed32(sy) - 1)
                                * unsigned64(high_after)
                            - int_power(radix, signed32(sy))
                                * unsigned64(borrow2)
                          =
                        value(xd, signed32(sy))
                            + int_power(radix, signed32(sy))
                                * unsigned64(high)
                            - unsigned64(qu) * vy
                          AND
                        (value_sub(
                          cells(after_store),
                          pointer_offset(xd),
                          pointer_offset(xd) + signed32(sy) - 1)
                            + int_power(radix, signed32(sy) - 1)
                                * unsigned64(high_after)
                            - int_power(radix, signed32(sy))
                                * unsigned64(borrow2)
                          =
                        value(xd, signed32(sy))
                            + int_power(radix, signed32(sy))
                                * unsigned64(high)
                            - unsigned64(qu) * vy
                          IMPLIES
                          correction_choice(
                            sy, sx, next_i,
                            x, y, q,
                            after_store, current_q, xp, qp, after_store,
                            qu, high_after, borrow2,
                            qh, dh, dl, vy))))))))))

  small_digit_branch(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, xd: ptr,
      high, middle, low, v, qh, dh, dl: word64,
      vy: int): bool =
    value(xd, signed32(sy))
      =
    value(xd, signed32(sy) - 2)
      + int_power(radix, signed32(sy) - 2)
          * (unsigned64(low) + radix * unsigned64(middle))
      AND
    (value(xd, signed32(sy))
        =
      value(xd, signed32(sy) - 2)
        + int_power(radix, signed32(sy) - 2)
            * (unsigned64(low) + radix * unsigned64(middle))
      IMPLIES
      (half_radix <= unsigned64(dh)
        AND reciprocal_3by2(v, dh, dl)
        AND
          unsigned64(middle) + radix * unsigned64(high)
            < unsigned64(dl) + radix * unsigned64(dh))
        AND
      (FORALL (qu, rl, rh: word64):
        quotient_remainder(
          qu, rl, rh, high, middle, low, dh, dl)
          IMPLIES
        small_digit_after_submul(
          sy, sx, next_i,
          x, y, q, current_x, current_q, xp, qp, xd,
          high, qu, rl, rh, qh, dh, dl, vy)))

  max_digit_branch(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, xd: ptr,
      high, qh, dh, dl: word64,
      vy: int): bool =
    value_sub(
      cells(xd),
      pointer_offset(xd) + 1,
      pointer_offset(xd) + signed32(sy) - 1)
      + int_power(radix, signed32(sy) - 2) * unsigned64(dl)
      + int_power(radix, signed32(sy) - 1) * unsigned64(dh)
      < vy
      AND
    (value_sub(
        cells(xd),
        pointer_offset(xd) + 1,
        pointer_offset(xd) + signed32(sy) - 1)
        + int_power(radix, signed32(sy) - 2) * unsigned64(dl)
        + int_power(radix, signed32(sy) - 1) * unsigned64(dh)
        < vy
      IMPLIES
      valid(y, signed32(sy))
        AND valid(xd, signed32(sy))
        AND is_writable(xd) = TRUE
        AND
      (FORALL (after_submul: ptr), (borrow: word64):
        same_shape(after_submul, current_x)
          IMPLIES
        submul_at(
          after_submul, current_x, y,
          pointer_offset(xd),
          signed32(sy), max64, borrow)
          IMPLIES
        value(after_submul, signed32(next_i))
          = value(current_x, signed32(next_i))
          AND
        (value(after_submul, signed32(next_i))
            = value(current_x, signed32(next_i))
          IMPLIES
          LET lower: int = pointer_offset(after_submul),
              middle: int = pointer_offset(xd),
              upper: int =
                pointer_offset(after_submul)
                  + signed32(sy) + signed32(next_i) - 1,
              new_cells: [int -> word64] = cells(after_submul)
          IN
            lower <= middle
              AND middle <= upper
              AND
            (value_sub(new_cells, lower, upper)
                =
              value_sub(new_cells, lower, middle)
                + value_sub(new_cells, middle, upper)
                    * int_power(radix, middle - lower)
              IMPLIES
              access(xp, pointer_offset(xp) + 1)
                AND
              write_quotient_and_continue(
                sy, sx, next_i,
                x, y, q, after_submul, current_q, xp, qp,
                cells(after_submul)(pointer_offset(xp) + 1),
                max64, qh, dh, dl, vy)))))

  digit_choice(
      sy, sx, next_i: word32,
      x, y, q, current_x, current_q, xp, qp, xd: ptr,
      high, middle, low, v, qh, dh, dl: word64,
      vy: int): bool =
    FORALL (high_equal, low_equal: bool):
      equal_flag(high, dh, high_equal)
        IMPLIES
      (IF high_equal = TRUE
       THEN equal_flag(middle, dl, low_equal)
       ELSE low_equal = FALSE
       ENDIF)
        IMPLIES
      IF low_equal = TRUE THEN
        max_digit_branch(
          sy, sx, next_i,
          x, y, q, current_x, current_q, xp, qp, xd,
          high, qh, dh, dl, vy)
      ELSE
        small_digit_branch(
          sy, sx, next_i,
          x, y, q, current_x, current_q, xp, qp, xd,
          high, middle, low, v, qh, dh, dl, vy)
      ENDIF

  loop_body(
      sy, sx, i: word32,
      x, y, q, current_x, current_q, xp, qp: ptr,
      high, qh, v, dh, dl: word64,
      vy: int): bool =
    int32_in_bounds(signed32(i) - 1)
      AND
    FORALL (next_i: word32):
      signed32(next_i) = signed32(i) - 1
        IMPLIES
      0 <= signed32(i)
        AND signed32(next_i) < signed32(i)
        AND access_closed(xp, pointer_offset(xp) - 1)
        AND
      FORALL (next_xp: ptr):
        shifted(next_xp, xp, -1)
          IMPLIES
        access_closed(
          next_xp,
          pointer_offset(next_xp) + 2 - signed32(sy))
          AND
        FORALL (xd: ptr):
          shifted(xd, next_xp, 2 - signed32(sy))
            IMPLIES
          access(next_xp, pointer_offset(next_xp) + 1)
            AND access(next_xp, pointer_offset(next_xp))
            AND
          digit_choice(
            sy, sx, next_i,
            x, y, q, current_x, current_q, next_xp, qp, xd,
            high,
            cells(next_xp)(pointer_offset(next_xp) + 1),
            cells(next_xp)(pointer_offset(next_xp)),
            v, qh, dh, dl, vy)

  loop_exit(
      sy, sx: word32,
      x, y, q, current_x, current_q, xp: ptr,
      high, qh: word64): bool =
    value_sub(
      cells(current_x),
      pointer_offset(current_x),
      pointer_offset(xp))
      =
    value_sub(
      update_cells(
        cells(current_x),
        pointer_offset(xp) + 1,
        high),
      pointer_offset(current_x),
      pointer_offset(xp))
      IMPLIES
    access(xp, pointer_offset(xp) + 1)
      AND is_writable(xp) = TRUE
      AND
    FORALL (final_x: ptr):
      same_shape(final_x, current_x)
        IMPLIES
      single_update(
        final_x, current_x,
        pointer_offset(xp) + 1, high)
        IMPLIES
      final_postcondition(
        sy, sx, x, y, q, final_x, current_q, qh)

  all_loop_obligations(
      sy, sx: word32,
      x, y, q, initial_x, initial_q: ptr,
      qh, v, dh, dl: word64,
      vy: int): bool =
    FORALL
        (high: word64),
        (i: word32),
        (qp, xp, current_x, current_q: ptr):
      same_shape(current_x, initial_x)
        IMPLIES
      same_shape(current_q, initial_q)
        IMPLIES
      loop_invariant(
        sy, sx, i,
        x, y, q, current_x, current_q, xp, qp,
        high, qh, dh, dl, vy)
        IMPLIES
      IF 0 < signed32(i) THEN
        loop_body(
          sy, sx, i,
          x, y, q, current_x, current_q, xp, qp,
          high, qh, v, dh, dl, vy)
      ELSE
        loop_exit(
          sy, sx,
          x, y, q, current_x, current_q, xp,
          high, qh)
      ENDIF

  after_pre_adjust(
      sy, sx, initial_i: word32,
      x, y, q, adjusted_x, initial_q, xp, qp: ptr,
      qh, v, dh, dl: word64,
      vy: int): bool =
    access(xp, pointer_offset(xp) + 1)
      AND
    LET high: word64 =
      cells(xp)(pointer_offset(xp) + 1)
    IN
      loop_invariant(
        sy, sx, initial_i,
        x, y, q, adjusted_x, initial_q, xp, qp,
        high, qh, dh, dl, vy)
      AND
      all_loop_obligations(
        sy, sx,
        x, y, q, adjusted_x, initial_q,
        qh, v, dh, dl, vy)

  pre_adjust_state(
      sy, sx, initial_i: word32,
      x, y, q, xd, xp, qp: ptr,
      qh, v, dh, dl: word64,
      vy: int): bool =
    FORALL (flag: bool):
      zero_flag(qh, flag)
        IMPLIES
      IF NOT (flag = TRUE) THEN
        valid(xd, signed32(sy))
          AND valid(y, signed32(sy))
          AND is_writable(xd) = TRUE
          AND
        FORALL (adjusted_x: ptr), (borrow: word64):
          same_shape(adjusted_x, x)
            IMPLIES
          subtraction_at(
            adjusted_x, x, y,
            pointer_offset(xd),
            signed32(sy), borrow)
            IMPLIES
          (FORALL (adjusted_xp: ptr):
            rebased_snapshot(adjusted_xp, adjusted_x, xp)
              IMPLIES
            after_pre_adjust(
              sy, sx, initial_i,
              x, y, q, adjusted_x, q, adjusted_xp, qp,
              qh, v, dh, dl, vy))
      ELSE
        after_pre_adjust(
          sy, sx, initial_i,
          x, y, q, x, q, xp, qp,
          qh, v, dh, dl, vy)
      ENDIF

  after_compare(
      sy, sx, initial_i: word32,
      x, y, q, xd, xp, qp: ptr,
      v, dh, dl: word64): bool =
    LET vy: int = value(y, signed32(sy)) IN
      valid(xd, signed32(sy))
        AND valid(y, signed32(sy))
        AND
      FORALL (comparison: word32):
        signed32(comparison)
            = compare_int(
                value(xd, signed32(sy)),
                value(y, signed32(sy)))
          IMPLIES
        FORALL (qh: word64):
          (IF 0 <= signed32(comparison)
           THEN qh = one64 ELSE qh = zero64 ENDIF)
            IMPLIES
          pre_adjust_state(
            sy, sx, initial_i,
            x, y, q, xd, xp, qp,
            qh, v, dh, dl, vy)

  initialized_division(
      sy, sx, initial_i, mdn: word32,
      x, y, q, xp, qp: ptr,
      v, dh, dl: word64): bool =
    access_closed(
      xp,
      pointer_offset(xp) + signed32(mdn))
      AND
    FORALL (xd: ptr):
      shifted(xd, xp, signed32(mdn))
        IMPLIES
      after_compare(
        sy, sx, initial_i,
        x, y, q, xd, xp, qp,
        v, dh, dl)

  reciprocal_initialization(
      sy, sx, initial_i: word32,
      x, y, q, xp, qp: ptr,
      dh, dl: word64): bool =
    half_radix <= unsigned64(dh)
      AND
    FORALL (v: word64):
      reciprocal_3by2(v, dh, dl)
        IMPLIES
      int32_in_bounds(2 - signed32(sy))
        AND
      FORALL (mdn: word32):
        signed32(mdn) = 2 - signed32(sy)
          IMPLIES
        initialized_division(
          sy, sx, initial_i, mdn,
          x, y, q, xp, qp,
          v, dh, dl)

  divisor_initialization(
      sy, sx, initial_i: word32,
      x, y, q, xp, qp: ptr): bool =
    int32_in_bounds(signed32(sy) - 1)
      AND
    FORALL (high_index: word32):
      signed32(high_index) = signed32(sy) - 1
        IMPLIES
      access(
        y,
        pointer_offset(y) + signed32(high_index))
        AND
      LET dh: word64 =
        cells(y)(pointer_offset(y) + signed32(high_index))
      IN
        int32_in_bounds(signed32(sy) - 2)
          AND
        FORALL (low_index: word32):
          signed32(low_index) = signed32(sy) - 2
            IMPLIES
          access(
            y,
            pointer_offset(y) + signed32(low_index))
            AND
          LET dl: word64 =
            cells(y)(pointer_offset(y) + signed32(low_index))
          IN
            reciprocal_initialization(
              sy, sx, initial_i,
              x, y, q, xp, qp,
              dh, dl)

  pointer_initialization(
      sy, sx: word32,
      x, y, q, xp: ptr): bool =
    int32_in_bounds(signed32(sx) - signed32(sy))
      AND
    FORALL (initial_i: word32):
      signed32(initial_i)
          = signed32(sx) - signed32(sy)
        IMPLIES
      access_closed(
        q,
        pointer_offset(q) + signed32(initial_i))
        AND
      FORALL (qp: ptr):
        shifted(qp, q, signed32(initial_i))
          IMPLIES
        divisor_initialization(
          sy, sx, initial_i,
          x, y, q, xp, qp)

  div_Div_div_sb_qrqtvc_statement: bool =
    FORALL
        (sy, sx: word32),
        (x, y, q: ptr):
      3 <= signed32(sy)
        IMPLIES
      signed32(sy) <= signed32(sx)
        IMPLIES
      valid(x, signed32(sx))
        IMPLIES
      valid(y, signed32(sy))
        IMPLIES
      valid(q, signed32(sx) - signed32(sy))
        IMPLIES
      is_writable(q) = TRUE
        IMPLIES
      is_writable(x) = TRUE
        IMPLIES
      normalized(y, sy)
        IMPLIES
      int32_in_bounds(signed32(sx) - 2)
        AND
      (FORALL (start_index: word32):
        signed32(start_index) = signed32(sx) - 2
          IMPLIES
        access_closed(
          x,
          pointer_offset(x) + signed32(start_index))
          AND
        (FORALL (xp: ptr):
          shifted(xp, x, signed32(start_index))
            IMPLIES
          pointer_initialization(
            sy, sx, x, y, q, xp)))

END div_Div_div_sb_qrqtvc
