% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/sub_Sub_wmpn_sub_nqtvc: the loop verification
% condition for equal-length multiprecision subtraction, including borrow
% arithmetic, pointer aliasing, exact memory updates, loop invariants, and
% memory framing. This file contains no proof.

sub_Sub_wmpn_sub_nqtvc[zone: TYPE+]: THEORY
BEGIN

  IMPORTING
    bv[32], bv[64],
    bv_nat[32], bv_nat[64]

  word32: TYPE = bvec[32]
  word64: TYPE = bvec[64]

  ptr: TYPE =
    [# data_length: nat,
       cells: [int -> word64],
       pointer_offset: int,
       pointer_min: int,
       pointer_max: int,
       is_writable: bool,
       pointer_zone: zone #]

  radix: int = 18446744073709551616

  unsigned64(value1: word64): int =
    bv2nat[64](value1)

  signed32(value1: word32): int =
    IF value1(31) THEN
      bv2nat[32](value1) - 4294967296
    ELSE
      bv2nat[32](value1)
    ENDIF

  int_to_nat(value1: int): nat =
    IF value1 < 0 THEN 0 ELSE value1 ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  value_from(
      values: [int -> word64],
      start: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      unsigned64(values(start))
        + radix * value_from(values, start + 1, count - 1)
    ENDIF
  MEASURE count

  value(p: ptr, count: int): int =
    value_from(
      cells(p),
      pointer_offset(p),
      int_to_nat(count))

  plength(p: ptr): int =
    data_length(p)

  pelts(p: ptr): [int -> word64] =
    cells(p)

  int32_in_bounds(value1: int): bool =
    -2147483648 <= value1 AND value1 <= 2147483647

  valid(p: ptr, count: int): bool =
    int32_in_bounds(count)
      AND 0 <= count
      AND 0 <= pointer_min(p)
      AND pointer_min(p) <= pointer_offset(p)
      AND pointer_offset(p) + count <= pointer_max(p)
      AND pointer_max(p) <= plength(p)

  data_equal(left, right: ptr): bool =
    data_length(left) = data_length(right)
      AND cells(left) = cells(right)

  rebased_snapshot(
      fresh, shared, old: ptr): bool =
    data_equal(fresh, shared)
      AND plength(shared) = plength(old)
      AND pointer_offset(fresh) = pointer_offset(old)
      AND pointer_min(fresh) = pointer_min(old)
      AND pointer_max(fresh) = pointer_max(old)
      AND is_writable(fresh) = is_writable(old)
      AND pointer_zone(fresh) = pointer_zone(old)

  snapshot_metadata(
      fresh, old: ptr): bool =
    plength(fresh) = plength(old)
      AND pointer_offset(fresh) = pointer_offset(old)
      AND pointer_min(fresh) = pointer_min(old)
      AND pointer_max(fresh) = pointer_max(old)
      AND is_writable(fresh) = is_writable(old)
      AND pointer_zone(fresh) = pointer_zone(old)

  disjoint_or_equal(
      left, right: ptr,
      count: int): bool =
    pointer_offset(left) = pointer_offset(right)
      OR pointer_offset(left) + count <= pointer_offset(right)
      OR pointer_offset(right) + count <= pointer_offset(left)

  map_eq_sub(
      left, right: [int -> word64],
      lower, upper: int): bool =
    FORALL (index: int):
      lower <= index AND index < upper
        IMPLIES left(index) = right(index)

  frame(
      new, old: ptr,
      count: int): bool =
    FORALL (index: int):
      index < pointer_offset(new)
        OR pointer_offset(new) + count <= index
      IMPLIES pelts(new)(index) = pelts(old)(index)

  access(p: ptr, index: int): bool =
    pointer_min(p) <= index
      AND index < pointer_max(p)

  borrow_range(borrow: word64): bool =
    0 <= unsigned64(borrow)
      AND unsigned64(borrow) <= 1

  alias_preserved(
      result_current, operand_current, operand_old: ptr,
      size: word32): bool =
    pointer_offset(result_current) = pointer_offset(operand_current)
      OR
        map_eq_sub(
          pelts(operand_current),
          pelts(operand_old),
          pointer_offset(operand_current),
          pointer_offset(operand_current) + signed32(size))

  single_update(
      new, old: ptr,
      index: int,
      replacement: word64): bool =
    cells(new) = cells(old) WITH [(index) := replacement]
      AND pelts(new)(index) = replacement

  value_equation(
      current, minuend, subtrahend: ptr,
      count: int,
      borrow: word64): bool =
    value(current, count)
        - int_power(radix, count) * unsigned64(borrow)
      =
    value(minuend, count) - value(subtrahend, count)

  loop_invariant(
      size, index: word32,
      original_result, minuend, subtrahend: ptr,
      current, x_current, y_current: ptr,
      borrow: word64): bool =
    0 <= signed32(index)
      AND signed32(index) <= signed32(size)
      AND
        value_equation(
          current,
          minuend,
          subtrahend,
          signed32(index),
          borrow)
      AND frame(current, original_result, signed32(index))
      AND pelts(x_current) = pelts(current)
      AND pelts(current) = pelts(y_current)
      AND
        alias_preserved(
          current, x_current, minuend, size)
      AND
        alias_preserved(
          current, y_current, subtrahend, size)
      AND borrow_range(borrow)

  next_loop_invariant(
      size, index, next_index: word32,
      original_result, minuend, subtrahend: ptr,
      current, x_current, y_current: ptr,
      borrow: word64): bool =
    0 <= signed32(size) - signed32(index)
      AND
        signed32(size) - signed32(next_index)
          < signed32(size) - signed32(index)
      AND
        loop_invariant(
          size, next_index,
          original_result, minuend, subtrahend,
          current, x_current, y_current,
          borrow)

  after_update(
      size, index: word32,
      original_result, minuend, subtrahend: ptr,
      current, x_current, y_current: ptr,
      borrow: word64): bool =
    int32_in_bounds(signed32(index) + 1)
      AND
        (FORALL (next_index: word32):
          signed32(next_index) = signed32(index) + 1
            IMPLIES
              next_loop_invariant(
                size, index, next_index,
                original_result, minuend, subtrahend,
                current, x_current, y_current,
                borrow))

  write_result(
      size, index: word32,
      original_result, minuend, subtrahend: ptr,
      current, x_current, y_current: ptr,
      incoming, result, outgoing: word64): bool =
    unsigned64(result) - radix * unsigned64(outgoing)
        =
      unsigned64(
        pelts(x_current)(
          pointer_offset(x_current) + signed32(index)))
        -
      unsigned64(
        pelts(y_current)(
          pointer_offset(y_current) + signed32(index)))
        - unsigned64(incoming)
      AND borrow_range(outgoing)
      IMPLIES
        (access(
          current,
          pointer_offset(current) + signed32(index))
          AND is_writable(current) = TRUE)
        AND
          (FORALL (y_next, x_next, r_next: ptr):
            rebased_snapshot(y_next, r_next, y_current)
              IMPLIES
                rebased_snapshot(x_next, r_next, x_current)
              IMPLIES
                snapshot_metadata(r_next, current)
              IMPLIES
                single_update(
                  r_next,
                  current,
                  pointer_offset(r_next) + signed32(index),
                  result)
              IMPLIES
                after_update(
                  size, index,
                  original_result, minuend, subtrahend,
                  r_next, x_next, y_next,
                  outgoing))

  final_state(
      size: word32,
      original_result, minuend, subtrahend: ptr,
      current, x_current, y_current: ptr,
      borrow: word64): bool =
    value_equation(
      current,
      minuend,
      subtrahend,
      signed32(size),
      borrow)
      AND borrow_range(borrow)
      AND frame(current, original_result, signed32(size))
      AND
        alias_preserved(
          current, x_current, minuend, size)
      AND
        alias_preserved(
          current, y_current, subtrahend, size)

  loop_step(
      size, index: word32,
      original_result, minuend, subtrahend: ptr,
      current, x_current, y_current: ptr,
      incoming: word64): bool =
    IF signed32(index) < signed32(size) THEN
      access(
        x_current,
        pointer_offset(x_current) + signed32(index))
        AND
          access(
            y_current,
            pointer_offset(y_current) + signed32(index))
        AND
          access(
            minuend,
            pointer_offset(minuend) + signed32(index))
        AND
          access(
            subtrahend,
            pointer_offset(subtrahend) + signed32(index))
        AND borrow_range(incoming)
        AND
          (FORALL (result, outgoing: word64):
            write_result(
              size, index,
              original_result, minuend, subtrahend,
              current, x_current, y_current,
              incoming, result, outgoing))
    ELSE
      final_state(
        size,
        original_result, minuend, subtrahend,
        current, x_current, y_current,
        incoming)
    ENDIF

  all_loop_states(
      size: word32,
      original_result, minuend, subtrahend: ptr): bool =
    FORALL
        (index: word32),
        (incoming: word64),
        (y_current, x_current, current: ptr):
      rebased_snapshot(y_current, current, subtrahend)
        IMPLIES
          rebased_snapshot(x_current, current, minuend)
        IMPLIES
          snapshot_metadata(current, original_result)
        IMPLIES
          loop_invariant(
            size, index,
            original_result, minuend, subtrahend,
            current, x_current, y_current,
            incoming)
        IMPLIES
          loop_step(
            size, index,
            original_result, minuend, subtrahend,
            current, x_current, y_current,
            incoming)

  initial_state(
      size: word32,
      result_pointer, minuend, subtrahend: ptr): bool =
    0 <= 0
      AND 0 <= signed32(size)
      AND
        value(result_pointer, 0)
            - int_power(radix, 0) * 0
          =
        value(minuend, 0) - value(subtrahend, 0)
      AND pelts(minuend) = pelts(result_pointer)
      AND pelts(result_pointer) = pelts(subtrahend)
      AND
        (pointer_offset(result_pointer) = pointer_offset(minuend)
          OR
            map_eq_sub(
              pelts(minuend),
              pelts(minuend),
              pointer_offset(minuend),
              pointer_offset(minuend) + signed32(size)))
      AND
        (pointer_offset(result_pointer) = pointer_offset(subtrahend)
          OR
            map_eq_sub(
              pelts(subtrahend),
              pelts(subtrahend),
              pointer_offset(subtrahend),
              pointer_offset(subtrahend) + signed32(size)))
      AND 0 <= 0
      AND 0 <= 1
      AND
        all_loop_states(
          size,
          result_pointer,
          minuend,
          subtrahend)

  wmpn_sub_n_vc: bool =
    FORALL
        (size: word32),
        (result_pointer, minuend, subtrahend: ptr):
      0 <= signed32(size)
        IMPLIES
          valid(result_pointer, signed32(size))
        IMPLIES
          valid(minuend, signed32(size))
        IMPLIES
          valid(subtrahend, signed32(size))
        IMPLIES
          disjoint_or_equal(
            result_pointer, minuend, signed32(size))
        IMPLIES
          disjoint_or_equal(
            result_pointer, subtrahend, signed32(size))
        IMPLIES
          data_equal(result_pointer, minuend)
        IMPLIES
          data_equal(minuend, subtrahend)
        IMPLIES
          is_writable(result_pointer) = TRUE
        IMPLIES
          initial_state(
            size,
            result_pointer,
            minuend,
            subtrahend)

END sub_Sub_wmpn_sub_nqtvc
