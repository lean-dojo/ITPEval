% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/get_str_Get_str_wmpn_get_strqtvc: the verification
% condition selecting power-of-two or general-base conversion of a positive
% multiprecision integer to a bounded digit string. This file contains no proof.

get_str_Get_str_wmpn_get_strqtvc[zone: TYPE+]: THEORY
BEGIN

  IMPORTING
    bv[8], bv[32], bv[64],
    bv_nat[8], bv_nat[32], bv_nat[64]

  word8: TYPE = bvec[8]
  word32: TYPE = bvec[32]
  word64: TYPE = bvec[64]

  ptr8: TYPE =
    [# data_length8: nat,
       cells8: [int -> word8],
       offset8: int,
       min8: int,
       max8: int,
       writable8: bool,
       zone8: zone #]

  ptr64: TYPE =
    [# data_length64: nat,
       cells64: [int -> word64],
       offset64: int,
       min64: int,
       max64: int,
       writable64: bool,
       zone64: zone #]

  base_info: TYPE =
    [# info_base: int,
       info_exp: word32,
       info_bb: word64 #]

  radix: int = 18446744073709551616
  max_uint64: int = 18446744073709551615
  max_int32: int = 2147483647

  zero32: word32 = fill[32](FALSE)

  unsigned32(value1: word32): int =
    bv2nat[32](value1)

  unsigned64(value1: word64): int =
    bv2nat[64](value1)

  unsigned8(value1: word8): int =
    bv2nat[8](value1)

  signed32(value1: word32): int =
    IF value1(31) THEN
      bv2nat[32](value1) - 4294967296
    ELSE
      bv2nat[32](value1)
    ENDIF

  int_to_nat(value1: int): nat =
    IF value1 < 0 THEN 0 ELSE value1 ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  euclidean_div(numerator, denominator: int): int =
    IF denominator <= 0 THEN
      0
    ELSE
      floor((numerator :: real) / (denominator :: real))
    ENDIF

  int32_in_bounds(value1: int): bool =
    -2147483648 <= value1 AND value1 <= max_int32

  valid8(p: ptr8, count: int): bool =
    int32_in_bounds(count)
      AND 0 <= count
      AND 0 <= min8(p)
      AND min8(p) <= offset8(p)
      AND offset8(p) + count <= max8(p)
      AND max8(p) <= data_length8(p)

  valid64(p: ptr64, count: int): bool =
    int32_in_bounds(count)
      AND 0 <= count
      AND 0 <= min64(p)
      AND min64(p) <= offset64(p)
      AND offset64(p) + count <= max64(p)
      AND max64(p) <= data_length64(p)

  same_shape8(newer, older: ptr8): bool =
    data_length8(newer) = data_length8(older)
      AND offset8(newer) = offset8(older)
      AND min8(newer) = min8(older)
      AND max8(newer) = max8(older)
      AND writable8(newer) = writable8(older)
      AND zone8(newer) = zone8(older)

  frame8(newer, older: ptr8, upper: int): bool =
    FORALL (index: int):
      index < offset8(newer) OR upper <= index
        IMPLIES cells8(newer)(index) = cells8(older)(index)

  value_from(
      values: [int -> word64],
      start: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      unsigned64(values(start))
        + radix * value_from(values, start + 1, count - 1)
    ENDIF
  MEASURE count

  value64(p: ptr64, count: int): int =
    value_from(cells64(p), offset64(p), int_to_nat(count))

  svalue_from_high(
      base: int,
      values: [int -> word8],
      lower: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      unsigned8(values(lower + count - 1))
        + base * svalue_from_high(base, values, lower, count - 1)
    ENDIF
  MEASURE count

  svalue(base: int, p: ptr8, count: int): int =
    svalue_from_high(
      base, cells8(p), offset8(p), int_to_nat(count))

  in_base(
      base: int,
      values: [int -> word8],
      lower, upper: int): bool =
    FORALL (index: int):
      lower <= index AND index < upper
        IMPLIES
          0 <= unsigned8(values(index))
            AND unsigned8(values(index)) < base

  info_ok(info: base_info): bool =
    2 <= info_base(info)
      AND info_base(info) <= 256
      AND unsigned64(info_bb(info)) < radix
      AND radix <= unsigned64(info_bb(info)) * info_base(info)
      AND 7 <= unsigned32(info_exp(info))
      AND unsigned32(info_exp(info)) <= 63
      AND unsigned64(info_bb(info))
        = int_power(info_base(info), unsigned32(info_exp(info)))

  final_contract(
      base_value: int,
      current_sp: ptr8,
      up: ptr64,
      un, size, result: word32): bool =
    in_base(
      base_value,
      cells8(current_sp),
      offset8(current_sp),
      offset8(current_sp) + unsigned32(result))
      AND
        svalue(base_value, current_sp, unsigned32(result))
          = value64(up, signed32(un))
      AND 0 < unsigned32(result)
      AND unsigned32(result) < signed32(size)
      AND 0 < unsigned8(cells8(current_sp)(offset8(current_sp)))

  bits_result_hypothesis(
      bits: word32,
      current_sp, original_sp: ptr8,
      up: ptr64,
      un, bit_count, result: word32): bool =
    in_base(
      int_power(2, unsigned32(bits)),
      cells8(current_sp),
      offset8(current_sp),
      offset8(current_sp) + unsigned32(result))
      AND
        svalue(
          int_power(2, unsigned32(bits)),
          current_sp,
          unsigned32(result))
          = value64(up, signed32(un))
      AND 0 < unsigned32(result)
      AND
        unsigned32(result)
          <= euclidean_div(
            signed32(bit_count) + unsigned32(bits) - 1,
            unsigned32(bits))
      AND 0 < unsigned8(cells8(current_sp)(offset8(current_sp)))
      AND
        frame8(
          current_sp,
          original_sp,
          offset8(current_sp)
            + euclidean_div(
                signed32(bit_count) + unsigned32(bits) - 1,
                unsigned32(bits)))

  bits_after_word(
      size, un: word32,
      sp: ptr8,
      up: ptr64,
      base, bits, bit_count: word32): bool =
    1 <= signed32(un)
      AND valid64(up, signed32(un))
      AND 1 <= unsigned32(bits)
      AND unsigned32(bits) <= 8
      AND
        valid8(
          sp,
          euclidean_div(
            signed32(bit_count) + unsigned32(bits) - 1,
            unsigned32(bits)))
      AND 0 <= signed32(bit_count)
      AND
        value64(up, signed32(un))
          < int_power(2, signed32(bit_count))
      AND
        0
          < unsigned64(
              cells64(up)(offset64(up) + signed32(un) - 1))
      AND 64 * signed32(un) + 7 <= max_int32
      AND writable8(sp) = TRUE
      AND
        (FORALL (current_sp: ptr8):
          same_shape8(current_sp, sp)
            IMPLIES
              (FORALL (result: word32):
                bits_result_hypothesis(
                  bits, current_sp, sp, up, un, bit_count, result)
                  IMPLIES
                    final_contract(
                      signed32(base),
                      current_sp,
                      up,
                      un,
                      size,
                      result)))

  bits_branch(
      size, un: word32,
      sp: ptr8,
      up: ptr64,
      base, bits: word32): bool =
    int32_in_bounds(64 * signed32(un))
      AND
        (FORALL (bit_count: word32):
          signed32(bit_count) = 64 * signed32(un)
            IMPLIES
              bits_after_word(
                size, un, sp, up, base, bits, bit_count))

  other_result_hypothesis(
      base_value: int,
      current_sp, original_sp: ptr8,
      up: ptr64,
      un, size, result: word32): bool =
    0 <= unsigned32(result)
      AND unsigned32(result) < signed32(size)
      AND
        svalue(base_value, current_sp, unsigned32(result))
          = value64(up, signed32(un))
      AND
        in_base(
          base_value,
          cells8(current_sp),
          offset8(current_sp),
          offset8(current_sp) + unsigned32(result))
      AND 0 < unsigned8(cells8(current_sp)(offset8(current_sp)))
      AND
        frame8(
          current_sp,
          original_sp,
          offset8(current_sp) + signed32(size))

  other_after_info(
      size, un: word32,
      sp: ptr8,
      up: ptr64,
      base: word32,
      info: base_info): bool =
    valid64(up, signed32(un))
      AND 1 <= signed32(un)
      AND info_base(info) = signed32(base)
      AND writable64(up) = TRUE
      AND writable8(sp) = TRUE
      AND
        0
          < unsigned64(
              cells64(up)(offset64(up) + signed32(un) - 1))
      AND 0 < signed32(size)
      AND valid8(sp, signed32(size))
      AND
        value64(up, signed32(un))
          < int_power(signed32(base), signed32(size) - 1)
      AND
        (FORALL (current_sp: ptr8):
          same_shape8(current_sp, sp)
            IMPLIES
              (FORALL (result: word32):
                other_result_hypothesis(
                  signed32(base),
                  current_sp,
                  sp,
                  up,
                  un,
                  size,
                  result)
                  IMPLIES
                    final_contract(
                      signed32(base),
                      current_sp,
                      up,
                      un,
                      size,
                      result)))

  other_branch(
      size, un: word32,
      sp: ptr8,
      up: ptr64,
      base: word32): bool =
    0 <= signed32(base)
      AND
        (FORALL (base_limb: word64):
          unsigned64(base_limb) = signed32(base)
            IMPLIES
              (2 <= unsigned64(base_limb)
                AND unsigned64(base_limb) <= 256)
              AND
                (FORALL (info: base_info):
                  info_ok(info)
                    AND info_base(info) = unsigned64(base_limb)
                    IMPLIES
                      other_after_info(
                        size, un, sp, up, base, info)))

  bits_characterization(base_limb: word64, bits: word32): bool =
    (0 <= unsigned32(bits) AND unsigned32(bits) <= 8)
      AND
        (NOT (unsigned32(bits) = 0)
          IMPLIES
            int_power(2, unsigned32(bits))
              = unsigned64(base_limb))
      AND
        (unsigned32(bits) = 0
          IMPLIES
            (FORALL (exponent: int):
              0 <= exponent
                IMPLIES
                  NOT (
                    int_power(2, exponent)
                      = unsigned64(base_limb))))

  base_limb_branch(
      size, un: word32,
      sp: ptr8,
      up: ptr64,
      base: word32,
      base_limb: word64): bool =
    (2 <= unsigned64(base_limb)
      AND unsigned64(base_limb) <= 256)
      AND
        (FORALL (bits: word32):
          bits_characterization(base_limb, bits)
            IMPLIES
              (unsigned32(bits) = 0 IMPLIES bits = zero32)
            IMPLIES
              IF NOT (bits = zero32) THEN
                bits_branch(size, un, sp, up, base, bits)
              ELSE
                other_branch(size, un, sp, up, base)
              ENDIF)

  wmpn_get_str_vc: bool =
    FORALL (
        size, un: word32,
        sp: ptr8,
        up: ptr64,
        base: word32):
      0 < signed32(size)
        AND 0 < signed32(un)
        AND valid8(sp, signed32(size))
        AND valid64(up, signed32(un))
        AND writable8(sp) = TRUE
        AND writable64(up) = TRUE
        AND
          int_power(radix, signed32(un))
            <= int_power(signed32(base), signed32(size) - 1)
        AND
          0
            < unsigned64(
                cells64(up)(offset64(up) + signed32(un) - 1))
        AND 2 <= signed32(base)
        AND signed32(base) <= 256
        AND 64 * signed32(un) + 7 <= max_int32
      IMPLIES
        0 <= signed32(base)
          AND
            (FORALL (base_limb: word64):
              unsigned64(base_limb) = signed32(base)
                IMPLIES
                  base_limb_branch(
                    size, un, sp, up, base, base_limb))

END get_str_Get_str_wmpn_get_strqtvc
