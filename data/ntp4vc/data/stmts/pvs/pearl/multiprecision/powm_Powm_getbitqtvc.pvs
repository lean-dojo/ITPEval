% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/powm_Powm_getbitqtvc: the verification condition for
% extracting one bit from a valid multiprecision limb array and relating it
% to full-array division and the bit-prefix value recurrence.
% This file contains no proof.

powm_Powm_getbitqtvc[zone: TYPE+]: THEORY
BEGIN

  IMPORTING
    bv[32], bv[64],
    bv_nat[32], bv_nat[64]

  word32: TYPE = bvec[32]
  word64: TYPE = bvec[64]

  ptr: TYPE =
    [# data_length: nat,
       cells: [int -> word64],
       pointer_offset: int,
       pointer_min: int,
       pointer_max: int,
       is_writable: bool,
       pointer_zone: zone #]

  radix: int = 18446744073709551616
  max_word64: int = 18446744073709551615

  unsigned64(value1: word64): int =
    bv2nat[64](value1)

  signed32(value1: word32): int =
    IF value1(31) THEN
      bv2nat[32](value1) - 4294967296
    ELSE
      bv2nat[32](value1)
    ENDIF

  int32_in_bounds(value1: int): bool =
    -2147483648 <= value1 AND value1 <= 2147483647

  uint64_in_bounds(value1: int): bool =
    0 <= value1 AND value1 <= max_word64

  int_to_nat(value1: int): nat =
    IF value1 < 0 THEN 0 ELSE value1 ENDIF

  int_abs(value1: int): int =
    IF value1 < 0 THEN -value1 ELSE value1 ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  euclidean_div_positive(
      numerator, denominator: int): int =
    IF denominator <= 0 THEN
      0
    ELSE
      floor((numerator :: real) / (denominator :: real))
    ENDIF

  truncating_div(
      numerator, denominator: int): int =
    IF denominator = 0 THEN
      0
    ELSIF numerator * denominator >= 0 THEN
      floor(
        (int_abs(numerator) :: real)
          / (int_abs(denominator) :: real))
    ELSE
      -floor(
        (int_abs(numerator) :: real)
          / (int_abs(denominator) :: real))
    ENDIF

  truncating_mod(
      numerator, denominator: int): int =
    numerator - denominator * truncating_div(numerator, denominator)

  plength(p: ptr): int =
    data_length(p)

  pelts(p: ptr, index: int): word64 =
    cells(p)(index)

  valid(p: ptr, size: int): bool =
    int32_in_bounds(size)
      AND 0 <= size
      AND 0 <= pointer_min(p)
      AND pointer_min(p) <= pointer_offset(p)
      AND pointer_offset(p) + size <= pointer_max(p)
      AND pointer_max(p) <= plength(p)

  value_from(
      p: ptr,
      start: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      unsigned64(pelts(p, start))
        + radix * value_from(p, start + 1, count - 1)
    ENDIF
  MEASURE count

  value(p: ptr, size: int): int =
    value_from(
      p,
      pointer_offset(p),
      int_to_nat(size))

  valueb(p: ptr, bit_count: int): int =
    IF bit_count < 0 THEN
      0
    ELSE
      LET limb_index =
        euclidean_div_positive(bit_count, 64)
      IN
        value(p, limb_index)
          + int_power(radix, limb_index)
              * mod(
                  unsigned64(
                    pelts(
                      p,
                      pointer_offset(p) + limb_index)),
                  int_power(
                    2,
                    bit_count - 64 * limb_index))
    ENDIF

  pelts_equal(left, right: ptr): bool =
    FORALL (index: int):
      pelts(left, index) = pelts(right, index)

  source_data_equal(left, right: ptr): bool =
    data_length(left) = data_length(right)
      AND cells(left) = cells(right)

  shifted_pointer(
      shifted, original: ptr,
      o4: word32): bool =
    pointer_offset(shifted)
        = pointer_offset(original) + signed32(o4)
      AND plength(shifted) = plength(original)
      AND pelts_equal(shifted, original)
      AND source_data_equal(shifted, original)
      AND pointer_min(shifted) = pointer_min(original)
      AND pointer_max(shifted) = pointer_max(original)
      AND pointer_zone(shifted) = pointer_zone(original)
      AND is_writable(shifted) = is_writable(original)

  result_obligation(
      p: ptr,
      pn, bi: word32,
      lps: word64): bool =
    FORALL (result: word64):
      unsigned64(result) = truncating_mod(unsigned64(lps), 2)
        IMPLIES
          (0 <= unsigned64(result)
            AND unsigned64(result) <= 1)
          AND
            unsigned64(result)
              =
            mod(
              euclidean_div_positive(
                value(p, signed32(pn)),
                int_power(2, signed32(bi) - 1)),
              2)
          AND
            valueb(p, signed32(bi))
              =
            valueb(p, signed32(bi) - 1)
              + int_power(2, signed32(bi) - 1)
                  * unsigned64(result)

  res_obligation(
      p: ptr,
      pn, bi: word32,
      lps: word64): bool =
    FORALL (res: word64):
      unsigned64(res) = truncating_mod(unsigned64(lps), 2)
        IMPLIES
          NOT (2 = 0)
          AND
            (NOT (2 = 0)
              AND
                uint64_in_bounds(
                  truncating_mod(unsigned64(lps), 2)))
          AND result_obligation(p, pn, bi, lps)

  lps_obligation(
      p: ptr,
      pn, bi, i: word32,
      mi: word64): bool =
    FORALL (lps: word64):
      unsigned64(lps)
          =
        euclidean_div_positive(
          unsigned64(
            pelts(
              p,
              pointer_offset(p) + signed32(i))),
          int_power(2, unsigned64(mi)))
        IMPLIES
          NOT (int_power(2, unsigned64(mi)) = 0)
          AND
            (NOT (2 = 0)
              AND
                uint64_in_bounds(
                  truncating_mod(unsigned64(lps), 2)))
          AND res_obligation(p, pn, bi, lps)

  p_prime_obligation(
      p: ptr,
      pn, bi, i: word32,
      mi: word64,
      o4: word32): bool =
    FORALL (p_prime: ptr):
      shifted_pointer(p_prime, p, o4)
        IMPLIES
          (0 <= unsigned64(mi)
            AND unsigned64(mi) < 64)
          AND lps_obligation(p, pn, bi, i, mi)

  o4_obligation(
      p: ptr,
      pn, bi, i: word32,
      mi: word64): bool =
    FORALL (o4: word32):
      signed32(o4) = signed32(i) + 1
        IMPLIES
          (pointer_min(p)
              <= pointer_offset(p) + signed32(o4)
            AND
              pointer_offset(p) + signed32(o4)
                <= pointer_max(p))
          AND p_prime_obligation(p, pn, bi, i, mi, o4)

  mi_obligation(
      p: ptr,
      pn, bi, i: word32,
      o3: word64): bool =
    FORALL (mi: word64):
      unsigned64(mi) = truncating_mod(unsigned64(o3), 64)
        IMPLIES
          (pointer_min(p)
              <= pointer_offset(p) + signed32(i)
            AND
              pointer_offset(p) + signed32(i)
                < pointer_max(p))
          AND int32_in_bounds(signed32(i) + 1)
          AND o4_obligation(p, pn, bi, i, mi)

  o2_obligation(
      p: ptr,
      pn, bi, i: word32): bool =
    FORALL (o2: word32):
      signed32(o2) = signed32(bi) - 1
        IMPLIES
          0 <= signed32(o2)
          AND
            (FORALL (o3: word64):
              unsigned64(o3) = signed32(o2)
                IMPLIES
                  (NOT (64 = 0)
                    AND
                      uint64_in_bounds(
                        truncating_mod(unsigned64(o3), 64)))
                  AND mi_obligation(p, pn, bi, i, o3))

  i_obligation(
      p: ptr,
      pn, bi, o1: word32): bool =
    FORALL (i: word32):
      signed32(i) = truncating_div(signed32(o1), 64)
        IMPLIES
          int32_in_bounds(signed32(bi) - 1)
          AND o2_obligation(p, pn, bi, i)

  o1_obligation(
      p: ptr,
      pn, bi: word32): bool =
    FORALL (o1: word32):
      signed32(o1) = signed32(bi) - 1
        IMPLIES
          (NOT (64 = 0)
            AND
              int32_in_bounds(
                truncating_div(signed32(o1), 64)))
          AND i_obligation(p, pn, bi, o1)

  getbit_vc: bool =
    FORALL (p: ptr), (pn, bi: word32):
      valid(p, signed32(pn))
        IMPLIES
          1 <= signed32(bi)
        IMPLIES
          euclidean_div_positive(signed32(bi) + 63, 64)
            <= signed32(pn)
        IMPLIES
          int32_in_bounds(signed32(bi) - 1)
          AND o1_obligation(p, pn, bi)

END powm_Powm_getbitqtvc
