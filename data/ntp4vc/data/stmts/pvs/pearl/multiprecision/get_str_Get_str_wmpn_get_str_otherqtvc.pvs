                                                            signed32(un)),
                                                          up,
                                                          un,
                                                          signed32(base),
                                                          info,
                                                          sp,
                                                          size,
                                                          shift,
                                                          d1,
                                                          di)))))))

END get_str_Get_str_wmpn_get_str_otherqtvc
