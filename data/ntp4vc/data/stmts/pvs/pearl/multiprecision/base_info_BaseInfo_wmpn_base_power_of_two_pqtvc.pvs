% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/base_info_BaseInfo_wmpn_base_power_of_two_pqtvc:
% the verification condition for recognizing a 64-bit base from 2 through 256
% as a power of two and returning its exponent from 1 through 8, or zero when
% no nonnegative exponent represents the base. This file contains no proof.

base_info_BaseInfo_wmpn_base_power_of_two_pqtvc: THEORY
BEGIN

  IMPORTING
    bv[32], bv[64],
    bv_nat[32], bv_nat[64]

  word32: TYPE = bvec[32]
  word64: TYPE = bvec[64]

  unsigned32(value: word32): int =
    bv2nat[32](value)

  unsigned64(value: word64): int =
    bv2nat[64](value)

  word32_of_nat(value: nat): word32 =
    nat2bv[32](value)

  word64_of_nat(value: nat): word64 =
    nat2bv[64](value)

  int_to_nat(value: int): nat =
    IF value < 0 THEN 0 ELSE value ENDIF

  nat_power(base: int, exponent: nat): RECURSIVE int =
    IF exponent = 0 THEN
      1
    ELSE
      base * nat_power(base, exponent - 1)
    ENDIF
  MEASURE exponent

  int_power(base, exponent: int): int =
    nat_power(base, int_to_nat(exponent))

  wmpn_base_power_of_two_p_vc: bool =
    FORALL
        (b: word64),
        (o1: bool),
        (result: word32):
      2 <= unsigned64(b)
        IMPLIES
      unsigned64(b) <= 256
        IMPLIES
      (unsigned64(b) = unsigned64(word64_of_nat(2))
        IMPLIES o1 = TRUE)
        IMPLIES
      (o1 = TRUE
        IMPLIES b = word64_of_nat(2))
        IMPLIES
      (IF o1 = TRUE THEN
         result = word32_of_nat(1)
       ELSE
         EXISTS (o2: bool):
           ((unsigned64(b) = unsigned64(word64_of_nat(4))
               IMPLIES o2 = TRUE)
             AND
            (o2 = TRUE
               IMPLIES b = word64_of_nat(4)))
             AND
           (IF o2 = TRUE THEN
              result = word32_of_nat(2)
            ELSE
              EXISTS (o3: bool):
                ((unsigned64(b) = unsigned64(word64_of_nat(8))
                    IMPLIES o3 = TRUE)
                  AND
                 (o3 = TRUE
                    IMPLIES b = word64_of_nat(8)))
                  AND
                (IF o3 = TRUE THEN
                   result = word32_of_nat(3)
                 ELSE
                   EXISTS (o4: bool):
                     ((unsigned64(b) = unsigned64(word64_of_nat(16))
                         IMPLIES o4 = TRUE)
                       AND
                      (o4 = TRUE
                         IMPLIES b = word64_of_nat(16)))
                       AND
                     (IF o4 = TRUE THEN
                        result = word32_of_nat(4)
                      ELSE
                        EXISTS (o5: bool):
                          ((unsigned64(b)
                                = unsigned64(word64_of_nat(32))
                              IMPLIES o5 = TRUE)
                            AND
                           (o5 = TRUE
                              IMPLIES b = word64_of_nat(32)))
                            AND
                          (IF o5 = TRUE THEN
                             result = word32_of_nat(5)
                           ELSE
                             EXISTS (o6: bool):
                               ((unsigned64(b)
                                     = unsigned64(word64_of_nat(64))
                                   IMPLIES o6 = TRUE)
                                 AND
                                (o6 = TRUE
                                   IMPLIES b = word64_of_nat(64)))
                                 AND
                               (IF o6 = TRUE THEN
                                  result = word32_of_nat(6)
                                ELSE
                                  EXISTS (o7: bool):
                                    ((unsigned64(b)
                                          = unsigned64(
                                              word64_of_nat(128))
                                        IMPLIES o7 = TRUE)
                                      AND
                                     (o7 = TRUE
                                        IMPLIES b = word64_of_nat(128)))
                                      AND
                                    (IF o7 = TRUE THEN
                                       result = word32_of_nat(7)
                                     ELSE
                                       EXISTS (o8: bool):
                                         ((unsigned64(b)
                                               = unsigned64(
                                                   word64_of_nat(256))
                                             IMPLIES o8 = TRUE)
                                           AND
                                          (o8 = TRUE
                                             IMPLIES
                                               b = word64_of_nat(256)))
                                           AND
                                         (IF o8 = TRUE THEN
                                            result = word32_of_nat(8)
                                          ELSE
                                            result = word32_of_nat(0)
                                          ENDIF)
                                     ENDIF)
                                ENDIF)
                           ENDIF)
                      ENDIF)
                 ENDIF)
            ENDIF)
       ENDIF)
        IMPLIES
          0 <= unsigned32(result)
            AND unsigned32(result) <= 8
            AND
              (unsigned32(result) /= 0
                IMPLIES
                  int_power(2, unsigned32(result))
                    = unsigned64(b))
            AND
              (unsigned32(result) = 0
                IMPLIES
                  (FORALL (n: int):
                    0 <= n
                      IMPLIES int_power(2, n) /= unsigned64(b)))

END base_info_BaseInfo_wmpn_base_power_of_two_pqtvc
