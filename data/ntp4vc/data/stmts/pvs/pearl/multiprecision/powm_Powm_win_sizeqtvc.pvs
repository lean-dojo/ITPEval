% Statement-only formalization of the NTP4VC corpus artifact
% pearl/multiprecision/powm_Powm_win_sizeqtvc: the verification condition for
% selecting a multiprecision exponentiation window size from a signed 32-bit
% bit length, with range and positivity postconditions. This file contains no proof.

powm_Powm_win_sizeqtvc: THEORY
BEGIN

  IMPORTING
    bv[32],
    bv_nat[32]

  word32: TYPE = bvec[32]

  word32_of_nat(value: below(exp2(32))): word32 =
    nat2bv[32](value)

  zero32: word32 = fill[32](FALSE)

  signed32(value: word32): int =
    IF value(31) THEN
      bv2nat[32](value) - 4294967296
    ELSE
      bv2nat[32](value)
    ENDIF

  window_result(eb: word32, zero_case: bool): word32 =
    IF zero_case = TRUE THEN
      word32_of_nat(0)
    ELSIF signed32(eb) <= 7 THEN
      word32_of_nat(1)
    ELSIF signed32(eb) <= 25 THEN
      word32_of_nat(2)
    ELSIF signed32(eb) <= 81 THEN
      word32_of_nat(3)
    ELSIF signed32(eb) <= 214 THEN
      word32_of_nat(4)
    ELSIF signed32(eb) <= 673 THEN
      word32_of_nat(5)
    ELSIF signed32(eb) <= 1793 THEN
      word32_of_nat(6)
    ELSIF signed32(eb) <= 4609 THEN
      word32_of_nat(7)
    ELSIF signed32(eb) <= 11521 THEN
      word32_of_nat(8)
    ELSIF signed32(eb) <= 28161 THEN
      word32_of_nat(9)
    ELSE
      word32_of_nat(10)
    ENDIF

  win_size_vc: bool =
    FORALL
        (eb, result: word32),
        (o1: bool):
      (signed32(eb) = signed32(zero32)
        IMPLIES o1 = TRUE)
        IMPLIES
      (o1 = TRUE
        IMPLIES eb = zero32)
        IMPLIES
      result = window_result(eb, o1)
        IMPLIES
          0 <= signed32(result)
            AND signed32(result) <= 10
            AND
              (0 < signed32(eb)
                IMPLIES 0 < signed32(result))

END powm_Powm_win_sizeqtvc
