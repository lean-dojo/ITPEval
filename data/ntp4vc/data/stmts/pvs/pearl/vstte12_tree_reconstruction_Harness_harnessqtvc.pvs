% Statement-only formalization of the NTP4VC corpus artifact
% pearl/vstte12_tree_reconstruction_Harness_harnessqtvc: the leaf-depth
% sequence [1, 3, 3, 2] uniquely reconstructs the specified finite binary
% tree, and such a tree exists. This file contains no proof.

vstte12_tree_reconstruction_Harness_harnessqtvc: THEORY
BEGIN

  tree: DATATYPE
  BEGIN
    Leaf: Leaf?
    Node(left: tree, right: tree): Node?
  END tree

  depths(d: int, value: tree): RECURSIVE list[int] =
    CASES value OF
      Leaf:
        cons(d, null[int]),
      Node(left_tree, right_tree):
        append(
          depths(d + 1, left_tree),
          depths(d + 1, right_tree))
    ENDCASES
  MEASURE value BY <<

  harness_vc: bool =
    LET o1: list[int] =
      cons(
        1,
        cons(
          3,
          cons(
            3,
            cons(2, null[int]))))
    IN
      (FORALL (result: tree):
        depths(0, result) = o1
          IMPLIES
            result =
              Node(
                Leaf,
                Node(
                  Node(Leaf, Leaf),
                  Leaf)))
      AND
        NOT (FORALL (value: tree):
          depths(0, value) /= o1)

END vstte12_tree_reconstruction_Harness_harnessqtvc
