:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/longest_increasing_subsequence_Backtracking_lissqtvc: the
:: backtracking longest-increasing-subsequence verification condition
:: preserves subsequence, maximality, and loop invariants. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1,
    MARGREL1, XBOOLEAN;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultE being Element of E,
      Lt being Relation of E,E,
      nthZ being Function of [:INT*,INT:],INT,
      nthE being Function of [:E*,INT:],E,
      ISS,LISS being Subset of [:INT*,E*:],
      w being FinSequence of E
  st
    (for xs being FinSequence of INT, k being Integer holds
      (k < 0 & len xs = 0 implies nthZ.[xs,k] = 0) &
      (k < 0 & 0 < len xs implies nthZ.[xs,k] = xs.1) &
      (0 <= k & k < len xs implies nthZ.[xs,k] = xs.(k+1)) &
      (len xs <= k implies nthZ.[xs,k] = 0)) &
    (for xs being FinSequence of E, k being Integer holds
      (k < 0 & len xs = 0 implies nthE.[xs,k] = defaultE) &
      (k < 0 & 0 < len xs implies nthE.[xs,k] = xs.1) &
      (0 <= k & k < len xs implies nthE.[xs,k] = xs.(k+1)) &
      (len xs <= k implies nthE.[xs,k] = defaultE)) &
    (for x,y,z being Element of E st
      [x,y] in Lt & [y,z] in Lt
     holds [x,z] in Lt) &
    (for x,y being Element of E st [x,y] in Lt
     holds not [y,x] in Lt) &
    (for x,y being Element of E holds
      [x,y] in Lt or [y,x] in Lt or x = y) &
    (for s being FinSequence of INT,
         x being FinSequence of E holds
      ([s,x] in ISS iff
        (for k being Integer st 0 <= k & k < len s
         holds
          0 <= nthZ.[s,k] & nthZ.[s,k] < len x) &
        (for k,l being Integer st
          0 <= k & k < l & l < len s
         holds
          nthZ.[s,k] < nthZ.[s,l] &
          [nthE.[x,nthZ.[s,k]],
           nthE.[x,nthZ.[s,l]]] in Lt))) &
    (for s being FinSequence of INT,
         x being FinSequence of E holds
      ([s,x] in LISS iff
        [s,x] in ISS &
        (for s1 being FinSequence of INT st [s1,x] in ISS
         holds len s1 <= len s)))
  holds
    (for i being Integer st 0 <= i & i < len w holds
      for o1 being FinSequence of INT st o1 = <*i*> holds
        (len o1 = 1 & nthZ.[o1,0] = i implies
          for o2,o3 being Integer st
            o2 = len w - 1 & o3 = i + 1
          holds
            (o3 <= o2 + 1 implies
              (((1 = len o1 & 0 < len o1) &
                nthZ.[o1,0] = i &
                [o1,w] in ISS &
                (for s1 being FinSequence of INT st
                  [s1,w] in ISS & 2 <= len s1 &
                  nthZ.[s1,0] = i &
                  i < nthZ.[s1,1] &
                  nthZ.[s1,1] < o3
                 holds len s1 <= len o1)) &
               (for s being FinSequence of INT,
                    lenS being Integer holds
                 (for j being Integer st
                   (o3 <= j & j <= o2) &
                   (lenS = len s & 0 < len s) &
                   nthZ.[s,0] = i &
                   [s,w] in ISS &
                   (for s1 being FinSequence of INT st
                     [s1,w] in ISS & 2 <= len s1 &
                     nthZ.[s1,0] = i &
                     i < nthZ.[s1,1] &
                     nthZ.[s1,1] < j
                    holds len s1 <= len s)
                  holds
                    ([nthE.[w,i],nthE.[w,j]] in Lt implies
                      ((0 <= len w - i &
                        len w - j < len w - i) &
                       0 <= j & j < len w) &
                      (for sj being FinSequence of INT st
                        0 < len sj &
                        nthZ.[sj,0] = j &
                        [sj,w] in ISS &
                        (for s1 being FinSequence of INT st
                          [s1,w] in ISS & 1 <= len s1 &
                          nthZ.[s1,0] = j
                         holds len s1 <= len sj)
                       holds
                        ((lenS < 1 + len sj implies
                          for o4 being FinSequence of INT st
                            o4 = <*i*> ^ sj
                          holds
                            (len o4 = 1 + len sj &
                             nthZ.[o4,0] = i &
                             (for i1 being Integer st
                               0 < i1 & i1 <= len sj
                              holds
                               nthZ.[o4,i1] =
                                 nthZ.[sj,i1-1])
                             implies
                              (1 + len sj = len o4 &
                               0 < len o4) &
                              nthZ.[o4,0] = i &
                              [o4,w] in ISS &
                              (for s1 being FinSequence of INT st
                                [s1,w] in ISS & 2 <= len s1 &
                                nthZ.[s1,0] = i &
                                i < nthZ.[s1,1] &
                                nthZ.[s1,1] < j + 1
                               holds len s1 <= len o4))) &
                         (not lenS < 1 + len sj implies
                          (lenS = len s & 0 < len s) &
                          nthZ.[s,0] = i &
                          [s,w] in ISS &
                          (for s1 being FinSequence of INT st
                            [s1,w] in ISS & 2 <= len s1 &
                            nthZ.[s1,0] = i &
                            i < nthZ.[s1,1] &
                            nthZ.[s1,1] < j + 1
                           holds len s1 <= len s)))) &
                     (not [nthE.[w,i],nthE.[w,j]] in Lt
                      implies
                       (lenS = len s & 0 < len s) &
                       nthZ.[s,0] = i &
                       [s,w] in ISS &
                       (for s1 being FinSequence of INT st
                         [s1,w] in ISS & 2 <= len s1 &
                         nthZ.[s1,0] = i &
                         i < nthZ.[s1,1] &
                         nthZ.[s1,1] < j + 1
                        holds len s1 <= len s))) &
                 (((lenS = len s & 0 < len s) &
                   nthZ.[s,0] = i &
                   [s,w] in ISS &
                   (for s1 being FinSequence of INT st
                     [s1,w] in ISS & 2 <= len s1 &
                     nthZ.[s1,0] = i &
                     i < nthZ.[s1,1] &
                     nthZ.[s1,1] < o2 + 1
                    holds len s1 <= len s))
                  implies
                   (lenS = len s & 0 < len s) &
                   nthZ.[s,0] = i &
                   [s,w] in ISS &
                   (for s1 being FinSequence of INT st
                     [s1,w] in ISS & 1 <= len s1 &
                     nthZ.[s1,0] = i
                    holds len s1 <= len s)))) &
            (o2 + 1 < o3 implies
              (1 = len o1 & 0 < len o1) &
              nthZ.[o1,0] = i &
              [o1,w] in ISS &
              (for s1 being FinSequence of INT st
                [s1,w] in ISS & 1 <= len s1 &
                nthZ.[s1,0] = i
               holds len s1 <= len o1)))))) &
    (for o1 being Integer st o1 = len w - 1 holds
      (0 <= o1 + 1 implies
        (0 = len (<*>INT) &
         [<*>INT,w] in ISS &
         (for s1 being FinSequence of INT st
           [s1,w] in ISS & 1 <= len s1 &
           nthZ.[s1,0] < 0
          holds len s1 <= len (<*>INT))) &
        (for s being FinSequence of INT,
             lenS being Integer holds
          (for i being Integer st
            (0 <= i & i <= o1) &
            lenS = len s &
            [s,w] in ISS &
            (for s1 being FinSequence of INT st
              [s1,w] in ISS & 1 <= len s1 &
              nthZ.[s1,0] < i
             holds len s1 <= len s)
           holds
            (0 <= i & i < len w) &
            (for si being FinSequence of INT st
              0 < len si &
              nthZ.[si,0] = i &
              [si,w] in ISS &
              (for s1 being FinSequence of INT st
                [s1,w] in ISS & 1 <= len s1 &
                nthZ.[s1,0] = i
               holds len s1 <= len si)
             holds
              (lenS < len si implies
                [si,w] in ISS &
                (for s1 being FinSequence of INT st
                  [s1,w] in ISS & 1 <= len s1 &
                  nthZ.[s1,0] < i + 1
                 holds len s1 <= len si)) &
              (not lenS < len si implies
                lenS = len s &
                [s,w] in ISS &
                (for s1 being FinSequence of INT st
                  [s1,w] in ISS & 1 <= len s1 &
                  nthZ.[s1,0] < i + 1
                 holds len s1 <= len s)))) &
          ((lenS = len s &
            [s,w] in ISS &
            (for s1 being FinSequence of INT st
              [s1,w] in ISS & 1 <= len s1 &
              nthZ.[s1,0] < o1 + 1
             holds len s1 <= len s))
           implies
            lenS = len s & [s,w] in LISS))) &
      (o1 + 1 < 0 implies
        0 = len (<*>INT) & [<*>INT,w] in LISS))
proof
end;
::$P+
