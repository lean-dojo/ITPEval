:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_lexicographic_permutations_1_Top_to_seqqtvc: the
:: loop verification condition for copying an integer array into a finite
:: sequence by appending each entry while preserving length and every
:: zero-based indexed value. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nthZ being Function of [:INT*,INT:],INT st
    (for s being FinSequence of INT, k being Integer holds
       (len s = 0 implies nthZ.[s,k] = 0) &
       (0 < len s & k < 0 implies nthZ.[s,k] = s.1) &
       (0 <= k & k < (len s qua Integer) implies
          nthZ.[s,k] = s.(k+1)) &
       ((len s qua Integer) <= k implies nthZ.[s,k] = 0))
  holds
    for a being FinSequence of INT holds
      for o1 being Integer st
        o1 = (len a qua Integer) - 1
      holds
        (0 <= o1 + 1 implies
          ((len (<*>INT) qua Integer) = 0 &
           (for i being Integer st 0 <= i & i < 0
            holds nthZ.[<*>INT,i] = nthZ.[a,i])) &
          (for s being FinSequence of INT holds
            ((((0 <= (len s qua Integer) &
                (len s qua Integer) <= o1) &
               (for i being Integer st
                  0 <= i & i < (len s qua Integer)
                holds nthZ.[s,i] = nthZ.[a,i]))
              implies
                (0 <= (len s qua Integer) &
                 (len s qua Integer) < (len a qua Integer)) &
                (for o2 being Integer st
                   o2 = nthZ.[a,(len s qua Integer)]
                 holds
                   for o3 being FinSequence of INT st
                     o3 = s ^ <*o2*>
                   holds
                     ((len o3 qua Integer) =
                        1 + (len s qua Integer) &
                      nthZ.[o3,(len s qua Integer)] = o2 &
                      (for i being Integer st
                         0 <= i & i < (len s qua Integer)
                       holds nthZ.[o3,i] = nthZ.[s,i]))
                     implies
                       (len o3 qua Integer) =
                         (len s qua Integer) + 1 &
                       (for i being Integer st
                          0 <= i &
                          i < (len s qua Integer) + 1
                        holds nthZ.[o3,i] = nthZ.[a,i]))) &
             ((((len s qua Integer) = o1 + 1) &
               (for i being Integer st
                  0 <= i & i < o1 + 1
                holds nthZ.[s,i] = nthZ.[a,i]))
              implies
                len s = len a &
                (for i being Integer st
                   0 <= i & i < (len s qua Integer)
                 holds nthZ.[s,i] = nthZ.[a,i]))))) &
        (o1 + 1 < 0 implies
          for r being FinSequence of INT st r = <*>INT holds
            len r = len a &
            (for i being Integer st
               0 <= i & i < (len r qua Integer)
             holds nthZ.[r,i] = nthZ.[a,i]))
proof
end;
::$P+
