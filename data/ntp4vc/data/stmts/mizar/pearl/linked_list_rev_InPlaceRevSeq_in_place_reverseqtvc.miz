:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/linked_list_rev_InPlaceRevSeq_in_place_reverseqtvc: the in-place
:: linked-list reversal verification condition preserves disjoint list
:: segments and the reversed-sequence invariant through one loop step.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being non empty set,
      null,defaultLoc,l being Element of L,
      next1 being Function of L,L,
      lM being FinSequence of L,
      eqLoc being Function of [:L,L:],BOOLEAN,
      nthElem being Function of [:L*,INT:],L,
      revSeq being Function of L*,L*,
      dropOne being Function of L*,L*,
      Disjoint being Subset of [:L*,L*:],
      ListSeg being
        Subset of [:Funcs(L,L),[:L,[:L*,L:]:]:]
  st
    (for a,b being Element of L holds
       (eqLoc.[a,b] = TRUE iff a = b)) &
    (for s being FinSequence of L, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultLoc) &
       (len s > 0 & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultLoc)) &
    (for s being FinSequence of L holds
       len (revSeq.s) = len s &
       (for i being Integer st 0 <= i & i < len s
        holds
          nthElem.[revSeq.s,i] =
            nthElem.[s,len s-1-i])) &
    (for s being FinSequence of L holds
       (len s = 0 implies dropOne.s = <*>L) &
       (1 <= len s implies
          len (dropOne.s) = len s - 1 &
          (for i being Integer st
             0 <= i & i < len (dropOne.s)
           holds nthElem.[dropOne.s,i] = nthElem.[s,i+1]))) &
    (for s1,s2 being FinSequence of L holds
       ([s1,s2] in Disjoint iff
         for i1 being Integer st 0 <= i1 & i1 < len s1
         holds
           for i2 being Integer st 0 <= i2 & i2 < len s2
           holds nthElem.[s1,i1] <> nthElem.[s2,i2])) &
    (for f being Function of L,L,
         p,q being Element of L,
         s being FinSequence of L
     holds
       ([f,[p,[s,q]]] in ListSeg iff
         (for i being Integer st 0 <= i & i < len s
          holds nthElem.[s,i] <> null) &
         ((p = q & len s = 0) or
          (1 <= len s &
           nthElem.[s,0] = p &
           f.(nthElem.[s,len s-1]) = q &
           (for i being Integer st
              0 <= i & i < len s-1
            holds
              f.(nthElem.[s,i]) = nthElem.[s,i+1]))))) &
    [next1,[l,[lM,null]]] in ListSeg
  holds
    [next1,[l,[lM,null]]] in ListSeg &
    [next1,[null,[<*>L,null]]] in ListSeg &
    [lM,<*>L] in Disjoint &
    revSeq.lM ^ <*>L = revSeq.lM &
    (for rM,pM being FinSequence of L,
         r,p being Element of L,
         next2 being Function of L,L st
       [next2,[p,[pM,null]]] in ListSeg &
       [next2,[r,[rM,null]]] in ListSeg &
       [pM,rM] in Disjoint &
       revSeq.pM ^ rM = revSeq.lM
     holds
       (eqLoc.[p,null] = TRUE iff p = null) implies
         ((eqLoc.[p,null] <> TRUE implies
            p <> null &
            p <> null &
            (for o3 being Element of L st
               o3 = nthElem.[pM,0]
             holds
               for o4 being FinSequence of L st
                 o4 = <*o3*> ^ rM
               holds
                 (len o4 = 1 + len rM &
                  nthElem.[o4,0] = o3 &
                  (for i being Integer st
                     0 < i & i <= len rM
                   holds
                     nthElem.[o4,i] =
                       nthElem.[rM,i-1])
                  implies
                    (0 <= 1 & 1 <= len pM) &
                    (0 <= len pM &
                     len (dropOne.pM) < len pM) &
                    [next2+*(p,r),
                      [next2.p,[dropOne.pM,null]]]
                        in ListSeg &
                    [next2+*(p,r),[p,[o4,null]]]
                      in ListSeg &
                    [dropOne.pM,o4] in Disjoint &
                    revSeq.(dropOne.pM) ^ o4 =
                      revSeq.lM))) &
          (eqLoc.[p,null] = TRUE implies
            [next2,[r,[revSeq.lM,null]]] in ListSeg)))
proof
end;
::$P+
