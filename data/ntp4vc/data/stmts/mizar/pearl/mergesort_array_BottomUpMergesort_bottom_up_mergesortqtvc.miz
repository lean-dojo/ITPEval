:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_array_BottomUpMergesort_bottom_up_mergesortqtvc:
:: the bottom-up mergesort verification condition maintains sorted runs
:: and permutation invariants while merging adjacent list segments.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      nthElem being Function of [:E*,INT:],E,
      SortedSub being Subset of [:E*,[:INT,INT:]:],
      Sorted being Subset of E*,
      Perm being Relation of E*,E*,
      PermSub being Subset of [:E*,[:E*,[:INT,INT:]:]:],
      a being FinSequence of E
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (for s being FinSequence of E, l,u being Integer holds
       ([s,[l,u]] in SortedSub iff
         for i1,i2 being Integer st
           l <= i1 & i1 < i2 & i2 < u
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s being FinSequence of E holds
       (s in Sorted iff
         for i1,i2 being Integer st
           0 <= i1 & i1 < i2 & i2 < len s
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s,t being FinSequence of E holds
       ([s,t] in Perm iff
         len s = len t &
         (for x being Element of E holds
           card {q where q is Integer :
             0 <= q & q < len s & nthElem.[s,q] = x} =
           card {q where q is Integer :
             0 <= q & q < len t & nthElem.[t,q] = x}))) &
    (for s,t being FinSequence of E, l,u being Integer holds
       ([s,[t,[l,u]]] in PermSub iff
         len s = len t &
         0 <= max(l,0) & max(l,0) <= len s &
         0 <= max(u,0) & max(u,0) <= len s &
         (for x being Element of E holds
           card {q where q is Integer :
             max(l,0) <= q & q < max(u,0) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(l,0) <= q & q < max(u,0) &
             nthElem.[t,q] = x})))
  holds
    for n being Integer st n = len a holds
      for tmp being FinSequence of E st
        len tmp = len a &
        (for i being Integer st 0 <= i & i < len tmp
         holds nthElem.[tmp,i] = nthElem.[a,i])
      holds
        (1 <= 1 &
         [a,a] in Perm &
         (for k,l being Integer st l = k * 1 &
            0 <= l & l < n
          holds [a,[l,min(n,l+1)]] in SortedSub)) &
        (for segLen being Integer,
             tmp1,a1 being FinSequence of E st
           len tmp1 = len tmp &
           len a1 = len a &
           1 <= segLen &
           [a,a1] in Perm &
           (for k,l being Integer st l = k * segLen &
              0 <= l & l < n
            holds [a1,[l,min(n,l+segLen)]] in SortedSub)
         holds
           (segLen < n implies
             ((0 <= 0 & 0 = 2 * 0 * segLen) &
              [a1,a1] in Perm &
              (for k,l being Integer st l = k * segLen &
                 0 <= l & l < n
               holds
                 [a1,[l,min(n,l+segLen)]] in SortedSub) &
              (for k,l being Integer st l = k * (2*segLen) &
                 0 <= l & l < 0
               holds
                 [a1,[l,min(n,l+2*segLen)]] in SortedSub)) &
             (for i being Integer,
                  tmp2,a2 being FinSequence of E st
                len tmp2 = len tmp1 &
                len a2 = len a1 &
                0 <= 2*i*segLen &
                [a1,a2] in Perm &
                (for k,l being Integer st l = k * segLen &
                   2*i*segLen <= l & l < n
                 holds
                   [a2,[l,min(n,l+segLen)]] in SortedSub) &
                (for k,l being Integer st l = k * (2*segLen) &
                   0 <= l & l < 2*i*segLen
                 holds
                   [a2,[l,min(n,l+2*segLen)]] in SortedSub)
              holds
                ((2*i*segLen < n-segLen) implies
                  for mid,hi being Integer st
                    mid = 2*i*segLen + segLen &
                    hi = min(n,mid+segLen)
                  holds
                    ((0 <= 2*i*segLen &
                      2*i*segLen <= mid &
                      mid <= hi &
                      hi <= len tmp2 &
                      len tmp2 = len a2) &
                     [a2,[2*i*segLen,mid]] in SortedSub &
                     [a2,[mid,hi]] in SortedSub) &
                    (for a3 being FinSequence of E st
                       len a3 = len a2 &
                       [a3,[2*i*segLen,hi]] in SortedSub &
                       [a2,[a3,[2*i*segLen,hi]]] in PermSub &
                       (for i1 being Integer st
                          (0 <= i1 & i1 < 2*i*segLen) or
                          (hi <= i1 & i1 < len a3)
                        holds nthElem.[a3,i1] = nthElem.[a2,i1])
                     holds
                       (0 <= n+segLen-2*i*segLen &
                        n+segLen-(mid+segLen) <
                          n+segLen-2*i*segLen) &
                       (0 <= mid+segLen &
                        mid+segLen = 2*(i+1)*segLen) &
                       [a1,a3] in Perm &
                       (for k,l being Integer st
                          l = k * segLen &
                          mid+segLen <= l & l < n
                        holds
                          [a3,[l,min(n,l+segLen)]]
                            in SortedSub) &
                       (for k,l being Integer st
                          l = k * (2*segLen) &
                          0 <= l & l < mid+segLen
                        holds
                          [a3,[l,min(n,l+2*segLen)]]
                            in SortedSub))) &
                ((not 2*i*segLen < n-segLen) implies
                  (0 <= 2*n-segLen &
                   2*n-2*segLen < 2*n-segLen) &
                  1 <= 2*segLen &
                  [a,a2] in Perm &
                  (for k,l being Integer st
                     l = k * (2*segLen) &
                     0 <= l & l < n
                   holds
                     [a2,[l,min(n,l+2*segLen)]]
                       in SortedSub)))) &
           ((not segLen < n) implies
             a1 in Sorted & [a,a1] in Perm))
proof
end;
::$P+
