:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/patience_PatienceAbstract_play_gameqtvc: the abstract patience-
:: solitaire play-game verification condition constructs a longest strictly
:: increasing subsequence from the final stack state. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1, NUMBERS,
    XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1,
    INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4,
    FINSEQ_1, FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCT_7, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0, FINSEQ_1,
    FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0, ZFMISC_1,
    MCART_1, NAT_1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1, XXREAL_0,
    MEMBERED, VALUED_0, VALUED_1, XCMPLX_0, XREAL_0,
    ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Inv being Subset of
        [:INT,[:INT,[:Funcs(INT,INT),[:Funcs(INT,INT),
          [:Funcs([:INT,INT:],INT),[:Funcs(INT,INT),
            [:Funcs(INT,INT),Funcs(INT,INT):]:]:]:]:]:]:],
      Increasing being Subset of [:INT,Funcs(INT,INT):],
      nthZ being Function of [:INT*,INT:],INT,
      minusOne,zeroFun being Function of INT,INT,
      minusOne2 being Function of [:INT,INT:],INT,
      input being FinSequence of INT
  st
    (for xs being FinSequence of INT, k being Element of INT holds
      (k < 0 & len xs = 0 implies nthZ.[xs,k] = 0) &
      (k < 0 & 0 < len xs implies nthZ.[xs,k] = xs.1) &
      (0 <= k & k < len xs implies nthZ.[xs,k] = xs.(k+1)) &
      (len xs <= k implies nthZ.[xs,k] = 0)) &
    (for i being Element of INT holds
      minusOne.i = -1 & zeroFun.i = 0) &
    (for i,j being Element of INT holds minusOne2.[i,j] = -1) &
    (for ns,ne being Element of INT,
         vals,sizes being Function of INT,INT,
         sts being Function of [:INT,INT:],INT,
         pStack,pHeight,pr being Function of INT,INT
     holds
      ([ns,[ne,[vals,[sizes,[sts,[pStack,[pHeight,pr]]]]]]]
        in Inv iff
       (0 <= ns & ns <= ne) &
       (0 < ne implies 0 < ns) &
       (for i being Element of INT st 0 <= i & i < ns holds
          1 <= sizes.i &
          (for j being Element of INT st 0 <= j & j < sizes.i
           holds
             0 <= In(sts.([i,j]),INT) &
             In(sts.([i,j]),INT) < ne)) &
       (for i being Element of INT st 0 <= i & i < ne holds
          0 <= pStack.i & pStack.i < ns &
          0 <= pHeight.i & pHeight.i < sizes.(pStack.i) &
          In(sts.([pStack.i,pHeight.i]),INT) = i) &
       (for si being Element of INT st 0 <= si & si < ns holds
          for ip being Element of INT st 0 <= ip & ip < sizes.si
          holds
            pStack.(In(sts.([si,ip]),INT)) = si &
            pHeight.(In(sts.([si,ip]),INT)) = ip) &
       (for i being Element of INT st 0 <= i & i < ns holds
          for j,k being Element of INT st
            0 <= j & j < k & k < sizes.i
          holds
            In(sts.([i,j]),INT) < In(sts.([i,k]),INT)) &
       (for i being Element of INT st 0 <= i & i < ns holds
          for j,k being Element of INT st
            0 <= j & j <= k & k < sizes.i
          holds
            vals.(In(sts.([i,k]),INT)) <=
            vals.(In(sts.([i,j]),INT))) &
       (for i being Element of INT st 0 <= i & i < ne holds
          -1 <= pr.i & pr.i < ne & pr.i < i &
          (pr.i < 0 implies pStack.i = 0) &
          (not pr.i < 0 implies
            vals.(pr.i) < vals.i &
            0 < pStack.i &
            pStack.(pr.i) = pStack.i - 1)))) &
    (for sl being Element of INT,
         sv being Function of INT,INT
     holds
      ([sl,sv] in Increasing iff
       0 <= sl & sl <= len input &
       (for i being Element of INT st 0 <= i & i < sl holds
          0 <= sv.i & sv.i < len input) &
       (for i,j being Element of INT st
          0 <= i & i < j & j < sl
        holds sv.i < sv.j) &
       (for i,j being Element of INT st
          0 <= i & i < j & j < sl
        holds
          ex ii,jj being Element of INT st
            ii = sv.i & jj = sv.j &
            In(nthZ.[input,ii],INT) <
            In(nthZ.[input,jj],INT))))
  holds
    [0,[0,[minusOne,[zeroFun,
      [minusOne2,[minusOne,[minusOne,minusOne]]]]]]] in Inv &
    (for ns,ne being Element of INT,
        vals,sizes being Function of INT,INT,
        sts being Function of [:INT,INT:],INT,
        pStack,pHeight,pr being Function of INT,INT
    st
      [ns,[ne,[vals,[sizes,[sts,[pStack,[pHeight,pr]]]]]]] in Inv &
      ne = 0 + len input &
      (for i being Element of INT st 0 <= i & i < 0
       holds vals.i = minusOne.i) &
      (for i being Element of INT st 0 <= i & i < ne
       holds vals.i = nthZ.[input,i-0])
    holds
      (ns = 0 implies
        (ex sl being Element of INT,
            sv being Function of INT,INT st
          sl = ns & [sl,sv] in Increasing) &
        (for sl being Element of INT,
             sv being Function of INT,INT st
          [sl,sv] in Increasing
         holds sl <= ns)) &
      (ns <> 0 implies
        for o2,o4,lastHeight being Element of INT st
          o4 = ns-1 &
          lastHeight = sizes.o4-1 &
          o2 = In(sts.[o4,lastHeight],INT)
        holds
          (-1 <= o4 implies
            ((-1 <= o2 & o2 < ne) &
             (0 <= o4 implies
               0 <= o2 & pStack.o2 = o4) &
             (o4+1 < ns implies
               o2 < minusOne.(In(o4+1,INT))) &
             (0 <= o4 & o4 < ns-1 implies
               vals.o2 <
                 vals.(In(minusOne.(In(o4+1,INT)),INT))) &
             (for j being Element of INT st o4 < j & j < ns
              holds 0 <= minusOne.j & minusOne.j < ne) &
             (for j,k being Element of INT st
                o4 < j & j < k & k < ns
              holds minusOne.j < minusOne.k) &
             (for j,k being Element of INT st
                o4 < j & j < k & k < ns
              holds vals.(minusOne.j) < vals.(minusOne.k))) &
            (for seq1 being Function of INT,INT,
                 idx being Element of INT
             holds
              (for i being Element of INT st
                (i <= o4 & 0 <= i) &
                (-1 <= idx & idx < ne) &
                (0 <= i implies
                  0 <= idx & pStack.idx = i) &
                (i+1 < ns implies
                  idx < seq1.(In(i+1,INT))) &
                (0 <= i & i < ns-1 implies
                  vals.idx <
                    vals.(In(seq1.(In(i+1,INT)),INT))) &
                (for j being Element of INT st i < j & j < ns
                 holds 0 <= seq1.j & seq1.j < ne) &
                (for j,k being Element of INT st
                   i < j & j < k & k < ns
                 holds seq1.j < seq1.k) &
                (for j,k being Element of INT st
                   i < j & j < k & k < ns
                 holds vals.(seq1.j) < vals.(seq1.k))
               holds
                (-1 <= pr.idx & pr.idx < ne) &
                (0 <= i-1 implies
                  0 <= pr.idx & pStack.(pr.idx) = i-1) &
                (i-1+1 < ns implies
                  pr.idx <
                    (seq1+*(i,idx)).(In(i-1+1,INT))) &
                (0 <= i-1 & i-1 < ns-1 implies
                  vals.(pr.idx) <
                    vals.(In(
                      (seq1+*(i,idx)).(In(i-1+1,INT)),INT))) &
                (for j being Element of INT st
                   i-1 < j & j < ns
                 holds
                   0 <= (seq1+*(i,idx)).j &
                   (seq1+*(i,idx)).j < ne) &
                (for j,k being Element of INT st
                   i-1 < j & j < k & k < ns
                 holds
                   (seq1+*(i,idx)).j <
                   (seq1+*(i,idx)).k) &
                (for j,k being Element of INT st
                   i-1 < j & j < k & k < ns
                 holds
                   vals.((seq1+*(i,idx)).j) <
                   vals.((seq1+*(i,idx)).k))) &
              ((-1 <= idx & idx < ne) &
               (0 <= 0-1 implies
                 0 <= idx & pStack.idx = 0-1) &
               (0-1+1 < ns implies
                 idx < seq1.(In(0-1+1,INT))) &
               (0 <= 0-1 & 0-1 < ns-1 implies
                 vals.idx <
                   vals.(In(seq1.(In(0-1+1,INT)),INT))) &
               (for j being Element of INT st 0-1 < j & j < ns
                holds 0 <= seq1.j & seq1.j < ne) &
               (for j,k being Element of INT st
                  0-1 < j & j < k & k < ns
                holds seq1.j < seq1.k) &
               (for j,k being Element of INT st
                  0-1 < j & j < k & k < ns
                holds vals.(seq1.j) < vals.(seq1.k))
               implies
                (ex sl being Element of INT,
                    sv being Function of INT,INT st
                  sl = ns & [sl,sv] in Increasing) &
                (for sl being Element of INT,
                     sv being Function of INT,INT st
                  [sl,sv] in Increasing
                 holds sl <= ns)))) &
          (o4 < -1 implies
            (ex sl being Element of INT,
                sv being Function of INT,INT st
              sl = ns & [sl,sv] in Increasing) &
            (for sl being Element of INT,
                 sv being Function of INT,INT st
              [sl,sv] in Increasing
             holds sl <= ns))))
proof
end;
::$P+
