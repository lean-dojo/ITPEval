:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/imp/imp_ConcreteInterpreter_interp_exprqtvc: the concrete
:: interpreter verification condition for literals, variables, subtraction,
:: and propagation of unbound-variable expression behavior.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ProgramVar,Expr,Opt,Behaviour,Env being non empty set,
      elit being Function of INT,Expr,
      evar being Function of ProgramVar,Expr,
      esub being Function of [:Expr,Expr:],Expr,
      none being Element of Opt,
      some being Function of INT,Opt,
      enormal being Function of INT,Behaviour,
      eunbound being Element of Behaviour,
      get being Function of [:Env,ProgramVar:],Opt,
      evalExpr being Subset of [:Env,[:Expr,Behaviour:]:],
      e being Element of Expr,
      env1 being Element of Env
  st
    (for x,y being Integer st elit.x = elit.y holds x = y) &
    (for x,y being Element of ProgramVar st evar.x = evar.y
     holds x = y) &
    (for e1,e2,f1,f2 being Element of Expr st
       esub.[e1,e2] = esub.[f1,f2]
     holds e1 = f1 & e2 = f2) &
    (for n being Integer, x being Element of ProgramVar
     holds elit.n <> evar.x) &
    (for n being Integer, e1,e2 being Element of Expr
     holds elit.n <> esub.[e1,e2]) &
    (for x being Element of ProgramVar, e1,e2 being Element of Expr
     holds evar.x <> esub.[e1,e2]) &
    (for e0 being Element of Expr holds
       (ex n being Integer st e0 = elit.n) or
       (ex x being Element of ProgramVar st e0 = evar.x) or
       ex e1,e2 being Element of Expr st e0 = esub.[e1,e2]) &
    (for X being Subset of Expr st
       (for n being Integer holds elit.n in X) &
       (for x being Element of ProgramVar holds evar.x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds esub.[e1,e2] in X)
     holds X = Expr) &
    (for x,y being Integer st some.x = some.y holds x = y) &
    (for x being Integer holds some.x <> none) &
    (for o being Element of Opt holds
       o = none or ex x being Integer st o = some.x) &
    (for x,y being Integer st enormal.x = enormal.y holds x = y) &
    (for x being Integer holds enormal.x <> eunbound) &
    (for b being Element of Behaviour holds
       b = eunbound or ex x being Integer st b = enormal.x) &
    (for rho being Element of Env, n being Integer holds
       [rho,[elit.n,enormal.n]] in evalExpr) &
    (for rho being Element of Env, x being Element of ProgramVar,
         n being Integer st get.[rho,x] = some.n
     holds [rho,[evar.x,enormal.n]] in evalExpr) &
    (for rho being Element of Env, x being Element of ProgramVar st
       get.[rho,x] = none
     holds [rho,[evar.x,eunbound]] in evalExpr) &
    (for rho being Element of Env, e1,e2 being Element of Expr,
         n1,n2 being Integer st
       [rho,[e1,enormal.n1]] in evalExpr &
       [rho,[e2,enormal.n2]] in evalExpr
     holds [rho,[esub.[e1,e2],enormal.(n1-n2)]] in evalExpr) &
    (for rho being Element of Env, e1,e2 being Element of Expr st
       [rho,[e1,eunbound]] in evalExpr
     holds [rho,[esub.[e1,e2],eunbound]] in evalExpr) &
    (for rho being Element of Env, e1,e2 being Element of Expr,
         n1 being Integer st
       [rho,[e1,enormal.n1]] in evalExpr &
       [rho,[e2,eunbound]] in evalExpr
     holds [rho,[esub.[e1,e2],eunbound]] in evalExpr) &
    (for R being Subset of [:Env,[:Expr,Behaviour:]:] st
       (for rho being Element of Env, n being Integer holds
          [rho,[elit.n,enormal.n]] in R) &
       (for rho being Element of Env, x being Element of ProgramVar,
            n being Integer st get.[rho,x] = some.n
        holds [rho,[evar.x,enormal.n]] in R) &
       (for rho being Element of Env, x being Element of ProgramVar st
          get.[rho,x] = none
        holds [rho,[evar.x,eunbound]] in R) &
       (for rho being Element of Env, e1,e2 being Element of Expr,
            n1,n2 being Integer st
          [rho,[e1,enormal.n1]] in R &
          [rho,[e2,enormal.n2]] in R
        holds [rho,[esub.[e1,e2],enormal.(n1-n2)]] in R) &
       (for rho being Element of Env, e1,e2 being Element of Expr st
          [rho,[e1,eunbound]] in R
        holds [rho,[esub.[e1,e2],eunbound]] in R) &
       (for rho being Element of Env, e1,e2 being Element of Expr,
            n1 being Integer st
          [rho,[e1,enormal.n1]] in R &
          [rho,[e2,eunbound]] in R
        holds [rho,[esub.[e1,e2],eunbound]] in R)
     holds evalExpr c= R)
  holds
    (for n being Integer st e = elit.n holds
       [env1,[e,enormal.n]] in evalExpr) &
    (for x being Element of ProgramVar st e = evar.x holds
       (for result being Integer st
          (ex v being Integer st
             get.[env1,x] = some.v & result = v)
        holds [env1,[e,enormal.result]] in evalExpr) &
       (get.[env1,x] = none implies
          [env1,[e,eunbound]] in evalExpr)) &
    (for e1,e2 being Element of Expr st e = esub.[e1,e2] holds
       (for f,f1 being Element of Expr st e = esub.[f,f1]
        holds f = e2 or f1 = e2) &
       (for o1 being Integer st
          [env1,[e2,enormal.o1]] in evalExpr
        holds
          (for f,f1 being Element of Expr st e = esub.[f,f1]
           holds f = e1 or f1 = e1) &
          (for o2 being Integer st
             [env1,[e1,enormal.o2]] in evalExpr
           holds [env1,[e,enormal.(o2-o1)]] in evalExpr) &
          ([env1,[e1,eunbound]] in evalExpr implies
             [env1,[e,eunbound]] in evalExpr)) &
       ([env1,[e2,eunbound]] in evalExpr implies
          [env1,[e,eunbound]] in evalExpr))
proof
end;
::$P+
