:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/imp/imp_SymbolicInterpreter_symbolic_interp_while_listqtvc:
:: the symbolic while-loop interpreter verification condition combining
:: counter bounds with sound, complete, state-extending results for the head
:: and tail of a list of symbolic states. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1, FINSEQ_1, FINSEQ_2, FINSET_1, FUNCOP_1, STRUCT_0, CARD_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      FINSEQ_1, FINSEQ_2, FINSET_1, STRUCT_0, CARD_3, FUNCOP_1;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2,
      FINSET_1, FUNCOP_1, STRUCT_0, CARD_3;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1,
      FUNCOP_1, STRUCT_0, CARD_3;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ProgramVar,SVar,Sigma,SymExpr,Constr,State,StateList,Expr,Cmd,
      ExprBehavior,Behavior,OptSVar,OptInt,Config being non empty set,
      p1 being Element of [:OptSVar,OptInt:],
      q1,q2,q3,p8,q4,q5,q6,q7,q8,q9,p9,q10,p10,q11,q12,q13,q14,q15
        being Function-yielding Function,
      p2 being Element of [:ExprBehavior,Cmd:],
      evalExpr being Subset of
        [:Funcs(ProgramVar,OptInt),[:Expr,ExprBehavior:]:],
      p3 being Element of [:Config,Sigma:],
      execCmd being Subset of
        [:Config,
          [:Funcs(ProgramVar,OptInt),
            [:Cmd,[:Funcs(ProgramVar,OptInt),Behavior:]:]:]:],
      execWhile being Subset of
        [:Config,
          [:INT,
            [:Funcs(ProgramVar,OptInt),
              [:Expr,
                [:Cmd,[:Funcs(ProgramVar,OptInt),Behavior:]:]:]:]:]:],
      execClosed being Subset of
        [:bool
            [:Config,
              [:Funcs(ProgramVar,OptInt),
                [:Cmd,[:Funcs(ProgramVar,OptInt),Behavior:]:]:]:],
          bool
            [:Config,
              [:INT,
                [:Funcs(ProgramVar,OptInt),
                  [:Expr,
                    [:Cmd,
                      [:Funcs(ProgramVar,OptInt),Behavior:]:]:]:]:]:]:],
      p4 being Element of [:Constr,Constr:],
      isSolution being Subset of [:Funcs(SVar,INT),Constr:],
      stateExtends being Subset of [:State,State:],
      p5 being Element of [:StateList,Behavior:],
      listMem being Subset of [:State,StateList:],
      p6 being Element of [:Behavior,Behavior:],
      ctr,loopLimit being Integer,
      states being Element of StateList,
      intSub being Subset of [:INT,[:INT,INT:]:],
      natSucc,natLt being Subset of [:NAT,NAT:],
      e being Element of Expr,
      c being Element of Cmd
  st
    (for a,b,r being Integer
     holds [r,[a,b]] in intSub iff r = a-b) &
    (for a,b being Nat
     holds [a,b] in natSucc iff a = b+1) &
    (for a,b being Nat
     holds [a,b] in natLt iff a < b) &
    dom q1 = {1,2} &
    dom (q1.1) = SVar & rng (q1.1) c= OptSVar &
    dom (q1.2) = INT & rng (q1.2) c= OptInt &
    dom q2 = {1,2} &
    dom (q2.1) = INT & rng (q2.1) c= Expr &
    dom (q2.2) = ProgramVar & rng (q2.2) c= Expr &
    dom q3 = {1,2} &
    dom (q3.1) = [:Expr,Expr:] & rng (q3.1) c= Expr &
    dom (q3.2) = INT & rng (q3.2) c= ExprBehavior &
    dom p8 = {1,2} &
    dom (p8.1) = Expr & rng (p8.1) c= NAT &
    dom (p8.2) = Cmd & rng (p8.2) c= NAT &
    dom q4 = {1,2} &
    dom (q4.1) =
      [:Funcs(ProgramVar,OptInt),[:ProgramVar,OptInt:]:] &
    rng (q4.1) c= Funcs(ProgramVar,OptInt) &
    dom (q4.2) = [:ProgramVar,Expr:] & rng (q4.2) c= Cmd &
    dom q5 = {1,2} &
    dom (q5.1) = [:Cmd,Cmd:] & rng (q5.1) c= Cmd &
    dom (q5.2) = [:Expr,[:Cmd,Cmd:]:] & rng (q5.2) c= Cmd &
    dom q6 = {1,2} &
    dom (q6.1) = [:Expr,Cmd:] & rng (q6.1) c= Cmd &
    dom (q6.2) = Config & rng (q6.2) c= OptInt &
    dom q7 = {1,2} &
    dom (q7.1) = INT & rng (q7.1) c= Config &
    dom (q7.2) = [:Sigma,[:ProgramVar,SVar:]:] &
      rng (q7.2) c= Sigma &
    dom q8 = {1,2} &
    dom (q8.1) = [:Sigma,ProgramVar:] & rng (q8.1) c= OptSVar &
    dom (q8.2) = INT & rng (q8.2) c= SymExpr &
    dom q9 = {1,2} &
    dom (q9.1) = SVar & rng (q9.1) c= SymExpr &
    dom (q9.2) = [:SymExpr,SymExpr:] & rng (q9.2) c= SymExpr &
    dom p9 = {1,2} &
    dom (p9.1) = SymExpr & rng (p9.1) c= NAT &
    dom (p9.2) = Constr & rng (p9.2) c= NAT &
    dom q10 = {1,2} &
    dom (q10.1) = [:Funcs(SVar,INT),SymExpr:] &
      rng (q10.1) c= INT &
    dom (q10.2) = [:SymExpr,SymExpr:] & rng (q10.2) c= Constr &
    dom p10 = {1,2} &
    dom (p10.1) = SymExpr & rng (p10.1) c= bool SVar &
    dom (p10.2) = Constr & rng (p10.2) c= bool SVar &
    dom q11 = {1,2} &
    dom (q11.1) = [:SymExpr,SymExpr:] & rng (q11.1) c= Constr &
    dom (q11.2) = [:Constr,Constr:] & rng (q11.2) c= Constr &
    dom q12 = {1,2} &
    dom (q12.1) = [:SVar,Constr:] & rng (q12.1) c= Constr &
    dom (q12.2) = State & rng (q12.2) c= Sigma &
    dom q13 = {1,2} &
    dom (q13.1) = State & rng (q13.1) c= Constr &
    dom (q13.2) = State & rng (q13.2) c= Funcs(SVar,INT) &
    dom q14 = {1,2} &
    dom (q14.1) = State & rng (q14.1) c= bool SVar &
    dom (q14.2) = [:Funcs(SVar,INT),Sigma:] &
      rng (q14.2) c= Funcs(ProgramVar,OptInt) &
    dom q15 = {1,2} &
    dom (q15.1) = [:State,StateList:] & rng (q15.1) c= StateList &
    dom (q15.2) = StateList & rng (q15.2) c= NAT &
    (for v1,v2 being Element of SVar st (q1.1).v1 = (q1.1).v2
     holds v1 = v2) &
    (for v being Element of SVar holds (q1.1).v <> (p1`1)) &
    (for o being Element of OptSVar holds
       o = (p1`1) or ex v being Element of SVar st o = (q1.1).v) &
    (for z1,z2 being Integer st (q1.2).z1 
= 
(q1.2).z2
     holds z1 = z2) &
    (for z being Integer holds (q1.2).z 
<> 
(p1`2)) &
    (for o being Element of OptInt holds
       o = (p1`2) or ex z being Integer st o = (q1.2).z) &
    (for z1,z2 being Integer st (q2.1).z1 = 
(q2.1).z2 holds z1 = z2) &
    (for x1,x2 being Element of ProgramVar st (q2.2).x1 = (q2.2).x2
     holds x1 = x2) &
    (for e1,e2,e3,e4 being Element of Expr st
       (q3.1).[e1,e2] = (q3.1).[e3,e4]
     holds e1 = e3 & e2 = e4) &
    (for z being Integer holds (p8.1).((q2.1).z) = 0) 
&
    (for x being Element of ProgramVar
     holds (p8.1).((q2.2).x) = 1) &
    (for e1,e2 being Element of Expr
     holds (p8.1).((q3.1).[e1,e2]) = 2) &
    (for e being Element of Expr holds
       (ex z being Integer st e = (q2.1).z) 
or
       (ex x being Element of ProgramVar st e = (q2.2).x) or
       ex e1,e2 being Element of Expr st e = (q3.1).[e1,e2]) &
    (for X being Subset of Expr st
       (for z being Integer holds (q2.1).z 
in X) &
       (for x being Element of ProgramVar holds (q2.2).x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds (q3.1).[e1,e2] in X)
     holds X = Expr) &
    (for z1,z2 being Integer st (q3.2).z1 
= (q3.2).z2
     holds z1 = z2) &
    (for z being Integer holds (q3.2).z 
<> (p2`1)) &
    (for eb being Element of ExprBehavior holds
       eb = (p2`1) or ex z being Integer st eb = (q3.2).z) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         x,y being Element of ProgramVar,
         o being Element of OptInt
     holds
       (y = x implies [y,o] in (q4.1).[env,[x,o]]) &
       (y <> x implies [y,env.y] in (q4.1).[env,[x,o]])) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         z being Integer
     holds [env,[(q2.1).z,(q3.2).z]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         x being Element of ProgramVar,
         z being Integer st env.x = (q1.2).z
     holds [env,[(q2.2).x,(q3.2).z]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         x being Element of ProgramVar st env.x = (p1`2)
     holds [env,[(q2.2).x,(p2`1)]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         e1,e2 being Element of Expr,
         z1,z2 being Integer st
       [env,[e1,(q3.2).z1]] in evalExpr &
       [env,[e2,(q3.2).z2]] in evalExpr
     holds
       [env,[(q3.1).[e1,e2],(q3.2).(z1-z2)]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         e1,e2 being Element of Expr st
       [env,[e1,(p2`1)]] in evalExpr
     holds [env,[(q3.1).[e1,e2],(p2`1)]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         e1,e2 being Element of Expr,
         z1 being Integer st
       [env,[e1,(q3.2).z1]] in evalExpr &
       [env,[e2,(p2`1)]] in evalExpr
     holds [env,[(q3.1).[e1,e2],(p2`1)]] in evalExpr) &
    (for R being Subset of
         [:Funcs(ProgramVar,OptInt),[:Expr,ExprBehavior:]:] st
       (for env being Element of Funcs(ProgramVar,OptInt),
            z being Integer
        holds [env,[(q2.1).z,(q3.2).z]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            x being Element of ProgramVar,
            z being Integer st env.x = (q1.2).z
        holds [env,[(q2.2).x,(q3.2).z]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            x being Element of ProgramVar st env.x = (p1`2)
        holds [env,[(q2.2).x,(p2`1)]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            e1,e2 being Element of Expr,
            z1,z2 being Integer st
          [env,[e1,(q3.2).z1]] in R &
          [env,[e2,(q3.2).z2]] in R
        holds [env,[(q3.1).[e1,e2],(q3.2).(z1-z2)]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            e1,e2 being Element of Expr st
          [env,[e1,(p2`1)]] in R
        holds [env,[(q3.1).[e1,e2],(p2`1)]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            e1,e2 being Element of Expr,
            z1 being Integer st
          [env,[e1,(q3.2).z1]] in R &
          [env,[e2,(p2`1)]] in R
        holds [env,[(q3.1).[e1,e2],(p2`1)]] in R)
     holds evalExpr c= R) &
    (for x1,x2 being Element of ProgramVar,
         e1,e2 being Element of Expr st
       (q4.2).[x1,e1] = 
(q4.2).[x2,e2]
     holds x1 = x2 & e1 = e2) &
    (for c1,c2,c3,c4 being Element of Cmd st
       (q5.1).[c1,c2] = (q5.1).[c3,c4]
     holds c1 = c3 & c2 = c4) &
    (for e1,e2 being Element of Expr,
         c1,c2,c3,c4 being Element of Cmd st
       (q5.2).[e1,[c1,c2]] 
= 
(q5.2).[e2,[c3,c4]]
     holds e1 = e2 & c1 = c3 & c2 = c4) &
    (for e1,e2 being Element of Expr,
         c1,c2 being Element of Cmd st
       (q6.1).[e1,c1] = (q6.1).[e2,c2]
     holds e1 = e2 & c1 = c2) &
    (p8.2).((p2`2)) = 0 &
    (for x being Element of ProgramVar,
         e being Element of Expr
     holds (p8.2).((q4.2).[x,e]) = 1) &
    (for c1,c2 being Element of Cmd
     holds (p8.2).((q5.1).[c1,c2]) = 2) &
    (for e being Element of Expr,
         c1,c2 being Element of Cmd
     holds (p8.2).((q5.2).[e,[c1,c2]]) = 3) &
    (for e being Element of Expr,
         c1 being Element of Cmd
     holds (p8.2).((q6.1).[e,c1]) = 4) &
    (for c1 being Element of Cmd holds
       c1 = (p2`2) or
       (ex x being Element of ProgramVar,
           e being Element of Expr st c1 = (q4.2).[x,e]) or
       (ex c2,c3 being Element of Cmd st c1 = (q5.1).[c2,c3]) or
       (ex e being Element of Expr,
           c2,c3 being Element of Cmd st c1 = (q5.2).[e,[c2,c3]]) or
       ex e being Element of Expr,
          c2 being Element of Cmd st c1 = (q6.1).[e,c2]) &
    (for X being Subset of Cmd st
       (p2`2) in X &
       (for x being Element of ProgramVar,
            e being Element of Expr
        holds (q4.2).[x,e] 
in X) &
       (for c1,c2 being Element of Cmd st c1 in X & c2 in X
        holds (q5.1).[c1,c2] in X) &
       (for e being Element of Expr,
            c1,c2 being Element of Cmd st c1 in X & c2 in X
        holds (q5.2).[e,[c1,c2]] 
in X) &
       (for e being Element of Expr,
            c1 being Element of Cmd st c1 in X
        holds (q6.1).[e,c1] in X)
     holds X = Cmd) &
    (p5`2) <> (p6`1) & (p5`2) <> (p6`2) & (p6`1) <> (p6`2) &
    (for b being Element of Behavior holds
       b = (p5`2) or b = (p6`1) or b = (p6`2)) &
    (for cnf being Element of Config holds
       (q6.2).cnf = (p1`2) or
       ex lim being Integer st
         0 <= lim & (q6.2).cnf = (q1.2).lim) &
    (q6.2).((p3`1)) = (p1`2) &
    (for lim being Integer st 0 <= lim
     holds (q6.2).((q7.1).lim) = (q1.2).lim) &
    (for cnf1,cnf2 being Element of Config st
       (q6.2).cnf1 = (q6.2).cnf2
     holds cnf1 = cnf2) &
    (for rCmd being Subset of
           [:Config,
             [:Funcs(ProgramVar,OptInt),
               [:Cmd,[:Funcs(ProgramVar,OptInt),Behavior:]:]:]:],
         rWhile being Subset of
           [:Config,
             [:INT,
               [:Funcs(ProgramVar,OptInt),
                 [:Expr,
                   [:Cmd,
                     [:Funcs(ProgramVar,OptInt),Behavior:]:]:]:]:]:]
     holds
       [rCmd,rWhile] in execClosed iff
       (for cnf being Element of Config,
            env being Element of Funcs(ProgramVar,OptInt)
        holds [cnf,[env,[(p2`2),[env,(p5`2)]]]] in rCmd) &
       (for cnf being Element of Config,
            env being Element of Funcs(ProgramVar,OptInt),
            x being Element of ProgramVar,
            e being Element of Expr,
            z being Integer st [env,[e,(q3.2).z]] in evalExpr
        holds
          [cnf,
            [env,
              [(q4.2).[x,e],
                [(q4.1).[env,[x,(q1.2).z]],(p5`2)]]]] in 
rCmd) &
       (for cnf being Element of Config,
            env being Element of Funcs(ProgramVar,OptInt),
            x being Element of ProgramVar,
            e being Element of Expr st
          [env,[e,(p2`1)]] in evalExpr
        holds
          [cnf,[env,[(q4.2).[x,e],[env,(p6`1)]]]] in rCmd) &
       (for cnf being Element of Config,
            env1,env2,env3 being Element of
              Funcs(ProgramVar,OptInt),
            c1,c2 being Element of Cmd,
            bhv being Element of Behavior st
          [cnf,[env1,[c1,[env2,(p5`2)]]]] in rCmd &
          [cnf,[env2,[c2,[env3,bhv]]]] in rCmd
        holds
          [cnf,[env1,[(q5.1).[c1,c2],[env3,bhv]]]] in rCmd) &
       (for cnf being Element of Config,
            env1,env2 being Element of Funcs(ProgramVar,OptInt),
            c1,c2 being Element of Cmd,
            bhv being Element of Behavior st
          bhv <> (p5`2) &
          [cnf,[env1,[c1,[env2,bhv]]]] in rCmd
        holds
          [cnf,[env1,[(q5.1).[c1,c2],[env2,bhv]]]] in rCmd) &
       (for cnf being Element of Config,
            env1,env2 being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1,c2 being Element of Cmd,
            bhv being Element of Behavior st
          [env1,[e,(q3.2).0]] in 
evalExpr 
&
          [cnf,[env1,[c2,[env2,bhv]]]] in rCmd
        holds
          [cnf,[env1,[(q5.2).[e,[c1,c2]],[env2,bhv]]]] in rCmd) &
       (for cnf being Element of Config,
            env1,env2 being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1,c2 being Element of Cmd,
            z being Integer,
            bhv being Element of Behavior st
          z <> 0 &
          [env1,[e,(q3.2).z]] in 
evalExpr 
&
          [cnf,[env1,[c1,[env2,bhv]]]] in rCmd
        holds
          [cnf,[env1,[(q5.2).[e,[c1,c2]],[env2,bhv]]]] in rCmd) &
       (for cnf being Element of Config,
            env being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1,c2 being Element of Cmd st
          [env,[e,(p2`1)]] in evalExpr
        holds
          [cnf,[env,[(q5.2).[e,[c1,c2]],[env,(p6`1)]]]] in rCmd) 
&
       (for cnf being Element of Config,
            env1,env2 being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1 being Element of Cmd,
            bhv being Element of Behavior st
          [cnf,[0,[env1,[e,[c1,[env2,bhv]]]]]] in rWhile
        holds
          [cnf,[env1,[(q6.1).[e,c1],[env2,bhv]]]] in rCmd) &
       (for cnf being Element of Config,
            ctr,lim being Integer,
            env being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1 being Element of Cmd st
          (q6.2).cnf = (q1.2).lim & lim <= ctr
        holds
          [cnf,[ctr,[env,[e,[c1,[env,(p6`2)]]]]]] in rWhile) &
       (for cnf being Element of Config,
            ctr being Integer,
            env being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1 being Element of Cmd st
          ((q6.2).cnf = (p1`2) or
           ex lim being Integer st
             (q6.2).cnf = (q1.2).lim & ctr < lim) &
          [env,[e,(q3.2).0]] in 
evalExpr
        holds
          [cnf,[ctr,[env,[e,[c1,[env,(p5`2)]]]]]] in rWhile) &
       (for cnf being Element of Config,
            ctr being Integer,
            env being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1 being Element of Cmd st
          ((q6.2).cnf = (p1`2) or
           ex lim being Integer st
             (q6.2).cnf = (q1.2).lim & ctr < lim) &
          [env,[e,(p2`1)]] in evalExpr
        holds
          [cnf,[ctr,[env,[e,[c1,[env,(p6`1)]]]]]] in rWhile) &
       (for cnf being Element of Config,
            ctr,z being Integer,
            env1,env2 being Element of Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1 being Element of Cmd,
            bhv being Element of Behavior st
          ((q6.2).cnf = (p1`2) or
           ex lim being Integer st
             (q6.2).cnf = (q1.2).lim & ctr < lim) &
          z <> 0 &
          [env1,[e,(q3.2).z]] in 
evalExpr 
&
          bhv <> (p5`2) &
          [cnf,[env1,[c1,[env2,bhv]]]] in rCmd
        holds
          [cnf,[ctr,[env1,[e,[c1,[env2,bhv]]]]]] in rWhile) &
       (for cnf being Element of Config,
            ctr,z being Integer,
            env1,env2,env3 being Element of
              Funcs(ProgramVar,OptInt),
            e being Element of Expr,
            c1 being Element of Cmd,
            bhv being Element of Behavior st
          ((q6.2).cnf = (p1`2) or
           ex lim being Integer st
             (q6.2).cnf = (q1.2).lim & ctr < lim) &
          z <> 0 &
          [env1,[e,(q3.2).z]] in 
evalExpr 
&
          [cnf,[env1,[c1,[env2,(p5`2)]]]] in rCmd &
          [cnf,[ctr+1,[env2,[e,[c1,[env3,bhv]]]]]] in rWhile
        holds
          [cnf,[ctr,[env1,[e,[c1,[env3,bhv]]]]]] in rWhile)) &
    [execCmd,execWhile] in execClosed &
    (for rCmd being Subset of
           [:Config,
             [:Funcs(ProgramVar,OptInt),
               [:Cmd,[:Funcs(ProgramVar,OptInt),Behavior:]:]:]:],
         rWhile being Subset of
           [:Config,
             [:INT,
               [:Funcs(ProgramVar,OptInt),
                 [:Expr,
                   [:Cmd,
                     [:Funcs(ProgramVar,OptInt),Behavior:]:]:]:]:]:] st
       [rCmd,rWhile] in execClosed
     holds execCmd c= rCmd & execWhile c= rWhile) &
    (for x being Element of ProgramVar
     holds (q8.1).[(p3`2),x] 
= (p1`1)) &
    (for sigma being Element of Sigma,
         x being Element of ProgramVar,
         v being Element of SVar
     holds (q8.1).[(q7.2).[sigma,[x,v]],x] = (q1.1).v) &
    (for sigma being Element of Sigma,
         x,y being Element of ProgramVar,
         v being Element of SVar st y <> x
     holds
       (q8.1).[(q7.2).[sigma,[x,v]],y] = (q8.1).[sigma,y]) &
    (for z1,z2 being Integer st (q8.2).z1 = 
(q8.2).z2 holds z1 = z2) &
    (for v1,v2 being Element of SVar st (q9.1).v1 = (q9.1).v2
     holds v1 = v2) &
    (for e1,e2,e3,e4 being Element of SymExpr st
       (q9.2).[e1,e2] = 
(q9.2).[e3,e4]
     holds e1 = e3 & e2 = e4) &
    (for z being Integer
     holds (p9.1).((q8.2).z) = 0) &
    (for v being Element of SVar
     holds (p9.1).((q9.1).v) = 1) &
    (for e1,e2 being Element of SymExpr
     holds (p9.1).((q9.2).[e1,e2]) = 2) &
    (for e being Element of SymExpr holds
       (ex z being Integer st e = (q8.2).z) or
       (ex v being Element of SVar st e = (q9.1).v) or
       ex e1,e2 being Element of SymExpr st e = (q9.2).[e1,e2]) &
    (for X being Subset of SymExpr st
       (for z being Integer holds (q8.2).z in 
X) &
       (for v being Element of SVar holds (q9.1).v in X) &
       (for e1,e2 being Element of SymExpr st e1 in X & e2 in X
        holds (q9.2).[e1,e2] 
in X)
     holds X = SymExpr) &
    (for rho being Element of Funcs(SVar,INT),
         z being Integer
     holds (q10.1).[rho,(q8.2).z] = z) &
    (for rho being Element of Funcs(SVar,INT),
         v being Element of SVar
     holds (q10.1).[rho,(q9.1).v] = rho.v) &
    (for rho being Element of Funcs(SVar,INT),
         e1,e2 being Element of SymExpr
     holds
       [(q10.1).[rho,(q9.2).[e1,e2]],
         [(q10.1).[rho,e1],(q10.1).[rho,e2]]] in intSub) &
    (for z being Integer
     holds
       (p10.1).((q8.2).z) = {}) &
    (for v being Element of SVar
     holds
       (p10.1).((q9.1).v) = {v}) &
    (for e1,e2 being Element of SymExpr
     holds
       (p10.1).((q9.2).[e1,e2]) =
         (p10.1).e1 \/
         (p10.1).e2) &
    (for e being Element of SymExpr
     holds
       (p10.1).e is finite) &
    (p4`1) <> (p4`2) &
    (for e1,e2,e3,e4 being Element of SymExpr st
       (q10.2).[e1,e2] = 
(q10.2).[e3,e4]
     holds e1 = e3 & e2 = e4) &
    (for e1,e2,e3,e4 being Element of SymExpr st
       (q11.1).[e1,e2] = 
(q11.1).[e3,e4]
     holds e1 = e3 & e2 = e4) &
    (for d1,d2,d3,d4 being Element of Constr st
       (q11.2).[d1,d2] = 
(q11.2).[d3,d4]
     holds d1 = d3 & d2 = d4) &
    (for v1,v2 being Element of SVar,
         d1,d2 being Element of Constr st
       (q12.1).[v1,d1] = 
(q12.1).[v2,d2]
     holds v1 = v2 & d1 = d2) &
    (p9.2).((p4`1)) = 0 &
    (p9.2).((p4`2)) = 1 &
    (for e1,e2 being Element of SymExpr
     holds (p9.2).((q10.2).[e1,e2]) = 2) &
    (for e1,e2 being Element of SymExpr
     holds (p9.2).((q11.1).[e1,e2]) = 3) &
    (for d1,d2 being Element of Constr
     holds (p9.2).((q11.2).[d1,d2]) = 4) &
    (for v being Element of SVar,
         d being Element of Constr
     holds (p9.2).((q12.1).[v,d]) = 5) &
    (for d being Element of Constr holds
       d = (p4`1) or d = (p4`2) or
       (ex e1,e2 being Element of SymExpr st d = (q10.2).[e1,e2]) or
       (ex e1,e2 being Element of SymExpr st d = (q11.1).[e1,e2]) 
or
       (ex d1,d2 being Element of Constr st d = (q11.2).[d1,d2]) 
or
       ex v being Element of SVar,
          d1 being Element of Constr st d = (q12.1).[v,d1]) &
    (for X being Subset of Constr st
       (p4`1) in X & (p4`2) in X &
       (for e1,e2 being Element of SymExpr
        holds (q10.2).[e1,e2] 
in X & (q11.1).[e1,e2] in 
X) &
       (for d1,d2 being Element of Constr st d1 in X & d2 in X
        holds (q11.2).[d1,d2] in 
X) &
       (for v being Element of SVar,
            d being Element of Constr st d in X
        holds (q12.1).[v,d] 
in X)
     holds X = Constr) &
    (for rho being Element of Funcs(SVar,INT)
     holds [rho,(p4`1)] in isSolution &
       not [rho,(p4`2)] in isSolution) &
    (for rho being Element of Funcs(SVar,INT),
         e1,e2 being Element of SymExpr
     holds
       ([rho,(q10.2).[e1,e2]] 
in isSolution iff
         (q10.1).[rho,e1] 
= (q10.1).[rho,e2]) &
       ([rho,(q11.1).[e1,e2]] 
in isSolution iff
         (q10.1).[rho,e1] 
<> (q10.1).[rho,e2])) &
    (for rho being Element of Funcs(SVar,INT),
         d1,d2 being Element of Constr
     holds
       [rho,(q11.2).[d1,d2]] in 
isSolution iff
       [rho,d1] in isSolution & [rho,d2] in isSolution) &
    (for rho being Element of Funcs(SVar,INT),
         v being Element of SVar,
         d being Element of Constr
     holds
       [rho,(q12.1).[v,d]] in 
isSolution iff
       [rho,d] in isSolution) &
    (p10.2).((p4`1)) = {} &
    (p10.2).((p4`2)) = {} &
    (for e1,e2 being Element of SymExpr
     holds
       (p10.2).((q10.2).[e1,e2]) =
         (p10.1).e1 \/
         (p10.1).e2 &
       (p10.2).((q11.1).[e1,e2]) =
         (p10.1).e1 \/
         (p10.1).e2) &
    (for d1,d2 being Element of Constr
     holds
       (p10.2).((q11.2).[d1,d2]) =
         (p10.2).d1 \/
         (p10.2).d2) &
    (for v being Element of SVar,
         d being Element of Constr
     holds
       (p10.2).((q12.1).[v,d]) =
         (p10.2).d \/ {v}) &
    (for d being Element of Constr
     holds
       (p10.2).d is finite) &
    (for s being Element of State holds
       (p10.2).((q13.1).s) c= (q14.1).s &
       (q14.1).s is finite &
       (for x being Element of ProgramVar,
            v being Element of SVar st
          (q8.1).[(q12.2).s,x] = (q1.1).v
        holds v in (q14.1).s)) &
    (for s1,s2 being Element of State st
       (q12.2).s1 = (q12.2).s2 &
       (q13.1).s1 = (q13.1).s2 &
       (q13.2).s1 = (q13.2).s2 &
       (q14.1).s1 = (q14.1).s2
     holds s1 = s2) &
    (for sigma being Element of Sigma,
         d being Element of Constr,
         rho being Element of Funcs(SVar,INT),
         vs being Subset of SVar st
       (p10.2).d c= vs & vs is 
finite &
       (for x being Element of ProgramVar,
            v being Element of SVar st
          (q8.1).[sigma,x] = 
(q1.1).v
        holds v in vs)
     holds
       ex s being Element of State st
         (q12.2).s = sigma & (q13.1).s = d &
         (q13.2).s = rho & 
(q14.1).s = vs) &
    (for s1,s2 being Element of State,
         l1,l2 being Element of StateList st
       (q15.1).[s1,l1] 
= 
(q15.1).[s2,l2]
     holds s1 = s2 & l1 = l2) &
    (for s being Element of State,
         l being Element of StateList
     holds (q15.1).[s,l] <> 
(p5`1)) &
    (for l being Element of StateList holds
       l = (p5`1) or
       ex s being Element of State,
          l1 being Element of StateList st l = (q15.1).[s,l1]) &
    (q15.2).((p5`1)) = 0 &
    (for s being Element of State,
         l being Element of StateList
     holds [(q15.2).((q15.1).[s,l]),(q15.2).l] in natSucc) &
    (for s being Element of State holds
       not [s,(p5`1)] in listMem) &
    (for s,s1 being Element of State,
         l being Element of StateList
     holds
       [s,(q15.1).[s1,l]] in 
listMem iff
       s = s1 or [s,l] in listMem) &
    (for s1,s2 being Element of State holds
       [s1,s2] in stateExtends iff
       (q14.1).s1 c= (q14.1).s2 &
       (for v being Element of SVar st v in (q14.1).s1
