                (bhv = (p6`2) & s1 in limits1)) &
               [(q13.2).s1,(q13.1).s1] in isSolution
             holds
               [(q13.2).s,(q13.1).s] in isSolution &
               [(q7.1).loopLimit,
                 [ctr,
                   [(q14.2).[(q13.2).s,(q12.2).s],
                     [e,
                       [c,
                         [(q14.2).[(q13.2).s1,(q12.2).s1],
                           bhv]]]]]] in execWhile))
           implies
             ((ex n being Nat st (q15.2).states = n & 0 <= n) &
              [(q15.2).restseq,(q15.2).states] in natLt) &
             0 <= ctr & ctr <= loopLimit))) &
    (for normals,unbounds,limits being finite Subset of State
     holds
       (((states = (p5`1) implies
            (limits = {} & card limits = 0) &
            (unbounds = {} & card unbounds = 0) &
