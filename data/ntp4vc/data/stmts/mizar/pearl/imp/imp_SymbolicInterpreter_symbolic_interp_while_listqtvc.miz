                  [(q13.2).s1,(q13.1).s1] in 
isSolution &
                  gamma = (q14.2).[(q13.2).s1,(q12.2).s1])) &
             (for bhv being Element of Behavior,
                  s1 being Element of State st
                ((bhv = (p5`2) & s1 in normals) or
                 (bhv = (p6`1) & s1 in unbounds) or
                 (bhv = (p6`2) & s1 in limits)) &
                [(q13.2).s1,(q13.1).s1] in isSolution
              holds
                ex s2 being Element of State st
                  [s2,states] in listMem &
                  [(q13.2).s2,(q13.1).s2] in 
isSolution &
                  [(q7.1).loopLimit,
                    [ctr,
                      [(q14.2).[(q13.2).s2,(q12.2).s2],
                        [e,
                          [c,
                            [(q14.2).[(q13.2).s1,(q12.2).s1],
                               bhv]]]]]] in execWhile))))))
proof
end;
