       (for v being Element of SVar st
          (q8.1).[sigma,x] = (q1.1).v
        holds [x,(q1.2).(rho.v)] in (q14.2).[rho,sigma])) &
    0 <= ctr & ctr <= loopLimit
  holds
    (for s being Element of State,
         restseq being Element of StateList st
       states = (q15.1).[s,restseq]
     holds
       ((ex n being Nat st (q15.2).states = n & 0 <= n) &
        [0,(q15.2).states] in natLt &
        0 <= ctr & ctr <= loopLimit) &
       (for normals1,unbounds1,limits1 being finite Subset of State
        holds
          (((for s1 being Element of State st
               s1 in normals1 or s1 in unbounds1 or s1 in limits1
             holds [s,s1] in stateExtends) &
            ([(q13.2).s,(q13.1).s] in isSolution implies
              (for gamma being Element of Funcs(ProgramVar,OptInt),
                   bhv being Element of Behavior st
                 [(q7.1).loopLimit,
                   [ctr,
                     [(q14.2).[(q13.2).s,(q12.2).s],
                       [e,[c,[gamma,bhv]]]]]] in execWhile
               holds
                 ex s1 being Element of State st
                   ((bhv = (p5`2) & s1 in normals1) or
                    (bhv = (p6`1) & s1 in unbounds1) or
