                                  bhv]]]]]] in execWhile) &
                limits = limits1 \/ limits2 &
                unbounds = unbounds1 \/ unbounds2 &
                normals = normals1 \/ normals2))
        implies
          (for s1 being Element of State st
             s1 in normals or s1 in unbounds or s1 in limits
           holds
             ex s being Element of State st
               [s,states] in listMem & [s,s1] in stateExtends) &
          (for s being Element of State st
             [s,states] in listMem &
             [(q13.2).s,(q13.1).s] in isSolution
           holds
             (for gamma being Element of Funcs(ProgramVar,OptInt),
                  bhv being Element of Behavior st
                [(q7.1).loopLimit,
                  [ctr,
                    [(q14.2).[(q13.2).s,(q12.2).s],
                      [e,[c,[gamma,bhv]]]]]] in execWhile
