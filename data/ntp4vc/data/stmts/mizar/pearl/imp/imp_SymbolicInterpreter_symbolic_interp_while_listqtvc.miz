                  [(q13.2).s1,(q13.1).s1] in 
isSolution
                holds
                  [(q13.2).s,(q13.1).s] in 
isSolution &
                  [(q7.1).loopLimit,
                    [ctr,
                      [(q14.2).[(q13.2).s,(q12.2).s],
                        [e,
                          [c,
                               [(q14.2).[(q13.2).s1,(q12.2).s1],
