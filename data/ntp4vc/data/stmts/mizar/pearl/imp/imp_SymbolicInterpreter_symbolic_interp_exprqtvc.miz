:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/imp/imp_SymbolicInterpreter_symbolic_interp_exprqtvc: the symbolic
:: expression interpreter verification condition for literals, variables,
:: subtraction, variable coverage, and unbound-variable propagation.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1, FINSET_1, FUNCOP_1, CARD_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      FINSET_1, CARD_3, FUNCOP_1;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, FINSET_1, FUNCOP_1,
      CARD_3;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1, FINSET_1, FUNCOP_1, CARD_3;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ProgramVar,SVar,Sigma,SymExpr,Constr,State,Expr,ExprBehavior,
      OptSVar,OptInt being non empty set,
      noneS being Element of OptSVar,
      someS being Function of SVar,OptSVar,
      noneI being Element of OptInt,
      someI being Function of INT,OptInt,
      elit being Function of INT,Expr,
      evar being Function of ProgramVar,Expr,
      esub being Function of [:Expr,Expr:],Expr,
      exprTag being Function of Expr,NAT,
      enormal being Function of INT,ExprBehavior,
      eunbound being Element of ExprBehavior,
      get being Function of [:Sigma,ProgramVar:],OptSVar,
      emptySigma being Element of Sigma,
      setSigma being Function of
        [:Sigma,[:ProgramVar,SVar:]:],Sigma,
      evalExpr being Subset of
        [:Funcs(ProgramVar,OptInt),[:Expr,ExprBehavior:]:],
      slit being Function of INT,SymExpr,
      svar being Function of SVar,SymExpr,
      ssub being Function of [:SymExpr,SymExpr:],SymExpr,
      symTag being Function of SymExpr,NAT,
      interp being Function of
        [:Funcs(SVar,INT),SymExpr:],INT,
      varsSym being Function of SymExpr,bool SVar,
      ctrue,cfalse being Element of Constr,
      ceq,cneq being Function of [:SymExpr,SymExpr:],Constr,
      cconj being Function of [:Constr,Constr:],Constr,
      cexists being Function of [:SVar,Constr:],Constr,
      constrTag being Function of Constr,NAT,
      varsConstr being Function of Constr,bool SVar,
      sigmaProj being Function of State,Sigma,
      constrProj being Function of State,Constr,
      rhoProj being Function of State,Funcs(SVar,INT),
      varsProj being Function of State,bool SVar,
      compose being Function of
        [:Funcs(SVar,INT),Sigma:],Funcs(ProgramVar,OptInt),
      intSub being Subset of [:INT,[:INT,INT:]:],
      e being Element of Expr,
      s being Element of State
  st
    (for a,b,r being Integer
     holds [r,[a,b]] in intSub iff r = a-b) &
    (for v1,v2 being Element of SVar st someS.v1 = someS.v2
     holds v1 = v2) &
    (for v being Element of SVar holds someS.v <> noneS) &
    (for o being Element of OptSVar holds
       o = noneS or ex v being Element of SVar st o = someS.v) &
    (for z1,z2 being Integer st someI.z1 = someI.z2
     holds z1 = z2) &
    (for z being Integer holds someI.z <> noneI) &
    (for o being Element of OptInt holds
       o = noneI or ex z being Integer st o = someI.z) &
    (for z1,z2 being Integer st elit.z1 = elit.z2
     holds z1 = z2) &
    (for x1,x2 being Element of ProgramVar st evar.x1 = evar.x2
     holds x1 = x2) &
    (for e1,e2,f1,f2 being Element of Expr st
       esub.[e1,e2] = esub.[f1,f2]
     holds e1 = f1 & e2 = f2) &
    (for z being Integer holds exprTag.(elit.z) = 0) &
    (for x being Element of ProgramVar holds exprTag.(evar.x) = 1) &
    (for e1,e2 being Element of Expr
     holds exprTag.(esub.[e1,e2]) = 2) &
    (for e0 being Element of Expr holds
       (ex z being Integer st e0 = elit.z) or
       (ex x being Element of ProgramVar st e0 = evar.x) or
       ex e1,e2 being Element of Expr st e0 = esub.[e1,e2]) &
    (for X being Subset of Expr st
       (for z being Integer holds elit.z in X) &
       (for x being Element of ProgramVar holds evar.x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds esub.[e1,e2] in X)
     holds X = Expr) &
    (for z1,z2 being Integer st enormal.z1 = enormal.z2
     holds z1 = z2) &
    (for z being Integer holds enormal.z <> eunbound) &
    (for b being Element of ExprBehavior holds
       b = eunbound or ex z being Integer st b = enormal.z) &
    (for x being Element of ProgramVar
     holds get.[emptySigma,x] = noneS) &
    (for sigma being Element of Sigma,
         x being Element of ProgramVar,
         v being Element of SVar
     holds get.[setSigma.[sigma,[x,v]],x] = someS.v) &
    (for sigma being Element of Sigma,
         x,y being Element of ProgramVar,
         v being Element of SVar st y <> x
     holds get.[setSigma.[sigma,[x,v]],y] = get.[sigma,y]) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         z being Integer
     holds [env,[elit.z,enormal.z]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         x being Element of ProgramVar,
         z being Integer st env.x = someI.z
     holds [env,[evar.x,enormal.z]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         x being Element of ProgramVar st env.x = noneI
     holds [env,[evar.x,eunbound]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         e1,e2 being Element of Expr,
         z1,z2 being Integer st
       [env,[e1,enormal.z1]] in evalExpr &
       [env,[e2,enormal.z2]] in evalExpr
     holds [env,[esub.[e1,e2],enormal.(z1-z2)]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         e1,e2 being Element of Expr st
       [env,[e1,eunbound]] in evalExpr
     holds [env,[esub.[e1,e2],eunbound]] in evalExpr) &
    (for env being Element of Funcs(ProgramVar,OptInt),
         e1,e2 being Element of Expr,
         z1 being Integer st
       [env,[e1,enormal.z1]] in evalExpr &
       [env,[e2,eunbound]] in evalExpr
     holds [env,[esub.[e1,e2],eunbound]] in evalExpr) &
    (for R being Subset of
         [:Funcs(ProgramVar,OptInt),[:Expr,ExprBehavior:]:] st
       (for env being Element of Funcs(ProgramVar,OptInt),
            z being Integer
        holds [env,[elit.z,enormal.z]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            x being Element of ProgramVar,
            z being Integer st env.x = someI.z
        holds [env,[evar.x,enormal.z]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            x being Element of ProgramVar st env.x = noneI
        holds [env,[evar.x,eunbound]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            e1,e2 being Element of Expr,
            z1,z2 being Integer st
          [env,[e1,enormal.z1]] in R &
          [env,[e2,enormal.z2]] in R
        holds [env,[esub.[e1,e2],enormal.(z1-z2)]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            e1,e2 being Element of Expr st
          [env,[e1,eunbound]] in R
        holds [env,[esub.[e1,e2],eunbound]] in R) &
       (for env being Element of Funcs(ProgramVar,OptInt),
            e1,e2 being Element of Expr,
            z1 being Integer st
          [env,[e1,enormal.z1]] in R &
          [env,[e2,eunbound]] in R
        holds [env,[esub.[e1,e2],eunbound]] in R)
     holds evalExpr c= R) &
    (for z1,z2 being Integer st slit.z1 = slit.z2
     holds z1 = z2) &
    (for v1,v2 being Element of SVar st svar.v1 = svar.v2
     holds v1 = v2) &
    (for a1,a2,b1,b2 being Element of SymExpr st
       ssub.[a1,a2] = ssub.[b1,b2]
     holds a1 = b1 & a2 = b2) &
    (for z being Integer holds symTag.(slit.z) = 0) &
    (for v being Element of SVar holds symTag.(svar.v) = 1) &
    (for a1,a2 being Element of SymExpr
     holds symTag.(ssub.[a1,a2]) = 2) &
    (for a being Element of SymExpr holds
       (ex z being Integer st a = slit.z) or
       (ex v being Element of SVar st a = svar.v) or
       ex a1,a2 being Element of SymExpr st a = ssub.[a1,a2]) &
    (for X being Subset of SymExpr st
       (for z being Integer holds slit.z in X) &
       (for v being Element of SVar holds svar.v in X) &
       (for a1,a2 being Element of SymExpr st a1 in X & a2 in X
        holds ssub.[a1,a2] in X)
     holds X = SymExpr) &
    (for rho being Element of Funcs(SVar,INT),
         z being Integer
     holds interp.[rho,slit.z] = z) &
    (for rho being Element of Funcs(SVar,INT),
         v being Element of SVar
     holds interp.[rho,svar.v] = rho.v) &
    (for rho being Element of Funcs(SVar,INT),
         a1,a2 being Element of SymExpr
     holds
       [interp.[rho,ssub.[a1,a2]],
         [interp.[rho,a1],interp.[rho,a2]]] in intSub) &
    (for z being Integer holds varsSym.(slit.z) = {}) &
    (for v being Element of SVar holds varsSym.(svar.v) = {v}) &
    (for a1,a2 being Element of SymExpr
     holds varsSym.(ssub.[a1,a2]) =
       varsSym.a1 \/ varsSym.a2) &
    (for a being Element of SymExpr holds varsSym.a is finite) &
    (for a1,a2,b1,b2 being Element of SymExpr st
       ceq.[a1,a2] = ceq.[b1,b2]
     holds a1 = b1 & a2 = b2) &
    (for a1,a2,b1,b2 being Element of SymExpr st
       cneq.[a1,a2] = cneq.[b1,b2]
     holds a1 = b1 & a2 = b2) &
    (for d1,d2,f1,f2 being Element of Constr st
       cconj.[d1,d2] = cconj.[f1,f2]
     holds d1 = f1 & d2 = f2) &
    (for v1,v2 being Element of SVar,
         d1,d2 being Element of Constr st
       cexists.[v1,d1] = cexists.[v2,d2]
     holds v1 = v2 & d1 = d2) &
    constrTag.ctrue = 0 &
    constrTag.cfalse = 1 &
    (for a1,a2 being Element of SymExpr
     holds constrTag.(ceq.[a1,a2]) = 2) &
    (for a1,a2 being Element of SymExpr
     holds constrTag.(cneq.[a1,a2]) = 3) &
    (for d1,d2 being Element of Constr
     holds constrTag.(cconj.[d1,d2]) = 4) &
    (for v being Element of SVar,
         d being Element of Constr
     holds constrTag.(cexists.[v,d]) = 5) &
    (for d being Element of Constr holds
       d = ctrue or d = cfalse or
       (ex a1,a2 being Element of SymExpr st d = ceq.[a1,a2]) or
       (ex a1,a2 being Element of SymExpr st d = cneq.[a1,a2]) or
       (ex d1,d2 being Element of Constr st d = cconj.[d1,d2]) or
       ex v being Element of SVar,
          d1 being Element of Constr st d = cexists.[v,d1]) &
    (for X being Subset of Constr st
       ctrue in X & cfalse in X &
       (for a1,a2 being Element of SymExpr
        holds ceq.[a1,a2] in X & cneq.[a1,a2] in X) &
       (for d1,d2 being Element of Constr st d1 in X & d2 in X
        holds cconj.[d1,d2] in X) &
       (for v being Element of SVar,
            d being Element of Constr st d in X
        holds cexists.[v,d] in X)
     holds X = Constr) &
    varsConstr.ctrue = {} &
    varsConstr.cfalse = {} &
    (for a1,a2 being Element of SymExpr
     holds varsConstr.(ceq.[a1,a2]) =
       varsSym.a1 \/ varsSym.a2) &
    (for a1,a2 being Element of SymExpr
     holds varsConstr.(cneq.[a1,a2]) =
       varsSym.a1 \/ varsSym.a2) &
    (for d1,d2 being Element of Constr
     holds varsConstr.(cconj.[d1,d2]) =
       varsConstr.d1 \/ varsConstr.d2) &
    (for v being Element of SVar,
         d being Element of Constr
     holds varsConstr.(cexists.[v,d]) =
       {v} \/ varsConstr.d) &
    (for d being Element of Constr holds varsConstr.d is finite) &
    (for st0 being Element of State holds
       varsConstr.(constrProj.st0) c= varsProj.st0 &
       varsProj.st0 is finite &
       (for x being Element of ProgramVar,
            v being Element of SVar st
          get.[sigmaProj.st0,x] = someS.v
        holds v in varsProj.st0)) &
    (for s1,s2 being Element of State st
       sigmaProj.s1 = sigmaProj.s2 &
       constrProj.s1 = constrProj.s2 &
       rhoProj.s1 = rhoProj.s2 &
       varsProj.s1 = varsProj.s2
     holds s1 = s2) &
    (for sigma being Element of Sigma,
         d being Element of Constr,
         rho being Element of Funcs(SVar,INT),
         vs being Subset of SVar st
       varsConstr.d c= vs & vs is finite &
       (for x being Element of ProgramVar,
            v being Element of SVar st
          get.[sigma,x] = someS.v
        holds v in vs)
     holds
       ex st0 being Element of State st
         sigmaProj.st0 = sigma &
         constrProj.st0 = d &
         rhoProj.st0 = rho &
         varsProj.st0 = vs) &
    (for rho being Element of Funcs(SVar,INT),
         sigma being Element of Sigma,
         x being Element of ProgramVar
     holds
       (get.[sigma,x] = noneS implies
          [x,noneI] in compose.[rho,sigma]) &
       (for v being Element of SVar st
          get.[sigma,x] = someS.v
        holds [x,someI.(rho.v)] in compose.[rho,sigma]))
  holds
    (for n being Integer st e = elit.n holds
       [compose.[rhoProj.s,sigmaProj.s],
         [e,enormal.(interp.[rhoProj.s,slit.n])]] in evalExpr &
       (for v being Element of SVar st v in varsSym.(slit.n)
        holds
          ex x being Element of ProgramVar st
            get.[sigmaProj.s,x] = someS.v)) &
    (for x being Element of ProgramVar st e = evar.x holds
       (for o1 being Element of SVar st
          get.[sigmaProj.s,x] = someS.o1
        holds
          [compose.[rhoProj.s,sigmaProj.s],
            [e,enormal.(interp.[rhoProj.s,svar.o1])]] in evalExpr &
          (for v being Element of SVar st v in varsSym.(svar.o1)
           holds
             ex x1 being Element of ProgramVar st
               get.[sigmaProj.s,x1] = someS.v)) &
       (get.[sigmaProj.s,x] = noneS implies
          [compose.[rhoProj.s,sigmaProj.s],
            [e,eunbound]] in evalExpr)) &
    (for e1,e2 being Element of Expr st e = esub.[e1,e2] holds
       (for f,f1 being Element of Expr st e = esub.[f,f1]
        holds f = e2 or f1 = e2) &
       (for o1 being Element of SymExpr st
          [compose.[rhoProj.s,sigmaProj.s],
            [e2,enormal.(interp.[rhoProj.s,o1])]] in evalExpr &
          (for v being Element of SVar st v in varsSym.o1
           holds
             ex x being Element of ProgramVar st
               get.[sigmaProj.s,x] = someS.v)
        holds
          (for f,f1 being Element of Expr st e = esub.[f,f1]
           holds f = e1 or f1 = e1) &
          (for o2 being Element of SymExpr st
             [compose.[rhoProj.s,sigmaProj.s],
               [e1,enormal.(interp.[rhoProj.s,o2])]] in evalExpr &
             (for v being Element of SVar st v in varsSym.o2
              holds
                ex x being Element of ProgramVar st
                  get.[sigmaProj.s,x] = someS.v)
           holds
             [compose.[rhoProj.s,sigmaProj.s],
               [e,enormal.(interp.[rhoProj.s,ssub.[o2,o1]])]]
                 in evalExpr &
             (for v being Element of SVar st
                v in varsSym.(ssub.[o2,o1])
              holds
                ex x being Element of ProgramVar st
                  get.[sigmaProj.s,x] = someS.v)) &
          ([compose.[rhoProj.s,sigmaProj.s],
             [e1,eunbound]] in evalExpr implies
            [compose.[rhoProj.s,sigmaProj.s],
              [e,eunbound]] in evalExpr)) &
       ([compose.[rhoProj.s,sigmaProj.s],
          [e2,eunbound]] in evalExpr implies
         [compose.[rhoProj.s,sigmaProj.s],
           [e,eunbound]] in evalExpr))
proof
end;
::$P+
