:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/register_allocation_DWP_wrapqtvc: correctness of wrapping a
:: double-weakest-precondition code transformer with a state-indexed
:: postcondition for the register-allocation machine. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS,
    INT_1, CARD_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4,
    ARYTM_0, ARYTM_1, ARYTM_2, ARYTM_3, REAL_1, NAT_1, ZFMISC_1,
    MCART_1, MARGREL1, XBOOLEAN, XCMPLX_0, XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, PARTFUN1, FUNCT_1, FUNCT_2, FUNCT_4, FUNCOP_1,
    FUNCT_7, FINSEQ_1,
    FINSEQ_2, ORDINAL1, CARD_1, ARYTM_2, ARYTM_1, NUMBERS, ARYTM_0,
    XCMPLX_0, XREAL_0, REAL_1, NAT_1, XXREAL_0, INT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, PARTFUN1, FUNCT_1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1,
    FINSEQ_1, FINSEQ_2, ZFMISC_1, XTUPLE_0, MCART_1, ARYTM_1,
    ARYTM_0, CARD_1, XCMPLX_0, XXREAL_0, REAL_1, NAT_1, XREAL_0, NUMBERS,
    INT_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, PARTFUN1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, FINSEQ_1, FINSEQ_2, ORDINAL1,
    NUMBERS, CARD_1, XTUPLE_0, VALUED_0, VALUED_1, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, MEMBERED, INT_1, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for A,I,S being non empty set,
      exec being Function of [:I,S:],S,
      execList being
        Function of [:I*,S:],S,
      trans being
        Function of
          Funcs(S,BOOLEAN),
          Funcs(S,BOOLEAN),
      code being FinSequence of I,
      pst being
        Function of S,Funcs(S,BOOLEAN)
  st
    I =
      [:{0},A,INT:] \/
      [:{1},INT:] \/
      [:{2},INT,INT:] \/
      [:{3},INT:] \/
      [:{4},INT:] &
    S = [:Funcs(A,INT),Funcs(INT,INT),INT*:] &
    (for x being Element of A,
         r being Integer,
         mem being Function of A,INT,
         reg being Function of INT,INT,
         stack being FinSequence of INT
     holds
       exec.[[0,x,r],[mem,reg,stack]] =
         [mem,reg+*(r,mem.x),stack]) &
    (for r,v being Integer,
         mem being Function of A,INT,
         reg being Function of INT,INT,
         stack being FinSequence of INT
     st v = reg.r
     holds
       exec.[[1,r],[mem,reg,stack]] =
         [mem,reg+*(r,-v),stack]) &
    (for r1,r2,v1,v2 being Integer,
         mem being Function of A,INT,
         reg being Function of INT,INT,
         stack being FinSequence of INT
     st v1 = reg.r1 & v2 = reg.r2
     holds
       exec.[[2,r1,r2],[mem,reg,stack]] =
         [mem,reg+*(r2,v1 + v2),stack]) &
    (for r being Integer,
         mem being Function of A,INT,
         reg being Function of INT,INT,
         stack being FinSequence of INT
     holds
       exec.[[3,r],[mem,reg,stack]] =
         [mem,reg,<*(reg.r)*> ^ stack]) &
    (for r being Integer,
         mem being Function of A,INT,
         reg being Function of INT,INT
     holds
       exec.[[4,r],[mem,reg,{}]] = [mem,reg,{}]) &
    (for r,v being Integer,
         mem being Function of A,INT,
         reg being Function of INT,INT,
         stack being FinSequence of INT
     holds
       exec.[[4,r],[mem,reg,<*v*> ^ stack]] =
         [mem,reg+*(r,v),stack]) &
    (for s being Element of S
     holds execList.[{},s] = s) &
    (for i being Element of I,
         c being FinSequence of I,
         s being Element of S
     holds
       execList.[<*i*> ^ c,s] = execList.[c,exec.[i,s]]) &
    (for q being Function of S,BOOLEAN,
         s being Element of S
     st (trans.q).s = TRUE
     holds q.(execList.[code,s]) = TRUE) &
    (for x being Element of S
     holds (trans.(pst.x)).x = TRUE)
  holds
    for s being Element of S
    holds (pst.s).(execList.[code,s]) = TRUE
proof
end;
::$P+
