:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/hillel_challenge_FulcrumNoOverflow_fulcrumqtvc: the fulcrum
:: verification condition tracks signed 32-bit array psum and ssum sums
:: with a two-word big-integer representation and rules out intermediate
:: overflow. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, MCART_1, COMPLEX1,
    ABSVALUE, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, COMPLEX1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, COMPLEX1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    ABSVALUE, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,B,I being non empty set,
      BV32 being non empty Subset of INT,
      a being Element of A,
      alen being Function of A,INT,
      ival being Function of I,INT,
      inext,iprev being Function of I,I,
      izero,ilen being Element of I,
      elts,psum,ssum being Function of I,INT,
      q,r being Function of B,INT,
      v being Function of B,INT,
      zero being Element of B st
    (for z being Integer holds
      (z in BV32 iff -(2 |^ 31) <= z & z <= 2147483647)) &
    (for x,y being Element of I st ival.x = ival.y holds x = y) &
    (for z being Integer holds
      ex x being Element of I st ival.x = z) &
    ival.izero = 0 & ival.ilen = alen.a &
    (for x being Element of I holds
      ival.(inext.x) = ival.x + 1 &
      ival.(iprev.x) = ival.x - 1) &
    (for x being Element of A holds alen.x in BV32) &
    (for i being Element of I holds
      (elts.i) in BV32 &
      (psum.i) in INT &
      (ssum.i) in INT) &
    (for b being Element of B holds
      q.b in BV32 & r.b in BV32 &
      -(2 |^ 31) <= q.b & q.b <= 2147483647 &
      0 <= r.b & r.b <= 2147483647 &
      v.b = q.b * (2 |^ 31) + r.b) &
    (for b1,b2 being Element of B st
      q.b1 = q.b2 & r.b1 = r.b2 & v.b1 = v.b2
     holds b1 = b2) &
    q.zero = 0 & r.zero = 0 & v.zero = 0 &
    (for u being Element of I holds
      (ival.u <= 0 implies (psum.u) = 0) &
      (0 < ival.u implies
        (psum.u) =
          (psum.(iprev.u)) + (elts.(iprev.u)))) &
    (for l being Element of I holds
      (alen.a <= ival.l implies (ssum.l) = 0) &
      (ival.l < alen.a implies
        (ssum.l) =
          (elts.l) + (ssum.(inext.l)))) 
&
    alen.a < 2147483647
  holds
    (-(2 |^ 31) <= alen.a - 1 & alen.a - 1 <= 2147483647) &
    (for o1 being Element of I st ival.o1 in BV32 & ival.o1 = alen.a - 1 
holds
      ((0 <= ival.o1 + 1 implies
        ((55 < 89 & v.zero = (psum.izero)) &
         (for right2 being Element of B holds
           ((for i being Element of I st
               ival.i in BV32 &
               (0 <= ival.i & ival.i <= ival.o1) &
               55 < 89 &
               v.right2 = (psum.i)
             holds
               (0 <= ival.i & ival.i < alen.a) &
               (-(2 |^ 31) * (2 |^ 31) <=
                  v.right2 + (elts.i) &
                v.right2 + (elts.i) <=
                  (2 |^ 31) * (2 |^ 31) - 1) &
               (for right3 being Element of B st
                  v.right3 = v.right2 + (elts.i)
                holds
                  55 < 89 &
                  v.right3 = (psum.(inext.i)))) &
            ((55 < 89 & v.right2 = (psum.(inext.o1))) 
implies
              (-(2 |^ 31) * (2 |^ 31) <=
                 |.v.zero - v.right2.| &
               |.v.zero - v.right2.| <=
                 (2 |^ 31) * (2 |^ 31) - 1) &
              (for bestd being Element of B st
                 v.bestd = |.v.zero - v.right2.|
               holds
                 (-(2 |^ 31) <= alen.a - 1 &
                  alen.a - 1 <= 2147483647) &
                 (for o2 being Element of I st
                    ival.o2 in BV32 & ival.o2 = alen.a - 1
                  holds
                    ((0 <= ival.o2 + 1 implies
                      ((55 < 89 &
                        v.zero = (psum.izero) &
                        v.right2 = (psum.ilen) &
                        0 <= 0 &
                        v.bestd =
                          |.(psum.izero) - 
(psum.ilen).| &
                        (for j being Element of I st 0 <= ival.j & ival.j 
<= 0
                         holds
                           v.bestd <=
                             |.(psum.j) - (ssum.j).|)) &
                       (for bestd1 being Element of B,
                            besti being Element of I,
                            left2,right3 being Element of B st
                            ival.besti in BV32
                        holds
                         ((for i being Element of I st
                             ival.i in BV32 &
                             (0 <= ival.i & ival.i <= ival.o2) &
                             55 < 89 &
                             v.left2 = (psum.i) &
                             v.right3 = (ssum.i) &
                             (0 <= ival.besti & ival.besti <= ival.i) &
                             v.bestd1 =
                               |.(psum.besti) -
                                  (ssum.besti).| &
                             (for j being Element of I st
                                0 <= ival.j & ival.j <= ival.i
                              holds
                                v.bestd1 <=
                                  |.(psum.j) - 
(ssum.j).|)
                           holds
                             (0 <= ival.i & ival.i < alen.a) &
                             (-(2 |^ 31) * (2 |^ 31) <=
                                v.left2 + (elts.i) &
                              v.left2 + (elts.i) <=
                                (2 |^ 31) * (2 |^ 31) - 1) &
                             (for left3 being Element of B st
                                v.left3 =
                                  v.left2 + (elts.i)
                              holds
                                (0 <= ival.i & ival.i < alen.a) &
                                (-(2 |^ 31) * (2 |^ 31) <=
                                   v.right3 - (elts.i) &
                                 v.right3 - (elts.i) <=
                                   (2 |^ 31) * (2 |^ 31) - 1) &
                                (for right4 being Element of B st
                                   v.right4 =
                                     v.right3 - (elts.i)
                                 holds
                                   (-(2 |^ 31) * (2 |^ 31) <=
                                      |.v.left3 - v.right4.| &
                                    |.v.left3 - v.right4.| <=
                                      (2 |^ 31) *
                                        (2 |^ 31) - 1) &
                                   (for d being Element of B st
                                      v.d =
                                        |.v.left3 - v.right4.|
                                    holds
                                      (0 <= v.d &
                                       0 <= v.bestd1) &
                                      ((v.d < v.bestd1 implies
                                        for bestd2 being Element of B
                                        holds
                                          (-(2 |^ 31) <= ival.i + 1 &
                                           ival.i + 1 <= 2147483647) &
                                          (for o5 being Element of I st
                                             ival.o5 in BV32 & ival.o5 = 
ival.i + 1
                                           holds
                                             (-(2 |^ 31) <= q.d &
                                              q.d <= 2147483647) &
                                             (0 <= r.d &
                                              r.d <= 2147483647) &
                                             v.d =
                                               q.d * (2 |^ 31) + r.d &
                                             ((v.d = v.bestd2 &
                                               r.d = r.bestd2 &
                                               q.d = q.bestd2) implies
                                               55 < 89 &
                                               v.left3 =
                                                 (psum.(inext.i)) &
                                               v.right4 =
                                                 (ssum.(inext.i)) &
                                               (0 <= ival.o5 &
                                                ival.o5 <= ival.i+1) &
                                               v.bestd2 =
                                                 |.(psum.o5) -
                                                    (ssum.o5).| &
                                               (for j being Element of I st
                                                  0 <= ival.j & ival.j <= 
ival.i+1
                                                holds
                                                  v.bestd2 <=
                                                    |.(psum.j) -
                                                       ssum.j.|)))) 
&
                                       (not v.d < v.bestd1 implies
                                          55 < 89 &
                                          v.left3 = (psum.(inext.i)) 
&
                                          v.right4 =
                                            (ssum.(inext.i)) &
                                          (0 <= ival.besti &
                                           ival.besti <= ival.i+1) &
                                          v.bestd1 =
                                            |.(psum.besti) 
-
                                               (ssum.besti).| &
                                          (for j being Element of I st
                                             0 <= ival.j & ival.j <= 
ival.i+1
                                           holds
                                             v.bestd1 <=
                                               |.(psum.j) -
                                                  (ssum.j).|))))))) &
                          ((55 < 89 &
                            v.left2 = (psum.(inext.o2)) &
                            v.right3 = (ssum.(inext.o2)) &
                            (0 <= ival.besti & ival.besti <= ival.o2+1) &
                            v.bestd1 =
                              |.(psum.besti) -
                                 (ssum.besti).| &
                            (for j being Element of I st
                               0 <= ival.j & ival.j <= ival.o2+1
                             holds
                               v.bestd1 <=
                                 |.(psum.j) - 
(ssum.j).|)
                           implies
                            (0 <= ival.besti & ival.besti <= alen.a) &
                            (for i being Element of I st
                               0 <= ival.i & ival.i <= alen.a
                             holds
                               |.(psum.besti) -
                                  (ssum.besti).| <=
                               |.(psum.i) - (ssum.i).|))))) &
                     (ival.o2 + 1 < 0 implies
                       (0 <= 0 & 0 <= alen.a) &
                       (for i being Element of I st
                          0 <= ival.i & ival.i <= alen.a
                        holds
                          |.(psum.izero) - 
(psum.ilen).| <=
                          |.(psum.i) - (ssum.i).|)))))))))) &
       (ival.o1 + 1 < 0 implies
         (-(2 |^ 31) * (2 |^ 31) <=
            |.v.zero - v.zero.| &
          |.v.zero - v.zero.| <=
            (2 |^ 31) * (2 |^ 31) - 1) &
         (for bestd being Element of B st
            v.bestd = |.v.zero - v.zero.|
          holds
            (-(2 |^ 31) <= alen.a - 1 &
             alen.a - 1 <= 2147483647) &
            (for o2 being Element of I st
               ival.o2 in BV32 & ival.o2 = alen.a - 1
             holds
               ((0 <= ival.o2 + 1 implies
                 ((55 < 89 &
                   v.zero = (psum.izero) &
                   v.zero = (psum.ilen) &
                   0 <= 0 &
                   v.bestd = |.(psum.izero) - 
(psum.ilen).| &
                   (for j being Element of I st 0 <= ival.j & ival.j <= 0
                    holds
                      v.bestd <=
                        |.(psum.j) - (ssum.j).|)) &
                  (for bestd1 being Element of B,
                       besti being Element of I,
                       left2,right2 being Element of B st
                       ival.besti in BV32
                   holds
                    ((for i being Element of I st
                        ival.i in BV32 &
                        (0 <= ival.i & ival.i <= ival.o2) &
                        55 < 89 &
                        v.left2 = (psum.i) &
                        v.right2 = (ssum.i) &
                        (0 <= ival.besti & ival.besti <= ival.i) &
                        v.bestd1 =
                          |.(psum.besti) - 
(ssum.besti).| &
                        (for j being Element of I st 0 <= ival.j & ival.j 
<= ival.i
                         holds
                           v.bestd1 <=
                             |.(psum.j) - (ssum.j).|)
                      holds
                        (0 <= ival.i & ival.i < alen.a) &
                        (-(2 |^ 31) * (2 |^ 31) <=
                           v.left2 + (elts.i) &
                         v.left2 + (elts.i) <=
                           (2 |^ 31) * (2 |^ 31) - 1) &
                        (for left3 being Element of B st
                           v.left3 = v.left2 + (elts.i)
                         holds
                           (0 <= ival.i & ival.i < alen.a) &
                           (-(2 |^ 31) * (2 |^ 31) <=
                              v.right2 - (elts.i) &
                            v.right2 - (elts.i) <=
                              (2 |^ 31) * (2 |^ 31) - 1) &
                           (for right3 being Element of B st
                              v.right3 =
                                v.right2 - (elts.i)
                            holds
                              (-(2 |^ 31) * (2 |^ 31) <=
                                 |.v.left3 - v.right3.| &
                               |.v.left3 - v.right3.| <=
                                 (2 |^ 31) * (2 |^ 31) - 1) &
                              (for d being Element of B st
                                 v.d =
                                   |.v.left3 - v.right3.|
                               holds
                                 (0 <= v.d & 0 <= v.bestd1) &
                                 ((v.d < v.bestd1 implies
                                   for bestd2 being Element of B
                                   holds
                                     (-(2 |^ 31) <= ival.i + 1 &
                                      ival.i + 1 <= 2147483647) &
                                     (for o5 being Element of I st
                                        ival.o5 in BV32 & ival.o5 = 
ival.i + 1
                                      holds
                                        (-(2 |^ 31) <= q.d &
                                         q.d <= 2147483647) &
                                        (0 <= r.d &
                                         r.d <= 2147483647) &
                                        v.d =
                                          q.d * (2 |^ 31) + r.d &
                                        ((v.d = v.bestd2 &
                                          r.d = r.bestd2 &
                                          q.d = q.bestd2) implies
                                          55 < 89 &
                                          v.left3 = (psum.(inext.i)) 
&
                                          v.right3 =
                                            (ssum.(inext.i)) &
                                          (0 <= ival.o5 &
                                           ival.o5 <= ival.i+1) &
                                          v.bestd2 =
                                            |.(psum.o5) 
-
                                               (ssum.o5).| 
&
                                          (for j being Element of I st
                                             0 <= ival.j & ival.j <= 
ival.i+1
                                           holds
                                             v.bestd2 <=
                                               |.(psum.j) -
                                                  (ssum.j).|)))) 
&
                                  (not v.d < v.bestd1 implies
                                     55 < 89 &
                                     v.left3 = (psum.(inext.i)) &
                                     v.right3 =
                                       (ssum.(inext.i)) &
                                     (0 <= ival.besti &
                                      ival.besti <= ival.i+1) &
                                     v.bestd1 =
                                       |.(psum.besti) -
                                          (ssum.besti).| &
                                     (for j being Element of I st
                                        0 <= ival.j & ival.j <= ival.i+1
                                      holds
                                        v.bestd1 <=
                                          |.(psum.j) -
                                             (ssum.j).|))))))) &
                     ((55 < 89 &
                       v.left2 = (psum.(inext.o2)) &
                       v.right2 = (ssum.(inext.o2)) &
                       (0 <= ival.besti & ival.besti <= ival.o2+1) &
                       v.bestd1 =
                         |.(psum.besti) - 
(ssum.besti).| &
                       (for j being Element of I st
                          0 <= ival.j & ival.j <= ival.o2+1
                        holds
                          v.bestd1 <=
                            |.(psum.j) - (ssum.j).|)
                      implies
                       (0 <= ival.besti & ival.besti <= alen.a) &
                       (for i being Element of I st
                          0 <= ival.i & ival.i <= alen.a
                        holds
                          |.(psum.besti) -
                             (ssum.besti).| <=
                          |.(psum.i) - (ssum.i).|))))) &
                (ival.o2 + 1 < 0 implies
                  (0 <= 0 & 0 <= alen.a) &
                  (for i being Element of I st
                     0 <= ival.i & ival.i <= alen.a
                   holds
                     |.(psum.izero) - (psum.ilen).| <=
                     |.(psum.i) - (ssum.i).|))))))))))))
proof
end;
::$P+
