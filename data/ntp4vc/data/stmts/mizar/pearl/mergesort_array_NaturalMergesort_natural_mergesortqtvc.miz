:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_array_NaturalMergesort_natural_mergesortqtvc:
:: the natural array mergesort verification condition tracks sorted runs,
:: merge boundaries, permutation invariants, and termination measures.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      nthElem being Function of [:E*,INT:],E,
      SortedSub being Subset of [:E*,[:INT,INT:]:],
      Sorted being Subset of E*,
      Perm being Relation of E*,E*,
      PermSub being Subset of [:E*,[:E*,[:INT,INT:]:]:],
      a being FinSequence of E
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (for s being FinSequence of E, l,u being Integer holds
       ([s,[l,u]] in SortedSub iff
         for i1,i2 being Integer st
           l <= i1 & i1 < i2 & i2 < u
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s being FinSequence of E holds
       (s in Sorted iff
         for i1,i2 being Integer st
           0 <= i1 & i1 < i2 & i2 < len s
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s,t being FinSequence of E holds
       ([s,t] in Perm iff
         len s = len t &
         (for x being Element of E holds
           card {q where q is Integer :
             0 <= q & q < len s & nthElem.[s,q] = x} =
           card {q where q is Integer :
             0 <= q & q < len t & nthElem.[t,q] = x}))) &
    (for s,t being FinSequence of E, l,u being Integer holds
       ([s,[t,[l,u]]] in PermSub iff
         len s = len t &
         0 <= max(l,0) & max(l,0) <= len s &
         0 <= max(u,0) & max(u,0) <= len s &
         (for x being Element of E holds
           card {q where q is Integer :
             max(l,0) <= q & q < max(u,0) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(l,0) <= q & q < max(u,0) &
             nthElem.[t,q] = x})))
  holds
    for n being Integer st n = len a holds
      (n <= 1 implies
        a in Sorted & [a,a] in Perm) &
      ((not n <= 1) implies
        for tmp being FinSequence of E st
          len tmp = len a &
          (for i being Integer st 0 <= i & i < len tmp
           holds nthElem.[tmp,i] = nthElem.[a,i])
        holds
          (((0 <= 0 & 0 <= n) &
            [a,[0,0]] in SortedSub) &
           [a,a] in Perm) &
          (for firstRun being Integer,
               tmp1,a1 being FinSequence of E st
             len tmp1 = len tmp &
             len a1 = len a &
             ((0 <= firstRun & firstRun <= n) &
              [a1,[0,firstRun]] in SortedSub) &
             [a,a1] in Perm
           holds
             ((0 <= 0 & 0 <= n) &
              (firstRun <= firstRun & firstRun <= n) &
              [a1,[0,firstRun]] in SortedSub &
              [a1,a1] in Perm) &
             (for lo,firstRun1 being Integer,
                  tmp2,a2 being FinSequence of E st
                len tmp2 = len tmp1 &
                len a2 = len a1 &
                (0 <= lo & lo <= n) &
                (firstRun <= firstRun1 & firstRun1 <= n) &
                [a2,[0,firstRun1]] in SortedSub &
                (lo = 0 or
                  (firstRun1 <= lo & firstRun < firstRun1)) &
                [a1,a2] in Perm
              holds
                (lo < n-1 implies
                  (0 <= lo & lo < len a2) &
                  (for mid being Integer st
                     (lo < mid & mid <= len a2) &
                     [a2,[lo,mid]] in SortedSub &
                     (mid < len a2 implies
                       not [nthElem.[a2,mid-1],
                            nthElem.[a2,mid]] in Leq)
                   holds
                     (mid = n implies
                       (lo = 0 implies
                         a2 in Sorted & [a,a2] in Perm) &
                       ((not lo = 0) implies
                         (0 <= n-firstRun &
                          n-firstRun1 < n-firstRun) &
                         ((0 <= firstRun1 & firstRun1 <= n) &
                          [a2,[0,firstRun1]] in SortedSub) &
                         [a,a2] in Perm)) &
                     ((not mid = n) implies
                       (0 <= mid & mid < len a2) &
                       (for hi being Integer st
                          (mid < hi & hi <= len a2) &
                          [a2,[mid,hi]] in SortedSub &
                          (hi < len a2 implies
                            not [nthElem.[a2,hi-1],
                                 nthElem.[a2,hi]] in Leq)
                        holds
                          (((0 <= lo & lo <= mid &
                             mid <= hi & hi <= len tmp2 &
                             len tmp2 = len a2) &
                            [a2,[lo,mid]] in SortedSub &
                            [a2,[mid,hi]] in SortedSub) &
                           (for a3 being FinSequence of E st
                              len a3 = len a2 &
                              [a3,[lo,hi]] in SortedSub &
                              [a2,[a3,[lo,hi]]] in PermSub &
                              (for i being Integer st
                                 (0 <= i & i < lo) or
                                 (hi <= i & i < len a3)
                               holds
                                 nthElem.[a3,i] =
                                   nthElem.[a2,i])
                            holds
                              (lo = 0 implies
                                (0 <= n-lo & n-hi < n-lo) &
                                (0 <= hi & hi <= n) &
                                (firstRun <= hi & hi <= n) &
                                [a3,[0,hi]] in SortedSub &
                                (hi = 0 or
                                  (hi <= hi & firstRun < hi)) &
                                [a1,a3] in Perm) &
                              ((not lo = 0) implies
                                (0 <= n-lo & n-hi < n-lo) &
                                (0 <= hi & hi <= n) &
                                (firstRun <= firstRun1 &
                                 firstRun1 <= n) &
                                [a3,[0,firstRun1]]
                                  in SortedSub &
                                (hi = 0 or
                                  (firstRun1 <= hi &
                                   firstRun < firstRun1)) &
                                [a1,a3] in Perm))))))) &
                ((not lo < n-1) implies
                  (0 <= n-firstRun &
                   n-firstRun1 < n-firstRun) &
                  ((0 <= firstRun1 & firstRun1 <= n) &
                   [a2,[0,firstRun1]] in SortedSub) &
                  [a,a2] in Perm))))
proof
end;
::$P+
