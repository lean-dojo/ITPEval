:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bignum_BigNum_add_digitqtvc: the single-digit addition verification
:: condition for valid finite base-b integer-digit lists and their recursively
:: defined integer values. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for base,d being Integer,
      n being FinSequence of INT,
      Value being Function of INT*,INT,
      Valid being Subset of INT* st
    1 < base &
    Value.(<*>INT) = 0 &
    (for d0 being Integer, r,s being FinSequence of INT st
      s = <*d0*> ^ r
     holds
      ex vr,vs being Integer st
        vr = Value.r &
        vs = Value.s &
        vs = d0 + base * vr) &
    <*>INT in Valid &
    (for d0 being Integer holds
      (<*d0*> in Valid iff 0 < d0 & d0 < base)) &
    (for d0 being Integer,
         r being non empty FinSequence of INT holds
      ((<*d0*> ^ r) in Valid iff
        (0 <= d0 & d0 < base) & r in Valid)) &
    n in Valid &
    0 <= d &
    d < base
  holds
    (for d0 being Integer, r being FinSequence of INT st
      n = <*d0*> ^ r
     holds
      (not d + d0 < base implies
        r = r &
        r in Valid &
        0 <= 1 &
        1 < base)) &
    (for result being FinSequence of INT holds
      ex vresult,vn being Integer st
        vresult = Value.result &
        vn = Value.n &
        (((n = <*>INT & d = 0 & result = <*>INT) or
          (n = <*>INT & d <> 0 & result = <*d*>) or
          (ex d0 being Integer,
              r being FinSequence of INT st
            n = <*d0*> ^ r &
            d + d0 < base &
            result = <*(d + d0)*> ^ r) or
          (ex d0 being Integer,
              r,o1 being FinSequence of INT,
              vr,vo1 being Integer st
            n = <*d0*> ^ r &
            not d + d0 < base &
            vr = Value.r &
            vo1 = Value.o1 &
            (o1 in Valid & vo1 = vr + 1) &
            result = <*(d + d0 - base)*> ^ o1))
         implies
          result in Valid &
          vresult = vn + d))
proof
end;
::$P+
