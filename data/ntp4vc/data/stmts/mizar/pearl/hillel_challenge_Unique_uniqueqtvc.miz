:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/hillel_challenge_Unique_uniqueqtvc: the uniqueness-filter
:: verification condition maintains prefix membership and pairwise
:: distinctness while scanning an integer list. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1,
    MARGREL1, XBOOLEAN;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being FinSequence of INT,
      nthElem being Function of [:INT*,INT:],INT,
      prefixSet being Function of [:INT*,INT:],bool INT,
      setList being Function of [:[:INT*,INT:],INT:],INT* st
    (for xs being FinSequence of INT, i being Integer holds
      (i < 0 & len xs = 0 implies nthElem.[xs,i] = 0) &
      (i < 0 & 0 < len xs implies nthElem.[xs,i] = xs.1) &
      (0 <= i & i < len xs implies
        nthElem.[xs,i] = xs.(i+1)) &
      (len xs <= i implies nthElem.[xs,i] = 0)) &
    (for xs being FinSequence of INT, i being Integer,
         x being Integer holds
      (x in prefixSet.[xs,i] iff
        ex j being Integer st
          0 <= j & j < i & nthElem.[xs,j] = x)) &
    (for xs being FinSequence of INT, i,v being Integer holds
      len (setList.[[xs,i],v]) = len xs &
      (0 <= i & i < len xs implies
        for k being Integer st 0 <= k & k < len xs holds
          (k = i implies nthElem.[setList.[[xs,i],v],k] = v) &
          (k <> i implies
            nthElem.[setList.[[xs,i],v],k] = nthElem.[xs,k])) &
      (i < 0 & 0 < len xs implies
        for k being Integer st 0 <= k & k < len xs holds
          (k = 0 implies nthElem.[setList.[[xs,i],v],k] = v) &
          (k <> 0 implies
            nthElem.[setList.[[xs,i],v],k] = nthElem.[xs,k])) &
      ((len xs <= i or (i < 0 & len xs = 0)) implies
        setList.[[xs,i],v] = xs))
  holds
    for n being Integer st n = len a holds
      for h being finite Subset of INT st h = {} holds
        0 <= n &
        (for res being FinSequence of INT st
          (for i being Integer st 0 <= i & i < n
            holds nthElem.[res,i] = 0) &
          len res = n
         holds
          for o1 being Integer st o1 = n - 1 holds
            (0 <= o1 + 1 implies
              ((0 <= 0 &
                (for x being Integer holds
                  (x in prefixSet.[a,0] iff x in h)) &
                (for x being Integer holds
                  (x in prefixSet.[a,0] iff
                    x in prefixSet.[res,0])) &
                (for i,j being Integer st
                  0 <= i & i < j & j < 0
                 holds nthElem.[res,i] <> nthElem.[res,j])) &
               (for len1 being Integer,
                    res1 being FinSequence of INT,
                    h1 being finite Subset of INT st
                  len res1 = len res
                holds
                  (for i being Integer st
                    (0 <= i & i <= o1) &
                    (0 <= len1 & len1 <= i) &
                    (for x being Integer holds
                      (x in prefixSet.[a,i] iff x in h1)) &
                    (for x being Integer holds
                      (x in prefixSet.[a,i] iff
                        x in prefixSet.[res1,len1])) &
                    (for i1,j being Integer st
                      0 <= i1 & i1 < j & j < len1
                     holds nthElem.[res1,i1] <>
                       nthElem.[res1,j])
                   holds
                    (0 <= i & i < len a) &
                    ((not nthElem.[a,i] in h1 implies
                      (0 <= i & i < len a) &
                      (for h2 being finite Subset of INT st
                        h2 = h1 \/ {nthElem.[a,i]}
                       holds
                        (0 <= i & i < len a) &
                        (for o2 being Integer st
                          o2 = nthElem.[a,i]
                         holds
                          (0 <= len1 & len1 < len res1) &
                          (len (setList.[[res1,len1],o2]) =
                              len res1 implies
                            ((for q being Integer holds
                              (q = len1 implies
                                nthElem.[setList.
                                  [[res1,len1],o2],q] = o2) &
                              (q <> len1 implies
                                nthElem.[setList.
                                  [[res1,len1],o2],q] =
                                  nthElem.[res1,q]))
                             implies
                              (0 <= len1 + 1 &
                                len1 + 1 <= i + 1) &
                              (for x being Integer holds
                                (x in prefixSet.[a,i+1] iff
                                  x in h2)) &
                              (for x being Integer holds
                                (x in prefixSet.[a,i+1] iff
                                  x in prefixSet.
                                    [setList.
                                      [[res1,len1],o2],len1+1])) &
                              (for i1,j being Integer st
                                0 <= i1 & i1 < j &
                                j < len1 + 1
                               holds
                                nthElem.
                                  [setList.
                                    [[res1,len1],o2],i1] <>
                                nthElem.
                                  [setList.
                                    [[res1,len1],o2],j])))))) &
                     (nthElem.[a,i] in h1 implies
                      (0 <= len1 & len1 <= i + 1) &
                      (for x being Integer holds
                        (x in prefixSet.[a,i+1] iff x in h1)) &
                      (for x being Integer holds
                        (x in prefixSet.[a,i+1] iff
                          x in prefixSet.[res1,len1])) &
                      (for i1,j being Integer st
                        0 <= i1 & i1 < j & j < len1
                       holds nthElem.[res1,i1] <>
                         nthElem.[res1,j]))) &
                  (((0 <= len1 & len1 <= o1 + 1) &
                    (for x being Integer holds
                      (x in prefixSet.[a,o1+1] iff x in h1)) &
                    (for x being Integer holds
                      (x in prefixSet.[a,o1+1] iff
                        x in prefixSet.[res1,len1])) &
                    (for i,j being Integer st
                      0 <= i & i < j & j < len1
                     holds nthElem.[res1,i] <>
                       nthElem.[res1,j]))
                   implies
                    (0 <= 0 & 0 <= len1 &
                      0 + len1 <= len res1) &
                    (for result being FinSequence of INT st
                      len result = len1 &
                      (for i being Integer st
                        0 <= i & i < len1
                       holds nthElem.[result,i] =
                         nthElem.[res1,0+i])
                     holds
                      (for x being Integer holds
                        (x in prefixSet.[result,len result] iff
                          x in prefixSet.[a,len a])) &
                      (for i,j being Integer st
                        0 <= i & i < j & j < len result
                       holds nthElem.[result,i] <>
                         nthElem.[result,j])))))) &
            (o1 + 1 < 0 implies
              (0 <= 0 & 0 <= 0 & 0 + 0 <= len res) &
              (for result being FinSequence of INT st
                len result = 0 &
                (for i being Integer st 0 <= i & i < 0
                  holds nthElem.[result,i] =
                    nthElem.[res,0+i])
               holds
                (for x being Integer holds
                  (x in prefixSet.[result,len result] iff
                    x in prefixSet.[a,len a])) &
                (for i,j being Integer st
                  0 <= i & i < j & j < len result
                 holds nthElem.[result,i] <>
                   nthElem.[result,j])))))
proof
end;
::$P+
