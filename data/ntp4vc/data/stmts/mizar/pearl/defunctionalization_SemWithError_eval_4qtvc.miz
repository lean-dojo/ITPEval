:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/defunctionalization_SemWithError_eval_4qtvc: the error-aware
:: defunctionalized expression-evaluation verification condition, combining
:: size decrease with preservation of the continuation evaluation relation.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Expr,Value,Cont being non empty set,
      cte being Function of INT,Expr,
      sube being Function of [:Expr,Expr:],Expr,
      vnum being Function of INT,Value,
      underflow being Element of Value,
      aone being Function of [:Expr,Cont:],Cont,
      btwo being Function of [:INT,Cont:],Cont,
      ident being Element of Cont,
      evalErr being Function of Expr,Value,
      sizeE being Function of Expr,INT,
      sizeC being Function of Cont,INT,
      evalCont being Subset of [:Cont,[:Value,Value:]:],
      e being Element of Expr,
      c being Element of Cont
  st
    (for x,y being Integer st cte.x = cte.y holds x = y) &
    (for e1,e2,f1,f2 being Element of Expr st
       sube.[e1,e2] = sube.[f1,f2]
     holds e1 = f1 & e2 = f2) &
    (for x being Integer, e1,e2 being Element of Expr
     holds cte.x <> sube.[e1,e2]) &
    (for e0 being Element of Expr holds
       (ex x being Integer st e0 = cte.x) or
       ex e1,e2 being Element of Expr st e0 = sube.[e1,e2]) &
    (for X being Subset of Expr st
       (for x being Integer holds cte.x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds sube.[e1,e2] in X)
     holds X = Expr) &
    (for x,y being Integer st vnum.x = vnum.y holds x = y) &
    (for x being Integer holds vnum.x <> underflow) &
    (for w being Element of Value holds
       w = underflow or ex x being Integer st w = vnum.x) &
    (for e1,e2 being Element of Expr, k1,k2 being Element of Cont st
       aone.[e1,k1] = aone.[e2,k2]
     holds e1 = e2 & k1 = k2) &
    (for x1,x2 being Integer, k1,k2 being Element of Cont st
       btwo.[x1,k1] = btwo.[x2,k2]
     holds x1 = x2 & k1 = k2) &
    (for e0 being Element of Expr, k1,k2 being Element of Cont,
         x being Integer
     holds aone.[e0,k1] <> btwo.[x,k2]) &
    (for e0 being Element of Expr, k being Element of Cont
     holds aone.[e0,k] <> ident) &
    (for x being Integer, k being Element of Cont
     holds btwo.[x,k] <> ident) &
    (for k being Element of Cont holds
       k = ident or
       (ex e0 being Element of Expr, k1 being Element of Cont st
          k = aone.[e0,k1]) or
       ex x being Integer, k1 being Element of Cont st
          k = btwo.[x,k1]) &
    (for K being Subset of Cont st
       ident in K &
       (for e0 being Element of Expr, k being Element of Cont st k in K
        holds aone.[e0,k] in K) &
       (for x being Integer, k being Element of Cont st k in K
        holds btwo.[x,k] in K)
     holds K = Cont) &
    (for x being Integer holds
       (0 <= x implies evalErr.(cte.x) = vnum.x) &
       (not 0 <= x implies evalErr.(cte.x) = underflow)) &
    (for e1,e2 being Element of Expr holds
       (evalErr.e1 = underflow implies
          evalErr.(sube.[e1,e2]) = underflow) &
       (for x being Integer st evalErr.e1 = vnum.x holds
          (evalErr.e2 = underflow implies
             evalErr.(sube.[e1,e2]) = underflow) &
          (for y being Integer st evalErr.e2 = vnum.y holds
             (y <= x implies
                evalErr.(sube.[e1,e2]) = vnum.(x-y)) &
             (not y <= x implies
                evalErr.(sube.[e1,e2]) = underflow)))) &
    (for x being Integer holds sizeE.(cte.x) = 1) &
    (for e1,e2 being Element of Expr holds
       sizeE.(sube.[e1,e2]) = 3 + sizeE.e1 + sizeE.e2) &
    sizeC.ident = 0 &
    (for e0 being Element of Expr, k being Element of Cont holds
       sizeC.(aone.[e0,k]) = 2 + sizeE.e0 + sizeC.k) &
    (for x being Integer, k being Element of Cont holds
       sizeC.(btwo.[x,k]) = 1 + sizeC.k) &
    (for k being Element of Cont holds
       [k,[underflow,underflow]] in evalCont) &
    (for x being Integer, k being Element of Cont,
         e0 being Element of Expr, r being Element of Value st
       [btwo.[x,k],[evalErr.e0,r]] in evalCont
     holds [aone.[e0,k],[vnum.x,r]] in evalCont) &
    (for x,y being Integer, k being Element of Cont,
         r being Element of Value st
       y <= x & [k,[vnum.(x-y),r]] in evalCont
     holds [btwo.[x,k],[vnum.y,r]] in evalCont) &
    (for x,y being Integer, k being Element of Cont,
         r being Element of Value st
       not y <= x & [k,[underflow,r]] in evalCont
     holds [btwo.[x,k],[vnum.y,r]] in evalCont) &
    (for x being Integer holds
       [ident,[vnum.x,vnum.x]] in evalCont) &
    (for R being Subset of [:Cont,[:Value,Value:]:] st
       (for k being Element of Cont holds
          [k,[underflow,underflow]] in R) &
       (for x being Integer, k being Element of Cont,
            e0 being Element of Expr, r being Element of Value st
          [btwo.[x,k],[evalErr.e0,r]] in R
        holds [aone.[e0,k],[vnum.x,r]] in R) &
       (for x,y being Integer, k being Element of Cont,
            r being Element of Value st
          y <= x & [k,[vnum.(x-y),r]] in R
        holds [btwo.[x,k],[vnum.y,r]] in R) &
       (for x,y being Integer, k being Element of Cont,
            r being Element of Value st
          not y <= x & [k,[underflow,r]] in R
        holds [btwo.[x,k],[vnum.y,r]] in R) &
       (for x being Integer holds
          [ident,[vnum.x,vnum.x]] in R)
     holds evalCont c= R)
  holds
    ((for n being Integer st e = cte.n holds
        0 <= n implies
          ((0 <= sizeC.c + sizeE.e &
            sizeC.c < sizeC.c + sizeE.e) &
           0 <= n)) &
     (for e1,e2 being Element of Expr st e = sube.[e1,e2] holds
        0 <= sizeC.c + sizeE.e &
        ex scnext,se1 being Integer st
          scnext = sizeC.(aone.[e2,c]) &
          se1 = sizeE.e1 &
          scnext + se1 < sizeC.c + sizeE.e)) &
    (for result being Element of Value st
       ((ex n being Integer st
           e = cte.n &
           ((0 <= n & [c,[vnum.n,result]] in evalCont) or
            (not 0 <= n & result = underflow))) or
        (ex e1,e2 being Element of Expr st
           e = sube.[e1,e2] &
           [aone.[e2,c],[evalErr.e1,result]] in evalCont))
     holds [c,[evalErr.e,result]] in evalCont)
proof
end;
::$P+
