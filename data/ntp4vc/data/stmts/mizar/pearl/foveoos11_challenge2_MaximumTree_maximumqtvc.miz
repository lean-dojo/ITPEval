:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/foveoos11_challenge2_MaximumTree_maximumqtvc: the verification
:: condition for recursively computing the maximum label of a nonempty
:: integer-labeled binary tree. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Tree being non empty set,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:INT,Tree:]:],Tree,
      Size being Function of Tree,INT,
      Mem being Subset of [:INT,Tree:],
      t being Element of Tree
  st
    (for l,r being Element of Tree,
         v being Integer
     holds
       node.[l,[v,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          v being Integer st
         u = node.[l,[v,r]]) &
    (for l,l2,r,r2 being Element of Tree,
         v,v2 being Integer st
       node.[l,[v,r]] = node.[l2,[v2,r2]]
     holds
       l = l2 & v = v2 & r = r2) &
    Size.emptyT = 0 &
    (for u being Element of Tree holds 0 <= Size.u) &
    (for l,r being Element of Tree,
         v being Integer
     holds
       Size.(node.[l,[v,r]]) = 1 + Size.l + Size.r) &
    (for x being Integer holds
       not [x,emptyT] in Mem) &
    (for x,v being Integer,
         l,r being Element of Tree
     holds
       ([x,node.[l,[v,r]]] in Mem iff
          [x,l] in Mem or x = v or [x,r] in Mem)) &
    t <> emptyT
  holds
    (for v being Integer,
         s being Element of Tree st
       t = node.[emptyT,[v,s]] & s <> emptyT
     holds
       (0 <= Size.t & Size.s < Size.t) &
       s <> emptyT) &
    (for v being Integer,
         s being Element of Tree st
       t = node.[s,[v,emptyT]] & s <> emptyT
     holds
       (0 <= Size.t & Size.s < Size.t) &
       s <> emptyT) &
    (for v being Integer,
         l,r being Element of Tree st
       t = node.[l,[v,r]] & l <> emptyT & r <> emptyT
     holds
       ((0 <= Size.t & Size.r < Size.t) &
        r <> emptyT) &
       (for o1 being Integer st
          [o1,r] in Mem &
          (for x being Integer st [x,r] in Mem holds x <= o1)
        holds
          (0 <= Size.t & Size.l < Size.t) &
          l <> emptyT)) &
    (for result being Integer st
       ((ex v being Integer st
           t = node.[emptyT,[v,emptyT]] &
           result = v) or
        (ex v,o1 being Integer,
            s being Element of Tree st
           t = node.[emptyT,[v,s]] &
           s <> emptyT &
           [o1,s] in Mem &
           (for x being Integer st [x,s] in Mem holds x <= o1) &
           result = max(o1,v)) or
        (ex v,o1 being Integer,
            s being Element of Tree st
           t = node.[s,[v,emptyT]] &
           s <> emptyT &
           [o1,s] in Mem &
           (for x being Integer st [x,s] in Mem holds x <= o1) &
           result = max(o1,v)) or
        (ex v,o1,o2 being Integer,
            l,r being Element of Tree st
           t = node.[l,[v,r]] &
           l <> emptyT & r <> emptyT &
           [o1,r] in Mem &
           (for x being Integer st [x,r] in Mem holds x <= o1) &
           [o2,l] in Mem &
           (for x being Integer st [x,l] in Mem holds x <= o2) &
           result = max(o2,max(v,o1))))
     holds
       [result,t] in Mem &
       (for x being Integer st [x,t] in Mem holds x <= result))
proof
end;
::$P+
