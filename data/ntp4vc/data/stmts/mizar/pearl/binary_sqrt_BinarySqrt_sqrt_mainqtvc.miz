:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binary_sqrt_BinarySqrt_sqrt_mainqtvc: the binary-square-root entry
:: verification condition repeats nonnegativity of the radicand and positivity
:: of the tolerance, together with unit integer and real identities.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for r,eps being Real st
    0 <= r &
    0 < eps
  holds
    0 <= r &
    0 < eps &
    (1 qua Integer) <= (1 qua Integer) &
    eps = (1 qua Real) * eps
proof
end;
::$P+
