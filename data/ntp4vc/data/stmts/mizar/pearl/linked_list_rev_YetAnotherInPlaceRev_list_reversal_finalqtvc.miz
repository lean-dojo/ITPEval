:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/linked_list_rev_YetAnotherInPlaceRev_list_reversal_finalqtvc: the
:: final verification condition for in-place linked-list reversal derives
:: the reversed list and frame properties from forward and reverse list
:: segment invariants. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being non empty set,
      null being Element of L,
      Result being Function of Funcs(INT,L),Funcs(INT,L),
      Fc being Function of
        [:Funcs(INT,L),INT:],Funcs(INT,L),
      ValidCells being Subset of [:Funcs(INT,L),INT:],
      ListLR,ListRL being Subset of
        [:Funcs(L,L),
          [:Funcs(INT,L),[:L,[:INT,INT:]:]:]:],
      Frame being Subset of
        [:Funcs(L,L),
          [:Funcs(L,L),[:Funcs(INT,L),INT:]:]:],
      IsList being Subset of
        [:Funcs(L,L),[:L,[:Funcs(INT,L),INT:]:]:]
  st
    (for s being Function of INT,L, n being Integer holds
       ([s,n] in ValidCells iff
         (for i being Integer st 0 <= i & i < n
          holds s.i <> null) &
         (for i,j being Integer st
            0 <= i & i < n & 0 <= j & j < n & i <> j
          holds s.i <> s.j))) &
    (for mem being Function of L,L,
         s being Function of INT,L,
         l being Element of L,
         lo,hi being Integer
     holds
       ([mem,[s,[l,[lo,hi]]]] in ListLR iff
         0 <= lo & lo <= hi &
         ((lo = hi & l = null) or
          (lo <> hi &
           l = s.lo &
           mem.(s.(hi-1)) = null &
           (for k being Integer st lo <= k & k < hi-1
            holds mem.(s.k) = s.(k+1)))))) &
    (for mem being Function of L,L,
         s being Function of INT,L,
         l being Element of L,
         lo,hi being Integer
     holds
       ([mem,[s,[l,[lo,hi]]]] in ListRL iff
         0 <= lo & lo <= hi &
         ((lo = hi & l = null) or
          (lo <> hi &
           mem.(s.lo) = null &
           l = s.(hi-1) &
           (for k being Integer st lo < k & k < hi
            holds mem.(s.k) = s.(k-1)))))) &
    (for mem1,mem2 being Function of L,L,
         s being Function of INT,L,
         n being Integer
     holds
       ([mem1,[mem2,[s,n]]] in Frame iff
         for p being Element of L st
           for i being Integer st 0 <= i & i < n
           holds p <> s.i
         holds mem1.p = mem2.p)) &
    (for s being Function of INT,L, i being Integer
     holds (Result.s).i = s.(i+1)) &
    (for n being Integer,
         mem being Function of L,L,
         l being Element of L,
         s being Function of INT,L st 0 <= n
     holds
       (n = 0 implies
         ([mem,[l,[s,n]]] in IsList iff l = null)) &
       (n <> 0 implies
         ([mem,[l,[s,n]]] in IsList iff
           l = s.0 & s.0 <> null &
           [mem,[mem.l,[Result.s,n-1]]] in IsList))) &
    (for s being Function of INT,L, n,i being Integer
     holds (Fc.[s,n]).i = s.(n-1-i))
  holds
    for mem1 being Function of L,L,
        s being Function of INT,L,
        n being Integer,
        l being Element of L st
      0 <= n & [mem1,[l,[s,n]]] in IsList
    holds
      ([s,n] in ValidCells &
       [mem1,[s,[l,[0,n]]]] in ListLR) &
      (for mem3 being Function of L,L,
           r being Element of L st
         [mem3,[s,[r,[0,n]]]] in ListRL &
         [mem3,[mem1,[s,n]]] in Frame
       holds
         [mem3,[r,[Fc.[s,n],n]]] in IsList &
         [mem3,[mem1,[s,n]]] in Frame)
proof
end;
::$P+
