:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2019_ghc_sort_Top_sort_to_listqtvc: the sort-to-list
:: verification condition turns bounded monotonic cutpoint segments into
:: nondecreasing runs and states that any sorted permutation of their
:: concatenation has the input array's multiplicities and length. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, PBOOLE, PRE_POLY, FINSET_1, CLASSES1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5, PBOOLE,
    PRE_POLY, FINSET_1, CLASSES1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, PRE_POLY, FINSET_1, CLASSES1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being FinSequence of INT st
    0 < len a
  holds
    0 < len a &
    (for list1,seq1 being FinSequence of INT st
       seq1 = Rev list1
     holds
       (seq1.1 = 0 &
        seq1.(len seq1) = len a &
        2 <= len list1 &
        (for z being Integer st z in rng list1
         holds 0 <= z & z <= len a) &
        (for k being Integer st
           0 <= k & k < len seq1 - 1
         holds
           (for z1,z2 being Integer st
              seq1.(k+1) <= z1 & z1 < z2 &
              z2 < seq1.(k+2)
            holds a.(z1+1) < a.(z2+1)) or
           (for z1,z2 being Integer st
              seq1.(k+1) <= z1 & z1 < z2 &
              z2 < seq1.(k+2)
            holds a.(z2+1) <= a.(z1+1))) &
        (for i,j being Integer st
           0 <= i & i < j & j < len seq1
         holds seq1.(i+1) <= seq1.(j+1)))
       implies
         ((0 < len list1 &
           (for x,y being Integer st
              0 <= x & x < y & y < len seq1
            holds seq1.(x+1) <= seq1.(y+1)) &
           (for z being Integer st z in rng list1
            holds 0 <= z & z <= len a) &
           (for k being Integer st
              0 <= k & k < len seq1 - 1
            holds
              (for z1,z2 being Integer st
                 seq1.(k+1) <= z1 & z1 < z2 &
                 z2 < seq1.(k+2)
               holds a.(z1+1) < a.(z2+1)) or
              (for z1,z2 being Integer st
                 seq1.(k+1) <= z1 & z1 < z2 &
                 z2 < seq1.(k+2)
               holds a.(z2+1) <= a.(z1+1)))) &
          (for o2 being FinSequence of INT* st
             (for l being FinSequence of INT st l in rng o2
              holds
                for i,j being Nat st
                  i in dom l & j in dom l & i < j
                holds l/.i <= l/.j) &
             (for x being Integer holds
                card {q where q is Integer :
                  0 <= q & q < len (FlattenSeq o2) &
                  (FlattenSeq o2).(q+1) = x} =
                card {q where q is Integer :
                  seq1.1 <= q & q < seq1.(len seq1) &
                  a.(q+1) = x})
           holds
             (for l being FinSequence of INT st l in rng o2
              holds
                for i,j being Nat st
                  i in dom l & j in dom l & i < j
                holds l/.i <= l/.j) &
             (for res being FinSequence of INT st
                (for i,j being Nat st
                   i in dom res & j in dom res & i < j
                 holds res/.i <= res/.j) &
                res,FlattenSeq o2 are_fiberwise_equipotent
              holds
                (for i,j being Nat st
                   i in dom res & j in dom res & i < j
                 holds res/.i <= res/.j) &
                (for x being Integer holds
                   card {q where q is Integer :
                     0 <= q & q < len a & a.(q+1) = x} =
                   card {q where q is Integer :
                     0 <= q & q < len res & res.(q+1) = x}) &
                len res = len a))))
proof
end;
::$P+
