:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/linked_list_rev_Termination_list_reversalqtvc: the linked-list
:: reversal termination verification condition preserves its finite-memory
:: rank invariant through a pointer and rank update. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being non empty set,
      null being Element of L,
      mem1 being Function of L,L,
      ValidCells being Subset of [:Funcs(INT,L),INT:],
      InsideMemory being
        Subset of [:Funcs(INT,L),[:INT,L:]:],
      FiniteMemory being
        Subset of [:Funcs(L,L),[:Funcs(INT,L),INT:]:],
      Seen being Function of
        [:[:Funcs(INT,L),Funcs(L,INT):],[:INT,INT:]:],INT,
      o1 being Function of L,INT
  st
    (for s being Function of INT,L, n being Integer holds
       ([s,n] in ValidCells iff
         (for i being Integer st 0 <= i & i < n
          holds s.i <> null) &
         (for i,j being Integer st
            0 <= i & i < n & 0 <= j & j < n & i <> j
          holds s.i <> s.j))) &
    (for s being Function of INT,L,
         n being Integer, p being Element of L
     holds
       ([s,[n,p]] in InsideMemory iff
         p = null or
         ex i being Integer st
           0 <= i & i < n & p = s.i)) &
    (for mem being Function of L,L,
         s being Function of INT,L, n being Integer
     holds
       ([mem,[s,n]] in FiniteMemory iff
         for i being Integer st 0 <= i & i < n
         holds [s,[n,mem.(s.i)]] in InsideMemory)) &
    (for s being Function of INT,L,
         idx being Function of L,INT,
         lo,hi,cur,prev,rank being Integer,
         shi being Element of L
     st
       cur = Seen.[[s,idx],[lo,hi]] &
       prev = Seen.[[s,idx],[lo,hi-1]] &
       shi = s.(hi-1) &
       rank = idx.shi
     holds
       (hi <= lo implies cur = 0) &
       (lo < hi & 0 < rank implies cur = 1 + prev) &
       (lo < hi & not 0 < rank implies cur = prev)) &
    (for p being Element of L holds
       (p = null implies o1.p = 0) &
       (p <> null implies o1.p = -1))
  holds
    for s being Function of INT,L,
        n,seenInit being Integer, l being Element of L
    st
      seenInit = Seen.[[s,o1],[0,n]] &
      0 <= n &
      [s,n] in ValidCells &
      [mem1,[s,n]] in FiniteMemory &
      [s,[n,l]] in InsideMemory
    holds
      [s,[n,l]] in InsideMemory &
      [s,[n,null]] in InsideMemory &
      [mem1,[s,n]] in FiniteMemory &
      (0 = seenInit & 0 <= seenInit) &
      (for i,oi being Integer, si being Element of L
       st
         0 <= i & i < n & si = s.i & oi = o1.si
       holds -1 <= oi & oi <= 0) &
      (for p being Element of L holds
         (o1.p = 0 iff p = null)) &
      ((o1.l = -1 implies
          o1.null = 0 &
          (for i,oi,omi being Integer,
               si,mi being Element of L
           st
             0 <= i & i < n &
             si = s.i & mi = mem1.si &
             oi = o1.si & omi = o1.mi
           holds
             0 < oi implies omi = oi - 1)) &
       (o1.l <> -1 implies
          for i,oi,omi being Integer,
              si,mi being Element of L
          st
            0 <= i & i < n &
            si = s.i & mi = mem1.si &
            oi = o1.si & omi = o1.mi
          holds
            0 < oi & oi <= o1.l implies omi = oi - 1)) &
      (for idx being Function of L,INT,
           r,l1 being Element of L,
           mem3 being Function of L,L,
           seen0 being Integer
       st
         seen0 = Seen.[[s,idx],[0,n]] &
         [s,[n,l1]] in InsideMemory &
         [s,[n,r]] in InsideMemory &
         [mem3,[s,n]] in FiniteMemory &
         0 <= seen0 &
         (for i,rank being Integer, si being Element of L
          st
            0 <= i & i < n & si = s.i & rank = idx.si
          holds
            -1 <= rank & rank <= seen0) &
         (for p being Element of L holds
            (idx.p = 0 iff p = null)) &
         ((idx.l1 = -1 implies
             idx.r = seen0 &
             (for i,rank,nextRank being Integer,
                  si,nextSi being Element of L
              st
                0 <= i & i < n &
                si = s.i & nextSi = mem3.si &
                rank = idx.si & nextRank = idx.nextSi
              holds
                0 < rank implies nextRank = rank - 1)) &
          (idx.l1 <> -1 implies
             for i,rank,nextRank being Integer,
                 si,nextSi being Element of L
             st
               0 <= i & i < n &
               si = s.i & nextSi = mem3.si &
               rank = idx.si & nextRank = idx.nextSi
             holds
               0 < rank & rank <= idx.l1 implies
                 nextRank = rank - 1))
       holds
         l1 <> null implies
           ((idx.l1 = -1 implies
               ([s,n] in ValidCells &
                [s,[n,l1]] in InsideMemory &
                l1 <> null &
                idx.l1 = -1 &
                0 <= seen0) &
               (for seen1,rankAtMem being Integer
                st
                  seen1 =
                    Seen.[[s,idx+*(l1,seen0+1)],[0,n]] &
                  rankAtMem =
                    (idx+*(l1,seen0+1)).(mem3.l1)
                holds
                  seen1 = 1 + seen0 implies
                    l1 <> null &
                    l1 <> null &
                    ((0 <= n - seen0 &
                      n - (seen0+1) < n - seen0) or
                     (n - seen0 = n - (seen0+1) &
                      0 <= 1 + idx.l1 &
                      1 + rankAtMem < 1 + idx.l1)) &
                    [s,[n,mem3.l1]] in InsideMemory &
                    [s,[n,l1]] in InsideMemory &
                    [mem3+*(l1,r),[s,n]] in FiniteMemory &
                    (seen0+1 = seen1 & 0 <= seen1) &
                    (for i,newRank being Integer,
                         si being Element of L
                     st
                       0 <= i & i < n & si = s.i &
                       newRank = (idx+*(l1,seen0+1)).si
                     holds
                       -1 <= newRank & newRank <= seen0+1) &
                    (for p being Element of L holds
                       ((idx+*(l1,seen0+1)).p = 0
                          iff p = null)) &
                    ((rankAtMem = -1
                       implies
                         (idx+*(l1,seen0+1)).l1 = seen0+1 &
                         (for i,newRank,nextRank being Integer,
                              si,nextSi being Element of L
                          st
                            0 <= i & i < n &
                            si = s.i &
                            nextSi = (mem3+*(l1,r)).si &
                            newRank = (idx+*(l1,seen0+1)).si &
                            nextRank =
                              (idx+*(l1,seen0+1)).nextSi
                          holds
                            0 < newRank implies
                              nextRank = newRank-1)) &
                     (rankAtMem <> -1
                       implies
                         for i,newRank,nextRank being Integer,
                             si,nextSi being Element of L
                         st
                           0 <= i & i < n &
                           si = s.i &
                           nextSi = (mem3+*(l1,r)).si &
                           newRank = (idx+*(l1,seen0+1)).si &
                           nextRank =
                             (idx+*(l1,seen0+1)).nextSi
                         holds
                           0 < newRank &
                           newRank <= rankAtMem
                           implies
                             nextRank = newRank-1)))) &
            (idx.l1 <> -1 implies
               l1 <> null &
               l1 <> null &
               ((0 <= n - seen0 &
                 n - seen0 < n - seen0) or
                (0 <= 1 + idx.l1 &
                 1 + idx.(mem3.l1) < 1 + idx.l1)) &
               [s,[n,mem3.l1]] in InsideMemory &
               [s,[n,l1]] in InsideMemory &
               [mem3+*(l1,r),[s,n]] in FiniteMemory &
               0 <= seen0 &
               (for i,rank being Integer, si being Element of L
                st
                  0 <= i & i < n &
                  si = s.i & rank = idx.si
                holds
                  -1 <= rank & rank <= seen0) &
               (for p being Element of L holds
                  (idx.p = 0 iff p = null)) &
               ((idx.(mem3.l1) = -1 implies
                   idx.l1 = seen0 &
                   (for i,rank,nextRank being Integer,
                        si,nextSi being Element of L
                    st
                      0 <= i & i < n &
                      si = s.i &
                      nextSi = (mem3+*(l1,r)).si &
                      rank = idx.si & nextRank = idx.nextSi
                    holds
                      0 < rank implies nextRank = rank-1)) &
                (idx.(mem3.l1) <> -1 implies
                   for i,rank,nextRank being Integer,
                       si,nextSi being Element of L
                   st
                     0 <= i & i < n &
                     si = s.i &
                     nextSi = (mem3+*(l1,r)).si &
                     rank = idx.si & nextRank = idx.nextSi
                   holds
                     0 < rank & rank <= idx.(mem3.l1)
                     implies nextRank = rank-1)))))
proof
end;
::$P+
