:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_shearsort_modified_Top_shearsortqtvc: the modified
:: ShearSort verification condition for alternating snake-ordered row sorts
:: and sorted column passes, preserving multiplicities while inversions
:: decrease. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSET_1, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSET_1, MARGREL1, XBOOLEAN, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Matrix being non empty set,
      rows,columns being Function of Matrix,INT,
      entry being Function of [:Matrix,[:INT,INT:]:],INT,
      Mocc being Function of [:Matrix,INT:],INT,
      Inv being Function of Matrix,INT,
      SnakeLt,OccPres,SortedRow,SortedColumn,RowsBefore,
      ColumnsBefore,SnakeOrder,SquareOrder,AllEqual,RowFrame,
      ColumnFrame,ColumnEqual,RowPost,RowUpdated,AllRowResults,
      RowState,RowIndex,AllRowIndices,RowExit,AllRowStates,
      ColumnPost,ColumnUpdated,AllColumnFlags,AllColumnResults,
      ColumnState,ColumnIndex,AllColumnIndices,ColumnExitState,
      ColumnExitResult,AllColumnStates,ColumnPhase being set
  st
    (for a being Element of Matrix holds
       0 <= rows.a & 0 <= columns.a) &

    (for i,j,k,l being Integer holds
       ([i,[j,[k,l]]] in SnakeLt iff
         i < k or
         (i = k &
          ((i mod 2 = 0 & j < l) or
           (i mod 2 <> 0 & l < j))))) &

    (for a being Element of Matrix, x being Integer holds
       Mocc.[a,x] =
         card {[i,j] where i,j are Integer :
           0 <= i & i < rows.a &
           0 <= j & j < columns.a &
           entry/.[a,[i,j]] = x}) &

    (for a being Element of Matrix holds
       Inv.a =
         card {[i,[j,[k,l]]] where i,j,k,l are Integer :
           0 <= i & i < rows.a &
           0 <= j & j < columns.a &
           0 <= k & k < rows.a &
           0 <= l & l < columns.a &
           [i,[j,[k,l]]] in SnakeLt &
           entry/.[a,[k,l]] < entry/.[a,[i,j]]}) &

    (for a,b being Element of Matrix holds
       ([a,b] in OccPres iff
         for x being Integer holds Mocc.[a,x] = Mocc.[b,x])) &

    (for a being Element of Matrix, row being Integer,
         ascending being Element of BOOLEAN
     holds
       ([a,[row,ascending]] in SortedRow iff
         0 <= row & row < rows.a &
         ((ascending = TRUE &
           for j,l being Integer st
             0 <= j & j <= l & l < columns.a
           holds entry/.[a,[row,j]] <= entry/.[a,[row,l]]) or
          (ascending <> TRUE &
           for j,l being Integer st
             0 <= j & j <= l & l < columns.a
           holds entry/.[a,[row,l]] <= entry/.[a,[row,j]])))) &

    (for a being Element of Matrix, col being Integer holds
       ([a,col] in SortedColumn iff
         0 <= col & col < columns.a &
         for i,k being Integer st
           0 <= i & i <= k & k < rows.a
         holds entry/.[a,[i,col]] <= entry/.[a,[k,col]])) &

    (for a being Element of Matrix, u being Integer holds
       ([a,u] in RowsBefore iff
         for k being Integer st 0 <= k & k < u
         holds
           ((k mod 2 = 0 &
             [a,[k,TRUE]] in SortedRow) or
            (k mod 2 <> 0 &
             [a,[k,FALSE]] in SortedRow)))) &

    (for a being Element of Matrix, u being Integer holds
       ([a,u] in ColumnsBefore iff
         for l being Integer st 0 <= l & l < u
         holds [a,l] in SortedColumn)) &

    (for a being Element of Matrix holds
       (a in SnakeOrder iff
         for i,j,k,l being Integer st
           0 <= i & i < rows.a
         holds
           (0 <= j & j < columns.a implies
             (0 <= k & k < rows.a implies
               (0 <= l & l < columns.a implies
                 ([i,[j,[k,l]]] in SnakeLt implies
                   entry/.[a,[i,j]] <= entry/.[a,[k,l]])))))) &

    (for a being Element of Matrix, bound being Integer holds
       ([a,bound] in SquareOrder iff
         for i,j,k,l being Integer st
           0 <= i & i < bound &
           0 <= j & j < bound &
           0 <= k & k < bound &
           0 <= l & l < bound &
           [i,[j,[k,l]]] in SnakeLt
         holds entry/.[a,[i,j]] <= entry/.[a,[k,l]])) &

    (for a,b being Element of Matrix holds
       ([a,b] in AllEqual iff
         for i,j being Integer st
           0 <= i & i < rows.a &
           0 <= j & j < columns.a
         holds entry/.[a,[i,j]] = entry/.[b,[i,j]])) &

    (for a,b being Element of Matrix, row being Integer holds
       ([a,[b,row]] in RowFrame iff
         for i,j being Integer st
           0 <= i & i < rows.a &
           0 <= j & j < columns.a & i <> row
         holds entry/.[a,[i,j]] = entry/.[b,[i,j]])) &

    (for a,b being Element of Matrix, col being Integer holds
       ([a,[b,col]] in ColumnFrame iff
         for i,j being Integer st
           0 <= i & i < rows.a &
           0 <= j & j < columns.a & j <> col
         holds entry/.[a,[i,j]] = entry/.[b,[i,j]])) &

    (for a,b being Element of Matrix, col being Integer holds
       ([a,[b,col]] in ColumnEqual iff
         for i being Integer st 0 <= i & i < rows.a
         holds entry/.[a,[i,col]] = entry/.[b,[i,col]])) &

    (for after,before being Element of Matrix, i being Integer holds
       ([after,[before,i]] in RowPost iff
         [after,[before,i]] in RowFrame &
         [after,before] in OccPres &
         ((i mod 2 = 0 &
           [after,[i,TRUE]] in SortedRow) or
          (i mod 2 <> 0 &
           [after,[i,FALSE]] in SortedRow)) &
         Inv.after <= Inv.before)) &

    (for original,base,after being Element of Matrix,
         next being Integer
     holds
       ([original,[base,[after,next]]] in RowUpdated iff
         [after,next] in RowsBefore &
         [after,original] in OccPres &
         Inv.after <= Inv.base)) &

    (for original,base,before being Element of Matrix,
         i being Integer
     holds
       ([original,[base,[before,i]]] in AllRowResults iff
         for after being Element of Matrix st
           rows.after = rows.before &
           columns.after = columns.before &
           [after,[before,i]] in RowPost
         holds
           [original,[base,[after,i+1]]] in RowUpdated)) &

    (for original,base,current being Element of Matrix,
         i,last being Integer
     holds
       ([original,[base,[current,[i,last]]]] in RowState iff
         0 <= i & i <= last &
         [current,i] in RowsBefore &
         [current,original] in OccPres &
         Inv.current <= Inv.base)) &

    (for original,base,current being Element of Matrix,
         i being Integer
     holds
       ([original,[base,[current,i]]] in RowIndex iff
         2 <> 0 &
         0 <= i & i < rows.current &
         [original,[base,[current,i]]] in AllRowResults)) &

    (for original,base,current being Element of Matrix,
         last being Integer
     holds
       ([original,[base,[current,last]]] in AllRowIndices iff
         for i being Integer st
           [original,[base,[current,[i,last]]]] in RowState
         holds [original,[base,[current,i]]] in RowIndex)) &

    (for original,base,current being Element of Matrix,
         u being Integer
     holds
       ([original,[base,[current,u]]] in RowExit iff
         [current,u] in RowsBefore &
         [current,original] in OccPres &
         Inv.current <= Inv.base)) &

    (for original,base being Element of Matrix, last being Integer holds
       ([original,[base,last]] in AllRowStates iff
         for current being Element of Matrix st
           rows.current = rows.base &
           columns.current = columns.base
         holds
           [original,[base,[current,last]]] in AllRowIndices &
           ([original,[base,[current,last+1]]] in RowExit implies
             [original,[base,current]] in ColumnPhase))) &

    (for after,before being Element of Matrix, j being Integer,
         nch being Element of BOOLEAN
     holds
       ([after,[before,[j,nch]]] in ColumnPost iff
         [after,[before,j]] in ColumnFrame &
         [after,before] in OccPres &
         (nch = TRUE implies [after,[before,j]] in ColumnEqual) &
         [after,j] in SortedColumn &
         Inv.after <= Inv.before &
         (nch <> TRUE implies Inv.after < Inv.before))) &

    (for original,base,after being Element of Matrix,
         newchange being Element of BOOLEAN, next being Integer
     holds
       ([original,[base,[after,[newchange,next]]]]
          in ColumnUpdated iff
         (newchange = TRUE implies [after,base] in AllEqual) &
         [after,next] in ColumnsBefore &
         [after,original] in OccPres &
         Inv.after <= Inv.base &
         (newchange <> TRUE implies Inv.after < Inv.base))) &

    (for original,base,before,after being Element of Matrix,
         j being Integer, nochange being Element of BOOLEAN
     holds
       ([original,[base,[before,[after,[j,nochange]]]]]
          in AllColumnFlags iff
         for nch being Element of BOOLEAN st
           [after,[before,[j,nch]]] in ColumnPost
         holds
           ((nch <> TRUE &
             [original,[base,[after,[FALSE,j+1]]]]
               in ColumnUpdated) or
            (nch = TRUE &
             [original,[base,[after,[nochange,j+1]]]]
               in ColumnUpdated)))) &

    (for original,base,before being Element of Matrix,
         j being Integer, nochange being Element of BOOLEAN
     holds
       ([original,[base,[before,[j,nochange]]]]
          in AllColumnResults iff
         for after being Element of Matrix st
           rows.after = rows.before &
           columns.after = columns.before
         holds
           [original,[base,[before,[after,[j,nochange]]]]]
             in AllColumnFlags)) &

    (for original,base,current being Element of Matrix,
         nochange being Element of BOOLEAN, j,last being Integer
     holds
       ([original,[base,[current,[nochange,[j,last]]]]]
          in ColumnState iff
         0 <= j & j <= last &
         (nochange = TRUE implies [current,base] in AllEqual) &
         [current,j] in ColumnsBefore &
         [current,original] in OccPres &
         Inv.current <= Inv.base &
         (nochange <> TRUE implies Inv.current < Inv.base))) &

    (for original,base,current being Element of Matrix,
         nochange being Element of BOOLEAN, j being Integer
     holds
       ([original,[base,[current,[nochange,j]]]]
          in ColumnIndex iff
         0 <= j & j < columns.current &
         [original,[base,[current,[j,nochange]]]]
           in AllColumnResults)) &

    (for original,base,current being Element of Matrix,
         nochange being Element of BOOLEAN, last being Integer
     holds
       ([original,[base,[current,[nochange,last]]]]
          in AllColumnIndices iff
         for j being Integer st
           [original,[base,[current,[nochange,[j,last]]]]]
             in ColumnState
         holds
           [original,[base,[current,[nochange,j]]]]
             in ColumnIndex)) &

    (for original,base,current being Element of Matrix,
         nochange being Element of BOOLEAN, u being Integer
     holds
       ([original,[base,[current,[nochange,u]]]]
          in ColumnExitState iff
         (nochange = TRUE implies [current,base] in AllEqual) &
         [current,u] in ColumnsBefore &
         [current,original] in OccPres &
         Inv.current <= Inv.base &
         (nochange <> TRUE implies Inv.current < Inv.base))) &

    (for original,outer,current being Element of Matrix,
         nochange being Element of BOOLEAN
     holds
       ([original,[outer,[current,nochange]]]
          in ColumnExitResult iff
         ((nochange = TRUE &
           [current,columns.original] in SquareOrder &
           current in SnakeOrder &
           [current,original] in OccPres) or
          (nochange <> TRUE &
           0 <= Inv.outer & Inv.current < Inv.outer &
           [current,original] in OccPres)))) &

    (for original,outer,base being Element of Matrix,
         last being Integer
     holds
       ([original,[outer,[base,last]]] in AllColumnStates iff
         for nochange being Element of BOOLEAN,
             current being Element of Matrix st
           rows.current = rows.base &
           columns.current = columns.base
         holds
           [original,[base,[current,[nochange,last]]]]
             in AllColumnIndices &
           ([original,[base,[current,[nochange,last+1]]]]
              in ColumnExitState implies
             [original,[outer,[current,nochange]]]
               in ColumnExitResult))) &

    (for original,outer,base being Element of Matrix holds
       ([original,[outer,base]] in ColumnPhase iff
         ((0 <= (columns.original-1)+1 implies
           [base,0] in ColumnsBefore &
           [base,original] in OccPres &
           Inv.base <= Inv.base &
           [original,[outer,[base,columns.original-1]]]
             in AllColumnStates) &
          ((columns.original-1)+1 < 0 implies
           [base,columns.original] in SquareOrder &
           base in SnakeOrder &
           [base,original] in OccPres))))
  holds
    for m,m1 being Element of Matrix st
      rows.m = columns.m &
      rows.m1 = rows.m &
      columns.m1 = columns.m &
      [m1,m] in OccPres
    holds
      (0 <= (columns.m-1)+1 implies
        [m1,0] in RowsBefore &
        [m1,m] in OccPres &
        Inv.m1 <= Inv.m1 &
        [m,[m1,columns.m-1]] in AllRowStates) &
      ((columns.m-1)+1 < 0 implies
        [m,[m1,m1]] in ColumnPhase)
proof
end;
::$P+
