:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_lexicographic_permutations_1_Top_swapqtvc: the
:: integer-array swap verification condition exchanges two valid entries in
:: an arbitrary integer-indexed array map, preserves every other valid entry,
:: and preserves all multiplicities after conversion to a finite sequence.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS,
    NAT_1, INT_1, INT_2, FINSEQ_1, FINSEQ_2, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, ORDINAL4, XCMPLX_0, XREAL_0, XXREAL_0,
    MCART_1, XTUPLE_0, FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2,
    RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1, FINSEQ_2,
    FUNCT_4, FUNCT_7, FINSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCT_7, CARD_1, NUMBERS, NAT_1, NAT_D, INT_1,
    INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, XXREAL_0, XTUPLE_0,
    MCART_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0,
    XTUPLE_0, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ToSeq being Function of [:Funcs(INT,INT),NAT:],INT*,
      Permuting being Subset of [:INT*,INT*:]
  st
    (for f being Function of INT,INT, n being Nat holds
      len (ToSeq.[f,n]) = n &
      for k being Nat st k < n
      holds
        (ToSeq.[f,n]).(k+1) = f.k) &
    (for p,q being FinSequence of INT holds
      ([p,q] in Permuting iff
        len p = len q &
        for x being Integer holds
          card {k where k is Nat :
            k < len p & p.(k+1) = x} =
          card {k where k is Nat :
            k < len q & q.(k+1) = x}))
  holds
    for n being Nat, i being Integer,
        a being Function of INT,INT,
        j being Integer st
      0 <= i & i < n & 0 <= j & j < n
    holds
      0 <= i & i < n &
      (for temp being Integer st
        temp = a.i
      holds
        (0 <= j & j < n) &
        (for o1 being Integer st
          o1 = a.j
        holds
          (0 <= i & i < n) &
          (for afterI being Function of INT,INT st
            afterI = a+*(i,o1)
          holds
            n = n implies
            (afterI = a+*(i,o1) implies
              (0 <= j & j < n) &
              (for swapped being Function of INT,INT st
                swapped = afterI+*(j,temp)
              holds
                n = n implies
                (swapped = afterI+*(j,temp) implies
                  swapped.i = a.j &
                  swapped.j = a.i &
                  (for k being Integer st
                    0 <= k & k < n &
                    k <> i & k <> j
                   holds
                    swapped.k = a.k) &
                  [ToSeq.[swapped,n],ToSeq.[a,n]]
                    in Permuting))))))
proof
end;
::$P+
