:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/defunctionalization_ReductionSemantics_itere_optqtvc: the
:: reduction-semantics iteration verification condition for subtraction
:: expressions, preserving direct evaluation through context recomposition
:: and characterizing the empty-context value result. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Expr,Context being non empty set,
      cte being Function of INT,Expr,
      sube being Function of [:Expr,Expr:],Expr,
      emptyCtx being Element of Context,
      leftCtx being Function of [:Context,Expr:],Context,
      rightCtx being Function of [:INT,Context:],Context,
      eval0 being Function of Expr,INT,
      recompose being Function of [:Context,Expr:],Expr,
      RedexExprs,ValueExprs being Subset of Expr,
      EmptyContexts being Subset of Context,
      c1 being Element of Context,
      e being Element of Expr
  st
    (for x,y being Integer st cte.x = cte.y holds x = y) &
    (for e1,e2,f1,f2 being Element of Expr st
       sube.[e1,e2] = sube.[f1,f2]
     holds e1 = f1 & e2 = f2) &
    (for x being Integer, e1,e2 being Element of Expr
     holds cte.x <> sube.[e1,e2]) &
    (for e0 being Element of Expr holds
       (ex x being Integer st e0 = cte.x) or
       ex e1,e2 being Element of Expr st e0 = sube.[e1,e2]) &
    (for X being Subset of Expr st
       (for x being Integer holds cte.x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds sube.[e1,e2] in X)
     holds X = Expr) &
    (for c2,c3 being Element of Context,
         e1,e2 being Element of Expr st
       leftCtx.[c2,e1] = leftCtx.[c3,e2]
     holds c2 = c3 & e1 = e2) &
    (for x1,x2 being Integer, c2,c3 being Element of Context st
       rightCtx.[x1,c2] = rightCtx.[x2,c3]
     holds x1 = x2 & c2 = c3) &
    (for c2,c3 being Element of Context, e0 being Element of Expr,
         x being Integer
     holds leftCtx.[c2,e0] <> rightCtx.[x,c3]) &
    (for c2 being Element of Context, e0 being Element of Expr
     holds leftCtx.[c2,e0] <> emptyCtx) &
    (for x being Integer, c2 being Element of Context
     holds rightCtx.[x,c2] <> emptyCtx) &
    (for c0 being Element of Context holds
       c0 = emptyCtx or
       (ex c2 being Element of Context, e0 being Element of Expr st
          c0 = leftCtx.[c2,e0]) or
       ex x being Integer, c2 being Element of Context st
          c0 = rightCtx.[x,c2]) &
    (for K being Subset of Context st
       emptyCtx in K &
       (for c2 being Element of Context, e0 being Element of Expr
          st c2 in K holds leftCtx.[c2,e0] in K) &
       (for x being Integer, c2 being Element of Context
          st c2 in K holds rightCtx.[x,c2] in K)
     holds K = Context) &
    (for x being Integer holds eval0.(cte.x) = x) &
    (for e1,e2 being Element of Expr holds
       eval0.(sube.[e1,e2]) = eval0.e1 - eval0.e2) &
    (for e0 being Element of Expr holds
       recompose.[emptyCtx,e0] = e0) &
    (for c2 being Element of Context, e1,e2 being Element of Expr holds
       recompose.[leftCtx.[c2,e2],e1] =
         recompose.[c2,sube.[e1,e2]]) &
    (for x being Integer, c2 being Element of Context,
         e0 being Element of Expr holds
       recompose.[rightCtx.[x,c2],e0] =
         recompose.[c2,sube.[cte.x,e0]]) &
    (for e0 being Element of Expr holds
       (e0 in RedexExprs iff
        ex x,y being Integer st e0 = sube.[cte.x,cte.y])) &
    (for e0 being Element of Expr holds
       (e0 in ValueExprs iff ex x being Integer st e0 = cte.x)) &
    (for c0 being Element of Context holds
       (c0 in EmptyContexts iff c0 = emptyCtx))
  holds
    (for c being Element of Context, r being Element of Expr st
       recompose.[c,r] = recompose.[c1,e] &
       r in RedexExprs
     holds
       r in RedexExprs &
       for o1 being Element of Expr st eval0.o1 = eval0.r
       holds
         eval0.(recompose.[c,o1]) =
           eval0.(recompose.[c1,e])) &
    (c1 in EmptyContexts & e in ValueExprs implies
       (ex n being Integer st e = cte.n) &
       for result being Integer st
         ex n being Integer st e = cte.n & result = n
       holds result = eval0.(recompose.[c1,e]))
proof
end;
::$P+
