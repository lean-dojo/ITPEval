:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/there_and_back_again_Palindrome_palindrome_recqtvc: the recursive
:: palindrome verification condition preserves the consumed-prefix result or
:: produces an integer-indexed mismatch witness. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      ORDINAL4, FINSEQ_1, FINSEQ_2, MCART_1, MARGREL1, XBOOLEAN;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1,
      CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
      XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
      REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
      FINSEQ_1, FINSEQ_2, MARGREL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
      VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
      NAT_1, FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 equalities XBOOLEAN;

begin

::$P-
theorem
  for D being non empty set,
      x,y being FinSequence of D,
      Eq being Function of [:D,D:],BOOLEAN,
      NthEq being Subset of [:D*,[:INT,INT:]:] st
    (for a,b being Element of D holds
       (Eq.[a,b] = TRUE iff a = b)) &
    (for s being FinSequence of D,
         i,j being Integer holds
       ([s,[i,j]] in NthEq iff
         ((0 <= i & i < len s &
           0 <= j & j < len s &
           s.(i+1) = s.(j+1)) or
          ((i < 0 or len s <= i) &
           (j < 0 or len s <= j))))) &
    len y <= len x
  holds
    (y = <*>D &
      (ex x0 being FinSequence of D st
         len x0 = len y &
         x = x0 ^ x) &
      (for i being Integer st
         0 <= i & i < len y
       holds
         [x,[i,len y-1-i]] in NthEq))
    or
    (ex y1 being Element of D,
        y2 being FinSequence of D st
       y = <*y1*> ^ y2 &
       ((y2 = <*>D &
         (ex x3 being Element of D,
             x4 being FinSequence of D st
            x = <*x3*> ^ x4 &
            (ex x0 being FinSequence of D st
               len x0 = len y &
               x = x0 ^ x4) &
            (for i being Integer st
               0 <= i & i < len y
             holds
               [x,[i,len y-1-i]] in NthEq)))
        or
        (ex y3 being Element of D,
            y4 being FinSequence of D st
           y2 = <*y3*> ^ y4 &
           (ex x5 being Element of D,
               x6 being FinSequence of D st
              x = <*x5*> ^ x6 &
              len y4 <= len x6 &
              (for o1 being FinSequence of D st
                 (ex x0 being FinSequence of D st
                    len x0 = len y4 &
                    x6 = x0 ^ o1) &
                 (for i being Integer st
                    0 <= i & i < len y4
                  holds
                    [x6,[i,len y4-1-i]] in NthEq)
               holds
                 ex x11 being Element of D,
                    xs being FinSequence of D st
                   o1 = <*x11*> ^ xs &
                   ((Eq.[x5,x11] = TRUE iff x5 = x11)
                    implies
                     ((Eq.[x5,x11] = TRUE implies
                        (ex x0 being FinSequence of D st
                           len x0 = len y &
                           x = x0 ^ xs) &
                        (for i being Integer st
                           0 <= i & i < len y
                         holds
                           [x,[i,len y-1-i]] in NthEq)) &
                      (Eq.[x5,x11] <> TRUE implies
                        ex i being Integer st
                          0 <= i & i < len y &
                          not [x,[i,len y-1-i]] in NthEq)))) &
              ((ex i being Integer st
                  0 <= i & i < len y4 &
                  not [x6,[i,len y4-1-i]] in NthEq)
               implies
                ex i being Integer st
                  0 <= i & i < len y &
                  not [x,[i,len y-1-i]] in NthEq)))))
proof
end;
::$P+
