:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/vstte12_tree_reconstruction_TreeReconstruction_build_recqtvc: the
:: recursive binary-tree reconstruction verification condition preserves
:: leaf-depth decompositions and propagates failure across recursive calls.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Tree being non empty set,
      leafT being Element of Tree,
      node being Function of [:Tree,Tree:],Tree,
      Depths being Function of [:INT,Tree:],INT*,
      Head being Function of INT*,INT,
      s being FinSequence of INT,
      d being Integer
  st
    (for l,r being Element of Tree holds
       node.[l,r] <> leafT) &
    (for u being Element of Tree holds
       u = leafT or
       ex l,r being Element of Tree st
         u = node.[l,r]) &
    (for l,l2,r,r2 being Element of Tree st
       node.[l,r] = node.[l2,r2]
     holds
       l = l2 & r = r2) &
    (for X being Subset of Tree st
       leafT in X &
       (for l,r being Element of Tree st
          l in X & r in X
        holds
          node.[l,r] in X)
     holds
       X = Tree) &
    (for e being Integer holds
       Depths.[e,leafT] = <*e*>) &
    (for e being Integer,
         l,r being Element of Tree
     holds
       Depths.[e,node.[l,r]] =
         Depths.[e+1,l] ^ Depths.[e+1,r]) &
    Head.(<*>(INT)) = 0 &
    (for h being Integer,
         t being FinSequence of INT
     holds
       Head.(<*h*> ^ t) = h)
  holds
    (s = <*>(INT) implies
       for tr being Element of Tree,
           rest being FinSequence of INT
       holds
         Depths.[d,tr] ^ rest <> s) &
    (for h being Integer,
         t being FinSequence of INT st
       s = <*h*> ^ t
     holds
       (h < d implies
          for tr being Element of Tree,
              rest being FinSequence of INT
          holds
            Depths.[d,tr] ^ rest <> s) &
       (h = d implies
          s = Depths.[d,leafT] ^ t) &
       (d < h implies
          (0 <= h-d & h-(d+1) < h-d) &
          (for l being Element of Tree,
               s1 being FinSequence of INT st
             s = Depths.[d+1,l] ^ s1
           holds
             ((0 <= len s & len s1 < len s) or
              (len s = len s1 &
               0 <= h-d &
               ex hs1 being Integer st
                 hs1 = Head.s1 &
                 hs1-(d+1) < h-d)) &
             (for r being Element of Tree,
                  s2 being FinSequence of INT st
                s1 = Depths.[d+1,r] ^ s2
              holds
                s = Depths.[d,node.[l,r]] ^ s2) &
             ((for tr being Element of Tree,
                   rest being FinSequence of INT
               holds
                 Depths.[d+1,tr] ^ rest <> s1)
              implies
                for tr being Element of Tree,
                    rest being FinSequence of INT
                holds
                  Depths.[d,tr] ^ rest <> s)) &
          ((for tr being Element of Tree,
                rest being FinSequence of INT
            holds
              Depths.[d+1,tr] ^ rest <> s)
           implies
             for tr being Element of Tree,
                 rest being FinSequence of INT
             holds
               Depths.[d,tr] ^ rest <> s)))
proof
end;
::$P+
