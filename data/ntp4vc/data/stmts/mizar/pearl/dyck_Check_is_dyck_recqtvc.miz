:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/dyck_Check_is_dyck_recqtvc: the recursive Dyck-word checker
:: verification condition characterizes the unique maximal Dyck prefix and
:: the remaining suffix across the left-parenthesis and fallback branches.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Paren being non empty set,
      L,R being Element of Paren,
      Dyck being Subset of Paren*,
      w being FinSequence of Paren
  st
    L <> R &
    (for q being Element of Paren holds q = L or q = R) &
    <*>Paren in Dyck &
    (for w1,w2 being FinSequence of Paren st
       w1 in Dyck & w2 in Dyck
     holds
       <*L*> ^ w1 ^ <*R*> ^ w2 in Dyck) &
    (for D being Subset of Paren* st
       <*>Paren in D &
       (for w1,w2 being FinSequence of Paren st
          w1 in D & w2 in D
        holds
          <*L*> ^ w1 ^ <*R*> ^ w2 in D)
     holds
       Dyck c= D)
  holds
    (for w0 being FinSequence of Paren st w = <*L*> ^ w0 holds
      (0 <= len w & len w0 < len w) &
      (for p0 being FinSequence of Paren holds
        for o1 being FinSequence of Paren st
          w0 = p0 ^ o1 &
          p0 in Dyck &
          (not ex t being FinSequence of Paren st
             o1 = <*L*> ^ t) &
          (for p2,s being FinSequence of Paren st
             w0 = p2 ^ s &
             p2 in Dyck &
             (not ex t being FinSequence of Paren st
                s = <*L*> ^ t)
           holds
             p2 = p0 & s = o1)
        holds
          ((for q being Element of Paren,
                w1 being FinSequence of Paren st
              o1 = <*q*> ^ w1
            holds
              (0 <= len w & len w1 < len w) &
              (for p1 being FinSequence of Paren holds
                (for w2 being FinSequence of Paren st
                   w1 = p1 ^ w2 &
                   p1 in Dyck &
                   (not ex t being FinSequence of Paren st
                      w2 = <*L*> ^ t) &
                   (for p2,s being FinSequence of Paren st
                      w1 = p2 ^ s &
                      p2 in Dyck &
                      (not ex t being FinSequence of Paren st
                         s = <*L*> ^ t)
                    holds
                      p2 = p1 & s = w2)
                 holds
                   w = <*L*> ^ p0 ^ <*R*> ^ p1 ^ w2 &
                   (<*L*> ^ p0 ^ <*R*> ^ p1) in Dyck &
                   (not ex t being FinSequence of Paren st
                      w2 = <*L*> ^ t) &
                   (for p2,s being FinSequence of Paren st
                      w = p2 ^ s &
                      p2 in Dyck &
                      (not ex t being FinSequence of Paren st
                         s = <*L*> ^ t)
                    holds
                      p2 = <*L*> ^ p0 ^ <*R*> ^ p1 &
                      s = w2)) &
                ((for p,s being FinSequence of Paren st
                    w1 = p ^ s
                  holds
                    not (p in Dyck &
                      (not ex t being FinSequence of Paren st
                         s = <*L*> ^ t)))
                 implies
                  for p,s being FinSequence of Paren st
                    w = p ^ s
                  holds
                    not (p in Dyck &
                      (not ex t being FinSequence of Paren st
                         s = <*L*> ^ t))))) &
           (o1 = <*>Paren implies
              for p,s being FinSequence of Paren st
                w = p ^ s
              holds
                not (p in Dyck &
                  (not ex t being FinSequence of Paren st
                     s = <*L*> ^ t))))) &
      ((for p,s being FinSequence of Paren st
          w0 = p ^ s
        holds
          not (p in Dyck &
            (not ex t being FinSequence of Paren st
               s = <*L*> ^ t)))
       implies
        for p,s being FinSequence of Paren st
          w = p ^ s
        holds
          not (p in Dyck &
            (not ex t being FinSequence of Paren st
               s = <*L*> ^ t)))) &
    ((not ex w0 being FinSequence of Paren st
        w = <*L*> ^ w0)
     implies
       w = (<*>Paren) ^ w &
       <*>Paren in Dyck &
       (not ex t being FinSequence of Paren st
          w = <*L*> ^ t) &
       (for p2,s being FinSequence of Paren st
          w = p2 ^ s &
          p2 in Dyck &
          (not ex t being FinSequence of Paren st
             s = <*L*> ^ t)
        holds
          p2 = <*>Paren & s = w))
proof
end;
::$P+
