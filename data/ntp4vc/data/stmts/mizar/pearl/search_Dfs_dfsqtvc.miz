:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/search_Dfs_dfsqtvc: the depth-first-search verification condition
:: preserves bounded path failure invariants and returns only successful
:: states reachable within the remaining depth. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, FINSEQ_1, FINSEQ_2,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for State being non empty set,
      Moves being Function of State,State*,
      Success being Subset of State,
      Path being Subset of [:State,[:State,INT:]:],
      p,m being Integer,
      s being Element of State
  st
    (for x being Element of State holds
       [x,[x,0]] in Path) &
    (for x being Element of State,
         i being Integer st 0 <= i & i < len (Moves.x)
     holds
       [x,[(Moves.x).(i+1),1]] in Path) &
    (for x,y,z being Element of State,
         n,k being Integer st
       [x,[y,n]] in Path & [y,[z,k]] in Path
     holds
       [x,[z,n+k]] in Path) &
    (for R being Subset of [:State,[:State,INT:]:] st
       (for x being Element of State holds
          [x,[x,0]] in R) &
       (for x being Element of State,
            i being Integer st 0 <= i & i < len (Moves.x)
        holds
          [x,[(Moves.x).(i+1),1]] in R) &
       (for x,y,z being Element of State,
            n,k being Integer st
          [x,[y,n]] in R & [y,[z,k]] in R
        holds
          [x,[z,n+k]] in R)
     holds
       Path c= R) &
    0 <= p & p <= m+1
  holds
    (m < p implies
      for t being Element of State,
          n being Integer st 0 <= n & n <= m-p
      holds
        t in Success implies not [s,[t,n]] in Path) &
    (not m < p & s in Success implies
      [s,[s,0]] in Path & s in Success & 0 <= 0 & 0 <= m-p) &
    (not m < p & not s in Success implies
      ((0 <= (len (Moves.s)-1)+1 implies
        (for j being Integer,
             t being Element of State,
             n being Integer st 0 <= j & j < 0
         holds
           [((Moves.s).(j+1)),[t,n]] in Path &
             t in Success implies not (0 <= n & n < m-p)) &
        (for i being Integer st
           (0 <= i & i <= len (Moves.s)-1) &
           (for j being Integer,
                t being Element of State,
                n being Integer st 0 <= j & j < i
            holds
              [((Moves.s).(j+1)),[t,n]] in Path &
                t in Success implies not (0 <= n & n < m-p))
         holds
           ((0 <= m-p & m-(p+1) < m-p) &
            0 <= p+1 & p+1 <= m+1) &
           (((for t being Element of State,
                  n being Integer st 0 <= n & n <= m-(p+1)
              holds
                t in Success implies
                  not [((Moves.s).(i+1)),[t,n]] in Path)
             implies
              for j being Integer,
                  t being Element of State,
                  n being Integer st 0 <= j & j < i+1
              holds
                [((Moves.s).(j+1)),[t,n]] in Path &
                  t in Success implies not (0 <= n & n < m-p)) &
            (for t being Element of State,
                 n being Integer st
               [((Moves.s).(i+1)),[t,n]] in Path &
               t in Success & 0 <= n & n <= m-(p+1)
             holds
               [s,[t,n+1]] in Path &
               t in Success & 0 <= n+1 & n+1 <= m-p))) &
       ((for j being Integer,
             t being Element of State,
             n being Integer st 0 <= j & j < (len (Moves.s)-1)+1
         holds
           [((Moves.s).(j+1)),[t,n]] in Path &
             t in Success implies not (0 <= n & n < m-p))
        implies
          for t being Element of State,
              n being Integer st 0 <= n & n <= m-p
          holds
            t in Success implies not [s,[t,n]] in Path)) &
       ((len (Moves.s)-1)+1 < 0 implies
          for t being Element of State,
              n being Integer st 0 <= n & n <= m-p
          holds
            t in Success implies not [s,[t,n]] in Path)))
proof
end;
::$P+
