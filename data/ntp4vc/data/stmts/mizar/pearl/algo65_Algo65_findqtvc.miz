:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/algo65_Algo65_findqtvc: the find verification condition composes
:: a partition around 42 with permutation-preserving recursive subrange
:: calls that establish the required ordering around index k.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,k,n,alen being Integer,
      a being Function of INT,INT st
    0 <= alen &
    (for q being Integer st q < 0 holds a.q = a.0) &
    (for q being Integer st alen <= q holds a.q = 0) &
    0 <= m & m <= k & k <= n & n < alen
  holds
    (m < n implies
      (0 <= m & m < n & n < alen) &
      (for j,i being Integer,
           a1 being Function of INT,INT st
        (for q being Integer st q < 0 holds a1.q = a1.0) &
        (for q being Integer st alen <= q holds a1.q = 0) &
        m <= j & j < i & i <= n &
        (for q being Integer st 0 <= q & q < m
          holds a.q = a1.q) &
        (for q being Integer st n + 1 <= q & q < alen
          holds a.q = a1.q) &
        (for v being Integer holds
          card {q where q is Integer :
            m <= q & q < n + 1 & a.q = v} =
          card {q where q is Integer :
            m <= q & q < n + 1 & a1.q = v}) &
        (for r being Integer st m <= r & r <= j
          holds ex x being Integer st x = a1.r & x <= 42) &
        (for r being Integer st j < r & r < i
          holds a1.r = 42) &
        (for r being Integer st i <= r & r <= n
          holds ex x being Integer st x = a1.r & 42 <= x)
      holds
        (k <= j implies
          (0 <= n - m & j - m < n - m) &
          (0 <= m & m <= k & k <= j & j < alen) &
          (for a2 being Function of INT,INT st
            (for q being Integer st q < 0 holds a2.q = a2.0) &
            (for q being Integer st alen <= q holds a2.q = 0) &
            (for q being Integer st 0 <= q & q < m
              holds a1.q = a2.q) &
            (for q being Integer st j + 1 <= q & q < alen
              holds a1.q = a2.q) &
            (for v being Integer holds
              card {q where q is Integer :
                m <= q & q < j + 1 & a1.q = v} =
              card {q where q is Integer :
                m <= q & q < j + 1 & a2.q = v}) &
            (for r being Integer st m <= r & r <= k
              holds ex x,y being Integer st
                x = a2.r & y = a2.k & x <= y) &
            (for r being Integer st k <= r & r <= j
              holds ex x,y being Integer st
                x = a2.k & y = a2.r & x <= y)
          holds
            (i <= k implies
              (0 <= n - m & n - i < n - m) &
              (0 <= i & i <= k & k <= n & n < alen) &
              (for a3 being Function of INT,INT st
                (for q being Integer st q < 0
                  holds a3.q = a3.0) &
                (for q being Integer st alen <= q
                  holds a3.q = 0) &
                (for q being Integer st 0 <= q & q < i
                  holds a2.q = a3.q) &
                (for q being Integer st n + 1 <= q & q < alen
                  holds a2.q = a3.q) &
                (for v being Integer holds
                  card {q where q is Integer :
                    i <= q & q < n + 1 & a2.q = v} =
                  card {q where q is Integer :
                    i <= q & q < n + 1 & a3.q = v}) &
                (for r being Integer st i <= r & r <= k
                  holds ex x,y being Integer st
                    x = a3.r & y = a3.k & x <= y) &
                (for r being Integer st k <= r & r <= n
                  holds ex x,y being Integer st
                    x = a3.k & y = a3.r & x <= y)
              holds
                (for q being Integer st 0 <= q & q < m
                  holds a.q = a3.q) &
                (for q being Integer st n + 1 <= q & q < alen
                  holds a.q = a3.q) &
                (for v being Integer holds
                  card {q where q is Integer :
                    m <= q & q < n + 1 & a.q = v} =
                  card {q where q is Integer :
                    m <= q & q < n + 1 & a3.q = v}) &
                (for r being Integer st m <= r & r <= k
                  holds ex x,y being Integer st
                    x = a3.r & y = a3.k & x <= y) &
                (for r being Integer st k <= r & r <= n
                  holds ex x,y being Integer st
                    x = a3.k & y = a3.r & x <= y)) &
            (not i <= k implies
              (for q being Integer st 0 <= q & q < m
                holds a.q = a2.q) &
              (for q being Integer st n + 1 <= q & q < alen
                holds a.q = a2.q) &
              (for v being Integer holds
                card {q where q is Integer :
                  m <= q & q < n + 1 & a.q = v} =
                card {q where q is Integer :
                  m <= q & q < n + 1 & a2.q = v}) &
              (for r being Integer st m <= r & r <= k
                holds ex x,y being Integer st
                  x = a2.r & y = a2.k & x <= y) &
              (for r being Integer st k <= r & r <= n
                holds ex x,y being Integer st
                  x = a2.k & y = a2.r & x <= y))) ) &
        (not k <= j implies
          (i <= k implies
            (0 <= n - m & n - i < n - m) &
            (0 <= i & i <= k & k <= n & n < alen) &
            (for a2 being Function of INT,INT st
              (for q being Integer st q < 0 holds a2.q = a2.0) &
              (for q being Integer st alen <= q holds a2.q = 0) &
              (for q being Integer st 0 <= q & q < i
                holds a1.q = a2.q) &
              (for q being Integer st n + 1 <= q & q < alen
                holds a1.q = a2.q) &
              (for v being Integer holds
                card {q where q is Integer :
                  i <= q & q < n + 1 & a1.q = v} =
                card {q where q is Integer :
                  i <= q & q < n + 1 & a2.q = v}) &
              (for r being Integer st i <= r & r <= k
                holds ex x,y being Integer st
                  x = a2.r & y = a2.k & x <= y) &
              (for r being Integer st k <= r & r <= n
                holds ex x,y being Integer st
                  x = a2.k & y = a2.r & x <= y)
            holds
              (for q being Integer st 0 <= q & q < m
                holds a.q = a2.q) &
              (for q being Integer st n + 1 <= q & q < alen
                holds a.q = a2.q) &
              (for v being Integer holds
                card {q where q is Integer :
                  m <= q & q < n + 1 & a.q = v} =
                card {q where q is Integer :
                  m <= q & q < n + 1 & a2.q = v}) &
              (for r being Integer st m <= r & r <= k
                holds ex x,y being Integer st
                  x = a2.r & y = a2.k & x <= y) &
              (for r being Integer st k <= r & r <= n
                holds ex x,y being Integer st
                  x = a2.k & y = a2.r & x <= y))) &
          (not i <= k implies
            (for q being Integer st 0 <= q & q < m
              holds a.q = a1.q) &
            (for q being Integer st n + 1 <= q & q < alen
              holds a.q = a1.q) &
            (for v being Integer holds
              card {q where q is Integer :
                m <= q & q < n + 1 & a.q = v} =
              card {q where q is Integer :
                m <= q & q < n + 1 & a1.q = v}) &
            (for r being Integer st m <= r & r <= k
              holds ex x,y being Integer st
                x = a1.r & y = a1.k & x <= y) &
            (for r being Integer st k <= r & r <= n
              holds ex x,y being Integer st
                x = a1.k & y = a1.r & x <= y)))))
    ) &
    (not m < n implies
      (for q being Integer st 0 <= q & q < m
        holds a.q = a.q) &
      (for q being Integer st n + 1 <= q & q < alen
        holds a.q = a.q) &
      (for v being Integer holds
        card {q where q is Integer :
          m <= q & q < n + 1 & a.q = v} =
        card {q where q is Integer :
          m <= q & q < n + 1 & a.q = v}) &
      (for r being Integer st m <= r & r <= k
        holds ex x,y being Integer st
          x = a.r & y = a.k & x <= y) &
      (for r being Integer st k <= r & r <= n
        holds ex x,y being Integer st
          x = a.k & y = a.r & x <= y))
proof
end;
::$P+
