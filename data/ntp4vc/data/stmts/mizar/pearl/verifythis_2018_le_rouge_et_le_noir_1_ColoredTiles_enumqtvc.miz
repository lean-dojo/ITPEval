:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2018_le_rouge_et_le_noir_1_ColoredTiles_enumqtvc: the
:: verification condition for enumerating valid red-and-black tile colorings
:: of lengths through 50 by finite-set dynamic programming. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, FINSEQ_5, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for C,Coloring,ColorSets being non empty set,
      Red,Black,Default being Element of C,
      Nth being Function of [:C*,INT:],C,
      FirstBlack being Function of C*,INT,
      AddLeft,AddLeftClosure being Function of [:INT,C*:],C*,
      Create being Function of [:INT,Funcs(INT,C):],C*,
      MapAdd being Function of [:ColorSets,INT:],ColorSets,
      CardSet being Function of ColorSets,INT,
      TwoRed being Subset of [:C*,INT:],
      Valid being Subset of C*,
      PrefixInv being Subset of
        [:Funcs(INT,ColorSets),[:Funcs(INT,INT),INT:]:],
      BucketInv,InnerStep being Subset of
        [:Funcs(INT,ColorSets),
          [:Funcs(INT,INT),[:INT,INT:]:]:],
      Final,Initialized,Initialization being Subset of
        [:Funcs(INT,ColorSets),Funcs(INT,INT):],
      AddRed being Subset of
        [:Funcs(INT,C),
          [:Funcs(INT,ColorSets),[:Funcs(INT,INT),INT:]:]:],
      OuterStep being Subset of
        [:Funcs(INT,ColorSets),[:Funcs(INT,INT),INT:]:],
      fc,fc1,fc2,fc3,fc4,fc5,fc6 being Function of INT,C
  st
    C = {Red,Black} & Red <> Black & Coloring = C* &
    (for s being set holds
       (s in ColorSets iff s c= Coloring & s is finite)) &
    (for c being FinSequence of C, i being Integer holds
       (i < 0 & len c = 0 implies Nth/.[c,i] = Default) &
       (i < 0 & 0 < len c implies Nth/.[c,i] = c.1) &
       (0 <= i & i < len c implies Nth/.[c,i] = c.(i+1)) &
       (len c <= i implies Nth/.[c,i] = Default)) &
    (for c being FinSequence of C holds
       (len c = 0 implies FirstBlack/.c = 0) &
       (for h being Element of C, t being FinSequence of C st
          c = <*h*> ^ t
        holds
          (h = Black implies FirstBlack/.c = 0) &
          (h <> Black implies
            FirstBlack/.c = 1 + FirstBlack/.t))) &
    (for c being FinSequence of C holds
       0 <= FirstBlack/.c & FirstBlack/.c <= len c) &
    (for c being FinSequence of C, j being Integer st
       0 <= j & j < FirstBlack/.c & FirstBlack/.c <= len c
     holds Nth/.[c,j] = Red) &
    (for c being FinSequence of C st FirstBlack/.c < len c
     holds Nth/.[c,FirstBlack/.c] = Black) &
    (for c being FinSequence of C st c in Valid
     holds FirstBlack/.c = 0 or 3 <= FirstBlack/.c) &
    (for c being FinSequence of C, i being Integer holds
       ([c,i] in TwoRed iff
         (Nth/.[c,i-2] = Red & Nth/.[c,i-1] = Red & 2 <= i) or
         (Nth/.[c,i-1] = Red & Nth/.[c,i+1] = Red &
           1 <= i & i <= len c-2) or
         (Nth/.[c,i+1] = Red & Nth/.[c,i+2] = Red &
           i <= len c-3))) &
    (for c being FinSequence of C holds
       (c in Valid iff
         for i being Integer st 0 <= i & i < len c
         holds Nth/.[c,i] = Red implies [c,i] in TwoRed)) &
    (for n being Integer, f being Function of INT,C holds
       (n < 0 implies Create/.[n,f] = <*>C) &
       (0 <= n implies
         len (Create/.[n,f]) = n &
         (for i being Integer st 0 <= i & i < n
          holds Nth/.[Create/.[n,f],i] = f/.i))) &
    (for nr being Integer, c being FinSequence of C holds
       (nr <= 0 & AddLeft/.[nr,c] = <*Black*> ^ c) or
       (0 < nr &
         AddLeft/.[nr,c] =
           <*Red*> ^ AddLeft/.[nr-1,c])) &
    (for nr being Integer, c being FinSequence of C st 0 <= nr
     holds len (AddLeft/.[nr,c]) = len c + nr + 1) &
    (for nr being Integer, c being FinSequence of C holds
       AddLeftClosure/.[nr,c] = AddLeft/.[nr,c]) &
    (for s being Element of ColorSets, nr being Integer,
         x being FinSequence of C
     holds
       (x in MapAdd/.[s,nr] iff
         ex y being FinSequence of C st
           y in s & x = AddLeftClosure/.[nr,y])) &
    (for s being Element of ColorSets holds
       CardSet/.s = card s) &
    (for i being Integer holds
       fc/.i = Black & fc1/.i = Black & fc2/.i = Black &
       fc3/.i = Red & fc4/.i = Black &
       fc5/.i = Red & fc6/.i = Red) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT, n being Integer
     holds
       ([sets,[count,n]] in PrefixInv iff
         (for c being FinSequence of C st
            0 <= len c & len c < n & c in Valid
          holds c in sets/.(len c)) &
         (for c being FinSequence of C, i being Integer st
            0 <= i & i < n & c in sets/.i
          holds len c = i & c in Valid) &
         (for i being Integer st 0 <= i & i < n
          holds count/.i = CardSet/.(sets/.i)))) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT, n,k being Integer
     holds
       ([sets,[count,[n,k]]] in BucketInv iff
         [sets,[count,n]] in PrefixInv &
         (for c being FinSequence of C holds
            (c in sets/.n iff
              len c = n & c in Valid & FirstBlack/.c < k)) &
         count/.n = CardSet/.(sets/.n))) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT
     holds
       ([sets,count] in Final iff
         (for i being Integer st 0 <= i & i <= 50
          holds
            for c being FinSequence of C st len c = i
            holds (c in Valid iff c in sets/.i)) &
         (for i being Integer st 0 <= i & i < 50
          holds count/.i = CardSet/.(sets/.i)))) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT, n,k being Integer
     holds
       ([sets,[count,[n,k]]] in InnerStep iff
         for o10 being Integer st o10 = n-k-1
         holds
           0 <= o10 & o10 < 51 &
           0 <= n & n < 51 &
           (for o11 being Integer st
              o11 = count/.n + count/.o10
            holds
              for count1 being Function of INT,INT st
                count1 = count+*(n,o11)
              holds
                for o12 being Integer st o12 = n-k-1
                holds
                  0 <= o12 & o12 < 51 &
                  (for ns being Element of ColorSets st
                     ns = MapAdd/.[sets/.o12,k]
                   holds
                     0 <= n & n < 51 &
                     (for o13 being Element of ColorSets st
                        o13 = sets/.n
                      holds
                        (for x being FinSequence of C st x in o13
                         holds not x in ns) &
                        (for o14 being Element of ColorSets st
                           o14 = o13 \/ ns
                         holds
                           CardSet/.o14 =
                             CardSet/.o13 + CardSet/.ns implies
                             [sets+*(n,o14),
                               [count1,[n,k+1]]] in BucketInv)))))) &
    (for red being Function of INT,C,
         sets being Function of INT,ColorSets,
         count being Function of INT,INT, n being Integer
     holds
       ([red,[sets,[count,n]]] in AddRed iff
         0 <= n &
         (for r being FinSequence of C st r = Create/.[n,red]
          holds
            (len r = n &
             (for i being Integer st 0 <= i & i < n
              holds Nth/.[r,i] = red/.i))
            implies
              for sr being Element of ColorSets st sr = {r}
              holds
                0 <= n & n < 51 &
                (for o11 being Integer st o11 = count/.n + 1
                 holds
                   for count1 being Function of INT,INT st
                     count1 = count+*(n,o11)
                   holds
                     for o12 being Element of ColorSets st
                       o12 = sets/.n
                     holds
                       (for x being FinSequence of C st x in o12
                        holds not x in sr) &
                       (for o13 being Element of ColorSets st
                          o13 = o12 \/ sr
                        holds
                          CardSet/.o13 =
                            CardSet/.o12 + CardSet/.sr implies
                            [sets+*(n,o13),
                              [count1,n+1]] in PrefixInv))))) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT, n being Integer
     holds
       ([sets,[count,n]] in OuterStep iff
         for o5 being Integer st o5 = n-1
         holds
           0 <= o5 & o5 < 51 &
           (for o6 being Integer st o6 = count/.o5
            holds
              0 <= n & n < 51 &
              (for count1 being Function of INT,INT st
                 count1 = count+*(n,o6)
               holds
                 for o7 being Integer st o7 = n-1
                 holds
                   0 <= o7 & o7 < 51 &
                   (for o8 being Element of ColorSets st
                      o8 = MapAdd/.[sets/.o7,0]
                    holds
                      0 <= n & n < 51 &
                      (for sets1 being Function of INT,ColorSets st
                         sets1 = sets+*(n,o8)
                       holds
                         for o9 being Integer st o9 = n-1
                         holds
                           (3 <= o9+1 implies
                             [sets1,[count1,[n,3]]] in BucketInv &
                             (for sets2 being
                                    Function of INT,ColorSets,
                                  count2 being Function of INT,INT
                              holds
                                (for k being Integer st
                                   3 <= k & k <= o9 &
                                   [sets2,[count2,[n,k]]]
                                     in BucketInv
                                 holds
                                   [sets2,[count2,[n,k]]]
                                     in InnerStep) &
                                ([sets2,[count2,[n,o9+1]]]
                                    in BucketInv
                                 implies
                                   [fc5,[sets2,[count2,n]]]
                                     in AddRed))) &
                           (o9+1 < 3 implies
                             [fc6,[sets1,[count1,n]]]
                               in AddRed))))))) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT
     holds
       ([sets,count] in Initialized iff
         (4 <= 51 implies
           [sets,[count,4]] in PrefixInv &
           (for sets1 being Function of INT,ColorSets,
                count1 being Function of INT,INT
            holds
              (for n being Integer st
                 4 <= n & n <= 50 &
                 [sets1,[count1,n]] in PrefixInv
               holds [sets1,[count1,n]] in OuterStep) &
              ([sets1,[count1,51]] in PrefixInv
               implies [sets1,count1] in Final))) &
         (51 < 4 implies [sets,count] in Final))) &
    (for sets being Function of INT,ColorSets,
         count being Function of INT,INT
     holds
       ([sets,count] in Initialization iff
         0 <= 0 & 0 < 51 &
         (for count0 being Function of INT,INT st
            count0 = count+*(0,1)
          holds
            for o1 being Element of ColorSets st
              o1 = {Create/.[0,fc]}
            holds
              0 <= 0 & 0 < 51 &
              (for sets0 being Function of INT,ColorSets st
                 sets0 = sets+*(0,o1)
               holds
                 0 <= 1 & 1 < 51 &
                 (for count1 being Function of INT,INT st
                    count1 = count0+*(1,1)
                  holds
                    for o2 being Element of ColorSets st
                      o2 = {Create/.[1,fc1]}
                    holds
                      0 <= 1 & 1 < 51 &
                      (for sets1 being Function of INT,ColorSets st
                         sets1 = sets0+*(1,o2)
                       holds
                         0 <= 2 & 2 < 51 &
                         (for count2 being Function of INT,INT st
                            count2 = count1+*(2,1)
                          holds
                            for o3 being Element of ColorSets st
                              o3 = {Create/.[2,fc2]}
                            holds
                              0 <= 2 & 2 < 51 &
                              (for sets2 being
                                   Function of INT,ColorSets st
                                 sets2 = sets1+*(2,o3)
                               holds
                                 0 <= 3 & 3 < 51 &
                                 (for count3 being
                                      Function of INT,INT st
                                    count3 = count2+*(3,2)
                                  holds
                                    for o4 being
                                         Element of ColorSets st
                                      o4 =
                                        {Create/.[3,fc3],
                                         Create/.[3,fc4]}
                                    holds
                                      0 <= 3 & 3 < 51 &
                                       (for sets3 being
                                           Function of INT,ColorSets st
                                         sets3 = sets2+*(3,o4)
                                       holds
                                         [sets3,count3]
                                           in Initialized))))))))))
  holds
    0 <= 51 &
    (for count being Function of INT,INT st
       (for i being Integer st 0 <= i & i < 51
        holds count/.i = 0)
     holds
       0 <= 51 &
       (for sets being Function of INT,ColorSets st
          (for i being Integer st 0 <= i & i < 51
           holds sets/.i = {})
        holds [sets,count] in Initialization))
proof
end;
::$P+
