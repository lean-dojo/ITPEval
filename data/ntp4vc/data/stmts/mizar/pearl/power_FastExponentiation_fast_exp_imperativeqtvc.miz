:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/power_FastExponentiation_fast_exp_imperativeqtvc: the imperative
:: fast-exponentiation verification condition establishes initialization and
:: preservation of its nonnegative-exponent loop invariant. This file contains
:: no proof.

environ
  vocabularies NUMBERS, INT_1, NAT_1, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0, SUBSET_1,
    NEWTON;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, NAT_1, NAT_D, NEWTON;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, NAT_D, NEWTON,
    CARD_1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,x being Integer st
    0 <= n
  holds
    0 <= n &
    ex exponent being Nat st
      exponent = n &
      1 * (x |^ exponent) = x |^ exponent &
      (for e,p,r being Integer holds
        (0 <= e &
          (ex currentExponent being Nat st
            currentExponent = e &
            r * (p |^ currentExponent) = x |^ exponent))
        implies
          ((0 < e implies
              2 <> 0 &
              ((e mod 2 = 1 implies
                  2 <> 0 &
                  (0 <= e & e div 2 < e) &
                  0 <= e div 2 &
                  (ex halfExponent being Nat st
                    halfExponent = e div 2 &
                    r * p * ((p * p) |^ halfExponent) =
                      x |^ exponent)) &
               (e mod 2 <> 1 implies
                  2 <> 0 &
                  (0 <= e & e div 2 < e) &
                  0 <= e div 2 &
                  (ex halfExponent being Nat st
                    halfExponent = e div 2 &
                    r * ((p * p) |^ halfExponent) =
                      x |^ exponent)))) &
           (not 0 < e implies
              r = x |^ exponent)))
proof
end;
::$P+
