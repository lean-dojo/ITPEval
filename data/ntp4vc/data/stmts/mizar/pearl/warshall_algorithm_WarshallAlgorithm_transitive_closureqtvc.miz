:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/warshall_algorithm_WarshallAlgorithm_transitive_closureqtvc:
:: the nested-loop verification condition for Warshall's transitive-closure
:: algorithm on an integer-indexed Boolean adjacency matrix. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Matrix being non empty set,
      rows,columns being Function of Matrix,INT,
      elts being Function of
        Matrix,Funcs([:INT,INT:],BOOLEAN),
      Path being Subset of
        [:Matrix,[:INT,[:INT,INT:]:]:],
      AtK being Subset of
        [:Matrix,[:Matrix,INT:]:],
      RowInv being Subset of
        [:Matrix,[:Matrix,[:INT,INT:]:]:],
      CellInv being Subset of
        [:Matrix,[:Matrix,[:INT,[:INT,INT:]:]:]:],
      m,t being Element of Matrix
  st
    (for a being Element of Matrix holds
       0 <= rows.a & 0 <= columns.a) &
    (for a being Element of Matrix,
         i,j,k being Integer
     holds
       ([a,[i,[j,k]]] in Path iff
        ex p being FinSequence of INT st
          2 <= len p &
          p.1 = i &
          p.(len p) = j &
          (for q being Nat st 1 <= q & q < len p
           holds
             (elts.a).[p.q,p.(q+1)] = TRUE) &
          (for q being Nat st 1 < q & q < len p
           holds
             0 <= In(p.q,INT) & In(p.q,INT) < k))) &
    (for a,s being Element of Matrix,
         k being Integer
     holds
       ([a,[s,k]] in AtK iff
        for x,y being Integer st
          0 <= x & x < rows.a &
          0 <= y & y < rows.a
        holds
          ((elts.s).[x,y] = TRUE iff
            [a,[x,[y,k]]] in Path))) &
    (for a,s being Element of Matrix,
         k,i being Integer
     holds
       ([a,[s,[k,i]]] in RowInv iff
        for x,y being Integer st
          0 <= x & x < rows.a &
          0 <= y & y < rows.a
        holds
          ((elts.s).[x,y] = TRUE iff
            (x < i & [a,[x,[y,k+1]]] in Path) or
            (i <= x & [a,[x,[y,k]]] in Path)))) &
    (for a,s being Element of Matrix,
         k,i,j being Integer
     holds
       ([a,[s,[k,[i,j]]]] in CellInv iff
        for x,y being Integer st
          0 <= x & x < rows.a &
          0 <= y & y < rows.a
        holds
          ((elts.s).[x,y] = TRUE iff
            ((x < i or (x = i & y < j)) &
              [a,[x,[y,k+1]]] in Path) or
            ((i < x or (x = i & j <= y)) &
              [a,[x,[y,k]]] in Path)))) &
    rows.m = columns.m &
    rows.t = rows.m &
    columns.t = columns.m &
    (for r being Integer st 0 <= r & r < rows.t
     holds
       for c being Integer st 0 <= c & c < columns.t
       holds (elts.t).[r,c] = (elts.m).[r,c])
  holds
    for o1 being Integer st o1 = rows.m - 1
    holds
      (0 <= o1 + 1 implies
        [m,[t,0]] in AtK &
        (for t1 being Element of Matrix st
           rows.t1 = rows.t & columns.t1 = columns.t
         holds
           (for k being Integer st
              (0 <= k & k <= o1) &
              [m,[t1,k]] in AtK
            holds
              for o2 being Integer st o2 = rows.m - 1
              holds
                (0 <= o2 + 1 implies
                  [m,[t1,[k,0]]] in RowInv &
                  (for t2 being Element of Matrix st
                     rows.t2 = rows.t1 &
                     columns.t2 = columns.t1
                   holds
                     (for i being Integer st
                        (0 <= i & i <= o2) &
                        [m,[t2,[k,i]]] in RowInv
                      holds
                        for o3 being Integer st
                          o3 = rows.m - 1
                        holds
                          (0 <= o3 + 1 implies
                            [m,[t2,[k,[i,0]]]] in CellInv &
                            (for t3 being Element of Matrix st
                               rows.t3 = rows.t2 &
                               columns.t3 = columns.t2
                             holds
                               (for j being Integer st
                                  (0 <= j & j <= o3) &
                                  [m,[t3,[k,[i,j]]]]
                                    in CellInv
                                holds
                                  0 <= i & i < rows.t3 &
                                  0 <= j & j < columns.t3 &
                                  (for o4 being
                                     Element of BOOLEAN st
                                     o4 = (elts.t3).[i,j]
                                   holds
                                     (o4 <> TRUE implies
                                       0 <= i &
                                       i < rows.t3 &
                                       0 <= k &
                                       k < columns.t3 &
                                       ((elts.t3).[i,k] =
                                          TRUE implies
                                         0 <= k &
                                         k < rows.t3 &
                                         0 <= j &
                                         j < columns.t3)) &
                                     (for o5 being
                                        Element of BOOLEAN st
                                        (o4 = TRUE &
                                           o5 = TRUE) or
                                        (o4 <> TRUE &
                                           (elts.t3).[i,k] =
                                             TRUE &
                                           o5 =
                                             (elts.t3).[k,j]) or
                                        (o4 <> TRUE &
                                           (elts.t3).[i,k] <>
                                             TRUE &
                                           o5 = FALSE)
                                      holds
                                        0 <= i &
                                        i < rows.t3 &
                                        0 <= j &
                                        j < columns.t3 &
                                        (for t4 being
                                           Element of Matrix st
                                           rows.t4 = rows.t3 &
                                           columns.t4 =
                                             columns.t3 &
                                           elts.t4 =
                                             (elts.t3)
                                               +*([i,j],o5)
                                         holds
                                           [m,[t4,
                                             [k,[i,j+1]]]]
                                             in CellInv)))) &
                               ([m,[t3,[k,[i,o3+1]]]]
                                  in CellInv implies
                                [m,[t3,[k,i+1]]]
                                  in RowInv))) &
                          (o3 + 1 < 0 implies
                            [m,[t2,[k,i+1]]] in RowInv)) &
                     ([m,[t2,[k,o2+1]]] in RowInv implies
                       [m,[t2,k+1]] in AtK))) &
                (o2 + 1 < 0 implies
                  [m,[t1,k+1]] in AtK)) &
           ([m,[t1,o1+1]] in AtK implies
             for n1 being Integer st n1 = rows.m
             holds [m,[t1,n1]] in AtK)) &
      (o1 + 1 < 0 implies
        for n1 being Integer st n1 = rows.m
        holds [m,[t,n1]] in AtK))
proof
end;
::$P+
