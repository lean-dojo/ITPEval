:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bignum_BigNum_add_cinqtvc: the carry-input addition verification
:: condition for valid finite base-b digit lists and their integer values.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for base,cin being Integer,
      n1,n2 being FinSequence of INT,
      Value being Function of INT*,INT,
      Valid being Subset of INT* st
    1 < base &
    Value.(<*>INT) = 0 &
    (for d being Integer, r,s being FinSequence of INT st
      s = <*d*> ^ r
     holds
      ex vr,vs being Integer st
        vr = Value.r &
        vs = Value.s &
        vs = d + base * vr) &
    <*>INT in Valid &
    (for d being Integer holds
      (<*d*> in Valid iff 0 < d & d < base)) &
    (for d being Integer,
         r being non empty FinSequence of INT holds
      ((<*d*> ^ r) in Valid iff
        (0 <= d & d < base) & r in Valid)) &
    n1 in Valid &
    n2 in Valid &
    0 <= cin &
    cin <= 1
  holds
    ((n2 = <*>INT & n1 = <*>INT implies
        n2 in Valid & 0 <= cin & cin < base) &
     (for x being Integer, x1 being FinSequence of INT st
        n2 = <*>INT & n1 = <*x*> ^ x1
      holds
        n1 in Valid & 0 <= cin & cin < base) &
     (for x being Integer, x1 being FinSequence of INT st
        n2 = <*x*> ^ x1 & n1 = <*>INT
      holds
        n2 in Valid & 0 <= cin & cin < base) &
     (for x,x2 being Integer,
          x1,x3 being FinSequence of INT st
        n2 = <*x*> ^ x1 & n1 = <*x2*> ^ x3
      holds
        (cin + x2 + x < base implies
          x3 = x3 &
          x3 in Valid &
          x1 in Valid &
          0 <= 0 &
          0 <= 1) &
        (not cin + x2 + x < base implies
          x3 = x3 &
          x3 in Valid &
          x1 in Valid &
          0 <= 1 &
          1 <= 1))) &
    (for result being FinSequence of INT holds
      ex vr,vn1,vn2 being Integer st
        vr = Value.result &
        vn1 = Value.n1 &
        vn2 = Value.n2 &
        (((n2 = <*>INT & n1 = <*>INT &
           result in Valid &
           vr = vn2 + cin)
          implies
           result in Valid &
           vr = vn1 + vn2 + cin) &
         (for x being Integer, x1 being FinSequence of INT st
           n2 = <*>INT &
           n1 = <*x*> ^ x1 &
           result in Valid &
           vr = vn1 + cin
          holds
           result in Valid &
           vr = vn1 + vn2 + cin) &
         (for x being Integer, x1 being FinSequence of INT st
           n2 = <*x*> ^ x1 &
           n1 = <*>INT &
           result in Valid &
           vr = vn2 + cin
          holds
           result in Valid &
           vr = vn1 + vn2 + cin) &
         (for x,x2 being Integer,
              x1,x3 being FinSequence of INT st
           n2 = <*x*> ^ x1 &
           n1 = <*x2*> ^ x3 &
           (ex vx1,vx3 being Integer st
             vx1 = Value.x1 &
             vx3 = Value.x3 &
             ((cin + x2 + x < base &
               ex o1 being FinSequence of INT,
                  vo1 being Integer st
                 vo1 = Value.o1 &
                 (o1 in Valid &
                  vo1 = vx3 + vx1 + 0) &
                 result = <*(cin + x2 + x)*> ^ o1) or
              (not cin + x2 + x < base &
               ex o1 being FinSequence of INT,
                  vo1 being Integer st
                 vo1 = Value.o1 &
                 (o1 in Valid &
                  vo1 = vx3 + vx1 + 1) &
                 result = <*(cin + x2 + x - base)*> ^ o1)))
          holds
           result in Valid &
           vr = vn1 + vn2 + cin)))
proof
end;
::$P+
