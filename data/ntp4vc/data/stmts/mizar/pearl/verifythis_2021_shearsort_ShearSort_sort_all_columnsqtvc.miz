:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_shearsort_ShearSort_sort_all_columnsqtvc: the
:: ShearSort column-sorting verification condition preserves each column's
:: multiplicities and establishes ascending column order, directly or via
:: two matrix transpositions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCOP_1, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1,
    NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSET_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, NAT_1, XXREAL_0, FINSET_1, MARGREL1,
    XBOOLEAN, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4,
    FUNCT_7;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1,
    CARD_1, REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1,
    NAT_1, FINSET_1, MARGREL1, FINSEQ_1, FINSEQ_2, PRE_POLY,
    FUNCT_4, FUNCT_7;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCOP_1, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSET_1, MARGREL1, XBOOLEAN, FRAENKEL, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ColPerm,ColPrefix,SameExceptCol,ColAtSorted,OneColPerm,
      RowColPerm,RowPrefix,SameExceptRow,RowAtSorted,OneRowPerm,
      Transpose being set,
      r,c being Integer,
      e being Function of [:INT,INT:],INT
  st
    0 <= r & 0 <= c &

    (for f2,f1 being Function of [:INT,INT:],INT,
         nr,nc being Integer
     holds
       ([f2,[f1,[nr,nc]]] in ColPerm iff
         for j being Integer st 0 <= j & j < nc
         holds
           for v being Integer holds
             card {i where i is Integer :
               0 <= i & i < nr & f2.[i,j] = v} =
             card {i where i is Integer :
               0 <= i & i < nr & f1.[i,j] = v})) &

    (for f being Function of [:INT,INT:],INT,
         nr,upto being Integer
     holds
       ([f,[nr,upto]] in ColPrefix iff
         for i,j,k being Integer st
           0 <= i & i <= k & k < nr & 0 <= j & j < upto
         holds f.[i,j] <= f.[k,j])) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         nr,nc,tid being Integer
     holds
       ([f2,[f1,[nr,[nc,tid]]]] in SameExceptCol iff
         for i,k being Integer st
           0 <= i & i < nr & 0 <= k & k < nc & k <> tid
         holds f2.[i,k] = f1.[i,k])) &

    (for f being Function of [:INT,INT:],INT,
         nr,tid being Integer
     holds
       ([f,[nr,tid]] in ColAtSorted iff
         for i,k being Integer st
           0 <= i & i <= k & k < nr
         holds f.[i,tid] <= f.[k,tid])) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         tid,nr being Integer
     holds
       ([f2,[f1,[tid,nr]]] in OneColPerm iff
         for v being Integer holds
           card {i where i is Integer :
             0 <= i & i < nr & f2.[i,tid] = v} =
           card {i where i is Integer :
             0 <= i & i < nr & f1.[i,tid] = v})) &

    (for f2,f0 being Function of [:INT,INT:],INT,
         n being Integer
     holds
       ([f2,[f0,n]] in RowColPerm iff
         for j being Integer st 0 <= j & j < n
         holds
           for v being Integer holds
             card {i where i is Integer :
               0 <= i & i < n & f2.[j,i] = v} =
             card {i where i is Integer :
               0 <= i & i < n & f0.[i,j] = v})) &

    (for f being Function of [:INT,INT:],INT,
         n,upto being Integer
     holds
       ([f,[n,upto]] in RowPrefix iff
         for i,j,k being Integer st
           0 <= i & i <= k & k < n & 0 <= j & j < upto
         holds f.[j,i] <= f.[j,k])) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         nr,nc,tid being Integer
     holds
       ([f2,[f1,[nr,[nc,tid]]]] in SameExceptRow iff
         for j,k being Integer st
           0 <= j & j < nr & 0 <= k & k < nc & j <> tid
         holds f2.[j,k] = f1.[j,k])) &

    (for f being Function of [:INT,INT:],INT,
         nc,tid being Integer
     holds
       ([f,[nc,tid]] in RowAtSorted iff
         for j,k being Integer st
           0 <= j & j <= k & k < nc
         holds f.[tid,j] <= f.[tid,k])) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         tid,nc being Integer
     holds
       ([f2,[f1,[tid,nc]]] in OneRowPerm iff
         for v being Integer holds
           card {j where j is Integer :
             0 <= j & j < nc & f2.[tid,j] = v} =
           card {j where j is Integer :
             0 <= j & j < nc & f1.[tid,j] = v})) &

    (for f1,f2 being Function of [:INT,INT:],INT,
         nr,nc being Integer
     holds
       ([f1,[f2,[nr,nc]]] in Transpose iff
         for i,j being Integer st
           0 <= i & i < nr & 0 <= j & j < nc
         holds f1.[i,j] = f2.[j,i]))
  holds
    (ex result being Element of BOOLEAN st
       result = TRUE or r = c) &
    (for o1 being Element of BOOLEAN st o1 = TRUE or r = c
     holds
       (o1 = TRUE implies
         (0 <= (c-1)+1 implies
           ([e,[e,[r,c]]] in ColPerm &
            [e,[r,0]] in ColPrefix) &
           (for e1 being Function of [:INT,INT:],INT holds
             (for tid being Integer st
                (0 <= tid & tid <= c-1) &
                [e1,[e,[r,c]]] in ColPerm &
                [e1,[r,tid]] in ColPrefix
              holds
                (0 <= tid & tid < c) &
                (for e2 being Function of [:INT,INT:],INT st
                   [e2,[e1,[r,[c,tid]]]] in SameExceptCol &
                   [e2,[r,tid]] in ColAtSorted &
                   [e2,[e1,[tid,r]]] in OneColPerm
                 holds
                   [e2,[e,[r,c]]] in ColPerm &
                   [e2,[r,tid+1]] in ColPrefix)) &
             (([e1,[e,[r,c]]] in ColPerm &
               [e1,[r,(c-1)+1]] in ColPrefix)
              implies
                [e1,[e,[r,c]]] in ColPerm &
                [e1,[r,c]] in ColPrefix))) &
         ((c-1)+1 < 0 implies
           [e,[e,[r,c]]] in ColPerm &
           [e,[r,c]] in ColPrefix)) &

       (o1 = FALSE implies
         r = c &
         (for e1 being Function of [:INT,INT:],INT st
            [e,[e1,[r,c]]] in Transpose
          holds
            (0 <= (c-1)+1 implies
              ([e1,[e,r]] in RowColPerm &
               [e1,[r,0]] in RowPrefix) &
              (for e2 being Function of [:INT,INT:],INT holds
                (for tid being Integer st
                   (0 <= tid & tid <= c-1) &
                   [e2,[e,r]] in RowColPerm &
                   [e2,[r,tid]] in RowPrefix
                 holds
                   (0 <= tid & tid < r) &
                   (for e3 being Function of [:INT,INT:],INT st
                      [e3,[e2,[r,[c,tid]]]] in SameExceptRow &
                      [e3,[c,tid]] in RowAtSorted &
                      [e3,[e2,[tid,c]]] in OneRowPerm
                    holds
                      [e3,[e,r]] in RowColPerm &
                      [e3,[r,tid+1]] in RowPrefix)) &
                (([e2,[e,r]] in RowColPerm &
                  [e2,[r,(c-1)+1]] in RowPrefix)
                 implies
                   r = c &
                   (for e3 being Function of [:INT,INT:],INT st
                      [e2,[e3,[r,c]]] in Transpose
                    holds
                      [e3,[e,[r,c]]] in ColPerm &
                      [e3,[r,c]] in ColPrefix)))) &
            ((c-1)+1 < 0 implies
              r = c &
              (for e2 being Function of [:INT,INT:],INT st
                 [e1,[e2,[r,c]]] in Transpose
               holds
                 [e2,[e,[r,c]]] in ColPerm &
                 [e2,[r,c]] in ColPrefix)))))
proof
end;
::$P+
