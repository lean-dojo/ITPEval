:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/leftist_heap_LeftistHeap_mergeqtvc: the leftist-heap merge
:: verification condition preserves total size, element multiplicities,
:: heap order, and the leftist invariant. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      Leq being Relation of E,E,
      emptyT being Element of Tree,
      node being Function of [:INT,[:Tree,[:E,Tree:]:]:],Tree,
      Size,Rank being Function of Tree,INT,
      Occ being Function of [:E,Tree:],INT,
      LeRoot being Subset of [:E,Tree:],
      Heaps,Leftist,LeftistHeaps being Subset of Tree,
      Minimum being Function of Tree,E,
      h1,h2 being Element of Tree
  st
    (for a being Element of E holds [a,a] in Leq) &
    (for a,b,c being Element of E st
       [a,b] in Leq & [b,c] in Leq
     holds
       [a,c] in Leq) &
    (for a,b being Element of E holds
       [a,b] in Leq or [b,a] in Leq) &
    (for s being Integer,
         l,r being Element of Tree,
         x being Element of E
     holds
       node.[s,[l,[x,r]]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex s being Integer,
          l,r being Element of Tree,
          x being Element of E st
         u = node.[s,[l,[x,r]]]) &
    (for s,s2 being Integer,
         l,l2,r,r2 being Element of Tree,
         x,x2 being Element of E st
       node.[s,[l,[x,r]]] = node.[s2,[l2,[x2,r2]]]
     holds
       s = s2 & l = l2 & x = x2 & r = r2) &
    (for X being Subset of Tree st
       emptyT in X &
       (for s being Integer,
            l,r being Element of Tree,
            x being Element of E st
          l in X & r in X
        holds
          node.[s,[l,[x,r]]] in X)
     holds
       X = Tree) &
    Size.emptyT = 0 &
    (for s being Integer,
         l,r being Element of Tree,
         x being Element of E
     holds
       Size.(node.[s,[l,[x,r]]]) = 1 + Size.l + Size.r) &
    (for a being Element of E holds
       Occ.[a,emptyT] = 0) &
    (for a,x being Element of E,
         s being Integer,
         l,r being Element of Tree
     holds
       ex whole,leftOcc,rightOcc being Integer st
         whole = Occ.[a,node.[s,[l,[x,r]]]] &
         leftOcc = Occ.[a,l] &
         rightOcc = Occ.[a,r] &
         (a = x implies whole = 1 + leftOcc + rightOcc) &
         (a <> x implies whole = leftOcc + rightOcc)) &
    (for a being Element of E holds
       [a,emptyT] in LeRoot) &
    (for a,x being Element of E,
         s being Integer,
         l,r being Element of Tree
     holds
       ([a,node.[s,[l,[x,r]]]] in LeRoot iff [a,x] in Leq)) &
    emptyT in Heaps &
    (for x being Element of E,
         s being Integer,
         l,r being Element of Tree
     holds
       (node.[s,[l,[x,r]]] in Heaps iff
          [x,l] in LeRoot & l in Heaps &
          [x,r] in LeRoot & r in Heaps)) &
    Rank.emptyT = 0 &
    (for x being Element of E,
         s being Integer,
         l,r being Element of Tree
     holds
       Rank.(node.[s,[l,[x,r]]]) =
         1 + min(Rank.l,Rank.r)) &
    emptyT in Leftist &
    (for x being Element of E,
         s being Integer,
         l,r being Element of Tree
     holds
       (node.[s,[l,[x,r]]] in Leftist iff
          s = Rank.(node.[s,[l,[x,r]]]) &
          l in Leftist & r in Leftist & Rank.r <= Rank.l)) &
    (for u being Element of Tree holds
       (u in LeftistHeaps iff u in Heaps & u in Leftist)) &
    (for x being Element of E,
         s being Integer,
         l,r being Element of Tree
     holds
       Minimum.(node.[s,[l,[x,r]]]) = x) &
    h1 in LeftistHeaps &
    h2 in LeftistHeaps
  holds
    (h2 = emptyT or
     ex s2 being Integer,
        l2,r2 being Element of Tree,
        x2 being Element of E st
       h2 = node.[s2,[l2,[x2,r2]]] &
       (h1 = emptyT or
        ex s1 being Integer,
           l1,r1 being Element of Tree,
           x1 being Element of E st
          h1 = node.[s1,[l1,[x1,r1]]] &
          (([x1,x2] in Leq &
            ((0 <= Size.h1 + Size.h2 &
              Size.r1 + Size.h2 < Size.h1 + Size.h2) &
             r1 in LeftistHeaps &
             h2 in LeftistHeaps) &
            (for o1 being Element of Tree st
               Size.o1 = Size.r1 + Size.h2 &
               (for x8 being Element of E holds
                  ex o1Occ,r1Occ,h2Occ being Integer st
                    o1Occ = Occ.[x8,o1] &
                    r1Occ = Occ.[x8,r1] &
                    h2Occ = Occ.[x8,h2] &
                    o1Occ = r1Occ + h2Occ) &
               o1 in LeftistHeaps
             holds
               (o1 in LeftistHeaps & l1 in LeftistHeaps) &
               [x1,l1] in LeRoot & [x1,o1] in LeRoot)) or
           (not [x1,x2] in Leq &
            ((0 <= Size.h1 + Size.h2 &
              Size.h1 + Size.r2 < Size.h1 + Size.h2) &
             h1 in LeftistHeaps &
             r2 in LeftistHeaps) &
            (for o1 being Element of Tree st
               Size.o1 = Size.h1 + Size.r2 &
               (for x8 being Element of E holds
                  ex o1Occ,h1Occ,r2Occ being Integer st
                    o1Occ = Occ.[x8,o1] &
                    h1Occ = Occ.[x8,h1] &
                    r2Occ = Occ.[x8,r2] &
                    o1Occ = h1Occ + r2Occ) &
               o1 in LeftistHeaps
             holds
               (o1 in LeftistHeaps & l2 in LeftistHeaps) &
               [x2,l2] in LeRoot & [x2,o1] in LeRoot))))) &
    (for result being Element of Tree st
       ((h2 = emptyT & result = h1) or
        ex s2 being Integer,
           l2,r2 being Element of Tree,
           x2 being Element of E st
          h2 = node.[s2,[l2,[x2,r2]]] &
          ((h1 = emptyT & result = h2) or
           ex s1 being Integer,
              l1,r1 being Element of Tree,
              x1 being Element of E st
             h1 = node.[s1,[l1,[x1,r1]]] &
             (([x1,x2] in Leq &
               ex o1 being Element of Tree st
                 Size.o1 = Size.r1 + Size.h2 &
                 (for x8 being Element of E holds
                    ex o1Occ,r1Occ,h2Occ being Integer st
                      o1Occ = Occ.[x8,o1] &
                      r1Occ = Occ.[x8,r1] &
                      h2Occ = Occ.[x8,h2] &
                      o1Occ = r1Occ + h2Occ) &
                 o1 in LeftistHeaps &
                 result in LeftistHeaps &
                 Minimum.result = x1 &
                 Size.result = 1 + Size.l1 + Size.o1 &
                 (ex resultOcc,l1Occ,o1Occ being Integer st
                    resultOcc = Occ.[x1,result] &
                    l1Occ = Occ.[x1,l1] &
                    o1Occ = Occ.[x1,o1] &
                    resultOcc = 1 + l1Occ + o1Occ) &
                 (for y being Element of E st y <> x1 holds
                    ex resultOcc,l1Occ,o1Occ being Integer st
                      resultOcc = Occ.[y,result] &
                      l1Occ = Occ.[y,l1] &
                      o1Occ = Occ.[y,o1] &
                      resultOcc = l1Occ + o1Occ)) or
              (not [x1,x2] in Leq &
               ex o1 being Element of Tree st
                 Size.o1 = Size.h1 + Size.r2 &
                 (for x8 being Element of E holds
                    ex o1Occ,h1Occ,r2Occ being Integer st
                      o1Occ = Occ.[x8,o1] &
                      h1Occ = Occ.[x8,h1] &
                      r2Occ = Occ.[x8,r2] &
                      o1Occ = h1Occ + r2Occ) &
                 o1 in LeftistHeaps &
                 result in LeftistHeaps &
                 Minimum.result = x2 &
                 Size.result = 1 + Size.l2 + Size.o1 &
                 (ex resultOcc,l2Occ,o1Occ being Integer st
                    resultOcc = Occ.[x2,result] &
                    l2Occ = Occ.[x2,l2] &
                    o1Occ = Occ.[x2,o1] &
                    resultOcc = 1 + l2Occ + o1Occ) &
                 (for y being Element of E st y <> x2 holds
                    ex resultOcc,l2Occ,o1Occ being Integer st
                      resultOcc = Occ.[y,result] &
                      l2Occ = Occ.[y,l2] &
                      o1Occ = Occ.[y,o1] &
                      resultOcc = l2Occ + o1Occ)))))
     holds
       Size.result = Size.h1 + Size.h2 &
       (for x being Element of E holds
          ex resultOcc,h1Occ,h2Occ being Integer st
            resultOcc = Occ.[x,result] &
            h1Occ = Occ.[x,h1] &
            h2Occ = Occ.[x,h2] &
            resultOcc = h1Occ + h2Occ) &
       result in LeftistHeaps)
proof
end;
::$P+
