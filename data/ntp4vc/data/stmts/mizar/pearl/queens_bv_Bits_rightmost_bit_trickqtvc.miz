:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/queens_bv_Bits_rightmost_bit_trickqtvc: the 32-bit rightmost-set-bit
:: trick relates a word AND its two's-complement negation to the singleton
:: containing the least index of a set bit. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, FINSET_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, NEWTON, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    NEWTON, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T being non empty set,
      Bv being Function of T,NAT,
      Mdl being Function of T,bool INT st
    (for self being Element of T holds
      Bv.self < 2 |^ 32 & Mdl.self is finite) &
    (for i being Integer, self being Element of T holds
      (((0 <= i & i < 32) &
        (ex w,k being Nat st
          w = Bv.self & k = i &
          (w div (2 |^ k)) mod 2 = 1))
       iff i in Mdl.self)) &
    (for a,b being Element of T st
      Bv.a = Bv.b & Mdl.a = Mdl.b
     holds a = b)
  holds
    for a being Element of T st Mdl.a <> {} holds
      for m being Integer st
        m in Mdl.a &
        (for i being Integer st i in Mdl.a holds m <= i)
      holds
        for neg,res being Nat st
          neg < 2 |^ 32 &
          neg = ((2 |^ 32) - Bv.a) mod (2 |^ 32) &
          res < 2 |^ 32 &
          (for i being Element of NAT st i < 32 holds
            ((res div (2 |^ i)) mod 2 = 1 iff
              ((Bv.a div (2 |^ i)) mod 2 = 1 &
               (neg div (2 |^ i)) mod 2 = 1)))
        holds
          (for i being Integer holds
            (((0 <= i & i < 32) &
              (ex k being Nat st
                k = i &
                (res div (2 |^ k)) mod 2 = 1))
             iff i in {m})) &
          (for result being Element of T st
            Bv.result = res & Mdl.result = {m}
           holds
            Mdl.result = {m})
proof
end;
::$P+
