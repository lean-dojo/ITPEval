:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/add_1_Add_1_wmpn_incr_1qtvc: the verification
:: condition for incrementing a positive-length writable multiprecision
:: integer in place by one, including carry propagation, pointer updates,
:: and memory framing. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Data being Function of P,INT*,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      x being Element of P,
      sz being Element of INT
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, k being Nat st k in dom (Data.p)
     holds
       ex d being Integer st
         d = (Data.p).k & 0 <= d & d < (2 |^ 64)) &
    (for p being Element of P, j being Element of INT holds
      (for limb being Integer st limb = Pelt.[p,j]
       holds 0 <= limb) &
      (for limb being Integer st limb = Pelt.[p,j]
       holds limb < (2 |^ 64))) &
    (for p being Element of P, j being Integer st
       0 <= j & j < len (Data.p)
     holds Pelt.[p,j] = (Data.p).(j+1)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    0 <= sz & sz < (2 |^ 32) &
    -(2 |^ 31) <= Signed32.sz &
    Signed32.sz <= 2147483647 &
    0 <= Signed32.sz &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + Signed32.sz <= Maximum.x &
    Maximum.x <= len (Data.x) &
    0 < Signed32.sz &
    (for vx,power being Integer st
       vx = VSub.[x,[Offset.x,Offset.x+Signed32.sz]] &
       power = Pow.(Signed32.sz)
     holds vx + 1 < power) &
    Writable.x = TRUE
  holds
    Minimum.x <= Offset.x + 0 &
    Offset.x + 0 <= Maximum.x &
    (for o1 being Element of P st
       Offset.o1 = Offset.x + 0 &
       len (Data.o1) = len (Data.x) &
       (for j being Element of INT holds
         Pelt.[o1,j] = Pelt.[x,j]) &
       Data.o1 = Data.x &
       Minimum.o1 = Minimum.x &
       Maximum.o1 = Maximum.x &
       Zone.o1 = Zone.x &
       Writable.o1 = Writable.x
     holds
       (((0 <= 0 & 0 <= Signed32.sz) &
         0 <> sz &
         Offset.o1 = Offset.x + 0 &
         (for j being Element of INT holds
           Pelt.[o1,j] = Pelt.[x,j]) &
         len (Data.o1) = len (Data.x) &
         (Minimum.o1 = Minimum.x &
          Maximum.o1 = Maximum.x) &
         1 <> 0 &
         (0 <= 1 & 1 <= 1) &
         Writable.o1 = TRUE &
         (for vx,power being Integer st
            vx = VSub.[x,[Offset.x,Offset.x+0]] &
            power = Pow.0
          holds vx + power * 1 = vx + 1)) &
        (for xp,x1 being Element of P,
             i,c,r being Element of INT st
           0 <= i & i < (2 |^ 32) &
           0 <= c & c < (2 |^ 64) &
           0 <= r & r < (2 |^ 64) &
           len (Data.x1) = len (Data.x) &
           Offset.x1 = Offset.x &
           Minimum.x1 = Minimum.x &
           Maximum.x1 = Maximum.x &
           Writable.x1 = Writable.x &
           Zone.x1 = Zone.x &
           (0 <= Signed32.i &
            Signed32.i <= Signed32.sz) &
           (i = sz implies r <> 0) &
           Offset.xp = Offset.x1 + Signed32.i &
           (for j being Element of INT holds
             Pelt.[xp,j] = Pelt.[x1,j]) &
           len (Data.xp) = len (Data.x1) &
           (Minimum.xp = Minimum.x1 &
            Maximum.xp = Maximum.x1) &
           (r <> 0 iff c = 0) &
           (0 <= c & c <= 1) &
           Writable.xp = TRUE &
           (for vx1,vx,power being Integer st
              vx1 =
                VSub.[x1,[Offset.x1,Offset.x1+Signed32.i]] &
              vx =
                VSub.[x,[Offset.x,Offset.x+Signed32.i]] &
              power = Pow.(Signed32.i)
            holds vx1 + power * c = vx + 1) &
           (for j being Element of INT st
              Signed32.i <= j & j < Signed32.sz
            holds
              Pelt.[x1,Offset.x1+j] =
                Pelt.[x,Offset.x1+j]) &
           (for j being Element of INT st
              j < Offset.x1 or Offset.x1 + Signed32.sz <= j
            holds Pelt.[x1,j] = Pelt.[x,j])
         holds
           for o2 being Element of BOOLEAN st
             (r = 0 implies o2 = TRUE) &
             (o2 = TRUE implies r = 0)
           holds
             (o2 = TRUE implies
               (Minimum.xp <= Offset.xp &
                Offset.xp < Maximum.xp) &
               (for res being Element of INT st
                  0 <= res & res < (2 |^ 64) &
                  (for px being Integer st
                     px = Pelt.[xp,Offset.xp]
                   holds res = (px + 1) mod (2 |^ 64))
                holds
                  for o3 being Element of BOOLEAN st
                    (res = 0 implies o3 = TRUE) &
                    (o3 = TRUE implies res = 0)
                  holds
                    (o3 = TRUE implies
                      (Minimum.xp <= Offset.xp &
                       Offset.xp < Maximum.xp) &
                      Writable.xp = TRUE &
                      (for xp1,x2 being Element of P st
                         Data.xp1 = Data.x2 &
                         len (Data.x2) = len (Data.xp) &
                         Offset.xp1 = Offset.xp &
                         Minimum.xp1 = Minimum.xp &
                         Maximum.xp1 = Maximum.xp &
                         Writable.xp1 = Writable.xp &
                         Zone.xp1 = Zone.xp &
                         len (Data.x2) = len (Data.x1) &
                         Offset.x2 = Offset.x1 &
                         Minimum.x2 = Minimum.x1 &
                         Maximum.x2 = Maximum.x1 &
                         Writable.x2 = Writable.x1 &
                         Zone.x2 = Zone.x1 &
                         (for j being Element of INT holds
                           (j = Offset.xp1 implies
                             Pelt.[xp1,j] = res) &
                           (j <> Offset.xp1 implies
                             Pelt.[xp1,j] = Pelt.[xp,j]))
                       holds
                          -(2 |^ 31) <= Signed32.i + 1 &
                          Signed32.i + 1 <= 2147483647 &
                          (for o4 being Element of INT st
                             0 <= o4 & o4 < (2 |^ 32) &
                             Signed32.o4 = Signed32.i + 1
                           holds
                             (Minimum.xp1 <= Offset.xp1 + 1 &
                              Offset.xp1 + 1 <= Maximum.xp1) &
                             (for o5 being Element of P st
                                Offset.o5 = Offset.xp1 + 1 &
                                len (Data.o5) = len (Data.xp1) &
                                (for j being Element of INT holds
                                  Pelt.[o5,j] = Pelt.[xp1,j]) &
                                Data.o5 = Data.xp1 &
                                Minimum.o5 = Minimum.xp1 &
                                Maximum.o5 = Maximum.xp1 &
                                Zone.o5 = Zone.xp1 &
                                Writable.o5 = Writable.xp1
                              holds
                                (0 <= Signed32.sz - Signed32.i &
                                 Signed32.sz - Signed32.o4 <
                                   Signed32.sz - Signed32.i) &
                                (0 <= Signed32.o4 &
                                 Signed32.o4 <= Signed32.sz) &
                                (o4 = sz implies res <> 0) &
                                Offset.o5 =
                                  Offset.x2 + Signed32.o4 &
                                (for j being Element of INT holds
                                  Pelt.[o5,j] = Pelt.[x2,j]) &
                                len (Data.o5) = len (Data.x2) &
                                (Minimum.o5 = Minimum.x2 &
                                 Maximum.o5 = Maximum.x2) &
                                (res <> 0 iff 1 = 0) &
                                (0 <= 1 & 1 <= 1) &
                                Writable.o5 = TRUE &
                                (for vx2,vx,power being Integer st
                                   vx2 = VSub.[x2,
                                     [Offset.x2,
                                      Offset.x2+Signed32.o4]] &
                                   vx = VSub.[x,
                                     [Offset.x,
                                      Offset.x+Signed32.o4]] &
                                   power = Pow.(Signed32.o4)
                                 holds
                                   vx2 + power * 1 = vx + 1) &
                                (for j being Element of INT st
                                   Signed32.o4 <= j &
                                   j < Signed32.sz
                                 holds
                                   Pelt.[x2,Offset.x2+j] =
                                     Pelt.[x,Offset.x2+j]) &
                                (for j being Element of INT st
                                   j < Offset.x2 or
                                   Offset.x2 + Signed32.sz <= j
                                 holds
                                   Pelt.[x2,j] = Pelt.[x,j]))))) &
                    (o3 <> TRUE implies
                      (Minimum.xp <= Offset.xp &
                       Offset.xp < Maximum.xp) &
                      Writable.xp = TRUE &
                      (for xp1,x2 being Element of P st
                         Data.xp1 = Data.x2 &
                         len (Data.x2) = len (Data.xp) &
                         Offset.xp1 = Offset.xp &
                         Minimum.xp1 = Minimum.xp &
                         Maximum.xp1 = Maximum.xp &
                         Writable.xp1 = Writable.xp &
                         Zone.xp1 = Zone.xp &
                         len (Data.x2) = len (Data.x1) &
                         Offset.x2 = Offset.x1 &
                         Minimum.x2 = Minimum.x1 &
                         Maximum.x2 = Maximum.x1 &
                         Writable.x2 = Writable.x1 &
                         Zone.x2 = Zone.x1 &
                         (for j being Element of INT holds
                           (j = Offset.xp1 implies
                             Pelt.[xp1,j] = res) &
                           (j <> Offset.xp1 implies
                             Pelt.[xp1,j] = Pelt.[xp,j]))
                       holds
                          -(2 |^ 31) <= Signed32.i + 1 &
                          Signed32.i + 1 <= 2147483647 &
                          (for o4 being Element of INT st
                             0 <= o4 & o4 < (2 |^ 32) &
                             Signed32.o4 = Signed32.i + 1
                           holds
                             (Minimum.xp1 <= Offset.xp1 + 1 &
                              Offset.xp1 + 1 <= Maximum.xp1) &
                             (for o5 being Element of P st
                                Offset.o5 = Offset.xp1 + 1 &
                                len (Data.o5) = len (Data.xp1) &
                                (for j being Element of INT holds
                                  Pelt.[o5,j] = Pelt.[xp1,j]) &
                                Data.o5 = Data.xp1 &
                                Minimum.o5 = Minimum.xp1 &
                                Maximum.o5 = Maximum.xp1 &
                                Zone.o5 = Zone.xp1 &
                                Writable.o5 = Writable.xp1
                              holds
                                (0 <= Signed32.sz - Signed32.i &
                                 Signed32.sz - Signed32.o4 <
                                   Signed32.sz - Signed32.i) &
                                (0 <= Signed32.o4 &
                                 Signed32.o4 <= Signed32.sz) &
                                (o4 = sz implies res <> 0) &
                                Offset.o5 =
                                  Offset.x2 + Signed32.o4 &
                                (for j being Element of INT holds
                                  Pelt.[o5,j] = Pelt.[x2,j]) &
                                len (Data.o5) = len (Data.x2) &
                                (Minimum.o5 = Minimum.x2 &
                                 Maximum.o5 = Maximum.x2) &
                                (res <> 0 iff 0 = 0) &
                                (0 <= 0 & 0 <= 1) &
                                Writable.o5 = TRUE &
                                (for vx2,vx,power being Integer st
                                   vx2 = VSub.[x2,
                                     [Offset.x2,
                                      Offset.x2+Signed32.o4]] &
                                   vx = VSub.[x,
                                     [Offset.x,
                                      Offset.x+Signed32.o4]] &
                                   power = Pow.(Signed32.o4)
                                 holds
                                   vx2 + power * 0 = vx + 1) &
                                (for j being Element of INT st
                                   Signed32.o4 <= j &
                                   j < Signed32.sz
                                 holds
                                   Pelt.[x2,Offset.x2+j] =
                                     Pelt.[x,Offset.x2+j]) &
                                (for j being Element of INT st
                                   j < Offset.x2 or
                                   Offset.x2 + Signed32.sz <= j
                                 holds
                                   Pelt.[x2,j] = Pelt.[x,j]))))))) &
             (o2 <> TRUE implies
               (for vx1,vx being Integer st
                  vx1 =
                    VSub.[x1,
                      [Offset.x1,Offset.x1+Signed32.sz]] &
                  vx =
                    VSub.[x,
                      [Offset.x,Offset.x+Signed32.sz]]
                holds vx1 = vx + 1) &
               (for j being Element of INT st
                  j < Offset.x1 or
                  Offset.x1 + Signed32.sz <= j
                holds Pelt.[x1,j] = Pelt.[x,j])))))
proof
end;
::$P+
