:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/add_Add_add_ryqtvc: the verification condition for
:: adding two multiprecision integers represented by total integer-indexed
:: limb maps, preserving carry, pointer aliasing, value, and framing
:: invariants.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z,M being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      Zr,Zx,Zy being Function of M,Z,
      Mr,Mx,My,Lr,Lx,Ly being Function of M,INT,
      Okay being Function of M,BOOLEAN,
      sy,sx being Element of INT,
      x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, j being Element of INT holds
      for pj being Integer st pj = Pelt.[p,j] holds
        0 <= pj & pj < (2 |^ 64)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    (for m being Element of M holds
      0 <= Mr.m & Mr.m < (2 |^ 32) &
      0 <= Mx.m & Mx.m < (2 |^ 32) &
      0 <= My.m & My.m < (2 |^ 32) &
      0 <= Lr.m & Lr.m < (2 |^ 32) &
      0 <= Lx.m & Lx.m < (2 |^ 32) &
      0 <= Ly.m & Ly.m < (2 |^ 32)) &
    0 <= sy & sy < (2 |^ 32) &
    0 <= sx & sx < (2 |^ 32) &
    0 <= Signed32.sy &
    Signed32.sy <= Signed32.sx &
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sx <= Maximum.x &
     Maximum.x <= Len.x) &
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sx <= Maximum.y &
     Maximum.y <= Len.y) &
    Writable.y = TRUE
  holds
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sx <= Maximum.y &
     Maximum.y <= Len.y) &
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sx <= Maximum.x &
     Maximum.x <= Len.x) &
    0 <= Signed32.sx &
    Signed32.sx <= Signed32.sx &
    Writable.y = TRUE &
    (for y1,x1 being Element of P st
       Offset.y1 = Offset.y &
       Writable.y1 = Writable.y &
       Zone.y1 = Zone.y
     holds
       (Offset.x1 = Offset.x &
        Writable.x1 = Writable.x &
        Zone.x1 = Zone.x
        implies
          (for nr,ny,nx being Element of P,
               m being Element of M st
             Writable.nr = TRUE &
             (VSub.[ny,
                [Offset.ny,Offset.ny+Signed32.sx]] =
              VSub.[y,
                [Offset.y,Offset.y+Signed32.sx]] &
              VSub.[nx,
                [Offset.nx,Offset.nx+Signed32.sx]] =
              VSub.[x,
                [Offset.x,Offset.x+Signed32.sx]]) &
             ((-(2 |^ 31) <= Signed32.sx &
               Signed32.sx <= 2147483647 &
               0 <= Signed32.sx &
               0 <= Minimum.ny &
               Minimum.ny <= Offset.ny &
               Offset.ny + Signed32.sx <= Maximum.ny &
               Maximum.ny <= Len.ny) &
              (-(2 |^ 31) <= Signed32.sx &
               Signed32.sx <= 2147483647 &
               0 <= Signed32.sx &
               0 <= Minimum.nx &
               Minimum.nx <= Offset.nx &
               Offset.nx + Signed32.sx <= Maximum.nx &
               Maximum.nx <= Len.nx)) &
             ((Len.nr = Len.ny &
               (for j being Element of INT holds
                  Pelt.[nr,j] = Pelt.[ny,j])) &
              Offset.nr = Offset.ny &
              Minimum.nr = Minimum.ny &
              Maximum.nr = Maximum.ny &
              Zone.nr = Zone.ny) &
             ((0 <= Offset.ny &
               Offset.ny + Signed32.sx <= Offset.nx) or
              (0 <= Offset.nx &
               Offset.nx + Signed32.sx <= Offset.ny)) &
             (Zx.m = Zone.y1 & Zy.m = Zone.x1) &
             (Signed32.(Mx.m) = Maximum.y &
              Signed32.(My.m) = Maximum.x) &
             (Lx.m = sx & Ly.m = sx) &
             Okay.m = TRUE &
             (for i being Element of INT st
                0 <= i & i < Signed32.sx
              holds
                Pelt.[ny,Offset.ny+i] =
                  Pelt.[y1,Offset.y1+i]) &
             (for i being Element of INT st
                0 <= i & i < Signed32.sx
              holds
                Pelt.[nx,Offset.nx+i] =
                  Pelt.[x1,Offset.x1+i]) &
             (for j being Element of INT holds
                Pelt.[y1,j] = Pelt.[y,j]) &
             (for j being Element of INT holds
                Pelt.[x1,j] = Pelt.[x,j]) &
             Len.y1 = Len.y &
             Len.x1 = Len.x &
             Minimum.y1 = Minimum.y &
             Minimum.x1 = Minimum.x &
             (Len.nr = Len.ny &
              (for j being Element of INT holds
                 Pelt.[nr,j] = Pelt.[ny,j])) &
             (Len.ny = Len.nx &
              (for j being Element of INT holds
                 Pelt.[ny,j] = Pelt.[nx,j]))
           holds
             (((0 <= Signed32.sy &
                Signed32.sy <= Signed32.sx) &
               ((-(2 |^ 31) <= Signed32.sx &
                 Signed32.sx <= 2147483647 &
                 0 <= Signed32.sx &
                 0 <= Minimum.nr &
                 Minimum.nr <= Offset.nr &
                 Offset.nr + Signed32.sx <= Maximum.nr &
                 Maximum.nr <= Len.nr) &
                (-(2 |^ 31) <= Signed32.sx &
                 Signed32.sx <= 2147483647 &
                 0 <= Signed32.sx &
                 0 <= Minimum.nx &
                 Minimum.nx <= Offset.nx &
                 Offset.nx + Signed32.sx <= Maximum.nx &
                 Maximum.nx <= Len.nx) &
                (-(2 |^ 31) <= Signed32.sy &
                 Signed32.sy <= 2147483647 &
                 0 <= Signed32.sy &
                 0 <= Minimum.ny &
                 Minimum.ny <= Offset.ny &
                 Offset.ny + Signed32.sy <= Maximum.ny &
                 Maximum.ny <= Len.ny)) &
               (Offset.nr = Offset.nx or
                Offset.nr + Signed32.sx <= Offset.nx or
                Offset.nx + Signed32.sx <= Offset.nr) &
               (Offset.nr = Offset.ny or
                Offset.nr + Signed32.sx <= Offset.ny or
                Offset.ny + Signed32.sy <= Offset.nr) &
               (Len.nr = Len.nx &
                (for j being Element of INT holds
                   Pelt.[nr,j] = Pelt.[nx,j])) &
               (Len.nx = Len.ny &
                (for j being Element of INT holds
                   Pelt.[nx,j] = Pelt.[ny,j])) &
               Writable.nr = TRUE) &
              (for nx1,ny1,nr1 being Element of P st
                 (Len.nx1 = Len.nr1 &
                  (for j being Element of INT holds
                     Pelt.[nx1,j] = Pelt.[nr1,j])) &
                 Len.nr1 = Len.nx &
                 Offset.nx1 = Offset.nx &
                 Minimum.nx1 = Minimum.nx &
                 Maximum.nx1 = Maximum.nx &
                 Writable.nx1 = Writable.nx &
                 Zone.nx1 = Zone.nx
               holds
                 (((Len.ny1 = Len.nr1 &
                    (for j being Element of INT holds
                       Pelt.[ny1,j] = Pelt.[nr1,j])) &
                   Len.nr1 = Len.ny &
                   Offset.ny1 = Offset.ny &
                   Minimum.ny1 = Minimum.ny &
                   Maximum.ny1 = Maximum.ny &
                   Writable.ny1 = Writable.ny &
                   Zone.ny1 = Zone.ny)
                  implies
                    ((Len.nr1 = Len.nr &
                      Offset.nr1 = Offset.nr &
                      Minimum.nr1 = Minimum.nr &
                      Maximum.nr1 = Maximum.nr &
                      Writable.nr1 = Writable.nr &
                      Zone.nr1 = Zone.nr)
                     implies
                       (for res being Element of INT st
                          0 <= res & res < (2 |^ 64)
                        holds
                          (((for vnr,vnx,vny,power being Integer st
                               vnr = VSub.[nr1,
                                 [Offset.nr1,
                                  Offset.nr1+Signed32.sx]] &
                               vnx = VSub.[nx,
                                 [Offset.nx,
                                  Offset.nx+Signed32.sx]] &
                               vny = VSub.[ny,
                                 [Offset.ny,
                                  Offset.ny+Signed32.sy]] &
                               power = Pow.(Signed32.sx)
                             holds
                               vnr + power * res = vnx + vny) &
                            (0 <= res & res <= 1) &
                            (for j being Element of INT st
                               j < Offset.nr1 or
                               Offset.nr1 + Signed32.sx <= j
                             holds
                               Pelt.[nr1,j] = Pelt.[nr,j]) &
                            (Offset.nr1 = Offset.nx1 or
                             (for i being Element of INT st
                                Offset.nx1 <= i &
                                i < Offset.nx1 + Signed32.sx
                              holds
                                Pelt.[nx1,i] = Pelt.[nx,i])) &
                            (Offset.nr1 = Offset.ny1 or
                             (for i being Element of INT st
                                Offset.ny1 <= i &
                                i < Offset.ny1 + Signed32.sy
                              holds
                                Pelt.[ny1,i] = Pelt.[ny,i])))
                           implies
                             (((Writable.y1 = TRUE &
                                Writable.nr1 = TRUE) &
                               Okay.m = TRUE &
                               (0 <= Signed32.sx &
                                Signed32.sx <= Signed32.sx) &
                               ((Len.nr1 = Len.ny1 &
                                 (for j being Element of INT holds
                                    Pelt.[nr1,j] = Pelt.[ny1,j])) &
                                Offset.nr1 = Offset.ny1 &
                                Minimum.nr1 = Minimum.ny1 &
                                Maximum.nr1 = Maximum.ny1 &
                                Zone.nr1 = Zone.ny1) &
                               ((0 <= Offset.ny1 &
                                 Offset.ny1 + Signed32.sx <=
                                   Offset.nx1) or
                                (0 <= Offset.nx1 &
                                 Offset.nx1 + Signed32.sx <=
                                   Offset.ny1)) &
                               (Zx.m = Zone.y1 &
                                Zy.m = Zone.x1) &
                               Lx.m = sx &
                               Ly.m = sx) &
                              (for m1 being Element of M,
                                   nx2,ny2,y2,x2 being Element of P st
                                 Zr.m1 = Zr.m &
                                 Zx.m1 = Zx.m &
                                 Zy.m1 = Zy.m &
                                 Mr.m1 = Mr.m &
                                 Mx.m1 = Mx.m &
                                 My.m1 = My.m &
                                 Lr.m1 = Lr.m &
                                 Lx.m1 = Lx.m &
                                 Ly.m1 = Ly.m
                               holds
                                 ((Offset.nx2 = Offset.nx1 &
                                   Writable.nx2 = Writable.nx1 &
                                   Zone.nx2 = Zone.nx1)
                                  implies
                                    ((Offset.ny2 = Offset.ny1 &
                                      Writable.ny2 = Writable.ny1 &
                                      Zone.ny2 = Zone.ny1)
                                     implies
                                       ((Offset.y2 = Offset.y1 &
                                         Minimum.y2 = Minimum.y1 &
                                         Writable.y2 = Writable.y1 &
                                         Zone.y2 = Zone.y1)
                                        implies
                                          ((Offset.x2 = Offset.x1 &
                                            Minimum.x2 = Minimum.x1 &
                                            Writable.x2 = Writable.x1 &
                                            Zone.x2 = Zone.x1)
                                           implies
                                             (((Maximum.y2 =
                                                  Signed32.(Mx.m1) &
                                                Maximum.x2 =
                                                  Signed32.(My.m1)) &
                                               (for i being Element of INT st
                                                  0 <= i &
                                                  i < Signed32.sx
                                                holds
                                                  Pelt.[ny1,Offset.ny2+i] =
                                                    Pelt.[y2,Offset.y2+i]) &
                                               (for i being Element of INT st
                                                  0 <= i &
                                                  i < Signed32.sx
                                                holds
                                                  Pelt.[nx1,Offset.nx2+i] =
                                                    Pelt.[x2,Offset.x2+i]) &
                                               (for j being Element of INT st
                                                  j < Offset.y2 or
                                                  Offset.y2 +
                                                    Signed32.sx <= j
                                                holds
                                                  Pelt.[y2,j] =
                                                    Pelt.[y1,j]) &
                                               (for j being Element of INT st
                                                  j < Offset.x2 or
                                                  Offset.x2 +
                                                    Signed32.sx <= j
                                                holds
                                                  Pelt.[x2,j] =
                                                    Pelt.[x1,j]) &
                                               (Len.y2 = Len.y1 &
                                                Len.x2 = Len.x1) &
                                               Minimum.y2 = Minimum.y1 &
                                               Minimum.x2 = Minimum.x1)
                                              implies
                                                ((for vy2,vx,vy,power
                                                    being Integer st
                                                    vy2 = VSub.[y2,
                                                      [Offset.y2,
                                                       Offset.y2+
                                                         Signed32.sx]] &
                                                    vx = VSub.[x,
                                                      [Offset.x,
                                                       Offset.x+
                                                         Signed32.sx]] &
                                                    vy = VSub.[y,
                                                      [Offset.y,
                                                       Offset.y+
                                                         Signed32.sy]] &
                                                    power =
                                                      Pow.(Signed32.sx)
                                                  holds
                                                    vy2 + power * res =
                                                      vx + vy) &
                                                 (0 <= res &
                                                  res <= 1) &
                                                 (for j being Element of INT st
                                                    j < Offset.y2 or
                                                    Offset.y2 +
                                                      Signed32.sx <= j
                                                  holds
                                                    Pelt.[y2,j] =
                                                      Pelt.[y,j]) &
                                                 (for j being Element of INT
                                                  holds
                                                    Pelt.[x2,j] =
                                                      Pelt.[x,j]) &
                                                 VSub.[x2,
                                                   [Offset.x2,
                                                    Offset.x2+
                                                      Signed32.sx]] =
                                                   VSub.[x,
                                                     [Offset.x,
                                                      Offset.x+
                                                        Signed32.sx]] &
                                                 (Minimum.x2 = Minimum.x &
                                                  Maximum.x2 = Maximum.x &
                                                  Len.x2 = Len.x) &
                                                 Minimum.y2 = Minimum.y &
                                                 Maximum.y2 = Maximum.y &
                                                 Len.y2 =
                                                   Len.y))))))))))
                                           )))))))
proof
end;
::$P+
