:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/add_Add_add_n_rxyqtvc: the multiprecision
:: self-addition verification condition preserves the value equation, carry
:: bound, out-of-range limbs, and pointer bounds and length metadata.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Data being Function of P,INT*,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      sx being Element of INT,
      x being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, k being Nat st k in dom (Data.p)
     holds
       ex d being Integer st
         d = (Data.p).k & 0 <= d & d < (2 |^ 64)) &
    (for p being Element of P, j being Integer holds
      (len (Data.p) = 0 implies Pelt.[p,j] = 0) &
      (j < 0 & 0 < len (Data.p) implies
        Pelt.[p,j] = (Data.p).1) &
      (0 <= j & j < len (Data.p) implies
        Pelt.[p,j] = (Data.p).(j+1)) &
      (len (Data.p) <= j implies Pelt.[p,j] = 0)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    0 <= sx & sx < (2 |^ 32) &
    0 <= Signed32.sx &
    Writable.x = TRUE &
    -(2 |^ 31) <= Signed32.sx &
    Signed32.sx <= 2147483647 &
    0 <= Signed32.sx &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + Signed32.sx <= Maximum.x &
    Maximum.x <= len (Data.x)
  holds
    0 <= Signed32.sx &
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sx <= Maximum.x &
     Maximum.x <= len (Data.x)) &
    Writable.x = TRUE &
    (for x1 being Element of P st
       len (Data.x1) = len (Data.x) &
       Offset.x1 = Offset.x &
       Minimum.x1 = Minimum.x &
       Maximum.x1 = Maximum.x &
       Writable.x1 = Writable.x &
       Zone.x1 = Zone.x
     holds
       for result being Element of INT st
         0 <= result & result < (2 |^ 64)
       holds
         (((for vx1,vx,power being Integer st
              vx1 = VSub.[x1,
                [Offset.x1,Offset.x1+Signed32.sx]] &
              vx = VSub.[x,
                [Offset.x,Offset.x+Signed32.sx]] &
              power = Pow.(Signed32.sx)
            holds vx1 + power * result = vx + vx) &
           (0 <= result & result <= 1) &
           (for j being Element of INT st
              j < Offset.x1 or Offset.x1 + Signed32.sx <= j
            holds Pelt.[x1,j] = Pelt.[x,j]))
          implies
            (for vx1,vx,power being Integer st
               vx1 = VSub.[x1,
                 [Offset.x1,Offset.x1+Signed32.sx]] &
               vx = VSub.[x,
                 [Offset.x,Offset.x+Signed32.sx]] &
               power = Pow.(Signed32.sx)
             holds vx1 + power * result = vx + vx) &
            (0 <= result & result <= 1) &
            (for j being Element of INT st
               j < Offset.x1 or Offset.x1 + Signed32.sx <= j
             holds Pelt.[x1,j] = Pelt.[x,j]) &
            Minimum.x1 = Minimum.x &
            Maximum.x1 = Maximum.x &
            len (Data.x1) = len (Data.x)))
proof
end;
::$P+
