:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/base_info_BaseInfo_wmpn_limb_size_in_base_2qtvc:
:: the limb bit-length verification condition relates a positive unsigned
:: 64-bit word to the complementary leading-zero count and its consecutive
:: powers-of-two bounds. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, RELAT_1,
    FUNCT_1, FUNCT_2, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, VALUED_0, VALUED_1,
    NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NEWTON,
    RELAT_1, FUNCT_1, FUNCT_2;
  constructors REAL_1, NAT_1, NEWTON, RELSET_1, FUNCT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, INT_1, NEWTON, CARD_1, MEMBERED, VALUED_0,
    VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Signed32 being Function of INT,INT,
      u being Integer st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    0 <= u & u < (2 |^ 64) &
    0 < u
  holds
    0 < u &
    (for o1 being Integer st 0 <= o1 & o1 < (2 |^ 32) holds
      for s being Element of INT st s = Signed32.o1 holds
        for n being Nat st
          n = s &
          (2 |^ n) * u <= (2 |^ 64) - 1 &
          (2 |^ 64) - 1 < 2 * (2 |^ n) * u &
          0 <= s &
          s < 64
        holds
          0 <= s &
          (for shift being Integer st
            0 <= shift & shift < (2 |^ 64) &
            shift = s
          holds
            0 <= 64 - shift &
            64 - shift <= (2 |^ 64) - 1 &
            (for r being Integer st
              0 <= r & r < (2 |^ 64) &
              r = 64 - shift
            holds
              (1 <= r & r <= 64) &
              (for e being Nat st e = r - 1 holds
                (2 |^ e) <= u) &
              (for e being Nat st e = r holds
                u < (2 |^ e)))))
proof
end;
::$P+
