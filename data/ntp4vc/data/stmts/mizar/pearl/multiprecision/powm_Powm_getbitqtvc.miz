:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/powm_Powm_getbitqtvc: the verification condition
:: for extracting one bit from a multiprecision integer and relating it to
:: the recurrence for the value of its low-bit prefix. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,D,Z being non empty set,
      Len being Function of P,NAT,
      Data being Function of P,D,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Value,ValueB being Function of [:P,INT:],INT,
      Pow2,PowRadix being Function of INT,INT,
      p being Element of P,
      pn,bi being Element of INT
  st
    (for q being Element of P, j being Element of INT holds
       for limb being Integer st limb = Pelt.[q,j] holds
         0 <= limb & limb < (2 |^ 64)) &
    (for e being Element of INT st 0 <= e holds
       ex n being Nat st
         n = e &
         Pow2.e = 2 |^ n &
         PowRadix.e = (2 |^ 64) |^ n) &
    (for q being Element of P, n,m being Element of INT holds
       (n < m implies
          for v,limb,vnext being Integer st
            v = VSub.[q,[n,m]] &
            limb = Pelt.[q,n] &
            vnext = VSub.[q,[n+1,m]]
          holds
            v = limb + (2 |^ 64) * vnext) &
       (not n < m implies VSub.[q,[n,m]] = 0)) &
    (for q being Element of P, sz being Element of INT holds
       Value.[q,sz] =
         VSub.[q,[Offset.q,Offset.q+sz]]) &
    (for q being Element of P, nbits being Element of INT holds
       (nbits < 0 implies ValueB.[q,nbits] = 0) &
       (0 <= nbits implies
          ex i being Element of INT st
            i = nbits div 64 &
            (for vb,v,radixPower,limb,bitPower being Integer st
               vb = ValueB.[q,nbits] &
               v = Value.[q,i] &
               radixPower = PowRadix.i &
               limb = Pelt.[q,Offset.q+i] &
               bitPower = Pow2.(nbits-64*i)
             holds
               vb = v + radixPower * (limb mod bitPower)))) &
    -(2 |^ 31) <= pn & pn <= 2147483647 &
    -(2 |^ 31) <= bi & bi <= 2147483647 &
    -(2 |^ 31) <= pn & pn <= 2147483647 &
    0 <= pn &
    0 <= Minimum.p &
    Minimum.p <= Offset.p &
    Offset.p + pn <= Maximum.p &
    Maximum.p <= Len.p &
    1 <= bi &
    (bi + 63) div 64 <= pn
  holds
    -(2 |^ 31) <= bi - 1 &
    bi - 1 <= 2147483647 &
    (for o1 being Element of INT st
       -(2 |^ 31) <= o1 & o1 <= 2147483647 &
       o1 = bi - 1
     holds
       64 <> 0 &
       -(2 |^ 31) <= o1 div 64 &
       o1 div 64 <= 2147483647 &
       (for i being Element of INT st
          -(2 |^ 31) <= i & i <= 2147483647 &
          i = o1 div 64
        holds
          -(2 |^ 31) <= bi - 1 &
          bi - 1 <= 2147483647 &
          (for o2 being Element of INT st
             -(2 |^ 31) <= o2 & o2 <= 2147483647 &
             o2 = bi - 1
           holds
             0 <= o2 &
             (for o3 being Element of INT st
                0 <= o3 & o3 < (2 |^ 64) &
                o3 = o2
              holds
                64 <> 0 &
                0 <= o3 mod 64 &
                o3 mod 64 <= (2 |^ 64) - 1 &
                (for mi being Element of INT st
                   0 <= mi & mi < (2 |^ 64) &
                   mi = o3 mod 64
                 holds
                   Minimum.p <= Offset.p + i &
                   Offset.p + i < Maximum.p &
                   -(2 |^ 31) <= i + 1 &
                   i + 1 <= 2147483647 &
                   (for o4 being Element of INT st
                      -(2 |^ 31) <= o4 &
                      o4 <= 2147483647 &
                      o4 = i + 1
                    holds
                      Minimum.p <= Offset.p + o4 &
                      Offset.p + o4 <= Maximum.p &
                      (for p1 being Element of P st
                         Offset.p1 = Offset.p + o4 &
                         Len.p1 = Len.p &
                         (for j being Element of INT holds
                            Pelt.[p1,j] = Pelt.[p,j]) &
                         Data.p1 = Data.p &
                         Minimum.p1 = Minimum.p &
                         Maximum.p1 = Maximum.p &
                         Zone.p1 = Zone.p &
                         Writable.p1 = Writable.p
                       holds
                         0 <= mi & mi < 64 &
                         (for limb,bitPower being Integer st
                            limb = Pelt.[p,Offset.p+i] &
                            bitPower = Pow2.mi
                          holds
                            for lps being Element of INT st
                              0 <= lps & lps < (2 |^ 64) &
                              lps = limb div bitPower
                            holds
                              bitPower <> 0 &
                              2 <> 0 &
                              0 <= lps mod 2 &
                              lps mod 2 <= (2 |^ 64) - 1 &
                              (for res being Element of INT st
                                 0 <= res & res < (2 |^ 64) &
                                 res = lps mod 2
                               holds
                                 2 <> 0 &
                                 2 <> 0 &
                                 0 <= lps mod 2 &
                                 lps mod 2 <= (2 |^ 64) - 1 &
                                 (for result being Element of INT st
                                    0 <= result &
                                    result < (2 |^ 64) &
                                    result = lps mod 2
                                  holds
                                    0 <= result & result <= 1 &
                                    (for whole,vb,vbPrev,powerBi
                                       being Integer st
                                       whole = Value.[p,pn] &
                                       vb = ValueB.[p,bi] &
                                       vbPrev = ValueB.[p,bi-1] &
                                       powerBi = Pow2.(bi-1)
                                     holds
                                       result =
                                         (whole div powerBi) mod 2 &
                                       vb =
                                         vbPrev +
                                           powerBi * result)))))))))))
proof
end;
::$P+
