:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/compare_Compare_wmpn_cmpqtvc: the multiprecision
:: comparison verification condition maintains equality of the unexamined
:: high limbs and returns the comparison of the represented unsigned values.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Compare being Function of [:INT,INT:],INT,
      sz being Element of INT,
      x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, j being Element of INT holds
      for limb being Integer st limb = Pelt.[p,j] holds
        0 <= limb & limb < (2 |^ 64)) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        for v,pn,vnext being Integer st
          v = VSub.[p,[n,m]] &
          pn = Pelt.[p,n] &
          vnext = VSub.[p,[n+1,m]]
        holds
          v = pn + (2 |^ 64) * vnext) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    (for a,b being Element of INT holds
      (a < b implies Compare.[a,b] = -1) &
      (not a < b & a = b implies Compare.[a,b] = 0) &
      (not a < b & a <> b implies Compare.[a,b] = 1)) &
    0 <= sz & sz < (2 |^ 32) &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sz <= Maximum.x &
     Maximum.x <= Len.x) &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sz <= Maximum.y &
     Maximum.y <= Len.y)
  holds
    0 <= Signed32.sz &
    Signed32.sz <= Signed32.sz &
    (for j being Element of INT st
       Signed32.sz <= j & j < Signed32.sz
     holds
       Pelt.[x,Offset.x+j] = Pelt.[y,Offset.y+j]) &
    (for i being Element of INT st 0 <= i & i < (2 |^ 32) holds
      (((0 <= Signed32.i & Signed32.i <= Signed32.sz) &
        (for j being Element of INT st
           Signed32.i <= j & j < Signed32.sz
         holds
           Pelt.[x,Offset.x+j] = Pelt.[y,Offset.y+j]))
       implies
        ((1 <= Signed32.i implies
          (-(2 |^ 31) <= Signed32.i - 1 &
           Signed32.i - 1 <= 2147483647) &
          (for o1 being Element of INT st
             0 <= o1 & o1 < (2 |^ 32) &
             Signed32.o1 = Signed32.i - 1
           holds
             (Minimum.x <= Offset.x + Signed32.o1 &
              Offset.x + Signed32.o1 < Maximum.x) &
             (for lx being Integer st
                lx = Pelt.[x,Offset.x+Signed32.o1]
              holds
                (Minimum.y <= Offset.y + Signed32.o1 &
                 Offset.y + Signed32.o1 < Maximum.y) &
                (for ly being Integer st
                   ly = Pelt.[y,Offset.y+Signed32.o1]
                 holds
                   for o2 being Element of BOOLEAN st
                     (lx = ly implies o2 = TRUE) &
                     (o2 = TRUE implies lx = ly)
                   holds
                     (o2 <> TRUE implies
                       ((ly < lx implies
                         1 =
                           Compare.
                             [VSub.[x,
                                [Offset.x,
                                 Offset.x+Signed32.sz]],
                              VSub.[y,
                                [Offset.y,
                                 Offset.y+Signed32.sz]]]) &
                        (not ly < lx implies
                         -1 =
                           Compare.
                             [VSub.[x,
                                [Offset.x,
                                 Offset.x+Signed32.sz]],
                              VSub.[y,
                                [Offset.y,
                                 Offset.y+Signed32.sz]]]))) &
                     (o2 = TRUE implies
                       Signed32.o1 < Signed32.i &
                       (0 <= Signed32.o1 &
                        Signed32.o1 <= Signed32.sz) &
                       (for j being Element of INT st
                          Signed32.o1 <= j &
                          j < Signed32.sz
                        holds
                          Pelt.[x,Offset.x+j] =
                            Pelt.[y,Offset.y+j]))))) &
         (not 1 <= Signed32.i implies
           0 =
             Compare.
               [VSub.[x,
                  [Offset.x,Offset.x+Signed32.sz]],
                VSub.[y,
                  [Offset.y,Offset.y+Signed32.sz]]])))))
proof
end;
::$P+
