:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_Sub_sub_rxqtvc: the verification condition for
:: alias-aware unequal-length multiprecision subtraction into the first
:: operand over total integer-indexed limb maps, preserving the borrow
:: equation, memory framing, the second operand, and pointer metadata.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z,M being non empty set,
      Data being Function of [:P,INT:],INT,
      DataLength being Function of P,INT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      Zr,Zx,Zy being Function of M,Z,
      Mr,Mx,My,Lr,Lx,Ly being Function of M,INT,
      Okay being Function of M,BOOLEAN,
      sx,sy being Element of INT,
      x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P holds 0 <= DataLength.p) &
    (for p being Element of P, j being Element of INT holds
      ex d being Integer st
        d = Data.[p,j] & 0 <= d & d < (2 |^ 64)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Data.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    (for m being Element of M holds
      0 <= Mr.m & Mr.m < (2 |^ 32) &
      0 <= Mx.m & Mx.m < (2 |^ 32) &
      0 <= My.m & My.m < (2 |^ 32) &
      0 <= Lr.m & Lr.m < (2 |^ 32) &
      0 <= Lx.m & Lx.m < (2 |^ 32) &
      0 <= Ly.m & Ly.m < (2 |^ 32)) &
    0 <= sx & sx < (2 |^ 32) &
    0 <= sy & sy < (2 |^ 32) &
    0 <= Signed32.sy &
    Signed32.sy <= Signed32.sx &
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sx <= Maximum.x &
     Maximum.x <= DataLength.x) &
    (-(2 |^ 31) <= Signed32.sy &
     Signed32.sy <= 2147483647 &
     0 <= Signed32.sy &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sy <= Maximum.y &
     Maximum.y <= DataLength.y) &
    Writable.x = TRUE
  holds
    (-(2 |^ 31) <= Signed32.sx &
     Signed32.sx <= 2147483647 &
     0 <= Signed32.sx &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sx <= Maximum.x &
     Maximum.x <= DataLength.x) &
    (-(2 |^ 31) <= Signed32.sy &
     Signed32.sy <= 2147483647 &
     0 <= Signed32.sy &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sy <= Maximum.y &
     Maximum.y <= DataLength.y) &
    0 <= Signed32.sy &
    Signed32.sy <= Signed32.sx &
    Writable.x = TRUE &
    (for y1,x1 being Element of P st
       Offset.y1 = Offset.y &
       Writable.y1 = Writable.y &
       Zone.y1 = Zone.y
     holds
       (Offset.x1 = Offset.x &
        Writable.x1 = Writable.x &
        Zone.x1 = Zone.x
        implies
          (for nr,nx,ny being Element of P,
               m being Element of M st
             Writable.nr = TRUE &
             (VSub.[nx,
                [Offset.nx,Offset.nx+Signed32.sx]] =
              VSub.[x,
                [Offset.x,Offset.x+Signed32.sx]] &
              VSub.[ny,
                [Offset.ny,Offset.ny+Signed32.sy]] =
              VSub.[y,
                [Offset.y,Offset.y+Signed32.sy]]) &
             ((-(2 |^ 31) <= Signed32.sx &
               Signed32.sx <= 2147483647 &
               0 <= Signed32.sx &
               0 <= Minimum.nx &
               Minimum.nx <= Offset.nx &
               Offset.nx + Signed32.sx <= Maximum.nx &
               Maximum.nx <= DataLength.nx) &
              (-(2 |^ 31) <= Signed32.sy &
               Signed32.sy <= 2147483647 &
               0 <= Signed32.sy &
               0 <= Minimum.ny &
               Minimum.ny <= Offset.ny &
               Offset.ny + Signed32.sy <= Maximum.ny &
               Maximum.ny <= DataLength.ny)) &
             (DataLength.nr = DataLength.nx &
              (for j being Element of INT holds
                Data.[nr,j] = Data.[nx,j]) &
              Offset.nr = Offset.nx &
              Minimum.nr = Minimum.nx &
              Maximum.nr = Maximum.nx &
              Zone.nr = Zone.nx) &
             ((0 <= Offset.nx &
              Offset.nx + Signed32.sx <= Offset.ny) or
              (0 <= Offset.ny &
               Offset.ny + Signed32.sy <= Offset.nx)) &
             (Zx.m = Zone.x1 & Zy.m = Zone.y1) &
             (Signed32.(Mx.m) = Maximum.x &
              Signed32.(My.m) = Maximum.y) &
             (Lx.m = sx & Ly.m = sy) &
             Okay.m = TRUE &
             (for i being Element of INT st
                0 <= i & i < Signed32.sx
              holds
                Data.[nx,Offset.nx+i] =
                  Data.[x1,Offset.x1+i]) &
             (for i being Element of INT st
                0 <= i & i < Signed32.sy
              holds
                Data.[ny,Offset.ny+i] =
                  Data.[y1,Offset.y1+i]) &
             (for j being Element of INT holds
                Data.[x1,j] = Data.[x,j]) &
             (for j being Element of INT holds
                Data.[y1,j] = Data.[y,j]) &
             DataLength.x1 = DataLength.x &
             DataLength.y1 = DataLength.y &
             Minimum.x1 = Minimum.x &
             Minimum.y1 = Minimum.y &
             DataLength.nr = DataLength.nx &
             (for j being Element of INT holds
               Data.[nr,j] = Data.[nx,j]) &
             DataLength.nx = DataLength.ny &
             (for j being Element of INT holds
               Data.[nx,j] = Data.[ny,j])
           holds
             ((0 <= Signed32.sy &
               Signed32.sy <= Signed32.sx &
               ((-(2 |^ 31) <= Signed32.sx &
                 Signed32.sx <= 2147483647 &
                 0 <= Signed32.sx &
                 0 <= Minimum.nr &
                 Minimum.nr <= Offset.nr &
                 Offset.nr + Signed32.sx <= Maximum.nr &
                 Maximum.nr <= DataLength.nr) &
                (-(2 |^ 31) <= Signed32.sx &
                 Signed32.sx <= 2147483647 &
                 0 <= Signed32.sx &
                 0 <= Minimum.nx &
                 Minimum.nx <= Offset.nx &
                 Offset.nx + Signed32.sx <= Maximum.nx &
                 Maximum.nx <= DataLength.nx) &
                (-(2 |^ 31) <= Signed32.sy &
                 Signed32.sy <= 2147483647 &
                 0 <= Signed32.sy &
                 0 <= Minimum.ny &
                 Minimum.ny <= Offset.ny &
                 Offset.ny + Signed32.sy <= Maximum.ny &
                 Maximum.ny <= DataLength.ny)) &
               (Offset.nr = Offset.nx or
                Offset.nr + Signed32.sx <= Offset.nx or
                Offset.nx + Signed32.sx <= Offset.nr) &
               (Offset.nr = Offset.ny or
                Offset.nr + Signed32.sx <= Offset.ny or
                Offset.ny + Signed32.sy <= Offset.nr) &
               (DataLength.nr = DataLength.nx &
                (for j being Element of INT holds
                  Data.[nr,j] = Data.[nx,j]) &
                DataLength.nx = DataLength.ny &
                (for j being Element of INT holds
                  Data.[nx,j] = Data.[ny,j])) &
               Writable.nr = TRUE) &
              (for ny1,nx1,nr1 being Element of P st
                 DataLength.ny1 = DataLength.nr1 &
                 (for j being Element of INT holds
                   Data.[ny1,j] = Data.[nr1,j]) &
                 DataLength.nr1 = DataLength.ny &
                 Offset.ny1 = Offset.ny &
                 Minimum.ny1 = Minimum.ny &
                 Maximum.ny1 = Maximum.ny &
                 Writable.ny1 = Writable.ny &
                 Zone.ny1 = Zone.ny
               holds
                 ((DataLength.nx1 = DataLength.nr1 &
                   (for j being Element of INT holds
                     Data.[nx1,j] = Data.[nr1,j]) &
                   DataLength.nr1 = DataLength.nx &
                   Offset.nx1 = Offset.nx &
                   Minimum.nx1 = Minimum.nx &
                   Maximum.nx1 = Maximum.nx &
                   Writable.nx1 = Writable.nx &
                   Zone.nx1 = Zone.nx)
                  implies
                    ((DataLength.nr1 = DataLength.nr &
                      Offset.nr1 = Offset.nr &
                      Minimum.nr1 = Minimum.nr &
                      Maximum.nr1 = Maximum.nr &
                      Writable.nr1 = Writable.nr &
                      Zone.nr1 = Zone.nr)
                     implies
                       (for res being Element of INT st
                          0 <= res & res < (2 |^ 64)
                        holds
                          (((for vnr,vnx,vny,power being Integer st
                               vnr = VSub.[nr1,
                                 [Offset.nr1,
                                  Offset.nr1+Signed32.sx]] &
                               vnx = VSub.[nx,
                                 [Offset.nx,
                                  Offset.nx+Signed32.sx]] &
                               vny = VSub.[ny,
                                 [Offset.ny,
                                  Offset.ny+Signed32.sy]] &
                               power = Pow.(Signed32.sx)
                             holds
                               vnr - power * res = vnx - vny) &
                            (0 <= res & res <= 1) &
                            (for j being Element of INT st
                               j < Offset.nr1 or
                               Offset.nr1 + Signed32.sx <= j
                             holds
                               Data.[nr1,j] = Data.[nr,j]) &
                            (Offset.nr1 = Offset.nx1 or
                             (for i being Element of INT st
                                Offset.nx1 <= i &
                                i < Offset.nx1 + Signed32.sx
                              holds
                                Data.[nx1,i] = Data.[nx,i])) &
                            (Offset.nr1 = Offset.ny1 or
                             (for i being Element of INT st
                                Offset.ny1 <= i &
                                i < Offset.ny1 + Signed32.sy
                              holds
                                Data.[ny1,i] = Data.[ny,i])))
                           implies
                             (((Writable.x1 = TRUE &
                                Writable.nr1 = TRUE) &
                               Okay.m = TRUE &
                               (0 <= Signed32.sy &
                                Signed32.sy <= Signed32.sx) &
                               (DataLength.nr1 = DataLength.nx1 &
                                (for j being Element of INT holds
                                  Data.[nr1,j] = Data.[nx1,j]) &
                                Offset.nr1 = Offset.nx1 &
                                Minimum.nr1 = Minimum.nx1 &
                                Maximum.nr1 = Maximum.nx1 &
                                Zone.nr1 = Zone.nx1) &
                               ((0 <= Offset.nx1 &
                                 Offset.nx1 + Signed32.sx <=
                                   Offset.ny1) or
                                (0 <= Offset.ny1 &
                                 Offset.ny1 + Signed32.sy <=
                                   Offset.nx1)) &
                               (Zx.m = Zone.x1 &
                                Zy.m = Zone.y1) &
                               Lx.m = sx &
                               Ly.m = sy) &
                              (for m1 being Element of M,
                                   ny2,nx2,y2,x2 being Element of P st
                                 Zr.m1 = Zr.m &
                                 Zx.m1 = Zx.m &
                                 Zy.m1 = Zy.m &
                                 Mr.m1 = Mr.m &
                                 Mx.m1 = Mx.m &
                                 My.m1 = My.m &
                                 Lr.m1 = Lr.m &
                                 Lx.m1 = Lx.m &
                                 Ly.m1 = Ly.m
                               holds
                                 ((Offset.ny2 = Offset.ny1 &
                                   Writable.ny2 = Writable.ny1 &
                                   Zone.ny2 = Zone.ny1)
                                  implies
                                    ((Offset.nx2 = Offset.nx1 &
                                      Writable.nx2 = Writable.nx1 &
                                      Zone.nx2 = Zone.nx1)
                                     implies
                                       ((Offset.y2 = Offset.y1 &
                                         Minimum.y2 = Minimum.y1 &
                                         Writable.y2 = Writable.y1 &
                                         Zone.y2 = Zone.y1)
                                        implies
                                          ((Offset.x2 = Offset.x1 &
                                            Minimum.x2 = Minimum.x1 &
                                            Writable.x2 = Writable.x1 &
                                            Zone.x2 = Zone.x1)
                                           implies
                                             (((Maximum.x2 =
                                                  Signed32.(Mx.m1) &
                                                Maximum.y2 =
                                                  Signed32.(My.m1)) &
                                               (for i being Element of INT st
                                                  0 <= i &
                                                  i < Signed32.sx
                                                holds
                                                  Data.[nx1,Offset.nx2+i] =
                                                    Data.[x2,Offset.x2+i]) &
                                               (for i being Element of INT st
                                                  0 <= i &
                                                  i < Signed32.sy
                                                holds
                                                  Data.[ny1,Offset.ny2+i] =
                                                    Data.[y2,Offset.y2+i]) &
                                               (for j being Element of INT st
                                                  j < Offset.x2 or
                                                  Offset.x2 +
                                                    Signed32.sx <= j
                                                holds
                                                  Data.[x2,j] =
                                                    Data.[x1,j]) &
                                               (for j being Element of INT st
                                                  j < Offset.y2 or
                                                  Offset.y2 +
                                                    Signed32.sy <= j
                                                holds
                                                  Data.[y2,j] =
                                                    Data.[y1,j]) &
                                               (DataLength.x2 =
                                                  DataLength.x1 &
                                                DataLength.y2 =
                                                  DataLength.y1) &
                                               Minimum.x2 = Minimum.x1 &
                                               Minimum.y2 = Minimum.y1)
                                              implies
                                                ((for vx2,vx,vy,power
                                                    being Integer st
                                                    vx2 = VSub.[x2,
                                                      [Offset.x2,
                                                       Offset.x2+
                                                         Signed32.sx]] &
                                                    vx = VSub.[x,
                                                      [Offset.x,
                                                       Offset.x+
                                                         Signed32.sx]] &
                                                    vy = VSub.[y,
                                                      [Offset.y,
                                                       Offset.y+
                                                         Signed32.sy]] &
                                                    power =
                                                      Pow.(Signed32.sx)
                                                  holds
                                                    vx2 - power * res =
                                                      vx - vy) &
                                                 (0 <= res &
                                                  res <= 1) &
                                                 (for j being Element of INT st
                                                    j < Offset.x2 or
                                                    Offset.x2 +
                                                      Signed32.sx <= j
                                                  holds
                                                    Data.[x2,j] =
                                                      Data.[x,j]) &
                                                 (for j being Element of INT
                                                  holds
                                                    Data.[y2,j] =
                                                      Data.[y,j]) &
                                                 VSub.[y2,
                                                   [Offset.y2,
                                                    Offset.y2+
                                                      Signed32.sy]] =
                                                   VSub.[y,
                                                     [Offset.y,
                                                      Offset.y+
                                                        Signed32.sy]] &
                                                 (Minimum.x2 = Minimum.x &
                                                  Maximum.x2 = Maximum.x &
                                                  DataLength.x2 =
                                                    DataLength.x) &
                                                 Minimum.y2 = Minimum.y &
                                                 Maximum.y2 = Maximum.y &
                                                 DataLength.y2 =
                                                   DataLength.y)))))))))
                                           ))))))))
proof
end;
::$P+
