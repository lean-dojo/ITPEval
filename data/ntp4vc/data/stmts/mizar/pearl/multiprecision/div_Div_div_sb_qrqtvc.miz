:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/div_Div_div_sb_qrqtvc: the verification condition for
:: normalized multiprecision quotient-and-remainder division, including
:: reciprocal quotient estimation, loop preservation, correction, and the
:: final quotient/remainder relation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
  FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
  XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
  VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
  XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
  MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
  ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
  INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
  REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
  NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
  RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
  VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
  NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      sy,sx being Element of INT,
      x,y,q being Element of P
  st
    (for p being Element of P, j being Element of INT holds
      0 <= Pelt/.[p,j] & Pelt/.[p,j] < (2 |^ 64)) &
    Pow/.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow/.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow/.(n+1) = (2 |^ 64)*Pow/.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        VSub/.[p,[n,m]] =
          Pelt/.[p,n]+(2 |^ 64)*VSub/.[p,[n+1,m]]) &
      (not n < m implies VSub/.[p,[n,m]] = 0)) &
    -(2 |^ 31) <= sy & sy <= (2 |^ 31)-1 &
    -(2 |^ 31) <= sx & sx <= (2 |^ 31)-1 &
    3 <= sy & sy <= sx &
    (-(2 |^ 31) <= sx & sx <= (2 |^ 31)-1 & 0 <= sx &
      0 <= Minimum.x & Minimum.x <= Offset.x &
      Offset.x+sx <= Maximum.x & Maximum.x <= Len.x) &
    (-(2 |^ 31) <= sy & sy <= (2 |^ 31)-1 & 0 <= sy &
      0 <= Minimum.y & Minimum.y <= Offset.y &
      Offset.y+sy <= Maximum.y & Maximum.y <= Len.y) &
    (-(2 |^ 31) <= sx-sy & sx-sy <= (2 |^ 31)-1 & 0 <= sx-sy &
      0 <= Minimum.q & Minimum.q <= Offset.q &
      Offset.q+sx-sy <= Maximum.q & Maximum.q <= Len.q) &
    Writable.q = TRUE & Writable.x = TRUE &
    (2 |^ 63) <= Pelt/.[y,Offset.y+sy-1]
  holds
    -(2 |^ 31) <= sx-2 & sx-2 <= (2 |^ 31)-1 &
    Minimum.x <= Offset.x+sx-2 &
    Offset.x+sx-2 <= Maximum.x &
    (for xp0 being Element of P st
      Offset.xp0 = Offset.x+sx-2 & Len.xp0 = Len.x &
      (for j being Element of INT holds
        Pelt/.[xp0,j] = Pelt/.[x,j]) &
      Minimum.xp0 = Minimum.x &
      Maximum.xp0 = Maximum.x & Writable.xp0 = Writable.x &
      Zone.xp0 = Zone.x
     holds
      -(2 |^ 31) <= sx-sy & sx-sy <= (2 |^ 31)-1 &
      Minimum.q <= Offset.q+sx-sy &
      Offset.q+sx-sy <= Maximum.q &
      (for qp0 being Element of P st
        Offset.qp0 = Offset.q+sx-sy & Len.qp0 = Len.q &
        (for j being Element of INT holds
          Pelt/.[qp0,j] = Pelt/.[q,j]) &
        Minimum.qp0 = Minimum.q &
        Maximum.qp0 = Maximum.q & Writable.qp0 = Writable.q &
        Zone.qp0 = Zone.q
       holds
        -(2 |^ 31) <= sy-1 & sy-1 <= (2 |^ 31)-1 &
        Minimum.y <= Offset.y+sy-1 &
        Offset.y+sy-1 < Maximum.y &
        (for dh being Element of INT st dh = Pelt/.[y,Offset.y+sy-1]
         holds
          -(2 |^ 31) <= sy-2 & sy-2 <= (2 |^ 31)-1 &
          Minimum.y <= Offset.y+sy-2 &
          Offset.y+sy-2 < Maximum.y &
          (for dl being Element of INT st dl = Pelt/.[y,Offset.y+sy-2]
           holds
            (2 |^ 63) <= dh &
            (for v being Element of INT st
              0 <= v & v < (2 |^ 64) &
              v = ((2 |^ 64)*(2 |^ 64)*(2 |^ 64)-1) div
                    (dl+(2 |^ 64)*dh) - (2 |^ 64)
             holds
              -(2 |^ 31) <= 2-sy & 2-sy <= (2 |^ 31)-1 &
              Minimum.xp0 <= Offset.xp0+2-sy &
              Offset.xp0+2-sy <= Maximum.xp0 &
              (for xd0 being Element of P st
                Offset.xd0 = Offset.xp0+2-sy & Len.xd0 = Len.xp0 &
                (for j being Element of INT holds
                  Pelt/.[xd0,j] = Pelt/.[xp0,j]) &
                Minimum.xd0 = Minimum.xp0 &
                Maximum.xd0 = Maximum.xp0 &
                Writable.xd0 = Writable.xp0 & Zone.xd0 = Zone.xp0
               holds
                (-(2 |^ 31) <= sy & sy <= (2 |^ 31)-1 & 0 <= sy &
                  0 <= Minimum.xd0 & Minimum.xd0 <= Offset.xd0 &
                  Offset.xd0+sy <= Maximum.xd0 &
                  Maximum.xd0 <= Len.xd0) &
                (for qh being Element of INT st
                  0 <= qh & qh < (2 |^ 64) &
                  ((VSub/.[xd0,[Offset.xd0,Offset.xd0+sy]] >=
                      VSub/.[y,[Offset.y,Offset.y+sy]] implies qh = 1) &
                   (VSub/.[xd0,[Offset.xd0,Offset.xd0+sy]] <
                      VSub/.[y,[Offset.y,Offset.y+sy]] implies qh = 0))
                 holds
                  (qh <> 0 implies 0 <= sy & Writable.xd0 = TRUE) &
                  (for x0,xp being Element of P st
                    ((qh = 0 & x0 = x & xp = xp0) or
                     (qh <> 0 &
                      ex xd1 being Element of P, borrow being Element of INT st
                        (for j being Element of INT holds
                          Pelt/.[xd1,j] = Pelt/.[x0,j]) &
                        Len.x0 = Len.xd0 &
                        Offset.xd1 = Offset.xd0 &
                        Minimum.xd1 = Minimum.xd0 &
                        Maximum.xd1 = Maximum.xd0 &
                        Writable.xd1 = Writable.xd0 &
                        Zone.xd1 = Zone.xd0 &
                        (for j being Element of INT holds
                          Pelt/.[xp,j] = Pelt/.[x0,j]) &
                        Len.x0 = Len.x &
                        Offset.xp = Offset.xp0 &
                        Minimum.xp = Minimum.xp0 &
                        Maximum.xp = Maximum.xp0 &
                        Writable.xp = Writable.xp0 &
                        Zone.xp = Zone.xp0 &
                        Offset.x0 = Offset.x & Minimum.x0 = Minimum.x &
                        Maximum.x0 = Maximum.x & Writable.x0 = Writable.x &
                        Zone.x0 = Zone.x &
                        0 <= borrow & borrow <= 1 &
                        VSub/.[xd1,[Offset.xd1,Offset.xd1+sy]]-
                          Pow/.sy*borrow =
                          VSub/.[xd0,[Offset.xd0,Offset.xd0+sy]]-
                          VSub/.[y,[Offset.y,Offset.y+sy]] &
                        (for j being Element of INT st
                          j < Offset.xd1 or Offset.xd1+sy <= j
                         holds Pelt/.[xd1,j] = Pelt/.[xd0,j])))
                   holds
                    Minimum.xp <= Offset.xp+1 &
                    Offset.xp+1 < Maximum.xp &
                    0 <= sx-sy & Offset.qp0 = Offset.q+sx-sy &
                    Offset.xp = Offset.x0+sy+(sx-sy)-2 &
                    VSub/.[x,[Offset.x,Offset.x+sx]] =
                      (VSub/.[qp0,[Offset.qp0,Offset.qp0]]+
                        qh*Pow/.0) *
                        VSub/.[y,[Offset.y,Offset.y+sy]]*Pow/.(sx-sy) +
                      VSub/.[x0,[Offset.x0,Offset.x0+sx-1]]+
                        Pow/.(sx-1)*Pelt/.[xp,Offset.xp+1] &
                    VSub/.[x0,[Offset.xp+2-sy,Offset.xp+1]]+
                        Pow/.(sy-1)*Pelt/.[xp,Offset.xp+1] <
                      VSub/.[y,[Offset.y,Offset.y+sy]] &
                    Pelt/.[x0,Offset.xp]+
                        (2 |^ 64)*Pelt/.[xp,Offset.xp+1] <=
                      dl+(2 |^ 64)*dh &
                    (for i,x1 being Element of INT,
                         xs,qs,xpi,qpi being Element of P st
                      0 <= x1 & x1 < (2 |^ 64) &
                      -(2 |^ 31) <= i & i <= (2 |^ 31)-1 &
                      Len.xs = Len.x0 & Offset.xs = Offset.x0 &
                      Minimum.xs = Minimum.x0 &
                      Maximum.xs = Maximum.x0 &
                      Writable.xs = Writable.x0 & Zone.xs = Zone.x0 &
                      Len.qs = Len.q & Offset.qs = Offset.q &
                      Minimum.qs = Minimum.q & Maximum.qs = Maximum.q &
                      Writable.qs = Writable.q & Zone.qs = Zone.q &
                      Len.qpi = Len.qs & Minimum.qpi = Minimum.qs &
                      Maximum.qpi = Maximum.qs &
                      Len.xpi = Len.xs & Minimum.xpi = Minimum.xs &
                      Maximum.xpi = Maximum.xs &
                      (for j being Element of INT holds
                        Pelt/.[qpi,j] = Pelt/.[qs,j]) &
                      (for j being Element of INT holds
                        Pelt/.[xpi,j] = Pelt/.[xs,j]) &
                      Writable.qpi = TRUE & Writable.xpi = TRUE &
                      0 <= i & i <= sx-sy &
                      Offset.qpi = Offset.qs+i &
                      Offset.xpi = Offset.xs+sy+i-2 &
                      VSub/.[x,[Offset.x,Offset.x+sx]] =
                        (VSub/.[qpi,
                           [Offset.qpi,Offset.qpi+sx-sy-i]]+
                           qh*Pow/.(sx-sy-i)) *
                           VSub/.[y,[Offset.y,Offset.y+sy]]*Pow/.i +
                        VSub/.[xs,[Offset.xs,Offset.xs+sy+i-1]]+
                          Pow/.(sy+i-1)*x1 &
                      VSub/.[xs,
                        [Offset.xpi+2-sy,
                         Offset.xpi+2-sy+sy-1]]+
                          Pow/.(sy-1)*x1 <
                        VSub/.[y,[Offset.y,Offset.y+sy]] &
                      Pelt/.[xs,Offset.xpi]+(2 |^ 64)*x1 <=
                        dl+(2 |^ 64)*dh
                     holds
                      (0 < i implies
                        -(2 |^ 31) <= i-1 &
                        i-1 <= (2 |^ 31)-1 &
                        Minimum.xpi <= Offset.xpi-1 &
                        Offset.xpi-1 <= Maximum.xpi &
                        (for xps being Element of P st
                          Offset.xps = Offset.xpi-1 &
                          Len.xps = Len.xpi &
                          (for j being Element of INT holds
                            Pelt/.[xps,j] = Pelt/.[xpi,j]) &
                          Minimum.xps = Minimum.xpi &
                          Maximum.xps = Maximum.xpi &
                          Writable.xps = Writable.xpi &
                          Zone.xps = Zone.xpi
                         holds
                          Minimum.xps <= Offset.xps+2-sy &
                          Offset.xps+2-sy <= Maximum.xps &
                          (for xd being Element of P st
                            Offset.xd = Offset.xps+2-sy &
                            Len.xd = Len.xps &
                            (for j being Element of INT holds
                              Pelt/.[xd,j] = Pelt/.[xps,j]) &
                            Minimum.xd = Minimum.xps &
                            Maximum.xd = Maximum.xps &
                            Writable.xd = Writable.xps &
                            Zone.xd = Zone.xps
                           holds
                            Minimum.xps <= Offset.xps+1 &
                            Offset.xps+1 < Maximum.xps &
                            ((x1 = dh &
                              Pelt/.[xps,Offset.xps+1] = dl)
                             implies
                              VSub/.[xd,
                                [Offset.xd+1,Offset.xd+sy-1]]+
                                Pow/.(sy-2)*dl+Pow/.(sy-1)*dh <
                                  VSub/.[y,[Offset.y,Offset.y+sy]] &
                              (-(2 |^ 31) <= sy &
                                sy <= (2 |^ 31)-1 & 0 <= sy &
                                0 <= Minimum.y &
                                Minimum.y <= Offset.y &
                                Offset.y+sy <= Maximum.y &
                                Maximum.y <= Len.y) &
                              (-(2 |^ 31) <= sy &
                                sy <= (2 |^ 31)-1 & 0 <= sy &
                                0 <= Minimum.xd &
                                Minimum.xd <= Offset.xd &
                                Offset.xd+sy <= Maximum.xd &
                                Maximum.xd <= Len.xd) &
                              Writable.xd = TRUE &
                              (for xd2,xp2,x3 being Element of P st
                                (for j being Element of INT holds
                                  Pelt/.[xd2,j] = Pelt/.[x3,j]) &
                                Len.xd2 = Len.x3 &
                                Len.x3 = Len.xd &
                                Offset.xd2 = Offset.xd &
                                Minimum.xd2 = Minimum.xd &
                                Maximum.xd2 = Maximum.xd &
                                Writable.xd2 = Writable.xd &
                                Zone.xd2 = Zone.xd &
                                (for j being Element of INT holds
                                  Pelt/.[xp2,j] = Pelt/.[x3,j]) &
                                Len.xp2 = Len.x3 &
                                Len.x3 = Len.xps &
                                Offset.xp2 = Offset.xps &
                                Minimum.xp2 = Minimum.xps &
                                Maximum.xp2 = Maximum.xps &
                                Writable.xp2 = Writable.xps &
                                Zone.xp2 = Zone.xps &
                                Len.x3 = Len.xs & Offset.x3 = Offset.xs &
                                Minimum.x3 = Minimum.xs &
                                Maximum.x3 = Maximum.xs &
                                Writable.x3 = Writable.xs &
                                Zone.x3 = Zone.xs
                               holds
                                (for b being Element of INT st
                                  0 <= b & b < (2 |^ 64) &
                                  VSub/.[xd2,
                                    [Offset.xd2,Offset.xd2+sy]]-
                                      Pow/.sy*b =
                                    VSub/.[xd,
                                      [Offset.xd,Offset.xd+sy]]-
                                    VSub/.[y,[Offset.y,Offset.y+sy]]*
                                      ((2 |^ 64)-1) &
                                  (for j being Element of INT st
                                    j < Offset.xd2 or
                                      Offset.xd2+sy <= j
                                   holds Pelt/.[xd2,j] = Pelt/.[xd,j])
                                 holds
                                  VSub/.[x3,
                                    [Offset.x3,Offset.x3+i-1]] =
                                    VSub/.[xs,
                                      [Offset.xs,Offset.xs+i-1]] &
                                  Offset.x3 <= Offset.xd2 &
                                  Offset.xd2 <=
                                    Offset.x3+sy+(i-1)-1 &
                                  Minimum.xp2 <= Offset.xp2+1 &
                                  Offset.xp2+1 < Maximum.xp2 &
                                  Minimum.qpi <= Offset.qpi-1 &
                                  Offset.qpi-1 <= Maximum.qpi &
                                  (for qps being Element of P st
                                    Offset.qps = Offset.qpi-1 &
                                    Len.qps = Len.qpi &
                                    (for j being Element of INT holds
                                      Pelt/.[qps,j] = Pelt/.[qpi,j]) &
                                    Minimum.qps = Minimum.qpi &
                                    Maximum.qps = Maximum.qpi &
                                    Writable.qps = Writable.qpi &
                                    Zone.qps = Zone.qpi &
                                    VSub/.[x3,
                                      [Offset.x3,
                                       Offset.x3+sy+(i-1)-1]] =
                                      VSub/.[x3,
                                        [Offset.x3,Offset.xd2]]+
                                      VSub/.[x3,
                                        [Offset.xd2,
                                         Offset.x3+sy+(i-1)-1]]*
                                        Pow/.(Offset.xd2-Offset.x3)
                                   holds
                                    Offset.qps+1 <=
                                      Offset.qps+sx-sy-(i-1) &
                                    (Offset.qps < Offset.qps+1 or
                                      Offset.qps+sx-sy-(i-1) <=
                                        Offset.qps) &
                                    Minimum.qps <= Offset.qps &
                                    Offset.qps < Maximum.qps &
                                    Writable.qps = TRUE &
                                    (for storedQ,nextQ being Element of P st
                                      Len.storedQ = Len.qps &
                                      Offset.storedQ = Offset.qps &
                                      Minimum.storedQ = Minimum.qps &
                                      Maximum.storedQ = Maximum.qps &
                                      Writable.storedQ = Writable.qps &
                                      Zone.storedQ = Zone.qps &
                                      Len.nextQ = Len.qs &
                                      Offset.nextQ = Offset.qs &
                                      Minimum.nextQ = Minimum.qs &
                                      Maximum.nextQ = Maximum.qs &
                                      Writable.nextQ = Writable.qs &
                                      Zone.nextQ = Zone.qs &
                                      (for j being Element of INT holds
                                        (j = Offset.storedQ implies
                                          Pelt/.[storedQ,j] =
                                            (2 |^ 64)-1) &
                                        (j <> Offset.storedQ implies
                                          Pelt/.[storedQ,j] =
                                            Pelt/.[qps,j])) &
                                      (for j being Element of INT holds
                                        Pelt/.[nextQ,j] =
                                          Pelt/.[storedQ,j]) &
                                      VSub/.[qs,
                                        [Offset.qps+1,
                                         Offset.qps+sx-sy-(i-1)]] =
                                      VSub/.[storedQ,
                                        [Offset.qps+1,
                                         Offset.qps+sx-sy-(i-1)]]
                                     holds i-1 < i &
                                      0 <= i-1 & i-1 <= sx-sy &
                                      Len.storedQ = Len.nextQ &
                                      Minimum.storedQ = Minimum.nextQ &
                                      Maximum.storedQ = Maximum.nextQ &
                                      Len.xp2 = Len.x3 &
                                      Minimum.xp2 = Minimum.x3 &
                                      Maximum.xp2 = Maximum.x3 &
                                      (for j being Element of INT holds
                                        Pelt/.[storedQ,j] =
                                          Pelt/.[nextQ,j]) &
                                      (for j being Element of INT holds
                                        Pelt/.[xp2,j] = Pelt/.[x3,j]) &
                                      Writable.storedQ = TRUE &
                                      Writable.xp2 = TRUE &
                                      Offset.storedQ =
                                        Offset.nextQ+(i-1) &
                                      Offset.xp2 =
                                        Offset.x3+sy+(i-1)-2 &
                                      VSub/.[x,
                                        [Offset.x,Offset.x+sx]] =
                                        (VSub/.[storedQ,
                                          [Offset.storedQ,
                                           Offset.storedQ+sx-sy-(i-1)]]+
                                          qh*Pow/.(sx-sy-(i-1))) *
                                          VSub/.[y,
                                            [Offset.y,Offset.y+sy]]*
                                          Pow/.(i-1) +
                                        VSub/.[x3,
                                          [Offset.x3,
                                           Offset.x3+sy+(i-1)-1]]+
                                        Pow/.(sy+(i-1)-1)*
                                          Pelt/.[xp2,Offset.xp2+1] &
                                      VSub/.[x3,
                                        [Offset.xp2+2-sy,
                                         Offset.xp2+2-sy+sy-1]]+
                                        Pow/.(sy-1)*
                                          Pelt/.[xp2,Offset.xp2+1] <
                                        VSub/.[y,
                                          [Offset.y,Offset.y+sy]] &
                                      Pelt/.[x3,Offset.xp2]+
                                        (2 |^ 64)*
                                          Pelt/.[xp2,Offset.xp2+1] <=
                                        dl+(2 |^ 64)*dh))))) &
                            (not (x1 = dh &
                              Pelt/.[xps,Offset.xps+1] = dl)
                             implies
                              Pelt/.[xps,Offset.xps+1]+
                                  (2 |^ 64)*x1 <
                                dl+(2 |^ 64)*dh &
                              (for qu,rl,rh being Element of INT st
                                0 <= qu & qu < (2 |^ 64) &
                                0 <= rl & rl < (2 |^ 64) &
                                0 <= rh & rh < (2 |^ 64) &
                                qu*dl+(2 |^ 64)*qu*dh+
                                    rl+(2 |^ 64)*rh =
                                  Pelt/.[xps,Offset.xps]+
                                  (2 |^ 64)*Pelt/.[xps,Offset.xps+1]+
                                  (2 |^ 64)*(2 |^ 64)*x1 &
                                rl+(2 |^ 64)*rh <
                                  dl+(2 |^ 64)*dh
                               holds
                                Offset.xs <= Offset.xd &
                                Offset.xd <= Offset.xs+sy+i-1 &
                                -(2 |^ 31) <= sy-2 &
                                sy-2 <= (2 |^ 31)-1 &
                                (0 <= sy-2 &
                                  0 <= Minimum.y &
                                  Minimum.y <= Offset.y &
                                  Offset.y+(sy-2) <= Maximum.y &
                                  Maximum.y <= Len.y) &
                                (0 <= sy-2 &
                                  0 <= Minimum.xd &
                                  Minimum.xd <= Offset.xd &
                                  Offset.xd+(sy-2) <= Maximum.xd &
                                  Maximum.xd <= Len.xd) &
                                Writable.xd = TRUE &
                                (for xd2,xp2,x3 being Element of P st
                                  (for j being Element of INT holds
                                    Pelt/.[xd2,j] = Pelt/.[x3,j]) &
                                  Len.xd2 = Len.x3 &
                                  Len.x3 = Len.xd &
                                  Offset.xd2 = Offset.xd &
                                  Minimum.xd2 = Minimum.xd &
                                  Maximum.xd2 = Maximum.xd &
                                  Writable.xd2 = Writable.xd &
                                  Zone.xd2 = Zone.xd &
                                  (for j being Element of INT holds
                                    Pelt/.[xp2,j] = Pelt/.[x3,j]) &
                                  Len.xp2 = Len.x3 &
                                  Len.x3 = Len.xps &
                                  Offset.xp2 = Offset.xps &
                                  Minimum.xp2 = Minimum.xps &
                                  Maximum.xp2 = Maximum.xps &
                                  Writable.xp2 = Writable.xps &
                                  Zone.xp2 = Zone.xps &
                                  Len.x3 = Len.xs &
                                  Offset.x3 = Offset.xs &
                                  Minimum.x3 = Minimum.xs &
                                  Maximum.x3 = Maximum.xs &
                                  Writable.x3 = Writable.xs &
                                  Zone.x3 = Zone.xs &
                                  VSub/.[xs,
                                    [Offset.xs,
                                     Offset.xs+sy+i-1]] =
                                    VSub/.[xs,
                                      [Offset.xs,Offset.xd]]+
                                    VSub/.[xs,
                                      [Offset.xd,
                                       Offset.xs+sy+i-1]]*
                                      Pow/.(Offset.xd-Offset.xs)
                                 holds
                                  (for cy being Element of INT st
                                    0 <= cy & cy < (2 |^ 64) &
                                    VSub/.[xd2,
                                      [Offset.xd2,Offset.xd2+sy-2]]-
                                        Pow/.(sy-2)*cy =
                                      VSub/.[xd,
                                        [Offset.xd,Offset.xd+sy-2]]-
                                      VSub/.[y,
                                        [Offset.y,Offset.y+sy-2]]*qu &
                                    (for j being Element of INT st
                                      j < Offset.xd2 or
                                        Offset.xd2+sy-2 <= j
                                     holds
                                      Pelt/.[xd2,j] = Pelt/.[xd,j])
                                   holds
                                    VSub/.[x3,
                                      [Offset.x3,Offset.x3+i-1]] =
                                      VSub/.[xs,
                                        [Offset.xs,Offset.xs+i-1]] &
                                    (for cy1,newlow,cy2,newhigh
                                      being Element of INT st
                                      0 <= cy1 & cy1 <= 1 &
                                      ((rl < cy implies cy1 = 1) &
                                       (not rl < cy implies cy1 = 0)) &
                                      0 <= newlow &
                                      newlow < (2 |^ 64) &
                                      newlow =
                                        (rl-cy) mod (2 |^ 64) &
                                      0 <= cy2 & cy2 <= 1 &
                                      ((rh < cy1 implies cy2 = 1) &
                                       (not rh < cy1 implies cy2 = 0)) &
                                      0 <= newhigh &
                                      newhigh < (2 |^ 64) &
                                      newhigh =
                                        (rh-cy1) mod (2 |^ 64)
                                     holds
                                      Offset.xd2 <= Offset.xp2 &
                                      Offset.xp2 <
                                        Offset.xd2+sy-1 &
                                      Offset.x3 <= Offset.x3+i-1 &
                                      (Offset.xp2 < Offset.x3 or
                                        Offset.x3+i-1 <= Offset.xp2) &
                                      Offset.xd2 <= Offset.xd2+sy-2 &
                                      (Offset.xp2 < Offset.xd2 or
                                        Offset.xd2+sy-2 <= Offset.xp2) &
                                      Minimum.xp2 <= Offset.xp2 &
                                      Offset.xp2 < Maximum.xp2 &
                                      Writable.xp2 = TRUE &
                                      (for xd3,xp3,x4 being Element of P st
                                        (for j being Element of INT holds
                                          Pelt/.[xp3,j] = Pelt/.[x4,j]) &
                                        Len.xp3 = Len.x4 &
                                        Len.x4 = Len.xp2 &
                                        Offset.xp3 = Offset.xp2 &
                                        Minimum.xp3 = Minimum.xp2 &
                                        Maximum.xp3 = Maximum.xp2 &
                                        Writable.xp3 = Writable.xp2 &
                                        Zone.xp3 = Zone.xp2 &
                                        (for j being Element of INT holds
                                          Pelt/.[xd3,j] = Pelt/.[x4,j]) &
                                        Len.xd3 = Len.x4 &
                                        Len.x4 = Len.xd2 &
                                        Offset.xd3 = Offset.xd2 &
                                        Minimum.xd3 = Minimum.xd2 &
                                        Maximum.xd3 = Maximum.xd2 &
                                        Writable.xd3 = Writable.xd2 &
                                        Zone.xd3 = Zone.xd2 &
                                        Len.x4 = Len.x3 &
                                        Offset.x4 = Offset.x3 &
                                        Minimum.x4 = Minimum.x3 &
                                        Maximum.x4 = Maximum.x3 &
                                        Writable.x4 = Writable.x3 &
                                        Zone.x4 = Zone.x3 &
                                        (for j being Element of INT holds
                                          (j = Offset.xp3 implies
                                            Pelt/.[xp3,j] = newlow) &
                                          (j <> Offset.xp3 implies
                                            Pelt/.[xp3,j] =
                                              Pelt/.[xp2,j])) &
                                        VSub/.[xd3,
                                          [Offset.xd3,
                                           Offset.xd3+sy-1]] =
                                          VSub/.[xd2,
                                            [Offset.xd2,
                                             Offset.xd2+sy-1]]+
                                          Pow/.(
                                            Offset.xp2-Offset.xd2)*
                                            (newlow-
                                              Pelt/.[xp2,Offset.xp2]) &
                                        VSub/.[x3,
                                          [Offset.x3,
                                           Offset.x3+i-1]] =
                                          VSub/.[x4,
                                            [Offset.x4,
                                             Offset.x4+i-1]] &
                                        VSub/.[xd2,
                                          [Offset.xd2,
                                           Offset.xd2+sy-2]] =
                                          VSub/.[xd3,
                                            [Offset.xd3,
                                             Offset.xd3+sy-2]]
                                       holds
                                        VSub/.[xd3,
                                          [Offset.xd3,
                                           Offset.xd3+sy-1]]+
                                            Pow/.(sy-1)*newhigh-
                                            Pow/.sy*cy2 =
                                          VSub/.[xd,
                                            [Offset.xd,Offset.xd+sy]]+
                                            Pow/.sy*x1-qu*
                                            VSub/.[y,
                                              [Offset.y,Offset.y+sy]] &
                                        (cy2 = 0 implies
                                          Minimum.qpi <= Offset.qpi-1 &
                                          Offset.qpi-1 <= Maximum.qpi &
                                          (for qps being Element of P st
                                            Offset.qps = Offset.qpi-1 &
                                            Len.qps = Len.qpi &
                                            (for j being Element of INT holds
                                              Pelt/.[qps,j] =
                                                Pelt/.[qpi,j]) &
                                            Minimum.qps = Minimum.qpi &
                                            Maximum.qps = Maximum.qpi &
                                            Writable.qps = Writable.qpi &
                                            Zone.qps = Zone.qpi
                                           holds
                                            Offset.qps+1 <=
                                              Offset.qps+sx-sy-(i-1) &
                                            (Offset.qps < Offset.qps+1 or
                                              Offset.qps+sx-sy-(i-1) <=
                                                Offset.qps) &
                                            Minimum.qps <= Offset.qps &
                                            Offset.qps < Maximum.qps &
                                            Writable.qps = TRUE &
                                            (for storedQ,nextQ
                                              being Element of P st
                                              Len.storedQ = Len.qps &
                                              Offset.storedQ = Offset.qps &
                                              Minimum.storedQ =
                                                Minimum.qps &
                                              Maximum.storedQ =
                                                Maximum.qps &
                                              Writable.storedQ =
                                                Writable.qps &
                                              Zone.storedQ = Zone.qps &
                                              Len.nextQ = Len.qs &
                                              Offset.nextQ = Offset.qs &
                                              Minimum.nextQ = Minimum.qs &
                                              Maximum.nextQ = Maximum.qs &
                                              Writable.nextQ = Writable.qs &
                                              Zone.nextQ = Zone.qs &
                                              (for j being Element of INT
                                               holds
                                                (j = Offset.storedQ implies
                                                  Pelt/.[storedQ,j] = qu) &
                                                (j <> Offset.storedQ implies
                                                  Pelt/.[storedQ,j] =
                                                    Pelt/.[qps,j])) &
                                              (for j being Element of INT
                                               holds
                                                Pelt/.[nextQ,j] =
                                                  Pelt/.[storedQ,j]) &
                                              VSub/.[qs,
                                                [Offset.qps+1,
                                                 Offset.qps+sx-sy-(i-1)]] =
                                              VSub/.[storedQ,
                                                [Offset.qps+1,
                                                 Offset.qps+sx-sy-(i-1)]]
                                             holds i-1 < i &
                                              0 <= i-1 & i-1 <= sx-sy &
                                              Len.storedQ = Len.nextQ &
                                              Minimum.storedQ =
                                                Minimum.nextQ &
                                              Maximum.storedQ =
                                                Maximum.nextQ &
                                              Len.xp3 = Len.x4 &
                                              Minimum.xp3 = Minimum.x4 &
                                              Maximum.xp3 = Maximum.x4 &
                                              (for j
                                                being Element of INT holds
                                                Pelt/.[storedQ,j] =
                                                  Pelt/.[nextQ,j]) &
                                              (for j
                                                being Element of INT holds
                                                Pelt/.[xp3,j] =
                                                  Pelt/.[x4,j]) &
                                              Writable.storedQ = TRUE &
                                              Writable.xp3 = TRUE &
                                              Offset.storedQ =
                                                Offset.nextQ+(i-1) &
                                              Offset.xp3 =
                                                Offset.x4+sy+(i-1)-2 &
                                              VSub/.[x,
                                                [Offset.x,Offset.x+sx]] =
                                                (VSub/.[storedQ,
                                                  [Offset.storedQ,
                                                   Offset.storedQ+
                                                     sx-sy-(i-1)]]+
                                                  qh*
                                                    Pow/.(sx-sy-(i-1))) *
                                                  VSub/.[y,
                                                    [Offset.y,
                                                     Offset.y+sy]]*
                                                  Pow/.(i-1) +
                                                VSub/.[x4,
                                                  [Offset.x4,
                                                   Offset.x4+
                                                     sy+(i-1)-1]]+
                                                Pow/.(sy+(i-1)-1)*
                                                  newhigh &
                                              VSub/.[x4,
                                                [Offset.xp3+2-sy,
                                                 Offset.xp3+2-sy+sy-1]]+
                                                Pow/.(sy-1)*newhigh <
                                                VSub/.[y,
                                                  [Offset.y,Offset.y+sy]] &
                                              Pelt/.[x4,Offset.xp3]+
                                                (2 |^ 64)*newhigh <=
                                                dl+(2 |^ 64)*dh))) &
                                        (cy2 <> 0 implies
                                          0 < qu &
                                          Pow/.sy-
                                            VSub/.[y,
                                              [Offset.y,Offset.y+sy]] <=
                                            VSub/.[xd3,
                                              [Offset.xd3,
                                               Offset.xd3+sy-1]]+
                                              Pow/.(sy-1)*newhigh &
                                          -(2 |^ 31) <= sy-1 &
                                          sy-1 <= (2 |^ 31)-1 &
                                          (0 <= sy-1 &
                                            0 <= Minimum.y &
                                            Minimum.y <= Offset.y &
                                            Offset.y+(sy-1) <= Maximum.y &
                                            Maximum.y <= Len.y) &
                                          (0 <= sy-1 &
                                            0 <= Minimum.xd3 &
                                            Minimum.xd3 <= Offset.xd3 &
                                            Offset.xd3+(sy-1) <=
                                              Maximum.xd3 &
                                            Maximum.xd3 <= Len.xd3) &
                                          Writable.xd3 = TRUE &
                                          (for corrected,xp4
                                            being Element of P st
                                            Len.corrected = Len.x4 &
                                            Offset.corrected = Offset.x4 &
                                            Minimum.corrected = Minimum.x4 &
                                            Maximum.corrected = Maximum.x4 &
                                            Writable.corrected = Writable.x4 &
                                            Zone.corrected = Zone.x4 &
                                            (for j being Element of INT holds
                                              Pelt/.[xp4,j] =
                                                Pelt/.[corrected,j]) &
                                            Offset.xp4 = Offset.xp3 &
                                            Len.xp4 = Len.corrected &
                                            Len.corrected = Len.xp3 &
                                            Len.xp4 = Len.xp3 &
                                            Minimum.xp4 = Minimum.xp3 &
                                            Maximum.xp4 = Maximum.xp3 &
                                            Writable.xp4 = Writable.xp3 &
                                            Zone.xp4 = Zone.xp3
                                           holds
                                            (for carry,high2
                                              being Element of INT st
                                              0 <= carry & carry <= 1 &
                                              VSub/.[corrected,
                                                [Offset.xd3,
                                                 Offset.xd3+sy-1]]+
                                                  Pow/.(sy-1)*carry =
                                                VSub/.[xd3,
                                                  [Offset.xd3,
                                                   Offset.xd3+sy-1]]+
                                                VSub/.[y,
                                                  [Offset.y,
                                                   Offset.y+sy-1]] &
                                              (for j
                                                being Element of INT st
                                                j < Offset.xd3 or
                                                  Offset.xd3+sy-1 <= j
                                               holds
                                              Pelt/.[corrected,j] =
                                                  Pelt/.[xd3,j]) &
                                              0 <= high2 &
                                              high2 < (2 |^ 64) &
                                              high2 =
                                                (newhigh+
                                                  ((dh+carry) mod
                                                    (2 |^ 64))) mod
                                                  (2 |^ 64)
                                             holds
                                              VSub/.[corrected,
                                                [Offset.corrected,
                                                 Offset.corrected+i-1]] =
                                                VSub/.[x4,
                                                  [Offset.x4,
                                                   Offset.x4+i-1]] &
                                              VSub/.[corrected,
                                                [Offset.xd3,
                                                 Offset.xd3+sy-1]]+
                                                  Pow/.(sy-1)*high2 =
                                                VSub/.[xd3,
                                                  [Offset.xd3,
                                                   Offset.xd3+sy-1]]+
                                                Pow/.(sy-1)*newhigh+
                                                VSub/.[y,
                                                  [Offset.y,Offset.y+sy]]-
                                                Pow/.sy &
                                              (2 |^ 64) <> 0 &
                                              0 <= qu-1 &
                                              qu-1 < (2 |^ 64) &
                                              Minimum.qpi <=
                                                Offset.qpi-1 &
                                              Offset.qpi-1 <= Maximum.qpi &
                                              (for qps
                                                being Element of P st
                                                Offset.qps =
                                                  Offset.qpi-1 &
                                                Len.qps = Len.qpi &
                                                (for j being Element of INT
                                                 holds
                                                  Pelt/.[qps,j] =
                                                    Pelt/.[qpi,j]) &
                                                Minimum.qps =
                                                  Minimum.qpi &
                                                Maximum.qps =
                                                  Maximum.qpi &
                                                Writable.qps =
                                                  Writable.qpi &
                                                Zone.qps = Zone.qpi
                                               holds
                                                Offset.qps+1 <=
                                                  Offset.qps+
                                                    sx-sy-(i-1) &
                                                (Offset.qps <
                                                    Offset.qps+1 or
                                                  Offset.qps+
                                                    sx-sy-(i-1) <=
                                                      Offset.qps) &
                                                Minimum.qps <= Offset.qps &
                                                Offset.qps < Maximum.qps &
                                                Writable.qps = TRUE &
                                                (for storedQ,nextQ
                                                  being Element of P st
                                                  Len.storedQ = Len.qps &
                                                  Offset.storedQ =
                                                    Offset.qps &
                                                  Minimum.storedQ =
                                                    Minimum.qps &
                                                  Maximum.storedQ =
                                                    Maximum.qps &
                                                  Writable.storedQ =
                                                    Writable.qps &
                                                  Zone.storedQ = Zone.qps &
                                                  Len.nextQ = Len.qs &
                                                  Offset.nextQ = Offset.qs &
                                                  Minimum.nextQ =
                                                    Minimum.qs &
                                                  Maximum.nextQ =
                                                    Maximum.qs &
                                                  Writable.nextQ =
                                                    Writable.qs &
                                                  Zone.nextQ = Zone.qs &
                                                  (for j
                                                    being Element of INT
                                                   holds
                                                    (j = Offset.storedQ
                                                     implies
                                                      Pelt/.[storedQ,j] =
                                                        qu-1) &
                                                    (j <> Offset.storedQ
                                                     implies
                                                      Pelt/.[storedQ,j] =
                                                        Pelt/.[qps,j])) &
                                                  (for j
                                                    being Element of INT
                                                   holds
                                                    Pelt/.[nextQ,j] =
                                                      Pelt/.[storedQ,j]) &
                                                  VSub/.[qs,
                                                    [Offset.qps+1,
                                                     Offset.qps+
                                                       sx-sy-(i-1)]] =
                                                  VSub/.[storedQ,
                                                    [Offset.qps+1,
                                                     Offset.qps+
                                                       sx-sy-(i-1)]]
                                                 holds i-1 < i &
                                                  0 <= i-1 &
                                                  i-1 <= sx-sy &
                                                  Len.storedQ = Len.nextQ &
                                                  Minimum.storedQ =
                                                    Minimum.nextQ &
                                                  Maximum.storedQ =
                                                    Maximum.nextQ &
                                                  Len.xp4 =
                                                    Len.corrected &
                                                  Minimum.xp4 =
                                                    Minimum.corrected &
                                                  Maximum.xp4 =
                                                    Maximum.corrected &
                                                  (for j
                                                    being Element of INT
                                                   holds
                                                    Pelt/.[storedQ,j] =
                                                      Pelt/.[nextQ,j]) &
                                                  (for j
                                                    being Element of INT
                                                   holds
                                                    Pelt/.[xp4,j] =
                                                      Pelt/.[corrected,j]) &
                                                  Writable.storedQ = TRUE &
                                                  Writable.xp4 = TRUE &
                                                  Offset.storedQ =
                                                    Offset.nextQ+(i-1) &
                                                  Offset.xp4 =
                                                    Offset.corrected+
                                                      sy+(i-1)-2 &
                                                  VSub/.[x,
                                                    [Offset.x,
                                                     Offset.x+sx]] =
                                                    (VSub/.[storedQ,
                                                      [Offset.storedQ,
                                                       Offset.storedQ+
                                                         sx-sy-(i-1)]]+
                                                      qh*
                                                        Pow/.(
                                                          sx-sy-(i-1))) *
                                                      VSub/.[y,
                                                        [Offset.y,
                                                         Offset.y+sy]]*
                                                      Pow/.(i-1) +
                                                    VSub/.[corrected,
                                                      [Offset.corrected,
                                                       Offset.corrected+
                                                         sy+(i-1)-1]]+
                                                    Pow/.(sy+(i-1)-1)*
                                                      high2 &
                                                  VSub/.[corrected,
                                                    [Offset.xp4+2-sy,
                                                     Offset.xp4+2-sy+
                                                       sy-1]]+
                                                    Pow/.(sy-1)*high2 <
                                                    VSub/.[y,
                                                      [Offset.y,
                                                       Offset.y+sy]] &
                                                  Pelt/.[corrected,
                                                    Offset.xp4]+
                                                    (2 |^ 64)*high2 <=
                                                    dl+
                                                      (2 |^ 64)*dh)))))))))) &
                      (not 0 < i implies
                        Offset.xs <= Offset.xpi &
                        Minimum.xpi <= Offset.xpi+1 &
                        Offset.xpi+1 < Maximum.xpi &
                        (for storedX,nextX being Element of P st
                          Len.storedX = Len.xpi &
                          Offset.storedX = Offset.xpi &
                          Minimum.storedX = Minimum.xpi &
                          Maximum.storedX = Maximum.xpi &
                          Writable.storedX = Writable.xpi &
                          Zone.storedX = Zone.xpi &
                          (for j being Element of INT holds
                            (j = Offset.storedX+1 implies
                              Pelt/.[storedX,j] = x1) &
                            (j <> Offset.storedX+1 implies
                              Pelt/.[storedX,j] = Pelt/.[xpi,j])) &
                          (for j being Element of INT holds
                            Pelt/.[nextX,j] = Pelt/.[storedX,j]) &
                          Len.nextX = Len.xs &
                          Offset.nextX = Offset.xs &
                          Minimum.nextX = Minimum.xs &
                          Maximum.nextX = Maximum.xs &
                          Writable.nextX = Writable.xs &
                          Zone.nextX = Zone.xs
                         holds
                          VSub/.[x,[Offset.x,Offset.x+sx]] =
                            (VSub/.[qs,
                              [Offset.qs,Offset.qs+sx-sy]]+
                              Pow/.(sx-sy)*qh) *
                              VSub/.[y,[Offset.y,Offset.y+sy]]+
                            VSub/.[nextX,
                              [Offset.nextX,Offset.nextX+sy]] &
                          VSub/.[nextX,
                            [Offset.nextX,Offset.nextX+sy]] <
                            VSub/.[y,[Offset.y,Offset.y+sy]] &
                          0 <= qh & qh <= 1)))))))))))))))
proof
end;
::$P+
