:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/div_Div_div3by2_invqtvc: the verification condition
:: for reciprocal-based division of a three-limb unsigned integer by a
:: normalized two-limb 64-bit divisor, including quotient corrections and
:: the final two-limb remainder bound. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, MARGREL1, XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for dh,v,dl,um,uh,l,h,ul being Integer st
    0 <= dh & dh < (2 |^ 64) &
    0 <= v & v < (2 |^ 64) &
    0 <= dl & dl < (2 |^ 64) &
    0 <= um & um < (2 |^ 64) &
    0 <= uh & uh < (2 |^ 64) &
    0 <= l & l < (2 |^ 64) &
    0 <= h & h < (2 |^ 64) &
    0 <= ul & ul < (2 |^ 64) &
    ((2 |^ 64) div 2) <= dh &
    v = ((((2 |^ 64) * (2 |^ 64) * (2 |^ 64)) - 1)
          div (dl + (2 |^ 64) * dh)) - (2 |^ 64) &
    um + (2 |^ 64) * uh < dl + (2 |^ 64) * dh &
    l + (2 |^ 64) * h = v * uh
  holds
    0 <= 0 &
    0 <= 1 &
    (for sl,c being Integer st
       0 <= sl & sl < (2 |^ 64) &
       0 <= c & c < (2 |^ 64) &
       sl + (2 |^ 64) * c = um + l + 0 &
       0 <= c & c <= 1
     holds
       (0 <= c & c <= 1) &
       (for sh,cp being Integer st
          0 <= sh & sh < (2 |^ 64) &
          0 <= cp & cp < (2 |^ 64) &
          sh + (2 |^ 64) * cp = uh + h + c &
          0 <= cp & cp <= 1
        holds
          for o1 being Integer st
            0 <= o1 & o1 < (2 |^ 64) &
            o1 = (sh + 1) mod (2 |^ 64)
          holds
            for p being Integer st
              0 <= p & p < (2 |^ 64) &
              p = (dh * sh) mod (2 |^ 64)
            holds
              for o2 being Integer st
                0 <= o2 & o2 < (2 |^ 64) &
                o2 = (um - p) mod (2 |^ 64)
              holds
                (2 |^ 64) <> 0 &
                (for tl,th being Integer st
                   0 <= tl & tl < (2 |^ 64) &
                   0 <= th & th < (2 |^ 64) &
                   tl + (2 |^ 64) * th = sh * dl
                 holds
                   (0 <= 0 & 0 <= 1) &
                   (for il,b being Integer st
                      0 <= il & il < (2 |^ 64) &
                      0 <= b & b < (2 |^ 64) &
                      il - (2 |^ 64) * b = ul - tl - 0 &
                      0 <= b & b <= 1
                    holds
                      (0 <= b & b <= 1) &
                      (for ih,bp being Integer st
                         0 <= ih & ih < (2 |^ 64) &
                         0 <= bp & bp < (2 |^ 64) &
                         ih - (2 |^ 64) * bp = o2 - th - b &
                         0 <= bp & bp <= 1
                       holds
                         (0 <= 0 & 0 <= 1) &
                         (for bl,b2 being Integer st
                            0 <= bl & bl < (2 |^ 64) &
                            0 <= b2 & b2 < (2 |^ 64) &
                            bl - (2 |^ 64) * b2 = il - dl - 0 &
                            0 <= b2 & b2 <= 1
                          holds
                            (0 <= b2 & b2 <= 1) &
                            (for bh,b2p being Integer st
                               0 <= bh & bh < (2 |^ 64) &
                               0 <= b2p & b2p < (2 |^ 64) &
                               bh - (2 |^ 64) * b2p =
                                 ih - dh - b2 &
                               0 <= b2p & b2p <= 1
                             holds
                               (sl <= bh implies
                                 for o3 being Integer st
                                   0 <= o3 & o3 < (2 |^ 64) &
                                   o3 = (o1 - 1) mod (2 |^ 64)
                                 holds
                                   (0 <= 0 & 0 <= 1) &
                                   (for rl,c1 being Integer st
                                      0 <= rl & rl < (2 |^ 64) &
                                      0 <= c1 & c1 < (2 |^ 64) &
                                      rl + (2 |^ 64) * c1 =
                                        bl + dl + 0 &
                                      0 <= c1 & c1 <= 1
                                    holds
                                      (0 <= c1 & c1 <= 1) &
                                      (for rh,c1p being Integer st
                                         0 <= rh & rh < (2 |^ 64) &
                                         0 <= c1p & c1p < (2 |^ 64) &
                                         rh + (2 |^ 64) * c1p =
                                           bh + dh + c1 &
                                         0 <= c1p & c1p <= 1
                                       holds
                                         for flag being
                                             Element of BOOLEAN st
                                           ((dh < rh & flag = TRUE) or
                                            (not dh < rh &
                                             ex eqflag being
                                                  Element of BOOLEAN st
                                               (rh = dh implies
                                                  eqflag = TRUE) &
                                               (eqflag = TRUE implies
                                                  rh = dh) &
                                               (eqflag = TRUE & dl <= rl
                                                  implies flag = TRUE) &
                                               (not (eqflag = TRUE &
                                                     dl <= rl)
                                                  implies flag = FALSE)))
                                         holds
                                           (flag = TRUE implies
                                             (0 <= 0 & 0 <= 1) &
                                             (for bl1,b1 being Integer st
                                                0 <= bl1 &
                                                bl1 < (2 |^ 64) &
                                                0 <= b1 &
                                                b1 < (2 |^ 64) &
                                                bl1 - (2 |^ 64) * b1 =
                                                  rl - dl - 0 &
                                                0 <= b1 & b1 <= 1
                                              holds
                                                (0 <= b1 & b1 <= 1) &
                                                (for bh1,b1p being
                                                     Integer st
                                                   0 <= bh1 &
                                                   bh1 < (2 |^ 64) &
                                                   0 <= b1p &
                                                   b1p < (2 |^ 64) &
                                                   bh1 -
                                                     (2 |^ 64) * b1p =
                                                     rh - dh - b1 &
                                                   0 <= b1p &
                                                   b1p <= 1
                                                 holds
                                                   for o5 being Integer st
                                                     0 <= o5 &
                                                     o5 < (2 |^ 64) &
                                                     o5 =
                                                       (o3 + 1)
                                                       mod (2 |^ 64)
                                                   holds
                                                     o5 * dl +
                                                       (2 |^ 64) * o5 * dh +
                                                       bl1 +
                                                       (2 |^ 64) * bh1 =
                                                       ul +
                                                       (2 |^ 64) * um +
                                                       (2 |^ 64) *
                                                       (2 |^ 64) * uh &
                                                     0 <= bl1 +
                                                       (2 |^ 64) * bh1 &
                                                     bl1 +
                                                       (2 |^ 64) * bh1 <
                                                       dl +
                                                       (2 |^ 64) * dh))) &
                                           (flag <> TRUE implies
                                             o3 * dl +
                                               (2 |^ 64) * o3 * dh +
                                               rl + (2 |^ 64) * rh =
                                               ul + (2 |^ 64) * um +
                                               (2 |^ 64) *
                                               (2 |^ 64) * uh &
                                             0 <= rl + (2 |^ 64) * rh &
                                             rl + (2 |^ 64) * rh <
                                               dl + (2 |^ 64) * dh)))) &
                               (not sl <= bh implies
                                 for flag being Element of BOOLEAN st
                                   ((dh < bh & flag = TRUE) or
                                    (not dh < bh &
                                     ex eqflag being Element of BOOLEAN st
                                       (bh = dh implies eqflag = TRUE) &
                                       (eqflag = TRUE implies bh = dh) &
                                       (eqflag = TRUE & dl <= bl
                                          implies flag = TRUE) &
                                       (not (eqflag = TRUE & dl <= bl)
                                          implies flag = FALSE)))
                                 holds
                                   (flag = TRUE implies
                                     (0 <= 0 & 0 <= 1) &
                                     (for bl1,b3 being Integer st
                                        0 <= bl1 & bl1 < (2 |^ 64) &
                                        0 <= b3 & b3 < (2 |^ 64) &
                                        bl1 - (2 |^ 64) * b3 =
                                          bl - dl - 0 &
                                        0 <= b3 & b3 <= 1
                                      holds
                                        (0 <= b3 & b3 <= 1) &
                                        (for bh1,b3p being Integer st
                                           0 <= bh1 &
                                           bh1 < (2 |^ 64) &
                                           0 <= b3p &
                                           b3p < (2 |^ 64) &
                                           bh1 - (2 |^ 64) * b3p =
                                             bh - dh - b3 &
                                           0 <= b3p & b3p <= 1
                                         holds
                                           for o4 being Integer st
                                             0 <= o4 &
                                             o4 < (2 |^ 64) &
                                             o4 =
                                               (o1 + 1) mod (2 |^ 64)
                                           holds
                                             o4 * dl +
                                               (2 |^ 64) * o4 * dh +
                                               bl1 +
                                               (2 |^ 64) * bh1 =
                                               ul + (2 |^ 64) * um +
                                               (2 |^ 64) *
                                               (2 |^ 64) * uh &
                                             0 <= bl1 +
                                               (2 |^ 64) * bh1 &
                                             bl1 + (2 |^ 64) * bh1 <
                                               dl + (2 |^ 64) * dh))) &
                                   (flag <> TRUE implies
                                     o1 * dl +
                                       (2 |^ 64) * o1 * dh +
                                       bl + (2 |^ 64) * bh =
                                       ul + (2 |^ 64) * um +
                                       (2 |^ 64) * (2 |^ 64) * uh &
                                     0 <= bl + (2 |^ 64) * bh &
                                     bl + (2 |^ 64) * bh <
                                       dl + (2 |^ 64) * dh)))))))))
proof
end;
::$P+
