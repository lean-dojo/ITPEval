            Pelt64.(up,In(Offset64.up + S32.o1,INT)) &
          Pelt64.(up,In(Offset64.up + S32.o1,INT)) < Pow2N.sb
        holds
          bits <= 2147483647 &
          (for o2 being Nat st
             o2 < Pow2N.32 & S32.o2 = bits
           holds
             sb <= 2147483647 &
             (for o3 being Nat st
