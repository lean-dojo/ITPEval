            o19 = sj
          holds
            Min8.sp1 <=
              Offset8.sp1+
              S32.o10 &
            Offset8.sp1+
              S32.o10 <
              Max8.sp1 &
            Writable8.sp1 =
              TRUE &
            (for sp2
               being Element of P8
             st
