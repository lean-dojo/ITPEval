                                                     Offset64.up+S32.i &
                                                   Offset64.up+S32.i <
                                                     Max64.up &
                                                   0 <= shift &
                                                   shift < 64 &
                                                   (for o11 being Nat st
                                                      o11 < Pow2N.64 &
                                                      o11 =
                                                        Pelt64.(up,
                                                          In(Offset64.up+
                                                            S32.i,INT))
                                                        div Pow2N.shift
                                                    holds
                                                      Pow2N.shift <> 0 &
                                                      (for o12 being Nat
                                                       st
                                                         o12 < Pow2N.64 &
                                                         o12 = bits
                                                       holds
                                                         0 <= shift+o12 &
                                                         shift+o12 <=
Pow2N.64-1 &
                                                         (for o13 being Nat
                                                          st
