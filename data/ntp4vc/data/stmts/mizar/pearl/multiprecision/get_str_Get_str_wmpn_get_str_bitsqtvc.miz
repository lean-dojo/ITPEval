                                                          holds
                                                            ((64 <= o13
                                                              implies
                                                              -Pow2N.31 <=
                                                                S32.i+1 &
                                                              S32.i+1 <=
                                                                2147483647 &
                                                              (for o14
                                                                 being Nat
                                                               st
                                                                 o14 <
                                                                   (2 |^ 
32) &
                                                                 S32.o14 =
                                                                   S32.i+1
                                                               holds
