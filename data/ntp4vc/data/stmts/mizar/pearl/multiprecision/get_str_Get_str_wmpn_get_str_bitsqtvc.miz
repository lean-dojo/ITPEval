               Offset8.sp2 =
                 Offset8.sp1 &
               Min8.sp2 =
                 Min8.sp1 &
               Max8.sp2 =
                 Max8.sp1 &
               Writable8.sp2 =
                 Writable8.sp1 &
               Zone8.sp2 =
                 Zone8.sp1 &
               [sp2,[sp1,
                 [Offset8.sp2+S32.o10,o19]]] in Update8 &
               Pelt8.(sp2,Offset8.sp2+S32.o10) = o19
             holds
               S32.o10 <
                 S32.j &
               0 <=
                 S32.o14 &
               S32.o14 <=
                 S32.un &
               0 <=
                 S32.o10 &
               S32.o10 <=
                 S32.sn &
               (S32.sn-S32.o10)*
                 bits =
                 (S32.sn-S32.j)*
                   bits+
                 bits &
               (0 < S32.o10
                 implies
                 (S32.sn-S32.j)*
                   bits+
                   bits =
                   64*S32.o14+
                   o15) &
               ((0 <= o15 &
                 o15 < 64) or
                 o14 = un) &
               [b,[sp2,
                 [Offset8.sp2+
                   S32.o10,
                  Offset8.sp2+
                   S32.sn]]]
