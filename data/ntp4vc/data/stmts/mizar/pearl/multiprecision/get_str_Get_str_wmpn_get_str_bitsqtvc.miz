    bits+
  bits &
(0 < S32.o10
  implies
  (S32.sn-S32.j)*
    bits+
    bits =
    64*S32.o14+
    o13) &
((0 <= o13 &
  o13 < 64) or
  o14 = un) &
[b,[sp2,
  [Offset8.sp2+
    S32.o10,
   Offset8.sp2+
    S32.sn]]]
