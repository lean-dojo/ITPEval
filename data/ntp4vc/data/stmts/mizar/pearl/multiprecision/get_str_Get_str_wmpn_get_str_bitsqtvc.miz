                                            holds
                                              0 <= S32.i &
                                              S32.i <= S32.un &
                                              0 <= S32.j &
                                              S32.j <= S32.sn &
                                              (0 < S32.j implies
                                                (S32.sn-S32.j)*bits =
                                                  64*S32.i+shift) &
                                              ((0 <= shift &
                                                shift < 64) or
                                                i = un) &
                                              [b,[sp1,
                                                [Offset8.sp1+S32.j,
                                                 Offset8.sp1+S32.sn]]]
                                                in InBase &
                                              ((SValueSub.(b,[sp1,
                                                  [Offset8.sp1+S32.j,
                                                   Offset8.sp1+S32.sn]]) =
                                                  ValueB.(up,
                                                    (S32.sn-S32.j)*
                                                      bits) &
                                                 (S32.sn-S32.j)*bits <=
                                                   64*S32.un) or
                                                (S32.j = 0 &
                                                 SValue.(b,
                                                   [sp1,S32.sn]) =
                                                   Value.(up,S32.un))) &
                                              (for k being Element of INT st
                                                 k < Offset8.sp1 or
                                                 Offset8.sp1+S32.sn <= k
                                               holds
                                                 Pelt8.(sp1,k) =
                                                   Pelt8.(sp,k))
                                              implies
                                              [b,[sn,[shift,[j,[i,sp1]]]]] 
in LoopStep))))))))))))))
proof
end;
::$P+
