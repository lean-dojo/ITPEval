:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/get_str_Get_str_wmpn_get_str_bitsqtvc: the
:: multiprecision conversion loop computes base-2^bits output bytes while
:: preserving pointer bounds, numeric value, and untouched memory. This file
:: contains no proof.
environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, INT_2, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, MCART_1, NEWTON, BINOP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, INT_2, NAT_1, NAT_D, NEWTON,
    XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, INT_2, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON, FINSEQ_1,
    FINSEQ_2, MARGREL1, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, INT_2, NAT_1, FINSEQ_1, FINSEQ_2,
    MARGREL1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
begin
::$P-
theorem
  for P64,P8,Z being non empty set,
      S32 being Function of NAT,INT,
      Pow2N being Function of NAT,NAT,
      Pow2,PowR being Function of INT,INT,
      Pelt64 being Function of [:P64,INT:],NAT,
      Pelt8 being Function of [:P8,INT:],NAT,
      Len64 being Function of P64,NAT,
      Len8 being Function of P8,NAT,
      Offset64,Min64,Max64 being Function of P64,INT,
      Offset8,Min8,Max8 being Function of P8,INT,
      Writable8 being Function of P8,BOOLEAN,
      Zone8 being Function of P8,Z,
      Valid64 being Subset of [:P64,INT:],
      Valid8 being Subset of [:P8,INT:],
      ValueSub being Function of [:P64,[:INT,INT:]:],INT,
      Value being Function of [:P64,INT:],INT,
      ValueB being Function of [:P64,INT:],INT,
      SValueSub being
        Function of [:INT,[:P8,[:INT,INT:]:]:],INT,
      SValue being Function of [:INT,[:P8,INT:]:],INT,
      InBase being Subset of [:INT,[:P8,[:INT,INT:]:]:],
      Update8 being Subset of [:P8,[:P8,[:INT,NAT:]:]:],
      LoopStep being set,
      un,bits,ub being Nat,
      up being Element of P64,
      sp being Element of P8
  st
    un < Pow2N.32 &
    bits < Pow2N.32 &
    ub < Pow2N.32 &
    (for w being Nat st w < Pow2N.32 holds
      (w < Pow2N.31 implies S32.w = w) &
      (Pow2N.31 <= w implies S32.w = w - Pow2N.32)) &
    (for n being Nat holds Pow2N.n = 2 |^ n) &
    (for e being Element of INT st 0 <= e holds
      ex n being Nat st
        n = e &
        Pow2.e = 2 |^ n &
        PowR.e = Pow2.(64*e)) &
    (for p being Element of P64, k being Element of INT holds
      (Pelt64.(p,k)) < Pow2N.64) &
    (for p being Element of P8, k being Element of INT holds
      (Pelt8.(p,k)) < Pow2N.8) &
    (for p being Element of P64, sz being Element of INT holds
      ([p,sz] in Valid64 iff
        -Pow2N.31 <= sz & sz <= 2147483647 &
        0 <= sz &
        0 <= Min64.p & Min64.p <= Offset64.p &
        Offset64.p + sz <= Max64.p &
        Max64.p <= Len64.p)) &
    (for p being Element of P8, sz being Element of INT holds
      ([p,sz] in Valid8 iff
        -Pow2N.31 <= sz & sz <= 2147483647 &
        0 <= sz &
        0 <= Min8.p & Min8.p <= Offset8.p &
        Offset8.p + sz <= Max8.p &
        Max8.p <= Len8.p)) &
    (for p being Element of P64, n,m being Element of INT holds
      (n < m implies
        ValueSub.(p,[n,m]) =
          Pelt64.(p,n) +
          In(Pow2N.64,INT) *
            ValueSub.(p,In([In(n+1,INT),m],[:INT,INT:]))) &
      (not n < m implies ValueSub.(p,[n,m]) = 0)) &
    (for p being Element of P64, sz being Element of INT holds
      Value.(p,sz) =
        ValueSub.(p,[Offset64.p,Offset64.p+sz])) &
    (for p being Element of P64, nbits being Element of INT holds
      (nbits < 0 implies ValueB.(p,nbits) = 0) &
      (0 <= nbits implies
        ex q being Element of INT st
          q = nbits div 64 &
          ValueB.(p,nbits) =
            Value.(p,q) +
            PowR.q *
              (In(Pelt64.(p,In(Offset64.p+q,INT)),INT) mod
                Pow2.(In(nbits-64*q,INT))))) &
    (for base being Element of INT, p being Element of P8,
         n,m being Element of INT holds
      (n < m implies
        SValueSub.(base,[p,[n,m]]) =
          Pelt8.(p,In(m-1,INT)) +
          base *
            SValueSub.(base,
              In([p,[n,In(m-1,INT)]],[:P8,[:INT,INT:]:]))) &
      (not n < m implies SValueSub.(base,[p,[n,m]]) = 0)) &
    (for base being Element of INT, p being Element of P8,
         sz being Element of INT holds
      SValue.(base,[p,sz]) =
        SValueSub.(base,[p,[Offset8.p,Offset8.p+sz]])) &
    (for base being Element of INT, p being Element of P8,
         n,m being Element of INT holds
      ([base,[p,[n,m]]] in InBase iff
        for k being Element of INT st n <= k & k < m holds
          0 <= (Pelt8.(p,k)) &
          (Pelt8.(p,k)) < base)) &
    (for p2,p1 being Element of P8, k being Element of INT,
         v being Nat holds
      ([p2,[p1,[k,v]]] in Update8 iff
        for q being Element of INT holds
          (q = k implies Pelt8.(p2,q) = v) &
          (q <> k implies Pelt8.(p2,q) = Pelt8.(p1,q)))) &
    (for b,sn,shift,j,i being Nat, sp1 being Element of P8 holds
      ([b,[sn,[shift,[j,[i,sp1]]]]] in LoopStep iff
