:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_1_Sub_1_wmpn_decrqtvc: the verification
:: condition for subtracting one 64-bit limb from a positive-length writable
:: multiprecision integer in place without underflow, including borrow
:: propagation, pointer updates, and memory framing. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Data being Function of P,INT*,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      x being Element of P,
      sz,y being Element of INT
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, k being Nat st k in dom (Data.p)
     holds
       ex d being Integer st
         d = (Data.p).k & 0 <= d & d < (2 |^ 64)) &
    (for p being Element of P, j being Integer holds
      (len (Data.p) = 0 implies Pelt.[p,j] = 0) &
      (j < 0 & 0 < len (Data.p) implies
        Pelt.[p,j] = (Data.p).1) &
      (0 <= j & j < len (Data.p) implies
        Pelt.[p,j] = (Data.p).(j+1)) &
      (len (Data.p) <= j implies Pelt.[p,j] = 0)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    0 <= sz & sz < (2 |^ 32) &
    0 <= y & y < (2 |^ 64) &
    -(2 |^ 31) <= Signed32.sz &
    Signed32.sz <= 2147483647 &
    0 <= Signed32.sz &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + Signed32.sz <= Maximum.x &
    Maximum.x <= len (Data.x) &
    0 < Signed32.sz &
    (for vx being Integer st
       vx = VSub.[x,[Offset.x,Offset.x+Signed32.sz]]
     holds 0 <= vx - y) &
    Writable.x = TRUE
  holds
    Minimum.x <= Offset.x &
    Offset.x < Maximum.x &
    (Minimum.x <= Offset.x + 1 &
     Offset.x + 1 <= Maximum.x) &
    (for o2 being Element of P st
       Offset.o2 = Offset.x + 1 &
       len (Data.o2) = len (Data.x) &
       (for j being Element of INT holds
         Pelt.[o2,j] = Pelt.[x,j]) &
       Data.o2 = Data.x &
       Minimum.o2 = Minimum.x &
       Maximum.o2 = Maximum.x &
       Zone.o2 = Zone.x &
       Writable.o2 = Writable.x
     holds
       for res being Element of INT st
         0 <= res & res < (2 |^ 64) &
         (for px being Integer st px = Pelt.[x,Offset.x] holds
           res = (px - y) mod (2 |^ 64))
       holds
         (Minimum.x <= Offset.x &
          Offset.x < Maximum.x) &
         Writable.x = TRUE &
         (for xp,x1 being Element of P st
            Data.xp = Data.x1 &
            len (Data.x1) = len (Data.o2) &
            Offset.xp = Offset.o2 &
            Minimum.xp = Minimum.o2 &
            Maximum.xp = Maximum.o2 &
            Writable.xp = Writable.o2 &
            Zone.xp = Zone.o2 &
            len (Data.x1) = len (Data.x) &
            Offset.x1 = Offset.x &
            Minimum.x1 = Minimum.x &
            Maximum.x1 = Maximum.x &
            Writable.x1 = Writable.x &
            Zone.x1 = Zone.x &
            (for j being Element of INT holds
              (j = Offset.x1 implies Pelt.[x1,j] = res) &
              (j <> Offset.x1 implies
                Pelt.[x1,j] = Pelt.[x,j]))
          holds
            for px being Integer st px = Pelt.[x,Offset.x] holds
            (px < res implies
              ((1 <= 1 & 1 <= Signed32.sz) &
               Offset.xp = Offset.x1 + 1 &
               (for j being Element of INT holds
                 Pelt.[xp,j] = Pelt.[x1,j]) &
               len (Data.xp) = len (Data.x1) &
               (Minimum.xp = Minimum.x1 &
                Maximum.xp = Maximum.x1) &
               (1 = sz implies 1 = 0) &
               (0 <= 1 & 1 <= 1) &
               Writable.xp = TRUE &
               (for vx1,vx,power being Integer st
                  vx1 = VSub.[x1,[Offset.x1,Offset.x1+1]] &
                  vx = VSub.[x,[Offset.x,Offset.x+1]] &
                  power = Pow.1
                holds vx1 - power * 1 = vx - y) &
               (for j being Element of INT st
                  1 <= j & j < Signed32.sz
                holds
                  Pelt.[x1,Offset.x1+j] =
                    Pelt.[x,Offset.x1+j]) &
               (for j being Element of INT st
                  j < Offset.x1 or
                  Offset.x1 + Signed32.sz <= j
                holds Pelt.[x1,j] = Pelt.[x,j])) &
              (for i,b being Element of INT,
                   xp1,x2 being Element of P st
                 0 <= i & i < (2 |^ 32) &
                 0 <= b & b < (2 |^ 64) &
                 len (Data.x2) = len (Data.x1) &
                 Offset.x2 = Offset.x1 &
                 Minimum.x2 = Minimum.x1 &
                 Maximum.x2 = Maximum.x1 &
                 Writable.x2 = Writable.x1 &
                 Zone.x2 = Zone.x1 &
                 (1 <= Signed32.i &
                  Signed32.i <= Signed32.sz) &
                 Offset.xp1 = Offset.x2 + Signed32.i &
                 (for j being Element of INT holds
                   Pelt.[xp1,j] = Pelt.[x2,j]) &
                 len (Data.xp1) = len (Data.x2) &
                 (Minimum.xp1 = Minimum.x2 &
                  Maximum.xp1 = Maximum.x2) &
                 (i = sz implies b = 0) &
                 (0 <= b & b <= 1) &
                 Writable.xp1 = TRUE &
                 (for vx2,vx,power being Integer st
                    vx2 =
                      VSub.[x2,
                        [Offset.x2,Offset.x2+Signed32.i]] &
                    vx =
                      VSub.[x,
                        [Offset.x,Offset.x+Signed32.i]] &
                    power = Pow.(Signed32.i)
                  holds vx2 - power * b = vx - y) &
                 (for j being Element of INT st
                    Signed32.i <= j & j < Signed32.sz
                  holds
                    Pelt.[x2,Offset.x2+j] =
                      Pelt.[x,Offset.x2+j]) &
                 (for j being Element of INT st
                    j < Offset.x2 or
                    Offset.x2 + Signed32.sz <= j
                  holds Pelt.[x2,j] = Pelt.[x,j])
               holds
                 for o3 being Element of BOOLEAN st
                   (b = 0 implies o3 = TRUE) &
                   (o3 = TRUE implies b = 0)
                 holds
                   (o3 <> TRUE implies
                     (Minimum.xp1 <= Offset.xp1 &
                      Offset.xp1 < Maximum.xp1) &
                     (for res1 being Element of INT st
                        0 <= res1 & res1 < (2 |^ 64) &
                        (for px1 being Integer st
                           px1 = Pelt.[xp1,Offset.xp1]
                         holds
                           res1 = (px1 - 1) mod (2 |^ 64))
                      holds
                        (Minimum.xp1 <= Offset.xp1 &
                         Offset.xp1 < Maximum.xp1) &
                        Writable.xp1 = TRUE &
                        (for xp2,x3 being Element of P st
                           Data.xp2 = Data.x3 &
                           len (Data.x3) = len (Data.xp1) &
                           Offset.xp2 = Offset.xp1 &
                           Minimum.xp2 = Minimum.xp1 &
                           Maximum.xp2 = Maximum.xp1 &
                           Writable.xp2 = Writable.xp1 &
                           Zone.xp2 = Zone.xp1 &
                           len (Data.x3) = len (Data.x2) &
                           Offset.x3 = Offset.x2 &
                           Minimum.x3 = Minimum.x2 &
                           Maximum.x3 = Maximum.x2 &
                           Writable.x3 = Writable.x2 &
                           Zone.x3 = Zone.x2 &
                           (for j being Element of INT holds
                             (j = Offset.xp2 implies
                               Pelt.[xp2,j] = res1) &
                             (j <> Offset.xp2 implies
                               Pelt.[xp2,j] = Pelt.[xp1,j]))
                         holds
                           -(2 |^ 31) <= Signed32.i + 1 &
                           Signed32.i + 1 <= 2147483647 &
                           (for o4 being Element of INT st
                              0 <= o4 & o4 < (2 |^ 32) &
                              Signed32.o4 = Signed32.i + 1
                            holds
                              (Minimum.xp2 <= Offset.xp2 + 1 &
                               Offset.xp2 + 1 <= Maximum.xp2) &
                              (for o5 being Element of P st
                                 Offset.o5 = Offset.xp2 + 1 &
                                 len (Data.o5) = len (Data.xp2) &
                                 (for j being Element of INT holds
                                   Pelt.[o5,j] = Pelt.[xp2,j]) &
                                 Data.o5 = Data.xp2 &
                                 Minimum.o5 = Minimum.xp2 &
                                 Maximum.o5 = Maximum.xp2 &
                                 Zone.o5 = Zone.xp2 &
                                 Writable.o5 = Writable.xp2
                               holds
                                 for o6 being Element of BOOLEAN st
                                   (Pelt.[xp1,Offset.xp1] = 0
                                      implies o6 = TRUE) &
                                   (o6 = TRUE implies
                                      Pelt.[xp1,Offset.xp1] = 0)
                                 holds
                                   (o6 <> TRUE implies
                                     (for vx3,vx being Integer st
                                        vx3 = VSub.[x3,
                                          [Offset.x3,
                                           Offset.x3+Signed32.sz]] &
                                        vx = VSub.[x,
                                          [Offset.x,
                                           Offset.x+Signed32.sz]]
                                      holds vx3 = vx - y) &
                                     (for j being Element of INT st
                                        j < Offset.x3 or
                                        Offset.x3 +
                                          Signed32.sz <= j
                                      holds
                                        Pelt.[x3,j] = Pelt.[x,j])) &
                                   (o6 = TRUE implies
                                     (0 <=
                                        Signed32.sz - Signed32.i &
                                      Signed32.sz - Signed32.o4 <
                                        Signed32.sz - Signed32.i) &
                                     (1 <= Signed32.o4 &
                                      Signed32.o4 <= Signed32.sz) &
                                     Offset.o5 =
                                       Offset.x3 + Signed32.o4 &
                                     (for j being Element of INT holds
                                       Pelt.[o5,j] = Pelt.[x3,j]) &
                                     len (Data.o5) = len (Data.x3) &
                                     (Minimum.o5 = Minimum.x3 &
                                      Maximum.o5 = Maximum.x3) &
                                     (o4 = sz implies b = 0) &
                                     (0 <= b & b <= 1) &
                                     Writable.o5 = TRUE &
                                     (for vx3,vx,power being Integer st
                                        vx3 = VSub.[x3,
                                          [Offset.x3,
                                           Offset.x3+Signed32.o4]] &
                                        vx = VSub.[x,
                                          [Offset.x,
                                           Offset.x+Signed32.o4]] &
                                        power = Pow.(Signed32.o4)
                                      holds
                                        vx3 - power * b = vx - y) &
                                     (for j being Element of INT st
                                        Signed32.o4 <= j &
                                        j < Signed32.sz
                                      holds
                                        Pelt.[x3,Offset.x3+j] =
                                          Pelt.[x,Offset.x3+j]) &
                                     (for j being Element of INT st
                                        j < Offset.x3 or
                                        Offset.x3 +
                                          Signed32.sz <= j
                                      holds
                                        Pelt.[x3,j] =
                                          Pelt.[x,j])))))) &
                   (o3 = TRUE implies
                     (for vx2,vx being Integer st
                        vx2 = VSub.[x2,
                          [Offset.x2,
                           Offset.x2+Signed32.sz]] &
                        vx = VSub.[x,
                          [Offset.x,
                           Offset.x+Signed32.sz]]
                      holds vx2 = vx - y) &
                     (for j being Element of INT st
                        j < Offset.x2 or
                        Offset.x2 + Signed32.sz <= j
                      holds Pelt.[x2,j] = Pelt.[x,j])))) &
            (not px < res implies
              (for vx1,vx being Integer st
                 vx1 = VSub.[x1,
                   [Offset.x1,
                    Offset.x1+Signed32.sz]] &
                 vx = VSub.[x,
                   [Offset.x,
                    Offset.x+Signed32.sz]]
               holds vx1 = vx - y) &
              (for j being Element of INT st
                 j < Offset.x1 or
                 Offset.x1 + Signed32.sz <= j
               holds Pelt.[x1,j] = Pelt.[x,j])))))
proof
end;
::$P+
