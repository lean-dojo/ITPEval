:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_1_Sub_1_wmpn_sub_1qtvc: the verification
:: condition for subtracting one 64-bit limb from a positive-length
:: multiprecision integer into a writable destination, including borrow
:: propagation, copying remaining limbs, and memory framing. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, PARTFUN1, STRUCT_0, GRAPH_1, CAT_1, CAT_3,
    NATTRA_1, ISOCAT_1, PUA2MSS1, REWRITE1, GROEB_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    PARTFUN1, STRUCT_0, GRAPH_1, CAT_1, CAT_2, CAT_3, NATTRA_1, ISOCAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, CAT_1, CAT_2, CAT_3, NATTRA_1, ISOCAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, STRUCT_0, CAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

definition
  let Bundle,State be set;
  pred Bundle is_a_coproduct_wrt State means
    ex P,Z being non empty set,
       Len being Function of P,NAT,
       Offset,Minimum,Maximum being Function of P,INT,
       Writable being Function of P,BOOLEAN,
       Zone being Function of P,Z,
       Pelt being Function of [:P,INT:],INT,
       VSub being Function of [:P,[:INT,INT:]:],INT,
       Pow being Function of INT,INT,
       x,r,s being Element of P,
       sz,y,b being Element of INT
    st
    Bundle =
      [Len,[Offset,[Minimum,[Maximum,[Writable,[Zone,
        [Pelt,[VSub,[Pow,[x,[r,[sz,[y,b]]]]]]]]]]]]] &
    State = s &
    (for i being Element of INT,
         s1 being Element of P st
       -(2 |^ 31) <= i & i <= 2147483647 &
       Len.s1 = Len.s &
       Offset.s1 = Offset.s &
       Minimum.s1 = Minimum.s &
       Maximum.s1 = Maximum.s &
       Writable.s1 = Writable.s &
       Zone.s1 = Zone.s &
       (i = sz or b = 0) &
       (0 <= i & i <= sz) &
       (for vs1,vx being Integer st
          vs1 = VSub.[s1,[Offset.s1,Offset.s1+i]] &
          vx = VSub.[x,[Offset.x,Offset.x+i]]
        holds vs1 - Pow.i * b = vx - y) &
       (for j being Element of INT st
          j < Offset.s1 or Offset.s1 + sz <= j
        holds Pelt.[s1,j] = Pelt.[r,j])
     holds
       (i < sz implies
         (Minimum.x <= Offset.x + i &
          Offset.x + i < Maximum.x) &
         (Minimum.s1 <= Offset.s1 + i &
          Offset.s1 + i < Maximum.s1) &
         Writable.s1 = TRUE &
         (for s2 being Element of P st
            Len.s2 = Len.s1 &
            Offset.s2 = Offset.s1 &
            Minimum.s2 = Minimum.s1 &
            Maximum.s2 = Maximum.s1 &
            Writable.s2 = Writable.s1 &
            Zone.s2 = Zone.s1 &
            (for j being Element of INT holds
               (j = Offset.s2 + i implies
                  Pelt.[s2,j] = Pelt.[x,Offset.x+i]) &
               (j <> Offset.s2 + i implies
                  Pelt.[s2,j] = Pelt.[s1,j])) &
            Pelt.[s2,Offset.s2+i] = Pelt.[x,Offset.x+i]
          holds
            -(2 |^ 31) <= i+1 &
            i+1 <= 2147483647 &
            (for o being Element of INT st o = i+1
             holds
               (0 <= sz-i & sz-o < sz-i) &
               (o = sz or b = 0) &
               (0 <= o & o <= sz) &
               (for vs2,vx being Integer st
                  vs2 = VSub.[s2,[Offset.s2,Offset.s2+o]] &
                  vx = VSub.[x,[Offset.x,Offset.x+o]]
                holds vs2 - Pow.o * b = vx - y) &
               (for j being Element of INT st
                  j < Offset.s2 or Offset.s2 + sz <= j
                holds Pelt.[s2,j] = Pelt.[r,j])))) &
       (not i < sz implies
         (for vs1,vx being Integer st
            vs1 = VSub.[s1,[Offset.s1,Offset.s1+sz]] &
            vx = VSub.[x,[Offset.x,Offset.x+sz]]
          holds vs1 - Pow.sz * b = vx - y) &
         (for j being Element of INT st
            j < Offset.s1 or Offset.s1 + sz <= j
          holds Pelt.[s1,j] = Pelt.[r,j]) &
         (0 <= b & b <= 1)));
end;

definition
  let Bundle,XPair,NPair be set;
  pred Bundle is_a_product_wrt XPair,NPair means
    ex P,Z being non empty set,
       Len being Function of P,NAT,
       Offset,Minimum,Maximum being Function of P,INT,
       Writable being Function of P,BOOLEAN,
       Zone being Function of P,Z,
       Pelt being Function of [:P,INT:],INT,
       VSub being Function of [:P,[:INT,INT:]:],INT,
       Pow being Function of INT,INT,
       x,r being Element of P,
       sz,y being Element of INT
    st
    Bundle =
      [Len,[Offset,[Minimum,[Maximum,[Writable,
        [Zone,[Pelt,[VSub,Pow]]]]]]]] &
    XPair = [x,r] &
    NPair = [sz,y] &
    ((for p being Element of P, j being Element of INT holds
      for pj being Integer st pj = Pelt.[p,j] holds
        0 <= pj & pj < (2 |^ 64)) &
    Pow.0 = 1 &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    -(2 |^ 31) <= sz & sz <= 2147483647 &
    0 <= y & y < (2 |^ 64) &
    0 <= sz &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + sz <= Maximum.x &
    Maximum.x <= Len.x &
    0 <= Minimum.r &
    Minimum.r <= Offset.r &
    Offset.r + sz <= Maximum.r &
    Maximum.r <= Len.r &
    0 < sz &
    Writable.r = TRUE)
  implies
    Minimum.x <= Offset.x &
    Offset.x < Maximum.x &
    (for res being Element of INT st
       0 <= res & res < (2 |^ 64) &
       (for px being Integer st px = Pelt.[x,Offset.x] holds
          res = (px - y) mod (2 |^ 64))
     holds
       (Minimum.r <= Offset.r & Offset.r < Maximum.r) &
       Writable.r = TRUE &
       (for r1 being Element of P st
          Len.r1 = Len.r &
          Offset.r1 = Offset.r &
          Minimum.r1 = Minimum.r &
          Maximum.r1 = Maximum.r &
          Writable.r1 = Writable.r &
          Zone.r1 = Zone.r &
          (for j being Element of INT holds
             (j = Offset.r1 implies Pelt.[r1,j] = res) &
             (j <> Offset.r1 implies Pelt.[r1,j] = Pelt.[r,j]))
        holds
          (for px being Integer st px = Pelt.[x,Offset.x] holds
            (px < y implies
              ((1 <= 1 & 1 <= sz) &
               (0 <= 1 & 1 <= 1) &
               (1 = sz or 1 = 1) &
               (for vr1,vx,p1 being Integer st
                  vr1 = VSub.[r1,[Offset.r1,Offset.r1+1]] &
                  vx = VSub.[x,[Offset.x,Offset.x+1]] &
                  p1 = Pow.1
                holds vr1 - p1 * 1 = vx - y) &
               (for j being Element of INT st
                  j < Offset.r1 or Offset.r1 + sz <= j
                holds Pelt.[r1,j] = Pelt.[r,j])) &
              (for i,b being Element of INT,
                   r2 being Element of P st
                 -(2 |^ 31) <= i & i <= 2147483647 &
                 0 <= b & b < (2 |^ 64) &
                 Len.r2 = Len.r1 &
                 Offset.r2 = Offset.r1 &
                 Minimum.r2 = Minimum.r1 &
                 Maximum.r2 = Maximum.r1 &
                 Writable.r2 = Writable.r1 &
                 Zone.r2 = Zone.r1 &
                 (1 <= i & i <= sz) &
                 (0 <= b & b <= 1) &
                 (i = sz or b = 1) &
                 (for vr2,vx being Integer st
                    vr2 = VSub.[r2,[Offset.r2,Offset.r2+i]] &
                    vx = VSub.[x,[Offset.x,Offset.x+i]]
                  holds vr2 - Pow.i * b = vx - y) &
                 (for j being Element of INT st
                    j < Offset.r2 or Offset.r2 + sz <= j
                  holds Pelt.[r2,j] = Pelt.[r,j])
               holds
                 (i < sz implies
                   (Minimum.x <= Offset.x + i &
                    Offset.x + i < Maximum.x) &
                   (for res1 being Element of INT st
                      0 <= res1 &
                      res1 < (2 |^ 64) &
                      (for pxi being Integer st
                         pxi = Pelt.[x,Offset.x+i]
                       holds res1 = (pxi - 1) mod (2 |^ 64))
                    holds
                      (Minimum.r2 <= Offset.r2 + i &
                       Offset.r2 + i < Maximum.r2) &
                      Writable.r2 = TRUE &
                      (for r3 being Element of P st
                         Len.r3 = Len.r2 &
                         Offset.r3 = Offset.r2 &
                         Minimum.r3 = Minimum.r2 &
                         Maximum.r3 = Maximum.r2 &
                         Writable.r3 = Writable.r2 &
                         Zone.r3 = Zone.r2 &
                         (for j being Element of INT holds
                            (j = Offset.r3 + i implies
                               Pelt.[r3,j] = res1) &
                            (j <> Offset.r3 + i implies
                               Pelt.[r3,j] = Pelt.[r2,j])) &
                         Pelt.[r3,Offset.r3+i] = res1
                       holds
                         -(2 |^ 31) <= i+1 &
                         i+1 <= 2147483647 &
                         (for o2 being Element of INT st o2 = i+1
                          holds
                            (for o3 being Element of BOOLEAN st
                               (Pelt.[x,Offset.x+i] = 0
                                  implies o3 = TRUE) &
                               (o3 = TRUE implies
                                  Pelt.[x,Offset.x+i] = 0)
                             holds
                               (o3 <> TRUE implies
                                 ((o2 = sz or 0 = 0) &
                                  (0 <= o2 & o2 <= sz) &
                                  (for vr3,vx being Integer st
                                     vr3 = VSub.[r3,
                                       [Offset.r3,Offset.r3+o2]] &
                                     vx = VSub.[x,
                                       [Offset.x,Offset.x+o2]]
                                   holds
                                     vr3 - Pow.o2 * 0 = vx - y) &
                                  (for j being Element of INT st
                                     j < Offset.r3 or
                                     Offset.r3 + sz <= j
                                   holds Pelt.[r3,j] = Pelt.[r,j])) &
                                 (for B,S being set st
                                    B = [Len,[Offset,[Minimum,[Maximum,
                                      [Writable,[Zone,[Pelt,[VSub,
                                        [Pow,[x,[r,[sz,[y,0]]]]]]]]]]]]] &
                                    S = r3
                                  holds B is_a_coproduct_wrt S)) &
                               (o3 = TRUE implies
                                 (0 <= sz-i & sz-o2 < sz-i) &
                                 (1 <= o2 & o2 <= sz) &
                                 (0 <= b & b <= 1) &
                                 (o2 = sz or b = 1) &
                                 (for vr3,vx being Integer st
                                    vr3 = VSub.[r3,
                                      [Offset.r3,Offset.r3+o2]] &
                                    vx = VSub.[x,
                                      [Offset.x,Offset.x+o2]]
                                  holds
                                    vr3 - Pow.o2 * b = vx - y) &
                                 (for j being Element of INT st
                                    j < Offset.r3 or
                                    Offset.r3 + sz <= j
                                  holds Pelt.[r3,j] = Pelt.[r,j])))))) &
                 (not i < sz implies
                   (((i = sz or b = 0) &
                     (0 <= i & i <= sz) &
                     (for vr2,vx being Integer st
                        vr2 = VSub.[r2,[Offset.r2,Offset.r2+i]] &
                        vx = VSub.[x,[Offset.x,Offset.x+i]]
                      holds vr2 - Pow.i * b = vx - y) &
                     (for j being Element of INT st
                        j < Offset.r2 or Offset.r2 + sz <= j
                      holds Pelt.[r2,j] = Pelt.[r,j])) &
                    (for B,S being set st
                       B = [Len,[Offset,[Minimum,[Maximum,[Writable,
                         [Zone,[Pelt,[VSub,
                           [Pow,[x,[r,[sz,[y,b]]]]]]]]]]]]] &
                       S = r2
                     holds B is_a_coproduct_wrt S)))) &
            (not px < y implies
              ((0 <= 1 & 1 <= sz) &
               (for vr1,vx,p1 being Integer st
                  vr1 = VSub.[r1,[Offset.r1,Offset.r1+1]] &
                  vx = VSub.[x,[Offset.x,Offset.x+1]] &
                  p1 = Pow.1
                holds vr1 - p1 * 0 = vx - y) &
               (for j being Element of INT st
                  j < Offset.r1 or Offset.r1 + sz <= j
                holds Pelt.[r1,j] = Pelt.[r,j])) &
              (for B,S being set st
                 B = [Len,[Offset,[Minimum,[Maximum,[Writable,[Zone,
                   [Pelt,[VSub,
                     [Pow,[x,[r,[sz,[y,0]]]]]]]]]]]]] &
                 S = r1
               holds B is_a_coproduct_wrt S)))))));
end;

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      x,r being Element of P,
      sz,y being Element of INT
  holds
    for B,XP,NP being set st
      B = [Len,[Offset,[Minimum,[Maximum,[Writable,
        [Zone,[Pelt,[VSub,Pow]]]]]]]] &
      XP = [x,r] & NP = [sz,y]
    holds B is_a_product_wrt XP,NP
proof
end;
::$P+
