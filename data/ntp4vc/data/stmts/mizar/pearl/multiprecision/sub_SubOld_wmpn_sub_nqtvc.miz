:: Statement-only formalization of NTP4VC corpus artifact
:: pearl/multiprecision/sub_SubOld_wmpn_sub_nqtvc: the loop verification
:: condition for multiprecision limb subtraction with borrow and pointer-state
:: updates. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, ZFMISC_1,
    FUNCT_1, FUNCT_2, NAT_1, NUMBERS, INT_1, INT_2, XXREAL_0,
    XREAL_0, REAL_1, ARYTM_1, ARYTM_3, CARD_1, ORDINAL1,
    BINOP_1, MARGREL1, XBOOLEAN, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, XXREAL_0, NAT_1, INT_1, INT_2,
    BINOP_1, MARGREL1, VALUED_0, VALUED_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, CARD_1,
    REAL_1, XXREAL_0, NAT_1, INT_1, INT_2, BINOP_1, MARGREL1,
    BINOP_2, VALUED_0, VALUED_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, XCMPLX_0,
    XREAL_0, ORDINAL1, NAT_1, INT_1, INT_2, MARGREL1,
    VALUED_0, VALUED_1;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for Ptr,Zone being non empty set,
      Length,Offset,MinPtr,MaxPtr being Function of Ptr,REAL,
      Writable being Function of Ptr,BOOLEAN,
      ZoneOf being Function of Ptr,Zone,
      Pelt,Value being Function of [:Ptr,REAL:],REAL,
      Signed32,RadixPower being Function of REAL,REAL,
      x,y,r being Element of Ptr,
      sz being Integer
  st
    (for p being Element of Ptr holds
      Length.p in NAT &
      Offset.p in INT &
      MinPtr.p in INT &
      MaxPtr.p in INT) &
    0 <= sz & sz < 65536 * 65536 &
    (for n being Integer st 0 <= n & n < 65536 * 65536 holds
      Signed32.(n qua Real) in INT &
      (n < 32768 * 65536 implies Signed32.(n qua Real) = n) &
      (32768 * 65536 <= n implies
        Signed32.(n qua Real) = n - 65536 * 65536)) &
    RadixPower.(0 qua Real) = 1 &
    (for n being Nat holds
      RadixPower.(n qua Real) in INT &
      RadixPower.((n+1) qua Real) =
        (65536 * 65536) * (65536 * 65536) * RadixPower.(n qua Real)) &
    (for p being Element of Ptr, j being Integer holds
      Pelt.([p,j qua Real]) in INT &
      0 <= Pelt.([p,j qua Real]) &
      Pelt.([p,j qua Real]) <
        (65536 * 65536) * (65536 * 65536)) &
    (for p being Element of Ptr, j being Integer holds
      Value.([p,j qua Real]) in INT) &
    (for p being Element of Ptr holds Value.([p,0]) = 0) &
    (for p being Element of Ptr, j being Integer st j < 0 holds
      Value.([p,j qua Real]) = 0) &
    (for p being Element of Ptr, n being Nat holds
      Value.([p,(n+1) qua Real]) =
        Value.([p,n qua Real]) +
          RadixPower.(n qua Real) *
            Pelt.([p,Offset.p+n])) &
    (-(32768 * 65536) <= Signed32.(sz qua Real) &
      Signed32.(sz qua Real) <= 32768 * 65536 - 1 &
      0 <= Signed32.(sz qua Real) &
      0 <= MinPtr.x & MinPtr.x <= Offset.x &
      Offset.x + Signed32.(sz qua Real) <= MaxPtr.x &
      MaxPtr.x <= Length.x) &
    (-(32768 * 65536) <= Signed32.(sz qua Real) &
      Signed32.(sz qua Real) <= 32768 * 65536 - 1 &
      0 <= Signed32.(sz qua Real) &
      0 <= MinPtr.y & MinPtr.y <= Offset.y &
      Offset.y + Signed32.(sz qua Real) <= MaxPtr.y &
      MaxPtr.y <= Length.y) &
    (-(32768 * 65536) <= Signed32.(sz qua Real) &
      Signed32.(sz qua Real) <= 32768 * 65536 - 1 &
      0 <= Signed32.(sz qua Real) &
      0 <= MinPtr.r & MinPtr.r <= Offset.r &
      Offset.r + Signed32.(sz qua Real) <= MaxPtr.r &
      MaxPtr.r <= Length.r) &
    Writable.r = TRUE
  holds
    0 <= 0 &
    0 <= Signed32.(sz qua Real) &
    Value.([r,0]) - RadixPower.(0 qua Real) * 0 =
      Value.([x,0]) - Value.([y,0]) &
    0 <= 0 &
    0 <= 1 &
    (for i,b being Integer, r1 being Element of Ptr
      st
        0 <= i & i < 65536 * 65536 &
        0 <= b &
        b < (65536 * 65536) * (65536 * 65536)
      holds
        (Length.r1 = Length.r &
         Offset.r1 = Offset.r &
         MinPtr.r1 = MinPtr.r &
         MaxPtr.r1 = MaxPtr.r &
         Writable.r1 = Writable.r &
         ZoneOf.r1 = ZoneOf.r
         implies
          ((0 <= Signed32.(i qua Real) &
            Signed32.(i qua Real) <= Signed32.(sz qua Real)) &
           Value.([r1,Signed32.(i qua Real)]) -
               RadixPower.(Signed32.(i qua Real)) * b =
             Value.([x,Signed32.(i qua Real)]) -
               Value.([y,Signed32.(i qua Real)]) &
           (for j being Integer st
              j < Offset.r1 or
              Offset.r1 + Signed32.(sz qua Real) <= j
            holds
              Pelt.([r1,j qua Real]) =
                Pelt.([r,j qua Real])) &
           0 <= b & b <= 1
           implies
            ((Signed32.(i qua Real) < Signed32.(sz qua Real)
              implies
                (MinPtr.x <= Offset.x + Signed32.(i qua Real) &
                 Offset.x + Signed32.(i qua Real) < MaxPtr.x) &
                (MinPtr.y <= Offset.y + Signed32.(i qua Real) &
                 Offset.y + Signed32.(i qua Real) < MaxPtr.y) &
                (0 <= b & b <= 1) &
                (for res,borrow being Integer
                  st
                    0 <= res &
                    res < (65536 * 65536) * (65536 * 65536) &
                    0 <= borrow &
                    borrow <
                      (65536 * 65536) * (65536 * 65536)
                  holds
                    (res -
                       (65536 * 65536) * (65536 * 65536) *
                         borrow =
                       Pelt.([x,Offset.x+Signed32.(i qua Real)]) -
                       Pelt.([y,Offset.y+Signed32.(i qua Real)]) -
                         b &
                     0 <= borrow & borrow <= 1
                     implies
                       ((MinPtr.r1 <= Offset.r1 + Signed32.(i qua Real) &
                         Offset.r1 + Signed32.(i qua Real) < MaxPtr.r1) &
                        Writable.r1 = TRUE) &
                       (for r2 being Element of Ptr holds
                         (Length.r2 = Length.r1 &
                          Offset.r2 = Offset.r1 &
                          MinPtr.r2 = MinPtr.r1 &
                          MaxPtr.r2 = MaxPtr.r1 &
                          Writable.r2 = Writable.r1 &
                          ZoneOf.r2 = ZoneOf.r1
                          implies
                            ((for j being Integer holds
                                (j = Offset.r2 + Signed32.(i qua Real)
                                  implies
                                    Pelt.([r2,j qua Real]) = res) &
                                (j <> Offset.r2 + Signed32.(i qua Real)
                                  implies
                                    Pelt.([r2,j qua Real]) =
                                      Pelt.([r1,j qua Real]))) &
                             Pelt.(
                               [r2,Offset.r2+
                                 Signed32.(i qua Real)]) = res
                             implies
                               -(32768 * 65536) <=
                                  Signed32.(i qua Real) + 1 &
                               Signed32.(i qua Real) + 1 <=
                                  32768 * 65536 - 1 &
                               (for o1 being Integer
                                 st
                                   0 <= o1 &
                                   o1 < 65536 * 65536
                                 holds
                                   (Signed32.(o1 qua Real) =
                                      Signed32.(i qua Real) + 1
                                    implies
                                      (0 <= Signed32.(sz qua Real) -
                                          Signed32.(i qua Real) &
                                       Signed32.(sz qua Real) -
                                          Signed32.(o1 qua Real) <
                                        Signed32.(sz qua Real) -
                                          Signed32.(i qua Real)) &
                                      (0 <= Signed32.(o1 qua Real) &
                                       Signed32.(o1 qua Real) <=
                                        Signed32.(sz qua Real)) &
                                      Value.(
                                        [r2,Signed32.(o1 qua Real)]) -
                                          RadixPower.(
                                            Signed32.(o1 qua Real)) *
                                            borrow =
                                        Value.(
                                          [x,Signed32.(o1 qua Real)]) -
                                        Value.(
                                          [y,Signed32.(o1 qua Real)]) &
                                      (for j being Integer st
                                         j < Offset.r2 or
                                         Offset.r2 +
                                           Signed32.(sz qua Real) <= j
                                       holds
                                         Pelt.([r2,j qua Real]) =
                                           Pelt.([r,j qua Real])) &
                                      0 <= borrow &
                                      borrow <= 1))))))) &
             (not Signed32.(i qua Real) < Signed32.(sz qua Real)
              implies
                (0 <= b & b <= 1) &
                Value.([r1,Signed32.(sz qua Real)]) -
                    RadixPower.(Signed32.(sz qua Real)) * b =
                  Value.([x,Signed32.(sz qua Real)]) -
                    Value.([y,Signed32.(sz qua Real)]) &
                (for j being Integer st
                   j < Offset.r1 or
                   Offset.r1 + Signed32.(sz qua Real) <= j
                 holds
                   Pelt.([r1,j qua Real]) =
                     Pelt.([r,j qua Real]))))))))
proof
end;
::$P+
