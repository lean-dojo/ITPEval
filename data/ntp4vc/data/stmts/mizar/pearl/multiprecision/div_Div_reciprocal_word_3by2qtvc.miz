:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/div_Div_reciprocal_word_3by2qtvc: the verification
:: condition for computing a reciprocal estimate for a normalized two-limb
:: unsigned 64-bit divisor, including carry, borrow, and final adjustment
:: branches. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, MARGREL1, XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for dh,dl being Integer st
    0 <= dh & dh < (2 |^ 64) &
    0 <= dl & dl < (2 |^ 64) &
    ((2 |^ 64) div 2) <= dh
  holds
    ((2 |^ 64) div 2) <= dh &
    (for o1 being Integer st
       0 <= o1 & o1 < (2 |^ 64) &
       o1 = ((((2 |^ 64) * (2 |^ 64)) - 1) div dh)
              - (2 |^ 64)
     holds
       for o2 being Integer st
         0 <= o2 & o2 < (2 |^ 64) &
         o2 = (dh * o1) mod (2 |^ 64)
       holds
         for o3 being Integer st
           0 <= o3 & o3 < (2 |^ 64) &
           o3 = (o2 + dl) mod (2 |^ 64)
         holds
           (o3 < dl implies
             (dh <= o3 implies
               (0 <= o1 - 1 & o1 - 1 < (2 |^ 64)) &
               (for o4 being Integer st
                  0 <= o4 & o4 < (2 |^ 64) &
                  o4 = o1 - 1
                holds
                  (0 <= o3 - dh & o3 - dh < (2 |^ 64)) &
                  (for o5 being Integer st
                     0 <= o5 & o5 < (2 |^ 64) &
                     o5 = o3 - dh
                   holds
                     (0 <= o4 - 1 & o4 - 1 < (2 |^ 64)) &
                     (for o6 being Integer st
                        0 <= o6 & o6 < (2 |^ 64) &
                        o6 = o4 - 1
                      holds
                        for o7 being Integer st
                          0 <= o7 & o7 < (2 |^ 64) &
                          o7 = (o5 - dh) mod (2 |^ 64)
                        holds
                          for tl,th being Integer st
                            0 <= tl & tl < (2 |^ 64) &
                            0 <= th & th < (2 |^ 64) &
                            tl + (2 |^ 64) * th = o6 * dl
                          holds
                            for o8 being Integer st
                              0 <= o8 & o8 < (2 |^ 64) &
                              o8 = (o7 + th) mod (2 |^ 64)
                            holds
                              (o8 < th implies
                                for o9 being Element of BOOLEAN st
                                  ((dh < o8 & o9 = TRUE) or
                                   (not dh < o8 &
                                    ex eqflag1 being
                                         Element of BOOLEAN st
                                      (o8 = dh implies
                                         eqflag1 = TRUE) &
                                      (eqflag1 = TRUE implies
                                         o8 = dh) &
                                      (eqflag1 = TRUE & dl <= tl
                                         implies o9 = TRUE) &
                                      (not (eqflag1 = TRUE &
                                            dl <= tl)
                                         implies o9 = FALSE)))
                                holds
                                  (o9 = TRUE implies
                                    (0 <= o6 - 1 &
                                     o6 - 1 < (2 |^ 64)) &
                                    (for o10 being Integer st
                                       0 <= o10 &
                                       o10 < (2 |^ 64) &
                                       o10 = o6 - 1
                                     holds
                                       (0 <= o10 - 1 &
                                        o10 - 1 < (2 |^ 64)) &
                                       (for o11 being Integer st
                                          0 <= o11 &
                                          o11 < (2 |^ 64) &
                                          o11 = o10 - 1
                                        holds
                                          o11 =
                                            ((((2 |^ 64) *
                                               (2 |^ 64) *
                                               (2 |^ 64)) - 1)
                                              div
                                                (dl +
                                                 (2 |^ 64) * dh))
                                             - (2 |^ 64)))) &
                                  (o9 <> TRUE implies
                                    (0 <= o6 - 1 &
                                     o6 - 1 < (2 |^ 64)) &
                                    (for o10 being Integer st
                                       0 <= o10 &
                                       o10 < (2 |^ 64) &
                                       o10 = o6 - 1
                                     holds
                                       o10 =
                                         ((((2 |^ 64) *
                                            (2 |^ 64) *
                                            (2 |^ 64)) - 1)
                                           div
                                             (dl +
                                              (2 |^ 64) * dh))
                                          - (2 |^ 64))) &
                              (not o8 < th implies
                                o6 =
                                  ((((2 |^ 64) * (2 |^ 64) *
                                     (2 |^ 64)) - 1)
                                    div (dl + (2 |^ 64) * dh))
                                   - (2 |^ 64))))))) &
             (not dh <= o3 implies
               (0 <= o1 - 1 & o1 - 1 < (2 |^ 64)) &
               (for o4 being Integer st
                  0 <= o4 & o4 < (2 |^ 64) &
                  o4 = o1 - 1
                holds
                  for o5 being Integer st
                    0 <= o5 & o5 < (2 |^ 64) &
                    o5 = (o3 - dh) mod (2 |^ 64)
                  holds
                    for tl,th being Integer st
                      0 <= tl & tl < (2 |^ 64) &
                      0 <= th & th < (2 |^ 64) &
                      tl + (2 |^ 64) * th = o4 * dl
                    holds
                      for o6 being Integer st
                        0 <= o6 & o6 < (2 |^ 64) &
                        o6 = (o5 + th) mod (2 |^ 64)
                      holds
                        (o6 < th implies
                          for o7 being Element of BOOLEAN st
                            ((dh < o6 & o7 = TRUE) or
                             (not dh < o6 &
                              ex eqflag2 being
                                   Element of BOOLEAN st
                                (o6 = dh implies eqflag2 = TRUE) &
                                (eqflag2 = TRUE implies o6 = dh) &
                                (eqflag2 = TRUE & dl <= tl
                                   implies o7 = TRUE) &
                                (not (eqflag2 = TRUE & dl <= tl)
                                   implies o7 = FALSE)))
                          holds
                            (o7 = TRUE implies
                              (0 <= o4 - 1 &
                               o4 - 1 < (2 |^ 64)) &
                              (for o8 being Integer st
                                 0 <= o8 & o8 < (2 |^ 64) &
                                 o8 = o4 - 1
                               holds
                                 (0 <= o8 - 1 &
                                  o8 - 1 < (2 |^ 64)) &
                                 (for o9 being Integer st
                                    0 <= o9 &
                                    o9 < (2 |^ 64) &
                                    o9 = o8 - 1
                                  holds
                                    o9 =
                                      ((((2 |^ 64) * (2 |^ 64) *
                                         (2 |^ 64)) - 1)
                                        div
                                          (dl + (2 |^ 64) * dh))
                                       - (2 |^ 64)))) &
                            (o7 <> TRUE implies
                              (0 <= o4 - 1 &
                               o4 - 1 < (2 |^ 64)) &
                              (for o8 being Integer st
                                 0 <= o8 & o8 < (2 |^ 64) &
                                 o8 = o4 - 1
                               holds
                                 o8 =
                                   ((((2 |^ 64) * (2 |^ 64) *
                                      (2 |^ 64)) - 1)
                                     div (dl + (2 |^ 64) * dh))
                                    - (2 |^ 64))) &
                        (not o6 < th implies
                          o4 =
                            ((((2 |^ 64) * (2 |^ 64) *
                               (2 |^ 64)) - 1)
                              div (dl + (2 |^ 64) * dh))
                             - (2 |^ 64)))))) &
           (not o3 < dl implies
             for tl,th being Integer st
               0 <= tl & tl < (2 |^ 64) &
               0 <= th & th < (2 |^ 64) &
               tl + (2 |^ 64) * th = o1 * dl
             holds
               for o4 being Integer st
                 0 <= o4 & o4 < (2 |^ 64) &
                 o4 = (o3 + th) mod (2 |^ 64)
               holds
                 (o4 < th implies
                   for o5 being Element of BOOLEAN st
                     ((dh < o4 & o5 = TRUE) or
                      (not dh < o4 &
                       ex eqflag3 being Element of BOOLEAN st
                         (o4 = dh implies eqflag3 = TRUE) &
                         (eqflag3 = TRUE implies o4 = dh) &
                         (eqflag3 = TRUE & dl <= tl
                            implies o5 = TRUE) &
                         (not (eqflag3 = TRUE & dl <= tl)
                            implies o5 = FALSE)))
                   holds
                     (o5 = TRUE implies
                       (0 <= o1 - 1 & o1 - 1 < (2 |^ 64)) &
                       (for o6 being Integer st
                          0 <= o6 & o6 < (2 |^ 64) &
                          o6 = o1 - 1
                        holds
                          (0 <= o6 - 1 &
                           o6 - 1 < (2 |^ 64)) &
                          (for o7 being Integer st
                             0 <= o7 & o7 < (2 |^ 64) &
                             o7 = o6 - 1
                           holds
                             o7 =
                               ((((2 |^ 64) * (2 |^ 64) *
                                  (2 |^ 64)) - 1)
                                 div (dl + (2 |^ 64) * dh))
                                - (2 |^ 64)))) &
                     (o5 <> TRUE implies
                       (0 <= o1 - 1 & o1 - 1 < (2 |^ 64)) &
                       (for o6 being Integer st
                          0 <= o6 & o6 < (2 |^ 64) &
                          o6 = o1 - 1
                        holds
                          o6 =
                            ((((2 |^ 64) * (2 |^ 64) *
                               (2 |^ 64)) - 1)
                              div (dl + (2 |^ 64) * dh))
                             - (2 |^ 64))) &
                 (not o4 < th implies
                   o1 =
                     ((((2 |^ 64) * (2 |^ 64) *
                        (2 |^ 64)) - 1)
                       div (dl + (2 |^ 64) * dh))
                      - (2 |^ 64)))))
proof
end;
::$P+
