:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/powm_Powm_win_sizeqtvc: the signed 32-bit
:: window-size threshold cascade returns a value from zero through ten and
:: returns a positive value for every positive input. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for eb,result being Integer,
      o1 being Element of BOOLEAN
  st
    -(2147483647)-1 <= eb & eb <= 2147483647 &
    -(2147483647)-1 <= result & result <= 2147483647 &
    (eb = 0 implies o1 = TRUE) &
    (o1 = TRUE implies eb = 0) &
    (o1 = TRUE implies result = 0) &
    (o1 <> TRUE & eb <= 7 implies result = 1) &
    (o1 <> TRUE & 7 < eb & eb <= 25 implies result = 2) &
    (o1 <> TRUE & 25 < eb & eb <= 81 implies result = 3) &
    (o1 <> TRUE & 81 < eb & eb <= 214 implies result = 4) &
    (o1 <> TRUE & 214 < eb & eb <= 673 implies result = 5) &
    (o1 <> TRUE & 673 < eb & eb <= 1793 implies result = 6) &
    (o1 <> TRUE & 1793 < eb & eb <= 4609 implies result = 7) &
    (o1 <> TRUE & 4609 < eb & eb <= 11521 implies result = 8) &
    (o1 <> TRUE & 11521 < eb & eb <= 28161 implies result = 9) &
    (o1 <> TRUE & 28161 < eb implies result = 10)
  holds
    0 <= result &
    result <= 10 &
    (0 < eb implies 0 < result)
proof
end;
::$P+
