:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/powm_Powm_binvert_limbqtvc: the verification
:: condition for Newton-doubling a table-seeded modular inverse of an odd
:: unsigned 64-bit limb. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Integer st
    0 <= n & n < (2 |^ 64) &
    n mod 2 = 1
  holds
    (for n1,inv being Integer, prec being Nat st
       0 <= n1 & 0 <= inv &
       (inv * n1) mod (2 |^ prec) = 1 &
       0 <= 2 * prec & 2 * prec <= 64
     holds
       (((2 * inv - inv * (inv * n1)) mod (2 |^ 64)) * n1)
         mod (2 |^ (2 * prec)) = 1) &
    2 <> 0 &
    0 <= n div 2 & n div 2 < (2 |^ 64) &
    (for o1 being Integer st
       0 <= o1 & o1 < (2 |^ 64) &
       o1 = n div 2
     holds
       128 <> 0 &
       0 <= o1 mod 128 & o1 mod 128 < (2 |^ 64) &
       (for h being Integer st
          0 <= h & h < (2 |^ 64) &
          h = o1 mod 128
        holds
          0 <= h & h < 128 &
          (for o2 being Integer st
             0 <= o2 & o2 < (2 |^ 64) &
             0 <= o2 & o2 < 256 &
             (o2 * (2 * h + 1)) mod (2 |^ 8) = 1
           holds
             for o3 being Integer st
               0 <= o3 & o3 < (2 |^ 64) &
               o3 = (o2 * n) mod (2 |^ 64)
             holds
               for o4 being Integer st
                 0 <= o4 & o4 < (2 |^ 64) &
                 o4 = (o2 * o3) mod (2 |^ 64)
               holds
                 for o5 being Integer st
                   0 <= o5 & o5 < (2 |^ 64) &
                   o5 = (2 * o2) mod (2 |^ 64)
                 holds
                   for o6 being Integer st
                     0 <= o6 & o6 < (2 |^ 64) &
                     o6 = (o5 - o4) mod (2 |^ 64)
                   holds
                     for o7 being Integer st
                       0 <= o7 & o7 < (2 |^ 64) &
                       o7 = (o6 * n) mod (2 |^ 64)
                     holds
                       for o8 being Integer st
                         0 <= o8 & o8 < (2 |^ 64) &
                         o8 = (o6 * o7) mod (2 |^ 64)
                       holds
                         for o9 being Integer st
                           0 <= o9 & o9 < (2 |^ 64) &
                           o9 = (2 * o6) mod (2 |^ 64)
                         holds
                           for o10 being Integer st
                             0 <= o10 & o10 < (2 |^ 64) &
                             o10 = (o9 - o8) mod (2 |^ 64)
                           holds
                             for o11 being Integer st
                               0 <= o11 & o11 < (2 |^ 64) &
                               o11 = (o10 * n) mod (2 |^ 64)
                             holds
                               for o12 being Integer st
                                 0 <= o12 & o12 < (2 |^ 64) &
                                 o12 = (o10 * o11) mod (2 |^ 64)
                               holds
                                 for o13 being Integer st
                                   0 <= o13 & o13 < (2 |^ 64) &
                                   o13 = (2 * o10) mod (2 |^ 64)
                                 holds
                                   for o14 being Integer st
                                     0 <= o14 &
                                     o14 < (2 |^ 64) &
                                     o14 =
                                       (o13 - o12) mod (2 |^ 64)
                                   holds
                                     (o14 * n) mod (2 |^ 64) = 1)))
proof
end;
::$P+
