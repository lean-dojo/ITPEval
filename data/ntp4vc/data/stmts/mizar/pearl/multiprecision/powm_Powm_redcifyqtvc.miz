:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/powm_Powm_redcifyqtvc: the verification condition
:: for zero-extending and copying a multiprecision integer before division
:: establishes its radix-2^64 Montgomery-reduction postcondition. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Value being Function of [:P,INT:],INT,
      PowRadix being Function of INT,INT,
      rp,up,mp being Element of P,
      n,un being Element of INT
  st
    (for p being Element of P, j being Element of INT holds
       for limb being Integer st limb = Pelt.[p,j] holds
         0 <= limb & limb < (2 |^ 64) &
         (j < 0 implies limb = Pelt.[p,0]) &
         (Len.p <= j implies limb = 0)) &
    (for e being Element of INT holds
       (e < 0 implies PowRadix.e = 1) &
       (0 <= e implies
          ex k being Nat st
            k = e & PowRadix.e = (2 |^ 64) |^ k)) &
    (for p being Element of P, a,b being Element of INT holds
       (a < b implies
          for v,limb,vnext being Integer st
            v = VSub.[p,[a,b]] &
            limb = Pelt.[p,a] &
            vnext = VSub.[p,[a+1,b]]
          holds
            v = limb + (2 |^ 64) * vnext) &
       (not a < b implies VSub.[p,[a,b]] = 0)) &
    (for p being Element of P, sz being Element of INT holds
       Value.[p,sz] = VSub.[p,[Offset.p,Offset.p+sz]]) &
    -(2 |^ 31) <= n & n <= 2147483647 &
    -(2 |^ 31) <= un & un <= 2147483647 &
    0 <= n &
    0 <= Minimum.rp &
    Minimum.rp <= Offset.rp &
    Offset.rp + n <= Maximum.rp &
    Maximum.rp <= Len.rp &
    0 <= un &
    0 <= Minimum.up &
    Minimum.up <= Offset.up &
    Offset.up + un <= Maximum.up &
    Maximum.up <= Len.up &
    0 <= Minimum.mp &
    Minimum.mp <= Offset.mp &
    Offset.mp + n <= Maximum.mp &
    Maximum.mp <= Len.mp &
    1 <= n &
    1 <= un &
    un + n < 2147483647 &
    (for top being Integer st
       top = Pelt.[mp,Offset.mp+n-1]
     holds
       0 < top) &
    Writable.rp = TRUE
  holds
    -(2 |^ 31) <= un + n &
    un + n <= 2147483647 &
    (for o1 being Element of INT st
       -(2 |^ 31) <= o1 &
       o1 <= 2147483647 &
       o1 = un + n
     holds
       0 <= o1 &
       (for o2 being Element of INT st
          0 <= o2 &
          o2 < (2 |^ 32) &
          o2 = o1
        holds
          0 <= o2 &
          (for tp being Element of P st
             Len.tp = o2 &
             Offset.tp = 0 &
             Minimum.tp = 0 &
             Maximum.tp = o2 &
             Writable.tp = TRUE
           holds
             -(2 |^ 31) <= un + 1 &
             un + 1 <= 2147483647 &
             (for o3 being Element of INT st
                -(2 |^ 31) <= o3 &
                o3 <= 2147483647 &
                o3 = un + 1
              holds
                0 <= o3 &
                (for o4 being Element of INT st
                   0 <= o4 &
                   o4 < (2 |^ 32) &
                   o4 = o3
                 holds
                   0 <= o4 &
                   (for qp being Element of P st
                      Len.qp = o4 &
                      Offset.qp = 0 &
                      Minimum.qp = 0 &
                      Maximum.qp = o4 &
                      Writable.qp = TRUE
                    holds
                      (-(2 |^ 31) <= n &
                       n <= 2147483647 &
                       0 <= n &
                       0 <= Minimum.tp &
                       Minimum.tp <= Offset.tp &
                       Offset.tp + n <= Maximum.tp &
                       Maximum.tp <= Len.tp &
                       Writable.tp = TRUE) &
                      (for tp1 being Element of P st
                         Len.tp1 = Len.tp &
                         Offset.tp1 = Offset.tp &
                         Minimum.tp1 = Minimum.tp &
                         Maximum.tp1 = Maximum.tp &
                         Writable.tp1 = Writable.tp &
                         Zone.tp1 = Zone.tp &
                         Value.[tp1,n] = 0 &
                         (for j being Element of INT st
                            j < Offset.tp1 or
                            Offset.tp1 + n <= j
                          holds
                            Pelt.[tp1,j] = Pelt.[tp,j])
                       holds
                         Minimum.tp1 <= Offset.tp1 + n &
                         Offset.tp1 + n <= Maximum.tp1 &
                         (for o5 being Element of P st
                            Offset.o5 = Offset.tp1 + n &
                            Len.o5 = Len.tp1 &
                            (for j being Element of INT holds
                               Pelt.[o5,j] = Pelt.[tp1,j]) &
                            Minimum.o5 = Minimum.tp1 &
                            Maximum.o5 = Maximum.tp1 &
                            Zone.o5 = Zone.tp1 &
                            Writable.o5 = Writable.tp1
                          holds
                            (-(2 |^ 31) <= un &
                             un <= 2147483647 &
                             0 <= un &
                             0 <= Minimum.up &
                             Minimum.up <= Offset.up &
                             Offset.up + un <= Maximum.up &
                             Maximum.up <= Len.up &
                             -(2 |^ 31) <= un &
                             un <= 2147483647 &
                             0 <= un &
                             0 <= Minimum.o5 &
                             Minimum.o5 <= Offset.o5 &
                             Offset.o5 + un <= Maximum.o5 &
                             Maximum.o5 <= Len.o5 &
                             Writable.o5 = TRUE) &
                            (for o6,tp2 being Element of P st
                               Len.o6 = Len.tp2 &
                               (for j being Element of INT holds
                                  Pelt.[o6,j] = Pelt.[tp2,j]) &
                               Len.tp2 = Len.o5 &
                               Offset.o6 = Offset.o5 &
                               Minimum.o6 = Minimum.o5 &
                               Maximum.o6 = Maximum.o5 &
                               Writable.o6 = Writable.o5 &
                               Zone.o6 = Zone.o5 &
                               Len.tp2 = Len.tp1 &
                               Offset.tp2 = Offset.tp1 &
                               Minimum.tp2 = Minimum.tp1 &
                               Maximum.tp2 = Maximum.tp1 &
                               Writable.tp2 = Writable.tp1 &
                               Zone.tp2 = Zone.tp1 &
                               (for i being Element of INT st
                                  0 <= i & i < un
                                holds
                                  Pelt.[o6,Offset.o6+i] =
                                    Pelt.[up,Offset.up+i]) &
                               (for j being Element of INT st
                                  j < Offset.o6 or
                                  Offset.o6 + un <= j
                                holds
                                  Pelt.[o6,j] = Pelt.[o5,j])
                             holds
                               -(2 |^ 31) <= un + n &
                               un + n <= 2147483647 &
                               (for o7 being Element of INT st
                                  -(2 |^ 31) <= o7 &
                                  o7 <= 2147483647 &
                                  o7 = un + n
                                holds
                                  (1 <= n &
                                   n <= o7 &
                                   o7 <= 2147483647 - 1) &
                                  (-(2 |^ 31) <= o7 &
                                   o7 <= 2147483647 &
                                   0 <= o7 &
                                   0 <= Minimum.tp2 &
                                   Minimum.tp2 <= Offset.tp2 &
                                   Offset.tp2 + o7 <= Maximum.tp2 &
                                   Maximum.tp2 <= Len.tp2) &
                                  (-(2 |^ 31) <= n &
                                   n <= 2147483647 &
                                   0 <= n &
                                   0 <= Minimum.mp &
                                   Minimum.mp <= Offset.mp &
                                   Offset.mp + n <= Maximum.mp &
                                   Maximum.mp <= Len.mp) &
                                  (-(2 |^ 31) <= o7 - n + 1 &
                                   o7 - n + 1 <= 2147483647 &
                                   0 <= o7 - n + 1 &
                                   0 <= Minimum.qp &
                                   Minimum.qp <= Offset.qp &
                                   Offset.qp + (o7 - n + 1) <= Maximum.qp &
                                   Maximum.qp <= Len.qp) &
                                  (-(2 |^ 31) <= n &
                                   n <= 2147483647 &
                                   0 <= n &
                                   0 <= Minimum.rp &
                                   Minimum.rp <= Offset.rp &
                                   Offset.rp + n <= Maximum.rp &
                                   Maximum.rp <= Len.rp) &
                                  Writable.qp = TRUE &
                                  Writable.rp = TRUE &
                                  (for top being Integer st
                                     top = Pelt.[mp,Offset.mp+n-1]
                                   holds
                                     0 < top) &
                                  (for qp1,rp1 being Element of P st
                                     Len.qp1 = Len.qp &
                                     Offset.qp1 = Offset.qp &
                                     Minimum.qp1 = Minimum.qp &
                                     Maximum.qp1 = Maximum.qp &
                                     Writable.qp1 = Writable.qp &
                                     Zone.qp1 = Zone.qp &
                                     Len.rp1 = Len.rp &
                                     Offset.rp1 = Offset.rp &
                                     Minimum.rp1 = Minimum.rp &
                                     Maximum.rp1 = Maximum.rp &
                                     Writable.rp1 = Writable.rp &
                                     Zone.rp1 = Zone.rp &
                                     (for vtp,vqp,vmp,vrp being Integer st
                                        vtp = Value.[tp2,o7] &
                                        vqp = Value.[qp1,o7-n+1] &
                                        vmp = Value.[mp,n] &
                                        vrp = Value.[rp1,n]
                                      holds
                                        vtp = vqp * vmp + vrp &
                                        vrp < vmp)
                                   holds
                                     for vrp,vup,vmp,power being Integer st
                                       vrp = Value.[rp1,n] &
                                       vup = Value.[up,un] &
                                       vmp = Value.[mp,n] &
                                       power = PowRadix.n
                                     holds
                                       vrp = (power * vup) mod vmp &
                                       vrp mod vmp =
                                         (power * vup) mod vmp)))))))))))
proof
end;
::$P+
