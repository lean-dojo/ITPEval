:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_Sub_wmpn_sub_nqtvc: the loop verification
:: condition for equal-length multiprecision subtraction with aliased pointer
:: snapshots, borrow arithmetic, single-limb updates, and memory framing.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],REAL,
      VSub being Function of [:P,[:INT,INT:]:],REAL,
      Pow being Function of INT,REAL,
      sz being Element of INT,
      r,x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, j being Element of INT holds
      Pelt.[p,j] in INT &
      (for pj being Integer st pj = Pelt.[p,j] holds
        0 <= pj & pj < (2 |^ 64) &
        ((j < 0 or Len.p <= j) implies pj = 0))) &
    Pow.0 = 1 &
    (for n being Element of INT holds
      Pow.n in INT &
      (n < 0 implies Pow.n = 1)) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      VSub.[p,[n,m]] in INT &
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    0 <= sz & sz < (2 |^ 32) &
    0 <= Signed32.sz &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.r &
     Minimum.r <= Offset.r &
     Offset.r + Signed32.sz <= Maximum.r &
     Maximum.r <= Len.r) &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sz <= Maximum.x &
     Maximum.x <= Len.x) &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sz <= Maximum.y &
     Maximum.y <= Len.y) &
    (Offset.r = Offset.x or
     Offset.r + Signed32.sz <= Offset.x or
     Offset.x + Signed32.sz <= Offset.r) &
    (Offset.r = Offset.y or
     Offset.r + Signed32.sz <= Offset.y or
     Offset.y + Signed32.sz <= Offset.r) &
    Len.r = Len.x &
    (for j being Element of INT holds Pelt.[r,j] = Pelt.[x,j]) &
    Len.x = Len.y &
    (for j being Element of INT holds Pelt.[x,j] = Pelt.[y,j]) &
    Writable.r = TRUE
  holds
    0 <= 0 &
    0 <= Signed32.sz &
    (for vr,vx,vy,power being Integer st
       vr = VSub.[r,[Offset.r,Offset.r]] &
       vx = VSub.[x,[Offset.x,Offset.x]] &
       vy = VSub.[y,[Offset.y,Offset.y]] &
       power = Pow.0
     holds vr - power * 0 = vx - vy) &
    (for j being Element of INT holds Pelt.[x,j] = Pelt.[r,j]) &
    (for j being Element of INT holds Pelt.[r,j] = Pelt.[y,j]) &
    (Offset.r = Offset.x or
      (for j being Element of INT st
         Offset.x <= j & j < Offset.x + Signed32.sz
       holds Pelt.[x,j] = Pelt.[x,j])) &
    (Offset.r = Offset.y or
      (for j being Element of INT st
         Offset.y <= j & j < Offset.y + Signed32.sz
       holds Pelt.[y,j] = Pelt.[y,j])) &
    0 <= 0 &
    0 <= 1 &
    (for i,b being Element of INT,
         y1,x1,r1 being Element of P
      st
        0 <= i & i < (2 |^ 32) &
        0 <= b & b < (2 |^ 64)
      holds
        (Len.y1 = Len.r1 &
         (for j being Element of INT holds
           Pelt.[y1,j] = Pelt.[r1,j]) &
         Len.r1 = Len.y &
         Offset.y1 = Offset.y &
         Minimum.y1 = Minimum.y &
         Maximum.y1 = Maximum.y &
         Writable.y1 = Writable.y &
         Zone.y1 = Zone.y
         implies
          (Len.x1 = Len.r1 &
           (for j being Element of INT holds
             Pelt.[x1,j] = Pelt.[r1,j]) &
           Len.r1 = Len.x &
           Offset.x1 = Offset.x &
           Minimum.x1 = Minimum.x &
           Maximum.x1 = Maximum.x &
           Writable.x1 = Writable.x &
           Zone.x1 = Zone.x
           implies
            (Len.r1 = Len.r &
             Offset.r1 = Offset.r &
             Minimum.r1 = Minimum.r &
             Maximum.r1 = Maximum.r &
             Writable.r1 = Writable.r &
             Zone.r1 = Zone.r
             implies
              (((0 <= Signed32.i &
                 Signed32.i <= Signed32.sz) &
                (for vr1,vx,vy,power being Integer st
                   vr1 = VSub.[r1,
                     [Offset.r1,Offset.r1+Signed32.i]] &
                   vx = VSub.[x,
                     [Offset.x,Offset.x+Signed32.i]] &
                   vy = VSub.[y,
                     [Offset.y,Offset.y+Signed32.i]] &
                   power = Pow.(Signed32.i)
                 holds vr1 - power * b = vx - vy) &
                (for j being Element of INT st
                   j < Offset.r1 or
                   Offset.r1 + Signed32.i <= j
                 holds Pelt.[r1,j] = Pelt.[r,j]) &
                (for j being Element of INT holds
                   Pelt.[x1,j] = Pelt.[r1,j]) &
                (for j being Element of INT holds
                   Pelt.[r1,j] = Pelt.[y1,j]) &
                (Offset.r1 = Offset.x1 or
                  (for j being Element of INT st
                     Offset.x1 <= j &
                     j < Offset.x1 + Signed32.sz
                   holds Pelt.[x1,j] = Pelt.[x,j])) &
                (Offset.r1 = Offset.y1 or
                  (for j being Element of INT st
                     Offset.y1 <= j &
                     j < Offset.y1 + Signed32.sz
                   holds Pelt.[y1,j] = Pelt.[y,j])) &
                0 <= b & b <= 1)
               implies
                ((Signed32.i < Signed32.sz implies
                   (Minimum.x1 <= Offset.x1 + Signed32.i &
                    Offset.x1 + Signed32.i < Maximum.x1) &
                   (Minimum.y1 <= Offset.y1 + Signed32.i &
                    Offset.y1 + Signed32.i < Maximum.y1) &
                   (Minimum.x <= Offset.x + Signed32.i &
                    Offset.x + Signed32.i < Maximum.x) &
                   (Minimum.y <= Offset.y + Signed32.i &
                    Offset.y + Signed32.i < Maximum.y) &
                   (0 <= b & b <= 1) &
                   (for res,borrow being Element of INT
                     st
                       0 <= res & res < (2 |^ 64) &
                       0 <= borrow & borrow < (2 |^ 64)
                     holds
                       ((for px1,py1 being Integer st
                           px1 = Pelt.[x1,
                             Offset.x1+Signed32.i] &
                           py1 = Pelt.[y1,
                             Offset.y1+Signed32.i]
                         holds
                           res - (2 |^ 64) * borrow =
                             px1 - py1 - b) &
                        0 <= borrow & borrow <= 1
                        implies
                          ((Minimum.r1 <=
                              Offset.r1 + Signed32.i &
                            Offset.r1 + Signed32.i < Maximum.r1) &
                           Writable.r1 = TRUE) &
                          (for y2,x2,r2 being Element of P
                            holds
                              (Len.y2 = Len.r2 &
                               (for j being Element of INT holds
                                 Pelt.[y2,j] = Pelt.[r2,j]) &
                               Len.r2 = Len.y1 &
                               Offset.y2 = Offset.y1 &
                               Minimum.y2 = Minimum.y1 &
                               Maximum.y2 = Maximum.y1 &
                               Writable.y2 = Writable.y1 &
                               Zone.y2 = Zone.y1
                               implies
                                (Len.x2 = Len.r2 &
                                 (for j being Element of INT holds
                                   Pelt.[x2,j] = Pelt.[r2,j]) &
                                 Len.r2 = Len.x1 &
                                 Offset.x2 = Offset.x1 &
                                 Minimum.x2 = Minimum.x1 &
                                 Maximum.x2 = Maximum.x1 &
                                 Writable.x2 = Writable.x1 &
                                 Zone.x2 = Zone.x1
                                 implies
                                  (Len.r2 = Len.r1 &
                                   Offset.r2 = Offset.r1 &
                                   Minimum.r2 = Minimum.r1 &
                                   Maximum.r2 = Maximum.r1 &
                                   Writable.r2 = Writable.r1 &
                                   Zone.r2 = Zone.r1
                                   implies
                                    ((for j being Element of INT
                                      holds
                                        (j =
                                           Offset.r2 + Signed32.i
                                         implies Pelt.[r2,j] = res) &
                                        (j <>
                                           Offset.r2 + Signed32.i
                                         implies
                                           Pelt.[r2,j] =
                                             Pelt.[r1,j])) &
                                     Pelt.[r2,
                                       Offset.r2+Signed32.i] = res
                                     implies
                                      -(2 |^ 31) <=
                                        Signed32.i + 1 &
                                      Signed32.i + 1 <=
                                        2147483647 &
                                      (for o1 being Element of INT
                                        st
                                          0 <= o1 &
                                          o1 < (2 |^ 32)
                                        holds
                                          (Signed32.o1 =
                                             Signed32.i + 1
                                           implies
                                            (0 <= Signed32.sz -
                                                Signed32.i &
                                             Signed32.sz -
                                                Signed32.o1 <
                                               Signed32.sz -
                                                Signed32.i) &
                                            (0 <= Signed32.o1 &
                                             Signed32.o1 <=
                                               Signed32.sz) &
                                            (for vr2,vx,vy,power
                                               being Integer st
                                               vr2 = VSub.[r2,
                                                 [Offset.r2,
                                                  Offset.r2+
                                                   Signed32.o1]] &
                                               vx = VSub.[x,
                                                 [Offset.x,
                                                  Offset.x+
                                                   Signed32.o1]] &
                                               vy = VSub.[y,
                                                 [Offset.y,
                                                  Offset.y+
                                                   Signed32.o1]] &
                                               power =
                                                 Pow.(Signed32.o1)
                                             holds
                                               vr2 - power * borrow =
                                                 vx - vy) &
                                            (for j being
                                               Element of INT st
                                               j < Offset.r2 or
                                               Offset.r2 +
                                                 Signed32.o1 <= j
                                             holds
                                               Pelt.[r2,j] =
                                                 Pelt.[r,j]) &
                                            (for j being
                                               Element of INT holds
                                               Pelt.[x2,j] =
                                                 Pelt.[r2,j]) &
                                            (for j being
                                               Element of INT holds
                                               Pelt.[r2,j] =
                                                 Pelt.[y2,j]) &
                                            (Offset.r2 = Offset.x2 or
                                             (for j being
                                                Element of INT st
                                                Offset.x2 <= j &
                                                j <
                                                  Offset.x2 +
                                                    Signed32.sz
                                              holds
                                                Pelt.[x2,j] =
                                                  Pelt.[x,j])) &
                                            (Offset.r2 = Offset.y2 or
                                             (for j being
                                                Element of INT st
                                                Offset.y2 <= j &
                                                j <
                                                  Offset.y2 +
                                                    Signed32.sz
                                              holds
                                                Pelt.[y2,j] =
                                                  Pelt.[y,j])) &
                                            0 <= borrow &
                                            borrow <= 1))))))))) &
                 (not Signed32.i < Signed32.sz implies
                   (for vr1,vx,vy,power being Integer st
                      vr1 = VSub.[r1,
                        [Offset.r1,Offset.r1+Signed32.sz]] &
                      vx = VSub.[x,
                        [Offset.x,Offset.x+Signed32.sz]] &
                      vy = VSub.[y,
                        [Offset.y,Offset.y+Signed32.sz]] &
                      power = Pow.(Signed32.sz)
                    holds vr1 - power * b = vx - vy) &
                   (0 <= b & b <= 1) &
                   (for j being Element of INT st
                      j < Offset.r1 or
                      Offset.r1 + Signed32.sz <= j
                    holds Pelt.[r1,j] = Pelt.[r,j]) &
                   (Offset.r1 = Offset.x1 or
                    (for j being Element of INT st
                       Offset.x1 <= j &
                       j < Offset.x1 + Signed32.sz
                     holds Pelt.[x1,j] = Pelt.[x,j])) &
                   (Offset.r1 = Offset.y1 or
                    (for j being Element of INT st
                       Offset.y1 <= j &
                       j < Offset.y1 + Signed32.sz
                     holds Pelt.[y1,j] = Pelt.[y,j]))))))))))
proof
end;
::$P+
