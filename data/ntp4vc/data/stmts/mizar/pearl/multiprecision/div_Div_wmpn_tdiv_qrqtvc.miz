:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/div_Div_wmpn_tdiv_qrqtvc: the allocation and call
:: verification condition for multiprecision quotient-and-remainder division,
:: including temporary-pointer validity, frame conditions, and the resulting
:: quotient-remainder value relation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Data being Function of P,INT*,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      NullZone being Element of Z,
      NotNull being Subset of P,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      sy,sx,qxn being Element of INT,
      x,y,q,r being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, k being Nat st k in dom (Data.p)
     holds
       ex d being Integer st
         d = (Data.p).k & 0 <= d & d < (2 |^ 64)) &
    (for p being Element of P, j being Element of INT holds
      (len (Data.p) = 0 implies Pelt/.[p,j] = 0) &
      (j < 0 & 0 < len (Data.p) implies
        Pelt/.[p,j] = (Data.p).1) &
      (0 <= j & j < len (Data.p) implies
        Pelt/.[p,j] = (Data.p).(j+1)) &
      (len (Data.p) <= j implies Pelt/.[p,j] = 0)) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        VSub/.[p,[n,m]] =
          Pelt/.[p,n] + (2 |^ 64) * VSub/.[p,[n+1,m]]) &
      (not n < m implies VSub/.[p,[n,m]] = 0)) &
    0 <= sy & sy < (2 |^ 32) &
    0 <= sx & sx < (2 |^ 32) &
    0 <= qxn & qxn < (2 |^ 32) &
    1 <= Signed32.sy &
    Signed32.sy <= Signed32.sx &
    Signed32.sx <= 2147483647 - 1 &
    (-(2 |^ 31) <= Signed32.sx &
      Signed32.sx <= (2 |^ 31) - 1 &
      0 <= Signed32.sx &
      0 <= Minimum.x &
      Minimum.x <= Offset.x &
      Offset.x + Signed32.sx <= Maximum.x &
      Maximum.x <= len (Data.x)) &
    (-(2 |^ 31) <= Signed32.sy &
      Signed32.sy <= (2 |^ 31) - 1 &
      0 <= Signed32.sy &
      0 <= Minimum.y &
      Minimum.y <= Offset.y &
      Offset.y + Signed32.sy <= Maximum.y &
      Maximum.y <= len (Data.y)) &
    (-(2 |^ 31) <= Signed32.sx-Signed32.sy+1 &
      Signed32.sx-Signed32.sy+1 <= (2 |^ 31) - 1 &
      0 <= Signed32.sx-Signed32.sy+1 &
      0 <= Minimum.q &
      Minimum.q <= Offset.q &
      Offset.q + (Signed32.sx-Signed32.sy+1) <= Maximum.q &
      Maximum.q <= len (Data.q)) &
    (-(2 |^ 31) <= Signed32.sy &
      Signed32.sy <= (2 |^ 31) - 1 &
      0 <= Signed32.sy &
      0 <= Minimum.r &
      Minimum.r <= Offset.r &
      Offset.r + Signed32.sy <= Maximum.r &
      Maximum.r <= len (Data.r)) &
    Writable.q = TRUE &
    Writable.r = TRUE &
    Signed32.qxn = 0 &
    0 < Pelt/.[y,Offset.y+Signed32.sy-1]
  holds
    0 <= Signed32.sx &
    (for o1 being Element of INT st
       0 <= o1 & o1 < (2 |^ 32) &
       o1 = Signed32.sx
     holds
       0 <= o1+1 & o1+1 <= (2 |^ 32)-1 &
       (for o2 being Element of INT st
          0 <= o2 & o2 < (2 |^ 32) &
          o2 = o1+1
        holds
          0 <= o2 &
          (for nx being Element of P st
             (Zone.nx <> NullZone implies
                len (Data.nx) = o2) &
             Offset.nx = 0 &
             Minimum.nx = 0 &
             Maximum.nx = len (Data.nx) &
             Writable.nx = TRUE
           holds
             ((nx in NotNull iff Zone.nx <> NullZone) implies
               (nx in NotNull implies
                 0 <= Signed32.sy &
                 (for o3 being Element of INT st
                    0 <= o3 & o3 < (2 |^ 32) &
                    o3 = Signed32.sy
                  holds
                    0 <= o3 &
                    (for ny being Element of P st
                       (Zone.ny <> NullZone implies
                          len (Data.ny) = o3) &
                       Offset.ny = 0 &
                       Minimum.ny = 0 &
                       Maximum.ny = len (Data.ny) &
                       Writable.ny = TRUE
                     holds
                       ((ny in NotNull iff Zone.ny <> NullZone) implies
                         (ny in NotNull implies
                           (((1 <= Signed32.sy &
                              Signed32.sy <= Signed32.sx &
                              Signed32.sx <= 2147483647 - 1) &
                             (-(2 |^ 31) <= Signed32.sx &
                              Signed32.sx <= (2 |^ 31) - 1 &
                              0 <= Signed32.sx &
                              0 <= Minimum.x &
                              Minimum.x <= Offset.x &
                              Offset.x + Signed32.sx <= Maximum.x &
                              Maximum.x <= len (Data.x)) &
                             (-(2 |^ 31) <= Signed32.sy &
                              Signed32.sy <= (2 |^ 31) - 1 &
                              0 <= Signed32.sy &
                              0 <= Minimum.y &
                              Minimum.y <= Offset.y &
                              Offset.y + Signed32.sy <= Maximum.y &
                              Maximum.y <= len (Data.y)) &
                             (-(2 |^ 31) <=
                                Signed32.sx-Signed32.sy+1 &
                              Signed32.sx-Signed32.sy+1 <=
                                (2 |^ 31) - 1 &
                              0 <= Signed32.sx-Signed32.sy+1 &
                              0 <= Minimum.q &
                              Minimum.q <= Offset.q &
                              Offset.q +
                                (Signed32.sx-Signed32.sy+1) <=
                                Maximum.q &
                              Maximum.q <= len (Data.q)) &
                             (-(2 |^ 31) <= Signed32.sy &
                              Signed32.sy <= (2 |^ 31) - 1 &
                              0 <= Signed32.sy &
                              0 <= Minimum.r &
                              Minimum.r <= Offset.r &
                              Offset.r + Signed32.sy <= Maximum.r &
                              Maximum.r <= len (Data.r)) &
                             (-(2 |^ 31) <= Signed32.sx+1 &
                              Signed32.sx+1 <= (2 |^ 31) - 1 &
                              0 <= Signed32.sx+1 &
                              0 <= Minimum.nx &
                              Minimum.nx <= Offset.nx &
                              Offset.nx + (Signed32.sx+1) <=
                                Maximum.nx &
                              Maximum.nx <= len (Data.nx)) &
                             (-(2 |^ 31) <= Signed32.sy &
                              Signed32.sy <= (2 |^ 31) - 1 &
                              0 <= Signed32.sy &
                              0 <= Minimum.ny &
                              Minimum.ny <= Offset.ny &
                              Offset.ny + Signed32.sy <= Maximum.ny &
                              Maximum.ny <= len (Data.ny)) &
                             (Writable.nx = TRUE &
                              Writable.ny = TRUE) &
                             0 <
                               Pelt/.[y,
                                 Offset.y+Signed32.sy-1] &
                             Writable.q = TRUE &
                             Writable.r = TRUE) &
                            (for ny1,nx1,r1,q1 being Element of P
                             holds
                               (len (Data.ny1) = len (Data.ny) &
                                Offset.ny1 = Offset.ny &
                                Minimum.ny1 = Minimum.ny &
                                Maximum.ny1 = Maximum.ny &
                                Writable.ny1 = Writable.ny &
                                Zone.ny1 = Zone.ny)
                               implies
                               ((len (Data.nx1) = len (Data.nx) &
                                 Offset.nx1 = Offset.nx &
                                 Minimum.nx1 = Minimum.nx &
                                 Maximum.nx1 = Maximum.nx &
                                 Writable.nx1 = Writable.nx &
                                 Zone.nx1 = Zone.nx)
                                implies
                                ((len (Data.r1) = len (Data.r) &
                                  Offset.r1 = Offset.r &
                                  Minimum.r1 = Minimum.r &
                                  Maximum.r1 = Maximum.r &
                                  Writable.r1 = Writable.r &
                                  Zone.r1 = Zone.r)
                                 implies
                                 ((len (Data.q1) = len (Data.q) &
                                   Offset.q1 = Offset.q &
                                   Minimum.q1 = Minimum.q &
                                   Maximum.q1 = Maximum.q &
                                   Writable.q1 = Writable.q &
                                   Zone.q1 = Zone.q)
                                  implies
                                  ((VSub/.[x,
                                      [Offset.x,
                                       Offset.x+Signed32.sx]] =
                                    VSub/.[q1,
                                      [Offset.q1,
                                       Offset.q1+
                                       (Signed32.sx-
                                        Signed32.sy+1)]] *
                                    VSub/.[y,
                                      [Offset.y,
                                       Offset.y+Signed32.sy]] +
                                    VSub/.[r1,
                                      [Offset.r1,
                                       Offset.r1+Signed32.sy]] &
                                    VSub/.[r1,
                                      [Offset.r1,
                                       Offset.r1+Signed32.sy]] <
                                    VSub/.[y,
                                      [Offset.y,
                                       Offset.y+Signed32.sy]])
                                   implies
                                   ((Offset.nx1 = 0 &
                                     Minimum.nx1 = 0 &
                                     Maximum.nx1 =
                                       len (Data.nx1) &
                                     Writable.nx1 = TRUE) &
                                    (Offset.ny1 = 0 &
                                     Minimum.ny1 = 0 &
                                     Maximum.ny1 =
                                       len (Data.ny1) &
                                     Writable.ny1 = TRUE) &
                                    VSub/.[x,
                                      [Offset.x,
                                       Offset.x+Signed32.sx]] =
                                      VSub/.[q1,
                                        [Offset.q1,
                                         Offset.q1+
                                         (Signed32.sx-
                                          Signed32.sy+1)]] *
                                      VSub/.[y,
                                        [Offset.y,
                                         Offset.y+Signed32.sy]] +
                                      VSub/.[r1,
                                        [Offset.r1,
                                         Offset.r1+Signed32.sy]] &
                                    VSub/.[r1,
                                      [Offset.r1,
                                       Offset.r1+Signed32.sy]] <
                                      VSub/.[y,
                                        [Offset.y,
                                         Offset.y+Signed32.sy]]))))))))))))))))
proof
end;
::$P+
