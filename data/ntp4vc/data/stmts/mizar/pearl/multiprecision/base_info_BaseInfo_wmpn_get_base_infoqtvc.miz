:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/base_info_BaseInfo_wmpn_get_base_infoqtvc:
:: the multiprecision base-information verification condition preserves the
:: power and exponent loop invariants and constructs a valid maximal
:: 64-bit base power for each base from 2 through 256.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, MCART_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    NAT_D, NEWTON, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for BaseInfo being non empty set,
      base,exponent,bigbase being Function of BaseInfo,NAT,
      b1 being Nat st
    (for self being Element of BaseInfo holds
      2 <= base.self &
      base.self <= 256 &
      bigbase.self < (2 |^ 64) &
      (2 |^ 64) <= bigbase.self * base.self &
      7 <= exponent.self &
      exponent.self <= 63 &
      bigbase.self = base.self |^ exponent.self) &
    (for a,c being Element of BaseInfo st
      base.a = base.c &
      exponent.a = exponent.c &
      bigbase.a = bigbase.c
     holds a = c) &
    b1 < (2 |^ 64) &
    2 <= b1 &
    b1 <= 256
  holds
    b1 <> 0 &
    0 <= (((2 |^ 64) - 1) div b1) &
    (((2 |^ 64) - 1) div b1) < (2 |^ 64) &
    (for m being Nat st
      m < (2 |^ 64) &
      m = (((2 |^ 64) - 1) div b1)
     holds
      b1 |^ 1 = b1 &
      1 <= 1 &
      1 <= 64 &
      (for exp1,p being Nat st
        exp1 < (2 |^ 32) &
        p < (2 |^ 64) &
        b1 |^ exp1 = p &
        1 <= exp1 &
        exp1 <= 64
       holds
        (p <= m implies
          0 <= p * b1 &
          p * b1 < (2 |^ 64) &
          (for o1 being Nat st
            o1 < (2 |^ 64) &
            o1 = p * b1
           holds
            0 <= exp1 + 1 &
            exp1 + 1 < (2 |^ 32) &
            (for o2 being Nat st
              o2 < (2 |^ 32) &
              o2 = exp1 + 1
             holds
              0 <= m - p &
              m - o1 < m - p &
              b1 |^ o2 = o1 &
              1 <= o2 &
              o2 <= 64))) &
        (not p <= m implies
          (2 <= b1 &
           b1 <= 256) &
          (p < (2 |^ 64) &
           (2 |^ 64) <= p * b1) &
          (7 <= exp1 &
           exp1 <= 63) &
          p = b1 |^ exp1 &
          (for result being Element of BaseInfo st
            base.result = b1 &
            exponent.result = exp1 &
            bigbase.result = p
           holds
            base.result = b1))))
proof
end;
::$P+
