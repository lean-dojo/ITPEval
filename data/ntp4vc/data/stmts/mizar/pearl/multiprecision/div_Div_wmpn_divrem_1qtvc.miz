:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/div_Div_wmpn_divrem_1qtvc: the verification
:: condition for one-limb multiprecision division, including divisor
:: normalization, reciprocal division, quotient-array updates, loop
:: invariants, and the final quotient-remainder relation. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1, MARGREL1, XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS,
    CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, NEWTON, MARGREL1,
    XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Pelt being Function of P,Funcs(INT,INT),
      VSub being Function of
        [:Funcs(INT,INT),[:INT,INT:]:],INT,
      Pow2 being Function of INT,INT,
      x,q being Element of P,
      sz,y being Integer st
    (for p being Element of P, j being Element of INT holds
       (for limb being Integer st limb = (Pelt.p).j
        holds 0 <= limb & limb < (2 |^ 64))) &
    (for pv being Integer st pv = Pow2.0 holds pv = 1) &
    (for n being Element of INT st n < 0 holds
       for pv being Integer st pv = Pow2.n holds pv = 1) &
    (for n being Element of INT st 0 <= n holds
       for pv1,pv2 being Integer st
         pv1 = Pow2.(n+1) & pv2 = Pow2.n
       holds pv1 = 2 * pv2) &
    (for f being Element of Funcs(INT,INT),
         n,m being Element of INT holds
       (n < m implies
         for v0,v1,v2 being Integer st
           v0 = VSub.[f,[n,m]] & v1 = f.n &
           v2 = VSub.[f,[n+1,m]]
         holds v0 = v1 + (2 |^ 64) * v2) &
       (not n < m implies
         for v0 being Integer st v0 = VSub.[f,[n,m]]
         holds v0 = 0)) &
    -(2 |^ 31) <= sz & sz <= (2 |^ 31) - 1 &
    0 <= y & y < (2 |^ 64) &
    (-(2 |^ 31) <= sz & sz <= (2 |^ 31) - 1 &
      0 <= sz & 0 <= Minimum.x & Minimum.x <= Offset.x &
      Offset.x + sz <= Maximum.x & Maximum.x <= Len.x) &
    (-(2 |^ 31) <= sz & sz <= (2 |^ 31) - 1 &
      0 <= sz & 0 <= Minimum.q & Minimum.q <= Offset.q &
      Offset.q + sz <= Maximum.q & Maximum.q <= Len.q) &
    Writable.q = TRUE &
    0 < sz &
    0 < y
  holds
    -(2 |^ 31) <= sz - 1 & sz - 1 <= (2 |^ 31) - 1 &
    (for msb being Integer st
       -(2 |^ 31) <= msb & msb <= (2 |^ 31) - 1 &
       msb = sz - 1
     holds
       0 < y &
       (for clz being Integer st
          -(2 |^ 31) <= clz & clz <= (2 |^ 31) - 1 &
          (for pc being Integer st pc = Pow2.clz
           holds pc * y <= (2 |^ 64) - 1 &
             (2 |^ 64) - 1 < 2 * pc * y) &
          0 <= clz & clz < 64
        holds
          (0 < clz implies
            for mult being Integer st mult = Pow2.clz holds
              0 <= clz &
              (for o1 being Integer st
                 0 <= o1 & o1 < (2 |^ 64) & o1 = clz
               holds
                 (0 <= o1 & o1 < 64 &
                   (for po1 being Integer st po1 = Pow2.o1
                    holds po1 * y <= (2 |^ 64) - 1)) &
                 (for ry being Integer st
                    0 <= ry & ry < (2 |^ 64) &
                    (for po1 being Integer st po1 = Pow2.o1
                     holds ry = po1 * y)
                  holds
                    ((2 |^ 64) div 2) <= ry &
                    (for v being Integer st
                       0 <= v & v < (2 |^ 64) &
                       v = ((((2 |^ 64) * (2 |^ 64)) - 1) div ry)
                         - (2 |^ 64)
                     holds
                       ((-1 <= msb & msb <= msb) &
                        0 < ry &
                        (for vx,vq being Integer st
                           vx = VSub.[Pelt.x,
                             [Offset.x+msb+1,Offset.x+sz]] &
                           vq = VSub.[Pelt.q,
                             [Offset.q+msb+1,Offset.q+sz]]
                         holds mult * vx = vq * ry + 0) &
                        0 <= (2 |^ 64) - mult &
                        0 mod mult = 0) &
                       (for r,i being Integer,
                            q1 being Element of P st
                          0 <= r & r < (2 |^ 64) &
                          -(2 |^ 31) <= i &
                          i <= (2 |^ 31) - 1 &
                          Len.q1 = Len.q &
                          Offset.q1 = Offset.q &
                          Minimum.q1 = Minimum.q &
                          Maximum.q1 = Maximum.q &
                          Writable.q1 = Writable.q &
                          Zone.q1 = Zone.q &
                          -1 <= i & i <= msb &
                          r < ry &
                          (for vx,vq being Integer st
                             vx = VSub.[Pelt.x,
                               [Offset.x+i+1,Offset.x+sz]] &
                             vq = VSub.[Pelt.q1,
                               [Offset.q1+i+1,Offset.q1+sz]]
                           holds mult * vx = vq * ry + r) &
                          r <= (2 |^ 64) - mult &
                          r mod mult = 0
                        holds
                          (0 <= i implies
                            Minimum.x <= Offset.x+i &
                            Offset.x+i < Maximum.x &
                            0 <= clz &
                            (for o2 being Integer st
                               0 <= o2 & o2 < (2 |^ 64) &
                               o2 = clz
                             holds
                               0 < o2 & o2 < 64 &
                               (for l,h being Integer st
                                  0 <= l & l < (2 |^ 64) &
                                  0 <= h & h < (2 |^ 64) &
                                  (for po2 being Integer st
                                     po2 = Pow2.o2
                                   holds
                                     (for limb being Integer st
                                        limb = (Pelt.x).(Offset.x+i)
                                      holds
                                        l + (2 |^ 64) * h =
                                          po2 * limb) &
                                     l mod po2 = 0 &
                                     l <= (2 |^ 64) - po2 &
                                     h < po2)
                                holds
                                  0 <= r+h &
                                  r+h <= (2 |^ 64) - 1 &
                                  (for o3 being Integer st
                                     0 <= o3 & o3 < (2 |^ 64) &
                                     o3 = r+h
                                   holds
                                     (((2 |^ 64) div 2) <= ry &
                                      o3 < ry &
                                      v =
                                        ((((2 |^ 64) * (2 |^ 64)) - 1)
                                          div ry) - (2 |^ 64)) &
                                      (for qu,rem being Integer st
                                         0 <= qu &
                                         qu < (2 |^ 64) &
                                         0 <= rem &
                                         rem < (2 |^ 64) &
                                         qu * ry + rem =
                                           l + (2 |^ 64) * o3 &
                                         0 <= rem & rem < ry
                                       holds
                                         mult <> 0 &
                                         Offset.q1+i+1 <=
                                           Offset.q1+sz &
                                         (Offset.q1+i <
                                            Offset.q1+i+1 or
                                          Offset.q1+sz <=
                                            Offset.q1+i) &
                                         (VSub.[Pelt.q1,
                                            [Offset.q1+i+1,
                                             Offset.q1+sz]] =
                                          VSub.[(Pelt.q1)+*
                                            (Offset.q1+i,qu),
                                            [Offset.q1+i+1,
                                             Offset.q1+sz]]
                                          implies
                                            Minimum.q1 <= Offset.q1+i &
                                            Offset.q1+i < Maximum.q1 &
                                            Writable.q1 = TRUE &
                                            (for q2 being Element of P st
                                               Len.q2 = Len.q1 &
                                               Offset.q2 = Offset.q1 &
                                               Minimum.q2 = Minimum.q1 &
                                               Maximum.q2 = Maximum.q1 &
                                               Writable.q2 = Writable.q1 &
                                               Zone.q2 = Zone.q1 &
                                               Pelt.q2 =
                                                 (Pelt.q1)+*
                                                   (Offset.q2+i,qu) &
                                               (Pelt.q2).(Offset.q2+i) = qu
                                             holds
                                               -(2 |^ 31) <= i-1 &
                                               i-1 <= (2 |^ 31) - 1 &
                                               (for o8 being Integer st
                                                  -(2 |^ 31) <= o8 &
                                                  o8 <= (2 |^ 31) - 1 &
                                                  o8 = i-1
                                                holds
                                                  o8 < i &
                                                  -1 <= o8 &
                                                  o8 <= msb &
                                                  rem < ry &
                                                  (for vx,vq being Integer
                                                     st
                                                    vx = VSub.[Pelt.x,
                                                      [Offset.x+o8+1,
                                                       Offset.x+sz]] &
                                                    vq = VSub.[Pelt.q2,
                                                      [Offset.q2+o8+1,
                                                       Offset.q2+sz]]
                                                   holds
                                                     mult * vx =
                                                       vq * ry + rem) &
                                                  rem <=
                                                    (2 |^ 64) - mult &
                                                  rem mod mult = 0)))))))) &
                          (not 0 <= i implies
                            0 <= clz &
                            (for o2 being Integer st
                               0 <= o2 & o2 < (2 |^ 64) &
                               o2 = clz
                             holds
                               0 <= o2 & o2 < 64 &
                               (for po2 being Integer st po2 = Pow2.o2
                                holds r mod po2 = 0) &
                               (for res being Integer st
                                  0 <= res & res < (2 |^ 64) &
                                  (for po2 being Integer st po2 = Pow2.o2
                                   holds r = po2 * res)
                                holds
                                  0 <= clz &
                                  (for o3 being Integer st
                                     0 <= o3 & o3 < (2 |^ 64) &
                                     o3 = clz
                                   holds
                                     0 <= o3 & o3 < 64 &
                                     (for po3 being Integer st
                                        po3 = Pow2.o3
                                      holds r mod po3 = 0) &
                                     (for result being Integer st
                                        0 <= result &
                                        result < (2 |^ 64) &
                                        (for po3 being Integer st
                                           po3 = Pow2.o3
                                         holds r = po3 * result)
                                      holds
                                        (for vx,vq being Integer st
                                           vx = VSub.[Pelt.x,
                                             [Offset.x,Offset.x+sz]] &
                                           vq = VSub.[Pelt.q1,
                                             [Offset.q1,Offset.q1+sz]]
                                         holds vx = vq * y + result) &
                                        result < y)))))))))) &
          (not 0 < clz implies
            ((2 |^ 64) div 2) <= y &
            (for v being Integer st
               0 <= v & v < (2 |^ 64) &
               v = ((((2 |^ 64) * (2 |^ 64)) - 1) div y)
                 - (2 |^ 64)
             holds
               ((-1 <= msb & msb <= msb) &
                0 < y &
                (for vx,vq being Integer st
                   vx = VSub.[Pelt.x,
                     [Offset.x+msb+1,Offset.x+sz]] &
                   vq = VSub.[Pelt.q,
                     [Offset.q+msb+1,Offset.q+sz]]
                 holds vx = vq * y + 0)) &
               (for r,i being Integer,
                    q1 being Element of P st
                  0 <= r & r < (2 |^ 64) &
                  -(2 |^ 31) <= i & i <= (2 |^ 31) - 1 &
                  Len.q1 = Len.q &
                  Offset.q1 = Offset.q &
                  Minimum.q1 = Minimum.q &
                  Maximum.q1 = Maximum.q &
                  Writable.q1 = Writable.q &
                  Zone.q1 = Zone.q &
                  -1 <= i & i <= msb &
                  r < y &
                  (for vx,vq being Integer st
                     vx = VSub.[Pelt.x,
                       [Offset.x+i+1,Offset.x+sz]] &
                     vq = VSub.[Pelt.q1,
                       [Offset.q1+i+1,Offset.q1+sz]]
                   holds vx = vq * y + r)
                holds
                  (0 <= i implies
                    Minimum.x <= Offset.x+i &
                    Offset.x+i < Maximum.x &
                    (((2 |^ 64) div 2) <= y &
                     r < y &
                     v = ((((2 |^ 64) * (2 |^ 64)) - 1) div y)
                       - (2 |^ 64)) &
                     (for qu,rem being Integer st
                        0 <= qu & qu < (2 |^ 64) &
                        0 <= rem & rem < (2 |^ 64) &
                        (for limb being Integer st
                           limb = (Pelt.x).(Offset.x+i)
                         holds
                           qu * y + rem =
                             limb + (2 |^ 64) * r) &
                        0 <= rem & rem < y
                      holds
                        Offset.q1+i+1 <= Offset.q1+sz &
                        (Offset.q1+i < Offset.q1+i+1 or
                         Offset.q1+sz <= Offset.q1+i) &
                        (VSub.[Pelt.q1,
                           [Offset.q1+i+1,Offset.q1+sz]] =
                         VSub.[(Pelt.q1)+*(Offset.q1+i,qu),
                           [Offset.q1+i+1,Offset.q1+sz]]
                         implies
                           Minimum.q1 <= Offset.q1+i &
                           Offset.q1+i < Maximum.q1 &
                           Writable.q1 = TRUE &
                           (for q2 being Element of P st
                              Len.q2 = Len.q1 &
                              Offset.q2 = Offset.q1 &
                              Minimum.q2 = Minimum.q1 &
                              Maximum.q2 = Maximum.q1 &
                              Writable.q2 = Writable.q1 &
                              Zone.q2 = Zone.q1 &
                              Pelt.q2 =
                                (Pelt.q1)+*(Offset.q2+i,qu) &
                              (Pelt.q2).(Offset.q2+i) = qu
                            holds
                              -(2 |^ 31) <= i-1 &
                              i-1 <= (2 |^ 31) - 1 &
                              (for o5 being Integer st
                                 -(2 |^ 31) <= o5 &
                                 o5 <= (2 |^ 31) - 1 &
                                 o5 = i-1
                               holds
                                 o5 < i &
                                 -1 <= o5 & o5 <= msb &
                                 rem < y &
                                 (for vx,vq being Integer st
                                    vx = VSub.[Pelt.x,
                                      [Offset.x+o5+1,
                                       Offset.x+sz]] &
                                    vq = VSub.[Pelt.q2,
                                      [Offset.q2+o5+1,
                                       Offset.q2+sz]]
                                  holds vx = vq * y + rem)))))) &
                  (not 0 <= i implies
                    (for vx,vq being Integer st
                       vx = VSub.[Pelt.x,
                         [Offset.x,Offset.x+sz]] &
                       vq = VSub.[Pelt.q1,
                         [Offset.q1,Offset.q1+sz]]
                     holds vx = vq * y + r) &
                    r < y))))))
proof
end;
::$P+
