:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_SubOld_wmpn_sub_n_in_placeqtvc: the loop
:: verification condition for equal-length in-place multiprecision
:: subtraction, including borrow arithmetic, one-limb updates, pointer
:: validity, loop invariants, and memory framing. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      sz being Element of INT,
      x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, j being Element of INT holds
      for pj being Integer st pj = Pelt.[p,j] holds
        0 <= pj & pj < (2 |^ 64)) &
    Pow.0 = 1 &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    0 <= sz & sz < (2 |^ 32) &
    0 <= Signed32.sz &
    -(2 |^ 31) <= Signed32.sz &
    Signed32.sz <= 2147483647 &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + Signed32.sz <= Maximum.x &
    Maximum.x <= Len.x &
    -(2 |^ 31) <= Signed32.sz &
    Signed32.sz <= 2147483647 &
    0 <= Signed32.sz &
    0 <= Minimum.y &
    Minimum.y <= Offset.y &
    Offset.y + Signed32.sz <= Maximum.y &
    Maximum.y <= Len.y &
    Writable.x = TRUE
  holds
    0 <= 0 &
    0 <= Signed32.sz &
    (for vx0,vy0,power0 being Integer st
       vx0 = VSub.[x,[Offset.x,Offset.x+0]] &
       vy0 = VSub.[y,[Offset.y,Offset.y+0]] &
       power0 = Pow.0
     holds vx0 - power0 * 0 = vx0 - vy0) &
    0 <= 0 &
    0 <= 1 &
    (for i,b being Element of INT,
         x1 being Element of P st
       0 <= i & i < (2 |^ 32) &
       0 <= b & b < (2 |^ 64) &
       Len.x1 = Len.x &
       Offset.x1 = Offset.x &
       Minimum.x1 = Minimum.x &
       Maximum.x1 = Maximum.x &
       Writable.x1 = Writable.x &
       Zone.x1 = Zone.x
     holds
       ((0 <= Signed32.i &
         Signed32.i <= Signed32.sz) &
        (for vx1,vx,vy,power being Integer st
           vx1 =
             VSub.[x1,[Offset.x1,Offset.x1+Signed32.i]] &
           vx =
             VSub.[x,[Offset.x,Offset.x+Signed32.i]] &
           vy =
             VSub.[y,[Offset.y,Offset.y+Signed32.i]] &
           power = Pow.(Signed32.i)
         holds vx1 - power * b = vx - vy) &
        (0 <= b & b <= 1) &
        (for j being Element of INT st
           Signed32.i <= j & j < Signed32.sz
         holds
           Pelt.[x1,Offset.x1+j] =
             Pelt.[x,Offset.x1+j]) &
        (for j being Element of INT st
           j < Offset.x1 or Offset.x1 + Signed32.sz <= j
         holds Pelt.[x1,j] = Pelt.[x,j]))
       implies
         ((Signed32.i < Signed32.sz implies
            (Minimum.x1 <= Offset.x1 + Signed32.i &
             Offset.x1 + Signed32.i < Maximum.x1) &
            (Minimum.y <= Offset.y + Signed32.i &
             Offset.y + Signed32.i < Maximum.y) &
            (0 <= b & b <= 1) &
            (for res,borrow being Element of INT st
               0 <= res & res < (2 |^ 64) &
               0 <= borrow & borrow < (2 |^ 64) &
               (for pr,px,py being Integer st
                  pr = Pelt.[x1,Offset.x1+Signed32.i] &
                  px = Pelt.[y,Offset.y+Signed32.i] &
                  py = res
                holds
                  py - (2 |^ 64) * borrow =
                    pr - px - b) &
               0 <= borrow & borrow <= 1
             holds
               ((Minimum.x1 <= Offset.x1 + Signed32.i &
                 Offset.x1 + Signed32.i < Maximum.x1) &
                Writable.x1 = TRUE) &
               (for x2 being Element of P st
                  Len.x2 = Len.x1 &
                  Offset.x2 = Offset.x1 &
                  Minimum.x2 = Minimum.x1 &
                  Maximum.x2 = Maximum.x1 &
                  Writable.x2 = Writable.x1 &
                  Zone.x2 = Zone.x1
                holds
                  ((for j being Element of INT holds
                      (j = Offset.x2 + Signed32.i implies
                        Pelt.[x2,j] = res) &
                      (j <> Offset.x2 + Signed32.i implies
                        Pelt.[x2,j] = Pelt.[x1,j])) &
                   Pelt.[x2,Offset.x2+Signed32.i] = res)
                  implies
                    (-(2 |^ 31) <= Signed32.i + 1 &
                     Signed32.i + 1 <= 2147483647) &
                    (for o1 being Element of INT st
                       0 <= o1 & o1 < (2 |^ 32) &
                       Signed32.o1 = Signed32.i + 1
                     holds
                       (0 <= Signed32.sz - Signed32.i &
                        Signed32.sz - Signed32.o1 <
                          Signed32.sz - Signed32.i) &
                       (0 <= Signed32.o1 &
                        Signed32.o1 <= Signed32.sz) &
                       (for vx2,vx,vy,power being Integer st
                          vx2 =
                            VSub.[x2,
                              [Offset.x2,
                               Offset.x2+Signed32.o1]] &
                          vx =
                            VSub.[x,
                              [Offset.x,
                               Offset.x+Signed32.o1]] &
                          vy =
                            VSub.[y,
                              [Offset.y,
                               Offset.y+Signed32.o1]] &
                          power = Pow.(Signed32.o1)
                        holds
                          vx2 - power * borrow = vx - vy) &
                       (0 <= borrow & borrow <= 1) &
                       (for j being Element of INT st
                          Signed32.o1 <= j &
                          j < Signed32.sz
                        holds
                          Pelt.[x2,Offset.x2+j] =
                            Pelt.[x,Offset.x2+j]) &
                       (for j being Element of INT st
                          j < Offset.x2 or
                          Offset.x2 + Signed32.sz <= j
                        holds Pelt.[x2,j] = Pelt.[x,j]))))) &
          (not Signed32.i < Signed32.sz implies
            (for vx1,vx,vy,power being Integer st
               vx1 =
                 VSub.[x1,
                   [Offset.x1,Offset.x1+Signed32.sz]] &
               vx =
                 VSub.[x,
                   [Offset.x,Offset.x+Signed32.sz]] &
               vy =
                 VSub.[y,
                   [Offset.y,Offset.y+Signed32.sz]] &
               power = Pow.(Signed32.sz)
             holds vx1 - power * b = vx - vy) &
            (0 <= b & b <= 1) &
            (for j being Element of INT st
               j < Offset.x1 or
               Offset.x1 + Signed32.sz <= j
             holds Pelt.[x1,j] = Pelt.[x,j]))))
proof
end;
::$P+
