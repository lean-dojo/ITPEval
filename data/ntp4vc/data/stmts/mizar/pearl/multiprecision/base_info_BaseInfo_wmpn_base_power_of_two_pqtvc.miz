:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/base_info_BaseInfo_wmpn_base_power_of_two_pqtvc:
:: the multiprecision base test returns the exponent for powers of two from
:: 2 through 256, and returns zero for every other admissible base.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for b,result being Nat,
      o1 being Element of BOOLEAN st
    b < (2 |^ 64) &
    result < (2 |^ 32) &
    2 <= b &
    b <= 256 &
    (b = 2 implies o1 = TRUE) &
    (o1 = TRUE implies b = 2) &
    ((o1 = TRUE & result = 1) or
     (o1 <> TRUE &
      ex o2 being Element of BOOLEAN st
        (b = 4 implies o2 = TRUE) &
        (o2 = TRUE implies b = 4) &
        ((o2 = TRUE & result = 2) or
         (o2 <> TRUE &
          ex o3 being Element of BOOLEAN st
            (b = 8 implies o3 = TRUE) &
            (o3 = TRUE implies b = 8) &
            ((o3 = TRUE & result = 3) or
             (o3 <> TRUE &
              ex o4 being Element of BOOLEAN st
                (b = 16 implies o4 = TRUE) &
                (o4 = TRUE implies b = 16) &
                ((o4 = TRUE & result = 4) or
                 (o4 <> TRUE &
                  ex o5 being Element of BOOLEAN st
                    (b = 32 implies o5 = TRUE) &
                    (o5 = TRUE implies b = 32) &
                    ((o5 = TRUE & result = 5) or
                     (o5 <> TRUE &
                      ex o6 being Element of BOOLEAN st
                        (b = 64 implies o6 = TRUE) &
                        (o6 = TRUE implies b = 64) &
                        ((o6 = TRUE & result = 6) or
                         (o6 <> TRUE &
                          ex o7 being Element of BOOLEAN st
                            (b = 128 implies o7 = TRUE) &
                            (o7 = TRUE implies b = 128) &
                            ((o7 = TRUE & result = 7) or
                             (o7 <> TRUE &
                              ex o8 being Element of BOOLEAN st
                                (b = 256 implies o8 = TRUE) &
                                (o8 = TRUE implies b = 256) &
                                ((o8 = TRUE & result = 8) or
                                 (o8 <> TRUE &
                                  result = 0))))))))))))))))
  holds
    0 <= result &
    result <= 8 &
    (result <> 0 implies 2 |^ result = b) &
    (result = 0 implies
      for n being Nat holds not 2 |^ n = b)
proof
end;
::$P+
