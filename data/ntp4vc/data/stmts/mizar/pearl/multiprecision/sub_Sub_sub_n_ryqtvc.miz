:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_Sub_sub_n_ryqtvc: the verification condition for
:: in-place equal-length multiprecision subtraction into the second operand,
:: preserving the borrow equation, pointer aliasing, memory framing, and
:: pointer metadata. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z,M being non empty set,
      Data being Function of P,INT*,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      Zr,Zx,Zy being Function of M,Z,
      Mr,Mx,My,Lr,Lx,Ly being Function of M,INT,
      Okay being Function of M,BOOLEAN,
      sz being Element of INT,
      x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, k being Nat st k in dom (Data.p)
     holds
       ex d being Integer st
         d = (Data.p).k & 0 <= d & d < (2 |^ 64)) &
    (for p being Element of P, j being Integer holds
      (len (Data.p) = 0 implies Pelt.[p,j] = 0) &
      (j < 0 & 0 < len (Data.p) implies
        Pelt.[p,j] = (Data.p).1) &
      (0 <= j & j < len (Data.p) implies
        Pelt.[p,j] = (Data.p).(j+1)) &
      (len (Data.p) <= j implies Pelt.[p,j] = 0)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    (for m being Element of M holds
      0 <= Mr.m & Mr.m < (2 |^ 32) &
      0 <= Mx.m & Mx.m < (2 |^ 32) &
      0 <= My.m & My.m < (2 |^ 32) &
      0 <= Lr.m & Lr.m < (2 |^ 32) &
      0 <= Lx.m & Lx.m < (2 |^ 32) &
      0 <= Ly.m & Ly.m < (2 |^ 32)) &
    0 <= sz & sz < (2 |^ 32) &
    0 <= Signed32.sz &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sz <= Maximum.x &
     Maximum.x <= len (Data.x)) &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sz <= Maximum.y &
     Maximum.y <= len (Data.y)) &
    Writable.y = TRUE
  holds
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sz <= Maximum.y &
     Maximum.y <= len (Data.y)) &
    (-(2 |^ 31) <= Signed32.sz &
     Signed32.sz <= 2147483647 &
     0 <= Signed32.sz &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sz <= Maximum.x &
     Maximum.x <= len (Data.x)) &
    0 <= Signed32.sz &
    Signed32.sz <= Signed32.sz &
    Writable.y = TRUE &
    (for y1,x1 being Element of P st
       Offset.y1 = Offset.y &
       Writable.y1 = Writable.y &
       Zone.y1 = Zone.y
     holds
       (Offset.x1 = Offset.x &
        Writable.x1 = Writable.x &
        Zone.x1 = Zone.x
        implies
          (for nr,ny,nx being Element of P,
               m being Element of M st
             Writable.nr = TRUE &
             (VSub.[ny,
                [Offset.ny,Offset.ny+Signed32.sz]] =
              VSub.[y,
                [Offset.y,Offset.y+Signed32.sz]] &
              VSub.[nx,
                [Offset.nx,Offset.nx+Signed32.sz]] =
              VSub.[x,
                [Offset.x,Offset.x+Signed32.sz]]) &
             ((-(2 |^ 31) <= Signed32.sz &
               Signed32.sz <= 2147483647 &
               0 <= Signed32.sz &
               0 <= Minimum.ny &
               Minimum.ny <= Offset.ny &
               Offset.ny + Signed32.sz <= Maximum.ny &
               Maximum.ny <= len (Data.ny)) &
              (-(2 |^ 31) <= Signed32.sz &
               Signed32.sz <= 2147483647 &
               0 <= Signed32.sz &
               0 <= Minimum.nx &
               Minimum.nx <= Offset.nx &
               Offset.nx + Signed32.sz <= Maximum.nx &
               Maximum.nx <= len (Data.nx))) &
             (Data.nr = Data.ny &
              Offset.nr = Offset.ny &
              Minimum.nr = Minimum.ny &
              Maximum.nr = Maximum.ny &
              Zone.nr = Zone.ny) &
             ((0 <= Offset.ny &
               Offset.ny + Signed32.sz <= Offset.nx) or
              (0 <= Offset.nx &
               Offset.nx + Signed32.sz <= Offset.ny)) &
             (Zx.m = Zone.y1 & Zy.m = Zone.x1) &
             (Signed32.(Mx.m) = Maximum.y &
              Signed32.(My.m) = Maximum.x) &
             (Lx.m = sz & Ly.m = sz) &
             Okay.m = TRUE &
             (for i being Element of INT st
                0 <= i & i < Signed32.sz
              holds
                Pelt.[ny,Offset.ny+i] =
                  Pelt.[y1,Offset.y1+i]) &
             (for i being Element of INT st
                0 <= i & i < Signed32.sz
              holds
                Pelt.[nx,Offset.nx+i] =
                  Pelt.[x1,Offset.x1+i]) &
             (for j being Element of INT holds
                Pelt.[y1,j] = Pelt.[y,j]) &
             (for j being Element of INT holds
                Pelt.[x1,j] = Pelt.[x,j]) &
             len (Data.y1) = len (Data.y) &
             len (Data.x1) = len (Data.x) &
             Minimum.y1 = Minimum.y &
             Minimum.x1 = Minimum.x &
             Data.nr = Data.ny &
             Data.ny = Data.nx
           holds
             ((0 <= Signed32.sz &
               ((-(2 |^ 31) <= Signed32.sz &
                 Signed32.sz <= 2147483647 &
                 0 <= Signed32.sz &
                 0 <= Minimum.nr &
                 Minimum.nr <= Offset.nr &
                 Offset.nr + Signed32.sz <= Maximum.nr &
                 Maximum.nr <= len (Data.nr)) &
                (-(2 |^ 31) <= Signed32.sz &
                 Signed32.sz <= 2147483647 &
                 0 <= Signed32.sz &
                 0 <= Minimum.nx &
                 Minimum.nx <= Offset.nx &
                 Offset.nx + Signed32.sz <= Maximum.nx &
                 Maximum.nx <= len (Data.nx)) &
                (-(2 |^ 31) <= Signed32.sz &
                 Signed32.sz <= 2147483647 &
                 0 <= Signed32.sz &
                 0 <= Minimum.ny &
                 Minimum.ny <= Offset.ny &
                 Offset.ny + Signed32.sz <= Maximum.ny &
                 Maximum.ny <= len (Data.ny))) &
               (Offset.nr = Offset.nx or
                Offset.nr + Signed32.sz <= Offset.nx or
                Offset.nx + Signed32.sz <= Offset.nr) &
               (Offset.nr = Offset.ny or
                Offset.nr + Signed32.sz <= Offset.ny or
                Offset.ny + Signed32.sz <= Offset.nr) &
               (Data.nr = Data.nx & Data.nx = Data.ny) &
               Writable.nr = TRUE) &
              (for nx1,ny1,nr1 being Element of P st
                 Data.nx1 = Data.nr1 &
                 len (Data.nr1) = len (Data.nx) &
                 Offset.nx1 = Offset.nx &
                 Minimum.nx1 = Minimum.nx &
                 Maximum.nx1 = Maximum.nx &
                 Writable.nx1 = Writable.nx &
                 Zone.nx1 = Zone.nx
               holds
                 ((Data.ny1 = Data.nr1 &
                   len (Data.nr1) = len (Data.ny) &
                   Offset.ny1 = Offset.ny &
                   Minimum.ny1 = Minimum.ny &
                   Maximum.ny1 = Maximum.ny &
                   Writable.ny1 = Writable.ny &
                   Zone.ny1 = Zone.ny)
                  implies
                    ((len (Data.nr1) = len (Data.nr) &
                      Offset.nr1 = Offset.nr &
                      Minimum.nr1 = Minimum.nr &
                      Maximum.nr1 = Maximum.nr &
                      Writable.nr1 = Writable.nr &
                      Zone.nr1 = Zone.nr)
                     implies
                       (for res being Element of INT st
                          0 <= res & res < (2 |^ 64)
                        holds
                          (((for vnr,vnx,vny,power being Integer st
                               vnr = VSub.[nr1,
                                 [Offset.nr1,
                                  Offset.nr1+Signed32.sz]] &
                               vnx = VSub.[nx,
                                 [Offset.nx,
                                  Offset.nx+Signed32.sz]] &
                               vny = VSub.[ny,
                                 [Offset.ny,
                                  Offset.ny+Signed32.sz]] &
                               power = Pow.(Signed32.sz)
                             holds
                               vnr - power * res = vnx - vny) &
                            (0 <= res & res <= 1) &
                            (for j being Element of INT st
                               j < Offset.nr1 or
                               Offset.nr1 + Signed32.sz <= j
                             holds
                               Pelt.[nr1,j] = Pelt.[nr,j]) &
                            (Offset.nr1 = Offset.nx1 or
                             (for i being Element of INT st
                                Offset.nx1 <= i &
                                i < Offset.nx1 + Signed32.sz
                              holds
                                Pelt.[nx1,i] = Pelt.[nx,i])) &
                            (Offset.nr1 = Offset.ny1 or
                             (for i being Element of INT st
                                Offset.ny1 <= i &
                                i < Offset.ny1 + Signed32.sz
                              holds
                                Pelt.[ny1,i] = Pelt.[ny,i])))
                           implies
                             (((Writable.y1 = TRUE &
                                Writable.nr1 = TRUE) &
                               Okay.m = TRUE &
                               (0 <= Signed32.sz &
                                Signed32.sz <= Signed32.sz) &
                               (Data.nr1 = Data.ny1 &
                                Offset.nr1 = Offset.ny1 &
                                Minimum.nr1 = Minimum.ny1 &
                                Maximum.nr1 = Maximum.ny1 &
                                Zone.nr1 = Zone.ny1) &
                               ((0 <= Offset.ny1 &
                                 Offset.ny1 + Signed32.sz <=
                                   Offset.nx1) or
                                (0 <= Offset.nx1 &
                                 Offset.nx1 + Signed32.sz <=
                                   Offset.ny1)) &
                               (Zx.m = Zone.y1 &
                                Zy.m = Zone.x1) &
                               Lx.m = sz &
                               Ly.m = sz) &
                              (for m1 being Element of M,
                                   nx2,ny2,y2,x2 being Element of P st
                                 Zr.m1 = Zr.m &
                                 Zx.m1 = Zx.m &
                                 Zy.m1 = Zy.m &
                                 Mr.m1 = Mr.m &
                                 Mx.m1 = Mx.m &
                                 My.m1 = My.m &
                                 Lr.m1 = Lr.m &
                                 Lx.m1 = Lx.m &
                                 Ly.m1 = Ly.m
                               holds
                                 ((Offset.nx2 = Offset.nx1 &
                                   Writable.nx2 = Writable.nx1 &
                                   Zone.nx2 = Zone.nx1)
                                  implies
                                    ((Offset.ny2 = Offset.ny1 &
                                      Writable.ny2 = Writable.ny1 &
                                      Zone.ny2 = Zone.ny1)
                                     implies
                                       ((Offset.y2 = Offset.y1 &
                                         Minimum.y2 = Minimum.y1 &
                                         Writable.y2 = Writable.y1 &
                                         Zone.y2 = Zone.y1)
                                        implies
                                          ((Offset.x2 = Offset.x1 &
                                            Minimum.x2 = Minimum.x1 &
                                            Writable.x2 = Writable.x1 &
                                            Zone.x2 = Zone.x1)
                                           implies
                                             (((Maximum.y2 =
                                                  Signed32.(Mx.m1) &
                                                Maximum.x2 =
                                                  Signed32.(My.m1)) &
                                               (for i being Element of INT st
                                                  0 <= i &
                                                  i < Signed32.sz
                                                holds
                                                  Pelt.[ny1,Offset.ny2+i] =
                                                    Pelt.[y2,Offset.y2+i]) &
                                               (for i being Element of INT st
                                                  0 <= i &
                                                  i < Signed32.sz
                                                holds
                                                  Pelt.[nx1,Offset.nx2+i] =
                                                    Pelt.[x2,Offset.x2+i]) &
                                               (for j being Element of INT st
                                                  j < Offset.y2 or
                                                  Offset.y2 +
                                                    Signed32.sz <= j
                                                holds
                                                  Pelt.[y2,j] =
                                                    Pelt.[y1,j]) &
                                               (for j being Element of INT st
                                                  j < Offset.x2 or
                                                  Offset.x2 +
                                                    Signed32.sz <= j
                                                holds
                                                  Pelt.[x2,j] =
                                                    Pelt.[x1,j]) &
                                               (len (Data.y2) =
                                                  len (Data.y1) &
                                                len (Data.x2) =
                                                  len (Data.x1)) &
                                               Minimum.y2 = Minimum.y1 &
                                               Minimum.x2 = Minimum.x1)
                                              implies
                                                ((for vy2,vx,vy,power
                                                    being Integer st
                                                    vy2 = VSub.[y2,
                                                      [Offset.y2,
                                                       Offset.y2+
                                                         Signed32.sz]] &
                                                    vx = VSub.[x,
                                                      [Offset.x,
                                                       Offset.x+
                                                         Signed32.sz]] &
                                                    vy = VSub.[y,
                                                      [Offset.y,
                                                       Offset.y+
                                                         Signed32.sz]] &
                                                    power =
                                                      Pow.(Signed32.sz)
                                                  holds
                                                    vy2 - power * res =
                                                      vx - vy) &
                                                 (0 <= res &
                                                  res <= 1) &
                                                 (for j being Element of INT st
                                                    j < Offset.y2 or
                                                    Offset.y2 +
                                                      Signed32.sz <= j
                                                  holds
                                                    Pelt.[y2,j] =
                                                      Pelt.[y,j]) &
                                                 (for j being Element of INT
                                                  holds
                                                    Pelt.[x2,j] =
                                                      Pelt.[x,j]) &
                                                 VSub.[x2,
                                                   [Offset.x2,
                                                    Offset.x2+
                                                      Signed32.sz]] =
                                                   VSub.[x,
                                                     [Offset.x,
                                                      Offset.x+
                                                        Signed32.sz]] &
                                                 (Minimum.x2 = Minimum.x &
                                                  Maximum.x2 = Maximum.x &
                                                  len (Data.x2) =
                                                    len (Data.x)) &
                                                 Minimum.y2 = Minimum.y &
                                                 Maximum.y2 = Maximum.y &
                                                 len (Data.y2) =
                                                   len (Data.y))))))))))
                                           ))))))))
proof
end;
::$P+
