:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/sub_SubOld_wmpn_sub_in_placeqtvc: the loop
:: verification condition for in-place multiprecision subtraction, including
:: borrow propagation, modular limb updates, and memory framing.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Signed32 being Function of INT,INT,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      sy,sx being Element of INT,
      x,y being Element of P
  st
    (for w being Integer st 0 <= w & w < (2 |^ 32) holds
      (w < (2 |^ 31) implies Signed32.w = w) &
      (not w < (2 |^ 31) implies
        Signed32.w = w - (2 |^ 32))) &
    (for p being Element of P, j being Element of INT holds
      for pj being Integer st pj = Pelt.[p,j] holds
        0 <= pj & pj < (2 |^ 64)) &
    Pow.0 = 1 &
    (for n being Element of INT st 0 <= n holds
      Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
      (n < m implies
        (for v,pn,vnext being Integer st
           v = VSub.[p,[n,m]] &
           pn = Pelt.[p,n] &
           vnext = VSub.[p,[n+1,m]]
         holds v = pn + (2 |^ 64) * vnext)) &
      (not n < m implies VSub.[p,[n,m]] = 0)) &
    0 <= sy & sy < (2 |^ 32) &
    0 <= sx & sx < (2 |^ 32) &
    0 <= Signed32.sy &
    Signed32.sy <= Signed32.sx &
    -(2 |^ 31) <= Signed32.sx &
    Signed32.sx <= 2147483647 &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + Signed32.sx <= Maximum.x &
    Maximum.x <= Len.x &
    -(2 |^ 31) <= Signed32.sy &
    Signed32.sy <= 2147483647 &
    0 <= Minimum.y &
    Minimum.y <= Offset.y &
    Offset.y + Signed32.sy <= Maximum.y &
    Maximum.y <= Len.y &
    Writable.x = TRUE
  holds
    0 <= Signed32.sy &
    (-(2 |^ 31) <= Signed32.sy &
     Signed32.sy <= 2147483647 &
     0 <= Signed32.sy &
     0 <= Minimum.x &
     Minimum.x <= Offset.x &
     Offset.x + Signed32.sy <= Maximum.x &
     Maximum.x <= Len.x) &
    (-(2 |^ 31) <= Signed32.sy &
     Signed32.sy <= 2147483647 &
     0 <= Signed32.sy &
     0 <= Minimum.y &
     Minimum.y <= Offset.y &
     Offset.y + Signed32.sy <= Maximum.y &
     Maximum.y <= Len.y) &
    Writable.x = TRUE &
    (for x1 being Element of P st
       Len.x1 = Len.x &
       Offset.x1 = Offset.x &
       Minimum.x1 = Minimum.x &
       Maximum.x1 = Maximum.x &
       Writable.x1 = Writable.x &
       Zone.x1 = Zone.x
     holds
       for o1 being Element of INT st
         0 <= o1 & o1 < (2 |^ 64) &
         (for vx1,vx,vy,power being Integer st
            vx1 =
              VSub.[x1,[Offset.x1,Offset.x1+Signed32.sy]] &
            vx =
              VSub.[x,[Offset.x,Offset.x+Signed32.sy]] &
            vy =
              VSub.[y,[Offset.y,Offset.y+Signed32.sy]] &
            power = Pow.(Signed32.sy)
          holds vx1 - power * o1 = vx - vy) &
         (0 <= o1 & o1 <= 1) &
         (for j being Element of INT st
            j < Offset.x1 or Offset.x1 + Signed32.sy <= j
          holds Pelt.[x1,j] = Pelt.[x,j])
       holds
         for o2 being Element of BOOLEAN st
           (o1 = 0 implies o2 = TRUE) &
           (o2 = TRUE implies o1 = 0)
         holds
           (o2 <> TRUE implies
             ((Signed32.sy <= Signed32.sy &
               Signed32.sy <= Signed32.sx) &
              (for vx1,vx,vy,power being Integer st
                 vx1 =
                   VSub.[x1,
                     [Offset.x1,Offset.x1+Signed32.sy]] &
                 vx =
                   VSub.[x,
                     [Offset.x,Offset.x+Signed32.sy]] &
                 vy =
                   VSub.[y,
                     [Offset.y,Offset.y+Signed32.sy]] &
                 power = Pow.(Signed32.sy)
               holds vx1 - power * o1 = vx - vy) &
              (0 <= o1 & o1 <= 1) &
              (sy = sx or o1 = 1) &
              (for j being Element of INT st
                 Signed32.sy <= j & j < Signed32.sx
               holds
                 Pelt.[x1,Offset.x1+j] =
                   Pelt.[x,Offset.x1+j]) &
              (for j being Element of INT st
                 j < Offset.x1 or Offset.x1 + Signed32.sx <= j
               holds Pelt.[x1,j] = Pelt.[x,j])) &
             (for i,b being Element of INT,
                  x2 being Element of P st
                0 <= i & i < (2 |^ 32) &
                0 <= b & b < (2 |^ 64) &
                Len.x2 = Len.x1 &
                Offset.x2 = Offset.x1 &
                Minimum.x2 = Minimum.x1 &
                Maximum.x2 = Maximum.x1 &
                Writable.x2 = Writable.x1 &
                Zone.x2 = Zone.x1 &
                (Signed32.sy <= Signed32.i &
                 Signed32.i <= Signed32.sx) &
                (for vx2,vx,vy,power being Integer st
                   vx2 =
                     VSub.[x2,
                       [Offset.x2,Offset.x2+Signed32.i]] &
                   vx =
                     VSub.[x,
                       [Offset.x,Offset.x+Signed32.i]] &
                   vy =
                     VSub.[y,
                       [Offset.y,Offset.y+Signed32.sy]] &
                   power = Pow.(Signed32.i)
                 holds vx2 - power * b = vx - vy) &
                (0 <= b & b <= 1) &
                (i = sx or b = 1) &
                (for j being Element of INT st
                   Signed32.i <= j & j < Signed32.sx
                 holds
                   Pelt.[x2,Offset.x2+j] =
                     Pelt.[x,Offset.x2+j]) &
                (for j being Element of INT st
                   j < Offset.x2 or Offset.x2 + Signed32.sx <= j
                 holds Pelt.[x2,j] = Pelt.[x,j])
              holds
                (Signed32.i < Signed32.sx implies
                  (Minimum.x2 <= Offset.x2 + Signed32.i &
                   Offset.x2 + Signed32.i < Maximum.x2) &
                  (for res being Element of INT st
                     0 <= res & res < (2 |^ 64) &
                     (for px being Integer st
                        px = Pelt.[x2,Offset.x2+Signed32.i]
                      holds res = (px - 1) mod (2 |^ 64))
                   holds
                     (Minimum.x2 <= Offset.x2 + Signed32.i &
                      Offset.x2 + Signed32.i < Maximum.x2) &
                     Writable.x2 = TRUE &
                     (for x3 being Element of P st
                        Len.x3 = Len.x2 &
                        Offset.x3 = Offset.x2 &
                        Minimum.x3 = Minimum.x2 &
                        Maximum.x3 = Maximum.x2 &
                        Writable.x3 = Writable.x2 &
                        Zone.x3 = Zone.x2 &
                        (for j being Element of INT holds
                          (j = Offset.x3 + Signed32.i implies
                            Pelt.[x3,j] = res) &
                          (j <> Offset.x3 + Signed32.i implies
                            Pelt.[x3,j] = Pelt.[x2,j])) &
                        Pelt.[x3,Offset.x3+Signed32.i] = res
                      holds
                        -(2 |^ 31) <= Signed32.i + 1 &
                        Signed32.i + 1 <= 2147483647 &
                        (for o3 being Element of INT st
                           0 <= o3 & o3 < (2 |^ 32) &
                           Signed32.o3 = Signed32.i + 1
                         holds
                           for o4 being Element of BOOLEAN st
                             (Pelt.[x2,Offset.x2+Signed32.i] = 0
                                implies o4 = TRUE) &
                             (o4 = TRUE implies
                                Pelt.[x2,Offset.x2+Signed32.i] = 0)
                           holds
                             (o4 <> TRUE implies
                               (for vx3,vx,vy,power being Integer st
                                  vx3 =
                                    VSub.[x3,
                                      [Offset.x3,
                                       Offset.x3+Signed32.sx]] &
                                  vx =
                                    VSub.[x,
                                      [Offset.x,
                                       Offset.x+Signed32.sx]] &
                                  vy =
                                    VSub.[y,
                                      [Offset.y,
                                       Offset.y+Signed32.sy]] &
                                  power = Pow.(Signed32.sx)
                                holds
                                  vx3 - power * 0 = vx - vy) &
                               (0 <= 0 & 0 <= 1) &
                               (for j being Element of INT st
                                  j < Offset.x3 or
                                  Offset.x3 + Signed32.sx <= j
                                holds
                                  Pelt.[x3,j] = Pelt.[x,j])) &
                             (o4 = TRUE implies
                               (0 <= Signed32.sx - Signed32.i &
                                Signed32.sx - Signed32.o3 <
                                  Signed32.sx - Signed32.i) &
                               (Signed32.sy <= Signed32.o3 &
                                Signed32.o3 <= Signed32.sx) &
                               (for vx3,vx,vy,power being Integer st
                                  vx3 =
                                    VSub.[x3,
                                      [Offset.x3,
                                       Offset.x3+Signed32.o3]] &
                                  vx =
                                    VSub.[x,
                                      [Offset.x,
                                       Offset.x+Signed32.o3]] &
                                  vy =
                                    VSub.[y,
                                      [Offset.y,
                                       Offset.y+Signed32.sy]] &
                                  power = Pow.(Signed32.o3)
                                holds
                                  vx3 - power * b = vx - vy) &
                               (0 <= b & b <= 1) &
                               (o3 = sx or b = 1) &
                               (for j being Element of INT st
                                  Signed32.o3 <= j &
                                  j < Signed32.sx
                                holds
                                  Pelt.[x3,Offset.x3+j] =
                                    Pelt.[x,Offset.x3+j]) &
                               (for j being Element of INT st
                                  j < Offset.x3 or
                                  Offset.x3 + Signed32.sx <= j
                                holds
                                  Pelt.[x3,j] = Pelt.[x,j]))))) &
                (not Signed32.i < Signed32.sx implies
                  (for vx2,vx,vy,power being Integer st
                     vx2 =
                       VSub.[x2,
                         [Offset.x2,Offset.x2+Signed32.sx]] &
                     vx =
                       VSub.[x,
                         [Offset.x,Offset.x+Signed32.sx]] &
                     vy =
                       VSub.[y,
                         [Offset.y,Offset.y+Signed32.sy]] &
                     power = Pow.(Signed32.sx)
                   holds vx2 - power * b = vx - vy) &
                  (0 <= b & b <= 1) &
                  (for j being Element of INT st
                     j < Offset.x2 or
                     Offset.x2 + Signed32.sx <= j
                   holds Pelt.[x2,j] = Pelt.[x,j])))) &
           (o2 = TRUE implies
             (for vx1,vx,vy,power being Integer st
                vx1 =
                  VSub.[x1,
                    [Offset.x1,Offset.x1+Signed32.sx]] &
                vx =
                  VSub.[x,
                    [Offset.x,Offset.x+Signed32.sx]] &
                vy =
                  VSub.[y,
                    [Offset.y,Offset.y+Signed32.sy]] &
                power = Pow.(Signed32.sx)
              holds vx1 - power * o1 = vx - vy) &
             (0 <= o1 & o1 <= 1) &
             (for j being Element of INT st
                j < Offset.x1 or Offset.x1 + Signed32.sx <= j
              holds Pelt.[x1,j] = Pelt.[x,j]))))
proof
end;
::$P+
