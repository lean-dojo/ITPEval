:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/div_Div_div2by1_invqtvc: the verification
:: condition for two-limb by one-limb unsigned division using a reciprocal
:: estimate, including carry correction and the quotient-remainder bounds.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for d,uh,v,l,h,ul being Integer st
    0 <= d & d < (2 |^ 64) &
    0 <= uh & uh < (2 |^ 64) &
    0 <= v & v < (2 |^ 64) &
    0 <= l & l < (2 |^ 64) &
    0 <= h & h < (2 |^ 64) &
    0 <= ul & ul < (2 |^ 64) &
    ((2 |^ 64) div 2) <= d &
    uh < d &
    v = ((((2 |^ 64) * (2 |^ 64)) - 1) div d)
          - (2 |^ 64) &
    l + (2 |^ 64) * h = v * uh
  holds
    0 <= 0 &
    0 <= 1 &
    (for sl,c being Integer st
       0 <= sl & sl < (2 |^ 64) &
       0 <= c & c < (2 |^ 64) &
       sl + (2 |^ 64) * c = l + ul + 0 &
       0 <= c & c <= 1
     holds
       (0 <= c & c <= 1) &
       (for sh,cp being Integer st
          0 <= sh & sh < (2 |^ 64) &
          0 <= cp & cp < (2 |^ 64) &
          sh + (2 |^ 64) * cp = uh + h + c &
          0 <= cp & cp <= 1
        holds
          for o1 being Integer st
            0 <= o1 & o1 < (2 |^ 64) &
            o1 = (sh + 1) mod (2 |^ 64)
          holds
            for p being Integer st
              0 <= p & p < (2 |^ 64) &
              p = (o1 * d) mod (2 |^ 64)
            holds
              for o2 being Integer st
                0 <= o2 & o2 < (2 |^ 64) &
                o2 = (ul - p) mod (2 |^ 64)
              holds
                (sl < o2 implies
                  for o3 being Integer st
                    0 <= o3 & o3 < (2 |^ 64) &
                    o3 = (o1 - 1) mod (2 |^ 64)
                  holds
                    for o4 being Integer st
                      0 <= o4 & o4 < (2 |^ 64) &
                      o4 = (o2 + d) mod (2 |^ 64)
                    holds
                      (d <= o4 implies
                        (0 <= o3 + 1 &
                         o3 + 1 < (2 |^ 64)) &
                        (for o5 being Integer st
                           0 <= o5 & o5 < (2 |^ 64) &
                           o5 = o3 + 1
                         holds
                           (0 <= o4 - d &
                            o4 - d < (2 |^ 64)) &
                           (for o6 being Integer st
                              0 <= o6 & o6 < (2 |^ 64) &
                              o6 = o4 - d
                            holds
                              o5 * d + o6 =
                                ul + (2 |^ 64) * uh &
                              0 <= o6 & o6 < d))) &
                      (not d <= o4 implies
                        o3 * d + o4 =
                          ul + (2 |^ 64) * uh &
                        0 <= o4 & o4 < d)) &
                (not sl < o2 implies
                  (d <= o2 implies
                    (0 <= o1 + 1 &
                     o1 + 1 < (2 |^ 64)) &
                    (for o3 being Integer st
                       0 <= o3 & o3 < (2 |^ 64) &
                       o3 = o1 + 1
                     holds
                       (0 <= o2 - d &
                        o2 - d < (2 |^ 64)) &
                       (for o4 being Integer st
                          0 <= o4 & o4 < (2 |^ 64) &
                          o4 = o2 - d
                        holds
                          o3 * d + o4 =
                            ul + (2 |^ 64) * uh &
                          0 <= o4 & o4 < d))) &
                  (not d <= o2 implies
                    o1 * d + o2 =
                      ul + (2 |^ 64) * uh &
                    0 <= o2 & o2 < d))))
proof
end;
::$P+
