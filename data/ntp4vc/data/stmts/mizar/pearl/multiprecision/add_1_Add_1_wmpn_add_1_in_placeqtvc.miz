:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/multiprecision/add_1_Add_1_wmpn_add_1_in_placeqtvc: the
:: verification condition for in-place addition of one 64-bit limb to a
:: positive-length multiprecision integer, including carry propagation,
:: pointer updates, and memory framing. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    NAT_D, NEWTON, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, NEWTON, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for P,Z being non empty set,
      Len being Function of P,NAT,
      Offset,Minimum,Maximum being Function of P,INT,
      Writable being Function of P,BOOLEAN,
      Zone being Function of P,Z,
      Pelt being Function of [:P,INT:],INT,
      VSub being Function of [:P,[:INT,INT:]:],INT,
      Pow being Function of INT,INT,
      x being Element of P,
      sz,y being Element of INT
  st
    (for p being Element of P, j being Element of INT holds
       for pj being Integer st pj = Pelt.[p,j] holds
         0 <= pj & pj < (2 |^ 64)) &
    Pow.0 = 1 &
    (for n being Element of INT st n < 0 holds Pow.n = 1) &
    (for n being Element of INT st 0 <= n holds
       Pow.(n+1) = (2 |^ 64) * Pow.n) &
    (for p being Element of P, n,m being Element of INT holds
       (n < m implies
          (for v,pn,vnext being Integer st
             v = VSub.[p,[n,m]] &
             pn = Pelt.[p,n] &
             vnext = VSub.[p,[n+1,m]]
           holds v = pn + (2 |^ 64) * vnext)) &
       (not n < m implies VSub.[p,[n,m]] = 0)) &
    -(2 |^ 31) <= sz & sz <= 2147483647 &
    0 <= y & y < (2 |^ 64) &
    0 <= sz &
    0 <= Minimum.x &
    Minimum.x <= Offset.x &
    Offset.x + sz <= Maximum.x &
    Maximum.x <= Len.x &
    0 < sz &
    Writable.x = TRUE
  holds
    Minimum.x <= Offset.x &
    Offset.x < Maximum.x &
    (for res being Element of INT st
       0 <= res & res < (2 |^ 64) &
       (for px being Integer st px = Pelt.[x,Offset.x] holds
          res = (px + y) mod (2 |^ 64))
     holds
       (Minimum.x <= Offset.x & Offset.x < Maximum.x) &
       Writable.x = TRUE &
       (for x1 being Element of P st
          Len.x1 = Len.x &
          Offset.x1 = Offset.x &
          Minimum.x1 = Minimum.x &
          Maximum.x1 = Maximum.x &
          Writable.x1 = Writable.x &
          Zone.x1 = Zone.x &
          (for j being Element of INT holds
             (j = Offset.x1 implies Pelt.[x1,j] = res) &
             (j <> Offset.x1 implies Pelt.[x1,j] = Pelt.[x,j]))
        holds
          (for px being Integer st px = Pelt.[x,Offset.x] holds
            (res < px implies
              ((1 <= 1 & 1 <= sz) &
               (0 <= 1 & 1 <= 1) &
               (1 = 1 or 1 = sz) &
               (for vx1,vx,p1 being Integer st
                  vx1 = VSub.[x1,[Offset.x1,Offset.x1+1]] &
                  vx = VSub.[x,[Offset.x,Offset.x+1]] &
                  p1 = Pow.1
                holds vx1 + p1 * 1 = vx + y) &
               (for j being Element of INT st
                  j < Offset.x1 or Offset.x1 + 1 <= j
                holds Pelt.[x1,j] = Pelt.[x,j]))) &
            (for i,c being Element of INT,
                 x2 being Element of P st
               -(2 |^ 31) <= i & i <= 2147483647 &
               0 <= c & c < (2 |^ 64) &
               Len.x2 = Len.x1 &
               Offset.x2 = Offset.x1 &
               Minimum.x2 = Minimum.x1 &
               Maximum.x2 = Maximum.x1 &
               Writable.x2 = Writable.x1 &
               Zone.x2 = Zone.x1 &
               (1 <= i & i <= sz) &
               (0 <= c & c <= 1) &
               (c = 1 or i = sz) &
               (for vx2,vx being Integer st
                  vx2 = VSub.[x2,[Offset.x2,Offset.x2+i]] &
                  vx = VSub.[x,[Offset.x,Offset.x+i]]
                holds vx2 + Pow.i * c = vx + y) &
               (for j being Element of INT st
                  j < Offset.x2 or Offset.x2 + i <= j
                holds Pelt.[x2,j] = Pelt.[x,j])
             holds
               (i < sz implies
                 (Minimum.x2 <= Offset.x2 + i &
                  Offset.x2 + i < Maximum.x2) &
                         (for res1 being Element of INT st
                            0 <= res1 &
                            res1 < (2 |^ 64) &
                            (for px2 being Integer st
                               px2 = Pelt.[x2,Offset.x2+i]
                             holds
                               res1 = (px2 + 1) mod (2 |^ 64))
                  holds
                    (Minimum.x2 <= Offset.x2 + i &
                     Offset.x2 + i < Maximum.x2) &
                    Writable.x2 = TRUE &
                    (for x3 being Element of P st
                       Len.x3 = Len.x2 &
                       Offset.x3 = Offset.x2 &
                       Minimum.x3 = Minimum.x2 &
                       Maximum.x3 = Maximum.x2 &
                       Writable.x3 = Writable.x2 &
                       Zone.x3 = Zone.x2 &
                               (for j being Element of INT holds
                          (j = Offset.x3 + i implies
                             Pelt.[x3,j] = res1) &
                          (j <> Offset.x3 + i implies
                             Pelt.[x3,j] = Pelt.[x2,j])) &
                       Pelt.[x3,Offset.x3+i] = res1
                     holds
                       -(2 |^ 31) <= i+1 &
                       i+1 <= 2147483647 &
                               (for o2 being Element of INT st
                          -(2 |^ 31) <= o2 &
                          o2 <= 2147483647 &
                          o2 = i+1
                        holds
                          (for o3 being Element of BOOLEAN st
                             (res1 = 0 implies o3 = TRUE) &
                             (o3 = TRUE implies res1 = 0)
                                   holds
                                     (o3 <> TRUE implies
                                       (for vx3,vx being Integer st
                                          vx3 = VSub.[x3,
                                            [Offset.x3,Offset.x3+sz]] &
                                          vx = VSub.[x,
                                            [Offset.x,Offset.x+sz]]
                                        holds
                                          vx3 + Pow.sz * 0 = vx + y) &
                                       (0 <= 0 & 0 <= 1) &
                                       (for j being Element of INT st
                                          j < Offset.x3 or
                                          Offset.x3 + sz <= j
                                holds
                                  Pelt.[x3,j] = Pelt.[x,j])) &
                             (o3 = TRUE implies
                               (0 <= sz-i &
                                sz-o2 < sz-i) &
                               (1 <= o2 & o2 <= sz) &
                                       (0 <= c & c <= 1) &
                                       (c = 1 or o2 = sz) &
                                       (for vx3,vx being Integer st
                                          vx3 = VSub.[x3,
                                            [Offset.x3,Offset.x3+o2]] &
                                          vx = VSub.[x,
                                            [Offset.x,Offset.x+o2]]
                                        holds
                                          vx3 + Pow.o2 * c = vx + y) &
                                       (for j being Element of INT st
                                  j < Offset.x3 or
                                  Offset.x3 + o2 <= j
                                holds
                                  Pelt.[x3,j] = Pelt.[x,j])))))) &
                       (not i < sz implies
                         (for vx2,vx being Integer st
                            vx2 = VSub.[x2,[Offset.x2,Offset.x2+sz]] &
                            vx = VSub.[x,[Offset.x,Offset.x+sz]]
                          holds vx2 + Pow.sz * c = vx + y) &
                         (0 <= c & c <= 1) &
                         (for j being Element of INT st
                            j < Offset.x2 or Offset.x2 + sz <= j
                          holds Pelt.[x2,j] = Pelt.[x,j])))) &
                  (not res < px implies
                    (for vx1,vx being Integer st
                       vx1 = VSub.[x1,[Offset.x1,Offset.x1+sz]] &
                       vx = VSub.[x,[Offset.x,Offset.x+sz]]
                     holds vx1 + Pow.sz * 0 = vx + y) &
                    (0 <= 0 & 0 <= 1) &
                    (for j being Element of INT st
                       j < Offset.x1 or Offset.x1 + sz <= j
                     holds Pelt.[x1,j] = Pelt.[x,j])))))
proof
end;
::$P+
