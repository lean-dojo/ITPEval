:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2017_odd_even_transposition_sort_Challenge3_odd_even_transposition_sortqtvc:
:: the odd-even transposition-sort verification condition preserves integer
:: sequence permutations, parity-indexed sorted prefixes, inversion variants,
:: and final sortedness through the odd and even passes. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_2, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1, XTUPLE_0, BINOP_1, BINOP_2,
    FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2, FINSOP_1,
    RVSUM_1, CLASSES1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_2, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN,
    BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, CLASSES1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, REAL_1,
    INT_1, INT_2, XXREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, PRE_POLY,
    FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, BINOP_1, BINOP_2,
    FUNCOP_1, FINSEQOP, SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1,
    CLASSES1, ZFMISC_1, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_2, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, RVSUM_1, FUNCOP_1, FRAENKEL, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for nthElem being Function of [:INT*,INT:],INT,
      inversions being Function of INT*,INT,
      Sorted being Subset of INT*,
      OddSorted,EvenSorted being Subset of [:INT*,INT:],
      Exchange being Subset of
        [:INT*,[:INT*,[:INT,INT:]:]:]
  st
    (for s being FinSequence of INT, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = 0) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = 0)) &
    (for s being FinSequence of INT holds
       inversions.s =
         card {p where p is Element of [:INT,INT:] :
           ex i,j being Integer st
             p = [i,j] & 0 <= i & i < j & j < len s &
             nthElem.[s,j] < nthElem.[s,i]}) &
    (for s being FinSequence of INT holds
       (s in Sorted iff
         for i1,i2 being Integer st
           0 <= i1 & i1 <= i2 & i2 < len s
         holds nthElem.[s,i1] <= nthElem.[s,i2])) &
    (for s being FinSequence of INT, n being Integer holds
       ([s,n] in OddSorted iff
         for i being Integer st
           0 <= i & 2*i+2 < n
         holds nthElem.[s,2*i+1] <= nthElem.[s,2*i+2])) &
    (for s being FinSequence of INT, n being Integer holds
       ([s,n] in EvenSorted iff
         for i being Integer st
           0 <= i & 2*i+1 < n
         holds nthElem.[s,2*i] <= nthElem.[s,2*i+1])) &
    (for s,t being FinSequence of INT, i,j being Integer holds
       ([s,[t,[i,j]]] in Exchange iff
         len s = len t &
         nthElem.[t,i] = nthElem.[s,j] &
         nthElem.[t,j] = nthElem.[s,i] &
         (for k being Integer st
           0 <= k & k < len s & k <> i & k <> j
          holds nthElem.[t,k] = nthElem.[s,k])))
  holds
    for a being FinSequence of INT holds
      a,a are_fiberwise_equipotent &
      (for sortedFlag being Element of BOOLEAN,
           a1 being FinSequence of INT st
         len a1 = len a
       holds
         (a,a1 are_fiberwise_equipotent &
          (sortedFlag = TRUE implies a1 in Sorted))
         implies
           (sortedFlag <> TRUE implies
             ((0 <= 0 & 0 <= 1 & 1 = 2*0+1) &
              a,a1 are_fiberwise_equipotent &
              [a1,1] in OddSorted &
              (FALSE = TRUE implies
                inversions.a1 < inversions.a1)) &
             (for halfI being Integer,
                  sortedFlag1 being Element of BOOLEAN,
                  a2 being FinSequence of INT
              holds
                (len a2 = len a1 &
                 (0 <= halfI & 0 <= 2*halfI+1) &
                 a,a2 are_fiberwise_equipotent &
                 [a2,2*halfI+1] in OddSorted &
                 (sortedFlag1 = TRUE implies
                   inversions.a2 = inversions.a1) &
                 (sortedFlag1 <> TRUE implies
                   inversions.a2 < inversions.a1))
                implies
                  (2*halfI+1 < len a2-1 implies
                    for o1 being Integer st
                      o1 = 2*halfI+1+1
                    holds
                      (0 <= o1 & o1 < len a2) &
                      (0 <= 2*halfI+1 &
                       2*halfI+1 < len a2) &
                      (nthElem.[a2,o1] <
                         nthElem.[a2,2*halfI+1]
                       implies
                         for o2 being Integer st
                           o2 = 2*halfI+1+1
                         holds
                           ((0 <= 2*halfI+1 &
                             2*halfI+1 < len a2) &
                            0 <= o2 & o2 < len a2) &
                           (for a3 being FinSequence of INT
                            holds
                              (len a3 = len a2 &
                               [a2,[a3,[2*halfI+1,o2]]]
                                 in Exchange)
                              implies
                                (0 <= len a2-(2*halfI+1) &
                                 len a3-(2*halfI+1+2) <
                                   len a2-(2*halfI+1)) &
                                (0 <= halfI+1 &
                                 0 <= 2*halfI+1+2 &
                                 2*halfI+1+2 =
                                   2*(halfI+1)+1) &
                                a,a3 are_fiberwise_equipotent &
                                [a3,2*halfI+1+2]
                                  in OddSorted &
                                (FALSE = TRUE implies
                                  inversions.a3 =
                                    inversions.a1) &
                                (FALSE <> TRUE implies
                                  inversions.a3 <
                                    inversions.a1))) &
                      (not nthElem.[a2,o1] <
                         nthElem.[a2,2*halfI+1]
                       implies
                         (0 <= len a2-(2*halfI+1) &
                          len a2-(2*halfI+1+2) <
                            len a2-(2*halfI+1)) &
                         (0 <= halfI+1 &
                          0 <= 2*halfI+1+2 &
                          2*halfI+1+2 =
                            2*(halfI+1)+1) &
                         a,a2 are_fiberwise_equipotent &
                         [a2,2*halfI+1+2] in OddSorted &
                         (sortedFlag1 = TRUE implies
                           inversions.a2 = inversions.a1) &
                         (sortedFlag1 <> TRUE implies
                           inversions.a2 < inversions.a1))) &
                  (not 2*halfI+1 < len a2-1 implies
                    ((0 <= 0 & 0 <= 0 & 0 = 2*0) &
                     0 <= 0 &
                     a,a2 are_fiberwise_equipotent &
                     (sortedFlag1 = TRUE implies
                       [a2,len a2] in OddSorted) &
                     [a2,0] in EvenSorted &
                     (sortedFlag1 = TRUE implies
                       inversions.a2 = inversions.a1) &
                     (sortedFlag1 <> TRUE implies
                       inversions.a2 < inversions.a1) &
                     (sortedFlag1 = TRUE or
                       inversions.a2 < inversions.a1)) &
                    (for halfI1 being Integer,
                         sortedFlag2 being Element of BOOLEAN,
                         a3 being FinSequence of INT
                     holds
                       (len a3 = len a2 &
                        (0 <= halfI1 &
                         0 <= 2*halfI1) &
                        0 <= 2*halfI1 &
                        a,a3 are_fiberwise_equipotent &
                        (sortedFlag2 = TRUE implies
                          [a3,len a3] in OddSorted) &
                        [a3,2*halfI1] in EvenSorted &
                        (sortedFlag2 = TRUE implies
                          inversions.a3 =
                            inversions.a1) &
                        (sortedFlag2 <> TRUE implies
                          inversions.a3 <
                            inversions.a1) &
                        (sortedFlag2 = TRUE or
                          inversions.a3 <
                            inversions.a1))
                       implies
                         (2*halfI1 < len a3-1 implies
                           for o1 being Integer st
                             o1 = 2*halfI1+1
                           holds
                             (0 <= o1 & o1 < len a3) &
                             (0 <= 2*halfI1 &
                              2*halfI1 < len a3) &
                             (nthElem.[a3,o1] <
                                nthElem.[a3,2*halfI1]
                              implies
                                for o2 being Integer st
                                  o2 = 2*halfI1+1
                                holds
                                  ((0 <= 2*halfI1 &
                                    2*halfI1 < len a3) &
                                   0 <= o2 & o2 < len a3) &
                                  (for a4 being
                                     FinSequence of INT
                                   holds
                                     (len a4 = len a3 &
                                      [a3,[a4,
                                        [2*halfI1,o2]]]
                                        in Exchange)
                                     implies
                                       (0 <= len a3-2*halfI1 &
                                        len a4-(2*halfI1+2) <
                                          len a3-2*halfI1) &
                                       (0 <= halfI1+1 &
                                        0 <= 2*halfI1+2 &
                                        2*halfI1+2 =
                                          2*(halfI1+1)) &
                                       0 <= 2*halfI1+2 &
                                       a,a4
                                         are_fiberwise_equipotent &
                                       (FALSE = TRUE implies
                                         [a4,len a4]
                                           in OddSorted) &
                                       [a4,2*halfI1+2]
                                         in EvenSorted &
                                       (FALSE = TRUE implies
                                         inversions.a4 =
                                           inversions.a1) &
                                       (FALSE <> TRUE implies
                                         inversions.a4 <
                                           inversions.a1) &
                                       (FALSE = TRUE or
                                         inversions.a4 <
                                           inversions.a1))) &
                             (not nthElem.[a3,o1] <
                                nthElem.[a3,2*halfI1]
                              implies
                                (0 <= len a3-2*halfI1 &
                                 len a3-(2*halfI1+2) <
                                   len a3-2*halfI1) &
                                (0 <= halfI1+1 &
                                 0 <= 2*halfI1+2 &
                                 2*halfI1+2 =
                                   2*(halfI1+1)) &
                                0 <= 2*halfI1+2 &
                                a,a3
                                  are_fiberwise_equipotent &
                                (sortedFlag2 = TRUE implies
                                  [a3,len a3]
                                    in OddSorted) &
                                [a3,2*halfI1+2]
                                  in EvenSorted &
                                (sortedFlag2 = TRUE implies
                                  inversions.a3 =
                                    inversions.a1) &
                                (sortedFlag2 <> TRUE implies
                                  inversions.a3 <
                                    inversions.a1) &
                                (sortedFlag2 = TRUE or
                                  inversions.a3 <
                                    inversions.a1))) &
                         (not 2*halfI1 < len a3-1 implies
                           ex d,d2 being Integer st
                             ((sortedFlag = TRUE & d = 0) or
                              (sortedFlag <> TRUE & d = 1)) &
                             ((sortedFlag2 = TRUE & d2 = 0) or
                              (sortedFlag2 <> TRUE & d2 = 1)) &
                             ((0 <= d & d2 < d) or
                              (d = d2 &
                               0 <= inversions.a1 &
                               inversions.a3 <
                                 inversions.a1)) &
                             a,a3 are_fiberwise_equipotent &
                             (sortedFlag2 = TRUE implies
                               a3 in Sorted))))) &
           (sortedFlag = TRUE implies
             a1 in Sorted &
             a,a1 are_fiberwise_equipotent)))
proof
end;
::$P+
