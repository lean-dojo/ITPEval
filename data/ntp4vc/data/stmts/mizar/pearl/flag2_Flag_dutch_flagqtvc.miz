:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/flag2_Flag_dutch_flagqtvc: the Dutch-national-flag loop
:: verification condition for partitioning a finite color sequence while
:: preserving color occurrence counts. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, INT_1, ARYTM_1, ARYTM_3, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, CARD_1, CARD_3, TARSKI, XBOOLE_0,
    SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, ZFMISC_1, MCART_1,
    MULTOP_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, RELAT_1,
    FUNCT_1, FUNCT_2, MCART_1, MULTOP_1;
  constructors NUMBERS, NAT_1, INT_1, XREAL_0, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, ZFMISC_1, MCART_1, MULTOP_1, XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, RELAT_1, FUNCT_1, FUNCT_2,
    MEMBERED, XTUPLE_0;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      d being Element of Segm 3,
      a being Function of INT,Segm 3,
      nb being Function of
        [:[:Funcs(INT,Segm 3),INT:],[:INT,Segm 3:]:],INT st
    (for z being Integer holds
      (z < 0 implies a.z = a.0) &
      (n <= z implies a.z = d)) &
    (for j,i,jm,v being Integer,
         f being Function of INT,Segm 3,
         c being Element of Segm 3 st
      jm = j-1 & v = nb.[[f,i],[jm,c]]
    holds
      (j <= i implies nb.[[f,i],[j,c]] = 0) &
      (not j <= i & f.jm = c implies
        nb.[[f,i],[j,c]] = 1 + v) &
      (not j <= i & f.jm <> c implies
        nb.[[f,i],[j,c]] = v))
  holds
    ((0 <= 0 & 0 <= 0 & 0 <= n & n <= n) &
     (for k being Integer st 0 <= k & k < 0 holds a.k = 0) &
     (for k being Integer st 0 <= k & k < 0 holds a.k = 1) &
     (for k being Integer st n <= k & k < n holds a.k = 2)) &
    (for r,i,b being Integer,
        a1 being Function of INT,Segm 3 st
      (for z being Integer holds
        (z < 0 implies a1.z = a1.0) &
        (n <= z implies a1.z = d))
    holds
      ((0 <= b & b <= i & i <= r & r <= n) &
       (for k being Integer st 0 <= k & k < b holds a1.k = 0) &
       (for k being Integer st b <= k & k < i holds a1.k = 1) &
       (for k being Integer st r <= k & k < n holds a1.k = 2) &
       (for c being Element of Segm 3 holds
         nb.[[a1,0],[n,c]] = nb.[[a,0],[n,c]]))
      implies
      ((i < r implies
        (0 <= i & i < n) &
        (a1.i = 0 implies
          (0 <= b & b < n) & (0 <= i & i < n) &
          (for a2 being Function of INT,Segm 3 st
            (for z being Integer holds
              (z < 0 implies a2.z = a2.0) &
              (n <= z implies a2.z = d))
          holds
            (a2.b = a1.i &
             a2.i = a1.b &
             (for k being Integer st k <> b & k <> i holds
               a2.k = a1.k) &
             (for k1,k2 being Integer,
                  c being Element of Segm 3 st
                k1 <= b & b < k2 & k1 <= i & i < k2
              holds nb.[[a2,k1],[k2,c]] = nb.[[a1,k1],[k2,c]]))
            implies
            (0 <= r-i & r-(i+1) < r-i) &
            (0 <= b+1 & b+1 <= i+1 & i+1 <= r & r <= n) &
            (for k being Integer st 0 <= k & k < b+1 holds
              a2.k = 0) &
            (for k being Integer st b+1 <= k & k < i+1 holds
              a2.k = 1) &
            (for k being Integer st r <= k & k < n holds
              a2.k = 2) &
            (for c being Element of Segm 3 holds
              nb.[[a2,0],[n,c]] = nb.[[a,0],[n,c]]))) &
        (a1.i = 1 implies
          (0 <= r-i & r-(i+1) < r-i) &
          (0 <= b & b <= i+1 & i+1 <= r & r <= n) &
          (for k being Integer st 0 <= k & k < b holds
            a1.k = 0) &
          (for k being Integer st b <= k & k < i+1 holds
            a1.k = 1) &
          (for k being Integer st r <= k & k < n holds
            a1.k = 2) &
          (for c being Element of Segm 3 holds
            nb.[[a1,0],[n,c]] = nb.[[a,0],[n,c]])) &
        (a1.i = 2 implies
          (0 <= r-1 & r-1 < n) & (0 <= i & i < n) &
          (for a2 being Function of INT,Segm 3 st
            (for z being Integer holds
              (z < 0 implies a2.z = a2.0) &
              (n <= z implies a2.z = d))
          holds
            (a2.(r-1) = a1.i &
             a2.i = a1.(r-1) &
             (for k being Integer st k <> r-1 & k <> i holds
               a2.k = a1.k) &
             (for k1,k2 being Integer,
                  c being Element of Segm 3 st
                k1 <= r-1 & r-1 < k2 & k1 <= i & i < k2
              holds nb.[[a2,k1],[k2,c]] = nb.[[a1,k1],[k2,c]]))
            implies
            (0 <= r-i & r-1-i < r-i) &
            (0 <= b & b <= i & i <= r-1 & r-1 <= n) &
            (for k being Integer st 0 <= k & k < b holds
              a2.k = 0) &
            (for k being Integer st b <= k & k < i holds
              a2.k = 1) &
            (for k being Integer st r-1 <= k & k < n holds
              a2.k = 2) &
            (for c being Element of Segm 3 holds
              nb.[[a2,0],[n,c]] = nb.[[a,0],[n,c]])))) &
       (not i < r implies
         (ex b1,r1 being Integer st
           (for k being Integer st 0 <= k & k < b1 holds
             a1.k = 0) &
           (for k being Integer st b1 <= k & k < r1 holds
             a1.k = 1) &
           (for k being Integer st r1 <= k & k < n holds
             a1.k = 2)) &
         (for c being Element of Segm 3 holds
           nb.[[a1,0],[n,c]] = nb.[[a,0],[n,c]]))))
proof
end;
::$P+
