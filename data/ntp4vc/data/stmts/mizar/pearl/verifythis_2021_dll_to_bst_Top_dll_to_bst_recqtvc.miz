:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_dll_to_bst_Top_dll_to_bst_recqtvc: the recursive
:: conversion of a well-formed doubly linked list segment into a balanced
:: binary search tree preserves map domains and the untouched list cells.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1, NEWTON, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, NEWTON,
    FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, NEWTON, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, NEWTON, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L,State,Map,Tree being non empty set,
      null being Element of L,
      ToMap being Function of State,Map,
      Dom being Function of Map,bool L,
      Lookup being Function of [:Map,L:],L,
      Update being Function of [:Map,[:L,L:]:],Map,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:INT,Tree:]:],Tree,
      Height being Function of Tree,INT,
      SeqAt,Cell being Function of [:L*,INT:],L,
      Pow2 being Function of INT,INT,
      Valid,Dll,IsTree being set,
      prev,next being Element of State,
      s being FinSequence of L,
      head being Element of L,
      ihead,n being Integer
  st
    (for m being Element of Map holds Dom.m is finite) &
    (for m1,m2 being Element of Map st
       Dom.m1 = Dom.m2 &
       (for x being Element of L st x in Dom.m1 holds
          Lookup.[m1,x] = Lookup.[m2,x])
     holds m1 = m2) &
    (for D being finite Subset of L,
         f being Function of D,L
     holds
       ex m being Element of Map st
         Dom.m = D &
         for x being Element of L st x in D holds
           Lookup.[m,x] = f.x) &
    (for m being Element of Map,
         x,v being Element of L
     holds
       Dom.(Update.[m,[x,v]]) = Dom.m \/ {x} &
       Lookup.[Update.[m,[x,v]],x] = v &
       (for y being Element of L st y <> x holds
          Lookup.[Update.[m,[x,v]],y] = Lookup.[m,y])) &

    (for lt,rt being Element of Tree,
         p being Integer
     holds node.[lt,[p,rt]] <> emptyT) &
    (for lt,lt2,rt,rt2 being Element of Tree,
         p,p2 being Integer st
       node.[lt,[p,rt]] = node.[lt2,[p2,rt2]]
     holds lt = lt2 & p = p2 & rt = rt2) &
    (for tr being Element of Tree holds
       tr = emptyT or
       ex lt,rt being Element of Tree,
          p being Integer st
         tr = node.[lt,[p,rt]]) &
    (for X being Subset of Tree st
       emptyT in X &
       (for lt,rt being Element of Tree,
            p being Integer st lt in X & rt in X
        holds node.[lt,[p,rt]] in X)
     holds X = Tree) &
    Height.emptyT = 0 &
    (for lt,rt being Element of Tree,
         p being Integer
     holds
       Height.(node.[lt,[p,rt]]) =
         1 + max(Height.lt,Height.rt)) &

    (for xs being FinSequence of L,
         i being Integer st 0 <= i & i < len xs
     holds SeqAt.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of L,
         i being Integer
     holds
       (i = len xs implies Cell.[xs,i] = null) &
       (i <> len xs implies Cell.[xs,i] = SeqAt.[xs,i])) &
    (for e being Integer st 0 <= e holds
       ex k being Nat st k = e & Pow2.e = 2 |^ k) &

    (for p,q being Element of Map,
         xs being FinSequence of L
     holds
       ([p,[q,xs]] in Valid iff
         for i being Integer st 0 <= i & i < len xs
         holds
           SeqAt.[xs,i] <> null &
           SeqAt.[xs,i] in Dom.p &
           SeqAt.[xs,i] in Dom.q &
           (for j being Integer st i < j & j < len xs
            holds SeqAt.[xs,i] <> SeqAt.[xs,j]))) &

    (for p,q being Element of Map,
         xs being FinSequence of L,
         hd being Element of L,
         lo,hi being Integer
     holds
       ([p,[q,[xs,[hd,[lo,hi]]]]] in Dll iff
         [p,[q,xs]] in Valid &
         0 <= lo & lo <= hi & hi <= len xs &
         hd = Cell.[xs,lo] &
         (for i being Integer st lo <= i & i < hi-1
          holds
            Lookup.[q,SeqAt.[xs,i]] = SeqAt.[xs,i+1]) &
         (for i being Integer st lo < i & i < hi
          holds
            Lookup.[p,SeqAt.[xs,i]] = SeqAt.[xs,i-1]) &
         (lo < hi implies
            Lookup.[q,SeqAt.[xs,hi-1]] = Cell.[xs,hi]) &
         (lo < hi implies
            ((lo = 0 implies
                Lookup.[p,SeqAt.[xs,lo]] = null) &
             (lo <> 0 implies
                Lookup.[p,SeqAt.[xs,lo]] =
                  SeqAt.[xs,lo-1]))))) &

    (for p,q being Element of Map,
         xs being FinSequence of L,
         root being Element of L,
         tr being Element of Tree,
         lo,hi being Integer
     holds
       ([p,[q,[xs,[root,[tr,[lo,hi]]]]]] in IsTree iff
         [p,[q,xs]] in Valid &
         0 <= lo & lo <= hi & hi <= len xs &
         ((tr = emptyT & root = null & lo = hi) or
          ex lt,rt being Element of Tree,
             pivot being Integer st
            tr = node.[lt,[pivot,rt]] &
            lo <= pivot & pivot < hi &
            root = SeqAt.[xs,pivot] &
            [p,[q,[xs,
              [Lookup.[p,root],[lt,[lo,pivot]]]]]]
                in IsTree &
            [p,[q,[xs,
              [Lookup.[q,root],[rt,[pivot+1,hi]]]]]]
                in IsTree))) &

    [ToMap.prev,[ToMap.next,
      [s,[head,[ihead,ihead+n]]]]] in Dll
  holds
    (n = 0 implies
      head = Cell.[s,ihead+n] &
      [ToMap.prev,[ToMap.next,
        [s,[null,[emptyT,[ihead,ihead+n]]]]]]
          in IsTree &
      Dom.(ToMap.prev) = Dom.(ToMap.prev) &
      Dom.(ToMap.next) = Dom.(ToMap.next) &
      (0 < n implies
        for h being Element of INT st h = Height.emptyT
        holds
          for hm1 being Element of INT st hm1 = h-1
          holds Pow2.hm1 <= n & n < Pow2.h)) &
    (n <> 0 implies
      2 <> 0 &
      (for nl being Integer st nl = n div 2 holds
        ((0 <= n & nl < n) &
         [ToMap.prev,[ToMap.next,
           [s,[head,[ihead,ihead+nl]]]]] in Dll) &
        (for next1,prev1 being Element of State,
             left1 being Element of L,
             l being Element of Tree st
           [ToMap.prev1,[ToMap.next1,
             [s,[left1,[l,[ihead,ihead+nl]]]]]]
               in IsTree &
           Dom.(ToMap.prev1) = Dom.(ToMap.prev) &
           Dom.(ToMap.next1) = Dom.(ToMap.next) &
           (for i being Integer st 0 <= i & i < ihead
            holds
              Lookup.[ToMap.prev1,SeqAt.[s,i]] =
                Lookup.[ToMap.prev,SeqAt.[s,i]]) &
           (for i being Integer st
              ihead+nl <= i & i < len s
            holds
              Lookup.[ToMap.prev1,SeqAt.[s,i]] =
                Lookup.[ToMap.prev,SeqAt.[s,i]]) &
           (for i being Integer st 0 <= i & i < ihead
            holds
              Lookup.[ToMap.next1,SeqAt.[s,i]] =
                Lookup.[ToMap.next,SeqAt.[s,i]]) &
           (for i being Integer st
              ihead+nl <= i & i < len s
            holds
              Lookup.[ToMap.next1,SeqAt.[s,i]] =
                Lookup.[ToMap.next,SeqAt.[s,i]]) &
           (0 < nl implies
              for h being Element of INT st h = Height.l
              holds
                for hm1 being Element of INT st hm1 = h-1
                holds Pow2.hm1 <= nl & nl < Pow2.h)
         holds
           Cell.[s,ihead+nl] in Dom.(ToMap.prev1) &
           (for prev2 being Element of State st
              ToMap.prev2 =
                Update.[ToMap.prev1,
                  [Cell.[s,ihead+nl],left1]]
            holds
              for o1,o2 being Integer st
                o1 = n-nl-1 & o2 = ihead+nl+1
              holds
                Cell.[s,ihead+nl] in Dom.(ToMap.next1) &
                (for o3 being Element of L st
                   o3 =
                     Lookup.[ToMap.next1,Cell.[s,ihead+nl]]
                 holds
                   ((0 <= n & o1 < n) &
                    [ToMap.prev2,[ToMap.next1,
                      [s,[o3,[o2,o2+o1]]]]] in Dll) &
                   (for next2,prev3 being Element of State,
                        temp being Element of L,
                        r being Element of Tree st
                      [ToMap.prev3,[ToMap.next2,
                        [s,[temp,[r,[o2,o2+o1]]]]]]
                          in IsTree &
                      Dom.(ToMap.prev3) = Dom.(ToMap.prev2) &
                      Dom.(ToMap.next2) = Dom.(ToMap.next1) &
                      (for i being Integer st
                         0 <= i & i < o2
                       holds
                         Lookup.[ToMap.prev3,SeqAt.[s,i]] =
                           Lookup.[ToMap.prev2,SeqAt.[s,i]]) &
                      (for i being Integer st
                         o2+o1 <= i & i < len s
                       holds
                         Lookup.[ToMap.prev3,SeqAt.[s,i]] =
                           Lookup.[ToMap.prev2,SeqAt.[s,i]]) &
                      (for i being Integer st
                         0 <= i & i < o2
                       holds
                         Lookup.[ToMap.next2,SeqAt.[s,i]] =
                           Lookup.[ToMap.next1,SeqAt.[s,i]]) &
                      (for i being Integer st
                         o2+o1 <= i & i < len s
                       holds
                         Lookup.[ToMap.next2,SeqAt.[s,i]] =
                           Lookup.[ToMap.next1,SeqAt.[s,i]]) &
                      (0 < o1 implies
                         for h being Element of INT st h = Height.r
                         holds
                           for hm1 being Element of INT st hm1 = h-1
                           holds
                             Pow2.hm1 <= o1 & o1 < Pow2.h)
                    holds
                      Cell.[s,ihead+nl] in Dom.(ToMap.next2) &
                      (for next3 being Element of State st
                         ToMap.next3 =
                           Update.[ToMap.next2,
                             [Cell.[s,ihead+nl],temp]]
                       holds
                         for o4 being Element of Tree st
                           o4 = node.[l,[ihead+nl,r]]
                         holds
                           Cell.[s,o2+o1] =
                             Cell.[s,ihead+n] &
                           [ToMap.prev3,[ToMap.next3,
                             [s,[Cell.[s,ihead+nl],
                               [o4,[ihead,ihead+n]]]]]]
                                 in IsTree &
                           Dom.(ToMap.prev3) =
                             Dom.(ToMap.prev) &
                           Dom.(ToMap.next3) =
                             Dom.(ToMap.next) &
                           (for i being Integer st
                              0 <= i & i < ihead
                            holds
                              Lookup.[ToMap.prev3,
                                SeqAt.[s,i]] =
                              Lookup.[ToMap.prev,
                                SeqAt.[s,i]]) &
                           (for i being Integer st
                              ihead+n <= i & i < len s
                            holds
                              Lookup.[ToMap.prev3,
                                SeqAt.[s,i]] =
                              Lookup.[ToMap.prev,
                                SeqAt.[s,i]]) &
                           (for i being Integer st
                              0 <= i & i < ihead
                            holds
                              Lookup.[ToMap.next3,
                                SeqAt.[s,i]] =
                              Lookup.[ToMap.next,
                                SeqAt.[s,i]]) &
                           (for i being Integer st
                              ihead+n <= i & i < len s
                            holds
                              Lookup.[ToMap.next3,
                                SeqAt.[s,i]] =
                              Lookup.[ToMap.next,
                                SeqAt.[s,i]]) &
                           (0 < n implies
                              for h being Element of INT st
                                h = Height.o4
                              holds
                                for hm1 being Element of INT st
                                  hm1 = h-1
                                holds
                                  Pow2.hm1 <= n &
                                  n < Pow2.h))))))))
proof
end;
::$P+
