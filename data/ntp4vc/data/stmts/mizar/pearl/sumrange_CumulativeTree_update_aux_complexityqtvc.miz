:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sumrange_CumulativeTree_update_aux_complexityqtvc: the verification
:: condition for a point update of an integer cumulative-sum tree, including
:: preservation of its interval-sum invariant and a depth-based credit bound.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Tree being non empty set,
      leaf being Function of [:INT,[:INT,INT:]:],Tree,
      node being Function of
        [:[:INT,[:INT,INT:]:],[:Tree,Tree:]:],Tree,
      Low,High,ISum being Function of [:INT,[:INT,INT:]:],INT,
      IndexOf being Function of Tree,[:INT,[:INT,INT:]:],
      Depth being Function of Tree,INT,
      Child being Subset of [:Tree,Tree:],
      nthInt being Function of [:INT*,INT:],INT,
      setInt being Function of [:INT*,[:INT,INT:]:],INT*,
      rangeSum being Function of [:INT*,[:INT,INT:]:],INT,
      TreeFor being Subset of
        [:Tree,[:INT*,[:INT,INT:]:]:],
      t being Element of Tree,
      a being FinSequence of INT,
      i,v,c being Integer
  st
    (for lo,hi,s being Integer holds
       Low.[lo,[hi,s]] = lo &
       High.[lo,[hi,s]] = hi &
       ISum.[lo,[hi,s]] = s) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         l,r being Element of Tree
     holds
       leaf.ind <> node.[ind,[l,r]]) &
    (for ind,ind2 being Element of [:INT,[:INT,INT:]:] st
       leaf.ind = leaf.ind2
     holds
       ind = ind2) &
    (for ind,ind2 being Element of [:INT,[:INT,INT:]:],
         l,l2,r,r2 being Element of Tree st
       node.[ind,[l,r]] = node.[ind2,[l2,r2]]
     holds
       ind = ind2 & l = l2 & r = r2) &
    (for u being Element of Tree holds
       (ex ind being Element of [:INT,[:INT,INT:]:] st
          u = leaf.ind) or
       ex ind being Element of [:INT,[:INT,INT:]:],
          l,r being Element of Tree st
         u = node.[ind,[l,r]]) &
    (for X being Subset of Tree st
       (for ind being Element of [:INT,[:INT,INT:]:]
        holds leaf.ind in X) &
       (for ind being Element of [:INT,[:INT,INT:]:],
            l,r being Element of Tree st
          l in X & r in X
        holds node.[ind,[l,r]] in X)
     holds
       X = Tree) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         l,r being Element of Tree
     holds
       IndexOf.(leaf.ind) = ind &
       IndexOf.(node.[ind,[l,r]]) = ind) &
    (for ind being Element of [:INT,[:INT,INT:]:]
     holds
       Depth.(leaf.ind) = 1) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         l,r being Element of Tree
     holds
       Depth.(node.[ind,[l,r]]) =
         1 + max(Depth.l,Depth.r)) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         u being Element of Tree
     holds
       not [u,leaf.ind] in Child) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         l,r,u being Element of Tree
     holds
       ([u,node.[ind,[l,r]]] in Child iff
          u = l or u = r)) &
    (for xs being FinSequence of INT, q being Integer holds
       (q < 0 & len xs = 0 implies nthInt.[xs,q] = 0) &
       (q < 0 & 0 < len xs implies nthInt.[xs,q] = xs.1) &
       (0 <= q & q < len xs implies
          nthInt.[xs,q] = xs.(q+1)) &
       (len xs <= q implies nthInt.[xs,q] = 0)) &
    (for xs being FinSequence of INT, q,x being Integer holds
       len (setInt.[xs,[q,x]]) = len xs &
       ((q <= 0 & 0 < len xs) implies
          for k being Integer holds
            (k <= 0 implies
               nthInt.[setInt.[xs,[q,x]],k] = x) &
            (0 < k implies
               nthInt.[setInt.[xs,[q,x]],k] =
                 nthInt.[xs,k])) &
       ((0 < q & q < len xs) implies
          for k being Integer holds
            (k = q implies
               nthInt.[setInt.[xs,[q,x]],k] = x) &
            (k <> q implies
               nthInt.[setInt.[xs,[q,x]],k] =
                 nthInt.[xs,k])) &
       ((len xs = 0 or len xs <= q) implies
          setInt.[xs,[q,x]] = xs)) &
    (for xs being FinSequence of INT, lo,hi being Integer st
       0 <= lo & lo <= hi & hi <= len xs
     holds
       (hi <= lo implies
          rangeSum.[xs,[lo,hi]] = 0) &
       (not hi <= lo implies
          for x being Integer st x = nthInt.[xs,lo] holds
            for rest being Integer st
              rest = rangeSum.[xs,[lo+1,hi]]
            holds
              rangeSum.[xs,[lo,hi]] = x + rest)) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         xs being FinSequence of INT,
         lo,hi being Integer
     holds
       ([leaf.ind,[xs,[lo,hi]]] in TreeFor iff
          Low.ind = lo &
          High.ind = hi &
          0 <= lo & lo < hi & hi <= len xs &
          ISum.ind = rangeSum.[xs,[lo,hi]] &
          hi = lo + 1)) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         l,r being Element of Tree,
         xs being FinSequence of INT,
         lo,hi being Integer
     holds
       ([node.[ind,[l,r]],[xs,[lo,hi]]] in TreeFor iff
          Low.ind = lo &
          High.ind = hi &
          0 <= lo & lo < hi & hi <= len xs &
          ISum.ind = rangeSum.[xs,[lo,hi]] &
          lo = Low.(IndexOf.l) &
          hi = High.(IndexOf.r) &
          High.(IndexOf.l) = Low.(IndexOf.r) &
          lo < High.(IndexOf.l) &
          High.(IndexOf.l) < hi &
          High.(IndexOf.l) = (lo + hi) div 2 &
          [l,[xs,[lo,High.(IndexOf.l)]]] in TreeFor &
          [r,[xs,[High.(IndexOf.l),hi]]] in TreeFor)) &
    [t,[a,[Low.(IndexOf.t),High.(IndexOf.t)]]] in TreeFor &
    Low.(IndexOf.t) <= i &
    i < High.(IndexOf.t)
  holds
    for ai being Integer st ai = nthInt.[a,i] holds
    (for ind being Element of [:INT,[:INT,INT:]:] st
       t = leaf.ind
     holds
       c + 1 - c <= Depth.t &
       v - ISum.ind = v - ai &
       Low.(IndexOf.(leaf.[Low.ind,[High.ind,v]])) =
         Low.(IndexOf.t) &
       High.(IndexOf.(leaf.[Low.ind,[High.ind,v]])) =
         High.(IndexOf.t) &
       [leaf.[Low.ind,[High.ind,v]],
         [setInt.[a,[i,v]],
           [Low.(IndexOf.(leaf.[Low.ind,[High.ind,v]])),
            High.(IndexOf.(leaf.[Low.ind,[High.ind,v]]))]]]
         in TreeFor) &
    (for ind being Element of [:INT,[:INT,INT:]:],
         l,r being Element of Tree st
       t = node.[ind,[l,r]]
     holds
       (i < High.(IndexOf.l) implies
          [l,t] in Child &
          [l,[a,[Low.(IndexOf.l),High.(IndexOf.l)]]]
            in TreeFor &
          Low.(IndexOf.l) <= i &
          i < High.(IndexOf.l) &
          (for c1 being Integer,
               l1 being Element of Tree st
             c1 - (c + 1) <= Depth.l &
             Low.(IndexOf.l1) = Low.(IndexOf.l) &
             High.(IndexOf.l1) = High.(IndexOf.l) &
             [l1,[setInt.[a,[i,v]],
               [Low.(IndexOf.l1),High.(IndexOf.l1)]]]
               in TreeFor
           holds
             c1 - c <= Depth.t &
             Low.(IndexOf.
               (node.
                 [[Low.ind,
                   [High.ind,
                    ISum.ind + (v - ai)]],
                  [l1,r]])) =
               Low.(IndexOf.t) &
             High.(IndexOf.
               (node.
                 [[Low.ind,
                   [High.ind,
                    ISum.ind + (v - ai)]],
                  [l1,r]])) =
               High.(IndexOf.t) &
             [node.
               [[Low.ind,
                 [High.ind,
                  ISum.ind + (v - ai)]],
                [l1,r]],
              [setInt.[a,[i,v]],
               [Low.(IndexOf.
                 (node.
                   [[Low.ind,
                     [High.ind,
                      ISum.ind + (v - ai)]],
                    [l1,r]])),
                High.(IndexOf.
                 (node.
                   [[Low.ind,
                     [High.ind,
                      ISum.ind + (v - ai)]],
                    [l1,r]]))]]]
               in TreeFor)) &
       (not i < High.(IndexOf.l) implies
          [r,t] in Child &
          [r,[a,[Low.(IndexOf.r),High.(IndexOf.r)]]]
            in TreeFor &
          Low.(IndexOf.r) <= i &
          i < High.(IndexOf.r) &
          (for c1 being Integer,
               r1 being Element of Tree st
             c1 - (c + 1) <= Depth.r &
             Low.(IndexOf.r1) = Low.(IndexOf.r) &
             High.(IndexOf.r1) = High.(IndexOf.r) &
             [r1,[setInt.[a,[i,v]],
               [Low.(IndexOf.r1),High.(IndexOf.r1)]]]
               in TreeFor
           holds
             c1 - c <= Depth.t &
             Low.(IndexOf.
               (node.
                 [[Low.ind,
                   [High.ind,
                    ISum.ind + (v - ai)]],
                  [l,r1]])) =
               Low.(IndexOf.t) &
             High.(IndexOf.
               (node.
                 [[Low.ind,
                   [High.ind,
                    ISum.ind + (v - ai)]],
                  [l,r1]])) =
               High.(IndexOf.t) &
             [node.
               [[Low.ind,
                 [High.ind,
                  ISum.ind + (v - ai)]],
                [l,r1]],
              [setInt.[a,[i,v]],
               [Low.(IndexOf.
                 (node.
                   [[Low.ind,
                     [High.ind,
                      ISum.ind + (v - ai)]],
                    [l,r1]])),
                High.(IndexOf.
                 (node.
                   [[Low.ind,
                     [High.ind,
                      ISum.ind + (v - ai)]],
                    [l,r1]]))]]]
               in TreeFor)))
proof
end;
::$P+
