:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_shearsort_Quicksort_quick_recqtvc: the recursive
:: quicksort verification condition tracks the pivot partition loop,
:: conditional swaps, termination measures, recursive sortedness, and
:: subarray permutation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nthElem being Function of [:INT*,INT:],INT,
      SortedSub being Subset of [:INT*,[:INT,INT:]:],
      PermSubPrime being Subset of
        [:INT*,[:INT*,[:INT,INT:]:]:],
      Exchange being Subset of
        [:INT*,[:INT*,[:INT,INT:]:]:],
      l,r being Integer,
      a being FinSequence of INT
  st
    (for s being FinSequence of INT, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = 0) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = 0)) &
    (for s being FinSequence of INT, lo,hi being Integer holds
       ([s,[lo,hi]] in SortedSub iff
         for i1,i2 being Integer st
           lo <= i1 & i1 <= i2 & i2 < hi
         holds nthElem.[s,i1] <= nthElem.[s,i2])) &
    (for s,t being FinSequence of INT, lo,hi being Integer holds
       ([s,[t,[lo,hi]]] in PermSubPrime iff
         len s = len t &
         (for q being Integer st
            0 <= q & q < min(max(lo,0),len s)
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for q being Integer st
            max(hi,0) <= q & q < len s
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for x being Integer holds
           card {q where q is Integer :
             max(lo,0) <= q &
             q < min(max(hi,0),len s) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(lo,0) <= q &
             q < min(max(hi,0),len t) &
             nthElem.[t,q] = x}))) &
    (for s,t being FinSequence of INT, i,j being Integer holds
       ([s,[t,[i,j]]] in Exchange iff
         nthElem.[t,i] = nthElem.[s,j] &
         nthElem.[t,j] = nthElem.[s,i] &
         (for k being Integer st
            0 <= k & k < len s & k <> i & k <> j
          holds nthElem.[t,k] = nthElem.[s,k]))) &
    0 <= l &
    l <= r &
    r <= len a
  holds
    (l + 1 < r implies
      (0 <= l & l < len a) &
      (for v,o1,o2 being Integer st
         v = nthElem.[a,l] & o1 = r-1 & o2 = l+1
       holds
         (o2 <= o1+1 implies
           ((nthElem.[a,l] = v & l <= l & l < o2) &
            (for j being Integer st l < j & j <= l
             holds nthElem.[a,j] < v) &
            (for j being Integer st l < j & j < o2
             holds v <= nthElem.[a,j]) &
            [a,[a,[l,r]]] in PermSubPrime)) &
           (for m being Integer,
                a1 being FinSequence of INT st
              len a1 = len a
            holds
              (for i being Integer st
                 (o2 <= i & i <= o1) &
                 (nthElem.[a1,l] = v & l <= m & m < i) &
                 (for j being Integer st l < j & j <= m
                  holds nthElem.[a1,j] < v) &
                 (for j being Integer st m < j & j < i
                  holds v <= nthElem.[a1,j]) &
                 [a,[a1,[l,r]]] in PermSubPrime
               holds
                 (0 <= i & i < len a1) &
                 ((nthElem.[a1,i] < v implies
                   ((0 <= i & i < len a1) &
                    0 <= m+1 & m+1 < len a1) &
                   (for a2 being FinSequence of INT st
                      len a2 = len a1 &
                      [a1,[a2,[i,m+1]]] in Exchange
                    holds
                      (nthElem.[a2,l] = v &
                       l <= m+1 & m+1 < i+1) &
                      (for j being Integer st
                         l < j & j <= m+1
                       holds nthElem.[a2,j] < v) &
                      (for j being Integer st
                         m+1 < j & j < i+1
                       holds v <= nthElem.[a2,j]) &
                      [a,[a2,[l,r]]] in PermSubPrime)) &
                  ((not nthElem.[a1,i] < v) implies
                   (nthElem.[a1,l] = v &
                    l <= m & m < i+1) &
                   (for j being Integer st l < j & j <= m
                    holds nthElem.[a1,j] < v) &
                   (for j being Integer st m < j & j < i+1
                    holds v <= nthElem.[a1,j]) &
                   [a,[a1,[l,r]]] in PermSubPrime))) &
              (((nthElem.[a1,l] = v &
                 l <= m & m < o1+1) &
                (for j being Integer st l < j & j <= m
                 holds nthElem.[a1,j] < v) &
                (for j being Integer st m < j & j < o1+1
                 holds v <= nthElem.[a1,j]) &
                [a,[a1,[l,r]]] in PermSubPrime)
               implies
                ((0 <= l & l < len a1) &
                 0 <= m & m < len a1) &
                (for a2 being FinSequence of INT st
                   len a2 = len a1 &
                   [a1,[a2,[l,m]]] in Exchange
                 holds
                   ((0 <= r-l & m-l < r-l) &
                    0 <= l & l <= m & m <= len a2) &
                   (for a3 being FinSequence of INT st
                      len a3 = len a2 &
                      [a3,[l,m]] in SortedSub &
                      [a2,[a3,[l,m]]] in PermSubPrime
                    holds
                      (for o3 being Integer st o3 = m+1
                       holds
                         ((0 <= r-l & r-o3 < r-l) &
                          0 <= o3 & o3 <= r &
                          r <= len a3) &
                         (for a4 being FinSequence of INT st
                            len a4 = len a3 &
                            [a4,[o3,r]] in SortedSub &
                            [a3,[a4,[o3,r]]] in PermSubPrime
                          holds
                            [a4,[l,r]] in SortedSub &
                            [a,[a4,[l,r]]] in
                              PermSubPrime)))))) &
         (o1+1 < o2 implies
           (0 <= l & l < len a) &
           (for a1 being FinSequence of INT st
              len a1 = len a &
              [a,[a1,[l,l]]] in Exchange
            holds
              ((0 <= r-l & l-l < r-l) &
               0 <= l & l <= l & l <= len a1) &
              (for a2 being FinSequence of INT st
                 len a2 = len a1 &
                 [a2,[l,l]] in SortedSub &
                 [a1,[a2,[l,l]]] in PermSubPrime
               holds
                 (for o3 being Integer st o3 = l+1
                  holds
                    ((0 <= r-l & r-o3 < r-l) &
                     0 <= o3 & o3 <= r & r <= len a2) &
                    (for a3 being FinSequence of INT st
                       len a3 = len a2 &
                       [a3,[o3,r]] in SortedSub &
                       [a2,[a3,[o3,r]]] in PermSubPrime
                     holds
                       [a3,[l,r]] in SortedSub &
                       [a,[a3,[l,r]]] in
                         PermSubPrime)))))))
    &
    ((not l + 1 < r) implies
      [a,[l,r]] in SortedSub &
      [a,[a,[l,r]]] in PermSubPrime)
proof
end;
::$P+
