:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/flag2_Flag_swapqtvc: swapping two valid positions in a finite
:: three-color sequence preserves all other entries and every color's
:: occurrence count on intervals containing both positions. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, INT_1, ARYTM_1, ARYTM_3, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, CARD_1, CARD_3, TARSKI, XBOOLE_0,
    SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, FUNCT_4, FUNCT_7,
    ZFMISC_1, MCART_1, MULTOP_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1,
    ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1,
    RELAT_1, FUNCT_1, FUNCT_2, FUNCT_4, FUNCT_7, MCART_1,
    MULTOP_1;
  constructors NUMBERS, NAT_1, INT_1, XREAL_0, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCT_4, FUNCT_7, ZFMISC_1, MCART_1,
    MULTOP_1, XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_4, FUNCT_7, MEMBERED, XTUPLE_0;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      d being Element of Segm 3,
      i,j being Integer,
      a being Function of INT,Segm 3,
      nb being Function of
        [:[:Funcs(INT,Segm 3),INT:],[:INT,Segm 3:]:],INT st
    (for z being Integer holds
      (z < 0 implies a.z = a.0) &
      (n <= z implies a.z = d)) &
    (for q,p,qm,v being Integer,
         f being Function of INT,Segm 3,
         c being Element of Segm 3 st
      qm = q-1 & v = nb.[[f,p],[qm,c]]
    holds
      (q <= p implies nb.[[f,p],[q,c]] = 0) &
      (not q <= p & f.qm = c implies
        nb.[[f,p],[q,c]] = 1 + v) &
      (not q <= p & f.qm <> c implies
        nb.[[f,p],[q,c]] = v)) &
    0 <= i & i < n & 0 <= j & j < n
  holds
    0 <= i & i < n &
    (for ai being Element of Segm 3 st ai = a.i holds
      (0 <= j & j < n) &
      (for aj being Element of Segm 3 st aj = a.j holds
        (0 <= i & i < n) &
        (for a1 being Function of INT,Segm 3 st
          (for z being Integer holds
            (z < 0 implies a1.z = a1.0) &
            (n <= z implies a1.z = d) &
            (0 <= z & z < n implies
              (z = i implies a1.z = aj) &
              (z <> i implies a1.z = a.z)))
        holds
          n = n implies
          (a1 = a+*(i,aj) implies
            (0 <= j & j < n) &
            (for a2 being Function of INT,Segm 3 st
              (for z being Integer holds
                (z < 0 implies a2.z = a2.0) &
                (n <= z implies a2.z = d) &
                (0 <= z & z < n implies
                  (z = j implies a2.z = ai) &
                  (z <> j implies a2.z = a1.z)))
            holds
              n = n implies
              (a2 = a1+*(j,ai) implies
                a2.i = a.j &
                a2.j = a.i &
                (for k being Integer st k <> i & k <> j
                  holds a2.k = a.k) &
                (for k1,k2 being Integer,
                     c being Element of Segm 3 st
                  k1 <= i & i < k2 & k1 <= j & j < k2
                holds
                  nb.[[a2,k1],[k2,c]] =
                    nb.[[a,k1],[k2,c]])))))))
proof
end;
::$P+
