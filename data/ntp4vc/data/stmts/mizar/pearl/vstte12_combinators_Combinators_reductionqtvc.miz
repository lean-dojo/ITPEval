:: Statement-only formalization of NTP4VC corpus artifact
:: pearl/vstte12_combinators_Combinators_reductionqtvc: the verification
:: condition for call-by-value reduction of the S and K combinators in
:: evaluation contexts. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      FUNCT_2, BINOP_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, RELAT_1,
      FUNCT_1, RELSET_1, FUNCT_2, BINOP_1;
 constructors RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, XTUPLE_0, BINOP_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      BINOP_1;
 requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for T,C being non empty set,
      sComb,kComb being Element of T,
      app being BinOp of T,
      hole being Element of C,
      left being Function of [:C,T:],C,
      right being Function of [:T,C:],C,
      Val being Subset of T,
      Ctx being Subset of C,
      sub being Function of [:C,T:],T,
      subc being BinOp of C,
      Red,RTC being Relation of T st
    sComb <> kComb &
    not sComb in rng app &
    not kComb in rng app &
    app is one-to-one &
    (for x being Element of T holds
      x = sComb or x = kComb or
      ex x1,x2 being Element of T st x = app.(x1,x2)) &
    (for A being Subset of T st
      sComb in A & kComb in A &
      (for x1,x2 being Element of T st x1 in A & x2 in A holds
        app.(x1,x2) in A)
    holds A = T) &
    not hole in rng left &
    not hole in rng right &
    rng left misses rng right &
    left is one-to-one &
    right is one-to-one &
    (for c being Element of C holds
      c = hole or
      (ex c1 being Element of C, x being Element of T st
        c = left.[c1,x]) or
      ex v being Element of T, c1 being Element of C st
        c = right.[v,c1]) &
    (for D being Subset of C st
      hole in D &
      (for c1 being Element of C, x being Element of T st c1 in D holds
        left.[c1,x] in D) &
      (for v being Element of T, c1 being Element of C st c1 in D holds
        right.[v,c1] in D)
    holds D = C) &
    sComb in Val &
    kComb in Val &
    (for x,y being Element of T holds
      (app.(x,y) in Val iff
        ((x = sComb or x = kComb) & y in Val) or
        (ex v being Element of T st
          x = app.(sComb,v) & v in Val & y in Val))) &
    hole in Ctx &
    (for c being Element of C, x being Element of T holds
      (left.[c,x] in Ctx iff c in Ctx)) &
    (for v being Element of T, c being Element of C holds
      (right.[v,c] in Ctx iff v in Val & c in Ctx)) &
    (for t being Element of T holds sub.[hole,t] = t) &
    (for c being Element of C, t2,t being Element of T holds
      sub.[left.[c,t2],t] = app.(sub.[c,t],t2)) &
    (for v,t being Element of T, c being Element of C holds
      sub.[right.[v,c],t] = app.(v,sub.[c,t])) &
    (for c being Element of C holds subc.(hole,c) = c) &
    (for c1 being Element of C, t2 being Element of T,
         c being Element of C holds
      subc.(left.[c1,t2],c) = left.[subc.(c1,c),t2]) &
    (for v being Element of T, c1,c being Element of C holds
      subc.(right.[v,c1],c) = right.[v,subc.(c1,c)]) &
    (for x,y being Element of T holds
      ([x,y] in Red iff
        (ex c being Element of C, v1,v2 being Element of T st
          c in Ctx & v1 in Val & v2 in Val &
          x = sub.[c,app.(app.(kComb,v1),v2)] &
          y = sub.[c,v1]) or
        (ex c being Element of C, v1,v2,v3 being Element of T st
          c in Ctx & v1 in Val & v2 in Val & v3 in Val &
          x = sub.[c,app.(app.(app.(sComb,v1),v2),v3)] &
          y = sub.[c,app.(app.(v1,v3),app.(v2,v3))]))) &
    (for x being Element of T holds [x,x] in RTC) &
    (for x,y,z being Element of T st [x,y] in RTC & [y,z] in Red holds
      [x,z] in RTC) &
    (for R being Relation of T st
      (for x being Element of T holds [x,x] in R) &
      (for x,y,z being Element of T st [x,y] in R & [y,z] in Red holds
        [x,z] in R)
    holds RTC c= R)
  holds
    for c being Element of C, t being Element of T st c in Ctx holds
      (t = sComb &
        [sub.[c,t],sub.[c,sComb]] in RTC & sComb in Val) or
      (t = kComb &
        [sub.[c,t],sub.[c,kComb]] in RTC & kComb in Val) or
      ex t1,t2 being Element of T st
        t = app.(t1,t2) &
        ((c in Ctx & left.[hole,t2] in Ctx implies
            subc.(c,left.[hole,t2]) in Ctx) implies
          subc.(c,left.[hole,t2]) in Ctx &
          for v1 being Element of T st
            [sub.[subc.(c,left.[hole,t2]),t1],
             sub.[subc.(c,left.[hole,t2]),v1]] in RTC &
            v1 in Val
          holds
            ((c in Ctx & right.[v1,hole] in Ctx implies
                subc.(c,right.[v1,hole]) in Ctx) implies
              subc.(c,right.[v1,hole]) in Ctx &
              for v2 being Element of T st
                [sub.[subc.(c,right.[v1,hole]),t2],
                 sub.[subc.(c,right.[v1,hole]),v2]] in RTC &
                v2 in Val
              holds
                (v1 = kComb &
                  [sub.[c,t],sub.[c,app.(v1,v2)]] in RTC &
                  app.(v1,v2) in Val) or
                (v1 = sComb &
                  [sub.[c,t],sub.[c,app.(v1,v2)]] in RTC &
                  app.(v1,v2) in Val) or
                (ex u being Element of T st
                  v1 = app.(sComb,u) &
                  [sub.[c,t],sub.[c,app.(v1,v2)]] in RTC &
                  app.(v1,v2) in Val) or
                (ex v3 being Element of T st
                  v1 = app.(kComb,v3) &
                  [sub.[c,t],sub.[c,v3]] in RTC &
                  v3 in Val) or
                ex v3,v4 being Element of T st
                  v1 = app.(app.(sComb,v3),v4) &
                  c in Ctx &
                  for result being Element of T st
                    [sub.[c,app.(app.(v3,v2),app.(v4,v2))],
                     sub.[c,result]] in RTC &
                    result in Val
                  holds
                    [sub.[c,t],sub.[c,result]] in RTC &
                    result in Val))
proof
end;
::$P+
