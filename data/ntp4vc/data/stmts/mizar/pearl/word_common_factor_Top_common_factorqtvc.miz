:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/word_common_factor_Top_common_factorqtvc: the verification condition
:: for recursively showing that two commuting finite words are nonnegative
:: powers of one common word. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, RFINSEQ, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    RFINSEQ;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, RFINSEQ;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for C being non empty set,
      Power being Function of [:C*,INT:],C*,
      a,b being FinSequence of C
  st
    (for n being Integer,
         w being FinSequence of C st 0 <= n
     holds
       (n = 0 implies Power.[w,n] = <*>C) &
       (n <> 0 implies
          Power.[w,n] = w ^ Power.[w,n-1])) &
    a ^ b = b ^ a
  holds
    (len a <> 0 implies
      (len b <> 0 implies
        ((len a <= len b implies
            (0 <= len a & len a <= len b) &
            (ex c being FinSequence of C st
               c = b/^len a &
               b = a ^ c &
               (b = a ^ c implies
                 (0 <= len b & len c < len b) &
                 a ^ c = c ^ a))) &
         (not len a <= len b implies
            ((0 <= len a & len b < len a) or
             (len a = len b & 0 <= len b & len a < len b)) &
            b ^ a = a ^ b)))) &
    (for w being FinSequence of C,
         ka,kb being Integer holds
       (((len a = 0 &
            w = b & ka = 0 & kb = 1) or
          (len a <> 0 & len b = 0 &
            w = a & ka = 1 & kb = 0) or
          (len a <> 0 & len b <> 0 & len a <= len b &
            (ex c being FinSequence of C st
               c = b/^len a &
               b = a ^ c &
               (ex kb1 being Integer st
                  ((0 <= ka & a = Power.[w,ka]) &
                   0 <= kb1 & c = Power.[w,kb1]) &
                  kb = ka + kb1))) or
          (len a <> 0 & len b <> 0 & not len a <= len b &
            (0 <= kb & b = Power.[w,kb]) &
            0 <= ka & a = Power.[w,ka]))
        implies
          (0 <= ka & a = Power.[w,ka]) &
          0 <= kb & b = Power.[w,kb]))
proof
end;
::$P+
