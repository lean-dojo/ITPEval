:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/equality_up_to_spaces_Top_compare_up_to_spacesqtvc: the comparison
:: loop verification condition for equality after recursively removing space
:: characters from two finite character sequences. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for C being non empty set,
      space being Element of C,
      eq being Function of [:C,C:],BOOLEAN,
      nthChar being Function of [:C*,INT:],C,
      dropSeq being Function of [:C*,INT:],C*,
      removeSpaces being Function of C*,C*,
      x,y being FinSequence of C
  st
    (for a,b being Element of C holds
       (eq.[a,b] = TRUE iff a = b)) &
    (for s being FinSequence of C,
         i being Integer st 0 <= i & i < len s
     holds
       nthChar.[s,i] = s.(i+1)) &
    (for s being FinSequence of C,
         i being Integer st 0 <= i & i <= len s
     holds
       len (dropSeq.[s,i]) = len s - i &
       (for k being Integer st 0 <= k & k < len s - i
        holds
          (dropSeq.[s,i]).(k+1) = s.(i+k+1))) &
    (for s being FinSequence of C holds
       (len s = 0 implies removeSpaces.s = s) &
       (len s <> 0 & eq.[nthChar.[s,0],space] = TRUE implies
          removeSpaces.s = removeSpaces.(dropSeq.[s,1])) &
       (len s <> 0 & eq.[nthChar.[s,0],space] <> TRUE implies
          removeSpaces.s =
            <*nthChar.[s,0]*> ^ removeSpaces.(dropSeq.[s,1])))
  holds
    (0 <= 0 & 0 <= len x) &
    (0 <= 0 & 0 <= len y) &
    (removeSpaces.x = removeSpaces.y iff
      removeSpaces.(dropSeq.[x,0]) =
        removeSpaces.(dropSeq.[y,0])) &
    (for j,i being Integer st
       (0 <= i & i <= len x) &
       (0 <= j & j <= len y) &
       (removeSpaces.x = removeSpaces.y iff
        removeSpaces.(dropSeq.[x,i]) =
          removeSpaces.(dropSeq.[y,j]))
     holds
       for o1 being Element of BOOLEAN st
         (i < len x & o1 = TRUE) or
         (not i < len x & j < len y & o1 = TRUE) or
         (not i < len x & not j < len y & o1 = FALSE)
       holds
         (o1 = TRUE &
           (for o2 being Element of BOOLEAN st
              (i < len x &
               o2 = eq.[nthChar.[x,i],space] &
               (o2 = TRUE iff nthChar.[x,i] = space)) or
              (not i < len x & o2 = FALSE)
            holds
              (o2 = TRUE &
               (0 <= len x - i + len y - j &
                len x - (i+1) + len y - j <
                  len x - i + len y - j) &
               (0 <= i+1 & i+1 <= len x) &
               (0 <= j & j <= len y) &
               (removeSpaces.x = removeSpaces.y iff
                removeSpaces.(dropSeq.[x,i+1]) =
                  removeSpaces.(dropSeq.[y,j]))) or
              (o2 = FALSE &
               (for o3 being Element of BOOLEAN st
                  (j < len y &
                   o3 = eq.[nthChar.[y,j],space] &
                   (o3 = TRUE iff nthChar.[y,j] = space)) or
                  (not j < len y & o3 = FALSE)
                holds
                  (o3 = TRUE &
                   (0 <= len x - i + len y - j &
                    len x - i + len y - (j+1) <
                      len x - i + len y - j) &
                   (0 <= i & i <= len x) &
                   (0 <= j+1 & j+1 <= len y) &
                   (removeSpaces.x = removeSpaces.y iff
                    removeSpaces.(dropSeq.[x,i]) =
                      removeSpaces.(dropSeq.[y,j+1]))) or
                  (o3 = FALSE &
                   (for o4 being Element of BOOLEAN st
                      (i = len x & o4 = TRUE) or
                      (i <> len x & j = len y & o4 = TRUE) or
                      (i <> len x & j <> len y & o4 = FALSE)
                    holds
                      (o4 = TRUE &
                       not removeSpaces.x = removeSpaces.y) or
                      (o4 = FALSE &
                       ((eq.[nthChar.[x,i],nthChar.[y,j]] = TRUE iff
                           nthChar.[x,i] = nthChar.[y,j]) implies
                         (eq.[nthChar.[x,i],nthChar.[y,j]] = FALSE &
                          not removeSpaces.x = removeSpaces.y) or
                         (eq.[nthChar.[x,i],nthChar.[y,j]] = TRUE &
                          (0 <= len x - i + len y - j &
                           len x - (i+1) + len y - (j+1) <
                             len x - i + len y - j) &
                          (0 <= i+1 & i+1 <= len x) &
                          (0 <= j+1 & j+1 <= len y) &
                          (removeSpaces.x = removeSpaces.y iff
                           removeSpaces.(dropSeq.[x,i+1]) =
                             removeSpaces.(dropSeq.[y,j+1])))))))))) or
         (o1 = FALSE &
          removeSpaces.x = removeSpaces.y)))
proof
end;
::$P+
