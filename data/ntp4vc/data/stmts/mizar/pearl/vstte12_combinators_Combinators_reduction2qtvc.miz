:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/vstte12_combinators_Combinators_reduction2qtvc: the VSTTE 2012
:: call-by-value reduction verification condition for S-K combinator terms
:: containing only K, using evaluation contexts and reflexive-transitive
:: reduction. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      ZFMISC_1, MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
 constructors ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, MCART_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
 requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for Term,Context being non empty set,
      s,k being Element of Term,
      app being Function of [:Term,Term:],Term,
      hole being Element of Context,
      left being Function of [:Context,Term:],Context,
      right being Function of [:Term,Context:],Context,
  Values,OnlyK being Subset of Term,
  ValidContexts being Subset of Context,
      subst being Function of [:Context,Term:],Term,
      substC being Function of [:Context,Context:],Context,
      Red,RTC being Relation of Term,Term,
      t being Element of Term,
      c being Element of Context
  st
    s <> k &
    (for x1,x2,y1,y2 being Element of Term st
       app.[x1,x2] = app.[y1,y2]
     holds x1 = y1 & x2 = y2) &
    (for x,y being Element of Term holds
       s <> app.[x,y] & k <> app.[x,y]) &
    (for x being Element of Term holds
       x = s or x = k or
       ex x1,x2 being Element of Term st x = app.[x1,x2]) &
    (for X being Subset of Term st
       s in X & k in X &
       (for x,y being Element of Term st x in X & y in X
        holds app.[x,y] in X)
     holds X = Term) &
    (for c1,c2 being Element of Context,
         x1,x2 being Element of Term st
       left.[c1,x1] = left.[c2,x2]
     holds c1 = c2 & x1 = x2) &
    (for x1,x2 being Element of Term,
         c1,c2 being Element of Context st
       right.[x1,c1] = right.[x2,c2]
     holds x1 = x2 & c1 = c2) &
    (for c1,c2 being Element of Context,
         x1,x2 being Element of Term
     holds left.[c1,x1] <> right.[x2,c2]) &
    (for c1 being Element of Context, x1 being Element of Term
     holds hole <> left.[c1,x1]) &
    (for x1 being Element of Term, c1 being Element of Context
     holds hole <> right.[x1,c1]) &
    (for c1 being Element of Context holds
       c1 = hole or
       (ex c2 being Element of Context, x being Element of Term st
          c1 = left.[c2,x]) or
       ex x being Element of Term, c2 being Element of Context st
          c1 = right.[x,c2]) &
    (for C being Subset of Context st
       hole in C &
       (for c1 being Element of Context, x being Element of Term
          st c1 in C holds left.[c1,x] in C) &
       (for x being Element of Term, c1 being Element of Context
          st c1 in C holds right.[x,c1] in C)
     holds C = Context) &
    s in Values &
    k in Values &
    (for x,y being Element of Term holds
       (app.[x,y] in Values iff
        (((x = k or x = s) & y in Values) or
         ex z being Element of Term st
           x = app.[s,z] & z in Values & y in Values))) &
    hole in ValidContexts &
    (for c1 being Element of Context, x being Element of Term holds
       (left.[c1,x] in ValidContexts iff c1 in ValidContexts)) &
    (for x being Element of Term, c1 being Element of Context holds
       (right.[x,c1] in ValidContexts iff
        x in Values & c1 in ValidContexts)) &
    (for x being Element of Term holds subst.[hole,x] = x) &
    (for c1 being Element of Context, x,y being Element of Term holds
       subst.[left.[c1,y],x] = app.[subst.[c1,x],y]) &
    (for x being Element of Term, c1 being Element of Context,
         y being Element of Term
     holds subst.[right.[x,c1],y] = app.[x,subst.[c1,y]]) &
    (for x,y being Element of Term holds
       ([x,y] in Red iff
        (ex c1 being Element of Context,
            v1,v2 being Element of Term st
           c1 in ValidContexts & v1 in Values & v2 in Values &
           x = subst.[c1,app.[app.[k,v1],v2]] &
           y = subst.[c1,v1]) or
        (ex c1 being Element of Context,
            v1,v2,v3 being Element of Term st
           c1 in ValidContexts &
           v1 in Values & v2 in Values & v3 in Values &
           x = subst.[c1,app.[app.[app.[s,v1],v2],v3]] &
           y = subst.[c1,app.[app.[v1,v3],app.[v2,v3]]]))) &
    (for x being Element of Term holds [x,x] in RTC) &
    (for x,y,z being Element of Term st
       [x,y] in RTC & [y,z] in Red
     holds [x,z] in RTC) &
    (for R being Relation of Term st
       (for x being Element of Term holds [x,x] in R) &
       (for x,y,z being Element of Term st
          [x,y] in R & [y,z] in Red
        holds [x,z] in R)
     holds RTC c= R) &
    (for c1 being Element of Context holds substC.[hole,c1] = c1) &
    (for c1,c2 being Element of Context, x being Element of Term
     holds substC.[left.[c1,x],c2] = left.[substC.[c1,c2],x]) &
    (for x being Element of Term, c1,c2 being Element of Context
     holds substC.[right.[x,c1],c2] = right.[x,substC.[c1,c2]]) &
    not s in OnlyK &
    k in OnlyK &
    (for x,y being Element of Term holds
       (app.[x,y] in OnlyK iff x in OnlyK & y in OnlyK)) &
    t in OnlyK &
    c in ValidContexts
  holds
    (t = k or
     ex t1,t2 being Element of Term st
       t = app.[t1,t2] &
       (((c in ValidContexts &
          left.[hole,t2] in ValidContexts)
          implies substC.[c,left.[hole,t2]] in ValidContexts)
        implies
        ((ex f,f1 being Element of Term st
            t = app.[f,f1] & (f = t1 or f1 = t1)) &
         t1 in OnlyK &
         substC.[c,left.[hole,t2]] in ValidContexts) &
        (for v1 being Element of Term st
           (v1 in OnlyK & v1 in Values) &
           [subst.[substC.[c,left.[hole,t2]],t1],
            subst.[substC.[c,left.[hole,t2]],v1]] in RTC
         holds
           (((c in ValidContexts &
              right.[v1,hole] in ValidContexts)
              implies
              substC.[c,right.[v1,hole]] in ValidContexts)
            implies
            ((ex f,f1 being Element of Term st
                t = app.[f,f1] & (f = t2 or f1 = t2)) &
             t2 in OnlyK &
             substC.[c,right.[v1,hole]] in ValidContexts) &
            (for v2 being Element of Term st
               (v2 in OnlyK & v2 in Values) &
               [subst.[substC.[c,right.[v1,hole]],t2],
                subst.[substC.[c,right.[v1,hole]],v2]] in RTC
             holds
               v1 = k or
               ex v3 being Element of Term st
                 v1 = app.[k,v3]))))) &
    (for result being Element of Term st
       ((t = k & result = k) or
        (ex t1,t2 being Element of Term st
           t = app.[t1,t2] &
           ((c in ValidContexts &
             left.[hole,t2] in ValidContexts)
             implies substC.[c,left.[hole,t2]] in ValidContexts) &
           (ex v1 being Element of Term st
              ((v1 in OnlyK & v1 in Values) &
               [subst.[substC.[c,left.[hole,t2]],t1],
                subst.[substC.[c,left.[hole,t2]],v1]] in RTC) &
              ((c in ValidContexts &
                right.[v1,hole] in ValidContexts)
                implies
                substC.[c,right.[v1,hole]] in ValidContexts) &
              (ex v2 being Element of Term st
                 ((v2 in OnlyK & v2 in Values) &
                  [subst.[substC.[c,right.[v1,hole]],t2],
                   subst.[substC.[c,right.[v1,hole]],v2]] in RTC) &
                 ((v1 = k & result = app.[v1,v2]) or
                  (ex v3 being Element of Term st
                     v1 = app.[k,v3] & result = v3))))))
     holds
       (result in OnlyK & result in Values) &
       [subst.[c,t],subst.[c,result]] in RTC)
proof
end;
::$P+
