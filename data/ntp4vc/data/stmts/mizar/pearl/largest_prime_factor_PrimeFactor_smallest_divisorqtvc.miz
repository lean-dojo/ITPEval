:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/largest_prime_factor_PrimeFactor_smallest_divisorqtvc: the integer
:: smallest-divisor verification condition for advancing a divisor search and
:: returning a divisor with no smaller divisor from two onward. This file
:: contains no proof.

environ
  vocabularies NUMBERS, INT_1, INT_2, NAT_1, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0,
    SUBSET_1, MARGREL1, XBOOLEAN;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, NAT_1, MARGREL1;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, INT_2, CARD_1,
    MARGREL1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for n,d being Integer st
    2 <= n &
    2 <= d &
    d <= n &
    (for i being Integer st 2 <= i & i < d
     holds not i divides n)
  holds
    (not n < d*d implies
      (2 <= d implies d <> 0) &
      (for o2 being Element of BOOLEAN st
        ((2 <= d &
          ((n mod d = 0 & o2 = TRUE) or
           (n mod d <> 0 & o2 = FALSE))) or
         (not 2 <= d & o2 = FALSE)) &
        o2 <> TRUE
       holds
        (0 <= n-d & n-(d+1) < n-d) &
        2 <= n &
        (2 <= d+1 & d+1 <= n) &
        (for i being Integer st 2 <= i & i < d+1
         holds not i divides n))) &
    (for result being Integer st
      ((n < d*d & result = n) or
       (not n < d*d &
        ex o2 being Element of BOOLEAN st
          ((2 <= d &
            ((n mod d = 0 & o2 = TRUE) or
             (n mod d <> 0 & o2 = FALSE))) or
           (not 2 <= d & o2 = FALSE)) &
          ((o2 = TRUE & result = d) or
           (o2 <> TRUE &
            (d+1 <= result & result <= n) &
            result divides n &
            (for i being Integer st 2 <= i & i < result
             holds not i divides n)))))
     holds
      (d <= result & result <= n) &
      result divides n &
      (for i being Integer st 2 <= i & i < result
       holds not i divides n))
proof
end;
::$P+
