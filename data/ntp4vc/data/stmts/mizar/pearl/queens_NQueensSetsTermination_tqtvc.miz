:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/queens_NQueensSetsTermination_tqtvc: the finite-set N-queens
:: termination verification condition decreases the cardinalities of the
:: remaining row and candidate sets. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, NUMBERS,
    XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1,
    INT_1, NAT_1, ORDINAL1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    NAT_1, XXREAL_0, FINSET_1;
  constructors REAL_1, INT_1, NAT_1, XXREAL_0, ZFMISC_1,
    CARD_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, NUMBERS, CARD_1, XXREAL_0,
    MEMBERED, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSET_1;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,o1,b,o2,c being finite Subset of INT st
    a <> {} &
    o1 = a \ b &
    o2 = o1 \ c
  holds
    o2 c= (a \ b) \ c &
    (for f being Integer, e being finite Subset of INT st
       e c= (a \ b) \ c & e <> {}
     holds
       e <> {} &
       (for d being Integer st
          d in e &
          (for x being Integer st x in e holds d <= x)
        holds
          for o3 being finite Subset of INT st
            o3 = c \/ {d} &
            (d in c implies card o3 = card c) &
            (not d in c implies card o3 = card c + 1)
          holds
            for o4 being finite Subset of INT st
              (for i being Integer holds
                (i in o4 iff 0 <= i & i + 1 in o3))
            holds
              for o5 being finite Subset of INT st
                o5 = b \/ {d} &
                (d in b implies card o5 = card b) &
                (not d in b implies card o5 = card b + 1)
              holds
                for o6 being finite Subset of INT st
                  (for i being Integer holds
                    (i in o6 iff 1 <= i & i - 1 in o5))
                holds
                  for o7 being finite Subset of INT st
                    o7 = a \ {d} &
                    (d in a implies card o7 = card a - 1) &
                    (not d in a implies card o7 = card a)
                  holds
                    (0 <= card a & card o7 < card a) &
                    (for o8 being Integer,
                         o9 being finite Subset of INT st
                       o9 = e \ {d} &
                       (d in e implies card o9 = card e - 1) &
                       (not d in e implies card o9 = card e)
                     holds
                       (0 <= card e & card o9 < card e) &
                       o9 c= (a \ b) \ c)))
proof
end;
::$P+
