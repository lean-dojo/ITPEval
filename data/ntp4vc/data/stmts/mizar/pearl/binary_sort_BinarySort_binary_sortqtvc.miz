:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binary_sort_BinarySort_binary_sortqtvc: the binary-sort
:: verification condition preserves sorted prefixes and whole-list
:: permutation while inserting each next integer by binary search.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4, FUNCOP_1,
    FUNCT_7, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, NAT_1, XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, NAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for alen being Integer,
      a being Function of INT,INT st
    0 <= alen &
    (for q being Integer st q < 0 holds a.q = a.0) &
    (for q being Integer st alen <= q holds a.q = 0)
  holds
    for o1 being Integer st o1 = alen - 1 holds
      (1 <= o1 + 1 implies
        ((for i,j being Integer st
            0 <= i & i <= j & j < 1
          holds
            ex ai,aj being Integer st
              ai = a.i & aj = a.j & ai <= aj) &
          (for z being Integer holds
            card {q where q is Integer :
              0 <= q & q < alen & a.q = z} =
            card {q where q is Integer :
              0 <= q & q < alen & a.q = z}) &
          (for a1 being Function of INT,INT st
            (for q being Integer st q < 0
              holds a1.q = a1.0) &
            (for q being Integer st alen <= q
              holds a1.q = 0)
           holds
            (for k being Integer st
              (1 <= k & k <= o1) &
              (for i,j being Integer st
                0 <= i & i <= j & j < k
               holds
                 ex ai,aj being Integer st
                   ai = a1.i & aj = a1.j & ai <= aj) &
              (for z being Integer holds
                card {q where q is Integer :
                  0 <= q & q < alen & a.q = z} =
                card {q where q is Integer :
                  0 <= q & q < alen & a1.q = z})
            holds
              (0 <= k & k < alen) &
              (for v being Integer st v = a1.k holds
                ((0 <= 0 & 0 <= k & k <= k) &
                  (for i being Integer st 0 <= i & i < 0
                    holds
                      ex ai being Integer st
                        ai = a1.i & ai <= v) &
                  (for i being Integer st k <= i & i < k
                    holds
                      ex ai being Integer st
                        ai = a1.i & v < ai)) &
                (for right1,left1 being Integer st
                  (0 <= left1 & left1 <= right1 &
                    right1 <= k) &
                  (for i being Integer st
                    0 <= i & i < left1
                   holds
                     ex ai being Integer st
                       ai = a1.i & ai <= v) &
                  (for i being Integer st
                    right1 <= i & i < k
                   holds
                     ex ai being Integer st
                       ai = a1.i & v < ai)
                 holds
                  (left1 < right1 implies
                    2 <> 0 &
                    (for mid being Integer st
                      mid = left1 + (right1 - left1) div 2
                     holds
                      (0 <= mid & mid < alen) &
                      (for amid being Integer st amid = a1.mid
                       holds
                        (v < amid implies
                          (0 <= right1 - left1 &
                            mid - left1 < right1 - left1) &
                          (0 <= left1 & left1 <= mid &
                            mid <= k) &
                          (for i being Integer st
                            0 <= i & i < left1
                           holds
                             ex ai being Integer st
                               ai = a1.i & ai <= v) &
                          (for i being Integer st
                            mid <= i & i < k
                           holds
                             ex ai being Integer st
                               ai = a1.i & v < ai)) &
                        (not v < amid implies
                          (0 <= right1 - left1 &
                            right1 - (mid + 1) <
                              right1 - left1) &
                          (0 <= mid + 1 & mid + 1 <= right1 &
                            right1 <= k) &
                          (for i being Integer st
                            0 <= i & i < mid + 1
                           holds
                             ex ai being Integer st
                               ai = a1.i & ai <= v) &
                          (for i being Integer st
                            right1 <= i & i < k
                           holds
                             ex ai being Integer st
                               ai = a1.i & v < ai))) &
                  (not left1 < right1 implies
                    for o2,o3 being Integer st
                      o2 = k - left1 & o3 = left1 + 1
                    holds
                      ((0 <= left1 & 0 <= o2 &
                          left1 + o2 <= alen) &
                        0 <= o3 & o3 + o2 <= alen) &
                      (for a2 being Function of INT,INT st
                        (for q being Integer st q < 0
                          holds a2.q = a2.0) &
                        (for q being Integer st alen <= q
                          holds a2.q = 0) &
                        (for i being Integer st
                          (0 <= i & i < o3) or
                          (o3 + o2 <= i & i < alen)
                         holds a2.i = a1.i) &
                        (for i being Integer st
                          o3 <= i & i < o3 + o2
                         holds
                          a2.i = a1.(left1 + i - o3))
                       holds
                        (0 <= left1 & left1 < alen) &
                        (for i,j being Integer st
                          0 <= i & i <= j & j < k + 1
                         holds
                           ex ai,aj being Integer st
                             ai = (a2+*(left1,v)).i &
                             aj = (a2+*(left1,v)).j &
                             ai <= aj) &
                        (for z being Integer holds
                          card {q where q is Integer :
                            0 <= q & q < alen &
                            a.q = z} =
                          card {q where q is Integer :
                            0 <= q & q < alen &
                            (a2+*(left1,v)).q = z})))))))) &
          (((for i,j being Integer st
              0 <= i & i <= j & j < o1 + 1
             holds
               ex ai,aj being Integer st
                 ai = a1.i & aj = a1.j & ai <= aj) &
            (for z being Integer holds
              card {q where q is Integer :
                0 <= q & q < alen & a.q = z} =
              card {q where q is Integer :
                0 <= q & q < alen & a1.q = z}))
           implies
            (for i,j being Integer st
              0 <= i & i <= j & j < alen
             holds
               ex ai,aj being Integer st
                 ai = a1.i & aj = a1.j & ai <= aj) &
            (for z being Integer holds
              card {q where q is Integer :
                0 <= q & q < alen & a.q = z} =
              card {q where q is Integer :
                0 <= q & q < alen & a1.q = z}))))) &
      (o1 + 1 < 1 implies
        (for i,j being Integer st
          0 <= i & i <= j & j < alen
         holds
           ex ai,aj being Integer st
             ai = a.i & aj = a.j & ai <= aj) &
        (for z being Integer holds
          card {q where q is Integer :
            0 <= q & q < alen & a.q = z} =
          card {q where q is Integer :
            0 <= q & q < alen & a.q = z}))
proof
end;
::$P+
