:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/string_search_BadShiftTable_make_tableqtvc: the bad-shift-table
:: construction verification condition establishes signed 63-bit bounds and
:: preserves the byte-map loop invariants through insertion. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSEQ_1, FINSEQ_2, FINSET_1, MCART_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    NAT_D, NEWTON, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON, FINSEQ_1,
    FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS,
    CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T being non empty set,
      mapDom being Function of T,bool NAT,
      mapVal being Function of T,Funcs(NAT,INT),
      nthElem being Function of [:NAT*,INT:],NAT,
      m being Integer,
      pat1 being FinSequence of NAT,
      sht1 being Element of T st
    (for a being FinSequence of NAT, j being Integer st
       0 <= j & j < len a
     holds nthElem.[a,j] = a.(j+1)) &
    (for q being Nat st q in dom pat1 holds
       ex b being Nat st b = pat1.q & b < 256) &
    (for sht being Element of T, c being Nat st
       c in mapDom.sht
     holds
       c < 256 &
       ex v being Integer st
         v = (mapVal.sht).c &
         -(2 |^ 62) <= v & v <= (2 |^ 62) - 1) &
    -(2 |^ 62) <= m &
    m <= (2 |^ 62) - 1 &
    m = len pat1 &
    0 <= len pat1 &
    mapDom.sht1 = {}
  holds
    (-(2 |^ 62) <= m - 1 &
      m - 1 <= (2 |^ 62) - 1) &
    (for o1 being Integer st
       -(2 |^ 62) <= o1 &
       o1 <= (2 |^ 62) - 1 &
       o1 = m - 1
     holds
       (0 <= o1 + 1 implies
         ((for j being Integer st 0 <= j & j < 0
           holds nthElem.[pat1,j] in mapDom.sht1) &
          (for c being Nat st
             c < 256 & c in mapDom.sht1
           holds
             ex v being Integer st
               v = (mapVal.sht1).c &
               1 <= v & v <= m + 1) &
          (for c being Nat st
             c < 256 & c in mapDom.sht1
           holds
             ex v being Integer st
               v = (mapVal.sht1).c &
               (for j being Integer st m - v < j & j < 0
                holds nthElem.[pat1,j] <> c))) &
         (for sht2 being Element of T holds
           (for i being Integer st
              -(2 |^ 62) <= i &
              i <= (2 |^ 62) - 1
            holds
              ((0 <= i & i <= o1) &
               (for j being Integer st 0 <= j & j < i
                holds nthElem.[pat1,j] in mapDom.sht2) &
               (for c being Nat st
                  c < 256 & c in mapDom.sht2
                holds
                  ex v being Integer st
                    v = (mapVal.sht2).c &
                    1 <= v & v <= m + 1) &
               (for c being Nat st
                  c < 256 & c in mapDom.sht2
                holds
                  ex v being Integer st
                    v = (mapVal.sht2).c &
                    (for j being Integer st m - v < j & j < i
                     holds nthElem.[pat1,j] <> c)))
              implies
                (-(2 |^ 62) <= m - i &
                  m - i <= (2 |^ 62) - 1) &
                (for o2 being Integer st
                   -(2 |^ 62) <= o2 &
                   o2 <= (2 |^ 62) - 1 &
                   o2 = m - i
                 holds
                   (0 <= i & i < len pat1) &
                   (for sht3 being Element of T st
                      mapDom.sht3 =
                        (mapDom.sht2) \/ {nthElem.[pat1,i]} &
                      (mapVal.sht3).(nthElem.[pat1,i]) = o2 &
                      (for c being Nat st
                         c < 256 & c <> nthElem.[pat1,i]
                       holds
                         (c in mapDom.sht3 iff
                            c in mapDom.sht2) &
                         (c in mapDom.sht2 implies
                           (mapVal.sht3).c = (mapVal.sht2).c))
                    holds
                      (for j being Integer st
                         0 <= j & j < i + 1
                       holds
                         nthElem.[pat1,j] in mapDom.sht3) &
                      (for c being Nat st
                         c < 256 & c in mapDom.sht3
                       holds
                         ex v being Integer st
                           v = (mapVal.sht3).c &
                           1 <= v & v <= m + 1) &
                      (for c being Nat st
                         c < 256 & c in mapDom.sht3
                       holds
                         ex v being Integer st
                           v = (mapVal.sht3).c &
                           (for j being Integer st
                              m - v < j & j < i + 1
                            holds nthElem.[pat1,j] <> c)))) &
           (((for j being Integer st
                0 <= j & j < o1 + 1
              holds nthElem.[pat1,j] in mapDom.sht2) &
             (for c being Nat st
                c < 256 & c in mapDom.sht2
              holds
                ex v being Integer st
                  v = (mapVal.sht2).c &
                  1 <= v & v <= m + 1) &
             (for c being Nat st
                c < 256 & c in mapDom.sht2
              holds
                ex v being Integer st
                  v = (mapVal.sht2).c &
                  (for j being Integer st
                     m - v < j & j < o1 + 1
                   holds nthElem.[pat1,j] <> c)))
            implies
              (for j being Integer st
                 0 <= j & j < len pat1
               holds nthElem.[pat1,j] in mapDom.sht2) &
              (for c being Nat st
                 c < 256 & c in mapDom.sht2
               holds
                 ex v being Integer st
                   v = (mapVal.sht2).c &
                   1 <= v & v <= len pat1 + 1) &
              (for c being Nat st
                 c < 256 & c in mapDom.sht2
               holds
                 ex v being Integer st
                   v = (mapVal.sht2).c &
                   (for j being Integer st 1 <= j & j < v
                    holds
                      nthElem.[pat1,len pat1 - j] <> c))))) &
       (o1 + 1 < 0 implies
         (for j being Integer st 0 <= j & j < len pat1
          holds nthElem.[pat1,j] in mapDom.sht1) &
         (for c being Nat st
            c < 256 & c in mapDom.sht1
          holds
            ex v being Integer st
              v = (mapVal.sht1).c &
              1 <= v & v <= len pat1 + 1) &
         (for c being Nat st
            c < 256 & c in mapDom.sht1
          holds
            ex v being Integer st
              v = (mapVal.sht1).c &
              (for j being Integer st 1 <= j & j < v
               holds nthElem.[pat1,len pat1 - j] <> c)))))
proof
end;
::$P+
