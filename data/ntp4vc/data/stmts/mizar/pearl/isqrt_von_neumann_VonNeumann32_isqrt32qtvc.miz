:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/isqrt_von_neumann_VonNeumann32_isqrt32qtvc: the 32-bit von Neumann
:: integer-square-root verification condition establishes initialization,
:: loop-step invariants, and the final consecutive-square bounds. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1,
    FUNCT_1, FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON,
    RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2,
    NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS,
    RVSUM_1, FINSEQOP, FUNCT_2;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1, MEMBERED, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Nat st x < 2 |^ 32 holds
    16 <= 16 &
    (16 = 0 implies 32768 = 0) &
    (16 <> 0 implies 32768 = 32768) &
    1073741824 = (32768 * 32768) mod (2 |^ 32) &
    (for i being Element of NAT st i < 32 holds
      not ((0 div (2 |^ i)) mod 2 = 1 &
        (((((2 |^ 16) mod (2 |^ 32)) + (2 |^ 32) - 1)
          mod (2 |^ 32)) div (2 |^ i)) mod 2 = 1)) &
    0 < 65536 &
    0 = (0 * ((2 |^ 16) mod (2 |^ 32))) mod (2 |^ 32) &
    x <= x &
    (x + (2 |^ 32) - x) mod (2 |^ 32) =
      (0 * 0) mod (2 |^ 32) &
    (0 + ((2 |^ 16) mod (2 |^ 32))) mod (2 |^ 32) <= 65536 &
    x <=
      (((((0 + ((2 |^ 16) mod (2 |^ 32))) mod (2 |^ 32)) *
          ((0 + ((2 |^ 16) mod (2 |^ 32))) mod (2 |^ 32)))
          mod (2 |^ 32)) + (2 |^ 32) - 1) mod (2 |^ 32) &
    (for res,m,num being Nat st
      res < 2 |^ 32 &
      m < 2 |^ 32 &
      num < 2 |^ 32 &
      m <= 16 &
      (for i being Element of NAT st i < 32 holds
        not ((res div (2 |^ i)) mod 2 = 1 &
          (((((2 |^ m) mod (2 |^ 32)) + (2 |^ 32) - 1)
            mod (2 |^ 32)) div (2 |^ i)) mod 2 = 1)) &
      res < 65536 &
      num <= x &
      (x + (2 |^ 32) - num) mod (2 |^ 32) =
        (res * res) mod (2 |^ 32) &
      (res + ((2 |^ m) mod (2 |^ 32))) mod (2 |^ 32) <= 65536 &
      x <=
        (((((res + ((2 |^ m) mod (2 |^ 32))) mod (2 |^ 32)) *
            ((res + ((2 |^ m) mod (2 |^ 32))) mod (2 |^ 32)))
            mod (2 |^ 32)) + (2 |^ 32) - 1) mod (2 |^ 32)
     holds
      for s,d,p,q,t,e,r being Nat st
        s < 2 |^ 32 &
        d < 2 |^ 32 &
        p < 2 |^ 32 &
        q < 2 |^ 32 &
        t < 2 |^ 32 &
        e < 2 |^ 32 &
        r < 2 |^ 32 &
        s = (2 |^ m) mod (2 |^ 32) &
        d = (m + (2 |^ 32) - 1) mod (2 |^ 32) &
        (m = 0 implies p = 0) &
        (m <> 0 implies p = (2 |^ d) mod (2 |^ 32)) &
        q = (p * p) mod (2 |^ 32) &
        t = (2 |^ d) mod (2 |^ 32) &
        e = (d + (2 |^ 32) - 1) mod (2 |^ 32) &
        (d = 0 implies r = 0) &
        (d <> 0 implies r = (2 |^ e) mod (2 |^ 32))
      holds
        (q <> 0 implies
          for b being Nat st
            b < 2 |^ 32 &
            (for i being Element of NAT st i < 32 holds
              ((b div (2 |^ i)) mod 2 = 1 iff
                (((((res * s) mod (2 |^ 32)) div (2 |^ i))
                    mod 2 = 1) or
                 ((q div (2 |^ i)) mod 2 = 1))))
           holds
            (b <= num implies
              q div (2 |^ 2) < q &
              d <= 16 &
              p div 2 = r &
              q div (2 |^ 2) = (r * r) mod (2 |^ 32) &
              (for i being Element of NAT st i < 32 holds
                not (((((res + p) mod (2 |^ 32)) div (2 |^ i))
                        mod 2 = 1) &
                  ((((t + (2 |^ 32) - 1) mod (2 |^ 32))
                    div (2 |^ i)) mod 2 = 1)) &
              (res + p) mod (2 |^ 32) < 65536 &
              (for i being Element of NAT st i < 32 holds
                ((((((res + p) mod (2 |^ 32)) * t)
                      mod (2 |^ 32)) div (2 |^ i)) mod 2 = 1 iff
                  ((((((res * s) mod (2 |^ 32)) div 2)
                        div (2 |^ i)) mod 2 = 1) or
                   ((q div (2 |^ i)) mod 2 = 1))) &
              (num + (2 |^ 32) - b) mod (2 |^ 32) <= x &
              (x + (2 |^ 32) -
                  ((num + (2 |^ 32) - b) mod (2 |^ 32)))
                  mod (2 |^ 32) =
                (((res + p) mod (2 |^ 32)) *
                  ((res + p) mod (2 |^ 32))) mod (2 |^ 32) &
              (((res + p) mod (2 |^ 32)) + t) mod (2 |^ 32)
                <= 65536 &
              x <=
                ((((((((res + p) mod (2 |^ 32)) + t)
                      mod (2 |^ 32)) *
                    (((res + p) mod (2 |^ 32)) + t)
                      mod (2 |^ 32))) mod (2 |^ 32)) +
                  (2 |^ 32) - 1) mod (2 |^ 32)) &
            (not b <= num implies
              q div (2 |^ 2) < q &
              d <= 16 &
              p div 2 = r &
              q div (2 |^ 2) = (r * r) mod (2 |^ 32) &
              (for i being Element of NAT st i < 32 holds
                not ((res div (2 |^ i)) mod 2 = 1 &
                  ((((t + (2 |^ 32) - 1) mod (2 |^ 32))
                    div (2 |^ i)) mod 2 = 1)) &
              res < 65536 &
              ((res * s) mod (2 |^ 32)) div 2 =
                (res * t) mod (2 |^ 32) &
              num <= x &
              (x + (2 |^ 32) - num) mod (2 |^ 32) =
                (res * res) mod (2 |^ 32) &
              (res + t) mod (2 |^ 32) <= 65536 &
              x <=
                (((((res + t) mod (2 |^ 32)) *
                    ((res + t) mod (2 |^ 32))) mod (2 |^ 32)) +
                  (2 |^ 32) - 1) mod (2 |^ 32))) &
        (q = 0 implies
          (((res * s) mod (2 |^ 32)) *
            ((res * s) mod (2 |^ 32))) mod (2 |^ 32) <= x &
          x <=
            (((((((res * s) mod (2 |^ 32)) + 1) mod (2 |^ 32)) *
                ((((res * s) mod (2 |^ 32)) + 1) mod (2 |^ 32)))
                mod (2 |^ 32)) + (2 |^ 32) - 1) mod (2 |^ 32))))))
proof
end;
::$P+
