:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/euler002_Solve_fqtvc: the Euler 002 verification condition initializes
:: and preserves an invariant for summing even Fibonacci numbers up to a
:: nonnegative bound. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m being Integer,
      FibonacciSeq being Function of INT,INT,
      EvenSum being Function of [:INT,INT:],INT
  st
    0 <= m &
    FibonacciSeq.0 = 0 &
    FibonacciSeq.1 = 1 &
    (for r being Integer st 0 <= r & r <> 0 & r <> 1 holds
      ex fr,fr1,fr2 being Integer st
        fr = FibonacciSeq.r &
        fr1 = FibonacciSeq.(r - 1) &
        fr2 = FibonacciSeq.(r - 2) &
        fr = fr1 + fr2) &
    (for bound being Integer holds
      EvenSum.[bound,0] = 0) &
    (for r,bound,fr being Integer st
      0 <= r &
      fr = FibonacciSeq.r &
      fr <= bound &
      fr mod 2 = 0
     holds
      ex sr,sr1 being Integer st
        sr = EvenSum.[bound,r] &
        sr1 = EvenSum.[bound,r + 1] &
        sr1 = sr + fr) &
    (for r,bound,fr being Integer st
      0 <= r &
      fr = FibonacciSeq.r &
      bound < fr &
      fr mod 2 = 0
     holds
      EvenSum.[bound,r + 1] = EvenSum.[bound,r]) &
    (for r,bound,fr being Integer st
      0 <= r &
      fr = FibonacciSeq.r &
      fr mod 2 <> 0
     holds
      EvenSum.[bound,r + 1] = EvenSum.[bound,r])
  holds
    0 <= 0 &
    0 <= 0 &
    0 = FibonacciSeq.(3 * 0) &
    0 = FibonacciSeq.0 &
    2 = FibonacciSeq.(3 * (0 + 1)) &
    2 = FibonacciSeq.(0 + 3) &
    0 = EvenSum.[m,0] &
    0 <= 0 &
    0 < 2 &
    (for k,n,fn,fn1 being Integer st
      0 <= n &
      0 <= k &
      fn = FibonacciSeq.(3 * n) &
      fn1 = FibonacciSeq.(3 * (n + 1)) &
      fn = FibonacciSeq.k &
      fn1 = FibonacciSeq.(k + 3) &
      0 <= fn &
      fn < fn1
     holds
      (fn <= m implies
        ex fn2,fk6,smk,smk3 being Integer st
          fn2 = FibonacciSeq.(3 * (n + 1 + 1)) &
          fk6 = FibonacciSeq.(k + 3 + 3) &
          smk = EvenSum.[m,k] &
          smk3 = EvenSum.[m,k + 3] &
          (0 <= m - fn &
           m - fn1 < m - fn) &
          0 <= n + 1 &
          0 <= k + 3 &
          fn1 = FibonacciSeq.(k + 3) &
          4 * fn1 + fn = fn2 &
          4 * fn1 + fn = fk6 &
          smk + fn = smk3 &
          0 <= fn1 &
          fn1 < 4 * fn1 + fn) &
      (not fn <= m implies
        ex n1,smk,smn1,fnn1 being Integer st
          smk = EvenSum.[m,k] &
          smn1 = EvenSum.[m,n1] &
          fnn1 = FibonacciSeq.n1 &
          smk = smn1 &
          m < fnn1))
proof
end;
::$P+
