:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/cursor_examples_TestListCursor_list_sumqtvc: the list-cursor
:: verification condition initializes and preserves a prefix-sum invariant
:: while advancing through an integer list. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    ORDINAL1, ORDINAL4, CARD_1, FINSEQ_1, FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0, FINSEQ_1,
    FINSEQ_2, MCART_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0,
    MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Cursor being non empty set,
      visited,collection being Function of Cursor,INT*,
      push being Function of [:INT*,INT:],INT*,
      listSum being Function of INT*,INT,
      Permitted,Complete being Subset of Cursor,
      c being Element of Cursor,
      l being FinSequence of INT
  st
    listSum.(<*>INT) = 0 &
    (for xs being FinSequence of INT, x being Integer holds
      push.[xs,x] = xs ^ <*x*> &
      (ex s being Integer st
        s = listSum.xs &
        listSum.(push.[xs,x]) = s + x)) &
    (for q being Element of Cursor holds
      (q in Permitted iff
        len (visited.q) <= len (collection.q) &
        (for i being Integer st
          0 <= i & i < len (visited.q)
         holds
          (visited.q).(i+1) = (collection.q).(i+1)))) &
    (for q being Element of Cursor holds
      (q in Complete iff
        len (visited.q) = len (collection.q))) &
    c in Permitted &
    visited.c = <*>INT &
    collection.c = l
  holds
    0 = listSum.(visited.c) &
    c in Permitted &
    (for c1 being Element of Cursor st
      collection.c1 = collection.c &
      c1 in Permitted
     holds
      c1 in Permitted &
      (((not c1 in Complete) &
        ((not c1 in Complete) &
         c1 in Permitted) &
        (for c2 being Element of Cursor st
          collection.c2 = collection.c1
         holds
          for x being Integer st
            visited.c2 = push.[visited.c1,x] &
            c2 in Permitted
          holds
            (0 <= len l - len (visited.c1) &
             len l - len (visited.c2) <
               len l - len (visited.c1)) &
            (ex s1,s2 being Integer st
              s1 = listSum.(visited.c1) &
              s2 = listSum.(visited.c2) &
              s1 + x = s2) &
            c2 in Permitted)) or
       (c1 in Complete &
        listSum.(visited.c1) = listSum.l)))
proof
end;
::$P+
