:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bitwalker_Bitwalker_peekthenpokeqtvc: the bit-stream peek-then-poke
:: verification condition relates reading a segment of up to 64 bits to
:: writing it back into a finite sequence of 8-bit words. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, FINSEQ_1, FINSEQ_2, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    NAT_D, NEWTON, XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1,
    XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for len32,start being Nat,
      addr being FinSequence of NAT,
      Bit being Function of [:NAT,INT:],BOOLEAN,
      Nth8 being Function of INT,BOOLEAN st
    len32 < (2 |^ 32) &
    start < (2 |^ 32) &
    (for q being Nat st q in dom addr holds
      ex b being Nat st b = addr.q & b < 256) &
    (for w being Nat, p being Integer holds
      (Bit.[w,p] = TRUE iff
        ex k being Nat st
          ((p < 0 & k = 0) or (0 <= p & k = p)) &
          (w div (2 |^ k)) mod 2 = 1)) &
    (for p being Integer holds
      (Nth8.p = TRUE iff
        ex q,k,b being Nat st
          (((p div 8) < 0 & q = 0) or
           (0 <= (p div 8) & q = p div 8)) &
          k = 7 - (p mod 8) &
          q < len addr &
          b = addr.(q + 1) &
          Bit.[b,k] = TRUE)) &
    8 * len addr < (2 |^ 32) &
    0 <= len32 &
    len32 < 64 &
    start + len32 <= 8 * len addr
  holds
    len32 <= 64 &
    start + len32 < (2 |^ 32) &
    8 * len addr < (2 |^ 32) &
    (for value being Nat st value < (2 |^ 64) holds
      (((8 * len addr < start + len32 implies value = 0) &
        (start + len32 <= 8 * len addr implies
          (for i being Integer st 0 <= i & i < len32 holds
            Bit.[value,i] =
              Nth8.(start + len32 - i - 1)) &
          (for i being Integer st len32 <= i & i < 64 holds
            Bit.[value,i] = FALSE)))
       implies
        (len32 < 64 &
         start + len32 < (2 |^ 32) &
         8 * len addr < (2 |^ 32)) &
        (for addr1 being FinSequence of NAT,
             Nth81 being Function of INT,BOOLEAN st
           len addr1 = len addr &
           (for q being Nat st q in dom addr1 holds
             ex b being Nat st b = addr1.q & b < 256) &
           (for p being Integer holds
             (Nth81.p = TRUE iff
               ex q,k,b being Nat st
                 (((p div 8) < 0 & q = 0) or
                  (0 <= (p div 8) & q = p div 8)) &
                 k = 7 - (p mod 8) &
                 q < len addr1 &
                 b = addr1.(q + 1) &
                 Bit.[b,k] = TRUE))
         holds
          (for res being Integer st
            (-2 <= res & res <= 0) &
            (res = -1 iff
              8 * len addr1 < start + len32) &
            (res = -2 iff
              (2 |^ len32) <= value &
              start + len32 <= 8 * len addr1) &
            (res = 0 iff
              value < (2 |^ len32) &
              start + len32 <= 8 * len addr1) &
            (res = 0 implies
              (for i being Integer st 0 <= i & i < start holds
                Nth8.i = Nth81.i) &
              (for i being Integer st
                 start <= i & i < start + len32
               holds
                Nth81.i =
                  Bit.[value,len32 - i - 1 + start]) &
              (for i being Integer st
                 start + len32 <= i & i < 8 * len addr1
               holds
                Nth81.i = Nth8.i))
           holds
            res = 0 &
            (for i being Integer st
               0 <= i & i < 8 * len addr1
             holds
              Nth81.i = Nth8.i)))))
proof
end;
::$P+
