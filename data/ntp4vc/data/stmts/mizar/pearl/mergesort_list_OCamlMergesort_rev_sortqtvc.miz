:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_list_OCamlMergesort_rev_sortqtvc: the reverse-order
:: list-mergesort verification condition preserves recursive prefix-split
:: obligations and yields a reversed-sorted permutation. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, CARD_1,
    ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4, XCMPLX_0, XREAL_0,
    XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5, CLASSES1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, CLASSES1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, CLASSES1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      Leq being Relation of E,E,
      Sorted being Subset of E*,
      prefFn being Function of [:INT,E*:],E*,
      n being Integer,
      l being FinSequence of E
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E holds
       (s in Sorted iff
         for i,j being Nat st
           i in dom s & j in dom s & i < j
         holds [s/.i,s/.j] in Leq)) &
    (for s being FinSequence of E holds
       prefFn.[0,s] = <*>E) &
    (for m being Integer,
         x being Element of E,
         t being FinSequence of E st 0 < m
     holds
       prefFn.[m,<*x*> ^ t] = <*x*> ^ prefFn.[m-1,t]) &
    2 <= n &
    n <= len l
  holds
    ((n = 2 &
       ex x1,x2 being Element of E,
          tail being FinSequence of E st
         l = <*x1*> ^ <*x2*> ^ tail) or
     (n <> 2 & n = 3 &
       ex x1,x2,x3 being Element of E,
          tail being FinSequence of E st
         l = <*x1*> ^ <*x2*> ^ <*x3*> ^ tail) or
     (n <> 2 & n <> 3 &
      (2 qua Integer) <> 0 &
      0 <= n div (2 qua Integer) &
      n div (2 qua Integer) <= len l &
      (for l2 being FinSequence of E st
         l = prefFn.[n div (2 qua Integer),l] ^ l2
       holds
         (0 <= n & n div (2 qua Integer) < n) &
         2 <= n div (2 qua Integer) &
         n div (2 qua Integer) <= len l &
         (for s1 being FinSequence of E st
            s1 in Sorted &
            s1,prefFn.[n div (2 qua Integer),l]
              are_fiberwise_equipotent
          holds
            (0 <= n &
             n - n div (2 qua Integer) < n) &
            2 <= n - n div (2 qua Integer) &
            n - n div (2 qua Integer) <= len l2 &
            (for s2 being FinSequence of E st
               s2 in Sorted &
               s2,prefFn.[n - n div (2 qua Integer),l2]
                 are_fiberwise_equipotent
             holds
               Rev (<*>E) in Sorted &
               s1 in Sorted &
               s2 in Sorted &
               (for x,y being Element of E st
                  x in rng (<*>E) & y in rng s1
                holds [x,y] in Leq) &
               (for x,y being Element of E st
                  x in rng (<*>E) & y in rng s2
                holds [x,y] in Leq))))) &
    (for result being FinSequence of E holds
       (((n = 2 &
          ex x1,x2 being Element of E,
             tail being FinSequence of E st
            l = <*x1*> ^ <*x2*> ^ tail &
            ((not [x1,x2] in Leq &
              result = <*x1*> ^ <*x2*>) or
             ([x1,x2] in Leq &
              result = <*x2*> ^ <*x1*>))) or
         (n <> 2 & n = 3 &
          ex x1,x2,x3 being Element of E,
             tail being FinSequence of E st
            l = <*x1*> ^ <*x2*> ^ <*x3*> ^ tail &
            ((not [x1,x2] in Leq &
              not [x2,x3] in Leq &
              result = <*x1*> ^ <*x2*> ^ <*x3*>) or
             (not [x1,x2] in Leq &
              [x2,x3] in Leq &
              not [x1,x3] in Leq &
              result = <*x1*> ^ <*x3*> ^ <*x2*>) or
             (not [x1,x2] in Leq &
              [x2,x3] in Leq &
              [x1,x3] in Leq &
              result = <*x3*> ^ <*x1*> ^ <*x2*>) or
             ([x1,x2] in Leq &
              not [x1,x3] in Leq &
              result = <*x2*> ^ <*x1*> ^ <*x3*>) or
             ([x1,x2] in Leq &
              [x1,x3] in Leq &
              not [x2,x3] in Leq &
              result = <*x2*> ^ <*x3*> ^ <*x1*>) or
             ([x1,x2] in Leq &
              [x1,x3] in Leq &
              [x2,x3] in Leq &
              result = <*x3*> ^ <*x2*> ^ <*x1*>))) or
         (n <> 2 & n <> 3 &
          ex l2 being FinSequence of E st
            l = prefFn.[n div (2 qua Integer),l] ^ l2 &
            ex s1 being FinSequence of E st
              s1 in Sorted &
              s1,prefFn.[n div (2 qua Integer),l]
                are_fiberwise_equipotent &
              ex s2 being FinSequence of E st
                s2 in Sorted &
                s2,prefFn.[n - n div (2 qua Integer),l2]
                  are_fiberwise_equipotent &
                Rev result in Sorted &
                result,s1 ^ s2 are_fiberwise_equipotent))
        implies
          Rev result in Sorted &
          result,prefFn.[n,l] are_fiberwise_equipotent)))
proof
end;
::$P+
