:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/vacid_0_sparse_array_SparseArray_getqtvc: the sparse-array get
:: verification condition preserves index bounds and equates every
:: branch-selected result with the abstract sparse-array value.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,SparseArray being non empty set,
      defaultElt being Element of A,
      values being Function of SparseArray,A*,
      indexSeq,backSeq being Function of SparseArray,INT*,
      cardinality,sparseLength being Function of SparseArray,INT,
      defaultValue being Function of SparseArray,A,
      nthValue being Function of [:A*,INT:],A,
      nthInt being Function of [:INT*,INT:],INT,
      IsElt being Subset of [:SparseArray,INT:],
      Value being Function of [:SparseArray,INT:],A,
      a being Element of SparseArray,
      i being Integer
  st
    (for s being FinSequence of A, j being Integer holds
       (len s = 0 implies nthValue.[s,j] = defaultElt) &
       (0 < len s & j < 0 implies nthValue.[s,j] = s.1) &
       (0 <= j & j < len s implies
          nthValue.[s,j] = s.(j+1)) &
       (len s <= j implies nthValue.[s,j] = defaultElt)) &
    (for s being FinSequence of INT, j being Integer holds
       (len s = 0 implies nthInt.[s,j] = 0) &
       (0 < len s & j < 0 implies nthInt.[s,j] = s.1) &
       (0 <= j & j < len s implies
          nthInt.[s,j] = s.(j+1)) &
       (len s <= j implies nthInt.[s,j] = 0)) &
    (for self being Element of SparseArray holds
       0 <= cardinality.self &
       cardinality.self <= len (values.self) &
       len (values.self) <= 1000 &
       len (values.self) = len (indexSeq.self) &
       len (indexSeq.self) = len (backSeq.self) &
       (for j being Integer st 0 <= j & j < cardinality.self
        holds
          ex backIndex being Integer st
            backIndex = nthInt.[backSeq.self,j] &
            0 <= backIndex &
            backIndex < len (values.self) &
            nthInt.[indexSeq.self,backIndex] = j)) &
    (for x,y being Element of SparseArray st
       values.x = values.y &
       indexSeq.x = indexSeq.y &
       backSeq.x = backSeq.y &
       cardinality.x = cardinality.y &
       defaultValue.x = defaultValue.y
     holds x = y) &
    (for self being Element of SparseArray holds
       sparseLength.self = len (values.self)) &
    (for self being Element of SparseArray, j being Integer holds
       ([self,j] in IsElt iff
         ex storedIndex being Integer st
           storedIndex = nthInt.[indexSeq.self,j] &
           0 <= storedIndex &
           storedIndex < cardinality.self &
           nthInt.[backSeq.self,storedIndex] = j)) &
    (for self being Element of SparseArray, j being Integer holds
       ([self,j] in IsElt implies
          Value.[self,j] = nthValue.[values.self,j]) &
       (not [self,j] in IsElt implies
          Value.[self,j] = defaultValue.self)) &
    0 <= i &
    i < sparseLength.a
  holds
    0 <= i &
    i < sparseLength.a &
    ([a,i] in IsElt implies
       0 <= i & i < len (values.a)) &
    (for result being Element of A st
       (([a,i] in IsElt &
         result = nthValue.[values.a,i]) or
        (not [a,i] in IsElt &
         result = defaultValue.a))
     holds result = Value.[a,i])
proof
end;
::$P+
