:: Statement-only formalization of NTP4VC corpus artifact
:: pearl/verifythis_2024_challenge1_Top_smart_array_copy_0bqtvc: the
:: verification condition for copying an array by shuffled fixed-size
:: subsegments followed by a final remainder chunk. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4, XCMPLX_0,
    XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    CARD_1, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for E being non empty set,
      src,dst being FinSequence of E,
      k,l,q,r being Integer st
    len src = len dst &
    0 < len dst &
    0 < k &
    0 < l &
    0 <= q &
    0 <= r &
    r < k*l &
    len dst = q*k*l + r
  holds
    ex zToNat being Function of INT,NAT,
       permutation being Function of [:INT,INT*:],BOOLEAN,
       permutationPair being Function of [:INT*,INT*,INT:],BOOLEAN,
       validChunk being Function of [:E*,INT,INT:],BOOLEAN,
       copyPred being
         Function of [:[:E*,E*:],[:INT,INT:]:],BOOLEAN,
       copyTo being
         Function of [:[:E*,E*:],[:INT,INT:],INT:],BOOLEAN st
      (for z being Integer holds
        ((z < 0 implies zToNat/.z = 0) &
         (0 <= z implies (zToNat/.z qua Integer) = z))) &
      (for ll being Integer, p being FinSequence of INT holds
        (permutation/.[ll,p] = TRUE iff
          0 <= ll & ll <= len p &
          (for i being Integer st 0 <= i & i < ll holds
            0 <= p/.(zToNat/.i + 1) &
            p/.(zToNat/.i + 1) < ll) &
          (for i,j being Integer st
            0 <= i & i < ll &
            0 <= j & j < ll &
            i <> j
          holds
            p/.(zToNat/.i + 1) <> p/.(zToNat/.j + 1)))) &
      (for ll being Integer,
           p,invp being FinSequence of INT holds
        (permutationPair/.[p,invp,ll] = TRUE iff
          permutation/.[ll,p] = TRUE &
          permutation/.[ll,invp] = TRUE &
          (for i being Integer st 0 <= i & i < ll holds
            p/.(zToNat/.(invp/.(zToNat/.i + 1)) + 1) = i) &
          (for i being Integer st 0 <= i & i < ll holds
            invp/.(zToNat/.(p/.(zToNat/.i + 1)) + 1) = i))) &
      (for a being FinSequence of E,
           ofs,len0 being Integer holds
        (validChunk/.[a,ofs,len0] = TRUE iff
          0 <= ofs &
          ofs <= ofs + len0 &
          ofs + len0 <= len a)) &
      (for a,b being FinSequence of E,
           ofs,len0 being Integer holds
        (copyPred/.[[a,b],[ofs,len0]] = TRUE iff
          validChunk/.[a,ofs,len0] = TRUE &
          len a = len b &
          (for i being Integer st
            ofs <= i & i < ofs + len0
          holds
            b/.(zToNat/.i + 1) = a/.(zToNat/.i + 1)))) &
      (for a,b being FinSequence of E,
           ofss,ofsd,len0 being Integer holds
        (copyTo/.[[a,b],[ofss,ofsd],len0] = TRUE iff
          validChunk/.[a,ofss,len0] = TRUE &
          validChunk/.[b,ofsd,len0] = TRUE &
          len a = len b &
          (for i being Integer st 0 <= i & i < len0 holds
            b/.(zToNat/.(ofsd + i) + 1) =
              a/.(zToNat/.(ofss + i) + 1)) &
          (for i being Integer st
            ofsd <= i & i < ofsd + len0
          holds
            b/.(zToNat/.i + 1) =
              a/.(zToNat/.(i + (ofss - ofsd)) + 1)))) &
      ((0 <= (q - 1) + 1 implies
          copyPred/.[[src,dst],[0,0*(k*l)]] = TRUE &
          (for dst1 being FinSequence of E st
            len dst1 = len dst
          holds
            (for s being Integer st
              (0 <= s & s <= q - 1) &
              copyPred/.[[src,dst1],[0,s*(k*l)]] = TRUE
            holds
              0 < l &
              (for sigma,invsigma being FinSequence of INT st
                (len sigma = len invsigma & len invsigma = l) &
                permutationPair/.[sigma,invsigma,l] = TRUE
              holds
                (0 <= (l - 1) + 1 implies
                  (copyPred/.[[src,dst1],[0,s*(k*l)]] = TRUE &
                   (for jp being Integer st
                     0 <= jp & jp < 0
                   holds
                     copyPred/.
                       [[src,dst1],
                        [s*(k*l) + sigma/.(zToNat/.jp + 1)*k,k]] =
                       TRUE)) &
                  (for dst2 being FinSequence of E st
                    len dst2 = len dst1
                  holds
                    (for j being Integer st
                      (0 <= j & j <= l - 1) &
                      copyPred/.[[src,dst2],[0,s*(k*l)]] = TRUE &
                      (for jp being Integer st
                        0 <= jp & jp < j
                      holds
                        copyPred/.
                          [[src,dst2],
                           [s*(k*l) + sigma/.(zToNat/.jp + 1)*k,k]] =
                          TRUE)
                    holds
                      (0 <= j & j < len sigma) &
                      (len src = len dst2 &
                       validChunk/.
                         [src,
                          s*(k*l) + sigma/.(zToNat/.j + 1)*k,
                          k] = TRUE &
                       validChunk/.
                         [dst2,
                          s*(k*l) + sigma/.(zToNat/.j + 1)*k,
                          k] = TRUE) &
                      (for dst3 being FinSequence of E st
                        len dst3 = len dst2
                      holds
                        (copyTo/.
                           [[src,dst3],
                            [s*(k*l) + sigma/.(zToNat/.j + 1)*k,
                             s*(k*l) + sigma/.(zToNat/.j + 1)*k],
                            k] = TRUE &
                         (for i being Integer st
                           0 <= i &
                           i < s*(k*l) + sigma/.(zToNat/.j + 1)*k
                         holds
                           dst3/.(zToNat/.i + 1) =
                             dst2/.(zToNat/.i + 1)) &
                         (for i being Integer st
                           s*(k*l) + sigma/.(zToNat/.j + 1)*k + k <= i &
                           i < len dst3
                         holds
                           dst3/.(zToNat/.i + 1) =
                             dst2/.(zToNat/.i + 1))
                        implies
                          copyPred/.
                            [[src,dst3],[0,s*(k*l)]] = TRUE &
                          (for jp being Integer st
                            0 <= jp & jp < j + 1
                          holds
                            copyPred/.
                              [[src,dst3],
                               [s*(k*l) +
                                  sigma/.(zToNat/.jp + 1)*k,
                                k]] = TRUE))) &
                    ((copyPred/.
                         [[src,dst2],[0,s*(k*l)]] = TRUE &
                      (for jp being Integer st
                        0 <= jp & jp < (l - 1) + 1
                      holds
                        copyPred/.
                          [[src,dst2],
                           [s*(k*l) + sigma/.(zToNat/.jp + 1)*k,k]] =
                          TRUE))
                     implies
                       copyPred/.
                         [[src,dst2],[0,(s + 1)*(k*l)]] = TRUE))) &
                ((l - 1) + 1 < 0 implies
                  copyPred/.
                    [[src,dst1],[0,(s + 1)*(k*l)]] = TRUE))) &
            (copyPred/.
               [[src,dst1],[0,((q - 1) + 1)*(k*l)]] = TRUE
             implies
               (len src = len dst1 &
                validChunk/.[src,q*(k*l),r] = TRUE &
                validChunk/.[dst1,q*(k*l),r] = TRUE) &
               (for dst2 being FinSequence of E st
                 len dst2 = len dst1
               holds
                 (copyTo/.
                    [[src,dst2],[q*(k*l),q*(k*l)],r] = TRUE &
                  (for i being Integer st
                    0 <= i & i < q*(k*l)
                  holds
                    dst2/.(zToNat/.i + 1) =
                      dst1/.(zToNat/.i + 1)) &
                  (for i being Integer st
                    q*(k*l) + r <= i & i < len dst2
                  holds
                    dst2/.(zToNat/.i + 1) =
                      dst1/.(zToNat/.i + 1))
                 implies
                   copyPred/.[[src,dst2],[0,len dst]] = TRUE))))))
       &
       ((q - 1) + 1 < 0 implies
          (len src = len dst &
           validChunk/.[src,q*(k*l),r] = TRUE &
           validChunk/.[dst,q*(k*l),r] = TRUE) &
          (for dst1 being FinSequence of E st
            len dst1 = len dst
          holds
            (copyTo/.
               [[src,dst1],[q*(k*l),q*(k*l)],r] = TRUE &
             (for i being Integer st
               0 <= i & i < q*(k*l)
             holds
               dst1/.(zToNat/.i + 1) =
                 dst/.(zToNat/.i + 1)) &
             (for i being Integer st
               q*(k*l) + r <= i & i < len dst1
             holds
               dst1/.(zToNat/.i + 1) =
                 dst/.(zToNat/.i + 1))
            implies
              copyPred/.[[src,dst1],[0,len dst]] = TRUE))))
proof
end;
::$P+
