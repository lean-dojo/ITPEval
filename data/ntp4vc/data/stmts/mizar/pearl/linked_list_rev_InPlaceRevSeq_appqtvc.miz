:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/linked_list_rev_InPlaceRevSeq_appqtvc: the linked-list append
:: verification condition preserves list segments while traversing the first
:: list and redirects its final link to the second list. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being non empty set,
      null,defaultLoc,l1,l2 being Element of L,
      next1 being Function of L,L,
      l1M,l2M being FinSequence of L,
      eqLoc being Function of [:L,L:],BOOLEAN,
      nthElem being Function of [:L*,INT:],L,
      append being Function of [:L*,L*:],L*,
      dropOne being Function of L*,L*,
      Disjoint being Subset of [:L*,L*:],
      ListSeg being
        Subset of [:Funcs(L,L),[:L,[:L*,L:]:]:]
  st
    (for a,b being Element of L holds
       (eqLoc.[a,b] = TRUE iff a = b)) &
    (for s being FinSequence of L, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultLoc) &
       (len s > 0 & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultLoc)) &
    (for a,b being FinSequence of L holds
       len (append.[a,b]) = len a + len b &
       (for i being Integer st 0 <= i & i < len a
        holds nthElem.[append.[a,b],i] = nthElem.[a,i]) &
       (for i being Integer st
          len a <= i & i < len (append.[a,b])
        holds
          nthElem.[append.[a,b],i] =
            nthElem.[b,i-len a])) &
    (for s being FinSequence of L holds
       (len s = 0 implies dropOne.s = <*>L) &
       (1 <= len s implies
          len (dropOne.s) = len s - 1 &
          (for i being Integer st
             0 <= i & i < len (dropOne.s)
           holds nthElem.[dropOne.s,i] = nthElem.[s,i+1]))) &
    (for s1,s2 being FinSequence of L holds
       ([s1,s2] in Disjoint iff
         for i1 being Integer st 0 <= i1 & i1 < len s1
         holds
           for i2 being Integer st 0 <= i2 & i2 < len s2
           holds nthElem.[s1,i1] <> nthElem.[s2,i2])) &
    (for f being Function of L,L,
         p,q being Element of L,
         s being FinSequence of L
     holds
       ([f,[p,[s,q]]] in ListSeg iff
         (for i being Integer st 0 <= i & i < len s
          holds nthElem.[s,i] <> null) &
         ((p = q & len s = 0) or
          (1 <= len s &
           nthElem.[s,0] = p &
           f.(nthElem.[s,len s-1]) = q &
           (for i being Integer st
              0 <= i & i < len s-1
            holds
              f.(nthElem.[s,i]) = nthElem.[s,i+1]))))) &
    [next1,[l1,[l1M,null]]] in ListSeg &
    [next1,[l2,[l2M,null]]] in ListSeg &
    [l1M,l2M] in Disjoint
  holds
    (eqLoc.[l1,null] = TRUE iff l1 = null) implies
      ((eqLoc.[l1,null] = TRUE &
        [next1,[l2,[append.[l1M,l2M],null]]] in ListSeg) or
       (eqLoc.[l1,null] <> TRUE &
        l1 <> null &
        [next1,[l1,[<*>L,l1]]] in ListSeg &
        [next1,[l1,[l1M,null]]] in ListSeg &
        append.[<*>L,l1M] = l1M &
        [<*>L,l1M] in Disjoint &
        (for l1pM,pM being FinSequence of L,
             p being Element of L st
           p <> null &
           [next1,[l1,[l1pM,p]]] in ListSeg &
           [next1,[p,[pM,null]]] in ListSeg &
           append.[l1pM,pM] = l1M &
           [l1pM,pM] in Disjoint
         holds
           p <> null &
           ((eqLoc.[next1.p,null] = TRUE iff next1.p = null)
            implies
              ((eqLoc.[next1.p,null] <> TRUE &
                (0 <= 1 & 1 <= len pM) &
                ((len <*p*> = 1 + len (<*>L) &
                  nthElem.[<*p*>,0] = p &
                  (for i being Integer st
                     0 < i & i <= len (<*>L)
                   holds
                     nthElem.[<*p*>,i] =
                       nthElem.[<*>L,i-1]))
                 implies
                   ((len (append.[l1pM,<*p*>]) =
                       len l1pM + len <*p*> &
                     (for i being Integer st
                        0 <= i & i < len l1pM
                      holds
                        nthElem.[append.[l1pM,<*p*>],i] =
                          nthElem.[l1pM,i]) &
                     (for i being Integer st
                        len l1pM <= i &
                        i < len (append.[l1pM,<*p*>])
                      holds
                        nthElem.[append.[l1pM,<*p*>],i] =
                          nthElem.[<*p*>,i-len l1pM]))
                    implies
                      p <> null &
                      (0 <= len pM &
                       len (dropOne.pM) < len pM) &
                      next1.p <> null &
                      [next1,
                        [l1,[append.[l1pM,<*p*>],next1.p]]]
                          in ListSeg &
                      [next1,
                        [next1.p,[dropOne.pM,null]]]
                          in ListSeg &
                      append.[append.[l1pM,<*p*>],
                        dropOne.pM] = l1M &
                      [append.[l1pM,<*p*>],dropOne.pM]
                        in Disjoint))) or
               (eqLoc.[next1.p,null] = TRUE &
                p <> null &
                [next1+*(p,l2),
                  [l1,[append.[l1M,l2M],null]]]
                    in ListSeg))))))
proof
end;
::$P+
