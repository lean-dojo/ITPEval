:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_list_OCamlMergesort_mergesortqtvc: the list-mergesort
:: verification condition returns a sorted permutation of the input list,
:: using a recursively specified prefix operation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      nthElem being Function of [:E*,INT:],E,
      Sorted being Subset of E*,
      Perm being Relation of E*,E*,
      prefFn being Function of [:INT,E*:],E*,
      l being FinSequence of E
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (<*>E) in Sorted &
    (for x being Element of E holds <*x*> in Sorted) &
    (for x,y being Element of E,
         t being FinSequence of E st
       [x,y] in Leq & <*y*> ^ t in Sorted
     holds <*x*> ^ <*y*> ^ t in Sorted) &
    (for s being FinSequence of E holds
       (s in Sorted iff
         for i,j being Integer st
           0 <= i & i < j & j < len s
         holds [nthElem.[s,i],nthElem.[s,j]] in Leq)) &
    (for s being FinSequence of E,
         x being Element of E holds
       (((for y being Element of E st y in rng s
          holds [x,y] in Leq) &
         s in Sorted)
        iff <*x*> ^ s in Sorted)) &
    (for s,t being FinSequence of E holds
       ((s in Sorted & t in Sorted &
         (for x,y being Element of E st
            x in rng s & y in rng t
          holds [x,y] in Leq))
        iff s ^ t in Sorted)) &
    (for s,t being FinSequence of E holds
       ([s,t] in Perm iff
         len s = len t &
         (for x being Element of E holds
           card {q where q is Integer :
             0 <= q & q < len s & nthElem.[s,q] = x} =
           card {q where q is Integer :
             0 <= q & q < len t & nthElem.[t,q] = x}))) &
    (for s being FinSequence of E holds
       prefFn.[0,s] = <*>E) &
    (for n being Integer,
         x being Element of E,
         t being FinSequence of E st 0 < n
     holds
       prefFn.[n,<*x*> ^ t] = <*x*> ^ prefFn.[n-1,t])
  holds
    for n being Integer st n = len l holds
      (not n < 2 implies 2 <= n & n <= len l) &
      (for result being FinSequence of E holds
         (((n < 2 & result = l) or
           (not n < 2 &
            result in Sorted &
            [result,prefFn.[n,l]] in Perm))
          implies
            result in Sorted & [result,l] in Perm))
proof
end;
::$P+
