:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/gcd_vc_sp_BinaryGcd_binary_gcdqtvc: the binary-GCD verification
:: condition establishes descent and nonnegativity for each parity branch and
:: preserves the greatest common divisor computed by the recursive cases.
:: This file contains no proof.

environ
  vocabularies NUMBERS, INT_1, INT_2, NAT_1, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0,
    SUBSET_1;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, NAT_1;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, INT_2, CARD_1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for u,v being Integer st
    0 <= u &
    0 <= v
  holds
    ((u < v implies
        (((0 <= v & u < v) or
          (v = u & 0 <= u & v < u)) &
         0 <= v &
         0 <= u)) &
     (not u < v implies
        (v <> 0 implies
          2 <> 0 &
          ((u mod 2 = 0 implies
              2 <> 0 &
              ((v mod 2 = 0 implies
                  2 <> 0 &
                  2 <> 0 &
                  (((0 <= v & v div 2 < v) or
                    (v = v div 2 & 0 <= u & u div 2 < u)) &
                   0 <= u div 2 &
                   0 <= v div 2)) &
               (v mod 2 <> 0 implies
                  2 <> 0 &
                  (0 <= u & u div 2 < u) &
                  0 <= u div 2 &
                  0 <= v))) &
           (u mod 2 <> 0 implies
              2 <> 0 &
              ((v mod 2 = 0 implies
                  2 <> 0 &
                  (0 <= v & v div 2 < v) &
                  0 <= u &
                  0 <= v div 2) &
               (v mod 2 <> 0 implies
                  2 <> 0 &
                  (0 <= u & (u - v) div 2 < u) &
                  0 <= (u - v) div 2 &
                  0 <= v))))))) &
    (for result being Integer holds
      (((u < v implies
           result = v gcd u) &
        (not u < v implies
          ((v = 0 implies
              result = u) &
           (v <> 0 implies
             ((u mod 2 = 0 implies
                ((v mod 2 = 0 implies
                    result = 2 * ((u div 2) gcd (v div 2))) &
                 (v mod 2 <> 0 implies
                    result = (u div 2) gcd v))) &
              (u mod 2 <> 0 implies
                ((v mod 2 = 0 implies
                    result = u gcd (v div 2)) &
                 (v mod 2 <> 0 implies
                    result = ((u - v) div 2) gcd v))))))))
       implies
        result = u gcd v))
proof
end;
::$P+
