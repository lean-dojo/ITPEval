:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binomial_heap_BinomialHeap_mergeqtvc: the binomial-heap merge
:: verification condition preserves heap and rank invariants and element
:: multiplicities across the empty, unequal-rank, and linked-root branches.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      Leq being Relation of E,E,
      treeMk being Function of [:E,[:Tree*,INT:]:],Tree,
      treeElem being Function of Tree,E,
      treeChildren being Function of Tree,Tree*,
      treeRank being Function of Tree,INT,
      treeDepth being Function of Tree,NAT,
      LeRoots being Subset of [:E,Tree*:],
      Heaps being Subset of Tree*,
      Occ being Function of [:E,Tree*:],INT,
      HasOrder being Subset of [:INT,Tree*:],
      BinomialTree being Subset of Tree,
      Inv being Subset of [:INT,Tree*:],
      linkTree being Function of [:Tree,Tree:],Tree,
      h1,h2 being FinSequence of Tree,
      k being Integer
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
      [x,y] in Leq & [y,z] in Leq
     holds
      [x,z] in Leq) &
    (for x,y being Element of E holds
      [x,y] in Leq or [y,x] in Leq) &
    (for e being Element of E,
         c being FinSequence of Tree,
         r being Integer
     holds
       treeElem.(treeMk.[e,[c,r]]) = e &
       treeChildren.(treeMk.[e,[c,r]]) = c &
       treeRank.(treeMk.[e,[c,r]]) = r) &
    (for t being Element of Tree holds
      ex e being Element of E,
         c being FinSequence of Tree,
         r being Integer st
        t = treeMk.[e,[c,r]]) &
    (for e being Element of E,
         c being FinSequence of Tree,
         r being Integer,
         i being Nat st i in dom c
     holds
       ex child being Element of Tree,
          childDepth,parentDepth being Nat st
         child = c/.i &
         childDepth = treeDepth.child &
         parentDepth = treeDepth.(treeMk.[e,[c,r]]) &
         childDepth < parentDepth) &
    (for e being Element of E holds
      [e,<*>Tree] in LeRoots) &
    (for e being Element of E,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ([e,<*t*> ^ tl] in LeRoots iff
        [e,treeElem.t] in Leq & [e,tl] in LeRoots)) &
    <*>Tree in Heaps &
    (for t being Element of Tree,
         tl being FinSequence of Tree
     holds
      (<*t*> ^ tl in Heaps iff
        [treeElem.t,treeChildren.t] in LeRoots &
        treeChildren.t in Heaps &
        tl in Heaps)) &
    (for x being Element of E holds
      Occ.[x,<*>Tree] = 0) &
    (for x being Element of E,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ex whole,children,tail being Integer st
        whole = Occ.[x,<*t*> ^ tl] &
        children = Occ.[x,treeChildren.t] &
        tail = Occ.[x,tl] &
        (x = treeElem.t implies whole = 1 + children + tail) &
        (x <> treeElem.t implies whole = children + tail)) &
    (for q being Integer holds
      ([q,<*>Tree] in HasOrder iff q = 0)) &
    (for q being Integer,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ([q,<*t*> ^ tl] in HasOrder iff
        treeRank.t = q - 1 &
        [q - 1,treeChildren.t] in HasOrder &
        [q - 1,tl] in HasOrder)) &
    (for t being Element of Tree holds
      (t in BinomialTree iff
        treeRank.t = len (treeChildren.t) &
        [treeRank.t,treeChildren.t] in HasOrder)) &
    (for q being Integer holds
      [q,<*>Tree] in Inv) &
    (for q being Integer,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ([q,<*t*> ^ tl] in Inv iff
        q <= treeRank.t &
        t in BinomialTree &
        [treeRank.t + 1,tl] in Inv)) &
    (for t1,t2 being Element of Tree holds
      (([treeElem.t1,treeElem.t2] in Leq &
        linkTree.[t1,t2] =
          treeMk.[treeElem.t1,
            [<*t2*> ^ treeChildren.t1,treeRank.t1 + 1]]) or
       (not [treeElem.t1,treeElem.t2] in Leq &
        linkTree.[t1,t2] =
          treeMk.[treeElem.t2,
            [<*t1*> ^ treeChildren.t2,treeRank.t2 + 1]]))) &
    h1 in Heaps &
    [k,h1] in Inv &
    h2 in Heaps &
    [k,h2] in Inv
  holds
    (h2 = <*>Tree or h1 = <*>Tree or
      ex x,x2 being Element of Tree,
         x1,x3 being FinSequence of Tree st
        h2 = <*x*> ^ x1 &
        h1 = <*x2*> ^ x3 &
        ((treeRank.x2 < treeRank.x &
          h1 = <*x2*> ^ x3 &
          x3 in Heaps &
          [treeRank.x2 + 1,x3] in Inv &
          h2 in Heaps &
          [treeRank.x2 + 1,h2] in Inv) or
         (not treeRank.x2 < treeRank.x &
          treeRank.x < treeRank.x2 &
          h2 = <*x*> ^ x1 &
          h1 in Heaps &
          [treeRank.x + 1,h1] in Inv &
          x1 in Heaps &
          [treeRank.x + 1,x1] in Inv) or
         (not treeRank.x2 < treeRank.x &
          not treeRank.x < treeRank.x2 &
          ((h1 = <*x2*> ^ x3 or
            (h1 = x3 & h2 = <*x*> ^ x1)) &
           x3 in Heaps &
           [treeRank.x2 + 1,x3] in Inv &
           x1 in Heaps &
           [treeRank.x2 + 1,x1] in Inv) &
          (for o2 being FinSequence of Tree st
             o2 in Heaps &
             [treeRank.x2 + 1,o2] in Inv &
             (for x4 being Element of E holds
               ex oo2,ox3,ox1 being Integer st
                 oo2 = Occ.[x4,o2] &
                 ox3 = Occ.[x4,x3] &
                 ox1 = Occ.[x4,x1] &
                 oo2 = ox3 + ox1)
           holds
             <*linkTree.[x2,x]*> in Heaps &
             linkTree.[x2,x] in BinomialTree &
             o2 in Heaps &
             [treeRank.(linkTree.[x2,x]),o2] in Inv)))) &
    (for result being FinSequence of Tree st
      ((h2 = <*>Tree &
        ((h1 = <*>Tree & result = h2) or
         (h1 <> <*>Tree & result = h1))) or
       ex x being Element of Tree,
          x1 being FinSequence of Tree st
         h2 = <*x*> ^ x1 &
         ((h1 = <*>Tree & result = h2) or
          ex x2 being Element of Tree,
             x3 being FinSequence of Tree st
            h1 = <*x2*> ^ x3 &
            ((treeRank.x2 < treeRank.x &
              ex o1 being FinSequence of Tree st
                o1 in Heaps &
                [treeRank.x2 + 1,o1] in Inv &
                (for x4 being Element of E holds
                  ex oo1,ox3,oh2 being Integer st
                    oo1 = Occ.[x4,o1] &
                    ox3 = Occ.[x4,x3] &
                    oh2 = Occ.[x4,h2] &
                    oo1 = ox3 + oh2) &
                result = <*x2*> ^ o1) or
             (not treeRank.x2 < treeRank.x &
              treeRank.x < treeRank.x2 &
              ex o1 being FinSequence of Tree st
                o1 in Heaps &
                [treeRank.x + 1,o1] in Inv &
                (for x4 being Element of E holds
                  ex oo1,oh1,ox1 being Integer st
                    oo1 = Occ.[x4,o1] &
                    oh1 = Occ.[x4,h1] &
                    ox1 = Occ.[x4,x1] &
                    oo1 = oh1 + ox1) &
                result = <*x*> ^ o1) or
             (not treeRank.x2 < treeRank.x &
              not treeRank.x < treeRank.x2 &
              ex o1 being FinSequence of Tree st
                o1 in Heaps &
                [treeRank.x2 + 1,o1] in Inv &
                (for x4 being Element of E holds
                  ex oo1,ox3,ox1 being Integer st
                    oo1 = Occ.[x4,o1] &
                    ox3 = Occ.[x4,x3] &
                    ox1 = Occ.[x4,x1] &
                    oo1 = ox3 + ox1) &
                result in Heaps &
                [treeRank.(linkTree.[x2,x]),result] in Inv &
                (for x4 being Element of E holds
                  ex ores,olink,oo1 being Integer st
                    ores = Occ.[x4,result] &
                    olink = Occ.[x4,<*linkTree.[x2,x]*>] &
                    oo1 = Occ.[x4,o1] &
                    ores = olink + oo1)))))
     holds
       result in Heaps &
       [k,result] in Inv &
       (for x being Element of E holds
         ex ores,oh1,oh2 being Integer st
           ores = Occ.[x,result] &
           oh1 = Occ.[x,h1] &
           oh2 = Occ.[x,h2] &
           ores = oh1 + oh2))
proof
end;
::$P+
