:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/kmp_KnuthMorrisPratt_initnextqtvc: the Knuth-Morris-Pratt
:: initialization verification condition establishes and preserves the
:: maximal proper-prefix table invariant. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    MCART_1, NUMBERS,
    XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1,
    INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    MCART_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for C being non empty set,
      c0 being Element of C,
      m being Integer,
      p being Function of INT,C,
      MatchesRel,NextRel being set st
    1 <= m &
    (for q being Integer st q < 0 holds p.q = p.0) &
    (for q being Integer st m <= q holds p.q = c0) &
    (for i1,i2,n being Integer holds
      ([i1,[i2,n]] in MatchesRel iff
        (0 <= i1 & i1 <= m - n) &
        (0 <= i2 & i2 <= m - n) &
        (for r being Integer st 0 <= r & r < n holds
          p.(i1 + r) = p.(i2 + r)))) &
    (for j,n being Integer holds
      ([j,n] in NextRel iff
        (0 <= n & n < j) &
        [j-n,[0,n]] in MatchesRel &
        (for z being Integer st n < z & z < j holds
          not [j-z,[0,z]] in MatchesRel)))
  holds
    0 <= m &
    (for next being Function of INT,INT st
      (for q being Integer st q < 0 holds next.q = next.0) &
      (for q being Integer st m <= q holds next.q = 0) &
      (for q being Integer st 0 <= q & q < m holds next.q = 0)
     holds
      (1 < m implies
        (0 <= 1 & 1 < m) &
        ((m = m & (next+*(1,0)) = (next+*(1,0))) implies
          ((0 <= 0 & 0 < 1 & 1 <= m) &
           [1-0,[0,0]] in MatchesRel &
           (for z being Integer st 0 + 1 < z & z < 1 + 1 holds
             not [1+1-z,[0,z]] in MatchesRel) &
           (for k being Integer st 0 < k & k <= 1 holds
             [k,(next+*(1,0)).k] in NextRel)) &
          (for j,i being Integer,
               next1 being Function of INT,INT st
            (for q being Integer st q < 0
              holds next1.q = next1.0) &
            (for q being Integer st m <= q
              holds next1.q = 0)
           holds
            ((0 <= j & j < i & i <= m) &
             [i-j,[0,j]] in MatchesRel &
             (for z being Integer st j + 1 < z & z < i + 1 holds
               not [i+1-z,[0,z]] in MatchesRel) &
             (for k being Integer st 0 < k & k <= i holds
               [k,next1.k] in NextRel)
             implies
              (i < m - 1 implies
                (0 <= j & j < m) &
                (0 <= i & i < m) &
                ((p.i = p.j implies
                  (0 <= i + 1 & i + 1 < m) &
                  ((m = m &
                    (next1+*(i+1,j+1)) =
                      (next1+*(i+1,j+1))) implies
                    (((0 <= m - i &
                        m - (i + 1) < m - i) or
                       (m - i = m - (i + 1) &
                        0 <= j & j + 1 < j)) &
                     (0 <= j + 1 & j + 1 < i + 1 &
                       i + 1 <= m) &
                     [i+1-(j+1),[0,j+1]] in MatchesRel &
                     (for z being Integer st
                       j + 1 + 1 < z & z < i + 1 + 1
                      holds
                       not [i+1+1-z,[0,z]] in MatchesRel) &
                     (for k being Integer st
                       0 < k & k <= i + 1
                      holds
                       [k,(next1+*(i+1,j+1)).k] in NextRel)))) &
                 (p.i <> p.j implies
                  ((j = 0 implies
                    (0 <= i + 1 & i + 1 < m) &
                    ((m = m &
                      (next1+*(i+1,0)) =
                        (next1+*(i+1,0))) implies
                      (((0 <= m - i &
                          m - (i + 1) < m - i) or
                         (m - i = m - (i + 1) &
                          0 <= j & j < j)) &
                       (0 <= j & j < i + 1 & i + 1 <= m) &
                       [i+1-j,[0,j]] in MatchesRel &
                       (for z being Integer st
                         j + 1 < z & z < i + 1 + 1
                        holds
                         not [i+1+1-z,[0,z]] in MatchesRel) &
                       (for k being Integer st
                         0 < k & k <= i + 1
                        holds
                         [k,(next1+*(i+1,0)).k] in NextRel)))) &
                   (j <> 0 implies
                    (0 <= j & j < m) &
                    (ex nj being Integer st
                      nj = next1.j &
                      ((0 <= m - i & m - i < m - i) or
                       (0 <= j & nj < j)) &
                      (0 <= nj & nj < i & i <= m) &
                      [i-nj,[0,nj]] in MatchesRel &
                      (for z being Integer st
                        nj + 1 < z & z < i + 1
                       holds
                        not [i+1-z,[0,z]] in MatchesRel) &
                      (for k being Integer st 0 < k & k <= i
                       holds
                        [k,next1.k] in NextRel)))))) &
               (not i < m - 1 implies
                m = m &
                (for j1 being Integer st 0 < j1 & j1 < m holds
                  [j1,next1.j1] in NextRel))))))) &
      (not 1 < m implies
        m = m &
        (for j being Integer st 0 < j & j < m holds
          [j,next.j] in NextRel)))
proof
end;
::$P+
