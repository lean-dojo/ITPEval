:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/braun_trees_BraunHeaps_replace_minqtvc: the Braun-heap replace-minimum
:: verification condition preserves heap order, Braun balance, tree size, and
:: element multiplicities while replacing one occurrence of the minimum.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for E,Tree being non empty set,
      Leq being Relation of E,E,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size being Function of Tree,INT,
      Occ being Function of [:E,Tree:],INT,
      LeRoot being Subset of [:E,Tree:],
      Heaps,Inv being Subset of Tree,
      Minimum being Function of Tree,E,
      t being Element of Tree,
      x being Element of E
  st
    (for a being Element of E holds [a,a] in Leq) &
    (for a,b,c being Element of E st
       [a,b] in Leq & [b,c] in Leq
     holds
       [a,c] in Leq) &
    (for a,b being Element of E holds
       [a,b] in Leq or [b,a] in Leq) &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       node.[l,[y,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          y being Element of E st
         u = node.[l,[y,r]]) &
    (for l,l2,r,r2 being Element of Tree,
         y,y2 being Element of E st
       node.[l,[y,r]] = node.[l2,[y2,r2]]
     holds
       l = l2 & y = y2 & r = r2) &
    Size.emptyT = 0 &
    (for u being Element of Tree holds 0 <= Size.u) &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       Size.(node.[l,[y,r]]) = 1 + Size.l + Size.r) &
    (for a being Element of E holds
       Occ.[a,emptyT] = 0) &
    (for a,y being Element of E,
         l,r being Element of Tree
     holds
       ex whole,leftOcc,rightOcc being Integer st
         whole = Occ.[a,node.[l,[y,r]]] &
         leftOcc = Occ.[a,l] &
         rightOcc = Occ.[a,r] &
         (a = y implies whole = 1 + leftOcc + rightOcc) &
         (a <> y implies whole = leftOcc + rightOcc)) &
    (for a being Element of E holds
       [a,emptyT] in LeRoot) &
    (for a,y being Element of E,
         l,r being Element of Tree
     holds
       ([a,node.[l,[y,r]]] in LeRoot iff [a,y] in Leq)) &
    emptyT in Heaps &
    (for y being Element of E,
         l,r being Element of Tree
     holds
       (node.[l,[y,r]] in Heaps iff
          [y,l] in LeRoot & l in Heaps &
          [y,r] in LeRoot & r in Heaps)) &
    emptyT in Inv &
    (for y being Element of E,
         l,r being Element of Tree
     holds
       (node.[l,[y,r]] in Inv iff
          (Size.l = Size.r or Size.l = Size.r + 1) &
          l in Inv & r in Inv)) &
    (for y being Element of E,
         l,r being Element of Tree
     holds
       Minimum.(node.[l,[y,r]]) = y) &
    t in Heaps &
    t in Inv &
    0 < Size.t
  holds
    (ex l,r being Element of Tree,
        y being Element of E st
      t = node.[l,[y,r]] &
      (for o1 being Element of BOOLEAN st
        ((([x,l] in LeRoot &
            (([x,r] in LeRoot & o1 = TRUE) or
             (not [x,r] in LeRoot & o1 = FALSE))) or
           (not [x,l] in LeRoot & o1 = FALSE)) &
          o1 <> TRUE)
       holds
         (l in Heaps & 0 < Size.l) &
         (([Minimum.l,r] in LeRoot &
           (ex f,f1 being Element of Tree,
               z being Element of E st
              t = node.[f,[z,f1]] & (f = l or f1 = l)) &
           l in Heaps &
           l in Inv &
           0 < Size.l) or
          (not [Minimum.l,r] in LeRoot &
           (ex f,f1 being Element of Tree,
               z being Element of E st
              t = node.[f,[z,f1]] & (f = r or f1 = r)) &
           r in Heaps &
           r in Inv &
           0 < Size.r &
           (for o2 being Element of Tree st
             o2 in Heaps &
             o2 in Inv &
             ((x = Minimum.r &
              Occ.[x,o2] = Occ.[x,r]) or
              (x <> Minimum.r &
               ex xO2,xR,minO2,minR being Integer st
                 xO2 = Occ.[x,o2] &
                 xR = Occ.[x,r] &
                 minO2 = Occ.[Minimum.r,o2] &
                 minR = Occ.[Minimum.r,r] &
                 xO2 = xR + 1 &
                 minO2 = minR - 1)) &
             (for e being Element of E st
                e <> x & e <> Minimum.r
              holds
                Occ.[e,o2] = Occ.[e,r]) &
             Size.o2 = Size.r
            holds
              r in Heaps & 0 < Size.r)))))
    &
    (for result being Element of Tree st
      ex l,r being Element of Tree,
         y being Element of E,
         o1 being Element of BOOLEAN st
        t = node.[l,[y,r]] &
        (([x,l] in LeRoot &
          (([x,r] in LeRoot & o1 = TRUE) or
           (not [x,r] in LeRoot & o1 = FALSE))) or
         (not [x,l] in LeRoot & o1 = FALSE)) &
        ((o1 = TRUE &
          result = node.[l,[x,r]]) or
         (o1 <> TRUE &
          (([Minimum.l,r] in LeRoot &
            ex o2 being Element of Tree st
              o2 in Heaps &
              o2 in Inv &
              ((x = Minimum.l &
                Occ.[x,o2] = Occ.[x,l]) or
               (x <> Minimum.l &
                ex xO2,xL,minO2,minL being Integer st
                  xO2 = Occ.[x,o2] &
                  xL = Occ.[x,l] &
                  minO2 = Occ.[Minimum.l,o2] &
                  minL = Occ.[Minimum.l,l] &
                  xO2 = xL + 1 &
                  minO2 = minL - 1)) &
              (for e being Element of E st
                 e <> x & e <> Minimum.l
               holds
                 Occ.[e,o2] = Occ.[e,l]) &
              Size.o2 = Size.l &
              result = node.[o2,[Minimum.l,r]]) or
           (not [Minimum.l,r] in LeRoot &
            ex o2 being Element of Tree st
              o2 in Heaps &
              o2 in Inv &
              ((x = Minimum.r &
                Occ.[x,o2] = Occ.[x,r]) or
               (x <> Minimum.r &
                ex xO2,xR,minO2,minR being Integer st
                  xO2 = Occ.[x,o2] &
                  xR = Occ.[x,r] &
                  minO2 = Occ.[Minimum.r,o2] &
                  minR = Occ.[Minimum.r,r] &
                  xO2 = xR + 1 &
                  minO2 = minR - 1)) &
              (for e being Element of E st
                 e <> x & e <> Minimum.r
               holds
                 Occ.[e,o2] = Occ.[e,r]) &
              Size.o2 = Size.r &
              result = node.[l,[Minimum.r,o2]]))))
     holds
       result in Heaps &
       result in Inv &
       ((x = Minimum.t &
         Occ.[x,result] = Occ.[x,t]) or
        (x <> Minimum.t &
         ex xResult,xT,minResult,minT being Integer st
           xResult = Occ.[x,result] &
           xT = Occ.[x,t] &
           minResult = Occ.[Minimum.t,result] &
           minT = Occ.[Minimum.t,t] &
           xResult = xT + 1 &
           minResult = minT - 1)) &
       (for e being Element of E st
          e <> x & e <> Minimum.t
        holds
          Occ.[e,result] = Occ.[e,t]) &
       Size.result = Size.t)
proof
end;
::$P+
