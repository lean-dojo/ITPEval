:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/unraveling_a_card_trick_GilbreathCardTrick_card_trickqtvc
:: (ntp4vc__mizar__pearl/unraveling_a_card_trick_GilbreathCardTrick_card_trickqtvc):
:: the Gilbreath card-trick verification condition for cutting an ordered
:: integer-card stack, reversing the cut stack, and riffle-shuffling the two
:: parts to obtain suit-sorted blocks. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_5;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Stack being non empty set,
      elts being Function of Stack,INT*,
      NthSome,SuitOrdered,SuitSorted being
        Subset of [:INT*,[:INT,INT:]:],
      Shuffle being Subset of [:INT*,[:INT*,INT*:]:],
      m,n being Integer,
      a,dPrime being Element of Stack
  st
    0 < m &
    0 <= n &
    (for s being FinSequence of INT,
         i,v being Integer holds
       ([s,[i,v]] in NthSome iff
         0 <= i & i < len s & s.(i+1) = v)) &
    (for s being FinSequence of INT,
         nn,mm being Integer holds
       ([s,[nn,mm]] in SuitOrdered iff
         for i,j being Integer st
           0 <= i & i < nn
         holds
           0 <= j & j < mm implies
             [s,[i*mm+j,j]] in NthSome)) &
    (for s being FinSequence of INT,
         nn,mm being Integer holds
       ([s,[nn,mm]] in SuitSorted iff
         (for i,v being Integer st
            [s,[i,v]] in NthSome
          holds 0 <= v & v < mm) &
         (for i,j1,j2 being Integer st
            0 <= i & i < nn &
            0 <= j1 & j1 < mm &
            0 <= j2 & j2 < mm
          holds
            (ex v being Integer st
               [s,[i*mm+j1,v]] in NthSome &
               not [s,[i*mm+j2,v]] in NthSome) or
            (ex v being Integer st
               [s,[i*mm+j2,v]] in NthSome &
               not [s,[i*mm+j1,v]] in NthSome)))) &
    (for p,q,r being FinSequence of INT holds
       ([p,[q,r]] in Shuffle iff
         for R being set st
           (for l being FinSequence of INT holds
              [l,[<*>INT,l]] in R &
              [<*>INT,[l,l]] in R) &
           (for x being Integer,
                p1,q1,r1 being FinSequence of INT st
              [p1,[q1,r1]] in R
            holds
              [<*x*> ^ p1,[q1,<*x*> ^ r1]] in R &
              [p1,[<*x*> ^ q1,<*x*> ^ r1]] in R)
         holds [p,[q,r]] in R)) &
    (for ordered,c,d,shuffled being FinSequence of INT st
       len ordered = n*m &
       [ordered,[n,m]] in SuitOrdered &
       ordered = c ^ d &
       [c,[Rev d,shuffled]] in Shuffle
     holds [shuffled,[n,m]] in SuitSorted) &
    len (elts.a) = n*m &
    [elts.a,[n,m]] in SuitOrdered &
    elts.dPrime = <*>INT
  holds
    (ex result being Integer st
       0 <= result & result <= n*m) &
    (for cut being Integer st
       0 <= cut & cut <= n*m
     holds
       (1 <= cut+1 implies
          (len (elts.a) = n*m-1+1 &
           len (elts.dPrime) = 1-1 &
           elts.a = Rev (elts.dPrime) ^ elts.a) &
          (for d1,a1 being Element of Stack holds
             (for i being Integer st
                (1 <= i & i <= cut) &
                len (elts.a1) = n*m-i+1 &
                len (elts.d1) = i-1 &
                elts.a = Rev (elts.d1) ^ elts.a1
              holds
                elts.a1 <> <*>INT &
                (for a2 being Element of Stack,
                     o1 being Integer st
                   elts.a1 = <*o1*> ^ elts.a2
                 holds
                   for d2 being Element of Stack st
                     elts.d2 = <*o1*> ^ elts.d1
                   holds
                     len (elts.a2) = n*m-(i+1)+1 &
                     len (elts.d2) = i+1-1 &
                     elts.a = Rev (elts.d2) ^ elts.a2)) &
             (len (elts.a1) = n*m-(cut+1)+1 &
              len (elts.d1) = cut+1-1 &
              elts.a = Rev (elts.d1) ^ elts.a1
              implies
                for d2,a2,result being Element of Stack st
                  elts.a2 = <*>INT &
                  elts.d2 = <*>INT &
                  [Rev (elts.a1),
                    [Rev (elts.d1),elts.result]] in Shuffle
                holds
                  len (elts.result) = n*m &
                  [elts.result,[n,m]] in SuitSorted))) &
       (cut+1 < 1 implies
          for d1,a1,result being Element of Stack st
            elts.a1 = <*>INT &
            elts.d1 = <*>INT &
            [Rev (elts.a),
              [Rev (elts.dPrime),elts.result]] in Shuffle
          holds
            len (elts.result) = n*m &
            [elts.result,[n,m]] in SuitSorted))
proof
end;
::$P+
