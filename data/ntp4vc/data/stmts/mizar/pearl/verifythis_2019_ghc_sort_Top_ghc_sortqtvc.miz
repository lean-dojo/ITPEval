:: Statement-only formalization of NTP4VC corpus artifact
:: pearl/verifythis_2019_ghc_sort_Top_ghc_sortqtvc: the final GHC-sort
:: verification condition states that copying a nondecreasing integer list
:: with the input multiplicities produces a sorted permutation. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    CLASSES1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2, CLASSES1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2, CLASSES1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being FinSequence of INT holds
    (len a = 0 implies
      (for i,j being Nat st
         i in dom a & j in dom a & i <= j
       holds a/.i <= a/.j) &
      a,a are_fiberwise_equipotent) &
    (len a <> 0 implies
      0 < len a &
      (for l being FinSequence of INT st
         (for i,j being Nat st
            i in dom l & j in dom l & i <= j
          holds l/.i <= l/.j) &
         a,l are_fiberwise_equipotent &
         len l = len a
       holds
         (0 <= 0 & len l = len a - 0) &
         (for a1 being FinSequence of INT st
            len a1 = len a
          holds
            ((for x being Integer st
                0 <= x & x < len a1
              holds a1.(x+1) = l.(x-0+1)) &
             (for x being Integer st
                0 <= x & x < 0
              holds a1.(x+1) = a.(x+1)) &
             a1,l are_fiberwise_equipotent)
            implies
              (for i,j being Nat st
                 i in dom a1 & j in dom a1 & i <= j
               holds a1/.i <= a1/.j) &
              a1,a are_fiberwise_equipotent)))
proof
end;
::$P+
