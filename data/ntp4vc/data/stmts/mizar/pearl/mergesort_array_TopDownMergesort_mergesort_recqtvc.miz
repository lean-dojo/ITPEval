:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_array_TopDownMergesort_mergesort_recqtvc:
:: the top-down mergesort recursion verification condition tracks midpoint
:: termination, sorted subarrays, subarray permutations, and unchanged entries.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      nthElem being Function of [:E*,INT:],E,
      SortedSub being Subset of [:E*,[:INT,INT:]:],
      PermSub being Subset of [:E*,[:E*,[:INT,INT:]:]:],
      PermSubPrime being Subset of
        [:E*,[:E*,[:INT,INT:]:]:],
      l,r being Integer,
      a,tmp being FinSequence of E
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (for s being FinSequence of E, lo,hi being Integer holds
       ([s,[lo,hi]] in SortedSub iff
         for i1,i2 being Integer st
           lo <= i1 & i1 < i2 & i2 < hi
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s,t being FinSequence of E, lo,hi being Integer holds
       ([s,[t,[lo,hi]]] in PermSub iff
         len s = len t &
         0 <= max(lo,0) & max(lo,0) <= len s &
         0 <= max(hi,0) & max(hi,0) <= len s &
         (for x being Element of E holds
           card {q where q is Integer :
             max(lo,0) <= q & q < max(hi,0) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(lo,0) <= q & q < max(hi,0) &
             nthElem.[t,q] = x}))) &
    (for s,t being FinSequence of E, lo,hi being Integer holds
       ([s,[t,[lo,hi]]] in PermSubPrime iff
         len s = len t &
         (for q being Integer st
            0 <= q & q < min(max(lo,0),len s)
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for q being Integer st
            max(hi,0) <= q & q < len s
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for x being Element of E holds
           card {q where q is Integer :
             max(lo,0) <= q &
             q < min(max(hi,0),len s) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(lo,0) <= q &
             q < min(max(hi,0),len t) &
             nthElem.[t,q] = x}))) &
    0 <= l &
    l <= r &
    r <= len a &
    len a = len tmp
  holds
    (r - 1 <= l implies
      [a,[l,r]] in SortedSub &
      [a,[a,[l,r]]] in PermSubPrime) &
    ((not r - 1 <= l) implies
      2 <> 0 &
      (for m being Integer st
         m = l + (r-l) div 2
       holds
         ((0 <= r-l & m-l < r-l) &
          0 <= l &
          l <= m &
          m <= len a &
          len a = len tmp) &
         (for tmp1,a1 being FinSequence of E st
            len tmp1 = len tmp &
            len a1 = len a &
            [a1,[l,m]] in SortedSub &
            [a,[a1,[l,m]]] in PermSubPrime
          holds
            ((0 <= r-l & r-m < r-l) &
             0 <= m &
             m <= r &
             r <= len a1 &
             len a1 = len tmp1) &
            (for tmp2,a2 being FinSequence of E st
               len tmp2 = len tmp1 &
               len a2 = len a1 &
               [a2,[m,r]] in SortedSub &
               [a1,[a2,[m,r]]] in PermSubPrime
             holds
               (((0 <= l &
                  l <= m &
                  m <= r &
                  r <= len tmp2 &
                  len tmp2 = len a2) &
                 [a2,[l,m]] in SortedSub &
                 [a2,[m,r]] in SortedSub) &
                (for a3 being FinSequence of E st
                   len a3 = len a2 &
                   [a3,[l,r]] in SortedSub &
                   [a2,[a3,[l,r]]] in PermSub &
                   (for i being Integer st
                      (0 <= i & i < l) or
                      (r <= i & i < len a3)
                    holds
                      nthElem.[a3,i] = nthElem.[a2,i])
                 holds
                   [a3,[l,r]] in SortedSub &
                   [a,[a3,[l,r]]] in PermSubPrime))))))
proof
end;
::$P+
