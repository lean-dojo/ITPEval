:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2019_ghc_sort_Top_sorted_listsqtvc: the recursive
:: construction of nondecreasing runs from ordered monotonic cutpoint
:: segments preserves sortedness and element multiplicities. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, PBOOLE, PRE_POLY, FINSET_1, CLASSES1,
    MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    PBOOLE, PRE_POLY, FINSET_1, CLASSES1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, PRE_POLY, FINSET_1,
    CLASSES1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, FRAENKEL,
    XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nthZ being Function of [:INT*,INT:],INT,
      StrictInc,Nondecr,Nonincr being Subset of INT*,
      orderF being Function of INT*,INT*,
      cutList,cutSeq,s being FinSequence of INT
  st
    (for xs being FinSequence of INT, k being Integer holds
       (len xs = 0 implies nthZ.[xs,k] = 0) &
       (0 < len xs & k < 0 implies nthZ.[xs,k] = xs.1) &
       (0 <= k & k < len xs implies
          nthZ.[xs,k] = xs.(k+1)) &
       (len xs <= k implies nthZ.[xs,k] = 0)) &
    (for xs being FinSequence of INT holds
       (xs in StrictInc iff
         for i,j being Integer st
           0 <= i & i < j & j < len xs
         holds nthZ.[xs,i] < nthZ.[xs,j])) &
    (for xs being FinSequence of INT holds
       (xs in Nondecr iff
         for i,j being Integer st
           0 <= i & i < j & j < len xs
         holds nthZ.[xs,i] <= nthZ.[xs,j])) &
    (for xs being FinSequence of INT holds
       (xs in Nonincr iff
         for i,j being Integer st
           0 <= i & i < j & j < len xs
         holds nthZ.[xs,j] <= nthZ.[xs,i])) &
    (for xs being FinSequence of INT st
       xs in StrictInc or xs in Nonincr
     holds
       ((len xs <= 1 & orderF.xs = xs) or
        (2 <= len xs &
          ((nthZ.[xs,0] < nthZ.[xs,1] &
            orderF.xs = xs) or
           (not nthZ.[xs,0] < nthZ.[xs,1] &
            orderF.xs = Rev xs)))) &
       orderF.xs in Nondecr &
       xs,orderF.xs are_fiberwise_equipotent) &
    cutSeq = Rev cutList &
    0 < len cutList &
    (for x,y being Integer st
       0 <= x & x < y & y < len cutSeq
     holds nthZ.[cutSeq,x] <= nthZ.[cutSeq,y]) &
    (for z being Integer st z in rng cutList
     holds 0 <= z & z <= len s) &
    (for k being Integer st
       0 <= k & k < len cutSeq - 1
     holds
       (for z1,z2 being Integer st
          nthZ.[cutSeq,k] <= z1 & z1 < z2 &
          z2 < nthZ.[cutSeq,k+1]
        holds nthZ.[s,z1] < nthZ.[s,z2]) or
       (for z1,z2 being Integer st
          nthZ.[cutSeq,k] <= z1 & z1 < z2 &
          z2 < nthZ.[cutSeq,k+1]
        holds nthZ.[s,z2] <= nthZ.[s,z1]))
  holds
    (len cutList <= 1 or
      for h1,h2 being Integer,
          t being FinSequence of INT st
        cutList = <*h1,h2*> ^ t
      holds
        (0 <= h2 & h2 <= len s) &
        (0 <= h1 & h1 <= len s) &
        ((for z1,z2 being Integer st
            h2 <= z1 & z1 < z2 & z2 < h1
          holds nthZ.[s,z1] < nthZ.[s,z2]) or
         (for z1,z2 being Integer st
            h2 <= z1 & z1 < z2 & z2 < h1
          holds nthZ.[s,z2] <= nthZ.[s,z1])) &
        (for seqi being FinSequence of INT st
           (for x being Integer holds
              card {q where q is Integer :
                0 <= q & q < len seqi &
                nthZ.[seqi,q] = x} =
              card {q where q is Integer :
                h2 <= q & q < h1 &
                nthZ.[s,q] = x}) &
           (for x being Integer st x in rng seqi
            holds
              ex z being Integer st
                h2 <= z & z < h1 & nthZ.[s,z] = x) &
           (((for z1,z2 being Integer st
                h2 <= z1 & z1 < z2 & z2 < h1
              holds nthZ.[s,z1] < nthZ.[s,z2])
             implies seqi in StrictInc) &
            ((for z1,z2 being Integer st
                h2 <= z1 & z1 < z2 & z2 < h1
              holds nthZ.[s,z2] <= nthZ.[s,z1])
             implies seqi in Nonincr)) &
           (seqi in StrictInc or seqi in Nonincr)
         holds
           (0 <= 0 &
            0 <= len cutSeq - 1 &
            len cutSeq - 1 <= len cutSeq) &
           (for prefSeq being FinSequence of INT st
              len prefSeq = len cutSeq - 1 &
              (for k being Integer st
                 0 <= k & k < len cutSeq - 1
               holds nthZ.[prefSeq,k] = nthZ.[cutSeq,k])
            holds
              prefSeq = Rev (<*h2*> ^ t) &
              (for lList,lSeq being FinSequence of INT st
                 lList = <*h2*> ^ t &
                 lSeq = prefSeq &
                 lSeq = Rev lList
               holds
                 cutList = <*h1*> ^ lList &
                 0 < len lList &
                 (for x,y being Integer st
                    0 <= x & x < y & y < len lSeq
                  holds nthZ.[lSeq,x] <= nthZ.[lSeq,y]) &
                 (for z being Integer st z in rng lList
                  holds 0 <= z & z <= len s) &
                 (for k being Integer st
                    0 <= k & k < len lSeq - 1
                  holds
                    (for z1,z2 being Integer st
                       nthZ.[lSeq,k] <= z1 & z1 < z2 &
                       z2 < nthZ.[lSeq,k+1]
                     holds nthZ.[s,z1] < nthZ.[s,z2]) or
                    (for z1,z2 being Integer st
                       nthZ.[lSeq,k] <= z1 & z1 < z2 &
                       z2 < nthZ.[lSeq,k+1]
                     holds nthZ.[s,z2] <= nthZ.[s,z1])) &
                 (for recursiveResult being
                      FinSequence of INT* st
                    (for l being FinSequence of INT st
                       l in rng recursiveResult
                     holds l in Nondecr) &
                    (for x being Integer holds
                       card {q where q is Integer :
                         0 <= q &
                         q < len (FlattenSeq recursiveResult) &
                         nthZ.[FlattenSeq recursiveResult,q] = x} =
                       card {q where q is Integer :
                         nthZ.[lSeq,0] <= q &
                         q < nthZ.[lSeq,len lSeq-1] &
                         nthZ.[s,q] = x})
                  holds seqi in StrictInc or seqi in Nonincr))))) &
    (for result being FinSequence of INT* st
       ((len cutList <= 1 & result = <*>INT*) or
        (ex h1,h2 being Integer,
            t,seqi,prefSeq,lList,lSeq being
              FinSequence of INT,
            recursiveResult being FinSequence of INT* st
          cutList = <*h1,h2*> ^ t &
          (for x being Integer holds
             card {q where q is Integer :
               0 <= q & q < len seqi &
               nthZ.[seqi,q] = x} =
             card {q where q is Integer :
               h2 <= q & q < h1 &
               nthZ.[s,q] = x}) &
          (for x being Integer st x in rng seqi
           holds
             ex z being Integer st
               h2 <= z & z < h1 & nthZ.[s,z] = x) &
          (((for z1,z2 being Integer st
               h2 <= z1 & z1 < z2 & z2 < h1
             holds nthZ.[s,z1] < nthZ.[s,z2])
            implies seqi in StrictInc) &
           ((for z1,z2 being Integer st
               h2 <= z1 & z1 < z2 & z2 < h1
             holds nthZ.[s,z2] <= nthZ.[s,z1])
            implies seqi in Nonincr)) &
          (seqi in StrictInc or seqi in Nonincr) &
          len prefSeq = len cutSeq - 1 &
          (for k being Integer st
             0 <= k & k < len cutSeq - 1
           holds nthZ.[prefSeq,k] = nthZ.[cutSeq,k]) &
          lList = <*h2*> ^ t &
          lSeq = prefSeq &
          lSeq = Rev lList &
          (for l being FinSequence of INT st
             l in rng recursiveResult
           holds l in Nondecr) &
          (for x being Integer holds
             card {q where q is Integer :
               0 <= q &
               q < len (FlattenSeq recursiveResult) &
               nthZ.[FlattenSeq recursiveResult,q] = x} =
             card {q where q is Integer :
               nthZ.[lSeq,0] <= q &
               q < nthZ.[lSeq,len lSeq-1] &
               nthZ.[s,q] = x}) &
          result = <*orderF.seqi*> ^ recursiveResult))
     holds
       (for l being FinSequence of INT st l in rng result
        holds l in Nondecr) &
       (for x being Integer holds
          card {q where q is Integer :
            0 <= q & q < len (FlattenSeq result) &
            nthZ.[FlattenSeq result,q] = x} =
          card {q where q is Integer :
            nthZ.[cutSeq,0] <= q &
            q < nthZ.[cutSeq,len cutSeq-1] &
            nthZ.[s,q] = x}))
proof
end;
::$P+
