:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sf_HoareLogic_parityqtvc: the parity-loop verification condition over
:: unbounded integers, with inductively generated evenness, loop-invariant
:: initialization and decrement preservation, and the exit characterization.
:: This file contains no proof.

environ
  vocabularies NUMBERS, INT_1, NAT_1, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0,
    SUBSET_1;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, NAT_1;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, CARD_1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Integer st 0 <= x holds
    0 <= x &
    ((ex n being Nat st x - x = 2 * n) or
      (0 = 1 & (ex n being Nat st x - x + 1 = 2 * n))) &
    (for y,x1 being Integer st
      0 <= x1 &
      ((y = 0 & (ex n being Nat st x - x1 = 2 * n)) or
       (y = 1 & (ex n being Nat st x - x1 + 1 = 2 * n)))
     holds
      (x1 <> 0 implies
        (0 <= x1 & x1 - 1 < x1) &
        0 <= x1 - 1 &
        (((1 - y) = 0 &
          (ex n being Nat st x - (x1 - 1) = 2 * n)) or
         ((1 - y) = 1 &
          (ex n being Nat st x - (x1 - 1) + 1 = 2 * n)))) &
      (x1 = 0 implies
        (y = 0 iff (ex n being Nat st x = 2 * n))))
proof
end;
::$P+
