:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/queens_NQueensSets_t3qtvc: the finite-set N-queens recursive-loop
:: verification condition preserves partial solutions, sorted enumeration,
:: candidate-set invariants, and function-update prefixes. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for EqPrefixI being Subset of
        [:Funcs(INT,INT),[:Funcs(INT,INT),INT:]:],
      EqPrefixS being Subset of
        [:Funcs(INT,Funcs(INT,INT)),
          [:Funcs(INT,Funcs(INT,INT)),INT:]:],
      PartialSolution being Subset of [:INT,Funcs(INT,INT):],
      LtSol being Relation of Funcs(INT,INT),Funcs(INT,INT),
      Sorted being Subset of
        [:Funcs(INT,Funcs(INT,INT)),[:INT,INT:]:],
      n,k,s being Integer,
      a,b,c being finite Subset of INT,
      col being Function of INT,INT,
      sol being Function of INT,Funcs(INT,INT)
  st
    (for t,u being Function of INT,INT, i being Integer holds
       ([t,[u,i]] in EqPrefixI iff
         for q being Integer st 0 <= q & q < i
         holds t.q = u.q)) &
    (for t,u being Function of INT,Funcs(INT,INT),
         i being Integer
     holds
       ([t,[u,i]] in EqPrefixS iff
         for q being Integer st 0 <= q & q < i
         holds t.q = u.q)) &
    (for q being Integer, t being Function of INT,INT holds
       ([q,t] in PartialSolution iff
         for i being Integer st 0 <= i & i < q
         holds
           (0 <= In(t.i,INT) & In(t.i,INT) < n) &
           (for j being Integer st 0 <= j & j < i
            holds
              t.i <> t.j &
              In(t.i,INT) - In(t.j,INT) <> i - j &
              In(t.i,INT) - In(t.j,INT) <> j - i))) &
    (for t,u being Function of INT,INT holds
       ([t,u] in LtSol iff
         ex i being Integer st
           0 <= i & i < n &
           [t,[u,i]] in EqPrefixI &
           In(t.i,INT) < In(u.i,INT))) &
    (for z being Function of INT,Funcs(INT,INT),
         aa,bb being Integer
     holds
       ([z,[aa,bb]] in Sorted iff
         for i,j being Integer st aa <= i & i < j & j < bb
         holds [z.i,z.j] in LtSol)) &
    0 <= k &
    k + card a = n &
    0 <= s &
    (for i being Integer holds
       (i in a iff
         (0 <= i & i < n) &
         (for j being Integer st 0 <= j & j < k
          holds col.j <> i))) &
    (for i being Integer st 0 <= i holds
       (not i in b iff
         for j being Integer st 0 <= j & j < k
         holds col.j <> i + j - k)) &
    (for i being Integer st 0 <= i holds
       (not i in c iff
         for j being Integer st 0 <= j & j < k
         holds col.j <> i + k - j)) &
    [k,col] in PartialSolution
  holds
    (a <> {} &
      (for o1 being finite Subset of INT st o1 = a \ b
       holds
        for o2 being finite Subset of INT st o2 = o1 \ c
        holds
          (((0 = s - s & 0 <= s - s) &
              o2 c= (a \ b) \ c &
              [k,col] in PartialSolution &
              [sol,[s,s]] in Sorted &
              (for i,j being Integer st
                 i in o2 \ o2 & j in o2
               holds i < j)) &
            (for i being Integer st s <= i & i < s
             holds
               [n,sol.i] in PartialSolution &
               [col,[sol.i,k]] in EqPrefixI &
               (sol.i).k in o2 \ o2) &
            (for t being Function of INT,INT st
               [n,t] in PartialSolution &
               [col,[t,k]] in EqPrefixI &
               t.k in o2 \ o2
             holds
               t.k in o2 &
               not t.k in o2 &
               (ex i being Integer st
                  s <= i & i < s &
                  [t,[sol.i,n]] in EqPrefixI)) &
            [col,[col,k]] in EqPrefixI &
            [sol,[sol,s]] in EqPrefixS) &
           (for e being finite Subset of INT,
                s1 being Integer,
                sol1 being Function of INT,Funcs(INT,INT),
                col1 being Function of INT,INT
            st
              (0 <= s1 - s &
               e c= (a \ b) \ c &
               [k,col1] in PartialSolution &
               [sol1,[s,s1]] in Sorted &
               (for i,j being Integer st
                  i in o2 \ e & j in e
                holds i < j)) &
              (for i being Integer st s <= i & i < s1
               holds
                 [n,sol1.i] in PartialSolution &
                 [col1,[sol1.i,k]] in EqPrefixI &
                 (sol1.i).k in o2 \ e) &
              (for t being Function of INT,INT st
                 [n,t] in PartialSolution &
                 [col1,[t,k]] in EqPrefixI &
                 t.k in o2 \ e
               holds
                 t.k in o2 &
                 not t.k in e &
                 (ex i being Integer st
                    s <= i & i < s1 &
                    [t,[sol1.i,n]] in EqPrefixI)) &
              [col,[col1,k]] in EqPrefixI &
              [sol,[sol1,s]] in EqPrefixS
            holds
              (e <> {} &
                (for d being Integer st
                   d in e &
                   (for x being Integer st x in e holds d <= x)
                 holds
                  for o3 being finite Subset of INT st
                    o3 = c \/ {d} &
                    (d in c implies card o3 = card c) &
                    (not d in c implies card o3 = card c + 1)
                  holds
                    for o4 being finite Subset of INT st
                      (for i being Integer holds
                         (i in o4 iff 0 <= i & i + 1 in o3))
                    holds
                      for o5 being finite Subset of INT st
                        o5 = b \/ {d} &
                        (d in b implies card o5 = card b) &
                        (not d in b implies card o5 = card b + 1)
                      holds
                        for o6 being finite Subset of INT st
                          (for i being Integer holds
                             (i in o6 iff 1 <= i & i - 1 in o5))
                        holds
                          for o7 being finite Subset of INT st
                            o7 = a \ {d} &
                            (d in a implies card o7 = card a - 1) &
                            (not d in a implies card o7 = card a)
                          holds
                            ((0 <= card a & card o7 < card a) &
                             0 <= k + 1 &
                             k + 1 + card o7 = n &
                             0 <= s1 &
                             (for i being Integer holds
                                (i in o7 iff
                                  (0 <= i & i < n) &
                                  (for j being Integer st
                                     0 <= j & j < k + 1
                                   holds
                                     (col1+*(k,d)).j <> i))) &
                             (for i being Integer st 0 <= i
                              holds
                                (not i in o6 iff
                                  for j being Integer st
                                    0 <= j & j < k + 1
                                  holds
                                    (col1+*(k,d)).j <>
                                      i + j - (k + 1))) &
                             (for i being Integer st 0 <= i
                              holds
                                (not i in o4 iff
                                  for j being Integer st
                                    0 <= j & j < k + 1
                                  holds
                                    (col1+*(k,d)).j <>
                                      i + (k + 1) - j)) &
                             [k+1,col1+*(k,d)] in PartialSolution) &
                            (for s2 being Integer,
                                 sol2 being
                                   Function of INT,Funcs(INT,INT),
                                 col2 being Function of INT,INT
                             st
                               0 <= s2 - s1 &
                               [sol2,[s1,s2]] in Sorted &
                               (for t being Function of INT,INT
                                holds
                                  ([n,t] in PartialSolution &
                                   [col2,[t,k+1]] in EqPrefixI
                                   iff
                                   ex i being Integer st
                                     s1 <= i & i < s2 &
                                     [t,[sol2.i,n]]
                                       in EqPrefixI)) &
                               [col1+*(k,d),[col2,k+1]]
                                 in EqPrefixI &
                               [sol1,[sol2,s1]] in EqPrefixS
                             holds
                               for o8 being finite Subset of INT st
                                 o8 = e \ {d} &
                                 (d in e implies
                                    card o8 = card e - 1) &
                                 (not d in e implies
                                    card o8 = card e)
                               holds
                                 (0 <= card e &
                                  card o8 < card e) &
                                 ((s1 - s + (s2 - s1) = s2 - s &
                                   0 <= s2 - s) &
                                  k + 1 - 1 = k &
                                  o8 c= (a \ b) \ c &
                                  [k+1-1,col2]
                                    in PartialSolution &
                                  [sol2,[s,s2]] in Sorted &
                                  (for i,j being Integer st
                                     i in o2 \ o8 & j in o8
                                   holds i < j)) &
                                 (for i being Integer st
                                    s <= i & i < s2
                                  holds
                                    [n,sol2.i]
                                      in PartialSolution &
                                    [col2,[sol2.i,k+1-1]]
                                      in EqPrefixI &
                                    (sol2.i).(k+1-1)
                                      in o2 \ o8) &
                                 (for t being Function of INT,INT st
                                    [n,t] in PartialSolution &
                                    [col2,[t,k+1-1]]
                                      in EqPrefixI &
                                    t.(k+1-1) in o2 \ o8
                                  holds
                                    t.(k+1-1) in o2 &
                                    not t.(k+1-1) in o8 &
                                    (ex i being Integer st
                                       s <= i & i < s2 &
                                       [t,[sol2.i,n]]
                                         in EqPrefixI)) &
                                 [col,[col2,k+1-1]]
                                   in EqPrefixI &
                                 [sol,[sol2,s]]
                                   in EqPrefixS))) or
              (e = {} &
                0 <= s1 - s &
                [sol1,[s,s1]] in Sorted &
                (for t being Function of INT,INT holds
                   ([n,t] in PartialSolution &
                    [col1,[t,k]] in EqPrefixI
                    iff
                    ex i being Integer st
                      s <= i & i < s1 &
                      [t,[sol1.i,n]] in EqPrefixI)) &
                [col,[col1,k]] in EqPrefixI &
                [sol,[sol1,s]] in EqPrefixS)))) or
    (a = {} &
      (1 = s + 1 - s & 0 <= s + 1 - s) &
      [sol+*(s,col),[s,s+1]] in Sorted &
      (for t being Function of INT,INT holds
         ([n,t] in PartialSolution &
          [col,[t,k]] in EqPrefixI
          iff
          ex i being Integer st
            s <= i & i < s + 1 &
            [t,[(sol+*(s,col)).i,n]] in EqPrefixI)) &
      [col,[col,k]] in EqPrefixI &
      [sol,[sol+*(s,col),s]] in EqPrefixS)
proof
end;
::$P+
