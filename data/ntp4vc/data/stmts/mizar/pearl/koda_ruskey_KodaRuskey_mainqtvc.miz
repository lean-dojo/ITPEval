:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/koda_ruskey_KodaRuskey_mainqtvc: the Koda-Ruskey forest-coloring
:: main verification condition, establishing the initial stack invariants
:: and completeness and pairwise distinctness of stored colorings.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1,
    MARGREL1, XBOOLEAN;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Forest,C,Coloring being non empty set,
      emptyF being Element of Forest,
      Default,White,Black being Element of C,
      node being Function of [:INT,[:Forest,Forest:]:],Forest,
      Apply being Function of [:Coloring,INT:],C,
      ListColoring being Function of C*,Coloring,
      nthColor being Function of [:C*,INT:],C,
      SizeF,CountF being Function of Forest,INT,
      CountS being Function of Forest*,INT,
      MemF being Subset of [:INT,Forest:],
      NoRepeated,EvenF being Subset of Forest,
      ValidNums being Subset of [:Forest,INT:],
      WhiteF,ValidC,FinalF being Subset of [:Forest,Coloring:],
      MemS being Subset of [:INT,Forest*:],
      AnyS being Subset of [:Forest*,Coloring:],
      Inverse being Subset of [:Forest*,[:Coloring,Coloring:]:],
      SubRel being Subset of [:Forest*,[:Forest,Coloring:]:],
      Stored being Subset of
        [:[:Forest,Coloring:],[:Forest*,[:Coloring*,Coloring*:]:]:],
      f0 being Element of Forest,
      bs being FinSequence of C
  st
    White <> Black &
    (for v being Element of C holds v = White or v = Black) &
    (for c1,c2 being Element of Coloring st
       (for i being Integer holds Apply.[c1,i] = Apply.[c2,i])
     holds c1 = c2) &
    (for g being Function of INT,C holds
       ex c being Element of Coloring st
         for i being Integer holds Apply.[c,i] = g.i) &
    (for xs being FinSequence of C, i being Integer holds
       Apply.[ListColoring.xs,i] = nthColor.[xs,i]) &
    (for xs being FinSequence of C, i being Integer holds
       (i < 0 & len xs = 0 implies nthColor.[xs,i] = Default) &
       (i < 0 & 0 < len xs implies nthColor.[xs,i] = xs.1) &
       (0 <= i & i < len xs implies nthColor.[xs,i] = xs.(i+1)) &
       (len xs <= i implies nthColor.[xs,i] = Default)) &
    (for i being Integer, l,r being Element of Forest holds
       node.[i,[l,r]] <> emptyF) &
    (for i,j being Integer, l,r,l1,r1 being Element of Forest st
       node.[i,[l,r]] = node.[j,[l1,r1]]
     holds i = j & l = l1 & r = r1) &
    (for f being Element of Forest holds
       f = emptyF or
       ex i being Integer, l,r being Element of Forest st
         f = node.[i,[l,r]]) &
    (for X being Subset of Forest st
       emptyF in X &
       (for i being Integer, l,r being Element of Forest st
          l in X & r in X holds node.[i,[l,r]] in X)
     holds X = Forest) &
    SizeF.emptyF = 0 &
    CountF.emptyF = 1 &
    (for i being Integer, l,r being Element of Forest holds
       SizeF.(node.[i,[l,r]]) = 1 + SizeF.l + SizeF.r &
       CountF.(node.[i,[l,r]]) = (1 + CountF.l) * CountF.r) &
    (for i being Integer holds not [i,emptyF] in MemF) &
    (for i,j being Integer, l,r being Element of Forest holds
       ([i,node.[j,[l,r]]] in MemF iff
          j = i or [i,l] in MemF or [i,r] in MemF)) &
    emptyF in NoRepeated &
    (for i being Integer, l,r being Element of Forest holds
       (node.[i,[l,r]] in NoRepeated iff
          l in NoRepeated & r in NoRepeated &
          not [i,l] in MemF & not [i,r] in MemF &
          (for j being Integer st [j,l] in MemF holds
             not [j,r] in MemF))) &
    (for f being Element of Forest, n being Integer holds
       ([f,n] in ValidNums iff
          f in NoRepeated &
          (for i being Integer st [i,f] in MemF holds
             0 <= i & i < n))) &
    (for c being Element of Coloring holds [emptyF,c] in WhiteF) &
    (for i being Integer, l,r being Element of Forest,
         c being Element of Coloring holds
       ([node.[i,[l,r]],c] in WhiteF iff
          Apply.[c,i] = White & [l,c] in WhiteF &
          [r,c] in WhiteF)) &
    (for c being Element of Coloring holds [emptyF,c] in ValidC) &
    (for i being Integer, l,r being Element of Forest,
         c being Element of Coloring holds
       ([node.[i,[l,r]],c] in ValidC iff
          [r,c] in ValidC &
          (Apply.[c,i] = White & [l,c] in WhiteF or
           Apply.[c,i] = Black & [l,c] in ValidC))) &
    not emptyF in EvenF &
    (for i being Integer, l,r being Element of Forest holds
       (node.[i,[l,r]] in EvenF iff
          not l in EvenF or r in EvenF)) &
    (for c being Element of Coloring holds [emptyF,c] in FinalF) &
    (for i being Integer, l,r being Element of Forest,
         c being Element of Coloring holds
       ([node.[i,[l,r]],c] in FinalF iff
          Apply.[c,i] = Black & [l,c] in FinalF &
          (not l in EvenF & [r,c] in WhiteF or
           l in EvenF & [r,c] in FinalF))) &
    (for i being Integer holds not [i,<*>Forest] in MemS) &
    (for i being Integer, f being Element of Forest,
         tl being FinSequence of Forest holds
       ([i,<*f*> ^ tl] in MemS iff
          [i,f] in MemF or [i,tl] in MemS)) &
    CountS.(<*>Forest) = 1 &
    (for f being Element of Forest,
         tl being FinSequence of Forest holds
       CountS.(<*f*> ^ tl) = CountF.f * CountS.tl) &
    (for c being Element of Coloring holds [<*>Forest,c] in AnyS) &
    (for f being Element of Forest,
         tl being FinSequence of Forest,
         c being Element of Coloring holds
       ([<*f*> ^ tl,c] in AnyS iff
          ([f,c] in WhiteF or [f,c] in FinalF) &
          [tl,c] in AnyS)) &
    (for c1,c2 being Element of Coloring holds
       [<*>Forest,[c1,c2]] in Inverse) &
    (for f being Element of Forest,
         tl being FinSequence of Forest,
         c1,c2 being Element of Coloring holds
       ([<*f*> ^ tl,[c1,c2]] in Inverse iff
          ([f,c1] in WhiteF & [f,c2] in FinalF or
           [f,c1] in FinalF & [f,c2] in WhiteF) &
          (f in EvenF &
             (for i being Integer st [i,tl] in MemS holds
                Apply.[c1,i] = Apply.[c2,i]) or
           not f in EvenF & [tl,[c1,c2]] in Inverse))) &
    (for f being Element of Forest,
         c being Element of Coloring holds
       [<*f*>,[f,c]] in SubRel) &
    (for st1 being FinSequence of Forest,
         f1,f2 being Element of Forest,
         c being Element of Coloring, i being Integer st
       [st1,[f2,c]] in SubRel
     holds [st1,[node.[i,[f1,f2]],c]] in SubRel) &
    (for st1 being FinSequence of Forest,
         f1,f2 being Element of Forest,
         c being Element of Coloring, i being Integer st
       [st1,[f1,c]] in SubRel & Apply.[c,i] = Black
     holds [st1 ^ <*f2*>,[node.[i,[f1,f2]],c]] in SubRel) &
    (for R being Subset of [:Forest*,[:Forest,Coloring:]:] st
       (for f being Element of Forest,
            c being Element of Coloring holds [<*f*>,[f,c]] in R) &
       (for st1 being FinSequence of Forest,
            f1,f2 being Element of Forest,
            c being Element of Coloring, i being Integer st
          [st1,[f2,c]] in R
        holds [st1,[node.[i,[f1,f2]],c]] in R) &
       (for st1 being FinSequence of Forest,
            f1,f2 being Element of Forest,
            c being Element of Coloring, i being Integer st
          [st1,[f1,c]] in R & Apply.[c,i] = Black
        holds [st1 ^ <*f2*>,[node.[i,[f1,f2]],c]] in R)
     holds SubRel c= R) &
    (for f being Element of Forest, c being Element of Coloring,
         st1 being FinSequence of Forest,
         v1,v2 being FinSequence of Coloring holds
       ([[f,c],[st1,[v1,v2]]] in Stored iff
          len v2 - len v1 = CountS.st1 &
          (for j being Integer st 0 <= j & j < len v1 holds
             for i being Integer st 0 <= i & i < SizeF.f holds
               Apply.[v2.(j+1),i] = Apply.[v1.(j+1),i]) &
          (for j being Integer st len v1 <= j & j < len v2 holds
             [f,v2.(j+1)] in ValidC &
             (for i being Integer st
                0 <= i & i < SizeF.f & not [i,st1] in MemS
              holds
                Apply.[v2.(j+1),i] = Apply.[c,i]) &
             (for k being Integer st
                len v1 <= k & k < len v2 & j <> k
              holds
                not (for i being Integer st
                  0 <= i & i < SizeF.f holds
                    Apply.[v2.(j+1),i] =
                      Apply.[v2.(k+1),i]))))) &
    [f0,ListColoring.bs] in WhiteF &
    SizeF.f0 = len bs &
    [f0,len bs] in ValidNums
  holds
    (SizeF.f0 = len bs &
     [f0,len bs] in ValidNums &
     [<*f0*>,[f0,ListColoring.bs]] in SubRel &
     [<*f0*>,ListColoring.bs] in AnyS &
     [f0,ListColoring.bs] in ValidC) &
    (for bits1 being FinSequence of C,
         visited being FinSequence of Coloring st
       len bits1 = len bs
     holds
       ((for i being Integer st not [i,<*f0*>] in MemS holds
           nthColor.[bits1,i] = nthColor.[bs,i]) &
        [<*f0*>,[ListColoring.bs,ListColoring.bits1]] in Inverse &
        [f0,ListColoring.bits1] in ValidC &
        [[f0,ListColoring.bits1],
          [<*f0*>,[<*>Coloring,visited]]] in Stored
        implies
          len visited = CountF.f0 &
          (for j being Integer st
             0 <= j & j < len visited
           holds
             [f0,visited.(j+1)] in ValidC &
             (for k being Integer st
                0 <= k & k < len visited & j <> k
              holds
                not (for i being Integer st
                  0 <= i & i < len bits1
                 holds
                   Apply.[visited.(j+1),i] =
                     Apply.[visited.(k+1),i])))))
proof
end;
::$P+
