:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binomial_Top_computeqtvc: the binomial-coefficient computation
:: verification condition combines its recurrence, positivity, and Euclidean
:: division specifications with the loop invariant and final result.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for k,n being Integer,
      infixsl,comb being Function of [:INT,INT:],INT st
    (for y,x being Integer st y <> 0
      holds
        (0 < y implies infixsl.[x,y] = x div y) &
        (y < 0 implies infixsl.[x,y] = - (x div (-y)))) &
    (for j,m being Integer st 0 <= j & j <= m holds
      ((j = 0 or j = m) implies comb.[m,j] = 1) &
      (not (j = 0 or j = m) implies
        ex c,c1,c2 being Integer st
          c = comb.[m,j] &
          c1 = comb.[m - 1,j] &
          c2 = comb.[m - 1,j - 1] &
          c = c1 + c2)) &
    (for j,m being Integer st 0 <= j & j <= m
      holds ex c being Integer st
        c = comb.[m,j] & 1 <= c) &
    0 <= k &
    k <= n
  holds
    for k1 being Integer st
      (k <= n - k & k1 = k) or
      (not k <= n - k & k1 = n - k)
    holds
      (1 <= k1 + 1 implies
        ((1 <= 1 & 1 <= k1 + 1) &
          1 = comb.[n,1 - 1]) &
        (for r being Integer holds
          (for i being Integer st
            (1 <= i & i <= k1) &
            (1 <= i & i <= k1 + 1) &
            r = comb.[n,i - 1]
           holds
            i <> 0 &
            (1 <= i + 1 & i + 1 <= k1 + 1) &
            infixsl.[r * (n - i + 1),i] =
              comb.[n,i + 1 - 1]) &
          (((1 <= k1 + 1 & k1 + 1 <= k1 + 1) &
              r = comb.[n,k1 + 1 - 1])
            implies r = comb.[n,k]))) &
      (k1 + 1 < 1 implies 1 = comb.[n,k])
proof
end;
::$P+
