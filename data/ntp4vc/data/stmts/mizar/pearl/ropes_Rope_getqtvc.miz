:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/ropes_Rope_getqtvc: the rope character-access verification condition
:: establishes recursive-call index safety and agreement with the flattened
:: immutable string. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Char,String,Rope being non empty set,
      stringLength being Function of String,INT,
      stringIndex being Function of [:String,INT:],Char,
      emptyString being Element of String,
      stringApp being Function of [:String,String:],String,
      stringSub being Function of [:String,[:INT,INT:]:],String,
      StrRel being Relation of String,String,
      emp being Element of Rope,
      str being Function of [:String,[:INT,INT:]:],Rope,
      app being Function of [:Rope,[:Rope,INT:]:],Rope,
      ropeLength being Function of Rope,INT,
      Inv being Subset of Rope,
      ropeString being Function of Rope,String,
      r being Element of Rope,
      i being Integer
  st
    (for s being Element of String holds 0 <= stringLength.s) &
    stringLength.emptyString = 0 &
    (for s1,s2 being Element of String holds
       ([s1,s2] in StrRel iff
         ex n1,n2 being Integer st
           n1 = stringLength.s1 &
           n2 = stringLength.s2 &
           n1 = n2 &
           (for j being Integer st 0 <= j & j < n1
            holds stringIndex.[s1,j] = stringIndex.[s2,j]))) &
    (for s1,s2 being Element of String st
       [s1,s2] in StrRel
     holds s1 = s2) &
    (for s1,s2 being Element of String holds
       stringLength.(stringApp.[s1,s2]) =
         stringLength.s1 + stringLength.s2) &
    (for s1,s2 being Element of String,
         j being Integer st
       0 <= j & j < stringLength.s1
     holds
       stringIndex.[stringApp.[s1,s2],j] =
         stringIndex.[s1,j]) &
    (for s1,s2 being Element of String,
         j being Integer st
       stringLength.s1 <= j &
       j < stringLength.s1 + stringLength.s2
     holds
       stringIndex.[stringApp.[s1,s2],j] =
         stringIndex.[s2,j-stringLength.s1]) &
    (for s being Element of String,
         offset,nlen being Integer st
       0 <= nlen & 0 <= offset & offset <= stringLength.s &
       offset + nlen <= stringLength.s
     holds
       stringLength.(stringSub.[s,[offset,nlen]]) = nlen) &
    (for s being Element of String,
         offset,nlen,j being Integer st
       0 <= nlen & 0 <= offset & offset <= stringLength.s &
       offset + nlen <= stringLength.s &
       0 <= j & j < nlen
     holds
       stringIndex.[stringSub.[s,[offset,nlen]],j] =
         stringIndex.[s,offset+j]) &
    (for s1,s2 being Element of String,
         offset1,offset2,len1,len2 being Integer st
       str.[s1,[offset1,len1]] = str.[s2,[offset2,len2]]
     holds s1 = s2 & offset1 = offset2 & len1 = len2) &
    (for l1,l2,r1,r2 being Element of Rope,
         len1,len2 being Integer st
       app.[l1,[r1,len1]] = app.[l2,[r2,len2]]
     holds l1 = l2 & r1 = r2 & len1 = len2) &
    (for s being Element of String,
         offset,nlen being Integer
     holds str.[s,[offset,nlen]] <> emp) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds app.[l,[r1,nlen]] <> emp) &
    (for s being Element of String,
         offset,len1,len2 being Integer,
         l,r1 being Element of Rope
     holds str.[s,[offset,len1]] <> app.[l,[r1,len2]]) &
    (for x being Element of Rope holds
       x = emp or
       (ex s being Element of String,
           offset,nlen being Integer st
          x = str.[s,[offset,nlen]]) or
       ex l,r1 being Element of Rope,
          nlen being Integer st
         x = app.[l,[r1,nlen]]) &
    (for X being Subset of Rope st
       emp in X &
       (for s being Element of String,
            offset,nlen being Integer
        holds str.[s,[offset,nlen]] in X) &
       (for l,r1 being Element of Rope,
            nlen being Integer st l in X & r1 in X
        holds app.[l,[r1,nlen]] in X)
     holds X = Rope) &
    ropeLength.emp = 0 &
    (for s being Element of String,
         offset,nlen being Integer
     holds ropeLength.(str.[s,[offset,nlen]]) = nlen) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds ropeLength.(app.[l,[r1,nlen]]) = nlen) &
    emp in Inv &
    (for s being Element of String,
         offset,nlen being Integer
     holds
       (str.[s,[offset,nlen]] in Inv iff
          0 < nlen &
          0 <= offset & offset < stringLength.s &
          offset + nlen <= stringLength.s)) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds
       (app.[l,[r1,nlen]] in Inv iff
          0 < ropeLength.l & l in Inv &
          0 < ropeLength.r1 & r1 in Inv &
          nlen = ropeLength.l + ropeLength.r1)) &
    ropeString.emp = emptyString &
    (for s being Element of String,
         offset,nlen being Integer
     holds
       ropeString.(str.[s,[offset,nlen]]) =
         stringSub.[s,[offset,nlen]]) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds
       ropeString.(app.[l,[r1,nlen]]) =
         stringApp.[ropeString.l,ropeString.r1]) &
    r in Inv &
    0 <= i &
    i < ropeLength.r
  holds
    (r <> emp &
     (for s being Element of String,
          offset,nlen being Integer st
        r = str.[s,[offset,nlen]]
      holds
        0 <= offset+i & offset+i < stringLength.s) &
     (for left1,right1 being Element of Rope,
          totalLen being Integer st
        r = app.[left1,[right1,totalLen]]
      holds
        (i < ropeLength.left1 implies
          (ex f,f1 being Element of Rope,
              flen being Integer st
             r = app.[f,[f1,flen]] &
             (f = left1 or f1 = left1)) &
          left1 in Inv &
          0 <= i & i < ropeLength.left1) &
        (not i < ropeLength.left1 implies
          (ex f,f1 being Element of Rope,
              flen being Integer st
             r = app.[f,[f1,flen]] &
             (f = right1 or f1 = right1)) &
          right1 in Inv &
          0 <= i-ropeLength.left1 &
          i-ropeLength.left1 < ropeLength.right1))) &
    (for result being Element of Char st
       (ex s being Element of String,
           offset,nlen being Integer st
          r = str.[s,[offset,nlen]] &
          result = stringIndex.[s,offset+i]) or
       (ex left1,right1 being Element of Rope,
           totalLen being Integer st
          r = app.[left1,[right1,totalLen]] &
          ((i < ropeLength.left1 &
            result = stringIndex.[ropeString.left1,i]) or
           (not i < ropeLength.left1 &
            result =
              stringIndex.[ropeString.right1,
                i-ropeLength.left1])))
     holds result = stringIndex.[ropeString.r,i])
proof
end;
::$P+
