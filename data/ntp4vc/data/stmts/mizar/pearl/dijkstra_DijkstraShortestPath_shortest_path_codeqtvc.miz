:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/dijkstra_DijkstraShortestPath_shortest_path_codeqtvc: the
:: Dijkstra shortest-path verification condition initializes and preserves
:: finite-set, path-distance, and successor invariants. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, VALUED_0, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for V,S,T being non empty set,
      vertices being finite Subset of V,
      nextV being Function of V,(bool V),
      weight being Function of [:V,V:],INT,
      toFset being Function of S,(bool V),
      pick being Function of S,V,
      read being Function of [:T,V:],INT,
      update being Function of [:T,[:V,INT:]:],T,
      fcard being Function of (bool V),INT,
      MinRel being Subset of [:V,[:S,T:]:],
      Path,ShortestPath being Subset of [:V,[:V,INT:]:],
      InvSrc being Subset of [:V,[:S,S:]:],
      Inv,InvSucc being Subset of [:V,[:S,[:S,T:]:]:],
      InvSucc2 being
        Subset of [:V,[:S,[:S,[:T,[:V,S:]:]:]:]:],
      src,dst being Element of V,
      visited,q being Element of S,
      d being Element of T
  st
    (for s being Element of S holds toFset.s is finite) &
    (for s being Element of S st toFset.s <> {}
     holds pick.s in toFset.s) &
    (for x being Element of V holds
      nextV.x is finite & nextV.x c= vertices) &
    (for x,y being Element of V holds
      ex w being Integer st
        w = weight.[x,y] & 0 <= w) &
    (for t0 being Element of T,
         k,x being Element of V,
         z being Integer
     holds
       (x = k implies read.[update.[t0,[k,z]],x] = z) &
       (x <> k implies
         read.[update.[t0,[k,z]],x] = read.[t0,x])) &
    (for X being finite Subset of V holds fcard.X = card X) &
    (for m being Element of V,
         q0 being Element of S,
         d0 being Element of T
     holds
       ([m,[q0,d0]] in MinRel iff
        m in toFset.q0 &
        (for x being Element of V st x in toFset.q0
         holds
           ex dm,dx being Integer st
             dm = read.[d0,m] & dx = read.[d0,x] &
             dm <= dx))) &
    (for x being Element of V holds [x,[x,0]] in Path) &
    (for x,y,z being Element of V,
         dx being Integer st
       [x,[y,dx]] in Path & z in nextV.y
     holds
       for w being Integer st w = weight.[y,z]
       holds [x,[z,dx + w]] in Path) &
    (for R being Subset of [:V,[:V,INT:]:] st
       (for x being Element of V holds [x,[x,0]] in R) &
       (for x,y,z being Element of V,
            dx being Integer st
          [x,[y,dx]] in R & z in nextV.y
        holds
          for w being Integer st w = weight.[y,z]
          holds [x,[z,dx + w]] in R)
     holds Path c= R) &
    (for x,y being Element of V,
         dx being Integer
     holds
       ([x,[y,dx]] in ShortestPath iff
        [x,[y,dx]] in Path &
        (for dx1 being Integer st [x,[y,dx1]] in Path
         holds dx <= dx1))) &
    (for x being Element of V,
         s,q0 being Element of S
     holds
       ([x,[s,q0]] in InvSrc iff
        x in toFset.s or x in toFset.q0)) &
    (for x being Element of V,
         s,q0 being Element of S,
         d0 being Element of T
     holds
       ([x,[s,[q0,d0]]] in Inv iff
        [x,[s,q0]] in InvSrc &
        read.[d0,x] = 0 &
        toFset.s c= vertices &
        toFset.q0 c= vertices &
        (for z being Element of V st z in toFset.q0
         holds not z in toFset.s) &
        (for z being Element of V st z in toFset.s
         holds [x,[z,read.[d0,z]]] in ShortestPath) &
        (for z being Element of V st z in toFset.q0
         holds [x,[z,read.[d0,z]]] in Path))) &
    (for xsrc being Element of V,
         s,q0 being Element of S,
         d0 being Element of T
     holds
       ([xsrc,[s,[q0,d0]]] in InvSucc iff
        for x being Element of V st x in toFset.s
        holds
          for y being Element of V st y in nextV.x
          holds
            (y in toFset.s or y in toFset.q0) &
            ex dy,dx,w being Integer st
              dy = read.[d0,y] &
              dx = read.[d0,x] &
              w = weight.[x,y] &
              dy <= dx + w)) &
    (for xsrc,u being Element of V,
         s,q0,su being Element of S,
         d0 being Element of T
     holds
       ([xsrc,[s,[q0,[d0,[u,su]]]]] in InvSucc2 iff
        for x being Element of V st x in toFset.s
        holds
          for y being Element of V st y in nextV.x
          holds
            (x <> u or (x = u & not y in toFset.su))
            implies
              (y in toFset.s or y in toFset.q0) &
              ex dy,dx,w being Integer st
                dy = read.[d0,y] &
                dx = read.[d0,x] &
                w = weight.[x,y] &
                dy <= dx + w)) &
    src in vertices &
    dst in vertices &
    toFset.visited = {} &
    toFset.q = {src}
  holds
    [src,[visited,[q,update.[d,[src,0]]]]] in Inv &
    [src,[visited,[q,update.[d,[src,0]]]]] in InvSucc &
    (for m being Element of V st
       [m,[q,update.[d,[src,0]]]] in MinRel
     holds
       for x being Element of V,
           dx being Integer st [src,[x,dx]] in Path
       holds
         for dm being Integer st
           dm = read.[update.[d,[src,0]],m] & dx < dm
         holds x in toFset.visited) &
    (for q1,visited1 being Element of S,
         d1 being Element of T st
       [src,[visited1,[q1,d1]]] in Inv &
       [src,[visited1,[q1,d1]]] in InvSucc &
       (for m being Element of V st [m,[q1,d1]] in MinRel
        holds
          for x being Element of V,
              dx being Integer st [src,[x,dx]] in Path
          holds
            for dm being Integer st
              dm = read.[d1,m] & dx < dm
            holds x in toFset.visited1)
     holds
       (toFset.q1 <> {} implies
         toFset.q1 <> {} &
         (for q2 being Element of S,
              u being Element of V st
            [u,[q1,d1]] in MinRel &
            toFset.q2 = toFset.q1 \ {u}
          holds
            for visited2 being Element of S st
              toFset.visited2 = toFset.visited1 \/ {u} &
              (u in toFset.visited1 implies
                fcard.(toFset.visited2) =
                  fcard.(toFset.visited1)) &
              (not u in toFset.visited1 implies
                ex n2,n1 being Integer st
                  n2 = fcard.(toFset.visited2) &
                  n1 = fcard.(toFset.visited1) &
                  n2 = n1 + 1)
            holds
              for su being Element of S st
                toFset.su = nextV.u
              holds
                (toFset.su c= nextV.u &
                 [src,[visited2,[q2,d1]]] in Inv &
                 [src,[visited2,
                   [q2,[d1,[u,su]]]]] in InvSucc2) &
                (for su1,q3 being Element of S,
                     d2 being Element of T st
                   toFset.su1 c= nextV.u &
                   [src,[visited2,[q3,d2]]] in Inv &
                   [src,[visited2,
                     [q3,[d2,[u,su1]]]]] in InvSucc2
                 holds
                   (toFset.su1 <> {} implies
                     toFset.su1 <> {} &
                     (for su2 being Element of S,
                          v1 being Element of V st
                        v1 = pick.su1 &
                        v1 in toFset.su1 &
                        toFset.su2 = toFset.su1 \ {v1}
                      holds
                        for q4 being Element of S,
                            d3 being Element of T st
                          (v1 in toFset.visited2 &
                           q4 = q3 & d3 = d2) or
                          (ex a,b,w being Integer st
                            a = read.[d3,v1] &
                            b = read.[d3,u] &
                            w = weight.[u,v1] &
                            v1 in toFset.q4 &
                            a <= b + w &
                            q4 = q3 & d3 = d2) or
                          (ex a,b,w being Integer st
                            a = read.[d2,u] &
                            b = read.[d2,v1] &
                            w = weight.[u,v1] &
                            v1 in toFset.q4 &
                            a + w < b &
                            q4 = q3 &
                            d3 = update.[d2,[v1,a + w]]) or
                          (not v1 in toFset.visited2 &
                           not v1 in toFset.q3 &
                           toFset.q4 = toFset.q3 \/ {v1} &
                           (ex a,w being Integer st
                             a = read.[d2,u] &
                             w = weight.[u,v1] &
                             d3 = update.[d2,[v1,a + w]]))
                        holds
                          (ex n1,n2 being Integer st
                            n1 = fcard.(toFset.su1) &
                            n2 = fcard.(toFset.su2) &
                            0 <= n1 & n2 < n1) &
                          toFset.su2 c= nextV.u &
                          [src,[visited2,[q4,d3]]] in Inv &
                          [src,[visited2,
                            [q4,[d3,[u,su2]]]]]
                            in InvSucc2)) &
                   (toFset.su1 = {} implies
                     (ex nv,n1,n2 being Integer st
                       nv = fcard.vertices &
                       n1 = fcard.(toFset.visited1) &
                       n2 = fcard.(toFset.visited2) &
                       0 <= nv - n1 &
                       nv - n2 < nv - n1) &
                     [src,[visited2,[q3,d2]]] in Inv &
                     [src,[visited2,[q3,d2]]] in InvSucc &
                     (for m being Element of V st
                        [m,[q3,d2]] in MinRel
                      holds
                        for x being Element of V,
                            dx being Integer st [src,[x,dx]] in Path
                        holds
                          for dm being Integer st
                            dm = read.[d2,m] & dx < dm
                          holds x in toFset.visited2))))) &
       (toFset.q1 = {} implies
         (for v1 being Element of V st
            v1 in toFset.visited1
          holds
            [src,[v1,read.[d1,v1]]] in ShortestPath) &
         (for v1 being Element of V st
            not v1 in toFset.visited1
          holds
            for dv being Integer holds
              not [src,[v1,dv]] in Path)))
proof
end;
::$P+
