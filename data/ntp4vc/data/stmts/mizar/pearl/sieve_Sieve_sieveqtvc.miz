:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sieve_Sieve_sieveqtvc: the integer sieve verification condition,
:: preserving no-small-factor invariants through exact Boolean-array updates
:: and finally characterizing the prime indices. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCOP_1, ZFMISC_1, NUMBERS, XREAL_0,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_2,
    NAT_1, ORDINAL1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FUNCT_4, FUNCOP_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, INT_2,
    NAT_1, NAT_D, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, FUNCT_4, FUNCOP_1,
    CARD_1, REAL_1, INT_1, INT_2, NAT_1, NAT_D, XXREAL_0,
    ZFMISC_1, MARGREL1, XBOOLEAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCOP_1, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1, MARGREL1,
    XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for NoFactorLt being Subset of [:INT,INT:],
      SieveInv being
        Subset of [:Funcs(INT,BOOLEAN),[:INT,INT:]:],
      StrikeInv being
        Subset of [:Funcs(INT,BOOLEAN),[:INT,[:INT,INT:]:]:]
  st
    (for bnd,num being Integer holds
      ([bnd,num] in NoFactorLt iff
        1 < num &
        (for k,l being Integer st
          (1 < l & l < bnd) & 1 < k
        holds
          num <> k * l))) &
    (for t being Function of INT,BOOLEAN,
         bnd,n being Integer holds
      ([t,[bnd,n]] in SieveInv iff
        for j being Integer st 0 <= j & j < n holds
          (t.j = TRUE iff [bnd,j] in NoFactorLt))) &
    (for t being Function of INT,BOOLEAN,
         i,r,n being Integer holds
      ([t,[i,[r,n]]] in StrikeInv iff
        for j being Integer st 0 <= j & j < n holds
          (t.j = TRUE iff
            [i,j] in NoFactorLt &
            (for k being Integer st 1 < k & k < r holds
              j <> k * i))))
  holds
    for n being Integer st 1 < n holds
      0 <= n &
      for t being Function of INT,BOOLEAN,
          lt being Nat st
        (for i being Integer st 0 <= i & i < n holds
          t.i = TRUE) &
        lt = n
      holds
        ex t0,t01 being Function of INT,BOOLEAN st
          t0 = t +* ({0 qua Integer} --> FALSE) &
          t01 = t0 +* ({1 qua Integer} --> FALSE) &
          (0 <= 0 & 0 < lt) &
          (0 <= 1 & 1 < lt) &
          ((1 < 2 & 2 <= n) & [t01,[2,n]] in SieveInv) &
          (for i being Integer,
               t1 being Function of INT,BOOLEAN,
               l1 being Nat st
             l1 = lt
           holds
             ((1 < i & i <= n) & [t1,[i,n]] in SieveInv)
             implies
               ((i < n implies
                   (0 <= i & i < l1) &
                   ((t1.i = TRUE implies
                       ((1 < i & i <= n) &
                        [t1,[i,[i,n]]] in StrikeInv) &
                       (for r being Integer,
                            t2 being Function of INT,BOOLEAN,
                            l2 being Nat st
                          l2 = l1
                        holds
                          ((1 < r & r <= n) &
                           [t2,[i,[r,n]]] in StrikeInv)
                          implies
                            ((r * i < n implies
                                ex t3 being
                                  Function of INT,BOOLEAN st
                                  t3 =
                                    t2 +*
                                      ({r * i} --> FALSE) &
                                  (0 <= r * i & r * i < l2) &
                                  (0 <= n - r &
                                   n - (r + 1) < n - r) &
                                  ((1 < r + 1 & r + 1 <= n) &
                                   r * i + i = (r + 1) * i) &
                                  [t3,[i,[r + 1,n]]]
                                    in StrikeInv) &
                             (not r * i < n implies
                                (0 <= n - i &
                                 n - (i + 1) < n - i) &
                                (1 < i + 1 & i + 1 <= n) &
                                [t2,[i + 1,n]] in SieveInv)))) &
                    (t1.i <> TRUE implies
                       (0 <= n - i &
                        n - (i + 1) < n - i) &
                       (1 < i + 1 & i + 1 <= n) &
                       [t1,[i + 1,n]] in SieveInv))) &
                (not i < n implies
                   l1 = n &
                   (for i1 being Integer st
                     0 <= i1 & i1 < n
                   holds
                     (t1.i1 = TRUE iff
                       ex p being Nat st
                         p = i1 & p is prime)))))
proof
end;
::$P+
