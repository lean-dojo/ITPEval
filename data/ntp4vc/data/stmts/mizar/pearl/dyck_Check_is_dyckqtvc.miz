:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/dyck_Check_is_dyckqtvc: the Dyck-word checker verification condition
:: connects its Boolean result to the unique valid-prefix decomposition and
:: excludes Dyck words when no valid prefix decomposition exists.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for Paren being non empty set,
      L,R being Element of Paren,
      Dyck being Subset of Paren*,
      w,o2 being FinSequence of Paren
  st
    L <> R &
    (for q being Element of Paren holds q = L or q = R) &
    <*>Paren in Dyck &
    (for w1,w2 being FinSequence of Paren st
       w1 in Dyck & w2 in Dyck
     holds
       <*L*> ^ w1 ^ <*R*> ^ w2 in Dyck) &
    (for D being Subset of Paren* st
       <*>Paren in D &
       (for w1,w2 being FinSequence of Paren st
          w1 in D & w2 in D
        holds
          <*L*> ^ w1 ^ <*R*> ^ w2 in D)
     holds
       Dyck c= D)
  holds
    (for o1 being FinSequence of Paren st
       w = o2 ^ o1 &
       o2 in Dyck &
       (not ex t being FinSequence of Paren st
          o1 = <*L*> ^ t) &
       (for p2,s being FinSequence of Paren st
          w = p2 ^ s &
          p2 in Dyck &
          (not ex t being FinSequence of Paren st
             s = <*L*> ^ t)
        holds
          p2 = o2 & s = o1)
     holds
       for result being Element of BOOLEAN st
         ((o1 = <*>Paren & result = TRUE) or
          (o1 <> <*>Paren & result = FALSE))
       holds
         (result = TRUE iff w in Dyck)) &
    ((for p,s being FinSequence of Paren st
        w = p ^ s
      holds
        not (p in Dyck &
          (not ex t being FinSequence of Paren st
             s = <*L*> ^ t)))
     implies
       not w in Dyck)
proof
end;
::$P+
