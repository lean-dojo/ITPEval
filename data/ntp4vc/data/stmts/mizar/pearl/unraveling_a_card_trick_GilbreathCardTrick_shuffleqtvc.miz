:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/unraveling_a_card_trick_GilbreathCardTrick_shuffleqtvc:
:: the loop verification condition for building a riffle shuffle from two
:: integer-card stacks while preserving its invariants and decreasing length
:: variant through either pop-and-push branch. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
    FINSET_1, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1,
    XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, PRE_POLY, FUNCT_4, FUNCT_7,
    FINSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Stack being non empty set,
      elts being Function of Stack,INT*,
      Shuffle being Subset of [:INT*,[:INT*,INT*:]:],
      c,aPrime,bPrime,a,b being Element of Stack
  st
    elts.c = <*>INT &
    elts.aPrime = <*>INT &
    elts.bPrime = <*>INT &
    (for p,q,r being FinSequence of INT holds
       ([p,[q,r]] in Shuffle iff
         for R being set st
           (for l being FinSequence of INT holds
              [l,[<*>INT,l]] in R &
              [<*>INT,[l,l]] in R) &
           (for x being Integer,
                p1,q1,r1 being FinSequence of INT st
              [p1,[q1,r1]] in R
            holds
              [<*x*> ^ p1,[q1,<*x*> ^ r1]] in R &
              [p1,[<*x*> ^ q1,<*x*> ^ r1]] in R)
         holds [p,[q,r]] in R))
  holds
    Rev (elts.a) = Rev (elts.a) ^ elts.aPrime &
    Rev (elts.b) = Rev (elts.b) ^ elts.bPrime &
    [elts.aPrime,[elts.bPrime,elts.c]] in Shuffle &
    (for bPrime1,aPrime1,c1,b1,a1 being Element of Stack st
       Rev (elts.a) = Rev (elts.a1) ^ elts.aPrime1 &
       Rev (elts.b) = Rev (elts.b1) ^ elts.bPrime1 &
       [elts.aPrime1,[elts.bPrime1,elts.c1]] in Shuffle
     holds
       for o1 being Element of BOOLEAN st
         ((elts.a1 = <*>INT &
             ((elts.b1 = <*>INT & o1 = TRUE) or
              (elts.b1 <> <*>INT & o1 = FALSE))) or
          (elts.a1 <> <*>INT & o1 = FALSE))
       holds
         (o1 <> TRUE &
           (for o2 being Element of BOOLEAN st
              ((elts.a1 <> <*>INT &
                  (elts.b1 = <*>INT implies o2 = TRUE)) or
               (elts.a1 = <*>INT & o2 = FALSE))
            holds
              (o2 = TRUE &
                elts.a1 <> <*>INT &
                (for o3 being Integer st
                   elts.a1 <> <*>INT & o3 = (elts.a1).1
                 holds
                   for aPrime2 being Element of Stack st
                     elts.aPrime2 = <*o3*> ^ elts.aPrime1
                   holds
                     elts.a1 <> <*>INT &
                     (for a2 being Element of Stack,
                          o4 being Integer st
                        elts.a1 = <*o4*> ^ elts.a2
                      holds
                        for c2 being Element of Stack st
                          elts.c2 = <*o4*> ^ elts.c1
                        holds
                          (0 <= len (elts.a1) + len (elts.b1) &
                           len (elts.a2) + len (elts.b1) <
                             len (elts.a1) + len (elts.b1)) &
                          Rev (elts.a) =
                            Rev (elts.a2) ^ elts.aPrime2 &
                          Rev (elts.b) =
                            Rev (elts.b1) ^ elts.bPrime1 &
                          [elts.aPrime2,
                            [elts.bPrime1,elts.c2]] in Shuffle))) or
               (o2 <> TRUE &
                elts.b1 <> <*>INT &
                (for o3 being Integer st
                   elts.b1 <> <*>INT & o3 = (elts.b1).1
                 holds
                   for bPrime2 being Element of Stack st
                     elts.bPrime2 = <*o3*> ^ elts.bPrime1
                   holds
                     elts.b1 <> <*>INT &
                     (for b2 being Element of Stack,
                          o4 being Integer st
                        elts.b1 = <*o4*> ^ elts.b2
                      holds
                        for c2 being Element of Stack st
                          elts.c2 = <*o4*> ^ elts.c1
                        holds
                          (0 <= len (elts.a1) + len (elts.b1) &
                           len (elts.a1) + len (elts.b2) <
                             len (elts.a1) + len (elts.b1)) &
                          Rev (elts.a) =
                            Rev (elts.a1) ^ elts.aPrime1 &
                          Rev (elts.b) =
                            Rev (elts.b2) ^ elts.bPrime2 &
                          [elts.aPrime1,
                            [elts.bPrime2,elts.c2]] in Shuffle)))) or
          (o1 = TRUE &
           elts.a1 = <*>INT &
           elts.b1 = <*>INT &
           [Rev (elts.a),[Rev (elts.b),elts.c1]] in Shuffle)))
proof
end;
::$P+
