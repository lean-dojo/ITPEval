:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/pairing_heap_PairingHeap_delete_minqtvc: the pairing-heap
:: delete-minimum verification condition exposes a heap-ordered child
:: forest and removes exactly one minimum while preserving all other
:: element multiplicities and decreasing the size by one.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_5;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Raw,Tree,Heap1 being non empty set,
      Leq being Relation of E,E,
      emptyRaw being Element of Raw,
      rawMk being Function of Tree,Raw,
      treeMk being Function of [:E,Tree*:],Tree,
      treeDepth being Function of Tree,NAT,
      SizeHeap being Function of Raw,INT,
      SizeTree being Function of Tree,INT,
      SizeList being Function of Tree*,INT,
      OccHeap being Function of [:E,Raw:],INT,
      OccTree being Function of [:E,Tree:],INT,
      OccList being Function of [:E,Tree*:],INT,
      LeTrees being Subset of [:E,Tree:],
      LeRoots being Subset of [:E,Tree*:],
      Heaps being Subset of Raw,
      HeapTrees being Subset of Tree,
      HeapLists being Subset of Tree*,
      heapOf being Function of Heap1,Raw,
      MinimumTree being Function of Tree,E,
      Minimum being Function of Raw,E,
      emptyHeap,hh being Element of Heap1
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds
       [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for t being Element of Tree holds rawMk.t <> emptyRaw) &
    (for u being Element of Raw holds
       u = emptyRaw or
       ex t being Element of Tree st u = rawMk.t) &
    (for t1,t2 being Element of Tree st rawMk.t1 = rawMk.t2
     holds t1 = t2) &
    (for t being Element of Tree holds
       ex x being Element of E,
          children being FinSequence of Tree st
         t = treeMk.[x,children]) &
    (for x,x2 being Element of E,
         children,children2 being FinSequence of Tree st
       treeMk.[x,children] = treeMk.[x2,children2]
     holds
       x = x2 & children = children2) &
    (for x being Element of E,
         children being FinSequence of Tree,
         i being Nat st i in dom children
     holds
       ex child being Element of Tree,
          childDepth,parentDepth being Nat st
         child = children/.i &
         childDepth = treeDepth.child &
         parentDepth = treeDepth.(treeMk.[x,children]) &
         childDepth < parentDepth) &
    SizeHeap.emptyRaw = 0 &
    (for t being Element of Tree holds
       SizeHeap.(rawMk.t) = SizeTree.t) &
    (for x being Element of E,
         children being FinSequence of Tree
     holds
       ex whole,forestSize being Integer st
         whole = SizeTree.(treeMk.[x,children]) &
         forestSize = SizeList.children &
         whole = 1 + forestSize) &
    SizeList.(<*>Tree) = 0 &
    (for t being Element of Tree,
         rest being FinSequence of Tree
     holds
       ex whole,headSize,tailSize being Integer st
         whole = SizeList.(<*t*> ^ rest) &
         headSize = SizeTree.t &
         tailSize = SizeList.rest &
         whole = headSize + tailSize) &
    (for x being Element of E holds
       OccHeap.[x,emptyRaw] = 0) &
    (for x being Element of E,
         t being Element of Tree
     holds
       OccHeap.[x,rawMk.t] = OccTree.[x,t]) &
    (for sought,root being Element of E,
         children being FinSequence of Tree
     holds
       ex whole,forestOcc being Integer st
         whole = OccTree.[sought,treeMk.[root,children]] &
         forestOcc = OccList.[sought,children] &
         (sought = root implies whole = 1 + forestOcc) &
         (sought <> root implies whole = forestOcc)) &
    (for x being Element of E holds
       OccList.[x,<*>Tree] = 0) &
    (for x being Element of E,
         t being Element of Tree,
         rest being FinSequence of Tree
     holds
       ex whole,headOcc,tailOcc being Integer st
         whole = OccList.[x,<*t*> ^ rest] &
         headOcc = OccTree.[x,t] &
         tailOcc = OccList.[x,rest] &
         whole = headOcc + tailOcc) &
    (for lower,root being Element of E,
         children being FinSequence of Tree
     holds
       ([lower,treeMk.[root,children]] in LeTrees iff
          [lower,root] in Leq)) &
    (for lower being Element of E holds
       [lower,<*>Tree] in LeRoots) &
    (for lower being Element of E,
         t being Element of Tree,
         rest being FinSequence of Tree
     holds
       ([lower,<*t*> ^ rest] in LeRoots iff
          [lower,t] in LeTrees & [lower,rest] in LeRoots)) &
    emptyRaw in Heaps &
    (for t being Element of Tree holds
       (rawMk.t in Heaps iff t in HeapTrees)) &
    (for root being Element of E,
         children being FinSequence of Tree
     holds
       (treeMk.[root,children] in HeapTrees iff
          [root,children] in LeRoots & children in HeapLists)) &
    (<*>Tree) in HeapLists &
    (for t being Element of Tree,
         rest being FinSequence of Tree
     holds
       (<*t*> ^ rest in HeapLists iff
          t in HeapTrees & rest in HeapLists)) &
    (for self being Element of Heap1 holds
       heapOf.self in Heaps) &
    (for a,b being Element of Heap1 st heapOf.a = heapOf.b
     holds a = b) &
    (for root being Element of E,
         children being FinSequence of Tree
     holds
       MinimumTree.(treeMk.[root,children]) = root) &
    (for t being Element of Tree holds
       Minimum.(rawMk.t) = MinimumTree.t) &
    SizeHeap.(heapOf.emptyHeap) = 0 &
    (for e being Element of E holds
       ex emptyOcc being Integer st
         emptyOcc = OccHeap.[e,heapOf.emptyHeap] &
         not 0 < emptyOcc) &
    0 < SizeHeap.(heapOf.hh)
  holds
    (ex root being Element of E,
        children being FinSequence of Tree st
       heapOf.hh = rawMk.(treeMk.[root,children]) &
       children in HeapLists) &
    (for result being Element of Heap1 st
       ex root being Element of E,
          children being FinSequence of Tree st
         heapOf.hh = rawMk.(treeMk.[root,children]) &
         SizeHeap.(heapOf.result) = SizeList.children &
         (for x being Element of E holds
            OccHeap.[x,heapOf.result] = OccList.[x,children])
     holds
       (ex resultOcc,originalOcc being Integer st
          resultOcc = OccHeap.[Minimum.(heapOf.hh),heapOf.result] &
          originalOcc = OccHeap.[Minimum.(heapOf.hh),heapOf.hh] &
          resultOcc = originalOcc - 1) &
       (for y being Element of E st y <> Minimum.(heapOf.hh)
        holds
          OccHeap.[y,heapOf.result] = OccHeap.[y,heapOf.hh]) &
       (ex resultSize,originalSize being Integer st
          resultSize = SizeHeap.(heapOf.result) &
          originalSize = SizeHeap.(heapOf.hh) &
          resultSize = originalSize - 1))
proof
end;
::$P+
