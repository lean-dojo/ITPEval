:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/schorr_waite_SchorrWaite_schorr_waiteqtvc: the Schorr-Waite
:: graph-marking verification condition initializes and preserves its
:: stack, path, graph-shape, marking, and lexicographic loop invariants.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, FINSET_1, MARGREL1,
    XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, FINSET_1, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for L being non empty set,
      graph being finite Subset of L,
      root,null,defaultLoc being Element of L,
      left1,right1 being Function of L,L,
      m,c being Function of L,BOOLEAN,
      pathRoot being Function of L,L*,
      nthElem being Function of [:L*,INT:],L,
      Path being
        Subset of
          [:Funcs(L,L),[:Funcs(L,L),[:L,[:L*,L:]:]:]:],
      NotInStack being Subset of [:L,L*:],
      Distinct being Subset of L*,
      Lex being Relation,
      Inv being set
  st
    (for s being FinSequence of L, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultLoc) &
       (len s > 0 & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultLoc)) &
    (for lf,rf being Function of L,L,
         x,y being Element of L,
         q being FinSequence of L
     holds
       ([lf,[rf,[x,[q,y]]]] in Path iff
          (q = <*>L & x = y) or
          ex z being Element of L,
             q1 being FinSequence of L st
            q = <*x*> ^ q1 &
            x <> null &
            (lf.x = z or rf.x = z) &
            [lf,[rf,[z,[q1,y]]]] in Path)) &
    (for n being Element of L, s being FinSequence of L holds
       ([n,s] in NotInStack iff
          for i being Integer st 0 <= i & i < len s
          holds n <> nthElem.[s,i])) &
    (for s being FinSequence of L holds
       (s in Distinct iff
          for i,j being Integer st
            0 <= i & i < len s & 0 <= j & j < len s & i <> j
          holds nthElem.[s,i] <> nthElem.[s,j])) &
    (for newUnmarked,newCFalse,oldUnmarked,oldCFalse
         being finite Subset of L,
         newStack,oldStack being FinSequence of L
     holds
       ([[newUnmarked,[newCFalse,newStack]],
         [oldUnmarked,[oldCFalse,oldStack]]] in Lex iff
          card newUnmarked < card oldUnmarked or
          card newUnmarked = card oldUnmarked &
            (card newCFalse < card oldCFalse or
             card newCFalse = card oldCFalse &
               len newStack < len oldStack))) &
    (for unmarked,cFalse being finite Subset of L,
         pth,stack being FinSequence of L,
         p,t being Element of L,
         pathMap being Function of L,L*,
         rightCur,leftCur being Function of L,L,
         color,mark being Function of L,BOOLEAN
     holds
       ([unmarked,[cFalse,[pth,[stack,[p,[t,[pathMap,
         [rightCur,[leftCur,[color,mark]]]]]]]]]] in Inv iff
          (for n being Element of L st n in graph holds
             [n,stack] in NotInStack or
             ex i being Integer st nthElem.[stack,i] = n) &
          [null,stack] in NotInStack &
          (len stack = 0 iff p = null) &
          (p <> null implies p in graph) &
          (len stack <> 0 implies nthElem.[stack,0] = p) &
          (for n being Element of L st
             n in graph & mark.n <> TRUE
           holds n in unmarked) &
          (for n being Element of L st
             n in graph & color.n <> TRUE
           holds n in cFalse) &
          (for i being Integer st 0 <= i & i < len stack
           holds nthElem.[stack,i] in graph) &
          (for i being Integer st 0 <= i & i < len stack - 1
           holds
             for p1,p2 being Element of L st
               p1 = nthElem.[stack,i] &
               p2 = nthElem.[stack,i+1]
             holds
               (color.p2 = TRUE implies
                  left1.p2 = leftCur.p2 &
                  right1.p2 = p1) &
               (color.p2 <> TRUE implies
                  left1.p2 = p1 &
                  right1.p2 = rightCur.p2)) &
          pathMap.root = <*>L &
          (for n being Element of L st
             n in graph & [n,stack] in NotInStack
           holds leftCur.n = left1.n & rightCur.n = right1.n) &
          (len stack <> 0 implies
             for first being Element of L st
               first = nthElem.[stack,len stack-1]
             holds
               (color.first = TRUE implies rightCur.first = null) &
               (color.first <> TRUE implies leftCur.first = null)) &
          (len stack <> 0 implies
             nthElem.[stack,len stack-1] = root) &
          (for k being Integer st 0 <= k & k < len stack - 1
           holds
             (color.(nthElem.[stack,k]) = TRUE implies
                rightCur.(nthElem.[stack,k]) =
                  nthElem.[stack,k+1]) &
             (color.(nthElem.[stack,k]) <> TRUE implies
                leftCur.(nthElem.[stack,k]) =
                  nthElem.[stack,k+1])) &
          (for i being Integer st 0 <= i & i < len stack
           holds mark.(nthElem.[stack,i]) = TRUE) &
          stack in Distinct &
          (for i being Integer st 0 <= i & i < len stack
           holds
             for n being Element of L st n = nthElem.[stack,i]
             holds
               (color.n = TRUE implies leftCur.n = left1.n) &
               (color.n <> TRUE implies rightCur.n = right1.n)) &
          (len stack <> 0 implies
             (color.p = TRUE implies right1.p = t) &
             (color.p <> TRUE implies left1.p = t)) &
          (for k being Integer st 0 < k & k < len stack
           holds
             for n being Element of L st n = nthElem.[stack,k]
             holds
               (color.n = TRUE implies
                  nthElem.[stack,k-1] = right1.n) &
               (color.n <> TRUE implies
                  nthElem.[stack,k-1] = left1.n)) &
          (p <> null implies
             [left1,[right1,[root,[pth,p]]]] in Path) &
          (for n being Element of L st n in graph & mark.n = TRUE
           holds
             ex q being FinSequence of L st
               [left1,[right1,[root,[q,n]]]] in Path) &
          (p = null implies t = root) &
          (for n being Element of L st n in graph & mark.n = TRUE
           holds
             [left1,[right1,[root,[pathMap.n,n]]]] in Path) &
          (for n being Element of L st
             n in graph & n <> null & mark.n = TRUE &
             [n,stack] in NotInStack
           holds
             (leftCur.n <> null implies mark.(leftCur.n) = TRUE) &
             (rightCur.n <> null implies mark.(rightCur.n) = TRUE)) &
          (for i being Integer st 0 <= i & i < len stack
           holds
             for n being Element of L st n = nthElem.[stack,i]
             holds
               color.n = TRUE implies
                 (leftCur.n <> null implies mark.(leftCur.n) = TRUE) &
                 (rightCur.n <> null implies
                    mark.(rightCur.n) = TRUE)))) &
    root <> null &
    root in graph &
    (for n being Element of L st n in graph holds
       n <> null &
       (left1.n = null or left1.n in graph) &
       (right1.n = null or right1.n in graph)) &
    (for n being Element of L st n in graph holds m.n <> TRUE)
  holds
    [graph,[graph,[<*>L,[<*>L,[null,[root,
      [pathRoot+*(root,<*>L),
        [right1,[left1,[c,m]]]]]]]]]] in Inv &
    (for unmarked,cFalse being finite Subset of L,
         pth,stack being FinSequence of L,
         p,t being Element of L,
         pathMap being Function of L,L*,
         rightCur,leftCur being Function of L,L,
         color,mark being Function of L,BOOLEAN
     st
       [unmarked,[cFalse,[pth,[stack,[p,[t,[pathMap,
         [rightCur,[leftCur,[color,mark]]]]]]]]]] in Inv
     holds
       ((p <> null or (t <> null & mark.t <> TRUE)) implies
          (((t = null or mark.t = TRUE) implies
              p <> null &
              ((color.p = TRUE implies
                  0 < len stack &
                  ex tail being FinSequence of L st
                    len stack = len tail + 1 &
                    (for i being Integer st
                       0 <= i & i < len tail
                     holds
                       nthElem.[tail,i] =
                         nthElem.[stack,i+1]) &
                    ((for n being Element of L st
                        [n,stack] in NotInStack
                      holds [n,tail] in NotInStack)
                     implies
                       [[unmarked,[cFalse,tail]],
                         [unmarked,[cFalse,stack]]] in Lex &
                       [unmarked,[cFalse,
                         [pathMap.(rightCur.p),
                           [tail,[rightCur.p,[p,[pathMap,
                             [rightCur+*(p,t),
                               [leftCur,[color,mark]]]]]]]]]] in Inv)) &
               (color.p <> TRUE implies
                  [[unmarked,[cFalse \ {p},stack]],
                    [unmarked,[cFalse,stack]]] in Lex &
                  [unmarked,[cFalse \ {p},
                    [pth,[stack,[p,[rightCur.p,[pathMap,
                      [rightCur+*(p,leftCur.p),
                        [leftCur+*(p,t),
                          [color+*(p,TRUE),mark]]]]]]]]]] in Inv))) &
           ((t <> null & mark.t <> TRUE) implies
              ((t <> root implies
                  [[unmarked \ {t},
                    [cFalse \/ {t},<*t*> ^ stack]],
                    [unmarked,[cFalse,stack]]] in Lex &
                  [unmarked \ {t},[cFalse \/ {t},
                    [pth ^ <*p*>,[<*t*> ^ stack,
                      [t,[leftCur.t,
                        [pathMap+*(t,pth ^ <*p*>),
                          [rightCur,[leftCur+*(t,p),
                            [color+*(t,FALSE),
                              mark+*(t,TRUE)]]]]]]]]]] in Inv) &
               (t = root implies
                  [[unmarked \ {t},
                    [cFalse \/ {t},<*t*> ^ stack]],
                    [unmarked,[cFalse,stack]]] in Lex &
                  [unmarked \ {t},[cFalse \/ {t},
                    [<*>L,[<*t*> ^ stack,
                      [t,[leftCur.t,
                        [pathMap+*(t,<*>L),
                          [rightCur,[leftCur+*(t,p),
                            [color+*(t,FALSE),
                              mark+*(t,TRUE)]]]]]]]]]] in Inv))))) &
       ((not (p <> null or (t <> null & mark.t <> TRUE))) implies
          (for n being Element of L st n in graph holds
             left1.n = leftCur.n & right1.n = rightCur.n) &
          (for n being Element of L st n in graph & mark.n = TRUE
           holds
             ex q being FinSequence of L st
               [left1,[right1,[root,[q,n]]]] in Path) &
          mark.root = TRUE &
          (for n being Element of L st n in graph & mark.n = TRUE
           holds
             for ch being Element of L st
               n <> null &
               (leftCur.n = ch or rightCur.n = ch) &
               ch <> null
             holds mark.ch = TRUE)))
proof
end;
::$P+
