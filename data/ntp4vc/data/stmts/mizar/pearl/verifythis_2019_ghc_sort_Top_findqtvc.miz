:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2019_ghc_sort_Top_findqtvc: the recursive sequence-search
:: verification condition preserves interval bounds and occurrence existence,
:: decreases the remaining interval, and returns an index containing the
:: searched integer. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s,e,v being Integer,
      seq1 being FinSequence of INT st
    0 <= s &
    s < e &
    e <= len seq1 &
    (ex q being Integer st
      s <= q & q < e & seq1.(q+1) = v)
  holds
    for o1 being Integer st o1 = seq1.(s+1) holds
      (o1 <> v implies
        for o2 being Integer st o2 = s+1 holds
          (0 <= e-s & e-o2 < e-s) &
          (0 <= o2 & o2 < e & e <= len seq1) &
          (ex q being Integer st
            o2 <= q & q < e & seq1.(q+1) = v)) &
      (for result being Integer st
         (o1 = v & result = s) or
         (o1 <> v & s+1 <= result & result < e &
          seq1.(result+1) = v)
       holds
         s <= result & result < e &
         seq1.(result+1) = v)
proof
end;
::$P+
