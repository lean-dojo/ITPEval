:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/decrease1_Decrease1_search_recqtvc: the recursive-search
:: verification condition for finding the first zero in an integer list
:: whose adjacent values decrease by at most one. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      ORDINAL4, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
      FINSET_1, MARGREL1, XBOOLEAN, MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
      MARGREL1, XBOOLEAN;
 constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0, FINSEQ_1,
      FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE,
      PRE_POLY, FINSET_1, MARGREL1, XBOOLEAN;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being FinSequence of INT,
      i being Integer,
      nthElem being Function of [:INT*,INT:],INT,
      decreaseOne being Subset of INT*
  st
    (for xs being FinSequence of INT, k being Integer
       st 0 <= k & k < len xs
       holds nthElem.[xs,k] = xs.(k+1)) &
    (for xs being FinSequence of INT holds
       (xs in decreaseOne iff
         for k being Integer
           st 0 <= k & k < len xs - 1
           holds nthElem.[xs,k] - 1 <= nthElem.[xs,k+1])) &
    a in decreaseOne &
    0 <= i
  holds
    (i < len a implies
      (0 <= i & i < len a) &
      (not nthElem.[a,i] = 0 implies
        (0 <= i & i < len a) &
        ((0 < nthElem.[a,i] implies
          (0 <= len a - i &
            len a - (i + nthElem.[a,i]) < len a - i) &
          a in decreaseOne &
          0 <= i + nthElem.[a,i]) &
         (not 0 < nthElem.[a,i] implies
          (0 <= len a - i &
            len a - (i + 1) < len a - i) &
          a in decreaseOne &
          0 <= i + 1)))) &
    (for result being Integer
       st
         ((i < len a &
            ((nthElem.[a,i] = 0 & result = i) or
             (not nthElem.[a,i] = 0 &
              ((0 < nthElem.[a,i] &
                ((result = -1 &
                  (for j being Integer
                     st i + nthElem.[a,i] <= j & j < len a
                     holds not nthElem.[a,j] = 0)) or
                 ((i + nthElem.[a,i] <= result &
                    result < len a) &
                   nthElem.[a,result] = 0 &
                   (for j being Integer
                      st i + nthElem.[a,i] <= j & j < result
                      holds not nthElem.[a,j] = 0)))) or
               (not 0 < nthElem.[a,i] &
                ((result = -1 &
                  (for j being Integer
                     st i + 1 <= j & j < len a
                     holds not nthElem.[a,j] = 0)) or
                 ((i + 1 <= result & result < len a) &
                   nthElem.[a,result] = 0 &
                   (for j being Integer
                      st i + 1 <= j & j < result
                      holds not nthElem.[a,j] = 0)))))))) or
          (not i < len a & result = -1))
       holds
         (result = -1 &
          (for j being Integer
             st i <= j & j < len a
             holds not nthElem.[a,j] = 0)) or
         ((i <= result & result < len a) &
          nthElem.[a,result] = 0 &
          (for j being Integer
             st i <= j & j < result
             holds not nthElem.[a,j] = 0)))
proof
end;
::$P+
