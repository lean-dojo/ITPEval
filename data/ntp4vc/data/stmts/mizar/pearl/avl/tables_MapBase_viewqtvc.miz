:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/tables_MapBase_viewqtvc: the view operation for an ordered
:: AVL-backed map, specifying its empty and node cases, subtree ordering,
:: cardinality, domain membership, and stored values. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T,K,Tree,T3,T4,View,View1 being non empty set,
      balancing being Nat,
      key being Function of T,K,
      Leq,EqRel,LtRel being Relation of K,K,
      emptyTree being Element of Tree,
      nodeTree being Function of
        [:Tree,[:T,[:Tree,[:NAT,{0}:]:]:]:],Tree,
      treeRank being Function of Tree,NAT,
      seqModel being Function of Tree,T*,
      realHeight being Function of Tree,INT,
      Balanced being Subset of Tree,
      mseq being Function of [:T*,INT:],T*,
      mhgt being Function of [:T*,INT:],INT,
      repr being Function of T3,Tree,
      m1 being Function of T3,[:T*,INT:],
      fld being Function of T4,T3,
      nthElem being Function of [:T*,INT:],T,
      Sorted being Subset of T*,
      Domain,DomainClosure being Subset of [:T*,K:],
      makeFunc,makeFuncClosure being Function of [:T*,K:],T,
      mapDomain being Subset of [:T4,K:],
      mapFunc being Function of [:T4,K:],T,
      mapCard being Function of T4,INT,
      emptyView being Element of View,
      nodeView being Function of
        [:T3,[:T,[:T3,[:NAT,{0}:]:]:]:],View,
      emptyView1 being Element of View1,
      nodeView1 being Function of
        [:T4,[:T,[:T4,NAT:]:]:],View1,
      t5 being Element of T4
  st
    balancing > 0 &
    (for x being Element of K holds [x,x] in Leq) &
    (for x,y,z being Element of K st
       [x,y] in Leq & [y,z] in Leq
     holds
       [x,z] in Leq) &
    (for x,y being Element of K holds
       [x,y] in Leq or [y,x] in Leq) &
    (for x,y being Element of K holds
       ([x,y] in EqRel iff
         [x,y] in Leq & [y,x] in Leq)) &
    (for x,y being Element of K holds
       ([x,y] in LtRel iff
         [x,y] in Leq & not [y,x] in Leq)) &
    treeRank.emptyTree = 0 &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       nodeTree.[l,[d,[r,[h,u]]]] <> emptyTree &
       treeRank.(nodeTree.[l,[d,[r,[h,u]]]]) =
         1 + treeRank.l + treeRank.r) &
    (for tr being Element of Tree holds
       tr = emptyTree or
       ex l,r being Element of Tree,
          d being Element of T,
          h being Nat,
          u being Element of {0} st
         tr = nodeTree.[l,[d,[r,[h,u]]]]) &
    (for l1,l2,r1,r2 being Element of Tree,
         d1,d2 being Element of T,
         h1,h2 being Nat,
         u1,u2 being Element of {0} st
       nodeTree.[l1,[d1,[r1,[h1,u1]]]] =
         nodeTree.[l2,[d2,[r2,[h2,u2]]]]
     holds
       l1 = l2 & d1 = d2 & r1 = r2 & h1 = h2 & u1 = u2) &
    seqModel.emptyTree = <*>T &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       seqModel.(nodeTree.[l,[d,[r,[h,u]]]]) =
         (seqModel.l) ^ (<*d*> ^ (seqModel.r))) &
    realHeight.emptyTree = 0 &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       ((realHeight.l < realHeight.r &
         realHeight.(nodeTree.[l,[d,[r,[h,u]]]]) =
           1 + realHeight.r) or
        (not realHeight.l < realHeight.r &
         realHeight.(nodeTree.[l,[d,[r,[h,u]]]]) =
           1 + realHeight.l))) &
    emptyTree in Balanced &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       (nodeTree.[l,[d,[r,[h,u]]]] in Balanced iff
        h = realHeight.(nodeTree.[l,[d,[r,[h,u]]]]) &
        u = 0 &
        -(balancing) <= realHeight.r - realHeight.l &
        realHeight.r - realHeight.l <= balancing &
        l in Balanced &
        r in Balanced)) &
    (for xs being FinSequence of T,
         z being Integer
     holds
       mseq.[xs,z] = xs &
       mhgt.[xs,z] = z) &
    (for a being Element of T3 holds
       repr.a in Balanced &
       mseq.(m1.a) = seqModel.(repr.a) &
       mhgt.(m1.a) = realHeight.(repr.a)) &
    (for a,b being Element of T3 st
       repr.a = repr.b & m1.a = m1.b
     holds
       a = b) &
    (for a,b being Element of T4 st
       fld.a = fld.b
     holds
       a = b) &
    (for xs being FinSequence of T,
         i being Integer st
       0 <= i & i < len xs
     holds
       nthElem.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of T holds
       (xs in Sorted iff
        for i,j being Integer st
          0 <= i & i < j & j < len xs
        holds
          [key.(nthElem.[xs,i]),key.(nthElem.[xs,j])]
            in LtRel)) &
    (for a being Element of T4 holds
       mseq.(m1.(fld.a)) in Sorted) &
    (for xs being FinSequence of T,
         q being Element of K
     holds
       ([xs,q] in Domain iff
        ex i being Integer st
          0 <= i & i < len xs &
          [key.(nthElem.[xs,i]),q] in EqRel)) &
    (for xs being FinSequence of T,
         q being Element of K,
         i being Integer st
       xs in Sorted &
       [xs,q] in Domain &
       0 <= i & i < len xs &
       [key.(nthElem.[xs,i]),q] in EqRel
     holds
       makeFunc.[xs,q] = nthElem.[xs,i]) &
    (for xs being FinSequence of T,
         q being Element of K
     holds
       ([xs,q] in DomainClosure iff [xs,q] in Domain)) &
    (for xs being FinSequence of T,
         q being Element of K
     holds
       makeFuncClosure.[xs,q] = makeFunc.[xs,q]) &
    (for a being Element of T4,
         q being Element of K
     holds
       ([a,q] in mapDomain iff
        [mseq.(m1.(fld.a)),q] in DomainClosure)) &
    (for a being Element of T4,
         q being Element of K
     holds
       mapFunc.[a,q] =
         makeFuncClosure.[mseq.(m1.(fld.a)),q]) &
    (for a being Element of T4 holds
       mapCard.a = len(mseq.(m1.(fld.a)))) &
    (for l,r being Element of T3,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       nodeView.[l,[d,[r,[h,u]]]] <> emptyView) &
    (for v being Element of View holds
       v = emptyView or
       ex l,r being Element of T3,
          d being Element of T,
          h being Nat,
          u being Element of {0} st
         v = nodeView.[l,[d,[r,[h,u]]]]) &
    (for l1,l2,r1,r2 being Element of T3,
         d1,d2 being Element of T,
         h1,h2 being Nat,
         u1,u2 being Element of {0} st
       nodeView.[l1,[d1,[r1,[h1,u1]]]] =
         nodeView.[l2,[d2,[r2,[h2,u2]]]]
     holds
       l1 = l2 & d1 = d2 & r1 = r2 & h1 = h2 & u1 = u2) &
    (for l,r being Element of T4,
         d being Element of T,
         h being Nat
     holds
       nodeView1.[l,[d,[r,h]]] <> emptyView1) &
    (for v being Element of View1 holds
       v = emptyView1 or
       ex l,r being Element of T4,
          d being Element of T,
          h being Nat st
         v = nodeView1.[l,[d,[r,h]]]) &
    (for l1,l2,r1,r2 being Element of T4,
         d1,d2 being Element of T,
         h1,h2 being Nat st
       nodeView1.[l1,[d1,[r1,h1]]] =
         nodeView1.[l2,[d2,[r2,h2]]]
     holds
       l1 = l2 & d1 = d2 & r1 = r2 & h1 = h2)
  holds
    for o2 being Element of View st
      (o2 = emptyView &
       mhgt.(m1.(fld.t5)) = 0 &
       mseq.(m1.(fld.t5)) = <*>T) or
      (ex l,r being Element of T3,
          d being Element of T,
          h being Nat,
          u being Element of {0} st
        o2 = nodeView.[l,[d,[r,[h,u]]]] &
        mseq.(m1.(fld.t5)) =
          (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.r))) &
        u = 0 &
        -(balancing) <= mhgt.(m1.l) - mhgt.(m1.r) &
        mhgt.(m1.l) - mhgt.(m1.r) <= balancing &
        mhgt.(m1.(fld.t5)) = h &
        ((mhgt.(m1.l) < mhgt.(m1.r) &
          h = 1 + mhgt.(m1.r)) or
         (not mhgt.(m1.l) < mhgt.(m1.r) &
          h = 1 + mhgt.(m1.l))))
    holds
      (o2 = emptyView implies
        for result being Element of View1 st
          result = emptyView1
        holds
          mapCard.t5 = 0 &
          (for k being Element of K holds
             not [t5,k] in mapDomain)) &
      (for l,r being Element of T3,
           d being Element of T,
           h being Nat,
           u being Element of {0} st
         o2 = nodeView.[l,[d,[r,[h,u]]]]
       holds
         mseq.(m1.r) in Sorted &
         (for o3 being Element of T4 st
            fld.o3 = r
          holds
            mseq.(m1.l) in Sorted) &
         (for result being Element of View1 st
            ex o3 being Element of T4 st
              fld.o3 = r &
              ex o4 being Element of T4 st
                fld.o4 = l &
                result = nodeView1.[o4,[d,[o3,h]]]
          holds
            (result = emptyView1 implies
              mapCard.t5 = 0 &
              (for k being Element of K holds
                 not [t5,k] in mapDomain)) &
            (for l4,r4 being Element of T4,
                 d4 being Element of T,
                 h4 being Nat st
               result = nodeView1.[l4,[d4,[r4,h4]]]
             holds
               mapCard.t5 =
                 1 + mapCard.l4 + mapCard.r4 &
               h4 = mhgt.(m1.(fld.t5)) &
               (for k being Element of K st
                  [k,key.d4] in LtRel
                holds
                  ([l4,k] in mapDomain iff
                   [t5,k] in mapDomain)) &
               (for k being Element of K st
                  [k,key.d4] in LtRel &
                  [l4,k] in mapDomain
                holds
                  mapFunc.[l4,k] = mapFunc.[t5,k]) &
               (for k being Element of K st
                  [key.d4,k] in Leq
                holds
                  not [l4,k] in mapDomain) &
               (for k being Element of K st
                  [key.d4,k] in LtRel
                holds
                  ([r4,k] in mapDomain iff
                   [t5,k] in mapDomain)) &
               (for k being Element of K st
                  [key.d4,k] in LtRel &
                  [r4,k] in mapDomain
                holds
                  mapFunc.[r4,k] = mapFunc.[t5,k]) &
               (for k being Element of K st
                  [k,key.d4] in Leq
                holds
                  not [r4,k] in mapDomain) &
               (for k being Element of K st
                  [k,key.d4] in EqRel
                holds
                  [t5,k] in mapDomain &
                  mapFunc.[t5,k] = d4) &
               [t5,key.d4] in mapDomain &
               mapFunc.[t5,key.d4] = d4)))
proof
end;
::$P+
