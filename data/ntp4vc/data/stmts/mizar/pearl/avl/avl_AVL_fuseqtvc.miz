:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/avl_AVL_fuseqtvc: the AVL fuse verification condition preserves
:: concatenation of the modeled sequences and bounds the cached-height change
:: across the empty and nonempty view branches. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,T1,T2,U,Tree being non empty set,
      zero being Element of U,
      op being BinOp of U,
      measure being Function of T1,U,
      measureC being Function of T1,U,
      agg being Function of [:Funcs(T1,U),T1*:],U,
      balancing being Nat,
      emptyT being Element of Tree,
      node being Function of
        [:Tree,[:T1,[:Tree,[:NAT,U:]:]:]:],Tree,
      treeRank being Function of Tree,NAT,
      seqModel being Function of Tree,T1*,
      realHeight being Function of Tree,INT,
      Balanced being Subset of Tree,
      mseq being Function of [:T1*,INT:],T1*,
      mhgt being Function of [:T1*,INT:],INT,
      repr being Function of T2,Tree,
      m1 being Function of T2,[:T1*,INT:],
      l,r being Element of T2,
      o1 being Element of
        {0} \/ [:T2,[:T1,[:T2,[:NAT,U:]:]:]:]
  st
    (for a,b,c being Element of U holds
      op.(a,op.(b,c)) = op.(op.(a,b),c)) &
    (for x being Element of U holds
      op.(x,zero) = x & x = op.(zero,x)) &
    (for f being Function of T1,U holds
      agg.[f,<*>T1] = zero) &
    (for f being Function of T1,U,
         s being FinSequence of T1 st len s = 1
     holds
      agg.[f,s] = f.(s/.1)) &
    (for f being Function of T1,U,
         s1,s2,s3 being FinSequence of T1 st s3 = s1 ^ s2
     holds
      agg.[f,s3] = op.(agg.[f,s1],agg.[f,s2])) &
    (for y being Element of T1 holds
      measureC.y = measure.y) &
    balancing > 0 &
    treeRank.emptyT = 0 &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       node.[lt,[x,[rt,[h,s]]]] <> emptyT &
       treeRank.(node.[lt,[x,[rt,[h,s]]]]) =
         1 + treeRank.lt + treeRank.rt) &
    (for tr being Element of Tree holds
      tr = emptyT or
      ex lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U st
        tr = node.[lt,[x,[rt,[h,s]]]]) &
    (for lt,lt2 being Element of Tree,
         x,x2 being Element of T1,
         rt,rt2 being Element of Tree,
         h,h2 being Nat,
         s,s2 being Element of U st
       node.[lt,[x,[rt,[h,s]]]] =
         node.[lt2,[x2,[rt2,[h2,s2]]]]
     holds
       lt = lt2 & x = x2 & rt = rt2 & h = h2 & s = s2) &
    seqModel.emptyT = <*>T1 &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       seqModel.(node.[lt,[x,[rt,[h,s]]]]) =
         (seqModel.lt) ^ (<*x*> ^ (seqModel.rt))) &
    realHeight.emptyT = 0 &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       ((realHeight.lt < realHeight.rt &
         realHeight.(node.[lt,[x,[rt,[h,s]]]]) =
           1 + realHeight.rt) or
        (not realHeight.lt < realHeight.rt &
         realHeight.(node.[lt,[x,[rt,[h,s]]]]) =
           1 + realHeight.lt))) &
    emptyT in Balanced &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       (node.[lt,[x,[rt,[h,s]]]] in Balanced iff
        h = realHeight.(node.[lt,[x,[rt,[h,s]]]]) &
        s = agg.[measureC,
          seqModel.(node.[lt,[x,[rt,[h,s]]]])] &
        -(balancing) <= realHeight.rt - realHeight.lt &
        realHeight.rt - realHeight.lt <= balancing &
        lt in Balanced &
        rt in Balanced)) &
    (for xs being FinSequence of T1,
         z being Integer
     holds
       mseq.[xs,z] = xs &
       mhgt.[xs,z] = z) &
    (for a being Element of T2 holds
       repr.a in Balanced &
       mseq.(m1.a) = seqModel.(repr.a) &
       mhgt.(m1.a) = realHeight.(repr.a)) &
    (for a,b being Element of T2 st
       repr.a = repr.b & m1.a = m1.b
     holds
       a = b) &
    -(balancing) <= mhgt.(m1.l) - mhgt.(m1.r) &
    mhgt.(m1.l) - mhgt.(m1.r) <= balancing &
    ((o1 = 0 &
      mhgt.(m1.l) = 0 &
      mseq.(m1.l) = <*>T1) or
     (ex l1 being Element of T2,
         d1 being Element of T1,
         r1 being Element of T2,
         h1 being Nat,
         s1 being Element of U st
       o1 = [l1,[d1,[r1,[h1,s1]]]] &
       mseq.(m1.l) =
         (mseq.(m1.l1)) ^ (<*d1*> ^ (mseq.(m1.r1))) &
       s1 = agg.[measureC,mseq.(m1.l)] &
       -(balancing) <= mhgt.(m1.l1) - mhgt.(m1.r1) &
       mhgt.(m1.l1) - mhgt.(m1.r1) <= balancing &
       mhgt.(m1.l) = h1 &
       h1 = 1 + max(mhgt.(m1.l1),mhgt.(m1.r1))))
  holds
    (o1 = 0 or
     ex l0 being Element of T2,
        d0 being Element of T1,
        r0 being Element of T2,
        h0 being Nat,
        s0 being Element of U st
       o1 = [l0,[d0,[r0,[h0,s0]]]] &
       (for o2 being Element of
          {0} \/ [:T2,[:T1,[:T2,[:NAT,U:]:]:]:]
        st
          ((o2 = 0 &
            mhgt.(m1.r) = 0 &
            mseq.(m1.r) = <*>T1) or
           (ex l1 being Element of T2,
               d1 being Element of T1,
               r1 being Element of T2,
               h1 being Nat,
               s1 being Element of U st
             o2 = [l1,[d1,[r1,[h1,s1]]]] &
             mseq.(m1.r) =
               (mseq.(m1.l1)) ^ (<*d1*> ^ (mseq.(m1.r1))) &
             s1 = agg.[measureC,mseq.(m1.r)] &
             -(balancing) <= mhgt.(m1.l1) - mhgt.(m1.r1) &
             mhgt.(m1.l1) - mhgt.(m1.r1) <= balancing &
             mhgt.(m1.r) = h1 &
             h1 = 1 + max(mhgt.(m1.l1),mhgt.(m1.r1))))
        holds
          (o2 = 0 or
           ex rl being Element of T2,
              rd being Element of T1,
              rr being Element of T2,
              rh being Nat,
              rs being Element of U st
             o2 = [rl,[rd,[rr,[rh,rs]]]] &
             -(balancing) <= mhgt.(m1.rl) - mhgt.(m1.rr) &
             mhgt.(m1.rl) - mhgt.(m1.rr) <= balancing &
             (for d2 being Element of T1,
                  r2 being Element of T2 st
                (mseq.(m1.rl)) ^ (<*rd*> ^ (mseq.(m1.rr))) =
                  <*d2*> ^ (mseq.(m1.r2)) &
                0 <=
                  1 + max(mhgt.(m1.rl),mhgt.(m1.rr)) -
                    mhgt.(m1.r2) &
                1 + max(mhgt.(m1.rl),mhgt.(m1.rr)) -
                  mhgt.(m1.r2) <= 1
              holds
                -(balancing) - 1 <=
                  mhgt.(m1.l) - mhgt.(m1.r2) &
                mhgt.(m1.l) - mhgt.(m1.r2) <=
                  balancing + 1)))) &
    (for result being Element of T2 st
      ((o1 = 0 & result = r) or
       (ex l0 being Element of T2,
           d0 being Element of T1,
           r0 being Element of T2,
           h0 being Nat,
           s0 being Element of U st
         o1 = [l0,[d0,[r0,[h0,s0]]]] &
         ex o2 being Element of
            {0} \/ [:T2,[:T1,[:T2,[:NAT,U:]:]:]:]
         st
           ((o2 = 0 &
             mhgt.(m1.r) = 0 &
             mseq.(m1.r) = <*>T1) or
            (ex l1 being Element of T2,
                d1 being Element of T1,
                r1 being Element of T2,
                h1 being Nat,
                s1 being Element of U st
              o2 = [l1,[d1,[r1,[h1,s1]]]] &
              mseq.(m1.r) =
                (mseq.(m1.l1)) ^ (<*d1*> ^ (mseq.(m1.r1))) &
              s1 = agg.[measureC,mseq.(m1.r)] &
              -(balancing) <= mhgt.(m1.l1) - mhgt.(m1.r1) &
              mhgt.(m1.l1) - mhgt.(m1.r1) <= balancing &
              mhgt.(m1.r) = h1 &
              h1 = 1 + max(mhgt.(m1.l1),mhgt.(m1.r1)))) &
           ((o2 = 0 & result = l) or
            (ex rl being Element of T2,
                rd being Element of T1,
                rr being Element of T2,
                rh being Nat,
                rs being Element of U,
                d2 being Element of T1,
                res being Element of T2 st
              o2 = [rl,[rd,[rr,[rh,rs]]]] &
              (mseq.(m1.rl)) ^ (<*rd*> ^ (mseq.(m1.rr))) =
                <*d2*> ^ (mseq.(m1.res)) &
              0 <=
                1 + max(mhgt.(m1.rl),mhgt.(m1.rr)) -
                  mhgt.(m1.res) &
              1 + max(mhgt.(m1.rl),mhgt.(m1.rr)) -
                mhgt.(m1.res) <= 1 &
              mseq.(m1.result) =
                (mseq.(m1.l)) ^ (<*d2*> ^ (mseq.(m1.res))) &
              0 <=
                1 + max(mhgt.(m1.l),mhgt.(m1.res)) -
                  mhgt.(m1.result) &
              1 + max(mhgt.(m1.l),mhgt.(m1.res)) -
                mhgt.(m1.result) <= 1 &
              (-(balancing) <=
                 mhgt.(m1.l) - mhgt.(m1.res) &
               mhgt.(m1.l) - mhgt.(m1.res) <= balancing
               implies
                 1 + max(mhgt.(m1.l),mhgt.(m1.res)) =
                   mhgt.(m1.result))))))
     holds
       mseq.(m1.result) = (mseq.(m1.l)) ^ (mseq.(m1.r)) &
       1 + max(mhgt.(m1.l),mhgt.(m1.r)) -
         mhgt.(m1.result) <= 1 &
       0 <=
         1 + max(mhgt.(m1.l),mhgt.(m1.r)) -
           mhgt.(m1.result))
proof
end;
::$P+
