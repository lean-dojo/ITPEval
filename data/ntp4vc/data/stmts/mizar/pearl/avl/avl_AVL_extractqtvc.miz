:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/avl_AVL_extractqtvc: the AVL extraction verification condition
:: preserves the selected split, sequence reconstruction, middle option, and
:: bounded cached-height change across all selector branches. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,T1,T2,U,Tree,Selector,Part,Option,Split being non empty set,
      zero being Element of U,
      op being BinOp of U,
      measure being Function of T1,U,
      measureC being Function of T1,U,
      agg being Function of [:Funcs(T1,U),T1*:],U,
      balancing being Nat,
      emptyT being Element of Tree,
      node being Function of
        [:Tree,[:T1,[:Tree,[:NAT,U:]:]:]:],Tree,
      treeRank being Function of Tree,NAT,
      seqModel being Function of Tree,T1*,
      realHeight being Function of Tree,INT,
      Balanced being Subset of Tree,
      mseq being Function of [:T1*,INT:],T1*,
      mhgt being Function of [:T1*,INT:],INT,
      repr being Function of T2,Tree,
      m1 being Function of T2,[:T1*,INT:],
      noneOpt being Element of Option,
      someOpt being Function of T1,Option,
      splitMk being Function of
        [:T1*,[:Option,T1*:]:],Split,
      lpart,rpart being Function of Split,T1*,
      midpart being Function of Split,Option,
      rebuild being Function of Split,T1*,
      leftExt being Function of
        [:T1*,[:T1,Split:]:],Split,
      rightExt being Function of
        [:Split,[:T1,T1*:]:],Split,
      Selected being Subset of [:Selector,Split:],
      Possible being Subset of [:Selector,T1*:],
      s being Element of Selector,
      t3 being Element of T2,
      o1 being Element of
        {0} \/ [:T2,[:T1,[:T2,[:NAT,U:]:]:]:]
  st
    (for a,b,c being Element of U holds
      op.(a,op.(b,c)) = op.(op.(a,b),c)) &
    (for x being Element of U holds
      op.(x,zero) = x & x = op.(zero,x)) &
    (for f being Function of T1,U holds
      agg.[f,<*>T1] = zero) &
    (for f being Function of T1,U,
         xs being FinSequence of T1 st len xs = 1
     holds
      agg.[f,xs] = f.(xs/.1)) &
    (for f being Function of T1,U,
         xs,ys,zs being FinSequence of T1 st zs = xs ^ ys
     holds
      agg.[f,zs] = op.(agg.[f,xs],agg.[f,ys])) &
    (for y being Element of T1 holds
      measureC.y = measure.y) &
    balancing > 0 &
    treeRank.emptyT = 0 &
    (for l being Element of Tree,
         x being Element of T1,
         r being Element of Tree,
         h being Nat,
         u being Element of U
     holds
       node.[l,[x,[r,[h,u]]]] <> emptyT &
       treeRank.(node.[l,[x,[r,[h,u]]]]) =
         1 + treeRank.l + treeRank.r) &
    (for tr being Element of Tree holds
      tr = emptyT or
      ex l being Element of Tree,
         x being Element of T1,
         r being Element of Tree,
         h being Nat,
         u being Element of U st
        tr = node.[l,[x,[r,[h,u]]]]) &
    (for l,l2 being Element of Tree,
         x,x2 being Element of T1,
         r,r2 being Element of Tree,
         h,h2 being Nat,
         u,u2 being Element of U st
       node.[l,[x,[r,[h,u]]]] =
         node.[l2,[x2,[r2,[h2,u2]]]]
     holds
       l = l2 & x = x2 & r = r2 & h = h2 & u = u2) &
    seqModel.emptyT = <*>T1 &
    (for l being Element of Tree,
         x being Element of T1,
         r being Element of Tree,
         h being Nat,
         u being Element of U
     holds
       seqModel.(node.[l,[x,[r,[h,u]]]]) =
         (seqModel.l) ^ (<*x*> ^ (seqModel.r))) &
    realHeight.emptyT = 0 &
    (for l being Element of Tree,
         x being Element of T1,
         r being Element of Tree,
         h being Nat,
         u being Element of U
     holds
       ((realHeight.l < realHeight.r &
         realHeight.(node.[l,[x,[r,[h,u]]]]) =
           1 + realHeight.r) or
        (not realHeight.l < realHeight.r &
         realHeight.(node.[l,[x,[r,[h,u]]]]) =
           1 + realHeight.l))) &
    emptyT in Balanced &
    (for l being Element of Tree,
         x being Element of T1,
         r being Element of Tree,
         h being Nat,
         u being Element of U
     holds
       (node.[l,[x,[r,[h,u]]]] in Balanced iff
        h = realHeight.(node.[l,[x,[r,[h,u]]]]) &
        u = agg.[measureC,
          seqModel.(node.[l,[x,[r,[h,u]]]])] &
        -(balancing) <= realHeight.r - realHeight.l &
        realHeight.r - realHeight.l <= balancing &
        l in Balanced &
        r in Balanced)) &
    (for xs being FinSequence of T1,
         z being Integer
     holds
       mseq.[xs,z] = xs &
       mhgt.[xs,z] = z) &
    (for a being Element of T2 holds
       repr.a in Balanced &
       mseq.(m1.a) = seqModel.(repr.a) &
       mhgt.(m1.a) = realHeight.(repr.a)) &
    (for a,b being Element of T2 st
       repr.a = repr.b & m1.a = m1.b
     holds
       a = b) &
    (for x being Element of T1 holds
       someOpt.x <> noneOpt) &
    (for x,y being Element of T1 st
       someOpt.x = someOpt.y
     holds
       x = y) &
    (for opt being Element of Option holds
       opt = noneOpt or
       ex x being Element of T1 st opt = someOpt.x) &
    (for xs,ys being FinSequence of T1,
         opt being Element of Option
     holds
       lpart.(splitMk.[xs,[opt,ys]]) = xs &
       midpart.(splitMk.[xs,[opt,ys]]) = opt &
       rpart.(splitMk.[xs,[opt,ys]]) = ys) &
    (for e being Element of Split holds
       ex xs,ys being FinSequence of T1,
          opt being Element of Option st
         e = splitMk.[xs,[opt,ys]]) &
    (for xs,ys being FinSequence of T1 holds
       rebuild.(splitMk.[xs,[noneOpt,ys]]) = xs ^ ys) &
    (for xs,ys being FinSequence of T1,
         x being Element of T1
     holds
       rebuild.(splitMk.[xs,[someOpt.x,ys]]) =
         (xs ^ <*x*>) ^ ys) &
    (for xs being FinSequence of T1,
         x being Element of T1,
         e being Element of Split
     holds
       leftExt.[xs,[x,e]] =
         splitMk.[xs ^ (<*x*> ^ lpart.e),
           [midpart.e,rpart.e]]) &
    (for e being Element of Split,
         x being Element of T1,
         ys being FinSequence of T1
     holds
       rightExt.[e,[x,ys]] =
         splitMk.[lpart.e,
           [midpart.e,rpart.e ^ (<*x*> ^ ys)]]) &
    (for q being Element of Selector st
       [q,<*>T1] in Possible
     holds
       [q,splitMk.[<*>T1,[noneOpt,<*>T1]]] in Selected) &
    [s,mseq.(m1.t3)] in Possible &
    ((o1 = 0 &
      mhgt.(m1.t3) = 0 &
      mseq.(m1.t3) = <*>T1) or
     (ex l being Element of T2,
         d being Element of T1,
         r being Element of T2,
         h being Nat,
         u being Element of U st
       o1 = [l,[d,[r,[h,u]]]] &
       mseq.(m1.t3) =
         (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.r))) &
       u = agg.[measureC,mseq.(m1.t3)] &
       -(balancing) <= mhgt.(m1.l) - mhgt.(m1.r) &
       mhgt.(m1.l) - mhgt.(m1.r) <= balancing &
       mhgt.(m1.t3) = h &
       h = 1 + max(mhgt.(m1.l),mhgt.(m1.r))))
  holds
    (o1 = 0 &
      [s,splitMk.[<*>T1,[noneOpt,<*>T1]]] in Selected &
      rebuild.(splitMk.[<*>T1,[noneOpt,<*>T1]]) =
        mseq.(m1.t3) &
      mseq.(m1.t3) =
        (lpart.(splitMk.[<*>T1,[noneOpt,<*>T1]])) ^
        (rpart.(splitMk.[<*>T1,[noneOpt,<*>T1]])) &
      mhgt.(m1.t3) - mhgt.(m1.t3) <= 1 &
      0 <= mhgt.(m1.t3) - mhgt.(m1.t3) &
      midpart.(splitMk.[<*>T1,[noneOpt,<*>T1]]) = noneOpt) or
    (ex tl being Element of T2,
        td being Element of T1,
        tr being Element of T2,
        h being Nat,
        u being Element of U st
      o1 = [tl,[td,[tr,[h,u]]]] &
      [s,(mseq.(m1.tl)) ^ (<*td*> ^ (mseq.(m1.tr)))]
        in Possible &
      agg.[measureC,mseq.(m1.tl)] =
        agg.[measureC,mseq.(m1.tl)] &
      agg.[measureC,mseq.(m1.tr)] =
        agg.[measureC,mseq.(m1.tr)] &
      ([s,splitMk.[mseq.(m1.tl),
          [someOpt.td,mseq.(m1.tr)]]] in Selected
       implies
        -(balancing) <= mhgt.(m1.tl) - mhgt.(m1.tr) &
        mhgt.(m1.tl) - mhgt.(m1.tr) <= balancing &
        (for o5 being Element of T2 st
           mseq.(m1.o5) =
             (mseq.(m1.tl)) ^ (mseq.(m1.tr)) &
           1 + max(mhgt.(m1.tl),mhgt.(m1.tr)) -
             mhgt.(m1.o5) <= 1 &
           0 <=
             1 + max(mhgt.(m1.tl),mhgt.(m1.tr)) -
               mhgt.(m1.o5)
         holds
           [s,splitMk.[mseq.(m1.tl),
             [someOpt.td,mseq.(m1.tr)]]] in Selected &
           rebuild.(splitMk.[mseq.(m1.tl),
             [someOpt.td,mseq.(m1.tr)]]) =
               mseq.(m1.t3) &
           mseq.(m1.o5) =
             (lpart.(splitMk.[mseq.(m1.tl),
               [someOpt.td,mseq.(m1.tr)]])) ^
             (rpart.(splitMk.[mseq.(m1.tl),
               [someOpt.td,mseq.(m1.tr)]])) &
           mhgt.(m1.t3) - mhgt.(m1.o5) <= 1 &
           0 <= mhgt.(m1.t3) - mhgt.(m1.o5) &
           midpart.(splitMk.[mseq.(m1.tl),
             [someOpt.td,mseq.(m1.tr)]]) = someOpt.td)) &
      (for sl being Element of Selector st
         [sl,mseq.(m1.tl)] in Possible &
         (for e being Element of Split st
            [sl,e] in Selected &
            rebuild.e = mseq.(m1.tl)
          holds
            [s,rightExt.[e,[td,mseq.(m1.tr)]]] in Selected)
       holds
         0 <= mhgt.(m1.t3) &
         mhgt.(m1.tl) < mhgt.(m1.t3) &
         [sl,mseq.(m1.tl)] in Possible &
         (for e being Element of Split,
              opt being Element of Option,
              nl being Element of T2 st
            [sl,e] in Selected &
            rebuild.e = mseq.(m1.tl) &
            mseq.(m1.nl) = (lpart.e) ^ (rpart.e) &
            mhgt.(m1.tl) - mhgt.(m1.nl) <= 1 &
            0 <= mhgt.(m1.tl) - mhgt.(m1.nl) &
            midpart.e = opt
          holds
            -(balancing) - 1 <=
              mhgt.(m1.nl) - mhgt.(m1.tr) &
            mhgt.(m1.nl) - mhgt.(m1.tr) <=
              balancing + 1 &
            (for o5 being Element of T2 st
               mseq.(m1.o5) =
                 (mseq.(m1.nl)) ^ (<*td*> ^ (mseq.(m1.tr))) &
               0 <=
                 1 + max(mhgt.(m1.nl),mhgt.(m1.tr)) -
                   mhgt.(m1.o5) &
               1 + max(mhgt.(m1.nl),mhgt.(m1.tr)) -
                 mhgt.(m1.o5) <= 1 &
               (-(balancing) <=
                  mhgt.(m1.nl) - mhgt.(m1.tr) &
                mhgt.(m1.nl) - mhgt.(m1.tr) <= balancing
                implies
                  1 + max(mhgt.(m1.nl),mhgt.(m1.tr)) =
                    mhgt.(m1.o5))
             holds
               [s,rightExt.[e,[td,mseq.(m1.tr)]]] in Selected &
               rebuild.(rightExt.[e,[td,mseq.(m1.tr)]]) =
                 mseq.(m1.t3) &
               mseq.(m1.o5) =
                 (lpart.(rightExt.[e,
                   [td,mseq.(m1.tr)]])) ^
                 (rpart.(rightExt.[e,
                   [td,mseq.(m1.tr)]])) &
               mhgt.(m1.t3) - mhgt.(m1.o5) <= 1 &
               0 <= mhgt.(m1.t3) - mhgt.(m1.o5) &
               midpart.(rightExt.[e,
                 [td,mseq.(m1.tr)]]) = opt))) &
      (for sr being Element of Selector st
         [sr,mseq.(m1.tr)] in Possible &
         (for e being Element of Split st
            [sr,e] in Selected &
            rebuild.e = mseq.(m1.tr)
          holds
            [s,leftExt.[mseq.(m1.tl),[td,e]]] in Selected)
       holds
         0 <= mhgt.(m1.t3) &
         mhgt.(m1.tr) < mhgt.(m1.t3) &
         [sr,mseq.(m1.tr)] in Possible &
         (for e being Element of Split,
              opt being Element of Option,
              nr being Element of T2 st
            [sr,e] in Selected &
            rebuild.e = mseq.(m1.tr) &
            mseq.(m1.nr) = (lpart.e) ^ (rpart.e) &
            mhgt.(m1.tr) - mhgt.(m1.nr) <= 1 &
            0 <= mhgt.(m1.tr) - mhgt.(m1.nr) &
            midpart.e = opt
          holds
            -(balancing) - 1 <=
              mhgt.(m1.tl) - mhgt.(m1.nr) &
            mhgt.(m1.tl) - mhgt.(m1.nr) <=
              balancing + 1 &
            (for o5 being Element of T2 st
               mseq.(m1.o5) =
                 (mseq.(m1.tl)) ^ (<*td*> ^ (mseq.(m1.nr))) &
               0 <=
                 1 + max(mhgt.(m1.tl),mhgt.(m1.nr)) -
                   mhgt.(m1.o5) &
               1 + max(mhgt.(m1.tl),mhgt.(m1.nr)) -
                 mhgt.(m1.o5) <= 1 &
               (-(balancing) <=
                  mhgt.(m1.tl) - mhgt.(m1.nr) &
                mhgt.(m1.tl) - mhgt.(m1.nr) <= balancing
                implies
                  1 + max(mhgt.(m1.tl),mhgt.(m1.nr)) =
                    mhgt.(m1.o5))
             holds
               [s,leftExt.[mseq.(m1.tl),[td,e]]] in Selected &
               rebuild.(leftExt.[mseq.(m1.tl),[td,e]]) =
                 mseq.(m1.t3) &
               mseq.(m1.o5) =
                 (lpart.(leftExt.[mseq.(m1.tl),
                   [td,e]])) ^
                 (rpart.(leftExt.[mseq.(m1.tl),
                   [td,e]])) &
               mhgt.(m1.t3) - mhgt.(m1.o5) <= 1 &
               0 <= mhgt.(m1.t3) - mhgt.(m1.o5) &
               midpart.(leftExt.[mseq.(m1.tl),
                 [td,e]]) = opt))))
proof
end;
::$P+
