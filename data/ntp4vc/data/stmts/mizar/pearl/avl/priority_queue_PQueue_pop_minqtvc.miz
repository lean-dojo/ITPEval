:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/priority_queue_PQueue_pop_minqtvc.
:: It states the pop-minimum contract for an injectively represented AVL
:: priority queue, including balance, height, sequence, cached minimum
:: aggregation, split selection, bag, minimum, and cardinality models.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1,
    FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T1,T2,K,KeyOption,Tree,ElemOption,Split being non empty set,
      noneKey being Element of KeyOption,
      someKey being Function of K,KeyOption,
      Leq being Relation of K,K,
      minOp being BinOp of KeyOption,
      key being Function of T1,K,
      measure,measureC being Function of T1,KeyOption,
      agg being Function of [:Funcs(T1,KeyOption),T1*:],KeyOption,
      balancing being Nat,
      emptyT being Element of Tree,
      node being Function of
        [:Tree,[:T1,[:Tree,[:NAT,KeyOption:]:]:]:],Tree,
      treeRank being Function of Tree,NAT,
      seqModel being Function of Tree,T1*,
      realHeight being Function of Tree,INT,
      Balanced being Subset of Tree,
      mseq being Function of [:T1*,INT:],T1*,
      mhgt being Function of [:T1*,INT:],INT,
      repr being Function of T2,Tree,
      m1 being Function of T2,[:T1*,INT:],
      nthElem being Function of [:T1*,NAT:],T1,
      defaultItem being Element of T1,
      noneElem being Element of ElemOption,
      someElem being Function of T1,ElemOption,
      splitMk being Function of
        [:T1*,[:ElemOption,T1*:]:],Split,
      leftPart,rightPart being Function of Split,T1*,
      middlePart being Function of Split,ElemOption,
      rebuild being Function of Split,T1*,
      Selected being Subset of Split,
      minPos being Function of T1*,NAT,
      qBag being Function of [:T2,T1:],INT,
      qMinimum being Function of T2,T1,
      qCard being Function of T2,INT,
      t5 being Element of T2
  st
    (for x being Element of KeyOption holds
       x = noneKey or ex k being Element of K st x = someKey.k)
  & (for a,b being Element of K st someKey.a = someKey.b holds a = b)
  & (for k being Element of K holds someKey.k <> noneKey)
  & (for k being Element of K holds [k,k] in Leq)
  & (for a,b,c being Element of K st
       [a,b] in Leq & [b,c] in Leq holds [a,c] in Leq)
  & (for a,b being Element of K holds
       [a,b] in Leq or [b,a] in Leq)
  & (for x being Element of KeyOption holds
       minOp.(noneKey,x) = x & minOp.(x,noneKey) = x)
  & (for a,b being Element of K holds
       (([b,a] in Leq & not [a,b] in Leq) implies
          minOp.(someKey.a,someKey.b) = someKey.b)
     & ((not ([b,a] in Leq & not [a,b] in Leq)) implies
          minOp.(someKey.a,someKey.b) = someKey.a))
  & (for x,y,z being Element of KeyOption holds
       minOp.(minOp.(x,y),z) = minOp.(x,minOp.(y,z)))
  & (for f being Function of T1,KeyOption holds
       agg.[f,<*>T1] = noneKey)
  & (for f being Function of T1,KeyOption,
         x being Element of T1, xs being FinSequence of T1 holds
       agg.[f,<*x*> ^ xs] = minOp.(f.x,agg.[f,xs]))
  & (for x being Element of T1 holds measure.x = someKey.(key.x))
  & measureC = measure
  & balancing > 0
  & treeRank.emptyT = 0
  & (for l,r being Element of Tree, d being Element of T1,
         h being Nat, u being Element of KeyOption holds
       node.[l,[d,[r,[h,u]]]] <> emptyT
     & treeRank.(node.[l,[d,[r,[h,u]]]])
         = 1 + treeRank.l + treeRank.r)
  & (for tr being Element of Tree holds tr = emptyT or
       ex l,r being Element of Tree, d being Element of T1,
          h being Nat, u being Element of KeyOption st
         tr = node.[l,[d,[r,[h,u]]]])
  & (for l1,l2,r1,r2 being Element of Tree,
         d1,d2 being Element of T1, h1,h2 being Nat,
         u1,u2 being Element of KeyOption st
       node.[l1,[d1,[r1,[h1,u1]]]]
         = node.[l2,[d2,[r2,[h2,u2]]]]
     holds l1 = l2 & d1 = d2 & r1 = r2 & h1 = h2 & u1 = u2)
  & seqModel.emptyT = <*>T1
  & (for l,r being Element of Tree, d being Element of T1,
         h being Nat, u being Element of KeyOption holds
       seqModel.(node.[l,[d,[r,[h,u]]]])
         = seqModel.l ^ <*d*> ^ seqModel.r)
  & realHeight.emptyT = 0
  & (for l,r being Element of Tree, d being Element of T1,
         h being Nat, u being Element of KeyOption holds
       ((realHeight.l <= realHeight.r implies
          realHeight.(node.[l,[d,[r,[h,u]]]]) = 1 + realHeight.r)
      & (realHeight.r <= realHeight.l implies
          realHeight.(node.[l,[d,[r,[h,u]]]]) = 1 + realHeight.l)))
  & emptyT in Balanced
  & (for l,r being Element of Tree, d being Element of T1,
         h being Nat, u being Element of KeyOption holds
       (node.[l,[d,[r,[h,u]]]] in Balanced iff
          h = realHeight.(node.[l,[d,[r,[h,u]]]])
        & u = agg.[measureC,seqModel.(node.[l,[d,[r,[h,u]]]])]
        & -balancing <= realHeight.r - realHeight.l
        & realHeight.r - realHeight.l <= balancing
        & l in Balanced & r in Balanced))
  & (for xs being FinSequence of T1, z being Integer holds
       mseq.[xs,z] = xs & mhgt.[xs,z] = z)
  & (for q being Element of T2 holds
       repr.q in Balanced
     & mseq.(m1.q) = seqModel.(repr.q)
     & mhgt.(m1.q) = realHeight.(repr.q))
  & (for a,b being Element of T2 st
       repr.a = repr.b & m1.a = m1.b holds a = b)
  & (for xs being FinSequence of T1, p being Nat st p in dom xs holds
       nthElem.[xs,p] = xs/.p)
  & (for x being Element of ElemOption holds
       x = noneElem or ex d being Element of T1 st x = someElem.d)
  & (for a,b being Element of T1 st someElem.a = someElem.b holds a = b)
  & (for d being Element of T1 holds someElem.d <> noneElem)
  & (for xs,ys being FinSequence of T1,
         opt being Element of ElemOption holds
       leftPart.(splitMk.[xs,[opt,ys]]) = xs
     & middlePart.(splitMk.[xs,[opt,ys]]) = opt
     & rightPart.(splitMk.[xs,[opt,ys]]) = ys)
  & (for s being Element of Split holds
       ex xs,ys being FinSequence of T1,
          opt being Element of ElemOption st
         s = splitMk.[xs,[opt,ys]])
  & (for s being Element of Split st middlePart.s = noneElem holds
       rebuild.s = leftPart.s ^ rightPart.s)
  & (for s being Element of Split, d being Element of T1 st
       middlePart.s = someElem.d holds
       rebuild.s = (leftPart.s ^ <*d*>) ^ rightPart.s)
  & (for s being Element of Split holds
       (s in Selected iff
          (ex d being Element of T1 st
             middlePart.s = someElem.d
           & (for i being Nat st i in dom (rightPart.s) holds
                [key.d,key.(nthElem.[rightPart.s,i])] in Leq)
           & (for i being Nat st i in dom (leftPart.s) holds
                [key.d,key.(nthElem.[leftPart.s,i])] in Leq
              & not [key.(nthElem.[leftPart.s,i]),key.d] in Leq))))
  & (for xs being non empty FinSequence of T1, p being Nat st
       p = minPos.xs holds
       p in dom xs
     & agg.[measureC,xs] = someKey.(key.(nthElem.[xs,p]))
     & (for i being Nat st i in dom xs & i < p holds
          [key.(nthElem.[xs,p]),key.(nthElem.[xs,i])] in Leq
        & not [key.(nthElem.[xs,i]),key.(nthElem.[xs,p])] in Leq)
     & (for i being Nat st i in dom xs & p <= i holds
          [key.(nthElem.[xs,p]),key.(nthElem.[xs,i])] in Leq))
  & (for q being Element of T2, d being Element of T1 holds
       qBag.[q,d]
         = card { i where i is Element of NAT :
                    i in dom (mseq.(m1.q))
                  & nthElem.[mseq.(m1.q),i] = d })
  & (for q being Element of T2 holds qCard.q = len (mseq.(m1.q)))
  & (for q being Element of T2 st mseq.(m1.q) = <*>T1 holds
       qMinimum.q = defaultItem)
  & (for q being Element of T2 st mseq.(m1.q) <> <*>T1 holds
       qMinimum.q = nthElem.[mseq.(m1.q),minPos.(mseq.(m1.q))])
  & 0 < qCard.t5
  holds
    len (mseq.(m1.t5)) <> 0
  & (for r being Element of Split,
         res being Element of T2 st
       mseq.(m1.res) = leftPart.r ^ rightPart.r
     & r in Selected
     & rebuild.r = mseq.(m1.t5)
     & mhgt.(m1.t5) - mhgt.(m1.res) <= 1
     & 0 <= mhgt.(m1.t5) - mhgt.(m1.res)
     holds
       qCard.t5 = qCard.res + 1
     & (ex b5,bres being Integer st
          b5 = qBag.[t5,qMinimum.t5]
        & bres = qBag.[res,qMinimum.t5]
        & b5 = bres + 1)
     & (for d2 being Element of T1 st d2 <> qMinimum.t5 holds
          qBag.[t5,d2] = qBag.[res,d2]))
proof
end;
::$P+
