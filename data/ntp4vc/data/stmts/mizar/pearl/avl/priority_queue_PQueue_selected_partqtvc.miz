:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/priority_queue_PQueue_selected_partqtvc: the priority-queue
:: selection VC chooses here, left, or right from cached minimum keys and
:: preserves the strict/non-strict split-selection invariant.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T,K,KeyOption,ElemOption,Split,Result being non empty set,
      balancing being Nat,
      Leq,EqRel,LtRel being Relation of K,K,
      key being Function of T,K,
      noneKey being Element of KeyOption,
      someKey being Function of K,KeyOption,
      minOp being BinOp of KeyOption,
      agg being Function of [:Funcs(T,KeyOption),T*:],KeyOption,
      measureC being Function of T,KeyOption,
      noneElem being Element of ElemOption,
      someElem being Function of T,ElemOption,
      splitMk being Function of
        [:T*,[:ElemOption,T*:]:],Split,
      lpart,rpart being Function of Split,T*,
      midpart being Function of Split,ElemOption,
      rebuild being Function of Split,T*,
      nthElem being Function of [:T*,INT:],T,
      Selected being Subset of Split,
      Here,LeftU,RightU being Element of Result,
      d being Element of T,
      rseq,lseq being FinSequence of T
  st
    balancing > 0 &
    (for x being Element of K holds [x,x] in Leq) &
    (for x,y,z being Element of K st
       [x,y] in Leq & [y,z] in Leq
     holds
       [x,z] in Leq) &
    (for x,y being Element of K holds
       [x,y] in Leq or [y,x] in Leq) &
    (for x,y being Element of K holds
       ([x,y] in EqRel iff
          [x,y] in Leq & [y,x] in Leq)) &
    (for x,y being Element of K holds
       ([x,y] in LtRel iff
          [x,y] in Leq & not [y,x] in Leq)) &
    (for opt being Element of KeyOption holds
       opt = noneKey or
       ex x being Element of K st opt = someKey.x) &
    (for x being Element of K holds someKey.x <> noneKey) &
    (for x,y being Element of K st someKey.x = someKey.y
     holds x = y) &
    (for opt being Element of KeyOption holds
       minOp.(noneKey,opt) = opt &
       minOp.(opt,noneKey) = opt) &
    (for x,y being Element of K holds
       ([y,x] in LtRel implies
          minOp.(someKey.x,someKey.y) = someKey.y) &
       (not [y,x] in LtRel implies
          minOp.(someKey.x,someKey.y) = someKey.x)) &
    (for x,y,z being Element of KeyOption holds
       minOp.(x,minOp.(y,z)) = minOp.(minOp.(x,y),z)) &
    (for f being Function of T,KeyOption holds
       agg.[f,<*>T] = noneKey) &
    (for f being Function of T,KeyOption,
         x being Element of T,
         xs being FinSequence of T
     holds
       agg.[f,<*x*> ^ xs] = minOp.(f.x,agg.[f,xs])) &
    (for x being Element of T holds
       measureC.x = someKey.(key.x)) &
    (for opt being Element of ElemOption holds
       opt = noneElem or
       ex x being Element of T st opt = someElem.x) &
    (for x being Element of T holds someElem.x <> noneElem) &
    (for x,y being Element of T st someElem.x = someElem.y
     holds x = y) &
    (for xs,ys being FinSequence of T,
         opt being Element of ElemOption
     holds
       lpart.(splitMk.[xs,[opt,ys]]) = xs &
       midpart.(splitMk.[xs,[opt,ys]]) = opt &
       rpart.(splitMk.[xs,[opt,ys]]) = ys) &
    (for e being Element of Split holds
       ex xs,ys being FinSequence of T,
          opt being Element of ElemOption st
         e = splitMk.[xs,[opt,ys]]) &
    (for xs,ys being FinSequence of T holds
       rebuild.(splitMk.[xs,[noneElem,ys]]) = xs ^ ys) &
    (for xs,ys being FinSequence of T,
         x being Element of T
     holds
       rebuild.(splitMk.[xs,[someElem.x,ys]]) =
         (xs ^ <*x*>) ^ ys) &
    (for xs being FinSequence of T,
         i being Nat st i < len xs
     holds
       nthElem.[xs,i] = xs.(i+1)) &
    (for e being Element of Split holds
       (e in Selected iff
        ex x being Element of T st
          midpart.e = someElem.x &
          (for i being Integer st
             0 <= i & i < len(rpart.e)
           holds
             [key.x,key.(nthElem.[rpart.e,i])] in Leq) &
          (for i being Integer st
             0 <= i & i < len(lpart.e)
           holds
             [key.x,key.(nthElem.[lpart.e,i])] in LtRel))) &
    Here <> LeftU & Here <> RightU & LeftU <> RightU &
    (for result being Element of Result holds
       result = Here or result = LeftU or result = RightU)
  holds
    for result being Element of Result st
      (agg.[measureC,rseq] = noneKey &
         agg.[measureC,lseq] = noneKey &
         result = Here) or
      (ex x being Element of K,
          o1 being Integer st
         agg.[measureC,rseq] = noneKey &
         agg.[measureC,lseq] = someKey.x &
         (0 < o1 iff [x,key.d] in LtRel) &
         (o1 < 0 iff [key.d,x] in LtRel) &
         (o1 = 0 iff [key.d,x] in EqRel) &
         ((o1 < 0 & result = Here) or
          (not o1 < 0 & result = LeftU))) or
      (ex x being Element of K,
          o1 being Integer st
         agg.[measureC,rseq] = someKey.x &
         agg.[measureC,lseq] = noneKey &
         (0 < o1 iff [x,key.d] in LtRel) &
         (o1 < 0 iff [key.d,x] in LtRel) &
         (o1 = 0 iff [key.d,x] in EqRel) &
         ((o1 <= 0 & result = Here) or
          (not o1 <= 0 & result = RightU))) or
      (ex x,x1 being Element of K,
          o1 being Integer st
         agg.[measureC,rseq] = someKey.x &
         agg.[measureC,lseq] = someKey.x1 &
         (0 < o1 iff [x,key.d] in LtRel) &
         (o1 < 0 iff [key.d,x] in LtRel) &
         (o1 = 0 iff [key.d,x] in EqRel) &
         ((o1 <= 0 &
            ex o2 being Integer st
              (0 < o2 iff [key.d,x1] in LtRel) &
              (o2 < 0 iff [x1,key.d] in LtRel) &
              (o2 = 0 iff [x1,key.d] in EqRel) &
              ((o2 <= 0 & result = LeftU) or
               (not o2 <= 0 & result = Here))) or
          (not o1 <= 0 &
            ex o2 being Integer st
              (0 < o2 iff [x,x1] in LtRel) &
              (o2 < 0 iff [x1,x] in LtRel) &
              (o2 = 0 iff [x1,x] in EqRel) &
              ((o2 <= 0 & result = LeftU) or
               (not o2 <= 0 & result = RightU)))))
    holds
      (result = Here &
        splitMk.[lseq,[someElem.d,rseq]] in Selected) or
      (result = LeftU &
        lseq <> <*>T &
        (for e being Element of Split st
           e in Selected & rebuild.e = lseq
         holds
           splitMk.[lpart.e,
             [midpart.e,rpart.e ^ (<*d*> ^ rseq)]]
               in Selected)) or
      (result = RightU &
        rseq <> <*>T &
        (for e being Element of Split st
           e in Selected & rebuild.e = rseq
         holds
           splitMk.[lseq ^ (<*d*> ^ lpart.e),
             [midpart.e,rpart.e]]
               in Selected))
proof
end;
::$P+
