:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/tables_MapBase_getqtvc: an ordered AVL-backed map lookup
:: verification condition relating a selected split to domain membership,
:: cardinality, key equality, and the stored value. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T,K,Tree,T3,T4,Option,Split being non empty set,
      balancing being Nat,
      key being Function of T,K,
      Leq,EqRel,LtRel being Relation of K,K,
      emptyT being Element of Tree,
      node being Function of
        [:Tree,[:T,[:Tree,[:NAT,{0}:]:]:]:],Tree,
      treeRank being Function of Tree,NAT,
      seqModel being Function of Tree,T*,
      realHeight being Function of Tree,INT,
      Balanced being Subset of Tree,
      mseq being Function of [:T*,INT:],T*,
      mhgt being Function of [:T*,INT:],INT,
      repr being Function of T3,Tree,
      m1 being Function of T3,[:T*,INT:],
      fld being Function of T4,T3,
      noneOpt being Element of Option,
      someOpt being Function of T,Option,
      splitMk being Function of
        [:T*,[:Option,T*:]:],Split,
      lpart,rpart being Function of Split,T*,
      midpart being Function of Split,Option,
      rebuild being Function of Split,T*,
      nthElem being Function of [:T*,INT:],T,
      Sorted being Subset of T*,
      Selected being Subset of [:K,Split:],
      Domain,DomainClosure being Subset of [:T*,K:],
      makeFunc,makeFuncClosure being Function of [:T*,K:],T,
      mapDomain being Subset of [:T4,K:],
      mapFunc being Function of [:T4,K:],T,
      mapCard being Function of T4,INT,
      t5 being Element of T4,
      k being Element of K
  st
    balancing > 0 &
    (for x being Element of K holds [x,x] in Leq) &
    (for x,y,z being Element of K st
       [x,y] in Leq & [y,z] in Leq
     holds
       [x,z] in Leq) &
    (for x,y being Element of K holds
       [x,y] in Leq or [y,x] in Leq) &
    (for x,y being Element of K holds
       ([x,y] in EqRel iff
         [x,y] in Leq & [y,x] in Leq)) &
    (for x,y being Element of K holds
       ([x,y] in LtRel iff
         [x,y] in Leq & not [y,x] in Leq)) &
    treeRank.emptyT = 0 &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       node.[l,[d,[r,[h,u]]]] <> emptyT &
       treeRank.(node.[l,[d,[r,[h,u]]]]) =
         1 + treeRank.l + treeRank.r) &
    (for tr being Element of Tree holds
       tr = emptyT or
       ex l,r being Element of Tree,
          d being Element of T,
          h being Nat,
          u being Element of {0} st
         tr = node.[l,[d,[r,[h,u]]]]) &
    (for l1,l2,r1,r2 being Element of Tree,
         d1,d2 being Element of T,
         h1,h2 being Nat,
         u1,u2 being Element of {0} st
       node.[l1,[d1,[r1,[h1,u1]]]] =
         node.[l2,[d2,[r2,[h2,u2]]]]
     holds
       l1 = l2 & d1 = d2 & r1 = r2 & h1 = h2 & u1 = u2) &
    seqModel.emptyT = <*>T &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       seqModel.(node.[l,[d,[r,[h,u]]]]) =
         (seqModel.l) ^ (<*d*> ^ (seqModel.r))) &
    realHeight.emptyT = 0 &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       ((realHeight.l < realHeight.r &
         realHeight.(node.[l,[d,[r,[h,u]]]]) =
           1 + realHeight.r) or
        (not realHeight.l < realHeight.r &
         realHeight.(node.[l,[d,[r,[h,u]]]]) =
           1 + realHeight.l))) &
    emptyT in Balanced &
    (for l,r being Element of Tree,
         d being Element of T,
         h being Nat,
         u being Element of {0}
     holds
       (node.[l,[d,[r,[h,u]]]] in Balanced iff
        h = realHeight.(node.[l,[d,[r,[h,u]]]]) &
        u = 0 &
        -(balancing) <= realHeight.r - realHeight.l &
        realHeight.r - realHeight.l <= balancing &
        l in Balanced &
        r in Balanced)) &
    (for xs being FinSequence of T,
         z being Integer
     holds
       mseq.[xs,z] = xs &
       mhgt.[xs,z] = z) &
    (for a being Element of T3 holds
       repr.a in Balanced &
       mseq.(m1.a) = seqModel.(repr.a) &
       mhgt.(m1.a) = realHeight.(repr.a)) &
    (for a,b being Element of T3 st
       repr.a = repr.b & m1.a = m1.b
     holds
       a = b) &
    (for a,b being Element of T4 st
       fld.a = fld.b
     holds
       a = b) &
    (for x being Element of T holds
       someOpt.x <> noneOpt) &
    (for x,y being Element of T st
       someOpt.x = someOpt.y
     holds
       x = y) &
    (for opt being Element of Option holds
       opt = noneOpt or
       ex x being Element of T st opt = someOpt.x) &
    (for xs,ys being FinSequence of T,
         opt being Element of Option
     holds
       lpart.(splitMk.[xs,[opt,ys]]) = xs &
       midpart.(splitMk.[xs,[opt,ys]]) = opt &
       rpart.(splitMk.[xs,[opt,ys]]) = ys) &
    (for e being Element of Split holds
       ex xs,ys being FinSequence of T,
          opt being Element of Option st
         e = splitMk.[xs,[opt,ys]]) &
    (for xs,ys being FinSequence of T holds
       rebuild.(splitMk.[xs,[noneOpt,ys]]) = xs ^ ys) &
    (for xs,ys being FinSequence of T,
         x being Element of T
     holds
       rebuild.(splitMk.[xs,[someOpt.x,ys]]) =
         (xs ^ <*x*>) ^ ys) &
    (for xs being FinSequence of T,
         i being Integer st
       0 <= i & i < len xs
     holds
       nthElem.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of T holds
       (xs in Sorted iff
        for i,j being Integer st
          0 <= i & i < j & j < len xs
        holds
          [key.(nthElem.[xs,i]),key.(nthElem.[xs,j])]
            in LtRel)) &
    (for a being Element of T4 holds
       mseq.(m1.(fld.a)) in Sorted) &
    (for q being Element of K,
         e being Element of Split
     holds
       ([q,e] in Selected iff
        (for i being Integer st
           0 <= i & i < len(lpart.e)
         holds
           [key.(nthElem.[lpart.e,i]),q] in LtRel) &
        (for i being Integer st
           0 <= i & i < len(rpart.e)
         holds
           [q,key.(nthElem.[rpart.e,i])] in LtRel) &
        (midpart.e = noneOpt or
         ex d being Element of T st
           midpart.e = someOpt.d &
           [q,key.d] in EqRel))) &
    (for xs being FinSequence of T,
         q being Element of K
     holds
       ([xs,q] in Domain iff
        ex i being Integer st
          0 <= i & i < len xs &
          [key.(nthElem.[xs,i]),q] in EqRel)) &
    (for xs being FinSequence of T,
         q being Element of K,
         i being Integer st
       xs in Sorted &
       [xs,q] in Domain &
       0 <= i & i < len xs &
       [key.(nthElem.[xs,i]),q] in EqRel
     holds
       makeFunc.[xs,q] = nthElem.[xs,i]) &
    (for xs being FinSequence of T,
         q being Element of K
     holds
       ([xs,q] in DomainClosure iff [xs,q] in Domain)) &
    (for xs being FinSequence of T,
         q being Element of K
     holds
       makeFuncClosure.[xs,q] = makeFunc.[xs,q]) &
    (for a being Element of T4,
         q being Element of K
     holds
       ([a,q] in mapDomain iff
        [mseq.(m1.(fld.a)),q] in DomainClosure)) &
    (for a being Element of T4,
         q being Element of K
     holds
       mapFunc.[a,q] =
         makeFuncClosure.[mseq.(m1.(fld.a)),q]) &
    (for a being Element of T4 holds
       mapCard.a = len(mseq.(m1.(fld.a))))
  holds
    mseq.(m1.(fld.t5)) in Sorted &
    (for o2 being Element of Split,
         result being Element of Option st
       [k,o2] in Selected &
       rebuild.o2 = mseq.(m1.(fld.t5)) &
       midpart.o2 = result
     holds
       (result = noneOpt &
        not [t5,k] in mapDomain) or
       (ex d being Element of T st
          result = someOpt.d &
          0 < mapCard.t5 &
          [key.d,k] in EqRel &
          [t5,k] in mapDomain &
          mapFunc.[t5,k] = d))
proof
end;
::$P+
