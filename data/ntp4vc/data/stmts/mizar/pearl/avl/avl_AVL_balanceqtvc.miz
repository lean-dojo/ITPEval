:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/avl/avl_AVL_balanceqtvc: the AVL-tree balance verification condition
:: for sequence preservation and bounded cached-height change across single
:: and double rotations. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,T1,T2,U,Tree being non empty set,
      zero being Element of U,
      op being BinOp of U,
      measure being Function of T1,U,
      measureC being Function of T1,U,
      agg being Function of [:Funcs(T1,U),T1*:],U,
      balancing being Nat,
      hl,hr,o1 being Integer,
      emptyT being Element of Tree,
      node being Function of
        [:Tree,[:T1,[:Tree,[:NAT,U:]:]:]:],Tree,
      treeRank being Function of Tree,NAT,
      seqModel being Function of Tree,T1*,
      realHeight being Function of Tree,INT,
      Balanced being Subset of Tree,
      mseq being Function of [:T1*,INT:],T1*,
      mhgt being Function of [:T1*,INT:],INT,
      repr being Function of T2,Tree,
      m1 being Function of T2,[:T1*,INT:],
      l,r being Element of T2,
      d being Element of T1
  st
    (for a,b,c being Element of U holds
      op.(a,op.(b,c)) = op.(op.(a,b),c)) &
    (for x being Element of U holds
      op.(x,zero) = x & x = op.(zero,x)) &
    (for f being Function of T1,U holds
      agg.[f,<*>T1] = zero) &
    (for f being Function of T1,U,
         s being FinSequence of T1 st len s = 1
     holds
      agg.[f,s] = f.(s/.1)) &
    (for f being Function of T1,U,
         s1,s2,s3 being FinSequence of T1 st s3 = s1 ^ s2
     holds
      agg.[f,s3] = op.(agg.[f,s1],agg.[f,s2])) &
    (for y being Element of T1 holds
      measureC.y = measure.y) &
    balancing > 0 &
    treeRank.emptyT = 0 &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       node.[lt,[x,[rt,[h,s]]]] <> emptyT &
       treeRank.(node.[lt,[x,[rt,[h,s]]]]) =
         1 + treeRank.lt + treeRank.rt) &
    (for tr being Element of Tree holds
      tr = emptyT or
      ex lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U st
        tr = node.[lt,[x,[rt,[h,s]]]]) &
    (for lt,lt2 being Element of Tree,
         x,x2 being Element of T1,
         rt,rt2 being Element of Tree,
         h,h2 being Nat,
         s,s2 being Element of U st
       node.[lt,[x,[rt,[h,s]]]] =
         node.[lt2,[x2,[rt2,[h2,s2]]]]
     holds
       lt = lt2 & x = x2 & rt = rt2 & h = h2 & s = s2) &
    seqModel.emptyT = <*>T1 &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       seqModel.(node.[lt,[x,[rt,[h,s]]]]) =
         (seqModel.lt) ^ (<*x*> ^ (seqModel.rt))) &
    realHeight.emptyT = 0 &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       ((realHeight.lt < realHeight.rt &
         realHeight.(node.[lt,[x,[rt,[h,s]]]]) =
           1 + realHeight.rt) or
        (not realHeight.lt < realHeight.rt &
         realHeight.(node.[lt,[x,[rt,[h,s]]]]) =
           1 + realHeight.lt))) &
    emptyT in Balanced &
    (for lt being Element of Tree,
         x being Element of T1,
         rt being Element of Tree,
         h being Nat,
         s being Element of U
     holds
       (node.[lt,[x,[rt,[h,s]]]] in Balanced iff
        h = realHeight.(node.[lt,[x,[rt,[h,s]]]]) &
        s = agg.[measureC,
          seqModel.(node.[lt,[x,[rt,[h,s]]]])] &
        -(balancing) <= realHeight.rt - realHeight.lt &
        realHeight.rt - realHeight.lt <= balancing &
        lt in Balanced &
        rt in Balanced)) &
    (for xs being FinSequence of T1,
         z being Integer
     holds
       mseq.[xs,z] = xs &
       mhgt.[xs,z] = z) &
    (for a being Element of T2 holds
       repr.a in Balanced &
       mseq.(m1.a) = seqModel.(repr.a) &
       mhgt.(m1.a) = realHeight.(repr.a)) &
    (for a,b being Element of T2 st
       repr.a = repr.b & m1.a = m1.b
     holds
       a = b) &
    -(balancing) - 1 <= mhgt.(m1.l) - mhgt.(m1.r) &
    mhgt.(m1.l) - mhgt.(m1.r) <= balancing + 1 &
    hl = mhgt.(m1.l) &
    hr = mhgt.(m1.r) &
    o1 = -(hr)
  holds
    o1 <= hl - hr &
    hl - hr <= hl &
    for df being Integer st df = hl - hr holds
      ((balancing < df implies
          not (mhgt.(m1.l) = 0 & mseq.(m1.l) = <*>T1) &
          (for ll,lr being Element of T2,
               ld being Element of T1,
               lh being Nat,
               ls being Element of U st
             mseq.(m1.l) = (mseq.(m1.ll)) ^ (<*ld*> ^ (mseq.(m1.lr))) &
             ls = agg.[measureC,mseq.(m1.l)] &
             -(balancing) <= mhgt.(m1.ll) - mhgt.(m1.lr) &
             mhgt.(m1.ll) - mhgt.(m1.lr) <= balancing &
             mhgt.(m1.l) = lh &
             lh = 1 + max(mhgt.(m1.ll),mhgt.(m1.lr))
           holds
             for o3 being Integer st o3 = mhgt.(m1.lr) holds
               for o4 being Integer st o4 = mhgt.(m1.ll) holds
                 ((o3 <= o4 implies
                     -(balancing) <= mhgt.(m1.lr) - mhgt.(m1.r) &
                     mhgt.(m1.lr) - mhgt.(m1.r) <= balancing &
                     (for o5 being Element of T2 st
                        mseq.(m1.o5) =
                          (mseq.(m1.lr)) ^ (<*d*> ^ (mseq.(m1.r))) &
                        mhgt.(m1.o5) = 1 + max(mhgt.(m1.lr),mhgt.(m1.r))
                      holds
                        -(balancing) <= mhgt.(m1.ll) - mhgt.(m1.o5) &
                        mhgt.(m1.ll) - mhgt.(m1.o5) <= balancing)) &
                  (not o3 <= o4 implies
                     not (mhgt.(m1.lr) = 0 & mseq.(m1.lr) = <*>T1) &
                     (for lrl,lrr being Element of T2,
                          lrd being Element of T1,
                          lrh being Nat,
                          lrs being Element of U st
                        mseq.(m1.lr) =
                          (mseq.(m1.lrl)) ^ (<*lrd*> ^ (mseq.(m1.lrr))) &
                        lrs = agg.[measureC,mseq.(m1.lr)] &
                        -(balancing) <= mhgt.(m1.lrl) - mhgt.(m1.lrr) &
                        mhgt.(m1.lrl) - mhgt.(m1.lrr) <= balancing &
                        mhgt.(m1.lr) = lrh &
                        lrh = 1 + max(mhgt.(m1.lrl),mhgt.(m1.lrr))
                      holds
                        -(balancing) <= mhgt.(m1.lrr) - mhgt.(m1.r) &
                        mhgt.(m1.lrr) - mhgt.(m1.r) <= balancing &
                        (for o6 being Element of T2 st
                           mseq.(m1.o6) =
                             (mseq.(m1.lrr)) ^ (<*d*> ^ (mseq.(m1.r))) &
                           mhgt.(m1.o6) = 1 + max(mhgt.(m1.lrr),mhgt.(m1.r))
                         holds
                           -(balancing) <= mhgt.(m1.ll) - mhgt.(m1.lrl) &
                           mhgt.(m1.ll) - mhgt.(m1.lrl) <= balancing &
                           (for o7 being Element of T2 st
                              mseq.(m1.o7) =
                                (mseq.(m1.ll)) ^ (<*ld*> ^ (mseq.(m1.lrl))) &
                              mhgt.(m1.o7) =
                                1 + max(mhgt.(m1.ll),mhgt.(m1.lrl))
                            holds
                              -(balancing) <= mhgt.(m1.o7) - mhgt.(m1.o6) &
                              mhgt.(m1.o7) - mhgt.(m1.o6) <= balancing))))))) &
       (not balancing < df implies
          for o2 being Integer st o2 = -(balancing) holds
            ((df < o2 implies
                not (mhgt.(m1.r) = 0 & mseq.(m1.r) = <*>T1) &
                (for rl,rr being Element of T2,
                     rd being Element of T1,
                     rh being Nat,
                     rs being Element of U st
                   mseq.(m1.r) = (mseq.(m1.rl)) ^ (<*rd*> ^ (mseq.(m1.rr))) &
                   rs = agg.[measureC,mseq.(m1.r)] &
                   -(balancing) <= mhgt.(m1.rl) - mhgt.(m1.rr) &
                   mhgt.(m1.rl) - mhgt.(m1.rr) <= balancing &
                   mhgt.(m1.r) = rh &
                   rh = 1 + max(mhgt.(m1.rl),mhgt.(m1.rr))
                 holds
                   for o4 being Integer st o4 = mhgt.(m1.rl) holds
                     for o5 being Integer st o5 = mhgt.(m1.rr) holds
                       ((o4 <= o5 implies
                           -(balancing) <= mhgt.(m1.l) - mhgt.(m1.rl) &
                           mhgt.(m1.l) - mhgt.(m1.rl) <= balancing &
                           (for o6 being Element of T2 st
                              mseq.(m1.o6) =
                                (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.rl))) &
                              mhgt.(m1.o6) =
                                1 + max(mhgt.(m1.l),mhgt.(m1.rl))
                            holds
                              -(balancing) <= mhgt.(m1.o6) - mhgt.(m1.rr) &
                              mhgt.(m1.o6) - mhgt.(m1.rr) <= balancing)) &
                        (not o4 <= o5 implies
                           not (mhgt.(m1.rl) = 0 & mseq.(m1.rl) = <*>T1) &
                           (for rll,rlr being Element of T2,
                                rld being Element of T1,
                                rlh being Nat,
                                rls being Element of U st
                              mseq.(m1.rl) =
                                (mseq.(m1.rll)) ^ (<*rld*> ^ (mseq.(m1.rlr))) &
                              rls = agg.[measureC,mseq.(m1.rl)] &
                              -(balancing) <= mhgt.(m1.rll) - mhgt.(m1.rlr) &
                              mhgt.(m1.rll) - mhgt.(m1.rlr) <= balancing &
                              mhgt.(m1.rl) = rlh &
                              rlh = 1 + max(mhgt.(m1.rll),mhgt.(m1.rlr))
                            holds
                              -(balancing) <= mhgt.(m1.rlr) - mhgt.(m1.rr) &
                              mhgt.(m1.rlr) - mhgt.(m1.rr) <= balancing &
                              (for o7 being Element of T2 st
                                 mseq.(m1.o7) =
                                   (mseq.(m1.rlr)) ^
                                     (<*rd*> ^ (mseq.(m1.rr))) &
                                 mhgt.(m1.o7) =
                                   1 + max(mhgt.(m1.rlr),mhgt.(m1.rr))
                               holds
                                 -(balancing) <= mhgt.(m1.l) - mhgt.(m1.rll) &
                                 mhgt.(m1.l) - mhgt.(m1.rll) <= balancing &
                                 (for o8 being Element of T2 st
                                    mseq.(m1.o8) =
                                      (mseq.(m1.l)) ^
                                        (<*d*> ^ (mseq.(m1.rll))) &
                                    mhgt.(m1.o8) =
                                      1 + max(mhgt.(m1.l),mhgt.(m1.rll))
                                  holds
                                    -(balancing) <=
                                      mhgt.(m1.o8) - mhgt.(m1.o7) &
                                    mhgt.(m1.o8) - mhgt.(m1.o7) <=
                                      balancing))))))) &
             (not df < o2 implies
                -(balancing) <= mhgt.(m1.l) - mhgt.(m1.r) &
                mhgt.(m1.l) - mhgt.(m1.r) <= balancing))) &
       (for result being Element of T2 holds
          (((balancing < df &
             ex ll,lr being Element of T2,
                ld being Element of T1,
                lh being Nat,
                ls being Element of U st
               mseq.(m1.l) = (mseq.(m1.ll)) ^ (<*ld*> ^ (mseq.(m1.lr))) &
               ls = agg.[measureC,mseq.(m1.l)] &
               -(balancing) <= mhgt.(m1.ll) - mhgt.(m1.lr) &
               mhgt.(m1.ll) - mhgt.(m1.lr) <= balancing &
               mhgt.(m1.l) = lh &
               lh = 1 + max(mhgt.(m1.ll),mhgt.(m1.lr)) &
               ex o3,o4 being Integer st
                 o3 = mhgt.(m1.lr) &
                 o4 = mhgt.(m1.ll) &
                 ((o3 <= o4 &
                    ex o5 being Element of T2 st
                      mseq.(m1.o5) =
                        (mseq.(m1.lr)) ^ (<*d*> ^ (mseq.(m1.r))) &
                      mhgt.(m1.o5) = 1 + max(mhgt.(m1.lr),mhgt.(m1.r)) &
                      mseq.(m1.result) =
                        (mseq.(m1.ll)) ^ (<*ld*> ^ (mseq.(m1.o5))) &
                      mhgt.(m1.result) =
                        1 + max(mhgt.(m1.ll),mhgt.(m1.o5))) or
                  (not o3 <= o4 &
                    ex lrl,lrr being Element of T2,
                       lrd being Element of T1,
                       lrh being Nat,
                       lrs being Element of U st
                      mseq.(m1.lr) =
                        (mseq.(m1.lrl)) ^ (<*lrd*> ^ (mseq.(m1.lrr))) &
                      lrs = agg.[measureC,mseq.(m1.lr)] &
                      -(balancing) <= mhgt.(m1.lrl) - mhgt.(m1.lrr) &
                      mhgt.(m1.lrl) - mhgt.(m1.lrr) <= balancing &
                      mhgt.(m1.lr) = lrh &
                      lrh = 1 + max(mhgt.(m1.lrl),mhgt.(m1.lrr)) &
                      ex o6,o7 being Element of T2 st
                        mseq.(m1.o6) =
                          (mseq.(m1.lrr)) ^ (<*d*> ^ (mseq.(m1.r))) &
                        mhgt.(m1.o6) =
                          1 + max(mhgt.(m1.lrr),mhgt.(m1.r)) &
                        mseq.(m1.o7) =
                          (mseq.(m1.ll)) ^ (<*ld*> ^ (mseq.(m1.lrl))) &
                        mhgt.(m1.o7) =
                          1 + max(mhgt.(m1.ll),mhgt.(m1.lrl)) &
                        mseq.(m1.result) =
                          (mseq.(m1.o7)) ^ (<*lrd*> ^ (mseq.(m1.o6))) &
                        mhgt.(m1.result) =
                          1 + max(mhgt.(m1.o7),mhgt.(m1.o6)))))) or
           (not balancing < df &
             ex o2 being Integer st
               o2 = -(balancing) &
               ((df < o2 &
                  ex rl,rr being Element of T2,
                     rd being Element of T1,
                     rh being Nat,
                     rs being Element of U st
                    mseq.(m1.r) =
                      (mseq.(m1.rl)) ^ (<*rd*> ^ (mseq.(m1.rr))) &
                    rs = agg.[measureC,mseq.(m1.r)] &
                    -(balancing) <= mhgt.(m1.rl) - mhgt.(m1.rr) &
                    mhgt.(m1.rl) - mhgt.(m1.rr) <= balancing &
                    mhgt.(m1.r) = rh &
                    rh = 1 + max(mhgt.(m1.rl),mhgt.(m1.rr)) &
                    ex o4,o5 being Integer st
                      o4 = mhgt.(m1.rl) &
                      o5 = mhgt.(m1.rr) &
                      ((o4 <= o5 &
                         ex o6 being Element of T2 st
                           mseq.(m1.o6) =
                             (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.rl))) &
                           mhgt.(m1.o6) =
                             1 + max(mhgt.(m1.l),mhgt.(m1.rl)) &
                           mseq.(m1.result) =
                             (mseq.(m1.o6)) ^ (<*rd*> ^ (mseq.(m1.rr))) &
                           mhgt.(m1.result) =
                             1 + max(mhgt.(m1.o6),mhgt.(m1.rr))) or
                       (not o4 <= o5 &
                         ex rll,rlr being Element of T2,
                            rld being Element of T1,
                            rlh being Nat,
                            rls being Element of U st
                           mseq.(m1.rl) =
                             (mseq.(m1.rll)) ^ (<*rld*> ^ (mseq.(m1.rlr))) &
                           rls = agg.[measureC,mseq.(m1.rl)] &
                           -(balancing) <= mhgt.(m1.rll) - mhgt.(m1.rlr) &
                           mhgt.(m1.rll) - mhgt.(m1.rlr) <= balancing &
                           mhgt.(m1.rl) = rlh &
                           rlh = 1 + max(mhgt.(m1.rll),mhgt.(m1.rlr)) &
                           ex o7,o8 being Element of T2 st
                             mseq.(m1.o7) =
                               (mseq.(m1.rlr)) ^ (<*rd*> ^ (mseq.(m1.rr))) &
                             mhgt.(m1.o7) =
                               1 + max(mhgt.(m1.rlr),mhgt.(m1.rr)) &
                             mseq.(m1.o8) =
                               (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.rll))) &
                             mhgt.(m1.o8) =
                               1 + max(mhgt.(m1.l),mhgt.(m1.rll)) &
                             mseq.(m1.result) =
                               (mseq.(m1.o8)) ^ (<*rld*> ^ (mseq.(m1.o7))) &
                             mhgt.(m1.result) =
                               1 + max(mhgt.(m1.o8),mhgt.(m1.o7))))) or
                (not df < o2 &
                   mseq.(m1.result) =
                     (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.r))) &
                   mhgt.(m1.result) =
                     1 + max(mhgt.(m1.l),mhgt.(m1.r))))))
        implies
          mseq.(m1.result) = (mseq.(m1.l)) ^ (<*d*> ^ (mseq.(m1.r))) &
          0 <= 1 + max(mhgt.(m1.l),mhgt.(m1.r)) - mhgt.(m1.result) &
          1 + max(mhgt.(m1.l),mhgt.(m1.r)) - mhgt.(m1.result) <= 1 &
          (-(balancing) <= mhgt.(m1.l) - mhgt.(m1.r) &
           mhgt.(m1.l) - mhgt.(m1.r) <= balancing implies
             1 + max(mhgt.(m1.l),mhgt.(m1.r)) = mhgt.(m1.result))))
proof
end;
::$P+
