:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2015_dancing_links_DancingLinks_removeqtvc: the removal
:: verification condition updates the predecessor and successor arrays of a
:: circular doubly linked list, leaving the removed node ready for reinsertion
:: and the remaining sequence represented as a circular list. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for DLL,IntArray being non empty set,
      prevField,nextField being Function of DLL,IntArray,
      nodeCount being Function of DLL,INT,
      arrayLength being Function of IntArray,INT,
      arrayGet being Function of [:IntArray,INT:],INT,
      arraySet being Function of
        [:IntArray,[:INT,INT:]:],IntArray,
      seqGet being Function of [:INT*,INT:],INT,
      ValidIn,ValidOut being Subset of [:DLL,INT:],
      IsList being Subset of [:DLL,INT*:],
      l being Element of DLL,
      i being Integer,
      s being FinSequence of INT
  st
    (for a being Element of IntArray holds
       0 <= arrayLength.a) &
    (for a,b being Element of IntArray st
       arrayLength.a = arrayLength.b &
       (for q being Integer holds
          arrayGet.[a,q] = arrayGet.[b,q])
     holds a = b) &
    (for a being Element of IntArray,
         j,x being Integer
     holds
       arrayLength.(arraySet.[a,[j,x]]) = arrayLength.a &
       (for q being Integer holds
          (q = j implies
             arrayGet.[arraySet.[a,[j,x]],q] = x) &
          (q <> j implies
             arrayGet.[arraySet.[a,[j,x]],q] =
               arrayGet.[a,q]))) &
    (for t being FinSequence of INT, k being Integer holds
       (len t = 0 implies seqGet.[t,k] = 0) &
       (len t > 0 & k < 0 implies seqGet.[t,k] = t.1) &
       (0 <= k & k < len t implies
          seqGet.[t,k] = t.(k+1)) &
       (len t <= k implies seqGet.[t,k] = 0)) &
    (for self being Element of DLL holds
       arrayLength.(prevField.self) =
         arrayLength.(nextField.self) &
       arrayLength.(nextField.self) = nodeCount.self) &
    (for a,b being Element of DLL st
       prevField.a = prevField.b &
       nextField.a = nextField.b &
       nodeCount.a = nodeCount.b
     holds a = b) &
    (for self being Element of DLL, j being Integer holds
       ([self,j] in ValidIn iff
         for p,nx being Integer st
           p = arrayGet.[prevField.self,j] &
           nx = arrayGet.[nextField.self,j]
         holds
           0 <= j & j < nodeCount.self &
           0 <= p & p < nodeCount.self &
           0 <= nx & nx < nodeCount.self &
           arrayGet.[nextField.self,p] = j &
           arrayGet.[prevField.self,nx] = j)) &
    (for self being Element of DLL, j being Integer holds
       ([self,j] in ValidOut iff
         for p,nx being Integer st
           p = arrayGet.[prevField.self,j] &
           nx = arrayGet.[nextField.self,j]
         holds
           0 <= j & j < nodeCount.self &
           0 <= p & p < nodeCount.self &
           0 <= nx & nx < nodeCount.self &
           arrayGet.[nextField.self,p] = nx &
           arrayGet.[prevField.self,nx] = p)) &
    (for self being Element of DLL,
         t being FinSequence of INT
     holds
       ([self,t] in IsList iff
         for k being Integer st 0 <= k & k < len t
         holds
           for x being Integer st x = seqGet.[t,k]
           holds
             0 <= x & x < nodeCount.self &
             (k = 0 implies
                arrayGet.[prevField.self,x] =
                  seqGet.[t,len t-1]) &
             (k <> 0 implies
                arrayGet.[prevField.self,x] =
                  seqGet.[t,k-1]) &
             (k = len t-1 implies
                arrayGet.[nextField.self,x] =
                  seqGet.[t,0]) &
             (k <> len t-1 implies
                arrayGet.[nextField.self,x] =
                  seqGet.[t,k+1]) &
             (for k1 being Integer st
                0 <= k1 & k1 < len t & k <> k1
              holds seqGet.[t,k] <> seqGet.[t,k1]))) &
    [l,i] in ValidIn &
    [l,<*i*> ^ s] in IsList
  holds
    for o1 being Element of IntArray st
      o1 = prevField.l
    holds
      (0 <= i & i < arrayLength.o1) &
      (for o2 being Integer st o2 = arrayGet.[o1,i] holds
       for o3 being Element of IntArray st
         o3 = nextField.l
       holds
         (0 <= i & i < arrayLength.o3) &
         (for o4 being Integer st o4 = arrayGet.[o3,i] holds
          for o5 being Element of IntArray st
            o5 = prevField.l
          holds
            (0 <= o4 & o4 < arrayLength.o5) &
            (for o5v being Element of IntArray st
               o5v = arraySet.[o5,[o4,o2]]
             holds
               (arrayLength.o5v = arrayLength.o5 &
                arrayLength.o5v =
                  arrayLength.(prevField.l) &
                (for q being Integer holds
                   (q = o4 implies
                      arrayGet.[o5v,q] = o2) &
                   (q <> o4 implies
                      arrayGet.[o5v,q] = arrayGet.[o5,q])))
               implies
                 (0 <= i &
                  i < arrayLength.(nextField.l)) &
                 (for o6 being Integer st
                    o6 = arrayGet.[nextField.l,i]
                  holds
                    (0 <= i & i < arrayLength.o5v) &
                    (for o7 being Integer st
                       o7 = arrayGet.[o5v,i]
                     holds
                       (0 <= o7 &
                        o7 < arrayLength.(nextField.l)) &
                       (for l1 being Element of DLL holds
                          for nextv being Element of IntArray st
                            nextv =
                              arraySet.[nextField.l,[o7,o6]]
                          holds
                            (arrayLength.nextv =
                               arrayLength.(nextField.l) &
                             arrayLength.nextv =
                               arrayLength.(nextField.l) &
                             (for q being Integer holds
                                (q = o7 implies
                                   arrayGet.[nextv,q] = o6) &
                                (q <> o7 implies
                                   arrayGet.[nextv,q] =
                                     arrayGet.[nextField.l,q])))
                            implies
                              (arrayLength.o5v =
                                 arrayLength.nextv &
                               arrayLength.nextv = nodeCount.l) &
                              ((nodeCount.l = nodeCount.l1 &
                                nextv = nextField.l1 &
                                o5v = prevField.l1)
                               implies
                                 [l1,i] in ValidOut &
                                 [l1,s] in IsList)))))))
proof
end;
::$P+
