:: Statement-only formalization of NTP4VC corpus artifact
:: pearl/verifythis_2024_challenge1_Top_smart_array_copy_1qtvc: the
:: verification condition for copying a total integer-indexed array through
:: permuted fixed-size subsegments and then copying the final remainder. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4, XCMPLX_0,
    XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    CARD_1, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for E being non empty set,
      src,dst being Element of [:NAT,Funcs(INT,E):],
      srcMap,dstMap being Function of INT,E,
      srcLen,dstLen being Nat,
      k,l,q,r being Integer st
    src = [srcLen,srcMap] &
    dst = [dstLen,dstMap] &
    srcLen = dstLen &
    0 < dstLen &
    0 < k &
    0 < l &
    0 <= q &
    0 <= r &
    r < k*l &
    dstLen = q*k*l + r
  holds
    ex arrLen being Function of
         ([:NAT,Funcs(INT,E):] \/ [:NAT,Funcs(INT,INT):]),NAT,
       nthE being Function of
         [:[:NAT,Funcs(INT,E):],INT:],E,
       nthZ being Function of
         [:[:NAT,Funcs(INT,INT):],INT:],INT,
       updateE being Function of
         [:[:[:NAT,Funcs(INT,E):],INT:],E:],
         [:NAT,Funcs(INT,E):],
       updateZ being Function of
         [:[:[:NAT,Funcs(INT,INT):],INT:],INT:],
         [:NAT,Funcs(INT,INT):],
       idMap being Function of INT,[:NAT,Funcs(INT,INT):],
       permutationRel being set,
       permutationPairRel being set,
       validChunkRel being set,
       copyToRel being set,
       copyPermRel being set,
       copySubsegmentRel being set,
       frameERel being set,
       frameZRel being set,
       innerStepRel being set,
       remainderStepRel being set,
       remainderVCRel being set,
       blockStepRel being set st
      (for a being Element of [:NAT,Funcs(INT,E):] holds
        ex n being Nat, f being Function of INT,E st
          a = [n,f] &
          arrLen/.a = n &
          (for i being Integer holds nthE/.[a,i] = f/.i)) &
      (for a being Element of [:NAT,Funcs(INT,INT):] holds
        ex n being Nat, f being Function of INT,INT st
          a = [n,f] &
          arrLen/.a = n &
          (for i being Integer holds nthZ/.[a,i] = f/.i)) &
      (for a being Element of [:NAT,Funcs(INT,E):],
           i,t being Integer,
           x being Element of E holds
        arrLen/.(updateE/.[[a,i],x]) = arrLen/.a &
        nthE/.[updateE/.[[a,i],x],i] = x &
        (t <> i implies
          nthE/.[updateE/.[[a,i],x],t] = nthE/.[a,t])) &
      (for a being Element of [:NAT,Funcs(INT,INT):],
           i,t,x being Integer holds
        arrLen/.(updateZ/.[[a,i],x]) = arrLen/.a &
        nthZ/.[updateZ/.[[a,i],x],i] = x &
        (t <> i implies
          nthZ/.[updateZ/.[[a,i],x],t] = nthZ/.[a,t])) &
      (for ll being Integer,
           p being Element of [:NAT,Funcs(INT,INT):] holds
        ([ll,p] in permutationRel iff
          0 <= ll &
          ll <= arrLen/.p &
          (for i being Integer st 0 <= i & i < ll holds
            0 <= nthZ/.[p,i] & nthZ/.[p,i] < ll) &
          (for i,j being Integer st
            0 <= i & i < ll &
            0 <= j & j < ll &
            i <> j
          holds
            nthZ/.[p,i] <> nthZ/.[p,j]))) &
      (for ll being Integer,
           p,invp being Element of [:NAT,Funcs(INT,INT):] holds
        ([p,[invp,ll]] in permutationPairRel iff
          [ll,p] in permutationRel &
          [ll,invp] in permutationRel &
          (for i being Integer st 0 <= i & i < ll holds
            nthZ/.[p,nthZ/.[invp,i]] = i) &
          (for i being Integer st 0 <= i & i < ll holds
            nthZ/.[invp,nthZ/.[p,i]] = i))) &
      (for ll being Integer st 0 < ll holds
        arrLen/.(idMap/.ll) = ll &
        (for i being Integer st 0 <= i & i < ll holds
          nthZ/.[idMap/.ll,i] = i) &
        [idMap/.ll,[idMap/.ll,ll]] in permutationPairRel) &
      (for a being Element of [:NAT,Funcs(INT,E):],
           ofs,len0 being Integer holds
        ([a,[ofs,len0]] in validChunkRel iff
          0 <= ofs &
          ofs <= ofs + len0 &
          ofs + len0 <= arrLen/.a)) &
      (for a,b being Element of [:NAT,Funcs(INT,E):],
           ofss,ofsd,len0 being Integer holds
        ([[a,b],[[ofss,ofsd],len0]] in copyToRel iff
          [a,[ofss,len0]] in validChunkRel &
          [b,[ofsd,len0]] in validChunkRel &
          arrLen/.a = arrLen/.b &
          (for i being Integer st 0 <= i & i < len0 holds
            nthE/.[b,ofsd+i] = nthE/.[a,ofss+i]) &
          (for i being Integer st
            ofsd <= i & i < ofsd + len0
          holds
            nthE/.[b,i] = nthE/.[a,i+(ofss-ofsd)]))) &
      (for a,b being Element of [:NAT,Funcs(INT,E):],
           size being Integer,
           p,invp being Element of [:NAT,Funcs(INT,INT):] holds
        ([[a,b],[size,[p,invp]]] in copyPermRel iff
          [a,[0,size]] in validChunkRel &
          arrLen/.a = arrLen/.b &
          [p,[invp,size]] in permutationPairRel &
          (for i being Integer st 0 <= i & i < size holds
            0 <= nthZ/.[p,i] & nthZ/.[p,i] < size) &
          (for i being Integer st 0 <= i & i < size holds
            0 <= nthZ/.[invp,i] & nthZ/.[invp,i] < size) &
          (for i being Integer st 0 <= i & i < size holds
            nthE/.[b,i] = nthE/.[a,nthZ/.[p,i]]) &
          (for i being Integer st 0 <= i & i < size holds
            nthE/.[a,i] = nthE/.[b,nthZ/.[invp,i]]))) &
      (for a,b being Element of [:NAT,Funcs(INT,E):],
           s,k0,l0,j being Integer,
           sigma,tau,p,invp being Element of [:NAT,Funcs(INT,INT):] holds
        ([[a,b],[[s,k0],[l0,[j,[sigma,[tau,[p,invp]]]]]]]
            in copySubsegmentRel iff
          [[a,b],
            [[s*(k0*l0)+nthZ/.[sigma,j]*k0,
              s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0],k0]]
            in copyToRel &
          (for i being Integer st 0 <= i & i < k0 holds
            nthZ/.[p,
              s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i] =
              s*(k0*l0)+nthZ/.[sigma,j]*k0+i) &
          (for i being Integer st 0 <= i & i < k0 holds
            nthZ/.[invp,
              s*(k0*l0)+nthZ/.[sigma,j]*k0+i] =
              s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i))) &
      (for a1,a2 being Element of [:NAT,Funcs(INT,E):],
           ofs,len0 being Integer holds
        ([[a1,a2],[ofs,len0]] in frameERel iff
          arrLen/.a2 = arrLen/.a1 &
          (for i being Integer st 0 <= i & i < ofs holds
            nthE/.[a2,i] = nthE/.[a1,i]) &
          (for i being Integer st
            ofs+len0 <= i & i < arrLen/.a2
          holds
            nthE/.[a2,i] = nthE/.[a1,i]))) &
      (for a1,a2 being Element of [:NAT,Funcs(INT,INT):],
           ofs,len0 being Integer holds
        ([[a1,a2],[ofs,len0]] in frameZRel iff
          arrLen/.a2 = arrLen/.a1 &
          (for i being Integer st 0 <= i & i < ofs holds
            nthZ/.[a2,i] = nthZ/.[a1,i]) &
          (for i being Integer st
            ofs+len0 <= i & i < arrLen/.a2
          holds
            nthZ/.[a2,i] = nthZ/.[a1,i]))) &
      (for a,d2,d3 being Element of [:NAT,Funcs(INT,E):],
           p2,ip2,p3,ip3,sigma,tau being Element of [:NAT,Funcs(INT,INT):],
           s,k0,l0,j,i being Integer holds
        ([[a,[d2,d3]],
          [p2,[ip2,[p3,[ip3,[sigma,[tau,[s,[k0,[l0,[j,i]]]]]]]]]]]
            in innerStepRel iff
          0 <= s*(k0*l0)+nthZ/.[sigma,j]*k0+i &
          s*(k0*l0)+nthZ/.[sigma,j]*k0+i < arrLen/.a &
          0 <= s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i &
          s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i < arrLen/.d3 &
          (arrLen/.(updateE/.
               [[d3,
                  s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                 nthE/.[a,s*(k0*l0)+nthZ/.[sigma,j]*k0+i]])
             = arrLen/.d3 implies
            ((nthE/.
                [updateE/.
                  [[d3,
                     s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                    nthE/.[a,s*(k0*l0)+nthZ/.[sigma,j]*k0+i]],
                 s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i]
                = nthE/.[a,s*(k0*l0)+nthZ/.[sigma,j]*k0+i] &
              (for t being Integer st
                t <> s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i
              holds
                nthE/.
                  [updateE/.
                    [[d3,
                       s*(k0*l0)+
                         nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                      nthE/.[a,s*(k0*l0)+nthZ/.[sigma,j]*k0+i]],
                   t] = nthE/.[d3,t]))
             implies
              0 <= s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i &
              s*(k0*l0)+nthZ/.[tau,nthZ/.[sigma,j]]*k0+i <
                arrLen/.p3 &
              (arrLen/.(updateZ/.
                   [[p3,
                      s*(k0*l0)+
                        nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                     s*(k0*l0)+nthZ/.[sigma,j]*k0+i])
                 = arrLen/.p3 implies
                ((nthZ/.
                    [updateZ/.
                      [[p3,
                         s*(k0*l0)+
                           nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                        s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                     s*(k0*l0)+
                       nthZ/.[tau,nthZ/.[sigma,j]]*k0+i]
                    = s*(k0*l0)+nthZ/.[sigma,j]*k0+i &
                  (for t being Integer st
                    t <>
                      s*(k0*l0)+
                        nthZ/.[tau,nthZ/.[sigma,j]]*k0+i
                  holds
                    nthZ/.
                      [updateZ/.
                        [[p3,
                           s*(k0*l0)+
                             nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                          s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                       t] = nthZ/.[p3,t]))
                 implies
                  0 <= s*(k0*l0)+nthZ/.[sigma,j]*k0+i &
                  s*(k0*l0)+nthZ/.[sigma,j]*k0+i < arrLen/.ip3 &
                  (arrLen/.(updateZ/.
                       [[ip3,
                          s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                         s*(k0*l0)+
                           nthZ/.[tau,nthZ/.[sigma,j]]*k0+i])
                     = arrLen/.ip3 implies
                    ((nthZ/.
                        [updateZ/.
                          [[ip3,
                             s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                            s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                         s*(k0*l0)+nthZ/.[sigma,j]*k0+i]
                        = s*(k0*l0)+
                            nthZ/.[tau,nthZ/.[sigma,j]]*k0+i &
                      (for t being Integer st
                        t <> s*(k0*l0)+nthZ/.[sigma,j]*k0+i
                      holds
                        nthZ/.
                          [updateZ/.
                            [[ip3,
                               s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                              s*(k0*l0)+
                                nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                           t] = nthZ/.[ip3,t]))
                     implies
                      [[d2,
                        updateE/.
                          [[d3,
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                            nthE/.
                              [a,
                               s*(k0*l0)+
                                 nthZ/.[sigma,j]*k0+i]]],
                       [s*(k0*l0)+
                          nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                        in frameERel &
                      [[p2,
                        updateZ/.
                          [[p3,
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                            s*(k0*l0)+nthZ/.[sigma,j]*k0+i]],
                       [s*(k0*l0)+
                          nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                        in frameZRel &
                      [[ip2,
                        updateZ/.
                          [[ip3,
                             s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                            s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0+i]],
                       [s*(k0*l0)+nthZ/.[sigma,j]*k0,k0]]
                        in frameZRel &
                      [updateZ/.
                         [[p3,
                            s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                           s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                       [updateZ/.
                          [[ip3,
                             s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                            s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                        s*(k0*l0)]]
                        in permutationPairRel &
                      [[a,
                        updateE/.
                          [[d3,
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                            nthE/.
                              [a,
                               s*(k0*l0)+
                                 nthZ/.[sigma,j]*k0+i]]],
                       [s*(k0*l0),
                        [updateZ/.
                           [[p3,
                              s*(k0*l0)+
                                nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                             s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                         updateZ/.
                           [[ip3,
                              s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0+i]]]]
                        in copyPermRel &
                      [[a,
                        updateE/.
                          [[d3,
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                            nthE/.
                              [a,
                               s*(k0*l0)+
                                 nthZ/.[sigma,j]*k0+i]]],
                       [[s*(k0*l0)+nthZ/.[sigma,j]*k0,
                         s*(k0*l0)+
                           nthZ/.[tau,nthZ/.[sigma,j]]*k0],
                        i+1]]
                        in copyToRel &
                      (for ip being Integer st 0 <= ip & ip < i+1 holds
                        nthZ/.
                          [updateZ/.
                            [[p3,
                               s*(k0*l0)+
                                 nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                              s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                           s*(k0*l0)+
                             nthZ/.[tau,nthZ/.[sigma,j]]*k0+ip]
                          = s*(k0*l0)+nthZ/.[sigma,j]*k0+ip) &
                      (for ip being Integer st 0 <= ip & ip < i+1 holds
                        nthZ/.
                          [updateZ/.
                            [[ip3,
                               s*(k0*l0)+nthZ/.[sigma,j]*k0+i],
                              s*(k0*l0)+
                                nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                           s*(k0*l0)+nthZ/.[sigma,j]*k0+ip]
                          = s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0+ip) &
                      (for jp being Integer st 0 <= jp & jp < j holds
                        [[a,
                          updateE/.
                            [[d3,
                               s*(k0*l0)+
                                 nthZ/.[tau,nthZ/.[sigma,j]]*k0+i],
                              nthE/.
                                [a,
                                 s*(k0*l0)+
                                   nthZ/.[sigma,j]*k0+i]]],
                         [[s,k0],
                          [l0,
                           [jp,
                            [sigma,
                             [tau,
                              [updateZ/.
                                 [[p3,
                                    s*(k0*l0)+
                                      nthZ/.
                                        [tau,nthZ/.[sigma,j]]*k0+i],
                                   s*(k0*l0)+
                                     nthZ/.[sigma,j]*k0+i],
                               updateZ/.
                                 [[ip3,
                                    s*(k0*l0)+
                                      nthZ/.[sigma,j]*k0+i],
                                   s*(k0*l0)+
                                     nthZ/.
                                       [tau,nthZ/.[sigma,j]]*k0+i]]]]]]]]
                          in copySubsegmentRel))))))))) &
      (for a,d2 being Element of [:NAT,Funcs(INT,E):],
           p2,ip2 being Element of [:NAT,Funcs(INT,INT):],
           last,i being Integer holds
        ([[a,d2],[p2,[ip2,[last,i]]]] in remainderStepRel iff
          0 <= last+i & last+i < arrLen/.a &
          0 <= last+i & last+i < arrLen/.d2 &
          (arrLen/.(updateE/.[[d2,last+i],nthE/.[a,last+i]])
              = arrLen/.d2 implies
            ((nthE/.
                [updateE/.[[d2,last+i],nthE/.[a,last+i]],last+i]
                = nthE/.[a,last+i] &
              (for t being Integer st t <> last+i holds
                nthE/.
                  [updateE/.[[d2,last+i],nthE/.[a,last+i]],t]
                  = nthE/.[d2,t]))
             implies
              0 <= last+i & last+i < arrLen/.p2 &
              (arrLen/.(updateZ/.[[p2,last+i],last+i]) = arrLen/.p2 implies
                ((nthZ/.[updateZ/.[[p2,last+i],last+i],last+i]
                    = last+i &
                  (for t being Integer st t <> last+i holds
                    nthZ/.[updateZ/.[[p2,last+i],last+i],t]
                      = nthZ/.[p2,t]))
                 implies
                  0 <= last+i & last+i < arrLen/.ip2 &
                  (arrLen/.(updateZ/.[[ip2,last+i],last+i]) = arrLen/.ip2
                   implies
                    ((nthZ/.[updateZ/.[[ip2,last+i],last+i],last+i]
                        = last+i &
                      (for t being Integer st t <> last+i holds
                        nthZ/.[updateZ/.[[ip2,last+i],last+i],t]
                          = nthZ/.[ip2,t]))
                     implies
                      [updateZ/.[[p2,last+i],last+i],
                       [updateZ/.[[ip2,last+i],last+i],
                        last+(i+1)]]
                        in permutationPairRel &
                      [[a,
                        updateE/.[[d2,last+i],nthE/.[a,last+i]]],
                       [last+(i+1),
                        [updateZ/.[[p2,last+i],last+i],
                         updateZ/.[[ip2,last+i],last+i]]]]
                        in copyPermRel)))))))) &
      (for a,d0 being Element of [:NAT,Funcs(INT,E):],
           p0,ip0 being Element of [:NAT,Funcs(INT,INT):],
           k0,l0,q0,r0 being Integer holds
        ([[a,d0],[p0,[ip0,[k0,[l0,[q0,r0]]]]]] in remainderVCRel iff
          ((0 <= (r0-1)+1 implies
              [p0,[ip0,q0*(k0*l0)+0]] in permutationPairRel &
              [[a,d0],
               [q0*(k0*l0)+0,[p0,ip0]]] in copyPermRel &
              (for ip1,p1 being Element of [:NAT,Funcs(INT,INT):],
                   d1 being Element of [:NAT,Funcs(INT,E):] st
                arrLen/.ip1 = arrLen/.ip0 &
                arrLen/.p1 = arrLen/.p0 &
                arrLen/.d1 = arrLen/.d0
              holds
                (for i being Integer st
                  (0 <= i & i <= r0-1) &
                  [p1,[ip1,q0*(k0*l0)+i]] in permutationPairRel &
                  [[a,d1],
                   [q0*(k0*l0)+i,[p1,ip1]]] in copyPermRel
                holds
                  [[a,d1],
                   [p1,[ip1,[q0*(k0*l0),i]]]]
                    in remainderStepRel) &
                (([p1,[ip1,q0*(k0*l0)+((r0-1)+1)]]
                    in permutationPairRel &
                  [[a,d1],
                   [q0*(k0*l0)+((r0-1)+1),[p1,ip1]]]
                    in copyPermRel)
                 implies
                  [[a,d1],[arrLen/.dst,[p1,ip1]]] in copyPermRel))) &
           ((r0-1)+1 < 0 implies
              [[a,d0],[arrLen/.dst,[p0,ip0]]] in copyPermRel)))) &
      (for a,d1 being Element of [:NAT,Funcs(INT,E):],
           p1,ip1,sigma,tau being Element of [:NAT,Funcs(INT,INT):],
           s,k0,l0 being Integer holds
        ([[a,d1],
          [p1,[ip1,[sigma,[tau,[s,[k0,l0]]]]]]]
            in blockStepRel iff
          ((0 <= (l0-1)+1 implies
              [p1,[ip1,s*(k0*l0)]] in permutationPairRel &
              [[a,d1],[s*(k0*l0),[p1,ip1]]] in copyPermRel &
              (for jp being Integer st 0 <= jp & jp < 0 holds
                [[a,d1],
                 [[s,k0],[l0,[jp,[sigma,[tau,[p1,ip1]]]]]]]
                  in copySubsegmentRel) &
              (for ip2,p2 being Element of [:NAT,Funcs(INT,INT):],
                   d2 being Element of [:NAT,Funcs(INT,E):] st
                arrLen/.ip2 = arrLen/.ip1 &
                arrLen/.p2 = arrLen/.p1 &
                arrLen/.d2 = arrLen/.d1
              holds
                (for j being Integer st
                  (0 <= j & j <= l0-1) &
                  [p2,[ip2,s*(k0*l0)]] in permutationPairRel &
                  [[a,d2],[s*(k0*l0),[p2,ip2]]] in copyPermRel &
                  (for jp being Integer st 0 <= jp & jp < j holds
                    [[a,d2],
                     [[s,k0],[l0,[jp,[sigma,[tau,[p2,ip2]]]]]]]
                      in copySubsegmentRel)
                holds
                  (0 <= j & j < arrLen/.sigma) &
                  (0 <= j & j < arrLen/.sigma) &
                  0 <= nthZ/.[sigma,j] &
                  nthZ/.[sigma,j] < arrLen/.tau &
                  ((0 <= (k0-1)+1 implies
                      [[d2,d2],
                       [s*(k0*l0)+
                          nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                        in frameERel &
                      [[p2,p2],
                       [s*(k0*l0)+
                          nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                        in frameZRel &
                      [[ip2,ip2],
                       [s*(k0*l0)+nthZ/.[sigma,j]*k0,k0]]
                        in frameZRel &
                      [p2,[ip2,s*(k0*l0)]] in permutationPairRel &
                      [[a,d2],[s*(k0*l0),[p2,ip2]]] in copyPermRel &
                      [[a,d2],
                       [[s*(k0*l0)+nthZ/.[sigma,j]*k0,
                         s*(k0*l0)+
                           nthZ/.[tau,nthZ/.[sigma,j]]*k0],0]]
                        in copyToRel &
                      (for i0 being Integer st 0 <= i0 & i0 < 0 holds
                        nthZ/.
                          [p2,
                           s*(k0*l0)+
                             nthZ/.[tau,nthZ/.[sigma,j]]*k0+i0]
                          = s*(k0*l0)+nthZ/.[sigma,j]*k0+i0) &
                      (for i0 being Integer st 0 <= i0 & i0 < 0 holds
                        nthZ/.
                          [ip2,s*(k0*l0)+nthZ/.[sigma,j]*k0+i0]
                          = s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0+i0) &
                      (for jp being Integer st 0 <= jp & jp < j holds
                        [[a,d2],
                         [[s,k0],
                          [l0,[jp,[sigma,[tau,[p2,ip2]]]]]]]
                          in copySubsegmentRel) &
                      (for ip3,p3 being Element of [:NAT,Funcs(INT,INT):],
                           d3 being Element of [:NAT,Funcs(INT,E):] st
                        arrLen/.ip3 = arrLen/.ip2 &
                        arrLen/.p3 = arrLen/.p2 &
                        arrLen/.d3 = arrLen/.d2
                      holds
                        (for i being Integer st
                          (0 <= i & i <= k0-1) &
                          [[d2,d3],
                           [s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                            in frameERel &
                          [[p2,p3],
                           [s*(k0*l0)+
                              nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                            in frameZRel &
                          [[ip2,ip3],
                           [s*(k0*l0)+nthZ/.[sigma,j]*k0,k0]]
                            in frameZRel &
                          [p3,[ip3,s*(k0*l0)]] in permutationPairRel &
                          [[a,d3],[s*(k0*l0),[p3,ip3]]] in copyPermRel &
                          [[a,d3],
                           [[s*(k0*l0)+nthZ/.[sigma,j]*k0,
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0],i]]
                            in copyToRel &
                          (for i0 being Integer st 0 <= i0 & i0 < i holds
                            nthZ/.
                              [p3,
                               s*(k0*l0)+
                                 nthZ/.[tau,nthZ/.[sigma,j]]*k0+i0]
                              = s*(k0*l0)+nthZ/.[sigma,j]*k0+i0) &
                          (for i0 being Integer st 0 <= i0 & i0 < i holds
                            nthZ/.
                              [ip3,
                               s*(k0*l0)+nthZ/.[sigma,j]*k0+i0]
                              = s*(k0*l0)+
                                  nthZ/.[tau,nthZ/.[sigma,j]]*k0+i0) &
                          (for jp being Integer st 0 <= jp & jp < j holds
                            [[a,d3],
                             [[s,k0],
                              [l0,[jp,[sigma,[tau,[p3,ip3]]]]]]]
                              in copySubsegmentRel)
                        holds
                          [[a,[d2,d3]],
                           [p2,
                            [ip2,
                             [p3,
                              [ip3,
                               [sigma,
                                [tau,[s,[k0,[l0,[j,i]]]]]]]]]]]
                            in innerStepRel) &
                      (([[d2,d3],
                         [s*(k0*l0)+
                            nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                          in frameERel &
                        [[p2,p3],
                         [s*(k0*l0)+
                            nthZ/.[tau,nthZ/.[sigma,j]]*k0,k0]]
                          in frameZRel &
                        [[ip2,ip3],
                         [s*(k0*l0)+nthZ/.[sigma,j]*k0,k0]]
                          in frameZRel &
                        [p3,[ip3,s*(k0*l0)]] in permutationPairRel &
                        [[a,d3],[s*(k0*l0),[p3,ip3]]] in copyPermRel &
                        [[a,d3],
                         [[s*(k0*l0)+nthZ/.[sigma,j]*k0,
                           s*(k0*l0)+
                             nthZ/.[tau,nthZ/.[sigma,j]]*k0],
                          (k0-1)+1]]
                          in copyToRel &
                        (for i0 being Integer st
                          0 <= i0 & i0 < (k0-1)+1
                        holds
                          nthZ/.
                            [p3,
                             s*(k0*l0)+
                               nthZ/.[tau,nthZ/.[sigma,j]]*k0+i0]
                            = s*(k0*l0)+nthZ/.[sigma,j]*k0+i0) &
                        (for i0 being Integer st
                          0 <= i0 & i0 < (k0-1)+1
                        holds
                          nthZ/.
                            [ip3,s*(k0*l0)+nthZ/.[sigma,j]*k0+i0]
                            = s*(k0*l0)+
                                nthZ/.[tau,nthZ/.[sigma,j]]*k0+i0) &
                        (for jp being Integer st 0 <= jp & jp < j holds
                          [[a,d3],
                           [[s,k0],
                            [l0,[jp,[sigma,[tau,[p3,ip3]]]]]]]
                            in copySubsegmentRel))
                       implies
                        [p3,[ip3,s*(k0*l0)]] in permutationPairRel &
                        [[a,d3],[s*(k0*l0),[p3,ip3]]] in copyPermRel &
                        (for jp being Integer st
                          0 <= jp & jp < j+1
                        holds
                          [[a,d3],
                           [[s,k0],
                            [l0,[jp,[sigma,[tau,[p3,ip3]]]]]]]
                            in copySubsegmentRel))) &
                  ((k0-1)+1 < 0 implies
                    [p2,[ip2,s*(k0*l0)]] in permutationPairRel &
                    [[a,d2],[s*(k0*l0),[p2,ip2]]] in copyPermRel &
                    (for jp being Integer st 0 <= jp & jp < j+1 holds
                      [[a,d2],
                       [[s,k0],[l0,[jp,[sigma,[tau,[p2,ip2]]]]]]]
                        in copySubsegmentRel))) &
                (([p2,[ip2,s*(k0*l0)]] in permutationPairRel &
                  [[a,d2],[s*(k0*l0),[p2,ip2]]] in copyPermRel &
                  (for jp being Integer st
                    0 <= jp & jp < (l0-1)+1
                  holds
                    [[a,d2],
                     [[s,k0],[l0,[jp,[sigma,[tau,[p2,ip2]]]]]]]
                      in copySubsegmentRel))
                 implies
                  [p2,[ip2,(s+1)*(k0*l0)]] in permutationPairRel &
                  [[a,d2],[(s+1)*(k0*l0),[p2,ip2]]] in copyPermRel))) &
           ((l0-1)+1 < 0 implies
              [p1,[ip1,(s+1)*(k0*l0)]] in permutationPairRel &
              [[a,d1],[(s+1)*(k0*l0),[p1,ip1]]] in copyPermRel)))))) &
      0 < arrLen/.dst &
      ((arrLen/.(idMap/.(arrLen/.dst)) = arrLen/.dst &
        (for i being Integer st 0 <= i & i < arrLen/.dst holds
          nthZ/.[idMap/.(arrLen/.dst),i] = i) &
        [idMap/.(arrLen/.dst),
         [idMap/.(arrLen/.dst),arrLen/.dst]] in permutationPairRel)
       implies
        0 < arrLen/.dst &
        ((arrLen/.(idMap/.(arrLen/.dst)) = arrLen/.dst &
          (for i being Integer st 0 <= i & i < arrLen/.dst holds
            nthZ/.[idMap/.(arrLen/.dst),i] = i) &
          [idMap/.(arrLen/.dst),
           [idMap/.(arrLen/.dst),arrLen/.dst]] in permutationPairRel)
         implies
          ((0 <= (q-1)+1 implies
              [idMap/.(arrLen/.dst),
               [idMap/.(arrLen/.dst),0*(k*l)]]
                in permutationPairRel &
              [[src,dst],
               [0*(k*l),
                [idMap/.(arrLen/.dst),idMap/.(arrLen/.dst)]]]
                in copyPermRel &
              (for ip1,p1 being Element of [:NAT,Funcs(INT,INT):],
                   d1 being Element of [:NAT,Funcs(INT,E):] st
                arrLen/.ip1 = arrLen/.(idMap/.(arrLen/.dst)) &
                arrLen/.p1 = arrLen/.(idMap/.(arrLen/.dst)) &
                arrLen/.d1 = arrLen/.dst
              holds
                (for s being Integer st
                  (0 <= s & s <= q-1) &
                  [p1,[ip1,s*(k*l)]] in permutationPairRel &
                  [[src,d1],[s*(k*l),[p1,ip1]]] in copyPermRel
                holds
                  0 < l &
                  (for sigma,invsigma being
                       Element of [:NAT,Funcs(INT,INT):] st
                    (arrLen/.sigma = arrLen/.invsigma & arrLen/.invsigma = l) &
                    [sigma,[invsigma,l]] in permutationPairRel
                  holds
                    0 < l &
                    (for tau,invtau being Element of [:NAT,Funcs(INT,INT):] st
                      (arrLen/.tau = arrLen/.invtau & arrLen/.invtau = l) &
                      [tau,[invtau,l]] in permutationPairRel
                    holds
                      [[src,d1],
                       [p1,[ip1,[sigma,[tau,[s,[k,l]]]]]]]
                        in blockStepRel)) &
                (([p1,[ip1,((q-1)+1)*(k*l)]]
                    in permutationPairRel &
                  [[src,d1],
                   [((q-1)+1)*(k*l),[p1,ip1]]] in copyPermRel)
                 implies
                  [[src,d1],[p1,[ip1,[k,[l,[q,r]]]]]]
                    in remainderVCRel))) &
           ((q-1)+1 < 0 implies
              [[src,dst],
               [idMap/.(arrLen/.dst),
                [idMap/.(arrLen/.dst),[k,[l,[q,r]]]]]]
                in remainderVCRel)))))
proof
end;
::$P+
