:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/defunctionalization_Defunctionalization_continue_2qtvc: the
:: defunctionalized continuation-step verification condition for expression
:: evaluation, including its size decrease and evaluation relation. This file
:: contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Expr,Cont being non empty set,
      cte being Function of INT,Expr,
      sube being Function of [:Expr,Expr:],Expr,
      aone being Function of [:Expr,Cont:],Cont,
      atwo being Function of [:INT,Cont:],Cont,
      ident being Element of Cont,
      eval0,sizeE being Function of Expr,INT,
      sizeC being Function of Cont,INT,
      evalCont being Subset of [:Cont,[:INT,INT:]:],
      c being Element of Cont,
      v being Integer
  st
    (for x,y being Integer st cte.x = cte.y holds x = y) &
    (for e1,e2,f1,f2 being Element of Expr st
       sube.[e1,e2] = sube.[f1,f2]
     holds e1 = f1 & e2 = f2) &
    (for x being Integer, e1,e2 being Element of Expr
     holds cte.x <> sube.[e1,e2]) &
    (for e being Element of Expr holds
       (ex x being Integer st e = cte.x) or
       ex e1,e2 being Element of Expr st e = sube.[e1,e2]) &
    (for X being Subset of Expr st
       (for x being Integer holds cte.x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds sube.[e1,e2] in X)
     holds X = Expr) &
    (for e1,e2 being Element of Expr, k1,k2 being Element of Cont st
       aone.[e1,k1] = aone.[e2,k2]
     holds e1 = e2 & k1 = k2) &
    (for x1,x2 being Integer, k1,k2 being Element of Cont st
       atwo.[x1,k1] = atwo.[x2,k2]
     holds x1 = x2 & k1 = k2) &
    (for e being Element of Expr, k1,k2 being Element of Cont,
         x being Integer
     holds aone.[e,k1] <> atwo.[x,k2]) &
    (for e being Element of Expr, k being Element of Cont
     holds aone.[e,k] <> ident) &
    (for x being Integer, k being Element of Cont
     holds atwo.[x,k] <> ident) &
    (for k being Element of Cont holds
       k = ident or
       (ex e being Element of Expr, k1 being Element of Cont st
          k = aone.[e,k1]) or
       ex x being Integer, k1 being Element of Cont st
          k = atwo.[x,k1]) &
    (for K being Subset of Cont st
       ident in K &
       (for e being Element of Expr, k being Element of Cont st k in K
        holds aone.[e,k] in K) &
       (for x being Integer, k being Element of Cont st k in K
        holds atwo.[x,k] in K)
     holds K = Cont) &
    (for x being Integer holds eval0.(cte.x) = x) &
    (for e1,e2 being Element of Expr holds
       eval0.(sube.[e1,e2]) = eval0.e1 - eval0.e2) &
    (for x being Integer holds sizeE.(cte.x) = 1) &
    (for e1,e2 being Element of Expr holds
       sizeE.(sube.[e1,e2]) = 3 + sizeE.e1 + sizeE.e2) &
    sizeC.ident = 0 &
    (for e being Element of Expr, k being Element of Cont holds
       sizeC.(aone.[e,k]) = 2 + sizeE.e + sizeC.k) &
    (for x being Integer, k being Element of Cont holds
       sizeC.(atwo.[x,k]) = 1 + sizeC.k) &
    (for x,r being Integer, k being Element of Cont,
         e being Element of Expr st
       [atwo.[x,k],[eval0.e,r]] in evalCont
     holds [aone.[e,k],[x,r]] in evalCont) &
    (for x,y,r being Integer, k being Element of Cont st
       [k,[x-y,r]] in evalCont
     holds [atwo.[x,k],[y,r]] in evalCont) &
    (for x being Integer holds [ident,[x,x]] in evalCont) &
    (for R being Subset of [:Cont,[:INT,INT:]:] st
       (for x,r being Integer, k being Element of Cont,
            e being Element of Expr st
          [atwo.[x,k],[eval0.e,r]] in R
        holds [aone.[e,k],[x,r]] in R) &
       (for x,y,r being Integer, k being Element of Cont st
          [k,[x-y,r]] in R
        holds [atwo.[x,k],[y,r]] in R) &
       (for x being Integer holds [ident,[x,x]] in R)
     holds evalCont c= R)
  holds
    (for e being Element of Expr, k being Element of Cont st
       c = aone.[e,k]
     holds
       ex sc,scnext,se being Integer st
         sc = sizeC.c &
         scnext = sizeC.(atwo.[v,k]) &
         se = sizeE.e &
         0 <= sc &
         scnext + se < sc) &
    (for x being Integer, k being Element of Cont st
       c = atwo.[x,k]
     holds
       ex sc,sck being Integer st
         sc = sizeC.c &
         sck = sizeC.k &
         0 <= sc &
         sck < sc) &
    (c = ident implies c = ident) &
    (for e being Element of Expr, k being Element of Cont,
         result being Integer st
       c = aone.[e,k] &
       [atwo.[v,k],[eval0.e,result]] in evalCont
     holds [c,[v,result]] in evalCont) &
    (for x,result being Integer, k being Element of Cont st
       c = atwo.[x,k] &
       [k,[x-v,result]] in evalCont
     holds [c,[v,result]] in evalCont) &
    (for result being Integer st c = ident & result = v
     holds [c,[v,result]] in evalCont)
proof
end;
::$P+
