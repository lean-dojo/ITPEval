:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_shearsort_ShearSort_sort_all_rowsqtvc: the
:: ShearSort row-sorting verification condition preserves every row's
:: multiplicities while establishing alternating ascending and descending
:: row order. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCOP_1, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1,
    NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSET_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, NAT_1, XXREAL_0, FINSET_1, MARGREL1,
    XBOOLEAN, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4,
    FUNCT_7;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1,
    CARD_1, REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1,
    NAT_1, FINSET_1, MARGREL1, FINSEQ_1, FINSEQ_2, PRE_POLY,
    FUNCT_4, FUNCT_7;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCOP_1, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSET_1, MARGREL1, XBOOLEAN, FRAENKEL, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for RowPerm,RowPrefix,SameExceptRow,RowAtSorted,OneRowPerm
      being set,
      r,c being Integer,
      e being Function of [:INT,INT:],INT
  st
    0 <= r & 0 <= c &

    (for f2,f1 being Function of [:INT,INT:],INT,
         nr,nc being Integer
     holds
       ([f2,[f1,[nr,nc]]] in RowPerm iff
         for i being Integer st 0 <= i & i < nr
         holds
           for v being Integer holds
             card {j where j is Integer :
               0 <= j & j < nc & f2.[i,j] = v} =
             card {j where j is Integer :
               0 <= j & j < nc & f1.[i,j] = v})) &

    (for f being Function of [:INT,INT:],INT,
         nc,upto being Integer
     holds
       ([f,[nc,upto]] in RowPrefix iff
         for i,j,k being Integer st
           0 <= i & i < upto &
           0 <= j & j <= k & k < nc
         holds
           (i mod 2 = 0 implies f.[i,j] <= f.[i,k]) &
           (i mod 2 <> 0 implies f.[i,k] <= f.[i,j]))) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         nr,nc,tid being Integer
     holds
       ([f2,[f1,[nr,[nc,tid]]]] in SameExceptRow iff
         for j,k being Integer st
           0 <= j & j < nr & 0 <= k & k < nc & j <> tid
         holds f2.[j,k] = f1.[j,k])) &

    (for f being Function of [:INT,INT:],INT,
         nc,tid being Integer
     holds
       ([f,[nc,tid]] in RowAtSorted iff
         for j,k being Integer st
           0 <= j & j <= k & k < nc
         holds
           (tid mod 2 = 0 implies f.[tid,j] <= f.[tid,k]) &
           (tid mod 2 <> 0 implies f.[tid,k] <= f.[tid,j]))) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         tid,nc being Integer
     holds
       ([f2,[f1,[tid,nc]]] in OneRowPerm iff
         for v being Integer holds
           card {j where j is Integer :
             0 <= j & j < nc & f2.[tid,j] = v} =
           card {j where j is Integer :
             0 <= j & j < nc & f1.[tid,j] = v}))
  holds
    (0 <= (r-1)+1 implies
      ([e,[e,[r,c]]] in RowPerm &
       [e,[c,0]] in RowPrefix) &
      (for e1 being Function of [:INT,INT:],INT holds
        (for tid being Integer st
           (0 <= tid & tid <= r-1) &
           [e1,[e,[r,c]]] in RowPerm &
           [e1,[c,tid]] in RowPrefix
         holds
           2 <> 0 &
           (0 <= tid & tid < r) &
           (for e2 being Function of [:INT,INT:],INT st
              [e2,[e1,[r,[c,tid]]]] in SameExceptRow &
              [e2,[c,tid]] in RowAtSorted &
              [e2,[e1,[tid,c]]] in OneRowPerm
            holds
              [e2,[e,[r,c]]] in RowPerm &
              [e2,[c,tid+1]] in RowPrefix)) &
        (([e1,[e,[r,c]]] in RowPerm &
          [e1,[c,(r-1)+1]] in RowPrefix)
         implies
           [e1,[e,[r,c]]] in RowPerm &
           [e1,[c,r]] in RowPrefix))) &
    ((r-1)+1 < 0 implies
      [e,[e,[r,c]]] in RowPerm &
      [e,[c,r]] in RowPrefix)
proof
end;
::$P+
