:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/coincidence_count_CoincidenceCount_coincidence_countqtvc:
:: the coincidence-count loop verification condition preserves the cardinality
:: invariant for intersecting suffix sets of two strictly increasing integer lists.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      ORDINAL4, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
      FINSET_1, MARGREL1, XBOOLEAN, MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
      MARGREL1, XBOOLEAN;
 constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0, FINSEQ_1,
      FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE,
      PRE_POLY, FINSET_1, MARGREL1, XBOOLEAN;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a, b being FinSequence of INT,
      nthElem being Function of [:INT*,INT:],INT,
      setOf being Function of INT*,bool INT,
      dropSet being Function of [:INT*,INT:],bool INT,
      setCard being Function of (bool INT),INT,
      coincidenceCount being Function of [:INT*,INT*:],INT
  st
    (for xs being FinSequence of INT, i being Integer
       st 0 <= i & i < len xs
       holds nthElem.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of INT, n being Integer
       st 0 <= n & n <= len xs
       holds
         (dropSet.[xs,n]) is finite &
         (for x being Integer holds
            (x in dropSet.[xs,n] iff
              ex k being Integer st
                n <= k & k < len xs & x = nthElem.[xs,k]))) &
    (for xs being FinSequence of INT
       holds setOf.xs = dropSet.[xs,0]) &
    (for s being finite Subset of INT
       holds setCard.s = card s) &
    (for xs, ys being FinSequence of INT
       holds
         coincidenceCount.[xs,ys] =
           setCard.(setOf.xs /\ setOf.ys)) &
    (for i, j being Integer
       st 0 <= i & i < j & j < len a
       holds nthElem.[a,i] < nthElem.[a,j]) &
    (for i, j being Integer
       st 0 <= i & i < j & j < len b
       holds nthElem.[b,i] < nthElem.[b,j])
  holds
    0 <= 0 & 0 <= len a &
    0 <= 0 & 0 <= len b &
    0 + setCard.(dropSet.[a,0] /\ dropSet.[b,0]) =
      coincidenceCount.[a,b] &
    (for c, j, i being Integer
       st
         0 <= i & i <= len a &
         0 <= j & j <= len b &
         c + setCard.(dropSet.[a,i] /\ dropSet.[b,j]) =
           coincidenceCount.[a,b]
       holds
         for o1 being Element of BOOLEAN
           st
             (i < len a &
                ((j < len b & o1 = TRUE) or
                 (not j < len b & o1 = FALSE))) or
             (not i < len a & o1 = FALSE)
           holds
             (o1 = TRUE &
                j < len b & i < len a &
                ((nthElem.[a,i] < nthElem.[b,j] &
                    0 <= (len a + len b) - (i + j) &
                    (len a + len b) - ((i+1) + j) <
                      (len a + len b) - (i + j) &
                    0 <= i+1 & i+1 <= len a &
                    0 <= j & j <= len b &
                    c + setCard.(
                      dropSet.[a,i+1] /\ dropSet.[b,j]) =
                      coincidenceCount.[a,b]) or
                 (not nthElem.[a,i] < nthElem.[b,j] &
                    nthElem.[b,j] < nthElem.[a,i] &
                    0 <= (len a + len b) - (i + j) &
                    (len a + len b) - (i + (j+1)) <
                      (len a + len b) - (i + j) &
                    0 <= i & i <= len a &
                    0 <= j+1 & j+1 <= len b &
                    c + setCard.(
                      dropSet.[a,i] /\ dropSet.[b,j+1]) =
                      coincidenceCount.[a,b]) or
                 (not nthElem.[a,i] < nthElem.[b,j] &
                    not nthElem.[b,j] < nthElem.[a,i] &
                    0 <= (len a + len b) - (i + j) &
                    (len a + len b) - ((i+1) + (j+1)) <
                      (len a + len b) - (i + j) &
                    0 <= i+1 & i+1 <= len a &
                    0 <= j+1 & j+1 <= len b &
                    c+1 + setCard.(
                      dropSet.[a,i+1] /\ dropSet.[b,j+1]) =
                      coincidenceCount.[a,b]))) or
             (o1 = FALSE &
                c = coincidenceCount.[a,b]))
proof
end;
::$P+
