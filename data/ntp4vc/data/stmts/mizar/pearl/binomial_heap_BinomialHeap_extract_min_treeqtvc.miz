:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binomial_heap_BinomialHeap_extract_min_treeqtvc: the binomial-heap
:: minimum-tree extraction verification condition preserves heap and rank
:: invariants, root minimality, binomial shape, and element multiplicities.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    BINOP_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, BINOP_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      Leq being Relation of E,E,
      treeMk being Function of [:E,[:Tree*,INT:]:],Tree,
      treeElem being Function of Tree,E,
      treeChildren being Function of Tree,Tree*,
      treeRank being Function of Tree,INT,
      treeDepth being Function of Tree,NAT,
      LeRoots being Subset of [:E,Tree*:],
      Heaps being Subset of Tree*,
      Occ being Function of [:E,Tree*:],INT,
      HasOrder being Subset of [:INT,Tree*:],
      BinomialTree being Subset of Tree,
      Inv being Subset of [:INT,Tree*:],
      h being FinSequence of Tree,
      k being Integer
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
      [x,y] in Leq & [y,z] in Leq
     holds
      [x,z] in Leq) &
    (for x,y being Element of E holds
      [x,y] in Leq or [y,x] in Leq) &
    (for e being Element of E,
         c being FinSequence of Tree,
         r being Integer
     holds
       treeElem.(treeMk.[e,[c,r]]) = e &
       treeChildren.(treeMk.[e,[c,r]]) = c &
       treeRank.(treeMk.[e,[c,r]]) = r) &
    (for t being Element of Tree holds
      ex e being Element of E,
         c being FinSequence of Tree,
         r being Integer st
        t = treeMk.[e,[c,r]]) &
    (for e being Element of E,
         c being FinSequence of Tree,
         r being Integer,
         i being Nat st i in dom c
     holds
       ex child being Element of Tree,
          childDepth,parentDepth being Nat st
         child = c/.i &
         childDepth = treeDepth.child &
         parentDepth = treeDepth.(treeMk.[e,[c,r]]) &
         childDepth < parentDepth) &
    (for e being Element of E holds
      [e,<*>Tree] in LeRoots) &
    (for e being Element of E,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ([e,<*t*> ^ tl] in LeRoots iff
        [e,treeElem.t] in Leq & [e,tl] in LeRoots)) &
    <*>Tree in Heaps &
    (for t being Element of Tree,
         tl being FinSequence of Tree
     holds
      (<*t*> ^ tl in Heaps iff
        [treeElem.t,treeChildren.t] in LeRoots &
        treeChildren.t in Heaps &
        tl in Heaps)) &
    (for x being Element of E holds
      Occ.[x,<*>Tree] = 0) &
    (for x being Element of E,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ex whole,children,tail being Integer st
        whole = Occ.[x,<*t*> ^ tl] &
        children = Occ.[x,treeChildren.t] &
        tail = Occ.[x,tl] &
        (x = treeElem.t implies whole = 1 + children + tail) &
        (x <> treeElem.t implies whole = children + tail)) &
    (for q being Integer holds
      ([q,<*>Tree] in HasOrder iff q = 0)) &
    (for q being Integer,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ([q,<*t*> ^ tl] in HasOrder iff
        treeRank.t = q - 1 &
        [q - 1,treeChildren.t] in HasOrder &
        [q - 1,tl] in HasOrder)) &
    (for t being Element of Tree holds
      (t in BinomialTree iff
        treeRank.t = len (treeChildren.t) &
        [treeRank.t,treeChildren.t] in HasOrder)) &
    (for q being Integer holds
      [q,<*>Tree] in Inv) &
    (for q being Integer,
         t being Element of Tree,
         tl being FinSequence of Tree
     holds
      ([q,<*t*> ^ tl] in Inv iff
        q <= treeRank.t &
        t in BinomialTree &
        [treeRank.t + 1,tl] in Inv)) &
    h in Heaps &
    [k,h] in Inv &
    h <> <*>Tree
  holds
    (len h = 1 or
      ex t being Element of Tree,
         tl being non empty FinSequence of Tree st
        h = <*t*> ^ tl &
        tl in Heaps &
        [treeRank.t + 1,tl] in Inv) &
    (for t being Element of Tree,
         hp being FinSequence of Tree st
      (ex t1 being Element of Tree st
        h = <*t1*> &
        t = t1 &
        hp = <*>Tree) or
      (ex t1 being Element of Tree,
          tl being non empty FinSequence of Tree st
        h = <*t1*> ^ tl &
        ex t2 being Element of Tree,
           hp1 being FinSequence of Tree st
          <*t2*> in Heaps &
          hp1 in Heaps &
          [treeRank.t1 + 1,hp1] in Inv &
          [treeElem.t2,tl] in LeRoots &
          t2 in BinomialTree &
          (for x being Element of E holds
            ex otl,ot2,ohp1 being Integer st
              otl = Occ.[x,tl] &
              ot2 = Occ.[x,<*t2*>] &
              ohp1 = Occ.[x,hp1] &
              otl = ot2 + ohp1) &
          (([treeElem.t1,treeElem.t2] in Leq &
              t = t1 & hp = tl) or
           (not [treeElem.t1,treeElem.t2] in Leq &
              t = t2 & hp = <*t1*> ^ hp1)))
     holds
       <*t*> in Heaps &
       hp in Heaps &
       [k,hp] in Inv &
       [treeElem.t,h] in LeRoots &
       t in BinomialTree &
       (for x being Element of E holds
         ex oh,ot,ohp being Integer st
           oh = Occ.[x,h] &
           ot = Occ.[x,<*t*>] &
           ohp = Occ.[x,hp] &
           oh = ot + ohp))
proof
end;
::$P+
