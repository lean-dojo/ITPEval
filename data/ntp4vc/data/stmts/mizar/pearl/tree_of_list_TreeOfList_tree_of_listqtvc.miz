:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/tree_of_list_TreeOfList_tree_of_listqtvc: the verification condition
:: for converting a list into an inorder-preserving binary tree whose
:: positive size lies between consecutive powers of two determined by its
:: height. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, NEWTON;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size,Height being Function of Tree,INT,
      Inorder being Function of Tree,E*,
      Pow2 being Function of INT,INT,
      xs being FinSequence of E
  st
    (for lt,rt being Element of Tree,
         x being Element of E
     holds
       node.[lt,[x,rt]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex lt,rt being Element of Tree,
          x being Element of E st
         u = node.[lt,[x,rt]]) &
    (for lt,lt2,rt,rt2 being Element of Tree,
         x,x2 being Element of E st
       node.[lt,[x,rt]] = node.[lt2,[x2,rt2]]
     holds
       lt = lt2 & x = x2 & rt = rt2) &
    (for X being Subset of Tree st
       emptyT in X &
       (for lt,rt being Element of Tree,
            x being Element of E st
          lt in X & rt in X
        holds
          node.[lt,[x,rt]] in X)
     holds
       X = Tree) &
    Size.emptyT = 0 &
    (for lt,rt being Element of Tree,
         x being Element of E
     holds
       Size.(node.[lt,[x,rt]]) = 1 + Size.lt + Size.rt) &
    Height.emptyT = 0 &
    (for lt,rt being Element of Tree,
         x being Element of E
     holds
       Height.(node.[lt,[x,rt]]) =
         1 + max(Height.lt,Height.rt)) &
    Inorder.emptyT = <*>(E) &
    (for lt,rt being Element of Tree,
         x being Element of E
     holds
       Inorder.(node.[lt,[x,rt]]) =
         Inorder.lt ^ <*x*> ^ Inorder.rt) &
    (for e being Integer st 0 <= e holds
       ex n being Nat st
         n = e &
         Pow2.e = 2 |^ n)
  holds
    for o1 being Integer st o1 = len xs holds
      (0 <= o1 & o1 <= len xs) &
      (for o2 being Element of Tree,
           o3 being FinSequence of E st
         Inorder.o2 ^ o3 = xs &
         Size.o2 = o1 &
         (0 < o1 implies
            for h being Element of INT st h = Height.o2 holds
              for hm1 being Element of INT st hm1 = h-1 holds
                Pow2.hm1 <= o1 & o1 < Pow2.h)
       holds
         Inorder.o2 = xs &
         (0 < Size.o2 implies
            for h being Element of INT st h = Height.o2 holds
              for hm1 being Element of INT st hm1 = h-1 holds
                Pow2.hm1 <= Size.o2 &
                Size.o2 < Pow2.h))
proof
end;
::$P+
