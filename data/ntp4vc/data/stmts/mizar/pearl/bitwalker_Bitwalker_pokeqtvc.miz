:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bitwalker_Bitwalker_pokeqtvc: the bit-stream poke verification
:: condition preserves the loop invariant while writing up to 63 bits of a
:: 64-bit value into a finite sequence of 8-bit words. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, FINSEQ_1, FINSEQ_2, MCART_1, MARGREL1,
    XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    NAT_D, NEWTON, XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1,
    XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for len32,start,value being Nat,
      addr being FinSequence of NAT,
      Bit being Function of [:NAT,INT:],BOOLEAN,
      Nth8 being Function of INT,BOOLEAN st
    len32 < (2 |^ 32) &
    start < (2 |^ 32) &
    value < (2 |^ 64) &
    (for q being Nat st q in dom addr holds
      ex b being Nat st b = addr.q & b < 256) &
    (for w being Nat, p being Integer holds
      (Bit.[w,p] = TRUE iff
        ex k being Nat st
          ((p < 0 & k = 0) or (0 <= p & k = p)) &
          (w div (2 |^ k)) mod 2 = 1)) &
    (for p being Integer holds
      (Nth8.p = TRUE iff
        ex q,k,b being Nat st
          (((p div 8) < 0 & q = 0) or
           (0 <= (p div 8) & q = p div 8)) &
          k = 7 - (p mod 8) &
          q < len addr &
          b = addr.(q + 1) &
          Bit.[b,k] = TRUE)) &
    len32 < 64 &
    start + len32 < (2 |^ 32) &
    8 * len addr < (2 |^ 32)
  holds
    (start + len32 < (2 |^ 32) or
      start + len32 <= (2 |^ 32) - 1) &
    (((start + len32) mod (2 |^ 32) = start + len32) implies
      ((8 * len addr < (start + len32) mod (2 |^ 32) implies
        (-2 <= -1 & -1 <= 0) &
        8 * len addr < start + len32 &
        (-1 = -2 iff
          (2 |^ len32) mod (2 |^ 64) <= value &
          start + len32 <= 8 * len addr) &
        (-1 = 0 iff
          value < (2 |^ len32) mod (2 |^ 64) &
          start + len32 <= 8 * len addr) &
        (-1 = 0 implies
          for i being Integer st
            start <= i & i < start + len32
          holds
            Nth8.i = Bit.[value,len32 - i - 1 + start])) &
       (not 8 * len addr < (start + len32) mod (2 |^ 32)
        implies
        (((2 |^ len32) mod (2 |^ 64) <= value implies
          (-2 <= -2 & -2 <= 0) &
          (-2 = -1 iff 8 * len addr < start + len32) &
          ((2 |^ len32) mod (2 |^ 64) <= value &
            start + len32 <= 8 * len addr) &
          (-2 = 0 iff
            value < (2 |^ len32) mod (2 |^ 64) &
            start + len32 <= 8 * len addr) &
          (-2 = 0 implies
            for i being Integer st
              start <= i & i < start + len32
            holds
              Nth8.i = Bit.[value,len32 - i - 1 + start])) &
         (not (2 |^ len32) mod (2 |^ 64) <= value implies
          (len32 <= 64 or 64 >= len32) &
          (for lstart being Nat st
             lstart =
               (64 + (2 |^ 32) - len32) mod (2 |^ 32)
           holds
            (lstart = 64 - len32 implies
              (((0 <= 0 & 0 <= len32) &
                (for j being Integer st
                   start <= j & j < start + 0
                 holds
                   Nth8.j =
                     Bit.[value,len32 - j - 1 + start])) &
               (for i being Nat,
                    addr1 being FinSequence of NAT,
                    Nth81 being Function of INT,BOOLEAN st
                  i < (2 |^ 32) &
                  len addr1 = len addr &
                  (for q being Nat st q in dom addr1 holds
                    ex b being Nat st b = addr1.q & b < 256) &
                  (for p being Integer holds
                    (Nth81.p = TRUE iff
                      ex q,k,b being Nat st
                        (((p div 8) < 0 & q = 0) or
                         (0 <= (p div 8) & q = p div 8)) &
                        k = 7 - (p mod 8) &
                        q < len addr1 &
                        b = addr1.(q + 1) &
                        Bit.[b,k] = TRUE)) &
                  (0 <= i & i <= len32) &
                  (for j being Integer st
                     0 <= j & j < start
                   holds Nth8.j = Nth81.j) &
                  (for j being Integer st
                     start <= j & j < start + i
                   holds
                     Nth81.j =
                       Bit.[value,len32 - j - 1 + start]) &
                  (for j being Integer st
                     start + i <= j & j < 8 * len addr1
                   holds Nth81.j = Nth8.j)
                holds
                  ((i < len32 implies
                    (lstart + i < (2 |^ 32) or
                      lstart + i <= (2 |^ 32) - 1) &
                    (((lstart + i) mod (2 |^ 32) =
                        lstart + i) implies
                      ((lstart + i) mod (2 |^ 32) < 64 &
                       (start + i < (2 |^ 32) or
                         start + i <= (2 |^ 32) - 1) &
                       (((start + i) mod (2 |^ 32) =
                           start + i) implies
                         ((8 * len addr1 < (2 |^ 32) &
                           (start + i) mod (2 |^ 32) <
                             8 * len addr1) &
                          (for addr2 being FinSequence of NAT,
                               Nth82 being Function of INT,BOOLEAN st
                             len addr2 = len addr1 &
                             (for q being Nat st q in dom addr2 holds
                               ex b being Nat st
                                 b = addr2.q & b < 256) &
                             (for p being Integer holds
                               (Nth82.p = TRUE iff
                                 ex q,k,b being Nat st
                                   (((p div 8) < 0 & q = 0) or
                                    (0 <= (p div 8) &
                                      q = p div 8)) &
                                   k = 7 - (p mod 8) &
                                   q < len addr2 &
                                   b = addr2.(q + 1) &
                                   Bit.[b,k] = TRUE)) &
                             (for i1 being Integer st
                                0 <= i1 &
                                i1 < 8 * len addr2 &
                                not i1 =
                                  (start + i) mod (2 |^ 32)
                              holds Nth82.i1 = Nth81.i1) &
                             Nth82.((start + i) mod (2 |^ 32)) =
                               Bit.[value,
                                 63 -
                                   ((lstart + i) mod (2 |^ 32))]
                           holds
                             (i + 1 < (2 |^ 32) or
                               i + 1 <= (2 |^ 32) - 1) &
                             (((i + 1) mod (2 |^ 32) = i + 1)
                              implies
                               ((0 <= len32 - i &
                                 len32 -
                                     ((i + 1) mod (2 |^ 32)) <
                                   len32 - i) &
                                (0 <=
                                    ((i + 1) mod (2 |^ 32)) &
                                  ((i + 1) mod (2 |^ 32)) <=
                                    len32) &
                                (for j being Integer st
                                   0 <= j & j < start
                                 holds Nth8.j = Nth82.j) &
                                (for j being Integer st
                                   start <= j &
                                   j <
                                     start +
                                       ((i + 1) mod (2 |^ 32))
                                 holds
                                   Nth82.j =
                                     Bit.[value,
                                       len32 - j - 1 + start]) &
                                (for j being Integer st
                                   start +
                                       ((i + 1) mod (2 |^ 32))
                                     <= j &
                                   j < 8 * len addr2
                                 holds Nth82.j = Nth8.j)))))))))) &
                   (not i < len32 implies
                    (-2 <= 0 & 0 <= 0) &
                    (0 = -1 iff
                      8 * len addr1 < start + len32) &
                    (0 = -2 iff
                      (2 |^ len32) mod (2 |^ 64) <= value &
                      start + len32 <= 8 * len addr1) &
                    (value < (2 |^ len32) mod (2 |^ 64) &
                      start + len32 <= 8 * len addr1) &
                    (for i1 being Integer st
                       0 <= i1 & i1 < start
                     holds Nth8.i1 = Nth81.i1) &
                    (for i1 being Integer st
                       start <= i1 & i1 < start + len32
                     holds
                       Nth81.i1 =
                         Bit.[value,len32 - i1 - 1 + start]) &
                    (for i1 being Integer st
                       start + len32 <= i1 &
                       i1 < 8 * len addr1
                     holds Nth81.i1 = Nth8.i1)))))))))))
proof
end;
::$P+
