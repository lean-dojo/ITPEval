:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/kmp_KnuthMorrisPratt_kmpqtvc: the Knuth-Morris-Pratt search
:: verification condition preserves its prefix-matching invariant and
:: returns the first occurrence of the pattern. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1,
    MARGREL1, XBOOLEAN;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for C being non empty set,
      c0 being Element of C,
      p,a being FinSequence of C,
      nthC being Function of [:C*,INT:],C,
      nthZ being Function of [:INT*,INT:],INT,
      MatchesRel,NextRel,FirstRel being set st
    (for xs being FinSequence of C, k being Integer holds
      (k < 0 & len xs = 0 implies nthC.[xs,k] = c0) &
      (k < 0 & 0 < len xs implies nthC.[xs,k] = xs.1) &
      (0 <= k & k < len xs implies nthC.[xs,k] = xs.(k+1)) &
      (len xs <= k implies nthC.[xs,k] = c0)) &
    (for xs being FinSequence of INT, k being Integer holds
      (k < 0 & len xs = 0 implies nthZ.[xs,k] = 0) &
      (k < 0 & 0 < len xs implies nthZ.[xs,k] = xs.1) &
      (0 <= k & k < len xs implies nthZ.[xs,k] = xs.(k+1)) &
      (len xs <= k implies nthZ.[xs,k] = 0)) &
    (for a1,a2 being FinSequence of C,
         i1,i2,l being Integer holds
      ([a1,[i1,[a2,[i2,l]]]] in MatchesRel iff
        (0 <= i1 & i1 <= len a1 - l) &
        (0 <= i2 & i2 <= len a2 - l) &
        (for r being Integer st 0 <= r & r < l holds
          nthC.[a1,i1+r] = nthC.[a2,i2+r]))) &
    (for q being FinSequence of C, j,l being Integer holds
      ([q,[j,l]] in NextRel iff
        (0 <= l & l < j) &
        [q,[j-l,[q,[0,l]]]] in MatchesRel &
        (for z being Integer st l < z & z < j holds
          not [q,[j-z,[q,[0,z]]]] in MatchesRel))) &
    (for q,x being FinSequence of C, r being Integer holds
      ([q,[x,r]] in FirstRel iff
        ((0 <= r & r < len x implies
          [x,[r,[q,[0,len q]]]] in MatchesRel) &
         (for k being Integer st 0 <= k & k < r holds
          not [x,[k,[q,[0,len q]]]] in MatchesRel)))) &
    1 <= len p
  holds
    for m,n being Integer st m = len p & n = len a holds
      1 <= len p &
      (for next being FinSequence of INT st
        len next = len p &
        (for j being Integer st 0 < j & j < len p holds
          [p,[j,nthZ.[next,j]]] in NextRel)
       holds
        ((0 <= 0 & 0 <= m) & (0 <= 0 & 0 <= n) &
         [a,[0-0,[p,[0,0]]]] in MatchesRel &
         (for k being Integer st 0 <= k & k < 0-0 holds
           not [a,[k,[p,[0,m]]]] in MatchesRel)) &
        (for j,i being Integer st
          ((0 <= j & j <= m) & j <= i & i <= n) &
          [a,[i-j,[p,[0,j]]]] in MatchesRel &
          (for k being Integer st 0 <= k & k < i-j holds
            not [a,[k,[p,[0,m]]]] in MatchesRel)
         holds
          for o1 being Element of BOOLEAN st
            (j < m &
              ((i < n & o1 = TRUE) or
               (not i < n & o1 = FALSE))) or
            (not j < m & o1 = FALSE)
          holds
            (o1 = TRUE &
              (0 <= j & j < len p) &
              (0 <= i & i < len a) &
              ((nthC.[a,i] = nthC.[p,j] &
                (((0 <= n-i & n-(i+1) < n-i) or
                  (n-i = n-(i+1) & 0 <= j & j+1 < j)) &
                 ((0 <= j+1 & j+1 <= m) &
                  j+1 <= i+1 & i+1 <= n) &
                 [a,[i+1-(j+1),[p,[0,j+1]]]] in MatchesRel &
                 (for k being Integer st
                   0 <= k & k < i+1-(j+1)
                  holds
                   not [a,[k,[p,[0,m]]]] in MatchesRel))) or
               (nthC.[a,i] <> nthC.[p,j] &
                ((j = 0 &
                  (((0 <= n-i & n-(i+1) < n-i) or
                    (n-i = n-(i+1) & 0 <= j & j < j)) &
                   ((0 <= j & j <= m) &
                    j <= i+1 & i+1 <= n) &
                   [a,[i+1-j,[p,[0,j]]]] in MatchesRel &
                   (for k being Integer st
                     0 <= k & k < i+1-j
                    holds
                     not [a,[k,[p,[0,m]]]] in MatchesRel))) or
                 (j <> 0 &
                  (0 <= j & j < len next) &
                  (((0 <= n-i & n-i < n-i) or
                    (0 <= j & nthZ.[next,j] < j)) &
                   ((0 <= nthZ.[next,j] &
                     nthZ.[next,j] <= m) &
                    nthZ.[next,j] <= i & i <= n) &
                   [a,[i-nthZ.[next,j],
                     [p,[0,nthZ.[next,j]]]]] in MatchesRel &
                   (for k being Integer st
                     0 <= k & k < i-nthZ.[next,j]
                    holds
                     not [a,[k,[p,[0,m]]]] in MatchesRel))))))) or
            (o1 = FALSE &
              (for result being Integer st
                (j = m & result = i-m) or
                (j <> m & result = i)
               holds
                [p,[a,result]] in FirstRel))))
proof
end;
::$P+
