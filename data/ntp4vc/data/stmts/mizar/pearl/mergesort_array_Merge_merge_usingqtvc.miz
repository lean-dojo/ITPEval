:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_array_Merge_merge_usingqtvc: the array-merge
:: verification condition combines two sorted adjacent list segments,
:: preserving their subarray permutation and all entries outside the segment.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1,
    MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL, MARGREL1,
    XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      nthElem being Function of [:E*,INT:],E,
      SortedSub being Subset of [:E*,[:INT,INT:]:],
      PermSub being Subset of [:E*,[:E*,[:INT,INT:]:]:],
      l,m,r being Integer,
      tmp,a being FinSequence of E,
      o1 being Element of BOOLEAN
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (for s being FinSequence of E, lo,hi being Integer holds
       ([s,[lo,hi]] in SortedSub iff
         for i1,i2 being Integer st
           lo <= i1 & i1 < i2 & i2 < hi
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s,t being FinSequence of E, lo,hi being Integer holds
       ([s,[t,[lo,hi]]] in PermSub iff
         len s = len t &
         0 <= max(lo,0) & max(lo,0) <= len s &
         0 <= max(hi,0) & max(hi,0) <= len s &
         (for x being Element of E holds
           card {q where q is Integer :
             max(lo,0) <= q & q < max(hi,0) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(lo,0) <= q & q < max(hi,0) &
             nthElem.[t,q] = x}))) &
    0 <= l &
    l <= m &
    m <= r &
    r <= len tmp &
    len tmp = len a &
    [a,[l,m]] in SortedSub &
    [a,[m,r]] in SortedSub &
    ((l < m &
       ((m < r & o1 = TRUE) or
        (not m < r & o1 = FALSE))) or
     (not l < m & o1 = FALSE))
  holds
    (o1 = TRUE &
      0 <= m & m < len a &
      (for o2 being Integer st o2 = m - 1 holds
        0 <= o2 & o2 < len a &
        (([nthElem.[a,o2],nthElem.[a,m]] in Leq &
          [a,[l,r]] in SortedSub &
          [a,[a,[l,r]]] in PermSub) or
         (not [nthElem.[a,o2],nthElem.[a,m]] in Leq &
          (for o3 being Integer st o3 = r - l holds
            ((0 <= l & 0 <= o3 & l + o3 <= len a) &
             0 <= l & l + o3 <= len tmp) &
            (for tmp1 being FinSequence of E st
               len tmp1 = len tmp &
               (for i being Integer st
                  (0 <= i & i < l) or
                  (l + o3 <= i & i < len tmp1)
                holds nthElem.[tmp1,i] = nthElem.[tmp,i]) &
               (for i being Integer st
                  l <= i & i < l + o3
                holds
                  nthElem.[tmp1,i] =
                    nthElem.[a,l+i-l])
             holds
               ((0 <= l & l <= m & m <= r &
                 r <= len tmp1 & len tmp1 = len a) &
                [tmp1,[l,m]] in SortedSub &
                [tmp1,[m,r]] in SortedSub) &
               (for a1 being FinSequence of E st
                  len a1 = len a &
                  [a1,[l,r]] in SortedSub &
                  [tmp1,[a1,[l,r]]] in PermSub &
                  (for i being Integer st
                     (0 <= i & i < l) or
                     (r <= i & i < len a1)
                   holds nthElem.[a1,i] = nthElem.[a,i])
                holds
                  [a1,[l,r]] in SortedSub &
                  [a,[a1,[l,r]]] in PermSub &
                  (for i being Integer st
                     (0 <= i & i < l) or
                     (r <= i & i < len a1)
                   holds
                     nthElem.[a1,i] =
                       nthElem.[a,i]))))))) or
    (o1 = FALSE &
      [a,[l,r]] in SortedSub &
      [a,[a,[l,r]]] in PermSub))
proof
end;
::$P+
