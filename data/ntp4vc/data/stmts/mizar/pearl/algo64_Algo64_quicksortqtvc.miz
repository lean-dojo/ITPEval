:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/algo64_Algo64_quicksortqtvc: the quicksort verification condition
:: composes a partition around 42 with sorted, permutation-preserving
:: recursive calls on the two resulting integer-list subranges.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,n,alen being Integer,
      a being Function of INT,INT st
    0 <= alen &
    (for k being Integer st k < 0 holds a.k = a.0) &
    (for k being Integer st alen <= k holds a.k = 0) &
    0 <= m & m <= n & n < alen
  holds
    (m < n implies
      (0 <= m & m < n & n < alen) &
      (for j,i being Integer,
           a1 being Function of INT,INT st
        (for k being Integer st k < 0 holds a1.k = a1.0) &
        (for k being Integer st alen <= k holds a1.k = 0) &
        m <= j & j < i & i <= n &
        (for k being Integer st 0 <= k & k < m
          holds a.k = a1.k) &
        (for k being Integer st n + 1 <= k & k < alen
          holds a.k = a1.k) &
        (for v being Integer holds
          card {k where k is Integer :
            m <= k & k < n + 1 & a.k = v} =
          card {k where k is Integer :
            m <= k & k < n + 1 & a1.k = v}) &
        (for r being Integer st m <= r & r <= j
          holds ex x being Integer st x = a1.r & x <= 42) &
        (for r being Integer st j < r & r < i
          holds a1.r = 42) &
        (for r being Integer st i <= r & r <= n
          holds ex x being Integer st x = a1.r & 42 <= x)
      holds
        (0 <= n - m & j - m < n - m) &
        (0 <= m & m <= j & j < alen) &
        (for a2 being Function of INT,INT st
          (for k being Integer st k < 0 holds a2.k = a2.0) &
          (for k being Integer st alen <= k holds a2.k = 0) &
          (for k being Integer st 0 <= k & k < m
            holds a1.k = a2.k) &
          (for k being Integer st j + 1 <= k & k < alen
            holds a1.k = a2.k) &
          (for v being Integer holds
            card {k where k is Integer :
              m <= k & k < j + 1 & a1.k = v} =
            card {k where k is Integer :
              m <= k & k < j + 1 & a2.k = v}) &
          (for p,q being Integer st
            m <= p & p <= q & q < j + 1
           holds ex x,y being Integer st
             x = a2.p & y = a2.q & x <= y)
        holds
          (0 <= n - m & n - i < n - m) &
          (0 <= i & i <= n & n < alen) &
          (for a3 being Function of INT,INT st
            (for k being Integer st k < 0 holds a3.k = a3.0) &
            (for k being Integer st alen <= k holds a3.k = 0) &
            (for k being Integer st 0 <= k & k < i
              holds a2.k = a3.k) &
            (for k being Integer st n + 1 <= k & k < alen
              holds a2.k = a3.k) &
            (for v being Integer holds
              card {k where k is Integer :
                i <= k & k < n + 1 & a2.k = v} =
              card {k where k is Integer :
                i <= k & k < n + 1 & a3.k = v}) &
            (for p,q being Integer st
              i <= p & p <= q & q < n + 1
             holds ex x,y being Integer st
               x = a3.p & y = a3.q & x <= y)
          holds
            (for k being Integer st 0 <= k & k < m
              holds a.k = a3.k) &
            (for k being Integer st n + 1 <= k & k < alen
              holds a.k = a3.k) &
            (for v being Integer holds
              card {k where k is Integer :
                m <= k & k < n + 1 & a.k = v} =
              card {k where k is Integer :
                m <= k & k < n + 1 & a3.k = v}) &
            (for p,q being Integer st
              m <= p & p <= q & q < n + 1
             holds ex x,y being Integer st
               x = a3.p & y = a3.q & x <= y)))) &
    (not m < n implies
      (for k being Integer st 0 <= k & k < m
        holds a.k = a.k) &
      (for k being Integer st n + 1 <= k & k < alen
        holds a.k = a.k) &
      (for v being Integer holds
        card {k where k is Integer :
          m <= k & k < n + 1 & a.k = v} =
        card {k where k is Integer :
          m <= k & k < n + 1 & a.k = v}) &
      (for p,q being Integer st
        m <= p & p <= q & q < n + 1
       holds ex x,y being Integer st
         x = a.p & y = a.q & x <= y)))
proof
end;
::$P+
