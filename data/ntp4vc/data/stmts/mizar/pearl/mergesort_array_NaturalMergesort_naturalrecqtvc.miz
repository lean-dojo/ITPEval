:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_array_NaturalMergesort_naturalrecqtvc:
:: the natural mergesort recursion verification condition tracks sorted
:: runs, subarray permutations, preserved prefixes, and merge boundaries.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      nthElem being Function of [:E*,INT:],E,
      SortedSub being Subset of [:E*,[:INT,INT:]:],
      PermSub being Subset of [:E*,[:E*,[:INT,INT:]:]:],
      PermSubPrime being Subset of
        [:E*,[:E*,[:INT,INT:]:]:],
      lo being Integer,
      a,tmp being FinSequence of E,
      k being Integer
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for s being FinSequence of E, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (for s being FinSequence of E, l,u being Integer holds
       ([s,[l,u]] in SortedSub iff
         for i1,i2 being Integer st
           l <= i1 & i1 < i2 & i2 < u
         holds [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s,t being FinSequence of E, l,u being Integer holds
       ([s,[t,[l,u]]] in PermSub iff
         len s = len t &
         0 <= max(l,0) & max(l,0) <= len s &
         0 <= max(u,0) & max(u,0) <= len s &
         (for x being Element of E holds
           card {q where q is Integer :
             max(l,0) <= q & q < max(u,0) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(l,0) <= q & q < max(u,0) &
             nthElem.[t,q] = x}))) &
    (for s,t being FinSequence of E, l,u being Integer holds
       ([s,[t,[l,u]]] in PermSubPrime iff
         len s = len t &
         (for q being Integer st
            0 <= q & q < min(max(l,0),len s)
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for q being Integer st
            max(u,0) <= q & q < len s
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for x being Element of E holds
           card {q where q is Integer :
             max(l,0) <= q &
             q < min(max(u,0),len s) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(l,0) <= q &
             q < min(max(u,0),len t) &
             nthElem.[t,q] = x}))) &
    0 <= lo &
    lo <= len a &
    len a = len tmp &
    0 <= k
  holds
    for n being Integer st n = len a holds
      (n - 1 <= lo implies
        (n = len a or lo + k < n & n < len a) &
        [a,[lo,n]] in SortedSub &
        [a,[a,[lo,len a]]] in PermSubPrime) &
      ((not n - 1 <= lo) implies
        (0 <= lo & lo < len a) &
        (for o1 being Integer st
           (lo < o1 & o1 <= len a) &
           [a,[lo,o1]] in SortedSub &
           (o1 < len a implies
             not [nthElem.[a,o1-1],nthElem.[a,o1]]
               in Leq)
         holds
           (o1 = n implies
             (n = len a or lo + k < n & n < len a) &
             [a,[lo,n]] in SortedSub &
             [a,[a,[lo,len a]]] in PermSubPrime) &
           ((not o1 = n) implies
             for o2 being Integer st o2 = k - 1 holds
               (0 <= o2 + 1 implies
                 ((lo + 0 < o1 & o1 < n) &
                  [a,[lo,o1]] in SortedSub &
                  [a,[a,[lo,len a]]] in PermSubPrime) &
                 (for mid being Integer,
                      a1,tmp1 being FinSequence of E st
                    len a1 = len a &
                    len tmp1 = len tmp
                  holds
                    ((for i being Integer st
                        (0 <= i & i <= o2) &
                        (lo + i < mid & mid < n) &
                        [a1,[lo,mid]] in SortedSub &
                        [a,[a1,[lo,len a1]]]
                          in PermSubPrime &
                        (for j being Integer st
                           0 <= j & j < lo
                         holds
                           nthElem.[a1,j] = nthElem.[a,j])
                      holds
                        ((0 <= k & i < k) &
                         (0 <= mid & mid <= len a1 &
                          len a1 = len tmp1) &
                         0 <= i) &
                        (for a2,tmp2 being FinSequence of E st
                           len a2 = len a1 &
                           len tmp2 = len tmp1
                         holds
                           for hi being Integer st
                             (hi = len a2 or
                              mid + i < hi & hi < len a2) &
                             [a2,[mid,hi]] in SortedSub &
                             [a1,[a2,[mid,len a2]]]
                               in PermSubPrime &
                             (for j being Integer st
                                0 <= j & j < mid
                              holds
                                nthElem.[a2,j] =
                                  nthElem.[a1,j])
                           holds
                             ((0 <= lo & lo <= mid &
                               mid <= hi & hi <= len tmp2 &
                               len tmp2 = len a2) &
                              [a2,[lo,mid]] in SortedSub &
                              [a2,[mid,hi]] in SortedSub) &
                             (for a3 being FinSequence of E st
                                len a3 = len a2 &
                                [a3,[lo,hi]] in SortedSub &
                                [a2,[a3,[lo,hi]]]
                                  in PermSub &
                                (for i1 being Integer st
                                   (0 <= i1 & i1 < lo) or
                                   (hi <= i1 &
                                    i1 < len a3)
                                 holds
                                   nthElem.[a3,i1] =
                                     nthElem.[a2,i1])
                              holds
                                (hi = n implies
                                  (n = len a3 or
                                   lo + k < n &
                                   n < len a3) &
                                  [a3,[lo,n]] in SortedSub &
                                  [a,[a3,[lo,len a3]]]
                                    in PermSubPrime &
                                  (for j being Integer st
                                     0 <= j & j < lo
                                   holds
                                     nthElem.[a3,j] =
                                       nthElem.[a,j])) &
                                ((not hi = n) implies
                                  (lo + (i+1) < hi &
                                   hi < n) &
                                  [a3,[lo,hi]]
                                    in SortedSub &
                                  [a,[a3,[lo,len a3]]]
                                    in PermSubPrime &
                                  (for j being Integer st
                                     0 <= j & j < lo
                                   holds
                                     nthElem.[a3,j] =
                                       nthElem.[a,j])))) &
                     (((lo + (o2+1) < mid & mid < n) &
                       [a1,[lo,mid]] in SortedSub &
                       [a,[a1,[lo,len a1]]]
                         in PermSubPrime &
                       (for j being Integer st
                          0 <= j & j < lo
                        holds
                          nthElem.[a1,j] =
                            nthElem.[a,j]))
                      implies
                       (mid = len a1 or
                        lo + k < mid & mid < len a1) &
                       [a1,[lo,mid]] in SortedSub &
                       [a,[a1,[lo,len a1]]]
                         in PermSubPrime &
                       (for j being Integer st
                          0 <= j & j < lo
                        holds
                          nthElem.[a1,j] =
                            nthElem.[a,j])))) &
               (o2 + 1 < 0 implies
                 (o1 = len a or
                 lo + k < o1 & o1 < len a) &
                 [a,[lo,o1]] in SortedSub &
                 [a,[a,[lo,len a]]]
                   in PermSubPrime))))))
proof
end;
::$P+
