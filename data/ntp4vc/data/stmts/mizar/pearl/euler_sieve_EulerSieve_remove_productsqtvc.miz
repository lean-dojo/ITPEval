:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/euler_sieve_EulerSieve_remove_productsqtvc: the verification
:: condition for marking products and updating successor links in Euler's
:: sieve, with the loop bound given by integer quotient. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_2, NAT_1,
    NAT_3, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1, MARGREL1, XBOOLEAN, NEWTON, PBOOLE,
    PRE_POLY;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_2, NAT_1, NAT_D, NEWTON, XXREAL_0, FINSEQ_1, FINSEQ_2,
    PBOOLE, PRE_POLY, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_2, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, MARGREL1, NAT_D,
    NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_2, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, MARGREL1, XBOOLEAN,
    NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for BV63 being non empty Subset of INT,
      T being non empty set,
      nextsF being Function of T,INT*,
      markedF being Function of T,BOOLEAN*,
      maxF being Function of T,BV63,
      nthInt being Function of [:INT*,INT:],INT,
      nthBool being Function of [:BOOLEAN*,INT:],BOOLEAN,
      setInt being Function of [:INT*,[:INT,INT:]:],INT*,
      setBool being Function of
        [:BOOLEAN*,[:INT,BOOLEAN:]:],BOOLEAN*,
      PrimeInt being Subset of INT,
      InvNexts being Subset of [:INT*,INT:],
      AllEliminated being Subset of [:BOOLEAN*,INT*:],
      AllPrimes being Subset of [:BOOLEAN*,INT:],
      AllMultiples being Subset of [:BOOLEAN*,[:INT,INT:]:],
      PrevMarked being Subset of [:BOOLEAN*,INT:],
      OnlyMarked being Subset of [:BOOLEAN*,INT:],
      NotMarkedNext being Subset of
        [:BOOLEAN*,[:INT*,INT:]:],
      IsCopy being Subset of [:BOOLEAN*,BOOLEAN*:],
      AllElimPartial being Subset of
        [:BOOLEAN*,[:INT*,INT:]:],
      PrimeMarked being Subset of
        [:BOOLEAN*,[:BOOLEAN*,[:INT,INT:]:]:],
      NotMarkedNextPartial being Subset of
        [:BOOLEAN*,[:INT*,[:INT,INT:]:]:],
      InvRemove being Subset of
        [:INT*,[:BOOLEAN*,INT:]:],
      LoopInv being Subset of
        [:T,[:BOOLEAN*,[:INT,[:INT,[:INT,INT:]:]:]:]:],
      Final being Subset of [:T,[:BOOLEAN*,INT:]:],
      Result being Subset of [:T,INT:],
      GetNextPost being Subset of [:T,[:INT,INT:]:],
      SetNextPre being Subset of [:T,[:INT,INT:]:]
  st
    (for z being Integer holds
       (z in BV63 iff
         -(2 |^ 62) <= z &
         z <= (2 |^ 62)-1)) &
    (for xs being FinSequence of INT, i being Integer st
       0 <= i & i < len xs
     holds nthInt.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of INT, i being Integer st
       i < 0 & 0 < len xs
     holds nthInt.[xs,i] = xs.1) &
    (for xs being FinSequence of INT, i being Integer st
       len xs <= i or (i < 0 & len xs = 0)
     holds nthInt.[xs,i] = 0) &
    (for xs being FinSequence of BOOLEAN, i being Integer st
       0 <= i & i < len xs
     holds nthBool.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of BOOLEAN, i being Integer st
       i < 0 & 0 < len xs
     holds nthBool.[xs,i] = xs.1) &
    (for xs being FinSequence of BOOLEAN, i being Integer st
       len xs <= i or (i < 0 & len xs = 0)
     holds nthBool.[xs,i] = FALSE) &
    (for xs being FinSequence of INT, i,x being Integer holds
       len (setInt.[xs,[i,x]]) = len xs &
       ((i <= 0 & 0 < len xs) implies
         for q being Integer holds
           (q <= 0 implies
             nthInt.[setInt.[xs,[i,x]],q] = x) &
           (0 < q implies
             nthInt.[setInt.[xs,[i,x]],q] =
               nthInt.[xs,q])) &
       ((0 < i & i < len xs) implies
         for q being Integer holds
           (q = i implies
             nthInt.[setInt.[xs,[i,x]],q] = x) &
           (q <> i implies
             nthInt.[setInt.[xs,[i,x]],q] =
               nthInt.[xs,q])) &
       ((len xs = 0 or len xs <= i) implies
         setInt.[xs,[i,x]] = xs)) &
    (for bs being FinSequence of BOOLEAN,
         i being Integer, b being Element of BOOLEAN
     holds
       len (setBool.[bs,[i,b]]) = len bs &
       ((i <= 0 & 0 < len bs) implies
         for q being Integer holds
           (q <= 0 implies
             nthBool.[setBool.[bs,[i,b]],q] = b) &
           (0 < q implies
             nthBool.[setBool.[bs,[i,b]],q] =
               nthBool.[bs,q])) &
       ((0 < i & i < len bs) implies
         for q being Integer holds
           (q = i implies
             nthBool.[setBool.[bs,[i,b]],q] = b) &
           (q <> i implies
             nthBool.[setBool.[bs,[i,b]],q] =
               nthBool.[bs,q])) &
       ((len bs = 0 or len bs <= i) implies
         setBool.[bs,[i,b]] = bs)) &
    (for z being Integer holds
       (z in PrimeInt iff
         ex q being Nat st z = q & q is prime)) &
    (for xs being FinSequence of INT, n being Integer holds
       ([xs,n] in InvNexts iff
         for i being Integer st 0 <= i & i < n
         holds
           ex ni being Integer st
             ni = nthInt.[xs,i] & i < ni & ni <= n)) &
    (for bs being FinSequence of BOOLEAN,
         xs being FinSequence of INT
     holds
       ([bs,xs] in AllEliminated iff
         len bs = len xs &
         (for i being Integer st 0 <= i & i < len bs
          holds
            ex ni being Integer st
              ni = nthInt.[xs,i] &
              (for j being Integer st i < j & j < ni
               holds nthBool.[bs,j] = TRUE)))) &
    (for bs being FinSequence of BOOLEAN, n being Integer
     holds
       ([bs,n] in AllPrimes iff
         for i being Integer st 0 <= i & i < n
         holds
           (nthBool.[bs,i] <> TRUE iff i in PrimeInt))) &
    (for bs being FinSequence of BOOLEAN,
         i,m being Integer
     holds
       ([bs,[i,m]] in AllMultiples iff
         2 <= i & i < len bs &
         (for k being Integer st 2 <= k & k < m
          holds
            i*k < len bs implies
              nthBool.[bs,i*k] = TRUE))) &
    (for bs being FinSequence of BOOLEAN, n being Integer
     holds
       ([bs,n] in PrevMarked iff
         for i being Integer st 2 <= i & i < n
         holds [bs,[i,len bs]] in AllMultiples)) &
    (for bs being FinSequence of BOOLEAN, n being Integer
     holds
       ([bs,n] in OnlyMarked iff
         for k being Integer st
           2 <= k & k < len bs & nthBool.[bs,k] = TRUE
         holds
           ex i,j being Integer st
             2 <= i & i < n &
             2 <= j & j < len bs &
             i*j = k)) &
    (for bs being FinSequence of BOOLEAN,
         xs being FinSequence of INT, n being Integer
     holds
       ([bs,[xs,n]] in NotMarkedNext iff
         len bs = len xs &
         2 <= len bs &
         2 <= n &
     (for i,ni being Integer st
        2 <= i & i <= (len bs-1) div n &
        ni = nthInt.[xs,i] &
        ni <= (len bs-1) div n &
        nthBool.[bs,i] <> TRUE
      holds
        nthBool.[bs,ni] <> TRUE))) &
    (for bs,old being FinSequence of BOOLEAN holds
       ([bs,old] in IsCopy iff
         len bs = len old &
         (for i being Integer st
            0 <= i & i < len bs &
            nthBool.[bs,i] <> TRUE
          holds nthBool.[old,i] <> TRUE))) &
    (for old being FinSequence of BOOLEAN,
         xs being FinSequence of INT, m being Integer
     holds
       ([old,[xs,m]] in AllElimPartial iff
         len old = len xs &
         (for i being Integer st m <= i & i < len old
          holds
            ex ni being Integer st
              ni = nthInt.[xs,i] &
              (for j being Integer st i < j & j < ni
               holds nthBool.[old,j] = TRUE)))) &
    (for old,bs being FinSequence of BOOLEAN,
         n,m being Integer
     holds
       ([old,[bs,[n,m]]] in PrimeMarked iff
         len old = len bs &
         n < m & m <= len bs &
         (for i being Integer st
            n <= i & i < m &
            nthBool.[old,i] <> TRUE &
            n*i < len old
          holds nthBool.[bs,n*i] = TRUE))) &
    (for bs being FinSequence of BOOLEAN,
         xs being FinSequence of INT, n,p being Integer
     holds
       ([bs,[xs,[n,p]]] in NotMarkedNextPartial iff
         len bs = len xs &
         2 <= len bs &
         2 <= n &
         p <= (len bs-1) div n &
     (for i,ni being Integer st
        2 <= i & i < p &
        ni = nthInt.[xs,i] &
        ni <= (len bs-1) div n &
        nthBool.[bs,i] <> TRUE
      holds
        nthBool.[bs,ni] <> TRUE))) &
    (for xs being FinSequence of INT,
         bs being FinSequence of BOOLEAN, n being Integer
     holds
       ([xs,[bs,n]] in InvRemove iff
         len xs = len bs &
         nthBool.[bs,2] <> TRUE &
         [bs,n] in AllPrimes &
         n in PrimeInt &
         nthBool.[bs,n] <> TRUE &
         [xs,len xs] in InvNexts)) &
    (for self being Element of T holds
       maxF.self < (2 |^ 62)-1 &
       3 <= maxF.self &
       len (nextsF.self) = len (markedF.self) &
       len (markedF.self) = maxF.self+1 &
       [nextsF.self,len (nextsF.self)] in InvNexts &
       [markedF.self,nextsF.self] in AllEliminated &
       (for i being Integer st
          3 <= i & i <= maxF.self & i mod 2 = 0
        holds nthBool.[markedF.self,i] = TRUE) &
       (for i being Integer st
          3 <= i & i < maxF.self-1 & i mod 2 = 1
        holds
          nthInt.[nextsF.self,i] mod 2 = 1 or
          nthInt.[nextsF.self,i] = maxF.self+1) &
       nthInt.[nextsF.self,maxF.self] = maxF.self+1 &
       ((maxF.self-1) mod 2 = 0 implies
         nthInt.[nextsF.self,maxF.self-1] = maxF.self) &
       ((maxF.self-1) mod 2 = 1 implies
         nthInt.[nextsF.self,maxF.self-1] =
           maxF.self+1)) &
    (for s being Element of T,
         old being FinSequence of BOOLEAN,
         n,p,x,m being Integer
     holds
       ([s,[old,[n,[p,[x,m]]]]] in LoopInv iff
         n <= p & p <= m &
         3 <= n & n <= m &
         p mod 2 = 1 &
         p <= x & x < nthInt.[nextsF.s,p] &
         nthInt.[nextsF.s,x] = nthInt.[nextsF.s,p] &
         nthBool.[markedF.s,n*n] = TRUE &
         [nextsF.s,[markedF.s,n]] in InvRemove &
         [markedF.s,n] in PrevMarked &
         nthBool.[markedF.s,p] <> TRUE &
         [markedF.s,old] in IsCopy &
         [old,[nextsF.s,x]] in AllElimPartial &
         [old,[nextsF.s,n]] in NotMarkedNext &
         [old,[markedF.s,
           [n,nthInt.[nextsF.s,x]]]] in PrimeMarked &
         [markedF.s,[nextsF.s,[n,p]]]
           in NotMarkedNextPartial &
         [markedF.s,n+1] in OnlyMarked)) &
    (for s being Element of T,
         old being FinSequence of BOOLEAN,
         n being Integer
     holds
       ([s,[old,n]] in Final iff
         [nextsF.s,[markedF.s,n]] in InvRemove &
         [markedF.s,[nextsF.s,
           nthInt.[nextsF.s,n]]] in NotMarkedNext &
         [markedF.s,old] in IsCopy &
         [markedF.s,n] in PrevMarked &
         [old,[markedF.s,[n,len (markedF.s)]]]
           in PrimeMarked &
         [markedF.s,n+1] in OnlyMarked)) &
    (for s being Element of T, n being Integer holds
       ([s,n] in Result iff
         [nextsF.s,[markedF.s,n]] in InvRemove &
         [markedF.s,[nextsF.s,
           nthInt.[nextsF.s,n]]] in NotMarkedNext &
         [markedF.s,nthInt.[nextsF.s,n]] in PrevMarked &
         [markedF.s,nthInt.[nextsF.s,n]] in OnlyMarked)) &
    (for s being Element of T, p,q being Integer holds
       ([s,[p,q]] in GetNextPost iff
         3 <= q & q <= maxF.s+1 &
         q = nthInt.[nextsF.s,p] &
         (q mod 2 = 1 or q = maxF.s+1))) &
    (for s being Element of T, p,q being Integer holds
       ([s,[p,q]] in SetNextPre iff
         0 <= p & p <= maxF.s &
         p < q & q <= maxF.s+1 &
         p mod 2 = 1 &
         (for j being Integer st p < j & j < q
          holds nthBool.[markedF.s,j] = TRUE) &
         nthBool.[markedF.s,p] <> TRUE &
         (q mod 2 = 1 or q = maxF.s+1)))
  holds
    for n being Element of BV63, t1 being Element of T st
      3 <= n &
      n <= maxF.t1 &
      n*n <= maxF.t1 &
      [nextsF.t1,[markedF.t1,n]] in InvRemove &
      [markedF.t1,n] in PrevMarked &
      [markedF.t1,n] in OnlyMarked &
      [markedF.t1,[nextsF.t1,n]] in NotMarkedNext
    holds
      2 <= maxF.t1 implies
        n <> 0 &
        maxF.t1 div n in BV63 &
        (for d being Element of BV63 st
           d = maxF.t1 div n
         holds
           (for t2 being Element of T st
              maxF.t2 = maxF.t1
            holds
              for p being Element of BV63,
                  x being Integer st
                [t2,[markedF.t1,
                  [n,[p,[x,maxF.t1]]]]] in LoopInv
              holds
                (3 <= p & p <= maxF.t2 &
                 p mod 2 = 1) &
                (for nx being Element of BV63 st
                   [t2,[p,nx]] in GetNextPost
                 holds
                   for o2 being Element of BOOLEAN st
                     ((0 <= nx &
                       2 <= maxF.t2 &
                       ((nx <= maxF.t2 & o2 = TRUE) or
                        (maxF.t2 < nx & o2 = FALSE))) or
                      (nx < 0 & o2 = FALSE))
                   holds
                     ((o2 = TRUE & nx <= d) implies
                       n*nx in BV63 &
                       (for o3 being Element of BV63 st
                          o3 = n*nx
                        holds
                          0 <= o3 & o3 <= maxF.t2 &
                          o3 mod 2 = 1 &
                          (for t3 being Element of T st
                             nextsF.t3 = nextsF.t2 &
                             maxF.t3 = maxF.t2 &
                             markedF.t3 =
                               setBool.[markedF.t2,[o3,TRUE]]
                           holds
                             0 <= nx & nx <= maxF.t3 &
                             nx mod 2 = 1 &
                             ((nthBool.[markedF.t3,nx] = TRUE)
                               implies
                               3 <= nx & nx <= maxF.t3 &
                               nx mod 2 = 1 &
                               (for o4 being Element of BV63 st
                                  [t3,[nx,o4]]
                                    in GetNextPost
                                holds
                                  [t3,[p,o4]]
                                    in SetNextPre &
                                  (for t4 being Element of T st
                                     markedF.t4 = markedF.t3 &
                                     maxF.t4 = maxF.t3 &
                                     nextsF.t4 =
                                       setInt.[nextsF.t3,[p,o4]]
                                   holds
                                     0 <= maxF.t1 -
                                       nthInt.[nextsF.t2,p] &
                                     maxF.t1 -
                                       nthInt.[nextsF.t4,p] <
                                       maxF.t1 -
                                       nthInt.[nextsF.t2,p] &
                                     [t4,[markedF.t1,
                                       [n,[p,[nx,maxF.t1]]]]]
                                         in LoopInv))) &
                             ((nthBool.[markedF.t3,nx] <> TRUE)
                               implies
                               0 <= maxF.t1 -
                                 nthInt.[nextsF.t2,p] &
                               maxF.t1 -
                                 nthInt.[nextsF.t3,nx] <
                                 maxF.t1 -
                                 nthInt.[nextsF.t2,p] &
                               [t3,[markedF.t1,
                                 [n,[nx,[nx,maxF.t1]]]]]
                                   in LoopInv)))) &
                      ((o2 = TRUE & d < nx) implies
                        [t2,[markedF.t1,n]] in Final) &
                      (o2 <> TRUE implies
                        [t2,[markedF.t1,n]] in Final))) &
           n*n in BV63 &
           (for o2 being Element of BV63 st o2 = n*n
            holds
              0 <= o2 & o2 <= maxF.t1 &
              o2 mod 2 = 1 &
              (for t2 being Element of T st
                 nextsF.t2 = nextsF.t1 &
                 maxF.t2 = maxF.t1 &
                 markedF.t2 =
                   setBool.[markedF.t1,[o2,TRUE]]
               holds
                 [t2,[markedF.t1,
                   [n,[n,[n,maxF.t1]]]]] in LoopInv &
                 (for t3 being Element of T st
                    maxF.t3 = maxF.t2 &
                    [t3,[markedF.t1,n]] in Final
                  holds [t3,n] in Result))))
proof
end;
::$P+
