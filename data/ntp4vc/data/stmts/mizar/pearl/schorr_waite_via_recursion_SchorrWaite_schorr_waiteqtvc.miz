:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/schorr_waite_via_recursion_SchorrWaite_schorr_waiteqtvc:
:: the recursive Schorr-Waite graph-marking verification condition,
:: including body transitions, recursive traversal, loop invariants,
:: pointer restoration, coloring, and termination variants.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L,C being non empty set,
      graph being finite Subset of L,
      null,root being Element of L,
      white,blackNone being Element of C,
      blackSome being Function of INT,C,
      block being Function of L,INT,
      accessor0 being Function of [:L,INT:],L,
      colors0 being Function of L,C,
      Path,Reach,WellColored,Unchanged,
      BodyPre,BodyPost,BodyRaises,BodyNormal,
      AuxPre,AuxPost,Variant,LoopInv,FinishVC,LoopVC,
      AuxCode,BodyImpl,AuxImpl,FinalPost,MainVC being set
  st
    white <> blackNone &
    (for i being Integer holds
       white <> blackSome.i & blackNone <> blackSome.i) &
    (for i,j being Integer st blackSome.i = blackSome.j holds i = j) &
    (for d being Element of C holds
       d = white or d = blackNone or
       ex i being Integer st d = blackSome.i) &

    (for b being Function of L,INT,
         a being Function of [:L,INT:],L,
         x,y being Element of L,
         q being FinSequence of L
     holds
       ([b,[a,[x,[q,y]]]] in Path iff
          (q = <*>L & x = y) or
          ex z being Element of L,
             q1 being FinSequence of L,
             n being Integer st
            q = <*x*> ^ q1 &
            x <> null &
            0 <= n & n < b.x &
            a.[x,n] = z &
            [b,[a,[z,[q1,y]]]] in Path)) &

    (for b being Function of L,INT,
         a being Function of [:L,INT:],L,
         x,y being Element of L
     holds
       ([b,[a,[x,y]]] in Reach iff
          ex q being FinSequence of L st
            [b,[a,[x,[q,y]]]] in Path)) &

    (for g,h being finite Subset of L,
         b being Function of L,INT,
         a being Function of [:L,INT:],L,
         c being Function of L,C
     holds
       ([g,[h,[b,[a,c]]]] in WellColored iff
          h c= g &
          (for x,y being Element of L st
             x in g & x <> null & y <> null & c.x <> white &
             (ex n being Integer st
                0 <= n & n < b.x & a.[x,n] = y)
           holds x in h or c.y <> white) &
          (for x being Element of L st x in h
           holds c.x <> white))) &

    (for b being Function of L,INT,
         a1,a2 being Function of [:L,INT:],L
     holds
       ([b,[a1,a2]] in Unchanged iff
          for x being Element of L, n being Integer st
            x <> null & 0 <= n & n < b.x
          holds a2.[x,n] = a1.[x,n])) &

    (for b being Function of L,INT,
         c being Function of L,C,
         p,t being Element of L
     holds
       ([b,[c,[p,t]]] in BodyPre iff
          (p <> null & (t = null or c.t <> white) implies
             ex m being Integer st
               c.p = blackSome.m & 0 <= m & m < b.p))) &

    (for b being Function of L,INT,
         a,a2 being Function of [:L,INT:],L,
         c,c2 being Function of L,C,
         p,t,p2,t2 being Element of L
     holds
       ([b,[a,[c,[p,[t,[a2,[c2,[p2,t2]]]]]]]] in BodyPost iff
          (p <> null or (t <> null & c.t = white)) &
          (t <> null & c.t = white & b.t = 0 implies
             c2 = c+*(t,blackNone) &
             t2 = t & p2 = p & a2 = a) &
          (t <> null & c.t = white & 0 < b.t implies
             c2 = c+*(t,blackSome.0) &
             t2 = a.[t,0] & p2 = t &
             a2 = a+*([t,0],p)) &
          (t = null or c.t <> white implies
             ex m,n being Integer st
               c.p = blackSome.m & n = m+1 &
               ((n = b.p &
                  t2 = p & p2 = a.[p,m] &
                  c2 = c & a2 = a+*([p,m],t)) or
                (n <> b.p &
                  p2 = p & t2 = a.[p,n] &
                  c2 = c+*(p,blackSome.n) &
                  a2 = (a+*([p,n],a.[p,m]))+*([p,m],t)))))) &

    (for c being Function of L,C,
         p,t being Element of L
     holds
       ([c,[p,t]] in BodyRaises iff
          p = null & (t = null or c.t <> white))) &

    (for b being Function of L,INT,
         a,a2 being Function of [:L,INT:],L,
         c,c2 being Function of L,C,
         p,t,p2,t2 being Element of L
     holds
       ([b,[a,[c,[p,[t,[a2,[c2,[p2,t2]]]]]]]] in BodyNormal iff
          not [c,[p,t]] in BodyRaises &
          [b,[c,[p,t]]] in BodyPre &
          (t = null or c.t <> white implies
             p <> null &
             ex m being Integer st
               c.p = blackSome.m & 0 <= m & m < b.p) &
          (t <> null & c.t = white implies 0 <= b.t) &
          [b,[a,[c,[p,[t,[a2,[c2,[p2,t2]]]]]]]] in BodyPost)) &

    (for g,h being finite Subset of L,
         b being Function of L,INT,
         a0,a being Function of [:L,INT:],L,
         c being Function of L,C,
         t being Element of L
     holds
       ([g,[h,[b,[a0,[a,[c,t]]]]]] in AuxPre iff
          [g,[h,[b,[a0,c]]]] in WellColored &
          t in g &
          (for x being Element of L, n being Integer st
             x <> null & c.x = white & 0 <= n & n < b.x
           holds a.[x,n] = a0.[x,n]))) &

    (for g,h being finite Subset of L,
         b being Function of L,INT,
         a0,a,a2 being Function of [:L,INT:],L,
         c,c2 being Function of L,C,
         p,t,p2,t2 being Element of L
     holds
       ([g,[h,[b,[a0,[a,[c,[p,[t,
         [a2,[c2,[p2,t2]]]]]]]]]]] in AuxPost iff
          t2 = t & p2 = p &
          [b,[a,a2]] in Unchanged &
          [g,[h,[b,[a0,c2]]]] in WellColored &
          (c2.t2 <> white or t2 = null) &
          (for x being Element of L st x <> null holds
             (not [b,[a0,[t2,x]]] in Reach or c.x <> white)
             implies c2.x = c.x))) &

    (for g,h,k being finite Subset of L
     holds
       ([g,[h,k]] in Variant iff
          card h <= card g & card h < card k)) &

    (for g,k being finite Subset of L,
         b being Function of L,INT,
         a0,ae,a being Function of [:L,INT:],L,
         ce,c being Function of L,C,
         pe,te,p,t being Element of L,
         s,i being Integer
     holds
       ([g,[k,[b,[a0,[ae,[ce,[pe,[te,[s,[i,
         [a,[c,[p,t]]]]]]]]]]]]] in LoopInv iff
          [g,[k,[b,[a0,c]]]] in WellColored &
          p = te & t = a0.[p,i] & c.p = blackSome.i &
          (for j being Integer st 0 <= j & j < s & j <> i
           holds a.[p,j] = ae.[p,j]) &
          a.[p,i] = pe &
          (for l being Element of L, n being Integer st
             l <> null & l <> p & 0 <= n & n < b.l
           holds a.[l,n] = ae.[l,n]) &
          (for j being Integer st 0 <= j & j < i holds
             a.[p,j] = null or c.(a.[p,j]) <> white) &
          (for l being Element of L st l <> null holds
             (not [b,[a0,[p,l]]] in Reach or ce.l <> white)
             implies c.l = ce.l))) &

    (for g,h,k being finite Subset of L,
         b being Function of L,INT,
         a0,ae,a being Function of [:L,INT:],L,
         ce,c being Function of L,C,
         pe,te,p,t being Element of L
     holds
       ([g,[h,[k,[b,[a0,[ae,[ce,[pe,[te,
         [a,[c,[p,t]]]]]]]]]]]] in FinishVC iff
          [g,[h,k]] in Variant &
          [g,[k,[b,[a0,[a,[c,t]]]]]] in AuxPre &
          (for a1 being Function of [:L,INT:],L,
               c1 being Function of L,C st
             [g,[k,[b,[a0,[a,[c,[p,[t,
               [a1,[c1,[p,t]]]]]]]]]]] in AuxPost
           holds
             [b,[c1,[p,t]]] in BodyPre &
             not [c1,[p,t]] in BodyRaises &
             ex a2 being Function of [:L,INT:],L,
                c2 being Function of L,C,
                p2,t2 being Element of L st
               [b,[a1,[c1,[p,[t,
                 [a2,[c2,[p2,t2]]]]]]]] in BodyNormal &
               p2 = pe & t2 = te &
               [g,[h,[b,[a0,[ae,[ce,[pe,[te,
                 [a2,[c2,[p2,t2]]]]]]]]]]] in AuxPost))) &

    (for g,h,k being finite Subset of L,
         b being Function of L,INT,
         a0,ae,af being Function of [:L,INT:],L,
         ce,cf being Function of L,C,
         pe,te,pf,tf being Element of L,
         s being Integer
     holds
       ([g,[h,[k,[b,[a0,[ae,[ce,[pe,[te,[s,
         [af,[cf,[pf,tf]]]]]]]]]]]]] in LoopVC iff
          (0 <= s-1 implies
             [g,[k,[b,[a0,[ae,[ce,[pe,[te,[s,[0,
               [af,[cf,[pf,tf]]]]]]]]]]]]] in LoopInv) &
          (for a being Function of [:L,INT:],L,
               c being Function of L,C,
               p,t being Element of L,
               i being Integer st
             0 <= i & i <= s-2 &
             [g,[k,[b,[a0,[ae,[ce,[pe,[te,[s,[i,
               [a,[c,[p,t]]]]]]]]]]]]] in LoopInv
           holds
             [g,[h,k]] in Variant &
             [g,[k,[b,[a0,[a,[c,t]]]]]] in AuxPre &
             (for a1 being Function of [:L,INT:],L,
                  c1 being Function of L,C st
                [g,[k,[b,[a0,[a,[c,[p,[t,
                  [a1,[c1,[p,t]]]]]]]]]]] in AuxPost
              holds
                [b,[c1,[p,t]]] in BodyPre &
                not [c1,[p,t]] in BodyRaises &
                ex a2 being Function of [:L,INT:],L,
                   c2 being Function of L,C,
                   p2,t2 being Element of L st
                  [b,[a1,[c1,[p,[t,
                    [a2,[c2,[p2,t2]]]]]]]] in BodyNormal &
                  [g,[k,[b,[a0,[ae,[ce,[pe,[te,[s,[i+1,
                    [a2,[c2,[p2,t2]]]]]]]]]]]]] in LoopInv)) &
          (for a being Function of [:L,INT:],L,
               c being Function of L,C,
               p,t being Element of L st
             [g,[k,[b,[a0,[ae,[ce,[pe,[te,[s,[s-1,
               [a,[c,[p,t]]]]]]]]]]]]] in LoopInv
           holds
             [g,[h,[k,[b,[a0,[ae,[ce,[pe,[te,
               [a,[c,[p,t]]]]]]]]]]]] in FinishVC) &
          (s-1 < 0 implies
             [g,[h,[k,[b,[a0,[ae,[ce,[pe,[te,
               [af,[cf,[pf,tf]]]]]]]]]]]] in FinishVC))) &

    (for g,h being finite Subset of L,
         b being Function of L,INT,
         a0,a being Function of [:L,INT:],L,
         c being Function of L,C,
         p,t being Element of L
     holds
       ([g,[h,[b,[a0,[a,[c,[p,t]]]]]]] in AuxCode iff
          ((t = null or c.t <> white) &
             [g,[h,[b,[a0,[a,[c,[p,[t,
               [a,[c,[p,t]]]]]]]]]]] in AuxPost) or
          (t <> null & c.t = white &
             (0 <= b.t implies
                [b,[c,[p,t]]] in BodyPre &
                not [c,[p,t]] in BodyRaises &
                ex a1 being Function of [:L,INT:],L,
                   c1 being Function of L,C,
                   p1,t1 being Element of L st
                  [b,[a,[c,[p,[t,
                    [a1,[c1,[p1,t1]]]]]]]] in BodyNormal &
                  ((b.t <> 0 &
                     [g,[h,[h \/ {t},[b,[a0,[a,[c,[p,[t,[b.t,
                       [a1,[c1,[p1,t1]]]]]]]]]]]]] in LoopVC) or
                   (b.t = 0 &
                     [g,[h,[b,[a0,[a,[c,[p,[t,
                       [a1,[c1,[p1,t1]]]]]]]]]]] in AuxPost)))))) &

    (for b being Function of L,INT,
         a0 being Function of [:L,INT:],L,
         c0 being Function of L,C
     holds
       ([b,[a0,c0]] in BodyImpl iff
          for a being Function of [:L,INT:],L,
              c being Function of L,C,
              p,t being Element of L st
            [b,[c,[p,t]]] in BodyPre
          holds
            [c,[p,t]] in BodyRaises or
            ((t = null or c.t <> white) &
              p <> null &
              (for m being Integer st
                 c.p = blackSome.m & 0 <= m & m < b.p
               holds
                 (m+1 = b.p implies
                   for a2 being Function of [:L,INT:],L,
                       c2 being Function of L,C,
                       p2,t2 being Element of L st
                     a2 = a+*([p,m],t) &
                     c2 = c & p2 = a.[p,m] & t2 = p
                   holds
                     [b,[a,[c,[p,[t,
                       [a2,[c2,[p2,t2]]]]]]]] in BodyNormal) &
                 (m+1 <> b.p implies
                   0 <= m+1 & m+1 < b.p &
                   for a2 being Function of [:L,INT:],L,
                       c2 being Function of L,C,
                       p2,t2 being Element of L st
                     a2 = (a+*([p,m+1],a.[p,m]))+*([p,m],t) &
                     c2 = c+*(p,blackSome.(m+1)) &
                     p2 = p & t2 = a.[p,m+1]
                   holds
                     [b,[a,[c,[p,[t,
                       [a2,[c2,[p2,t2]]]]]]]] in BodyNormal))) or
            (t <> null & c.t = white &
              (0 <= b.t implies
                (b.t = 0 implies
                  for a2 being Function of [:L,INT:],L,
                      c2 being Function of L,C,
                      p2,t2 being Element of L st
                    a2 = a & c2 = c+*(t,blackNone) &
                    p2 = p & t2 = t
                  holds
                    [b,[a,[c,[p,[t,
                      [a2,[c2,[p2,t2]]]]]]]] in BodyNormal) &
                (b.t <> 0 implies
                  0 < b.t &
                  for a2 being Function of [:L,INT:],L,
                      c2 being Function of L,C,
                      p2,t2 being Element of L st
                    a2 = a+*([t,0],p) &
                    c2 = c+*(t,blackSome.0) &
                    p2 = t & t2 = a.[t,0]
                  holds
                    [b,[a,[c,[p,[t,
                      [a2,[c2,[p2,t2]]]]]]]] in BodyNormal))))) &

    (for g being finite Subset of L,
         b being Function of L,INT,
         a0 being Function of [:L,INT:],L,
         c0 being Function of L,C
     holds
       ([g,[b,[a0,c0]]] in AuxImpl iff
          for h being finite Subset of L,
              a being Function of [:L,INT:],L,
              c being Function of L,C,
              p,t being Element of L st
            [g,[h,[b,[a0,[a,[c,t]]]]]] in AuxPre
          holds [g,[h,[b,[a0,[a,[c,[p,t]]]]]]] in AuxCode)) &

    (for r being Element of L,
         b being Function of L,INT,
         a0,a being Function of [:L,INT:],L,
         c0,c being Function of L,C
     holds
       ([r,[b,[a0,[c0,[a,c]]]]] in FinalPost iff
          [b,[a0,a]] in Unchanged &
          (for x being Element of L st
             [b,[a0,[r,x]]] in Reach & x <> null
           holds c.x <> white) &
          (for x being Element of L st
             not [b,[a0,[r,x]]] in Reach & x <> null
           holds c.x = c0.x))) &

    (for r being Element of L,
         g being finite Subset of L,
         b being Function of L,INT,
         a0 being Function of [:L,INT:],L,
         c0 being Function of L,C
     holds
       ([r,[g,[b,[a0,c0]]]] in MainVC iff
          [g,[{},[b,[a0,[a0,[c0,r]]]]]] in AuxPre &
          (for a being Function of [:L,INT:],L,
               c being Function of L,C st
             [g,[{},[b,[a0,[a0,[c0,[null,[r,
               [a,[c,[null,r]]]]]]]]]]] in AuxPost
           holds
             [b,[c,[null,r]]] in BodyPre &
             [c,[null,r]] in BodyRaises &
             [r,[b,[a0,[c0,[a,c]]]]] in FinalPost))) &

    root in graph &
    (for l being Element of L, n being Integer st
       l in graph & l <> null & 0 <= n & n < block.l
     holds accessor0.[l,n] in graph) &
    (for x being Element of L st x in graph
     holds colors0.x = white)
  holds
    [block,[accessor0,colors0]] in BodyImpl &
    [graph,[block,[accessor0,colors0]]] in AuxImpl &
    [root,[graph,[block,[accessor0,colors0]]]] in MainVC
proof
end;
::$P+
