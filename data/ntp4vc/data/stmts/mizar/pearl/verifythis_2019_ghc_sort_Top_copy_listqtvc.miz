:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2019_ghc_sort_Top_copy_listqtvc: the verification
:: condition for copying an integer list into an integer-array suffix while
:: preserving copied values, the untouched prefix, and occurrence counts.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4, FUNCOP_1,
    FUNCT_7, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2,
    FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for alen,s being Integer,
      l being FinSequence of INT,
      a being Function of INT,INT
  st
    0 <= alen &
    0 <= s &
    len l = alen - s
  holds
    (l = <*>INT implies
      (for x being Integer st s <= x & x < alen
       holds a.x = l.(x-s+1)) &
      (for x being Integer holds
        card {q where q is Integer :
          s <= q & q < alen & a.q = x} =
        card {q where q is Integer :
          0 <= q & q < len l & l.(q+1) = x})) &
    (for h being Integer,
         t being FinSequence of INT st l = <*h*> ^ t
     holds
       (0 <= s & s < alen) &
       ((l = <*h*> ^ t &
         0 <= s+1 &
         len t = alen-(s+1)) &
        (for a1 being Function of INT,INT st
           (for x being Integer st s+1 <= x & x < alen
            holds a1.x = t.(x-(s+1)+1)) &
           (for x being Integer st 0 <= x & x < s+1
            holds a1.x = (a+*(s,h)).x) &
           (for x being Integer holds
             card {q where q is Integer :
               s+1 <= q & q < alen & a1.q = x} =
             card {q where q is Integer :
               0 <= q & q < len t & t.(q+1) = x})
         holds
           (for x being Integer st s <= x & x < alen
            holds a1.x = l.(x-s+1)) &
           (for x being Integer st 0 <= x & x < s
            holds a1.x = a.x) &
           (for x being Integer holds
             card {q where q is Integer :
               s <= q & q < alen & a1.q = x} =
             card {q where q is Integer :
               0 <= q & q < len l & l.(q+1) = x}))))
proof
end;
::$P+
