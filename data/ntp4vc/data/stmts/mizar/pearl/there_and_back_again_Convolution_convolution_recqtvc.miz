:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/there_and_back_again_Convolution_convolution_recqtvc: the recursive
:: convolution verification condition preserves a list decomposition and
:: pairs the first list with the reversal of the consumed prefix.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      ORDINAL4, FINSEQ_1, FINSEQ_2, FINSEQ_5, FUNCT_3, EUCLID_7, MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, FUNCT_3, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1,
      CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      FINSEQ_1, FINSEQ_2, FINSEQ_5;
 constructors FUNCT_1, FUNCT_3, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
      REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, FINSEQ_1,
      FINSEQ_2, FINSEQ_5, EUCLID_7;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
      XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
      EUCLID_7;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for D being non empty set,
      x, y being FinSequence of D st
    len x <= len y
  holds
    (x = <*>D or
      ex x0 being Element of D,
         xs being FinSequence of D st
        x = <*x0*> ^ xs &
        len xs <= len y &
        (for o1 being FinSequence of [:D,D:],
             o2 being FinSequence of D st
          (ex y0 being FinSequence of D st
            y = y0 ^ o2 &
            len y0 = len xs &
            o1 = <:xs,Rev y0:>)
         holds
          ex x1 being Element of D,
             x2 being FinSequence of D st
            o2 = <*x1*> ^ x2)) &
    (for r being FinSequence of [:D,D:],
         ys being FinSequence of D st
      ((x = <*>D &
        r = <*>([:D,D:]) &
        ys = y) or
       (ex x0 being Element of D,
           xs being FinSequence of D,
           r1 being FinSequence of [:D,D:],
           ys1 being FinSequence of D st
          x = <*x0*> ^ xs &
          (ex y0 being FinSequence of D st
            y = y0 ^ ys1 &
            len y0 = len xs &
            r1 = <:xs,Rev y0:>) &
          (ex x1 being Element of D,
              x2 being FinSequence of D st
            ys1 = <*x1*> ^ x2 &
            r = <*[x0,x1]*> ^ r1 &
            ys = x2)))
     holds
      ex y0 being FinSequence of D st
        y = y0 ^ ys &
        len y0 = len x &
        r = <:x,Rev y0:>)
proof
end;
::$P+
