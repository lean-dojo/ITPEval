:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bitcount_Hamming_hammingDqtvc: the 32-bit Hamming-distance
:: verification condition equates the population count of the bitwise XOR
:: with the number of bit positions at which two words differ. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1,
    FUNCT_1, FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1, NEWTON, FINSET_1,
    MARGREL1, XBOOLEAN, BVFUNC_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON,
    RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2,
    NAT_1, NAT_D, FINSET_1, MARGREL1, XBOOLEAN, BVFUNC_1;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS,
    RVSUM_1, FINSEQOP, FUNCT_2, FINSET_1, MARGREL1, BVFUNC_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1, MEMBERED, FRAENKEL, FINSET_1, MARGREL1, BVFUNC_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for result being Nat,
      a,b being Function of Segm 32,BOOLEAN st
    result < 2 |^ 32 &
    result = card {i where i is Element of Segm 32 :
      (a 'xor' b).i = TRUE}
  holds
    result = card {i where i is Element of Segm 32 :
      a.i <> b.i}
proof
end;
::$P+
