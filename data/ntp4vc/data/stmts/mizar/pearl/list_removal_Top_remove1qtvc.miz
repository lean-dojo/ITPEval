:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/list_removal_Top_remove1qtvc: the linked-list removal verification
:: condition advances through a list and reconnects the predecessor or head
:: around the removed entry. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being non empty set,
      null,head,entry being Element of L,
      ListRel being
        Subset of [:Funcs(L,L),[:L,[:INT,L:]:]:]
  st
    head <> null &
    entry <> null &
    head <> entry &
    (for n being Integer,
         f being Function of L,L,
         x,y being Element of L st 0 <= n
     holds
       ([f,[x,[n,y]]] in ListRel iff
         (n = 0 & x = y) or
         (n <> 0 & x <> null &
          [f,[f.x,[n-1,y]]] in ListRel)))
  holds
    for n1,n2 being Integer,
        mem1 being Function of L,L st
      0 < n1 &
      0 < n2 &
      [mem1,[head,[n1,entry]]] in ListRel &
      [mem1,[entry,[n2,null]]] in ListRel
    holds
      head <> null &
      ((0 < 1 & 1 <= n1) &
       [mem1,[head,[1,mem1.head]]] in ListRel &
       mem1.head <> null &
       [mem1,[mem1.head,[n1-1,entry]]] in ListRel &
       [mem1,[entry,[n2,null]]] in ListRel) &
      (for n being Integer,
           curr,prev being Element of L st
         (0 < n & n <= n1) &
         [mem1,[head,[n,curr]]] in ListRel &
         curr <> null &
         (prev = null implies n = 1) &
         (prev <> null implies mem1.prev = curr) &
         (prev <> null implies
            [mem1,[head,[n-1,prev]]] in ListRel) &
         [mem1,[curr,[n1-n,entry]]] in ListRel &
         [mem1,[entry,[n2,null]]] in ListRel
       holds
         (curr <> entry &
          curr <> null &
          (0 <= n1-n & n1-(n+1) < n1-n) &
          (0 < n+1 & n+1 <= n1) &
          [mem1,[head,[n+1,mem1.curr]]] in ListRel &
          mem1.curr <> null &
          (curr = null implies n+1 = 1) &
          (curr <> null implies curr = curr) &
          (curr <> null implies
             [mem1,[head,[n+1-1,curr]]] in ListRel) &
          [mem1,[mem1.curr,[n1-(n+1),entry]]] in ListRel &
          [mem1,[entry,[n2,null]]] in ListRel) or
         (curr = entry &
          ((prev = null &
            curr <> null &
            head <> null &
            [mem1+*(head,mem1.curr),
              [head,[n1+n2-1,null]]] in ListRel) or
           (prev <> null &
            curr <> null &
            prev <> null &
            [mem1+*(prev,mem1.curr),
              [head,[n1+n2-1,null]]] in ListRel))))
proof
end;
::$P+
