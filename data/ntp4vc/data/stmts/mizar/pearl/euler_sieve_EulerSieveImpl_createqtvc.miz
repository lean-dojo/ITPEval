:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/euler_sieve_EulerSieveImpl_createqtvc: the creation verification
:: condition for initializing the marked, successor, and compressed-array
:: representation used by an Euler sieve. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1, MARGREL1, XBOOLEAN, NEWTON, PBOOLE,
    PRE_POLY;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, NAT_D, NEWTON, XXREAL_0, FINSEQ_1, FINSEQ_2,
    PBOOLE, PRE_POLY, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, MARGREL1, NAT_D,
    NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, MARGREL1, XBOOLEAN,
    NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for BV63 being non empty Subset of INT,
      A,T being non empty set,
      elts being Function of A,INT*,
      size being Function of A,INT,
      nextsF being Function of T,INT*,
      markedF being Function of T,BOOLEAN*,
      arrF being Function of T,A,
      maxF,maxArrF being Function of T,BV63,
      nthInt being Function of [:INT*,INT:],INT,
      nthBool being Function of [:BOOLEAN*,INT:],BOOLEAN,
      setInt being Function of [:INT*,[:INT,INT:]:],INT*,
      Abs being Function of INT,INT,
      InvNexts being Subset of [:INT*,INT:],
      AllEliminated being Subset of [:BOOLEAN*,INT*:],
      CoreInv being Subset of
        [:BV63,[:INT*,[:BOOLEAN*,[:INT*,BV63:]:]:]:],
      Post being Subset of T,
      Finish being Subset of [:BV63,[:INT*,[:BOOLEAN*,A:]:]:],
      fc being Function of [:BV63,INT:],INT,
      o1 being Function of INT,BOOLEAN,
      fc1 being Function of [:BV63,[:BV63,INT:]:],INT
  st
    (for z being Integer holds
       (z in BV63 iff
         -(2 |^ 62) <= z &
         z <= (2 |^ 62)-1)) &
    (for xs being FinSequence of INT, i being Integer st
       0 <= i & i < len xs
     holds nthInt.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of INT, i being Integer st
       i < 0 & 0 < len xs
     holds nthInt.[xs,i] = xs.1) &
    (for xs being FinSequence of INT, i being Integer st
       len xs <= i or (i < 0 & len xs = 0)
     holds nthInt.[xs,i] = 0) &
    (for xs being FinSequence of BOOLEAN, i being Integer st
       0 <= i & i < len xs
     holds nthBool.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of BOOLEAN, i being Integer st
       i < 0 & 0 < len xs
     holds nthBool.[xs,i] = xs.1) &
    (for xs being FinSequence of BOOLEAN, i being Integer st
       len xs <= i or (i < 0 & len xs = 0)
     holds nthBool.[xs,i] = FALSE) &
    (for xs being FinSequence of INT, i,x being Integer holds
       len (setInt.[xs,[i,x]]) = len xs &
       ((i <= 0 & 0 < len xs) implies
         for q being Integer holds
           (q <= 0 implies
             nthInt.[setInt.[xs,[i,x]],q] = x) &
           (0 < q implies
             nthInt.[setInt.[xs,[i,x]],q] = nthInt.[xs,q])) &
       ((0 < i & i < len xs) implies
         for q being Integer holds
           (q = i implies
             nthInt.[setInt.[xs,[i,x]],q] = x) &
           (q <> i implies
             nthInt.[setInt.[xs,[i,x]],q] = nthInt.[xs,q])) &
       ((len xs = 0 or len xs <= i) implies
         setInt.[xs,[i,x]] = xs)) &
    (for x being Integer holds
       (0 <= x implies Abs.x = x) &
       (x < 0 implies Abs.x = -x)) &
    (for a being Element of A holds
       0 <= size.a &
       size.a = len (elts.a) &
       len (elts.a) <= (2 |^ 62)-1 &
       (for i being Integer st 0 <= i & i < len (elts.a)
        holds nthInt.[elts.a,i] in BV63)) &
    (for xs being FinSequence of INT, n being Integer holds
       ([xs,n] in InvNexts iff
         for i being Integer st 0 <= i & i < n
         holds i < nthInt.[xs,i] & nthInt.[xs,i] <= n)) &
    (for bs being FinSequence of BOOLEAN,
         xs being FinSequence of INT
     holds
       ([bs,xs] in AllEliminated iff
         len bs = len xs &
         (for i being Integer st 0 <= i & i < len bs
          holds
            for j being Integer st
              i < j & j < nthInt.[xs,i]
            holds nthBool.[bs,j] = TRUE))) &
    (for m,ma being Element of BV63,
         xs being FinSequence of INT,
         bs being FinSequence of BOOLEAN,
         av being FinSequence of INT
     holds
       ([m,[xs,[bs,[av,ma]]]] in CoreInv iff
         m < (2 |^ 62)-1 &
         3 <= m &
         len xs = len bs &
         len bs = m+1 &
         (m-1) div 2 = ma &
         len av = ma+1 &
         [xs,len xs] in InvNexts &
         [bs,xs] in AllEliminated &
         (for i being Integer st 3 <= i & i <= m
          holds i mod 2 = 0 implies nthBool.[bs,i] = TRUE) &
         (for i being Integer st 3 <= i & i < m-1
          holds
            i mod 2 = 1 implies
              nthInt.[xs,i] mod 2 = 1 or
              nthInt.[xs,i] = m+1) &
         nthInt.[xs,m] = m+1 &
         ((m-1) mod 2 = 0 implies nthInt.[xs,m-1] = m) &
         ((m-1) mod 2 = 1 implies nthInt.[xs,m-1] = m+1) &
         (for i being Integer st 0 <= i & i <= ma
          holds
            -(m+1) <= nthInt.[av,i] &
            nthInt.[av,i] <= m+1) &
         (for i being Integer st 0 <= i & i <= ma
          holds
            (nthBool.[bs,2*i+1] = TRUE iff
              nthInt.[av,i] < 0)) &
         (for i being Integer st 0 <= i & i <= ma
          holds
            nthBool.[bs,2*i+1] <> TRUE implies
              nthInt.[av,i] = nthInt.[xs,2*i+1]) &
         (for i being Integer st 0 <= i & i <= ma
          holds
            nthBool.[bs,2*i+1] = TRUE implies
              nthInt.[av,i] = -nthInt.[xs,2*i+1]) &
         (for i being Integer st 0 <= i & i <= ma
          holds
            i < (Abs.(nthInt.[av,i])) div 2 &
            (Abs.(nthInt.[av,i])) div 2 <= ma+1 &
            Abs.(nthInt.[av,i]) <= m+1) &
         (for i,j being Integer st
            0 <= i & i <= ma &
            i < j & j < (Abs.(nthInt.[av,i])) div 2
          holds nthInt.[av,j] < 0))) &
    (for r being Element of T holds
       [maxF.r,[nextsF.r,[markedF.r,
         [elts.(arrF.r),maxArrF.r]]]] in CoreInv) &
    (for a,b being Element of T st
       nextsF.a = nextsF.b &
       markedF.a = markedF.b &
       arrF.a = arrF.b &
       maxF.a = maxF.b &
       maxArrF.a = maxArrF.b
     holds a = b) &
    (for r being Element of T holds
       (r in Post iff
         (nthBool.[markedF.r,0] = nthBool.[markedF.r,1] &
          nthBool.[markedF.r,1] = TRUE) &
         nthBool.[markedF.r,2] <> TRUE &
         (for i being Integer st
            1 <= i & i <= (maxF.r-1) div 2
          holds nthBool.[markedF.r,2*i+1] <> TRUE) &
         (for i being Integer st
            2 <= i & i <= (maxF.r+1) div 2
          holds
            2*i <= maxF.r implies
              nthBool.[markedF.r,2*i] = TRUE) &
         (for i being Integer st
            1 <= i & i <= (maxF.r-1) div 2
          holds
            2*i+1 < maxF.r-1 implies
              nthInt.[nextsF.r,2*i+1] = 2*i+3) &
         (for i being Integer st
            2 <= i & i <= (maxF.r-1) div 2
          holds
            2*i < maxF.r-1 implies
              nthInt.[nextsF.r,2*i] = 2*i+1) &
         (for i being Integer st 0 <= i & i <= maxF.r
          holds
            nthBool.[markedF.r,i] = TRUE implies
              i < 2 or 2 divides i))) &
    (for m being Element of BV63,
         xs being FinSequence of INT,
         bs being FinSequence of BOOLEAN,
         a being Element of A
     holds
       ([m,[xs,[bs,a]]] in Finish iff
         m-1 in BV63 &
         (for o7 being Element of BV63 st o7 = m-1
          holds
            2 <> 0 &
            o7 div 2 in BV63 &
            (for o8 being Element of BV63 st o8 = o7 div 2
             holds
               [m,[xs,[bs,[elts.a,o8]]]] in CoreInv &
               (for r being Element of T st
                  nextsF.r = xs &
                  markedF.r = bs &
                  arrF.r = a &
                  maxF.r = m &
                  maxArrF.r = o8
                holds maxF.r = m & r in Post))))) &
    (for m being Element of BV63, i being Integer holds
       (i = m implies fc.[m,i] = m+1) &
       (i <> m & i = m-1 & i mod 2 = 0 implies
         fc.[m,i] = m) &
       (i <> m & i = m-1 & i mod 2 <> 0 implies
         fc.[m,i] = m+1) &
       (i <> m & i <> m-1 & (i < 3 or i mod 2 = 0) implies
         fc.[m,i] = i+1) &
       (i <> m & i <> m-1 & not i < 3 & i mod 2 <> 0 implies
         fc.[m,i] = i+2)) &
    (for i being Integer holds
       (o1.i = TRUE iff
         i = 0 or i = 1 or (2 < i & i mod 2 = 0))) &
    (for m,la being Element of BV63, i being Integer holds
       (i = la-1 implies fc1.[m,[la,i]] = m+1) &
       (i <> la-1 & i = 0 implies fc1.[m,[la,i]] = -2) &
       (i <> la-1 & i <> 0 implies fc1.[m,[la,i]] = 2*i+3))
  holds
    for max1 being Element of BV63 st
      max1 < (2 |^ 62)-1 & 3 <= max1
    holds
      max1-1 in BV63 &
      (for o2 being Element of BV63 st o2 = max1-1
       holds
         2 <> 0 &
         o2 div 2 in BV63 &
         (for o3 being Element of BV63 st o3 = o2 div 2
          holds
            o3+1 in BV63 &
            (for lenArr being Element of BV63 st lenArr = o3+1
             holds
               0 <= max1+1 &
               (for nexts1 being FinSequence of INT st
                  len nexts1 = max1+1 &
                  (for i being Integer st
                     0 <= i & i < max1+1
                   holds nthInt.[nexts1,i] = fc.[max1,i])
                holds
                  (for i being Integer st
                     i <> 0 & i <> 1 & 2 < i
                   holds 2 <> 0) &
                  0 <= max1+1 &
                  (for marked1 being FinSequence of BOOLEAN st
                     len marked1 = max1+1 &
                     (for i being Integer st
                        0 <= i & i < max1+1
                      holds nthBool.[marked1,i] = o1.i)
                   holds
                     0 <= lenArr &
                     (for arr1 being Element of A st
                        (for i being Integer st
                           0 <= i & i < lenArr
                         holds nthInt.[elts.arr1,i] = -2) &
                        len (elts.arr1) = lenArr
                      holds
                        lenArr-1 in BV63 &
                        (for o6 being Element of BV63 st
                           o6 = lenArr-1
                         holds
                           (1 <= o6+1 implies
                             nthInt.[elts.arr1,0] =
                               fc1.[max1,[lenArr,0]] &
                             (for arr2 being Element of A st
                                size.arr2 = size.arr1
                              holds
                                (for i being Element of BV63 st
                                   (1 <= i & i <= o6) &
                                   (for j being Integer st
                                      0 <= j & j < i
                                    holds
                                      nthInt.[elts.arr2,j] =
                                        fc1.[max1,[lenArr,j]])
                                 holds
                                   lenArr-1 in BV63 &
                                   (for o7 being Element of BV63 st
                                      o7 = lenArr-1
                                    holds
                                      (i = o7 implies i = o7) implies
                                        (((i = o7 &
                                            max1+1 in BV63) or
                                           (i <> o7 &
                                            2*i in BV63 &
                                            (for o8 being Element of BV63 st
                                               o8 = 2*i
                                             holds o8+3 in BV63))) &
                                         (for o8 being Element of BV63 st
                                            ((i = o7 & o8 = max1+1) or
                                             (i <> o7 &
                                              ex o9 being Element of BV63 st
                                                o9 = 2*i & o8 = o9+3))
                                          holds
                                            0 <= i &
                                            i < len (elts.arr2) &
                                            (for arr3 being Element of A st
                                               size.arr3 = size.arr2 &
                                               elts.arr3 =
                                                 setInt.[elts.arr2,[i,o8]]
                                             holds
                                               for j being Integer st
                                                 0 <= j & j < i+1
                                               holds
                                                 nthInt.[elts.arr3,j] =
                                                   fc1.[max1,[lenArr,j]])))) &
                                ((for j being Integer st
                                    0 <= j & j < o6+1
                                  holds
                                    nthInt.[elts.arr2,j] =
                                      fc1.[max1,[lenArr,j]])
                                 implies
                                   [max1,[nexts1,[marked1,arr2]]]
                                     in Finish))) &
                           (o6+1 < 1 implies
                             [max1,[nexts1,[marked1,arr1]]]
                               in Finish)))))))))
proof
end;
::$P+
