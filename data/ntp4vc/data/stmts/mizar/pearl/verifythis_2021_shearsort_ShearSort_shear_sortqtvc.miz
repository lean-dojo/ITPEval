:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_shearsort_ShearSort_shear_sortqtvc: the complete
:: ShearSort verification condition for logarithmic rounds, alternating row
:: sorting, column sorting, threshold propagation, and preservation of matrix
:: multiplicities. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCOP_1, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1,
    NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSET_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, NAT_1, XXREAL_0, FINSET_1, MARGREL1,
    XBOOLEAN, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4,
    FUNCT_7;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1,
    CARD_1, REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1,
    NAT_1, FINSET_1, MARGREL1, FINSEQ_1, FINSEQ_2, PRE_POLY,
    FUNCT_4, FUNCT_7;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCOP_1, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSET_1, MARGREL1, XBOOLEAN, FRAENKEL, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Pow2,z0,zn being Function of INT,INT,
      Cross,Snake,Zones,RowPerm,ColPerm,ColSorted,OccPres,
      RowOrder,SelectContract,MatrixSelect,SelectVC,PairSpec,
      NzoInv,NzoVC,AuxUp,AuxDown,ColumnPhase,NzoPhase,
      LoopBody,LoopInv,PostLoop,Completion,Initial,Final being set,
      n,c being Integer,
      e being Function of [:INT,INT:],INT
  st
    0 <= n & 0 <= c &
    (for q being Integer holds
       (q < 0 implies Pow2.q = 1) &
       (q = 0 implies Pow2.q = 1) &
       (0 <= q implies Pow2.(q+1) = 2 * Pow2.q)) &
    (for q being Integer holds z0.q = 0 & zn.q = n) &

    (for f being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f,[r,d]] in Cross iff
         for i,j1,j2,k being Integer st
           0 <= i & i < k & k < r &
           0 <= j1 & j1 < d & 0 <= j2 & j2 < d
         holds f.[i,j1] <= f.[k,j2])) &

    (for f being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f,[r,d]] in Snake iff
         for i,j,k being Integer st
           0 <= i & i < r & 0 <= j & j <= k & k < d
         holds
           (i mod 2 = 0 implies f.[i,j] <= f.[i,k]) &
           (i mod 2 <> 0 implies f.[i,k] <= f.[i,j]))) &

    (for f being Function of [:INT,INT:],INT,
         zeros,ones being Function of INT,INT,
         width,r,d being Integer
     holds
       ([f,[zeros,[ones,[width,[r,d]]]]] in Zones iff
         (for v being Integer holds
            0 <= zeros.v & zeros.v <= ones.v & ones.v <= r) &
         (for v being Integer holds ones.v <= zeros.v + width) &
         (for v,i,j being Integer st
            0 <= i & i < zeros.v & 0 <= j & j < d
          holds f.[i,j] <= v) &
         (for v,i,j being Integer st
            ones.v <= i & i < r & 0 <= j & j < d
          holds v < f.[i,j]))) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f2,[f1,[r,d]]] in RowPerm iff
         for i being Integer st 0 <= i & i < r
         holds
           for v being Integer holds
             card {j where j is Integer :
               0 <= j & j < d & f2.[i,j] = v} =
             card {j where j is Integer :
               0 <= j & j < d & f1.[i,j] = v})) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f2,[f1,[r,d]]] in ColPerm iff
         for j being Integer st 0 <= j & j < d
         holds
           for v being Integer holds
             card {i where i is Integer :
               0 <= i & i < r & f2.[i,j] = v} =
             card {i where i is Integer :
               0 <= i & i < r & f1.[i,j] = v})) &

    (for f being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f,[r,d]] in ColSorted iff
         for i,j,k being Integer st
           0 <= i & i <= k & k < r & 0 <= j & j < d
         holds f.[i,j] <= f.[k,j])) &

    (for f0,f1 being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f0,[f1,[r,d]]] in OccPres iff
         for v being Integer holds
           card {[i,j] where i,j are Integer :
             0 <= i & i < r & 0 <= j & j < d &
             f0.[i,j] = v} =
           card {[i,j] where i,j are Integer :
             0 <= i & i < r & 0 <= j & j < d &
             f1.[i,j] = v})) &

    (for row being Function of INT,INT,
         b being Element of BOOLEAN, d being Integer
     holds
       ([row,[b,d]] in RowOrder iff
         for j,k being Integer st 0 <= j & j <= k & k < d
         holds
           (b = TRUE implies row.j <= row.k) &
           (b = FALSE implies row.k <= row.j))) &

    (for r1,r2 being Function of INT,INT,
         v,d being Integer, result being Element of BOOLEAN
     holds
       ([r1,[r2,[v,[d,result]]]] in SelectContract iff
         (result = TRUE implies
           for i being Integer st 0 <= i & i < d
           holds r1.i <= v or r2.i <= v) &
         (result = FALSE implies
           for i being Integer st 0 <= i & i < d
           holds v < r1.i or v < r2.i))) &

    (for f being Function of [:INT,INT:],INT,
         row1,row2,v,d being Integer,
         result being Element of BOOLEAN
     holds
       ([f,[row1,[row2,[v,[d,result]]]]] in MatrixSelect iff
         (result = TRUE implies
           for i being Integer st 0 <= i & i < d
           holds f.[row1,i] <= v or f.[row2,i] <= v) &
         (result = FALSE implies
           for i being Integer st 0 <= i & i < d
           holds v < f.[row1,i] or v < f.[row2,i]))) &

    (for v,d being Integer holds
       ([v,d] in SelectVC iff
         for r1,r2 being Function of INT,INT,
             b being Element of BOOLEAN st
           [r1,[b,d]] in RowOrder &
           ((b = TRUE & [r2,[FALSE,d]] in RowOrder) or
            (b = FALSE & [r2,[TRUE,d]] in RowOrder))
         holds
           (b = FALSE implies
             0 <= 1 & 0 < 1 &
             [r2,[TRUE,d]] in RowOrder &
             [r1,[FALSE,d]] in RowOrder &
             (for result being Element of BOOLEAN st
                [r2,[r1,[v,[d,result]]]] in SelectContract
              holds
                [r1,[r2,[v,[d,result]]]] in SelectContract)) &
           (b = TRUE implies
             (0 <= 0 & 0 <= d) &
             (for j being Integer st 0 <= j & j < 0
              holds r1.j <= v & v < r2.j) &
             (for i being Integer st
                0 <= i & i <= d &
                (for j being Integer st 0 <= j & j < i
                 holds r1.j <= v & v < r2.j)
              holds
                for step being Element of BOOLEAN st
                  (step = TRUE iff
                    i <> d & r1.i <= v & v < r2.i)
                holds
                  (step = TRUE implies
                    0 <= d-i & d-(i+1) < d-i &
                    0 <= i+1 & i+1 <= d &
                    (for j being Integer st
                       0 <= j & j < i+1
                     holds r1.j <= v & v < r2.j)) &
                  (step = FALSE implies
                    for result being Element of BOOLEAN st
                      (result = TRUE iff i = d or r2.i <= v)
                    holds
                      [r1,[r2,[v,[d,result]]]]
                        in SelectContract))))) &

    (for f being Function of [:INT,INT:],INT,
         nz,no,kd,r,d,v being Integer
     holds
       ([f,[nz,[no,[kd,[r,[d,v]]]]]] in PairSpec iff
         0 <= nz & nz <= no & no <= r & no <= nz + kd &
         (for j being Integer st 0 <= j & j < d
          holds
            ex lecnt,gcnt being Integer st
              lecnt = card {i where i is Integer :
                0 <= i & i < r & f.[i,j] <= v} &
              gcnt = card {i where i is Integer :
                0 <= i & i < r & v < f.[i,j]} &
              nz <= lecnt & r-no <= gcnt))) &

    (for f being Function of [:INT,INT:],INT,
         z,ob,nz,no,index,r,d,v being Integer
     holds
       ([f,[z,[ob,[nz,[no,[index,[r,[d,v]]]]]]]]
          in NzoInv iff
         z <= index & index <= ob & z <= nz & no <= ob &
         index-z = 2*(nz-z+ob-no) &
         (for j being Integer st 0 <= j & j < d
          holds
            ex lecnt,gcnt1,gcnt2 being Integer st
              lecnt = card {i where i is Integer :
                0 <= i & i < index & f.[i,j] <= v} &
              gcnt1 = card {i where i is Integer :
                0 <= i & i < index & v < f.[i,j]} &
              gcnt2 = card {i where i is Integer :
                ob <= i & i < r & v < f.[i,j]} &
              nz <= lecnt & r-no <= gcnt1+gcnt2))) &

    (for f being Function of [:INT,INT:],INT,
         zeros,ones being Function of INT,INT,
         kd,r,d,v being Integer
     holds
       ([f,[zeros,[ones,[kd,[r,[d,v]]]]]] in NzoVC iff
         [f,[zeros.v,[ones.v,[zeros.v,
           [ones.v,[zeros.v,[r,[d,v]]]]]]]] in NzoInv &
         (for index,no,nz being Integer st
            [f,[zeros.v,[ones.v,[nz,[no,[index,[r,[d,v]]]]]]]]
              in NzoInv
          holds
            (index+1 < ones.v implies
              [v,d] in SelectVC & 2 <> 0 &
              (for j,k being Integer st
                 0 <= j & j <= k & k < d
               holds
                 (index mod 2 = 0 implies
                   f.[index,j] <= f.[index,k] &
                   f.[index+1,k] <= f.[index+1,j]) &
                 (index mod 2 <> 0 implies
                   f.[index,k] <= f.[index,j] &
                   f.[index+1,j] <= f.[index+1,k])) &
              (for result being Element of BOOLEAN st
                 [f,[index,[index+1,[v,[d,result]]]]]
                   in MatrixSelect
               holds
                 (result = TRUE implies
                   0 <= ones.v-index &
                   ones.v-(index+2) < ones.v-index &
                   [f,[zeros.v,[ones.v,[nz+1,
                     [no,[index+2,[r,[d,v]]]]]]]]
                     in NzoInv) &
                 (result = FALSE implies
                   0 <= ones.v-index &
                   ones.v-(index+2) < ones.v-index &
                   [f,[zeros.v,[ones.v,[nz,
                     [no-1,[index+2,[r,[d,v]]]]]]]]
                     in NzoInv))) &
            (not index+1 < ones.v implies
              [f,[nz,[no,[kd,[r,[d,v]]]]]] in PairSpec)))) &

    (for f being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f,[r,d]] in AuxUp iff
         for v,i,j being Integer st
           0 <= i & i < r &
           (ex q being Integer st
             i+1 <= q & q < r & f.[q,j] <= v) &
           0 <= j & j < d & v < f.[i,j]
         holds
           0 <= r-i & r-(i+1) < r-i &
           0 <= i+1 & i+1 < r &
           (ex q being Integer st
             i+2 <= q & q < r & f.[q,j] <= v) &
           0 <= j & j < d & v < f.[i+1,j])) &

    (for f being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f,[r,d]] in AuxDown iff
         for v,i,j being Integer st
           0 <= i & i < r &
           (ex q being Integer st
             0 <= q & q < i & v < f.[q,j]) &
           0 <= j & j < d & f.[i,j] <= v
         holds
           0 <= i & i-1 < i & 0 <= i-1 & i-1 < r &
           (ex q being Integer st
             0 <= q & q < i-1 & v < f.[q,j]) &
           0 <= j & j < d & f.[i-1,j] <= v)) &

    (for f0,f2 being Function of [:INT,INT:],INT,
         zeros,ones,newz,newo being Function of INT,INT,
         ind,l,kd,r,d being Integer
     holds
       ([f0,[f2,[zeros,[ones,[newz,[newo,
         [ind,[l,[kd,[r,d]]]]]]]]]] in ColumnPhase iff
         (ind = l implies
           [f2,[zeros,[ones,[1,[r,d]]]]] in Zones) &
         ((ind = l implies [f2,[r,d]] in Cross) implies
           for f3 being Function of [:INT,INT:],INT st
             [f3,[f2,[r,d]]] in ColPerm &
             [f3,[r,d]] in ColSorted
           holds
             [f3,[r,d]] in AuxUp & [f3,[r,d]] in AuxDown &
             [f3,[newz,[newo,[kd,[r,d]]]]] in Zones &
             0 < kd &
             (kd-1)*Pow2.(ind+1) < r &
             r <= kd*Pow2.(ind+1) &
             (l < ind+1 implies [f3,[r,d]] in Snake) &
             [f0,[f3,[r,d]]] in OccPres))) &

    (for f0,f2 being Function of [:INT,INT:],INT,
         zeros,ones being Function of INT,INT,
         ind,l,kd,r,d being Integer
     holds
       ([f0,[f2,[zeros,[ones,[ind,[l,[kd,[r,d]]]]]]]]
          in NzoPhase iff
         (for v being Integer holds
            [f2,[zeros,[ones,[kd,[r,[d,v]]]]]] in NzoVC) &
         (for newz,newo being Function of INT,INT st
            (for v being Integer holds
               [f2,[newz.v,[newo.v,[kd,[r,[d,v]]]]]]
                 in PairSpec)
          holds
            [f0,[f2,[zeros,[ones,[newz,[newo,
              [ind,[l,[kd,[r,d]]]]]]]]]]
              in ColumnPhase))) &

    (for f0,f1 being Function of [:INT,INT:],INT,
         zeros,ones being Function of INT,INT,
         k,ind,l,r,d being Integer
     holds
       ([f0,[f1,[zeros,[ones,[k,[ind,[l,[r,d]]]]]]]]
          in LoopBody iff
         for f2 being Function of [:INT,INT:],INT st
           [f2,[f1,[r,d]]] in RowPerm &
           [f2,[r,d]] in Snake
         holds
           2 <> 0 &
           [f0,[f2,[zeros,[ones,[ind,[l,
             [(k+1) div 2,[r,d]]]]]]]] in NzoPhase)) &

    (for f0,f1 being Function of [:INT,INT:],INT,
         zeros,ones being Function of INT,INT,
         k,ind,l,r,d being Integer
     holds
       ([f0,[f1,[zeros,[ones,[k,[ind,[l,[r,d]]]]]]]]
          in LoopInv iff
         0 <= ind & ind <= l &
         [f1,[zeros,[ones,[k,[r,d]]]]] in Zones &
         0 < k & (k-1)*Pow2.ind < r & r <= k*Pow2.ind &
         (l < ind implies [f1,[r,d]] in Snake) &
         [f0,[f1,[r,d]]] in OccPres)) &

    (for f0,f1 being Function of [:INT,INT:],INT,
         zeros,ones being Function of INT,INT,
         k,l,r,d being Integer
     holds
       ([f0,[f1,[zeros,[ones,[k,[l,[r,d]]]]]]]
          in PostLoop iff
         [f1,[zeros,[ones,[k,[r,d]]]]] in Zones &
         0 < k & (k-1)*Pow2.(l+1) < r &
         r <= k*Pow2.(l+1) &
         (l < l+1 implies [f1,[r,d]] in Snake) &
         [f0,[f1,[r,d]]] in OccPres)) &

    (for f0,f1 being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f0,[f1,[r,d]]] in Completion iff
         ([f1,[r,d]] in Cross implies
           [f1,[r,d]] in Final &
           [f0,[f1,[r,d]]] in OccPres))) &

    (for f being Function of [:INT,INT:],INT,
         l,r,d being Integer
     holds
       ([f,[l,[r,d]]] in Initial iff
         [f,[z0,[zn,[r,[r,d]]]]] in Zones &
         0 < r & (r-1)*Pow2.0 < r & r <= r*Pow2.0 &
         (l < 0 implies [f,[r,d]] in Snake))) &

    (for f being Function of [:INT,INT:],INT,
         r,d being Integer
     holds
       ([f,[r,d]] in Final iff
         [f,[r,d]] in Cross & [f,[r,d]] in Snake))
  holds
    (n <> 0 implies
      0 <= n-1 &
      (n-1)*Pow2.0 < n &
      n <= Pow2.0*((n-1)+1) &
      (for p,l being Integer st
         0 <= l & 0 <= p &
         (l <> 0 implies Pow2.(l-1) <= n) &
         p*Pow2.l < n & n <= Pow2.l*(p+1)
       holds
         (p <> 0 implies
           2 <> 0 & 0 <= p & p div 2 < p &
           0 <= l+1 & 0 <= p div 2 &
           (l+1 <> 0 implies Pow2.(l+1-1) <= n) &
           (p div 2)*Pow2.(l+1) < n &
           n <= Pow2.(l+1)*(p div 2+1)) &
         (p = 0 implies
           (for ones,zeros being Function of INT,INT,
                f1 being Function of [:INT,INT:],INT st
              [f1,[zeros,[ones,[1,[n,c]]]]] in Zones
            holds [f1,[n,c]] in Cross) &
           (0 <= l+1 implies
             [e,[l,[n,c]]] in Initial &
             (for ones,zeros being Function of INT,INT,
                  k being Integer,
                  f1 being Function of [:INT,INT:],INT
              holds
                (for ind being Integer st
                   [e,[f1,[zeros,[ones,[k,
                     [ind,[l,[n,c]]]]]]]] in LoopInv
                 holds
                   [e,[f1,[zeros,[ones,[k,
                     [ind,[l,[n,c]]]]]]]] in LoopBody) &
                ([e,[f1,[zeros,[ones,[k,[l,[n,c]]]]]]]
                    in PostLoop implies
                  [f1,[zeros,[ones,[1,[n,c]]]]] in Zones &
                  [e,[f1,[n,c]]] in Completion))) &
           (l+1 < 0 implies
             [e,[z0,[zn,[1,[n,c]]]]] in Zones &
             ([e,[n,c]] in Cross implies [e,[n,c]] in Final))))) &
    (n = 0 implies [e,[n,c]] in Final)
proof
end;
::$P+
