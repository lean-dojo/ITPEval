:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/skew_heaps_SkewHeaps_mergeqtvc: the skew-heap merge verification
:: condition preserves heap order, element multiplicities, and total size
:: while establishing the recursive-call decrease. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      Leq being Relation of E,E,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size being Function of Tree,INT,
      Occ being Function of [:E,Tree:],INT,
      LeRoot being Subset of [:E,Tree:],
      Heaps being Subset of Tree,
      t1,t2 being Element of Tree
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds
       [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       node.[l,[x,r]] <> emptyT) &
    (for t being Element of Tree holds
       t = emptyT or
       ex l,r being Element of Tree,
          x being Element of E st
         t = node.[l,[x,r]]) &
    (for l,l1,r,r1 being Element of Tree,
         x,x1 being Element of E st
       node.[l,[x,r]] = node.[l1,[x1,r1]]
     holds
       l = l1 & x = x1 & r = r1) &
    (for X being Subset of Tree st
       emptyT in X &
       (for l,r being Element of Tree,
            x being Element of E st
          l in X & r in X
        holds
          node.[l,[x,r]] in X)
     holds
       X = Tree) &
    Size.emptyT = 0 &
    (for t being Element of Tree holds
       0 <= Size.t) &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       Size.(node.[l,[x,r]]) = 1 + Size.l + Size.r) &
    (for x being Element of E holds
       Occ.[x,emptyT] = 0) &
    (for x,y being Element of E,
         l,r being Element of Tree
     holds
       ex whole,leftOcc,rightOcc being Integer st
         whole = Occ.[x,node.[l,[y,r]]] &
         leftOcc = Occ.[x,l] &
         rightOcc = Occ.[x,r] &
         (x = y implies whole = 1 + leftOcc + rightOcc) &
         (x <> y implies whole = leftOcc + rightOcc)) &
    (for x being Element of E holds
       [x,emptyT] in LeRoot) &
    (for x,y being Element of E,
         l,r being Element of Tree
     holds
       ([x,node.[l,[y,r]]] in LeRoot iff [x,y] in Leq)) &
    emptyT in Heaps &
    (for x being Element of E,
         l,r being Element of Tree
     holds
       (node.[l,[x,r]] in Heaps iff
          [x,l] in LeRoot & l in Heaps &
          [x,r] in LeRoot & r in Heaps)) &
    t1 in Heaps &
    t2 in Heaps
  holds
    (t2 = emptyT or
     ex l2,r2 being Element of Tree,
        x2 being Element of E st
       t2 = node.[l2,[x2,r2]] &
       (t1 = emptyT or
        ex l1,r1 being Element of Tree,
           x1 being Element of E st
          t1 = node.[l1,[x1,r1]] &
          (([x1,x2] in Leq &
            (0 <= Size.t1 + Size.t2 &
             Size.r1 + Size.t2 < Size.t1 + Size.t2) &
            r1 in Heaps & t2 in Heaps) or
           (not [x1,x2] in Leq &
            (0 <= Size.t1 + Size.t2 &
             Size.r2 + Size.t1 < Size.t1 + Size.t2) &
            r2 in Heaps & t1 in Heaps)))) &
    (for result being Element of Tree st
       ((t2 = emptyT &
         ((t1 = emptyT & result = t2) or
          ex l1,r1 being Element of Tree,
             x1 being Element of E st
            t1 = node.[l1,[x1,r1]] & result = t1)) or
        ex l2,r2 being Element of Tree,
           x2 being Element of E st
          t2 = node.[l2,[x2,r2]] &
          ((t1 = emptyT & result = t2) or
           ex l1,r1 being Element of Tree,
              x1 being Element of E st
             t1 = node.[l1,[x1,r1]] &
             (([x1,x2] in Leq &
               ex o1 being Element of Tree st
                 o1 in Heaps &
                 (for e being Element of E holds
                    ex o1Occ,r1Occ,t2Occ being Integer st
                      o1Occ = Occ.[e,o1] &
                      r1Occ = Occ.[e,r1] &
                      t2Occ = Occ.[e,t2] &
                      o1Occ = r1Occ + t2Occ) &
                 Size.o1 = Size.r1 + Size.t2 &
                 result = node.[o1,[x1,l1]]) or
              (not [x1,x2] in Leq &
               ex o1 being Element of Tree st
                 o1 in Heaps &
                 (for e being Element of E holds
                    ex o1Occ,r2Occ,t1Occ being Integer st
                      o1Occ = Occ.[e,o1] &
                      r2Occ = Occ.[e,r2] &
                      t1Occ = Occ.[e,t1] &
                      o1Occ = r2Occ + t1Occ) &
                 Size.o1 = Size.r2 + Size.t1 &
                 result = node.[o1,[x2,l2]]))))
     holds
       result in Heaps &
       (for e being Element of E holds
          ex resultOcc,t1Occ,t2Occ being Integer st
            resultOcc = Occ.[e,result] &
            t1Occ = Occ.[e,t1] &
            t2Occ = Occ.[e,t2] &
            resultOcc = t1Occ + t2Occ) &
       Size.result = Size.t1 + Size.t2)
proof
end;
::$P+
