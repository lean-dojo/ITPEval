:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/rightmostbittrick_Rmbt_rightmost_bit_trickqtvc: the 64-bit
:: rightmost-set-bit verification condition for a word AND its fixed-width
:: two's-complement negation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, FINSET_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON,
    XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, NEWTON, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    NEWTON, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Nat st
    x < 2 |^ 64 &
    x <> 0
  holds
    x <> 0 &
    (for p being Nat st p < 2 |^ 64 holds
      ((p < 64 &
        (for i being Element of NAT st i < p holds
          (x div (2 |^ i)) mod 2 = 0) &
        (x div (2 |^ p)) mod 2 = 1)
       implies
        for neg,r being Nat st
          neg < 2 |^ 64 &
          neg = ((2 |^ 64) - x) mod (2 |^ 64) &
          r < 2 |^ 64 &
          (for i being Element of NAT st i < 64 holds
            ((r div (2 |^ i)) mod 2 = 1 iff
              ((x div (2 |^ i)) mod 2 = 1 &
               (neg div (2 |^ i)) mod 2 = 1)))
        holds
          0 <= p &
          p < 64 &
          (for i being Element of NAT st i < p holds
            (x div (2 |^ i)) mod 2 = 0) &
          (x div (2 |^ p)) mod 2 = 1 &
          (for i being Element of NAT st i < p holds
            (r div (2 |^ i)) mod 2 = 0) &
          (for i being Element of NAT st
             p + 1 <= i & i < p + 1 + (63 - p)
           holds
             (r div (2 |^ i)) mod 2 = 0) &
          (r div (2 |^ p)) mod 2 = 1))
proof
end;
::$P+
