:: Statement-only formalization of NTP4VC corpus artifact
:: pearl/verifythis_2024_challenge1_Top_smart_array_copy_0qtvc: the
:: verification condition for copying an array by shuffled fixed-size
:: subsegments and then copying a final remainder element by element. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4, XCMPLX_0,
    XREAL_0, XXREAL_0, REAL_1, VALUED_0, VALUED_1, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    CARD_1, NUMBERS, REAL_1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for E being non empty set,
      src,dst being Function of INT,E,
      n,k,l,q,r being Integer st
    0 < n &
    0 < k &
    0 < l &
    0 <= q &
    0 <= r &
    r < k*l &
    n = q*k*l + r
  holds
    ex nthElt being Function of [:Funcs(INT,E),INT:],E,
       intElt being Function of [:Funcs(INT,INT),INT:],INT,
       permutation being Function of [:INT,Funcs(INT,INT):],BOOLEAN,
       permutationPair being
         Function of
           [:Funcs(INT,INT),Funcs(INT,INT),INT:],BOOLEAN,
       validChunk being
         Function of [:Funcs(INT,E),INT,INT:],BOOLEAN,
       copyPred being
         Function of
           [:[:Funcs(INT,E),Funcs(INT,E):],[:INT,INT:]:],BOOLEAN,
       updateArray being
         Function of
           [:[:Funcs(INT,E),INT:],E:],Funcs(INT,E) st
      (for a being Function of INT,E, i being Integer holds
        nthElt.[a,i] = a.i) &
      (for p being Function of INT,INT, i being Integer holds
        intElt/.[p,i] = p.i) &
      (for ll being Integer, p being Function of INT,INT holds
        (permutation/.[ll,p] = TRUE iff
          0 <= ll &
          (for i being Integer st 0 <= i & i < ll holds
            0 <= intElt/.[p,i] &
            intElt/.[p,i] < ll) &
          (for i,j being Integer st
            0 <= i & i < ll &
            0 <= j & j < ll &
            i <> j
          holds
            intElt/.[p,i] <> intElt/.[p,j]))) &
      (for ll being Integer,
           p,invp being Function of INT,INT holds
        (permutationPair/.[p,invp,ll] = TRUE iff
          permutation/.[ll,p] = TRUE &
          permutation/.[ll,invp] = TRUE &
          (for i being Integer st 0 <= i & i < ll holds
            intElt/.[p,intElt/.[invp,i]] = i) &
          (for i being Integer st 0 <= i & i < ll holds
            intElt/.[invp,intElt/.[p,i]] = i))) &
      (for a being Function of INT,E,
           ofs,len0 being Integer holds
        (validChunk/.[a,ofs,len0] = TRUE iff
          0 <= ofs &
          ofs <= ofs + len0 &
          ofs + len0 <= n)) &
      (for a,b being Function of INT,E,
           ofs,len0 being Integer holds
        (copyPred/.[[a,b],[ofs,len0]] = TRUE iff
          validChunk/.[a,ofs,len0] = TRUE &
          (for i being Integer st
            ofs <= i & i < ofs + len0
          holds
            nthElt.[b,i] = nthElt.[a,i]))) &
      (for a being Function of INT,E,
           i being Integer,
           x being Element of E,
           t being Integer holds
        (t = i implies
          nthElt.[updateArray/.[[a,i],x],t] = x) &
        (t <> i implies
          nthElt.[updateArray/.[[a,i],x],t] = nthElt.[a,t])) &
      ((0 <= (q - 1) + 1 implies
          copyPred/.[[src,dst],[0,0*(k*l)]] = TRUE &
          (for dst1 being Function of INT,E holds
            ((for s being Integer st
              (0 <= s & s <= q - 1) &
              copyPred/.[[src,dst1],[0,s*(k*l)]] = TRUE
            holds
              0 < l &
              (for sigma,invsigma being Function of INT,INT st
                permutationPair/.[sigma,invsigma,l] = TRUE
              holds
                (((0 <= (l - 1) + 1 implies
                    (copyPred/.[[src,dst1],[0,s*(k*l)]] = TRUE &
                     (for jp being Integer st
                       0 <= jp & jp < 0
                     holds
                       copyPred/.
                         [[src,dst1],
                          [s*(k*l) + intElt/.[sigma,jp]*k,k]] =
                         TRUE)) &
                    (for dst2 being Function of INT,E holds
                      (for j being Integer st
                        (0 <= j & j <= l - 1) &
                        copyPred/.[[src,dst2],[0,s*(k*l)]] = TRUE &
                        (for jp being Integer st
                          0 <= jp & jp < j
                        holds
                          copyPred/.
                            [[src,dst2],
                             [s*(k*l) + intElt/.[sigma,jp]*k,k]] =
                            TRUE)
                      holds
                        (0 <= j & j < l) &
                        ((0 <= (k - 1) + 1 implies
                            (copyPred/.
                               [[src,dst2],[0,s*(k*l)]] = TRUE &
                             (for jp being Integer st
                               0 <= jp & jp < j
                             holds
                               copyPred/.
                                 [[src,dst2],
                                  [s*(k*l) +
                                     intElt/.[sigma,jp]*k,
                                   k]] = TRUE) &
                             copyPred/.
                               [[src,dst2],
                                [s*(k*l) + intElt/.[sigma,j]*k,
                                 0]] = TRUE) &
                            (for dst3 being Function of INT,E holds
                              (for i being Integer st
                                (0 <= i & i <= k - 1) &
                                copyPred/.
                                  [[src,dst3],[0,s*(k*l)]] = TRUE &
                                (for jp being Integer st
                                  0 <= jp & jp < j
                                holds
                                  copyPred/.
                                    [[src,dst3],
                                     [s*(k*l) +
                                        intElt/.[sigma,jp]*k,
                                      k]] = TRUE) &
                                copyPred/.
                                  [[src,dst3],
                                   [s*(k*l) + intElt/.[sigma,j]*k,
                                    i]] = TRUE
                              holds
                                (0 <=
                                   s*(k*l) +
                                     intElt/.[sigma,j]*k + i &
                                 s*(k*l) +
                                     intElt/.[sigma,j]*k + i <
                                   n) &
                                (0 <=
                                   s*(k*l) +
                                     intElt/.[sigma,j]*k + i &
                                 s*(k*l) +
                                     intElt/.[sigma,j]*k + i <
                                   n) &
                                (copyPred/.
                                   [[src,
                                     updateArray/.
                                       [[dst3,
                                         s*(k*l) +
                                           intElt/.[sigma,j]*k + i],
                                        nthElt/.
                                          [src,
                                           s*(k*l) +
                                             intElt/.[sigma,j]*k + i]]],
                                    [0,s*(k*l)]] = TRUE &
                                 (for jp being Integer st
                                   0 <= jp & jp < j
                                 holds
                                   copyPred/.
                                     [[src,
                                       updateArray/.
                                         [[dst3,
                                           s*(k*l) +
                                             intElt/.[sigma,j]*k + i],
                                          nthElt/.
                                            [src,
                                             s*(k*l) +
                                               intElt/.[sigma,j]*k + i]]],
                                      [s*(k*l) +
                                         intElt/.[sigma,jp]*k,
                                       k]] = TRUE) &
                                 copyPred/.
                                   [[src,
                                     updateArray/.
                                       [[dst3,
                                         s*(k*l) +
                                           intElt/.[sigma,j]*k + i],
                                        nthElt/.
                                          [src,
                                           s*(k*l) +
                                             intElt/.[sigma,j]*k + i]]],
                                    [s*(k*l) +
                                       intElt/.[sigma,j]*k,
                                     i + 1]] = TRUE)) &
                              ((copyPred/.
                                   [[src,dst3],[0,s*(k*l)]] = TRUE &
                                (for jp being Integer st
                                  0 <= jp & jp < j
                                holds
                                  copyPred/.
                                    [[src,dst3],
                                     [s*(k*l) +
                                        intElt/.[sigma,jp]*k,
                                      k]] = TRUE) &
                                copyPred/.
                                  [[src,dst3],
                                   [s*(k*l) + intElt/.[sigma,j]*k,
                                    (k - 1) + 1]] = TRUE)
                               implies
                                 copyPred/.
                                   [[src,dst3],[0,s*(k*l)]] = TRUE &
                                 (for jp being Integer st
                                   0 <= jp & jp < j + 1
                                 holds
                                   copyPred/.
                                     [[src,dst3],
                                      [s*(k*l) +
                                         intElt/.[sigma,jp]*k,
                                       k]] = TRUE)))) &
                          ((k - 1) + 1 < 0 implies
                            copyPred/.
                              [[src,dst2],[0,s*(k*l)]] = TRUE &
                            (for jp being Integer st
                              0 <= jp & jp < j + 1
                            holds
                              copyPred/.
                                [[src,dst2],
                                 [s*(k*l) +
                                    intElt/.[sigma,jp]*k,
                                  k]] = TRUE)))) &
                    ((copyPred/.
                         [[src,dst2],[0,s*(k*l)]] = TRUE &
                      (for jp being Integer st
                        0 <= jp & jp < (l - 1) + 1
                      holds
                        copyPred/.
                          [[src,dst2],
                           [s*(k*l) + intElt/.[sigma,jp]*k,k]] =
                          TRUE))
                     implies
                       copyPred/.
                         [[src,dst2],[0,(s + 1)*(k*l)]] = TRUE)))) &
                 ((l - 1) + 1 < 0 implies
                   copyPred/.
                     [[src,dst1],[0,(s + 1)*(k*l)]] = TRUE)))) &
             (copyPred/.
                [[src,dst1],[0,((q - 1) + 1)*(k*l)]] = TRUE
              implies
                ((0 <= (r - 1) + 1 implies
                    (copyPred/.
                       [[src,dst1],[0,q*(k*l)]] = TRUE &
                     copyPred/.
                       [[src,dst1],[q*(k*l),0]] = TRUE) &
                    (for dst2 being Function of INT,E holds
                      (for i being Integer st
                        (0 <= i & i <= r - 1) &
                        copyPred/.
                          [[src,dst2],[0,q*(k*l)]] = TRUE &
                        copyPred/.
                          [[src,dst2],[q*(k*l),i]] = TRUE
                      holds
                        (0 <= q*(k*l) + i &
                         q*(k*l) + i < n) &
                        (0 <= q*(k*l) + i &
                         q*(k*l) + i < n) &
                        (copyPred/.
                           [[src,
                             updateArray/.
                               [[dst2,q*(k*l) + i],
                                nthElt/.[src,q*(k*l) + i]]],
                            [0,q*(k*l)]] = TRUE &
                         copyPred/.
                           [[src,
                             updateArray/.
                               [[dst2,q*(k*l) + i],
                                nthElt/.[src,q*(k*l) + i]]],
                            [q*(k*l),i + 1]] = TRUE)) &
                      ((copyPred/.
                           [[src,dst2],[0,q*(k*l)]] = TRUE &
                        copyPred/.
                           [[src,dst2],
                            [q*(k*l),(r - 1) + 1]] = TRUE)
                       implies
                         copyPred/.
                           [[src,dst2],[0,n]] = TRUE))) &
                  ((r - 1) + 1 < 0 implies
                    copyPred/.
                      [[src,dst1],[0,n]] = TRUE))))))
       &
       ((q - 1) + 1 < 0 implies
          ((0 <= (r - 1) + 1 implies
              (copyPred/.[[src,dst],[0,q*(k*l)]] = TRUE &
               copyPred/.[[src,dst],[q*(k*l),0]] = TRUE) &
              (for dst1 being Function of INT,E holds
                (for i being Integer st
                  (0 <= i & i <= r - 1) &
                  copyPred/.[[src,dst1],[0,q*(k*l)]] = TRUE &
                  copyPred/.[[src,dst1],[q*(k*l),i]] = TRUE
                holds
                  (0 <= q*(k*l) + i &
                   q*(k*l) + i < n) &
                  (0 <= q*(k*l) + i &
                   q*(k*l) + i < n) &
                  (copyPred/.
                     [[src,
                       updateArray/.
                         [[dst1,q*(k*l) + i],
                          nthElt/.[src,q*(k*l) + i]]],
                      [0,q*(k*l)]] = TRUE &
                   copyPred/.
                     [[src,
                       updateArray/.
                         [[dst1,q*(k*l) + i],
                          nthElt/.[src,q*(k*l) + i]]],
                      [q*(k*l),i + 1]] = TRUE)) &
                ((copyPred/.
                     [[src,dst1],[0,q*(k*l)]] = TRUE &
                  copyPred/.
                     [[src,dst1],[q*(k*l),(r - 1) + 1]] = TRUE)
                 implies
                   copyPred/.
                     [[src,dst1],[0,n]] = TRUE))) &
            ((r - 1) + 1 < 0 implies
              copyPred/.[[src,dst],[0,n]] = TRUE))))
proof
end;
::$P+
