:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sumrange_CumulativeArray_createqtvc: the verification condition for
:: constructing an integer cumulative-sum array by initialization and repeated
:: array updates. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being FinSequence of INT,
      nthInt being Function of [:INT*,INT:],INT,
      setInt being Function of [:INT*,[:INT,INT:]:],INT*,
      rangeSum being Function of [:INT*,[:INT,INT:]:],INT,
      Cumulative being Subset of [:INT*,INT*:]
  st
    (for xs being FinSequence of INT, i being Integer holds
      (i < 0 & len xs = 0 implies nthInt.[xs,i] = 0) &
      (i < 0 & 0 < len xs implies nthInt.[xs,i] = xs.1) &
      (0 <= i & i < len xs implies
        nthInt.[xs,i] = xs.(i+1)) &
      (len xs <= i implies nthInt.[xs,i] = 0)) &
    (for xs being FinSequence of INT, i,x being Integer holds
      len (setInt.[xs,[i,x]]) = len xs &
      ((i <= 0 & 0 < len xs) implies
        for q being Integer holds
          (q <= 0 implies nthInt.[setInt.[xs,[i,x]],q] = x) &
          (0 < q implies
            nthInt.[setInt.[xs,[i,x]],q] = nthInt.[xs,q])) &
      ((0 < i & i < len xs) implies
        for q being Integer holds
          (q = i implies nthInt.[setInt.[xs,[i,x]],q] = x) &
          (q <> i implies
            nthInt.[setInt.[xs,[i,x]],q] = nthInt.[xs,q])) &
      ((len xs = 0 or len xs <= i) implies
        setInt.[xs,[i,x]] = xs)) &
    (for xs being FinSequence of INT, i,j being Integer st
      0 <= i & i <= j & j <= len xs
     holds
      (j <= i implies rangeSum.[xs,[i,j]] = 0) &
      (not j <= i implies
        for v1 being Integer st v1 = nthInt.[xs,i] holds
          for v2 being Integer st v2 = rangeSum.[xs,[i+1,j]]
          holds rangeSum.[xs,[i,j]] = v1 + v2)) &
    (for c,xs being FinSequence of INT holds
      ([c,xs] in Cumulative iff
        len c = len xs + 1 &
        (for i being Integer st 0 <= i & i < len c
         holds nthInt.[c,i] = rangeSum.[xs,[0,i]])))
  holds
    for l being Integer st l = len a holds
      for o1 being Integer st o1 = l + 1 holds
        0 <= o1 &
        (for s being FinSequence of INT st
          (for i being Integer st 0 <= i & i < o1
           holds nthInt.[s,i] = 0) &
          len s = o1
         holds
          (1 <= l + 1 implies
            (for k being Integer st 0 <= k & k < 1
             holds nthInt.[s,k] = rangeSum.[a,[0,k]]) &
            (for s1 being FinSequence of INT st len s1 = len s
             holds
              (for i being Integer st
                (1 <= i & i <= l) &
                (for k being Integer st 0 <= k & k < i
                 holds nthInt.[s1,k] = rangeSum.[a,[0,k]])
               holds
                (0 <= i-1 & i-1 < len a) &
                (0 <= i-1 & i-1 < len s1) &
                (0 <= i & i < len s1) &
                (for v1 being Integer st v1 = nthInt.[s1,i-1]
                 holds
                  for v2 being Integer st v2 = nthInt.[a,i-1]
                  holds
                    for o4 being Integer st o4 = v1 + v2
                    holds
                      (len (setInt.[s1,[i,o4]]) = len s1
                       implies
                        ((for q being Integer holds
                          (q = i implies
                            nthInt.[setInt.[s1,[i,o4]],q] = o4) &
                          (q <> i implies
                            nthInt.[setInt.[s1,[i,o4]],q] =
                              nthInt.[s1,q]))
                         implies
                          for k being Integer st 0 <= k & k < i+1
                          holds
                            nthInt.[setInt.[s1,[i,o4]],k] =
                              rangeSum.[a,[0,k]]))) &
              ((for k being Integer st 0 <= k & k < l+1
                holds nthInt.[s1,k] = rangeSum.[a,[0,k]])
               implies [s1,a] in Cumulative))) &
          (l + 1 < 1 implies [s,a] in Cumulative)))
proof
end;
::$P+
