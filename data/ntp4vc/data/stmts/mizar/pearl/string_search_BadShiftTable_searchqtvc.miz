:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/string_search_BadShiftTable_searchqtvc: the bad-shift string-search
:: verification condition preserves exclusion of earlier matches, signed
:: 63-bit bounds, loop progress, and the final match specification. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSEQ_1, FINSEQ_2, FINSET_1, MCART_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    NAT_D, NEWTON, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON, FINSEQ_1,
    FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS,
    CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T being non empty set,
      mapDom being Function of T,bool NAT,
      mapVal being Function of T,Funcs(NAT,INT),
      nthElem being Function of [:NAT*,INT:],NAT,
      MatchesRel being set,
      pat1,text being FinSequence of NAT,
      sht1 being Element of T st
    (for a being FinSequence of NAT, j being Integer st
       0 <= j & j < len a
     holds nthElem.[a,j] = a.(j+1)) &
    (for q being Nat st q in dom pat1 holds
       ex b being Nat st b = pat1.q & b < 256) &
    (for q being Nat st q in dom text holds
       ex b being Nat st b = text.q & b < 256) &
    (for sht being Element of T, c being Nat st
       c in mapDom.sht
     holds
       c < 256 &
       ex v being Integer st
         v = (mapVal.sht).c &
         -(2 |^ 62) <= v & v <= (2 |^ 62) - 1) &
    (for p,t being FinSequence of NAT, q being Integer holds
       ([p,[t,q]] in MatchesRel iff
         (0 <= q & q <= len t - len p) &
         (for k being Integer st 0 <= k & k < len p holds
            nthElem.[t,q+k] = nthElem.[p,k]))) &
    (for j being Integer st 0 <= j & j < len pat1 holds
       nthElem.[pat1,j] in mapDom.sht1) &
    (for c being Nat st c in mapDom.sht1 holds
       ex v being Integer st
         v = (mapVal.sht1).c &
         1 <= v & v <= len pat1 + 1) &
    (for c being Nat st c in mapDom.sht1 holds
       ex v being Integer st
         v = (mapVal.sht1).c &
         (for j being Integer st 1 <= j & j < v holds
            nthElem.[pat1,len pat1-j] <> c)) &
    len pat1 <= len text
  holds
    for m being Integer st
      -(2 |^ 62) <= m & m <= (2 |^ 62) - 1
    holds
      (m = len pat1 & 0 <= len pat1 implies
        for n being Integer st
          -(2 |^ 62) <= n & n <= (2 |^ 62) - 1
        holds
          (n = len text & 0 <= len text implies
            ((0 <= 0 & 0 <= n) &
             (for j being Integer st 0 <= j & j < 0 holds
                (j <= n-m implies
                  not [pat1,[text,j]] in MatchesRel))) &
            (for i being Integer st
               -(2 |^ 62) <= i & i <= (2 |^ 62) - 1
             holds
               ((0 <= i & i <= n) &
                (for j being Integer st 0 <= j & j < i holds
                   (j <= n-m implies
                     not [pat1,[text,j]] in MatchesRel))
                implies
                  (-(2 |^ 62) <= n-m &
                    n-m <= (2 |^ 62) - 1) &
                  (for o1 being Integer st
                     -(2 |^ 62) <= o1 &
                     o1 <= (2 |^ 62) - 1
                   holds
                     (o1 = n-m implies
                       (i <= o1 implies
                         (0 <= i &
                          i <= len text - len pat1) &
                         ([pat1,[text,i]] in MatchesRel implies
                           (-1 <= i &
                            i <= len text - len pat1) &
                           ((i = -1 implies
                              for j being Integer holds
                                not [pat1,[text,j]]
                                  in MatchesRel) &
                            (i <> -1 implies
                              [pat1,[text,i]] in MatchesRel))) &
                         (not [pat1,[text,i]] in MatchesRel implies
                           (-(2 |^ 62) <= n-m &
                             n-m <= (2 |^ 62) - 1) &
                           (for o2 being Integer st
                              -(2 |^ 62) <= o2 &
                              o2 <= (2 |^ 62) - 1
                            holds
                              (o2 = n-m implies
                                ((i = o2 implies i = o2) implies
                                  (i = o2 implies
                                    (-1 <= -1 &
                                     -1 <= len text - len pat1) &
                                    (for j being Integer holds
                                       not [pat1,[text,j]]
                                         in MatchesRel)) &
                                  (i <> o2 implies
                                    (-(2 |^ 62) <= i+m &
                                      i+m <= (2 |^ 62) - 1) &
                                    (for o3 being Integer st
                                       -(2 |^ 62) <= o3 &
                                       o3 <= (2 |^ 62) - 1
                                     holds
                                       (o3 = i+m implies
                                         (0 <= o3 &
                                          o3 < len text) &
                                         (for c being Nat st
                                            c =
                                              nthElem.[text,o3]
                                          holds
                                            ((c in mapDom.sht1
                                                implies
                                                c in mapDom.sht1) &
                                             (not c in mapDom.sht1
                                                implies
                                                (-(2 |^ 62) <= m+1 &
                                                  m+1 <=
                                                    (2 |^ 62) - 1))) &
                                            (for o4 being Integer st
                                               -(2 |^ 62) <= o4 &
                                               o4 <= (2 |^ 62) - 1
                                             holds
                                               (((c in mapDom.sht1 &
                                                   o4 =
                                                     (mapVal.sht1).c &
                                                   o4 =
                                                     (mapVal.sht1).c) or
                                                  (not c in mapDom.sht1 &
                                                   o4 = m+1))
                                                implies
                                                  (-(2 |^ 62) <= i+o4 &
                                                    i+o4 <=
                                                      (2 |^ 62) - 1) &
                                                  (for o5
                                                     being Integer st
                                                     -(2 |^ 62) <= o5 &
                                                     o5 <=
                                                       (2 |^ 62) - 1
                                                   holds
                                                     (o5 = i+o4
                                                      implies
                                                        (0 <= n-m-i &
                                                         n-m-o5 <
                                                           n-m-i) &
                                                        (0 <= o5 &
                                                         o5 <= n) &
                                                        (for j
                                                           being Integer st
                                                           0 <= j &
                                                           j < o5
                                                         holds
                                                           (j <= n-m
                                                            implies
                                                              not
                                                                [pat1,
                                                                  [text,j]]
                                                                in
                                                                  MatchesRel
                                                         ))))))))))))))) &
                       (not i <= o1 implies
                         (-1 <= -1 &
                          -1 <= len text - len pat1) &
                         (for j being Integer holds
                            not [pat1,[text,j]] in MatchesRel))))))))
proof
end;
::$P+
