:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/isqrt_Simple_isqrtqtvc: the simple integer-square-root verification
:: condition establishes initialization and loop-step square bounds for a
:: nonnegative integer. This file contains no proof.

environ
  vocabularies NUMBERS, INT_1, NAT_1, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0,
    SUBSET_1;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, NAT_1;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, CARD_1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Integer st
    0 <= x
  holds
    0 <= 0 &
    0 * 0 <= x &
    1 = (0 + 1) * (0 + 1) &
    (for count being Integer st
      0 <= count &
      count * count <= x
     holds
      (((count + 1) * (count + 1) <= x implies
          (0 <= x - count &
           x - (count + 1) < x - count) &
          0 <= count + 1 &
          (count + 1) * (count + 1) <= x &
          (count + 1) * (count + 1) +
              (2 * (count + 1) + 1) =
            (count + 1 + 1) * (count + 1 + 1)) &
       (not (count + 1) * (count + 1) <= x implies
          0 <= count &
          count * count <= x &
          x < (count + 1) * (count + 1))))
proof
end;
::$P+
