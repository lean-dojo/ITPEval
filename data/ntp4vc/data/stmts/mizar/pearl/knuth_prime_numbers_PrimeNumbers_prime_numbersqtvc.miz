:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/knuth_prime_numbers_PrimeNumbers_prime_numbersqtvc: the verification
:: condition, under Bertrand's postulate, for initializing and extending a
:: table of consecutive prime numbers by testing odd candidates. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, INT_2, NAT_1, NAT_3, VALUED_0, VALUED_1,
    ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4, FUNCOP_1,
    FUNCT_7, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, INT_2, NAT_1, NAT_D, NEWTON, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, INT_2, XXREAL_0,
    ZFMISC_1, NAT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, INT_2, NAT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for PrimeInt being Subset of INT,
      NoPrimeIn being Subset of [:INT,INT:],
      FirstPrimes being Subset of [:Funcs(INT,INT),INT:] st
    (for z being Integer holds
      (z in PrimeInt iff
        ex q being Nat st z = q & q is prime)) &
    (for l,u being Integer holds
      ([l,u] in NoPrimeIn iff
        for x being Integer st l < x & x < u
        holds not x in PrimeInt)) &
    (for p being Integer st p in PrimeInt
     holds not [p,2*p] in NoPrimeIn) &
    (for f being Function of INT,INT, u being Integer holds
      ([f,u] in FirstPrimes iff
        f.0 = 2 &
        (for i,j being Integer st
          0 <= i & i < j & j < u
         holds
          ex fi,fj being Integer st
            fi = f.i & fj = f.j & fi < fj) &
        (for i being Integer st 0 <= i & i < u
         holds f.i in PrimeInt) &
        (for i being Integer st 0 <= i & i < u - 1
         holds [f.i,f.(i+1)] in NoPrimeIn)))
  holds
    for m being Integer st 2 <= m holds
      0 <= m &
      (for p being Function of INT,INT st
        (for q being Integer st q < 0 holds p.q = p.0) &
        (for q being Integer st m <= q holds p.q = 0) &
        (for i being Integer st 0 <= i & i < m
         holds p.i = 0)
       holds
        0 <= 0 & 0 < m &
        (for p0 being Function of INT,INT st
          p0 = p+*(0,2)
         holds
          0 <= 1 & 1 < m &
          (for pInit being Function of INT,INT st
            pInit = p0+*(1,3)
           holds
            (2 <= (m-1)+1 implies
              ex pInitLast being Integer st
              pInitLast = pInit.(2-1) &
              [pInit,2] in FirstPrimes &
              (pInitLast < 5 &
                5 < 2*pInitLast) &
              5 mod 2 = 1 &
              [pInitLast,5] in NoPrimeIn &
              (for n being Integer,
                   p1 being Function of INT,INT st
                (for q being Integer st q < 0
                 holds p1.q = p1.0) &
                (for q being Integer st m <= q
                 holds p1.q = 0)
               holds
                (for j,p1Last being Integer st
                  p1Last = p1.(j-1) &
                  (2 <= j & j <= m-1) &
                  [p1,j] in FirstPrimes &
                  (p1Last < n &
                    n < 2*p1Last) &
                  n mod 2 = 1 &
                  [p1Last,n] in NoPrimeIn
                 holds
                  (for n1 being Integer,
                       p2 being Function of INT,INT st
                    (for q being Integer st q < 0
                     holds p2.q = p2.0) &
                    (for q being Integer st m <= q
                     holds p2.q = 0)
                   holds
                    for k,p2Last,p2k being Integer st
                      p2Last = p2.(j-1) &
                      p2k = p2.k &
                      (1 <= k & k < j) &
                      [p2,j] in FirstPrimes &
                      (p2Last < n1 &
                        n1 < 2*p2Last) &
                      n1 mod 2 = 1 &
                      [p2Last,n1] in NoPrimeIn &
                      (for i being Integer st
                        0 <= i & i < k
                       holds
                        ex p2i being Integer st
                          p2i = p2.i & not p2i divides n1)
                    holds
                      (0 <= k & k < m) &
                      p2k <> 0 &
                      ((n1 mod p2k = 0 implies
                        (((0 <= 2*p2Last-n1 &
                            2*p2Last-(n1+2) <
                              2*p2Last-n1) or
                           (2*p2Last-n1 =
                              2*p2Last-(n1+2) &
                            0 <= j-k &
                            j-1 < j-k)) &
                         (1 <= 1 & 1 < j) &
                         [p2,j] in FirstPrimes &
                         (p2Last < n1+2 &
                           n1+2 < 2*p2Last) &
                         (n1+2) mod 2 = 1 &
                         [p2Last,n1+2] in NoPrimeIn &
                         (for i being Integer st
                           0 <= i & i < 1
                          holds
                           ex p2i being Integer st
                             p2i = p2.i &
                             not p2i divides n1+2))) &
                       (not n1 mod p2k = 0 implies
                        (0 <= k & k < m) &
                        (0 <= k & k < m) &
                        p2k <> 0 &
                        ((p2k < n1 div p2k implies
                          (((0 <= 2*p2Last-n1 &
                              2*p2Last-n1 <
                                2*p2Last-n1) or
                             (0 <= j-k &
                              j-(k+1) < j-k)) &
                           (1 <= k+1 & k+1 < j) &
                           [p2,j] in FirstPrimes &
                           (p2Last < n1 &
                             n1 < 2*p2Last) &
                           n1 mod 2 = 1 &
                           [p2Last,n1] in NoPrimeIn &
                           (for i being Integer st
                             0 <= i & i < k+1
                            holds
                             ex p2i being Integer st
                               p2i = p2.i &
                               not p2i divides n1))) &
                         (not p2k < n1 div p2k implies
                          p2Last < n1 &
                          n1 in PrimeInt &
                          [p2Last,n1] in NoPrimeIn))))) &
                  ((1 <= 1 & 1 < j) &
                    [p1,j] in FirstPrimes &
                    (p1Last < n &
                      n < 2*p1Last) &
                    n mod 2 = 1 &
                    [p1Last,n] in NoPrimeIn &
                    (for i being Integer st
                      0 <= i & i < 1
                     holds
                      ex p1i being Integer st
                        p1i = p1.i & not p1i divides n)) &
                  (for n1 being Integer st
                    p1Last < n1 &
                    n1 in PrimeInt &
                    [p1Last,n1] in NoPrimeIn
                   holds
                    0 <= j & j < m &
                    (for p3 being Function of INT,INT st
                      p3 = p1+*(j,n1)
                     holds
                      ex p3Last being Integer st
                        p3Last = p3.(j+1-1) &
                        [p3,j+1] in FirstPrimes &
                        (p3Last < n1+2 &
                          n1+2 < 2*p3Last) &
                        (n1+2) mod 2 = 1 &
                        [p3Last,n1+2] in NoPrimeIn))) &
                ((ex p1Last being Integer st
                    p1Last = p1.((m-1)+1-1) &
                    [p1,(m-1)+1] in FirstPrimes &
                    (p1Last < n &
                      n < 2*p1Last) &
                    n mod 2 = 1 &
                    [p1Last,n] in NoPrimeIn)
                 implies
                  m = m &
                  [p1,m] in FirstPrimes)) &
            ((m-1)+1 < 2 implies
              m = m &
              [pInit,m] in FirstPrimes)))))
proof
end;
::$P+
