:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/mergesort_list_OCamlMergesort_chopqtvc: the list-chopping
:: verification condition establishes the recursive size obligations and
:: reconstructs a list from its prefix and remainder. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being non empty set,
      prefFn being Function of [:INT,E*:],E*,
      n being Integer,
      l being FinSequence of E
  st
    (for s being FinSequence of E holds
       prefFn.[0,s] = <*>E) &
    (for m being Integer,
         x being Element of E,
         t being FinSequence of E st 0 < m
     holds
       prefFn.[m,<*x*> ^ t] = <*x*> ^ prefFn.[m-1,t]) &
    0 <= n &
    n <= len l
  holds
    (n <> 0 implies
       ex x being Element of E,
          t being FinSequence of E st
         l = <*x*> ^ t &
         (0 <= n & n-1 < n) &
         0 <= n-1 &
         n-1 <= len t) &
    (for result being FinSequence of E holds
       (((n = 0 & result = l) or
         (n <> 0 &
          ex x being Element of E,
             t being FinSequence of E st
            l = <*x*> ^ t &
            t = prefFn.[n-1,t] ^ result))
        implies
          l = prefFn.[n,l] ^ result))
proof
end;
::$P+
