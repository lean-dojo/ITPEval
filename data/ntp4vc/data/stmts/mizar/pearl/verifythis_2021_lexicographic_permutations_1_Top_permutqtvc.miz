:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_lexicographic_permutations_1_Top_permutqtvc: the
:: verification condition for enumerating all integer-sequence permutations
:: in strict lexicographic order, including the loop invariant, finite-set
:: termination variant, and completeness postcondition. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FINSET_1, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FINSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, FRAENKEL, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for nthI being Function of [:INT*,INT:],INT,
      nthS being Function of [:(INT*)*,INT:],INT*,
      ToSeq being Function of INT*,INT*,
      AllPermutations being Function of INT*,bool INT*,
      setCard being Function of (bool INT*),INT,
      LexLess,Permuting,SeqCopy being Subset of [:INT*,INT*:],
      Ascending being Subset of INT*,
      SnocSpec being
        Subset of [:(INT*)*,[:(INT*)*,INT*:]:],
      LoopInv being
        Subset of
          [:(bool INT*),[:INT*,[:(bool INT*),[:(INT*)*,INT*:]:]:]:],
      Complete being Subset of [:INT*,(INT*)*:]
  st
    (for s being FinSequence of INT, k being Integer holds
       (len s = 0 implies nthI.[s,k] = 0) &
       (0 < len s & k < 0 implies nthI.[s,k] = s.1) &
       (0 <= k & k < len s implies nthI.[s,k] = s.(k+1)) &
       (len s <= k implies nthI.[s,k] = 0)) &
    (for s being FinSequence of INT*, k being Integer holds
       (len s = 0 implies nthS.[s,k] = <*>INT) &
       (0 < len s & k < 0 implies nthS.[s,k] = s.1) &
       (0 <= k & k < len s implies nthS.[s,k] = s.(k+1)) &
       (len s <= k implies nthS.[s,k] = <*>INT)) &
    (for p,q being FinSequence of INT holds
       ([p,q] in LexLess iff
         len p = len q & 0 < len q &
         ex i being Integer st
           0 <= i & i < len p &
           (for j being Integer st 0 <= j & j < i
            holds nthI.[p,j] = nthI.[q,j]) &
           nthI.[p,i] < nthI.[q,i])) &
    (for p,q being FinSequence of INT holds
       ([p,q] in Permuting iff
         len p = len q &
         for x being Integer holds
           card {k where k is Integer :
             0 <= k & k < len p & nthI.[p,k] = x} =
           card {k where k is Integer :
             0 <= k & k < len q & nthI.[q,k] = x})) &
    (for s,a being FinSequence of INT holds
       ([s,a] in SeqCopy iff
         len s = len a &
         for i being Integer st 0 <= i & i < len s
         holds nthI.[s,i] = nthI.[a,i])) &
    (for a being FinSequence of INT holds [ToSeq.a,a] in SeqCopy) &
    (for a being FinSequence of INT holds
       (AllPermutations.a is finite) &
       (for p being FinSequence of INT st [p,a] in Permuting
        holds p in AllPermutations.a)) &
    (for s being finite Subset of INT* holds setCard.s = card s) &
    (for a being FinSequence of INT holds
       (a in Ascending iff
         for i,j being Integer st
           0 <= i & i <= j & j < len a
         holds nthI.[a,i] <= nthI.[a,j])) &
    (for preseq,result being FinSequence of INT*,
         x being FinSequence of INT holds
       ([preseq,[result,x]] in SnocSpec iff
         len result = 1 + len preseq &
         nthS.[result,len preseq] = x &
         for i being Integer st 0 <= i & i < len preseq
         holds nthS.[result,i] = nthS.[preseq,i])) &
    (for all1,seen being finite Subset of INT*,
         a0,current being FinSequence of INT,
         result being FinSequence of INT* holds
       ([all1,[a0,[seen,[result,current]]]] in LoopInv iff
         0 < len result &
         [current,a0] in Permuting &
         (for i being Integer st 0 <= i & i < len result
          holds [nthS.[result,i],a0] in Permuting) &
         nthS.[result,len result-1] = current &
         [nthS.[result,len result-1],a0] in Permuting &
         (for i,j being Integer st
            0 <= i & i < j & j < len result
          holds [nthS.[result,i],nthS.[result,j]] in LexLess) &
         (for p being FinSequence of INT st
            [p,a0] in Permuting & [p,current] in LexLess
          holds
            ex i being Integer st
              0 <= i & i < len result-1 &
              nthS.[result,i] = p) &
         (for p being FinSequence of INT holds
            (p in seen iff
              ex i being Integer st
                0 <= i & i < len result &
                nthS.[result,i] = p)) &
         seen c= all1)) &
    (for a being FinSequence of INT,
         result being FinSequence of INT* holds
       ([a,result] in Complete iff
         (for i being Integer st 0 <= i & i < len result
          holds [nthS.[result,i],a] in Permuting) &
         (for i,j being Integer st
            0 <= i & i < j & j < len result
          holds [nthS.[result,i],nthS.[result,j]] in LexLess) &
         (for p being FinSequence of INT st [p,a] in Permuting
          holds
            ex i being Integer st
              0 <= i & i < len result &
              nthS.[result,i] = p)))
  holds
    for a being FinSequence of INT holds
      for a0 being FinSequence of INT st a0 = ToSeq.a holds
        [a0,a] in SeqCopy implies
          for all1 being finite Subset of INT* st
            all1 = AllPermutations.a0
          holds
            (for p being FinSequence of INT st [p,a0] in Permuting
             holds p in all1) implies
              for a1 being FinSequence of INT holds
                (len a1 = len a &
                 a1 in Ascending &
                 [ToSeq.a1,ToSeq.a] in Permuting) implies
                    for o1 being FinSequence of INT st
                      o1 = ToSeq.a1
                    holds
                      [o1,a1] in SeqCopy implies
                        for o2 being FinSequence of INT* st
                          o2 = <*>INT*
                        holds
                          for o3 being FinSequence of INT* st
                            o3 = o2 ^ <*o1*>
                          holds
                            [o2,[o3,o1]] in SnocSpec implies
                              for o4 being FinSequence of INT st
                                o4 = ToSeq.a1
                              holds
                                [o4,a1] in SeqCopy implies
                                  for o5 being FinSequence of INT st
                                    o5 = ToSeq.a1
                                  holds
                                    [o5,a1] in SeqCopy implies
                                      for o6 being
                                          finite Subset of INT* st
                                        o6 = {o5}
                                      holds
                                        ([ToSeq.a1,a0] in Permuting &
                                         o4 = ToSeq.a1 &
                                         [all1,[a0,
                                           [o6,[o3,o4]]]] in LoopInv) &
                                        (for sresult being
                                               finite Subset of INT*,
                                             result being
                                               FinSequence of INT*,
                                             a2 being
                                               FinSequence of INT
                                         holds
                                           (len a2 = len a1 &
                                            [all1,[a0,
                                              [sresult,
                                                [result,ToSeq.a2]]]]
                                              in LoopInv) implies
                                               (len a2 = len a0 &
                                                [ToSeq.a2,a0]
                                                  in Permuting) &
                                               (for a3 being
                                                    FinSequence of INT
                                                holds
                                                  len a3 = len a2
                                                  implies
                                                  for o7 being
                                                      Element of BOOLEAN
                                                  holds
                                                    ([ToSeq.a3,a0]
                                                       in Permuting &
                                                     (o7 <> TRUE implies
                                                       [a3,a2]
                                                         in SeqCopy) &
                                                     (o7 <> TRUE implies
                                                       for p being
                                                           FinSequence of
                                                             INT st
                                                         [p,a0]
                                                           in Permuting
                                                       holds
                                                         not
                                                           [ToSeq.a3,p]
                                                             in LexLess) &
                                                     (o7 = TRUE implies
                                                       [ToSeq.a2,
                                                        ToSeq.a3]
                                                         in LexLess) &
                                                     (o7 = TRUE implies
                                                       for p being
                                                           FinSequence of
                                                             INT st
                                                         [p,a0]
                                                           in Permuting
                                                       holds
                                                         not
                                                           ([ToSeq.a2,p]
                                                              in LexLess &
                                                            [p,ToSeq.a3]
                                                              in LexLess)))
                                                    implies
                                                      ((o7 = TRUE implies
                                                        for o8 being
                                                            FinSequence of
                                                              INT st
                                                          o8 = ToSeq.a3
                                                        holds
                                                          [o8,a3]
                                                            in SeqCopy
                                                          implies
                                                          for o9 being
                                                              FinSequence of
                                                                INT* st
                                                            o9 =
                                                              result ^
                                                                <*o8*>
                                                          holds
                                                            [result,
                                                              [o9,o8]]
                                                              in SnocSpec
                                                            implies
                                                            for o10 being
                                                                FinSequence
                                                                  of INT st
                                                              o10 =
                                                                ToSeq.a3
                                                            holds
                                                              [o10,a3]
                                                                in SeqCopy
                                                              implies
                                                              for o11 being
                                                                  FinSequence
                                                                    of INT st
                                                                o11 =
                                                                  ToSeq.a3
                                                              holds
                                                                [o11,a3]
                                                                  in SeqCopy
                                                                implies
                    (0 <= setCard.all1 - setCard.sresult &
                     setCard.all1 - setCard.(sresult \/ {o11}) <
                       setCard.all1 - setCard.sresult) &
                    [ToSeq.a3,a0] in Permuting &
                    o10 = ToSeq.a3 &
                    [all1,[a0,[sresult \/ {o11},[o9,o10]]]]
                      in LoopInv) &
(o7 <> TRUE implies
  [ToSeq.a,result]
    in Complete))))
proof
end;
::$P+
