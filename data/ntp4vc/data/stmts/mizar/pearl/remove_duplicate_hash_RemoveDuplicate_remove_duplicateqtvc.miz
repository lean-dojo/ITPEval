:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/remove_duplicate_hash_RemoveDuplicate_remove_duplicateqtvc: the
:: duplicate-removal verification condition for mutable finite-set
:: accumulation, array initialization, loop invariants, cardinal updates,
:: and duplicate-free output. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1,
    FRAENKEL;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,S being non empty set,
      defaultElt being Element of E,
      toFSet being Function of S,bool E,
      choose1 being Function of S,E,
      setCard being Function of (bool E),INT,
      nthElem being Function of [:E*,INT:],E,
      setList being Function of [:[:E*,INT:],E:],E*,
      Appears being Subset of [:E,[:E*,INT:]:],
      NoDup being Subset of [:E*,INT:],
      a being FinSequence of E,
      s being Element of S
  st
    (for state being Element of S holds toFSet.state is finite) &
    (for state being Element of S st toFSet.state <> {}
       holds choose1.state in toFSet.state) &
    (for h being finite Subset of E holds setCard.h = card h) &
    (for xs being FinSequence of E, i being Integer holds
       (i < 0 & len xs = 0 implies
          nthElem.[xs,i] = defaultElt) &
       (i < 0 & 0 < len xs implies
          nthElem.[xs,i] = xs.1) &
       (0 <= i & i < len xs implies
          nthElem.[xs,i] = xs.(i+1)) &
       (len xs <= i implies
          nthElem.[xs,i] = defaultElt)) &
    (for x being Element of E, xs being FinSequence of E,
         upper being Integer holds
       ([x,[xs,upper]] in Appears iff
         ex i being Integer st
           0 <= i & i < upper & nthElem.[xs,i] = x)) &
    (for xs being FinSequence of E, upper being Integer holds
       ([xs,upper] in NoDup iff
         for i being Integer st 0 <= i & i < upper
         holds not [nthElem.[xs,i],[xs,i]] in Appears)) &
    1 <= len a &
    toFSet.s = {} &
    setCard.(toFSet.s) = 0
  holds
    for o1 being Integer st o1 = len a - 1 holds
      (0 <= o1+1 implies
        (for x being Element of E holds
           ([x,[a,0]] in Appears iff x in toFSet.s)) &
        (for s1 being Element of S holds
           for i being Integer st
             (0 <= i & i <= o1) &
             (for x being Element of E holds
                ([x,[a,i]] in Appears iff x in toFSet.s1))
           holds
             0 <= i & i < len a &
             (for s2 being Element of S st
                toFSet.s2 =
                  toFSet.s1 \/ {nthElem.[a,i]} &
                (nthElem.[a,i] in toFSet.s1 implies
                   setCard.(toFSet.s2) =
                     setCard.(toFSet.s1)) &
                (not nthElem.[a,i] in toFSet.s1 implies
                   setCard.(toFSet.s2) =
                     setCard.(toFSet.s1) + 1)
              holds
                for x being Element of E holds
                  ([x,[a,i+1]] in Appears iff
                    x in toFSet.s2)))) &
      (for saved being Element of S st
         (o1+1 < 0 & saved = s) or
         (0 <= o1+1 &
           (for x being Element of E holds
              ([x,[a,o1+1]] in Appears iff
                x in toFSet.saved)))
       holds
         0 <= 0 & 0 < len a &
         (for o2 being Integer st
            o2 = setCard.(toFSet.saved)
          holds
            0 <= o2 &
            (for r being FinSequence of E st
               (for i being Integer st 0 <= i & i < o2
                  holds nthElem.[r,i] = nthElem.[a,0]) &
               len r = o2
             holds
               for emptyState being Element of S st
                 toFSet.emptyState = {}
               holds
                 for o3 being Integer st o3 = len a - 1
                 holds
                   (0 <= o3+1 implies
                     ((for x being Element of E holds
                         ([x,[a,0]] in Appears iff
                           x in toFSet.emptyState)) &
                      (for x being Element of E holds
                         (x in toFSet.emptyState iff
                           [x,[r,0]] in Appears)) &
                      [r,0] in NoDup &
                      0 <= 0 &
                      0 = setCard.(toFSet.emptyState) &
                      setCard.(toFSet.emptyState) <= len r &
                      toFSet.emptyState c= toFSet.saved) &
                     (for j being Integer,
                          r1 being FinSequence of E,
                          current being Element of S st
                        len r1 = len r
                      holds
                        (for i being Integer st
                           (0 <= i & i <= o3) &
                           (for x being Element of E holds
                              ([x,[a,i]] in Appears iff
                                x in toFSet.current)) &
                           (for x being Element of E holds
                              (x in toFSet.current iff
                                [x,[r1,j]] in Appears)) &
                           [r1,j] in NoDup &
                           0 <= j &
                           j = setCard.(toFSet.current) &
                           setCard.(toFSet.current) <= len r1 &
                           toFSet.current c= toFSet.saved
                         holds
                           0 <= i & i < len a &
                           ((not nthElem.[a,i] in toFSet.current
                             implies
                               0 <= i & i < len a &
                               (for updated being Element of S st
                                  toFSet.updated =
                                    toFSet.current \/
                                      {nthElem.[a,i]} &
                                  (nthElem.[a,i] in
                                      toFSet.current implies
                                    setCard.(toFSet.updated) =
                                      setCard.(toFSet.current)) &
                                  (not nthElem.[a,i] in
                                      toFSet.current implies
                                    setCard.(toFSet.updated) =
                                      setCard.(toFSet.current) + 1)
                                holds
                                  0 <= i & i < len a &
                                  0 <= j & j < len r1 &
                                  (len (setList.
                                      [[r1,j],nthElem.[a,i]]) =
                                      len r1
                                   implies
                                    ((for q being Integer holds
                                       (q = j implies
                                         nthElem.
                                           [setList.
                                             [[r1,j],
                                               nthElem.[a,i]],q] =
                                           nthElem.[a,i]) &
                                       (q <> j implies
                                         nthElem.
                                           [setList.
                                             [[r1,j],
                                               nthElem.[a,i]],q] =
                                           nthElem.[r1,q]))
                                     implies
                                       (for x being Element of E
                                          holds
                                            ([x,[a,i+1]] in Appears
                                              iff
                                             x in
                                               toFSet.updated)) &
                                       (for x being Element of E
                                          holds
                                            (x in toFSet.updated iff
                                             [x,
                                               [setList.
                                                 [[r1,j],
                                                   nthElem.[a,i]],
                                                j+1]]
                                               in Appears)) &
                                       [setList.
                                          [[r1,j],nthElem.[a,i]],
                                        j+1] in NoDup &
                                       0 <= j+1 &
                                       j+1 =
                                         setCard.
                                           (toFSet.updated) &
                                       setCard.(toFSet.updated) <=
                                         len (setList.
                                           [[r1,j],
                                             nthElem.[a,i]]) &
                                       toFSet.updated c=
                                         toFSet.saved)))) &
                            (nthElem.[a,i] in toFSet.current
                             implies
                               (for x being Element of E holds
                                  ([x,[a,i+1]] in Appears iff
                                    x in toFSet.current)) &
                               (for x being Element of E holds
                                  (x in toFSet.current iff
                                    [x,[r1,j]] in Appears)) &
                               [r1,j] in NoDup &
                               0 <= j &
                               j = setCard.(toFSet.current) &
                               setCard.(toFSet.current) <=
                                 len r1 &
                               toFSet.current c=
                                 toFSet.saved))) &
                        (((for x being Element of E holds
                             ([x,[a,o3+1]] in Appears iff
                               x in toFSet.current)) &
                          (for x being Element of E holds
                             (x in toFSet.current iff
                               [x,[r1,j]] in Appears)) &
                          [r1,j] in NoDup &
                          0 <= j &
                          j = setCard.(toFSet.current) &
                          setCard.(toFSet.current) <= len r1 &
                          toFSet.current c= toFSet.saved)
                         implies
                           [r1,len r1] in NoDup &
                           (for x being Element of E holds
                              ([x,[a,len a]] in Appears iff
                                [x,[r1,len r1]] in Appears)))))
                    &
                   (o3+1 < 0 implies
                     [r,len r] in NoDup &
                     (for x being Element of E holds
                        ([x,[a,len a]] in Appears iff
                          [x,[r,len r]] in Appears))))))
proof
end;
::$P+
