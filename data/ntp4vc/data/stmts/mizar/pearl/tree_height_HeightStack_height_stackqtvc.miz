:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/tree_height_HeightStack_height_stackqtvc: the verification condition
:: for computing binary-tree height with an explicit stack, including its
:: lexicographic termination decrease and universal result equation.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size,Height being Function of Tree,INT,
      Heights,Sizes being Function of [:INT,Tree:]*,INT,
      m being Integer,
      s being FinSequence of [:INT,Tree:]
  st
    (for l,r being Element of Tree,
         y being Element of E
     holds
       node.[l,[y,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          y being Element of E st
         u = node.[l,[y,r]]) &
    (for l,l2,r,r2 being Element of Tree,
         y,y2 being Element of E st
       node.[l,[y,r]] = node.[l2,[y2,r2]]
     holds
       l = l2 & y = y2 & r = r2) &
    (for X being Subset of Tree st
       emptyT in X &
       (for l,r being Element of Tree,
            y being Element of E st
          l in X & r in X
        holds
          node.[l,[y,r]] in X)
     holds
       X = Tree) &
    Size.emptyT = 0 &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       Size.(node.[l,[y,r]]) = 1 + Size.l + Size.r) &
    Height.emptyT = 0 &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       Height.(node.[l,[y,r]]) =
         1 + max(Height.l,Height.r)) &
    Heights.(<*>([:INT,Tree:])) = 0 &
    Sizes.(<*>([:INT,Tree:])) = 0 &
    (for h being Integer,
         t being Element of Tree,
         rest being FinSequence of [:INT,Tree:]
     holds
       ex treeHeight,restHeights,allHeights,
          treeSize,restSizes,allSizes being Integer st
         treeHeight = Height.t &
         restHeights = Heights.rest &
         allHeights = Heights.(<*[h,t]*> ^ rest) &
         allHeights = max(h + treeHeight,restHeights) &
         treeSize = Size.t &
         restSizes = Sizes.rest &
         allSizes = Sizes.(<*[h,t]*> ^ rest) &
         allSizes = treeSize + restSizes) &
    0 <= m
  holds
    (s = <*>([:INT,Tree:]) or
     (ex h being Integer,
         sizeCurrent,sizeRest being Integer,
         rest being FinSequence of [:INT,Tree:] st
        s = <*[h,emptyT]*> ^ rest &
        sizeCurrent = Sizes.s &
        sizeRest = Sizes.rest &
        (((0 <= sizeCurrent & sizeRest < sizeCurrent) or
          (sizeCurrent = sizeRest & rest = rest)) &
         0 <= max(m,h))) or
     ex h,sizeCurrent,sizeNext being Integer,
        l,r being Element of Tree,
        y being Element of E,
        rest,next being FinSequence of [:INT,Tree:] st
       s = <*[h,node.[l,[y,r]]]*> ^ rest &
       next =
         <*[h+1,l]*> ^ (<*[h+1,r]*> ^ rest) &
       sizeCurrent = Sizes.s &
       sizeNext = Sizes.next &
       (((0 <= sizeCurrent & sizeNext < sizeCurrent) or
         (sizeCurrent = sizeNext & rest = next)) &
        0 <= m)) &
    (for result being Integer st
       ((s = <*>([:INT,Tree:]) & result = m) or
        (ex h being Integer,
            restHeights being Integer,
            rest being FinSequence of [:INT,Tree:] st
           s = <*[h,emptyT]*> ^ rest &
           restHeights = Heights.rest &
           result = max(max(m,h),restHeights)) or
        ex h,nextHeights being Integer,
           l,r being Element of Tree,
           y being Element of E,
           rest,next being FinSequence of [:INT,Tree:] st
          s = <*[h,node.[l,[y,r]]]*> ^ rest &
          next =
            <*[h+1,l]*> ^ (<*[h+1,r]*> ^ rest) &
          nextHeights = Heights.next &
          result = max(m,nextHeights))
     holds
       ex stackHeights being Integer st
         stackHeights = Heights.s &
         result = max(m,stackHeights))
proof
end;
::$P+
