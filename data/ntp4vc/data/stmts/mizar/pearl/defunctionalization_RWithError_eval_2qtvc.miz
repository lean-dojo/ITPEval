:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/defunctionalization_RWithError_eval_2qtvc: the error-aware
:: defunctionalized expression-evaluation continuation verification condition,
:: including context size decrease, recomposition, and evaluation preservation.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Expr,Context,Value being non empty set,
      cte being Function of INT,Expr,
      sube being Function of [:Expr,Expr:],Expr,
      emptyCtx being Element of Context,
      leftCtx being Function of [:Context,Expr:],Context,
      rightCtx being Function of [:INT,Context:],Context,
      vnum being Function of INT,Value,
      underflow being Element of Value,
      sizeE being Function of Expr,INT,
      sizeC being Function of Context,INT,
      recompose being Function of [:Context,Expr:],Expr,
      evalErr being Function of Expr,Value,
      n being Integer,
      c being Element of Context
  st
    (for x,y being Integer st cte.x = cte.y holds x = y) &
    (for e1,e2,f1,f2 being Element of Expr st
       sube.[e1,e2] = sube.[f1,f2]
     holds e1 = f1 & e2 = f2) &
    (for x being Integer, e1,e2 being Element of Expr
     holds cte.x <> sube.[e1,e2]) &
    (for e0 being Element of Expr holds
       (ex x being Integer st e0 = cte.x) or
       ex e1,e2 being Element of Expr st e0 = sube.[e1,e2]) &
    (for X being Subset of Expr st
       (for x being Integer holds cte.x in X) &
       (for e1,e2 being Element of Expr st e1 in X & e2 in X
        holds sube.[e1,e2] in X)
     holds X = Expr) &
    (for c1,c2 being Element of Context,
         e1,e2 being Element of Expr st
       leftCtx.[c1,e1] = leftCtx.[c2,e2]
     holds c1 = c2 & e1 = e2) &
    (for x1,x2 being Integer, c1,c2 being Element of Context st
       rightCtx.[x1,c1] = rightCtx.[x2,c2]
     holds x1 = x2 & c1 = c2) &
    (for c1,c2 being Element of Context, e0 being Element of Expr,
         x being Integer
     holds leftCtx.[c1,e0] <> rightCtx.[x,c2]) &
    (for c1 being Element of Context, e0 being Element of Expr
     holds leftCtx.[c1,e0] <> emptyCtx) &
    (for x being Integer, c1 being Element of Context
     holds rightCtx.[x,c1] <> emptyCtx) &
    (for c0 being Element of Context holds
       c0 = emptyCtx or
       (ex c1 being Element of Context, e0 being Element of Expr st
          c0 = leftCtx.[c1,e0]) or
       ex x being Integer, c1 being Element of Context st
          c0 = rightCtx.[x,c1]) &
    (for K being Subset of Context st
       emptyCtx in K &
       (for c1 being Element of Context, e0 being Element of Expr
          st c1 in K holds leftCtx.[c1,e0] in K) &
       (for x being Integer, c1 being Element of Context
          st c1 in K holds rightCtx.[x,c1] in K)
     holds K = Context) &
    (for x,y being Integer st vnum.x = vnum.y holds x = y) &
    (for x being Integer holds vnum.x <> underflow) &
    (for v being Element of Value holds
       v = underflow or ex x being Integer st v = vnum.x) &
    (for x being Integer holds sizeE.(cte.x) = 1) &
    (for e1,e2 being Element of Expr holds
       sizeE.(sube.[e1,e2]) = 3 + sizeE.e1 + sizeE.e2) &
    sizeC.emptyCtx = 0 &
    (for c1 being Element of Context, e0 being Element of Expr holds
       sizeC.(leftCtx.[c1,e0]) = 2 + sizeC.c1 + sizeE.e0) &
    (for x being Integer, c1 being Element of Context holds
       sizeC.(rightCtx.[x,c1]) = 1 + sizeC.c1) &
    (for e0 being Element of Expr holds
       recompose.[emptyCtx,e0] = e0) &
    (for c1 being Element of Context, e1,e2 being Element of Expr holds
       recompose.[leftCtx.[c1,e2],e1] =
         recompose.[c1,sube.[e1,e2]]) &
    (for x being Integer, c1 being Element of Context,
         e0 being Element of Expr holds
       recompose.[rightCtx.[x,c1],e0] =
         recompose.[c1,sube.[cte.x,e0]]) &
    (for x being Integer holds
       (0 <= x implies evalErr.(cte.x) = vnum.x) &
       (not 0 <= x implies evalErr.(cte.x) = underflow)) &
    (for e1,e2 being Element of Expr holds
       (evalErr.e1 = underflow implies
          evalErr.(sube.[e1,e2]) = underflow) &
       (for v1 being Integer st evalErr.e1 = vnum.v1 holds
          (evalErr.e2 = underflow implies
             evalErr.(sube.[e1,e2]) = underflow) &
          (for v2 being Integer st evalErr.e2 = vnum.v2 holds
             (v2 <= v1 implies
                evalErr.(sube.[e1,e2]) = vnum.(v1-v2)) &
             (not v2 <= v1 implies
                evalErr.(sube.[e1,e2]) = underflow)))) &
    0 <= n
  holds
    (c = emptyCtx implies c = emptyCtx) &
    (for c1 being Element of Context, e being Element of Expr st
       c = leftCtx.[c1,e]
     holds
       ex sc,scnext,se being Integer st
         sc = sizeC.c &
         scnext = sizeC.(rightCtx.[n,c1]) &
         se = sizeE.e &
         0 <= 1 + 2 * sc &
         2 * (scnext + se) < 1 + 2 * sc) &
    (for n1 being Integer, c1 being Element of Context st
       c = rightCtx.[n1,c1]
     holds
       n <= n1 implies
         ex sc,scc1,se being Integer st
           sc = sizeC.c &
           scc1 = sizeC.c1 &
           se = sizeE.(cte.(n1-n)) &
           0 <= 1 + 2 * sc &
           2 * (scc1 + se) < 1 + 2 * sc) &
    (for result being Element of Value st
       (c = emptyCtx & result = vnum.n) or
       (ex c1 being Element of Context, e being Element of Expr st
          c = leftCtx.[c1,e] &
          result = evalErr.(recompose.[rightCtx.[n,c1],e])) or
       (ex n1 being Integer, c1 being Element of Context st
          c = rightCtx.[n1,c1] &
          ((n <= n1 &
            result = evalErr.(recompose.[c1,cte.(n1-n)])) or
           (not n <= n1 & result = underflow)))
     holds result = evalErr.(recompose.[c,cte.n]))
proof
end;
::$P+
