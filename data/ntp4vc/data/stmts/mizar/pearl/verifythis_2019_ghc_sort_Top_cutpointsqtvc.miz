:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2019_ghc_sort_Top_cutpointsqtvc: the monotonic-cutpoint
:: verification condition preserves bounded, ordered cutpoints and monotonic
:: array segments through the nested scan and final extension. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, MARGREL1, XBOOLEAN, MCART_1,
    XTUPLE_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, MARGREL1, ZFMISC_1, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1, XBOOLEAN, FRAENKEL,
    XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for LS being non empty set,
      listF,seqF being Function of LS,INT*,
      nil being Element of LS,
      nthElem being Function of [:INT*,INT:],INT,
      lastVal being Function of LS,INT,
      ltBool being Function of
        [:INT*,[:INT,INT:]:],BOOLEAN,
      eqb being Function of
        [:BOOLEAN,BOOLEAN:],BOOLEAN,
      MonoSeg being Subset of
        [:INT*,[:INT,INT:]:],
      CutCore being Subset of
        [:INT*,[:LS,INT:]:],
      ResultSpec being Subset of [:INT*,LS:]
  st
    (for a being FinSequence of INT, i being Integer holds
       (len a = 0 implies nthElem.[a,i] = 0) &
       (0 < len a & i < 0 implies nthElem.[a,i] = a.1) &
       (0 <= i & i < len a implies
          nthElem.[a,i] = a.(i+1)) &
       (len a <= i implies nthElem.[a,i] = 0)) &
    (for a being FinSequence of INT, i,j,x,y being Integer st
       x = nthElem.[a,i] & y = nthElem.[a,j]
     holds
       (ltBool.[a,[i,j]] = TRUE iff x < y)) &
    (for b1,b2 being Element of BOOLEAN holds
       (eqb.[b1,b2] = TRUE iff b1 = b2)) &
    (for x being Element of LS holds
       seqF.x = Rev (listF.x) &
       lastVal.x = nthElem.[seqF.x,len (seqF.x)-1]) &
    (for x,y being Element of LS st
       listF.x = listF.y & seqF.x = seqF.y
     holds x = y) &
    (for l being FinSequence of INT holds
       ex x being Element of LS st
         listF.x = l & seqF.x = Rev l) &
    listF.nil = <*>INT &
    seqF.nil = <*>INT &
    (for a being FinSequence of INT, l,u being Integer holds
       ([a,[l,u]] in MonoSeg iff
         (for z1,z2,x,y being Integer st
            l <= z1 & z1 < z2 & z2 < u &
            x = nthElem.[a,z1] & y = nthElem.[a,z2]
          holds x < y) or
         (for z1,z2,x,y being Integer st
            l <= z1 & z1 < z2 & z2 < u &
            x = nthElem.[a,z1] & y = nthElem.[a,z2]
          holds y <= x))) &
    (for a being FinSequence of INT,
         c being Element of LS,
         n being Integer
     holds
       ([a,[c,n]] in CutCore iff
         0 < len (seqF.c) &
         nthElem.[seqF.c,0] = 0 &
         (for z being Integer st z in rng (listF.c)
          holds 0 <= z & z <= n) &
         (for k being Integer st
            0 <= k & k < len (seqF.c)-1
          holds
            [a,[nthElem.[seqF.c,k],
                nthElem.[seqF.c,k+1]]] in MonoSeg) &
         (for i,j,x,y being Integer st
            0 <= i & i < j & j < len (seqF.c) &
            x = nthElem.[seqF.c,i] &
            y = nthElem.[seqF.c,j]
          holds x <= y))) &
    (for a being FinSequence of INT,
         c being Element of LS
     holds
       ([a,c] in ResultSpec iff
         [a,[c,len a]] in CutCore &
         lastVal.c = len a &
         2 <= len (listF.c)))
  holds
    for s being FinSequence of INT st 0 < len s holds
      for n being Integer st n = len s holds
        for o1 being Element of LS st
          listF.o1 = <*0*> ^ listF.nil
        holds
          1 = 0 + 1 &
          (0 < 1 & 1 <= n + 1) &
          [s,[o1,n]] in CutCore &
          lastVal.o1 = 0 &
          (for cut being Element of LS st
            (0 < lastVal.cut + 1 &
             lastVal.cut + 1 <= n + 1) &
            [s,[cut,n]] in CutCore
           holds
            (lastVal.cut + 1 < n implies
              (0 <= lastVal.cut + 1 &
               lastVal.cut + 1 < len s) &
              (0 <= lastVal.cut &
               lastVal.cut < len s) &
              ((lastVal.cut + 1 <= lastVal.cut + 1 &
                lastVal.cut + 1 <= n) &
               [s,[lastVal.cut,lastVal.cut+1]]
                 in MonoSeg) &
              (for y being Integer st
                (lastVal.cut + 1 <= y & y <= n) &
                [s,[lastVal.cut,y]] in MonoSeg
               holds
                (y < n implies
                  (0 <= y & y < len s) &
                  (0 <= y-1 & y-1 < len s)) &
                (for o2 being Element of BOOLEAN st
                  ((y < n &
                    o2 =
                      eqb.[ltBool.[s,[y-1,y]],
                           ltBool.[s,
                             [lastVal.cut,lastVal.cut+1]]] &
                    (o2 = TRUE iff
                      ltBool.[s,[y-1,y]] =
                        ltBool.[s,
                          [lastVal.cut,lastVal.cut+1]])) or
                   (not y < n & o2 = FALSE))
                 holds
                   (o2 = TRUE implies
                     (0 <= n-y &
                      n-(y+1) < n-y) &
                     (lastVal.cut + 1 <= y+1 &
                      y+1 <= n) &
                     [s,[lastVal.cut,y+1]] in MonoSeg) &
                   (o2 <> TRUE implies
                     for o3 being Element of LS st
                       listF.o3 = <*y*> ^ listF.cut
                     holds
                       (0 <= n-(lastVal.cut+1) &
                        n-(y+1) <
                          n-(lastVal.cut+1)) &
                       (0 < y+1 & y+1 <= n+1) &
                       [s,[o3,n]] in CutCore &
                       lastVal.o3 = y)))) &
            ((not lastVal.cut + 1 < n) implies
              (lastVal.cut < n implies
                for o2 being Element of LS st
                  listF.o2 = <*n*> ^ listF.cut
                holds [s,o2] in ResultSpec) &
              ((not lastVal.cut < n) implies
                [s,cut] in ResultSpec)))
proof
end;
::$P+
