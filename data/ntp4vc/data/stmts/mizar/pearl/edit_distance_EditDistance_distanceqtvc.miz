:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/edit_distance_EditDistance_distanceqtvc: the dynamic-programming
:: verification condition for computing minimum insertion/deletion edit
:: distance between two words. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for C being non empty set,
      w1,w2 being FinSequence of C,
      Dist,MinDist being Subset of [:C*,[:C*,INT:]:],
      Suffix being Function of [:C*,INT:],C*,
      MinSuffix being Subset of
        [:C*,[:C*,[:INT,[:INT,INT:]:]:]:],
      nthInt being Function of [:INT*,INT:],INT,
      nthChar being Function of [:C*,INT:],C,
      setInt being Function of [:INT*,[:INT,INT:]:],INT*,
      UpdateEq being Subset of [:INT*,[:INT,INT:]:],
      RowInv,RowStep,RowsPhase,InitPhase being Subset of
        [:C*,[:C*,[:INT,[:INT,INT*:]:]:]:],
      SplitInv,CharStep being Subset of
        [:C*,[:C*,[:INT,[:INT,[:INT,[:INT,INT*:]:]:]:]:]:],
      Final being Subset of [:C*,[:C*,INT*:]:],
      InitPrefix being Subset of [:INT,[:INT,INT*:]:]
  st
    [<*>C,[<*>C,0]] in Dist &
    (for u,v being FinSequence of C,
         n being Integer,
         a being Element of C st
       [u,[v,n]] in Dist
     holds
       [<*a*> ^ u,[v,n+1]] in Dist) &
    (for u,v being FinSequence of C,
         n being Integer,
         a being Element of C st
       [u,[v,n]] in Dist
     holds
       [u,[<*a*> ^ v,n+1]] in Dist) &
    (for u,v being FinSequence of C,
         n being Integer,
         a being Element of C st
       [u,[v,n]] in Dist
     holds
       [<*a*> ^ u,[<*a*> ^ v,n]] in Dist) &
    (for D being Subset of [:C*,[:C*,INT:]:] st
       [<*>C,[<*>C,0]] in D &
       (for u,v being FinSequence of C,
            n being Integer,
            a being Element of C st
          [u,[v,n]] in D
        holds
          [<*a*> ^ u,[v,n+1]] in D) &
       (for u,v being FinSequence of C,
            n being Integer,
            a being Element of C st
          [u,[v,n]] in D
        holds
          [u,[<*a*> ^ v,n+1]] in D) &
       (for u,v being FinSequence of C,
            n being Integer,
            a being Element of C st
          [u,[v,n]] in D
        holds
          [<*a*> ^ u,[<*a*> ^ v,n]] in D)
     holds
       Dist c= D) &
    (for u,v being FinSequence of C,
         n being Integer
     holds
       ([u,[v,n]] in MinDist iff
         [u,[v,n]] in Dist &
         (for m being Integer st [u,[v,m]] in Dist
          holds n <= m))) &
    (for u being FinSequence of C holds
       Suffix.[u,len u] = <*>C) &
    (for u being FinSequence of C,
         i being Integer st 0 <= i & i < len u
     holds
       Suffix.[u,i] = <*u.(i+1)*> ^ Suffix.[u,i+1]) &
    (for u,v being FinSequence of C,
         i,j,n being Integer
     holds
       ([u,[v,[i,[j,n]]]] in MinSuffix iff
         [Suffix.[u,i],[Suffix.[v,j],n]] in MinDist)) &
    (for xs being FinSequence of INT,
         i being Integer st 0 <= i & i < len xs
     holds
       nthInt.[xs,i] = xs.(i+1)) &
    (for xs being FinSequence of INT,
         i being Integer st i < 0 & 0 < len xs
     holds
       nthInt.[xs,i] = xs.1) &
    (for xs being FinSequence of INT,
         i being Integer st
       len xs <= i or (i < 0 & len xs = 0)
     holds
       nthInt.[xs,i] = 0) &
    (for u being FinSequence of C,
         i being Integer st 0 <= i & i < len u
     holds
       nthChar.[u,i] = u.(i+1)) &
    (for xs being FinSequence of INT,
         i,x being Integer st 0 <= i & i < len xs
     holds
       len (setInt.[xs,[i,x]]) = len xs &
       (for q being Integer holds
          (q = i implies nthInt.[setInt.[xs,[i,x]],q] = x) &
          (q <> i implies
            nthInt.[setInt.[xs,[i,x]],q] = nthInt.[xs,q]))) &
    (for xs being FinSequence of INT,
         i,x being Integer
     holds
       ([xs,[i,x]] in UpdateEq iff
         for q being Integer holds
           (q = i implies nthInt.[setInt.[xs,[i,x]],q] = x) &
           (q <> i implies
             nthInt.[setInt.[xs,[i,x]],q] = nthInt.[xs,q]))) &
    (for u,v being FinSequence of C,
         i,n2 being Integer,
         t being FinSequence of INT
     holds
       ([u,[v,[i,[n2,t]]]] in RowInv iff
         for j being Integer st 0 <= j & j <= n2
         holds
           [u,[v,[i,[j,nthInt.[t,j]]]]] in MinSuffix)) &
    (for u,v being FinSequence of C,
         i,n2,j,oldt being Integer,
         t being FinSequence of INT
     holds
       ([u,[v,[i,[n2,[j,[oldt,t]]]]]] in SplitInv iff
         (for k being Integer st j < k & k <= n2
          holds
            [u,[v,[i,[k,nthInt.[t,k]]]]] in MinSuffix) &
         (for k being Integer st 0 <= k & k <= j
          holds
            [u,[v,[i+1,[k,nthInt.[t,k]]]]] in MinSuffix) &
         [u,[v,[i+1,[j+1,oldt]]]] in MinSuffix)) &
    (for u,v being FinSequence of C,
         i,n2,j,oldt being Integer,
         t being FinSequence of INT
     holds
       ([u,[v,[i,[n2,[j,[oldt,t]]]]]] in CharStep iff
         0 <= j & j < len t &
         0 <= j & j < len v &
         0 <= i & i < len u &
         ((nthChar.[u,i] = nthChar.[v,j] &
             0 <= j & j < len t &
             (len (setInt.[t,[j,oldt]]) = len t implies
               ([t,[j,oldt]] in UpdateEq implies
                 [u,[v,[i,[n2,[j-1,
                   [nthInt.[t,j],setInt.[t,[j,oldt]]]]]]]]
                   in SplitInv))) or
          (nthChar.[u,i] <> nthChar.[v,j] &
             0 <= j+1 & j+1 < len t &
             0 <= j & j < len t &
             (for x,y being Integer st
                x = nthInt.[t,j] & y = nthInt.[t,j+1]
              holds
                for o6 being Integer st
                  ((x <= y & o6 = x+1) or
                   (y < x & o6 = y+1))
                holds
                  0 <= j & j < len t &
                  (len (setInt.[t,[j,o6]]) = len t implies
                    ([t,[j,o6]] in UpdateEq implies
                      [u,[v,[i,[n2,[j-1,
                        [x,setInt.[t,[j,o6]]]]]]]]
                        in SplitInv))))))) &
    (for u,v being FinSequence of C,
         i,n2 being Integer,
         t being FinSequence of INT
     holds
       ([u,[v,[i,[n2,t]]]] in RowStep iff
         0 <= n2 & n2 < len t &
         0 <= n2 & n2 < len t &
         0 <= n2 & n2 < len t &
         (for oldLast,o3 being Integer st
            oldLast = nthInt.[t,n2] & o3 = oldLast+1
          holds
            len (setInt.[t,[n2,o3]]) = len t implies
              ([t,[n2,o3]] in UpdateEq implies
                ((-1 <= n2-1 implies
                   [u,[v,[i,[n2,[n2-1,
                     [oldLast,setInt.[t,[n2,o3]]]]]]]]
                     in SplitInv &
                   (for oldt being Integer,
                        t1 being FinSequence of INT st
                      len t1 = len (setInt.[t,[n2,o3]])
                    holds
                      (for j being Integer st
                         (j <= n2-1 & 0 <= j) &
                         [u,[v,[i,[n2,[j,[oldt,t1]]]]]]
                           in SplitInv
                       holds
                         [u,[v,[i,[n2,[j,[oldt,t1]]]]]]
                           in CharStep) &
                      ([u,[v,[i,[n2,[-1,[oldt,t1]]]]]]
                          in SplitInv implies
                        [u,[v,[i-1+1,[n2,t1]]]] in RowInv))) &
                 (n2-1 < -1 implies
                   [u,[v,[i-1+1,[n2,setInt.[t,[n2,o3]]]]]]
                     in RowInv)))))) &
    (for u,v being FinSequence of C,
         t being FinSequence of INT
     holds
       ([u,[v,t]] in Final iff
         0 <= 0 & 0 < len t &
         [Suffix.[u,0],[Suffix.[v,0],nthInt.[t,0]]]
           in MinDist)) &
    (for u,v being FinSequence of C,
         n1,n2 being Integer,
         t being FinSequence of INT
     holds
       ([u,[v,[n1,[n2,t]]]] in RowsPhase iff
         ((-1 <= n1-1 implies
            [u,[v,[n1-1+1,[n2,t]]]] in RowInv &
            (for t1 being FinSequence of INT st len t1 = len t
             holds
               (for i being Integer st
                  (i <= n1-1 & 0 <= i) &
                  [u,[v,[i+1,[n2,t1]]]] in RowInv
                holds
                  [u,[v,[i,[n2,t1]]]] in RowStep) &
               ([u,[v,[0,[n2,t1]]]] in RowInv implies
                 [u,[v,t1]] in Final))) &
          (n1-1 < -1 implies
            [u,[v,t]] in Final)))) &
    (for n2,i being Integer,
         t being FinSequence of INT
     holds
       ([n2,[i,t]] in InitPrefix iff
         for j being Integer st 0 <= j & j < i
         holds nthInt.[t,j] = n2-j)) &
    (for u,v being FinSequence of C,
         n1,n2 being Integer,
         t being FinSequence of INT
     holds
       ([u,[v,[n1,[n2,t]]]] in InitPhase iff
         [n2,[0,t]] in InitPrefix &
         (for t1 being FinSequence of INT st len t1 = len t
          holds
            (for i being Integer st
               (0 <= i & i <= n2) &
               [n2,[i,t1]] in InitPrefix
             holds
               0 <= i & i < len t1 &
               (len (setInt.[t1,[i,n2-i]]) = len t1 implies
                 ([t1,[i,n2-i]] in UpdateEq implies
                   [n2,[i+1,setInt.[t1,[i,n2-i]]]]
                     in InitPrefix))) &
            ([n2,[n2+1,t1]] in InitPrefix implies
              [u,[v,[n1,[n2,t1]]]] in RowsPhase))))
  holds
    for n1,n2,o1 being Integer st
      n1 = len w1 & n2 = len w2 & o1 = n2+1
    holds
      0 <= o1 &
      (for t being FinSequence of INT st
         (for i being Integer st 0 <= i & i < o1
          holds nthInt.[t,i] = 0) &
         len t = o1
       holds
         (0 <= n2+1 implies
           [w1,[w2,[n1,[n2,t]]]] in InitPhase) &
         (n2+1 < 0 implies
           [w1,[w2,[n1,[n2,t]]]] in RowsPhase))
proof
end;
::$P+
