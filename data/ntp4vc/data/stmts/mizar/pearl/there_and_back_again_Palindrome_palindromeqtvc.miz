:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/there_and_back_again_Palindrome_palindromeqtvc: the top-level
:: palindrome verification condition preserves palindromicity after a normal
:: return and refutes it from an in-range mirrored mismatch.
:: Under the displayed bounds, zero-based option lookup is represented by the
:: one-based entries x.(i+1) and x.(len x-i). This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      ORDINAL4, FINSEQ_1, FINSEQ_2;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
      INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1, FINSEQ_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1,
      FINSEQ_2;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for D being non empty set,
      x being FinSequence of D
  holds
    len x <= len x &
    (for o1 being FinSequence of D st
       (ex x0 being FinSequence of D st
          len x0 = len x &
          x = x0 ^ o1) &
       (for i being Integer st
          0 <= i & i < len x
        holds
          x.(i+1) = x.(len x-i))
     holds
       for i being Integer st
         0 <= i & i < len x
       holds
         x.(i+1) = x.(len x-i)) &
    ((ex i being Integer st
        0 <= i & i < len x &
        x.(i+1) <> x.(len x-i))
      implies
        not (for i being Integer st
          0 <= i & i < len x
        holds
          x.(i+1) = x.(len x-i)))
proof
end;
::$P+
