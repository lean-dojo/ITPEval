:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/power_FastExponentiation_fast_exp_2qtvc: the fast exponentiation
:: with accumulator verification condition establishes recursive descent and
:: preservation of x^n * acc across zero, even, and odd cases. This file
:: contains no proof.

environ
  vocabularies NUMBERS, INT_1, NAT_1, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0, SUBSET_1,
    NEWTON;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, NAT_1, NAT_D, NEWTON;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, NAT_D, NEWTON,
    CARD_1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,acc,x being Integer st
    0 <= n
  holds
    (n <> 0 implies
      2 <> 0 &
      ((n mod 2 = 0 implies
          2 <> 0 &
          (0 <= n & n div 2 < n) &
          0 <= n div 2) &
       (n mod 2 <> 0 implies
          (0 <= n & n - 1 < n) &
          0 <= n - 1))) &
    (for result being Integer holds
      (((n = 0 implies
           result = acc) &
        (n <> 0 implies
          ((n mod 2 = 0 implies
              ex half being Nat st
                half = n div 2 &
                result = ((x * x) |^ half) * acc) &
           (n mod 2 <> 0 implies
              ex previousExponent being Nat st
                previousExponent = n - 1 &
                result = (x |^ previousExponent) * (x * acc)))))
       implies
        ex exponent being Nat st
          exponent = n &
          result = (x |^ exponent) * acc))
proof
end;
::$P+
