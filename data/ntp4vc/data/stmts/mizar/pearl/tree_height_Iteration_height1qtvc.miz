:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/tree_height_Iteration_height1qtvc: the verification condition for
:: iterative binary-tree height computation with defunctionalized
:: continuations, including loop-invariant preservation, variant decrease,
:: and the final height result. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree,Cont,What being non empty set,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      ident being Element of Cont,
      kleft being Function of [:Tree,Cont:],Cont,
      kright being Function of [:INT,Cont:],Cont,
      argument being Function of Tree,What,
      resultW being Function of INT,What,
      Size,Height being Function of Tree,INT,
      isId being Function of Cont,BOOLEAN,
      isResult being Function of What,BOOLEAN,
      evalK being Function of [:Cont,INT:],INT,
      evalW being Function of What,INT,
      sizeK being Function of Cont,INT,
      sizeW being Function of What,INT,
      t being Element of Tree
  st
    (for l,r,l2,r2 being Element of Tree,
         y,y2 being Element of E st
       node.[l,[y,r]] = node.[l2,[y2,r2]]
     holds
       l = l2 & y = y2 & r = r2) &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       node.[l,[y,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          y being Element of E st
         u = node.[l,[y,r]]) &
    (for X being Subset of Tree st
       emptyT in X &
       (for l,r being Element of Tree,
            y being Element of E st
          l in X & r in X
        holds
          node.[l,[y,r]] in X)
     holds
       X = Tree) &
    (for l,l2 being Element of Tree,
         k,k2 being Element of Cont st
       kleft.[l,k] = kleft.[l2,k2]
     holds
       l = l2 & k = k2) &
    (for x,x2 being Integer,
         k,k2 being Element of Cont st
       kright.[x,k] = kright.[x2,k2]
     holds
       x = x2 & k = k2) &
    (for l being Element of Tree,
         x being Integer,
         k,k2 being Element of Cont
     holds
       kleft.[l,k] <> kright.[x,k2]) &
    (for l being Element of Tree,
         k being Element of Cont
     holds
       kleft.[l,k] <> ident) &
    (for x being Integer,
         k being Element of Cont
     holds
       kright.[x,k] <> ident) &
    (for k being Element of Cont holds
       k = ident or
       (ex l being Element of Tree,
           k1 being Element of Cont st
          k = kleft.[l,k1]) or
       ex x being Integer,
          k1 being Element of Cont st
         k = kright.[x,k1]) &
    (for K being Subset of Cont st
       ident in K &
       (for l being Element of Tree,
            k being Element of Cont st
          k in K
        holds
          kleft.[l,k] in K) &
       (for x being Integer,
            k being Element of Cont st
          k in K
        holds
          kright.[x,k] in K)
     holds
       K = Cont) &
    (for u,v being Element of Tree st
       argument.u = argument.v
     holds
       u = v) &
    (for x,y being Integer st
       resultW.x = resultW.y
     holds
       x = y) &
    (for u being Element of Tree,
         x being Integer
     holds
       argument.u <> resultW.x) &
    (for w being Element of What holds
       (ex u being Element of Tree st
          w = argument.u) or
       ex x being Integer st
          w = resultW.x) &
    (for W being Subset of What st
       (for u being Element of Tree holds
          argument.u in W) &
       (for x being Integer holds
          resultW.x in W)
     holds
       W = What) &
    Size.emptyT = 0 &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       Size.(node.[l,[y,r]]) = 1 + Size.l + Size.r) &
    Height.emptyT = 0 &
    (for l,r being Element of Tree,
         y being Element of E
     holds
       Height.(node.[l,[y,r]]) =
         1 + max(Height.l,Height.r)) &
    isId.ident = TRUE &
    (for l being Element of Tree,
         k being Element of Cont
     holds
       isId.(kleft.[l,k]) = FALSE) &
    (for x being Integer,
         k being Element of Cont
     holds
       isId.(kright.[x,k]) = FALSE) &
    (for u being Element of Tree holds
       isResult.(argument.u) = FALSE) &
    (for x being Integer holds
       isResult.(resultW.x) = TRUE) &
    (for r being Integer holds
       evalK.[ident,r] = r) &
    (for l being Element of Tree,
         k being Element of Cont,
         r being Integer
     holds
       evalK.[kleft.[l,k],r] =
         evalK.[k,1 + max(Height.l,r)]) &
    (for x,r being Integer,
         k being Element of Cont
     holds
       evalK.[kright.[x,k],r] =
         evalK.[k,1 + max(x,r)]) &
    (for u being Element of Tree holds
       evalW.(argument.u) = Height.u) &
    (for x being Integer holds
       evalW.(resultW.x) = x) &
    sizeK.ident = 0 &
    (for u being Element of Tree,
         k being Element of Cont
     holds
       sizeK.(kleft.[u,k]) =
         3 + 4 * Size.u + sizeK.k) &
    (for x being Integer,
         k being Element of Cont
     holds
       sizeK.(kright.[x,k]) =
         1 + sizeK.k) &
    (for u being Element of Tree holds
       sizeW.(argument.u) = 1 + 4 * Size.u) &
    (for x being Integer holds
       sizeW.(resultW.x) = 0)
  holds
    evalK.[ident,evalW.(argument.t)] = Height.t &
    for k being Element of Cont,
        w being Element of What st
      evalK.[k,evalW.w] = Height.t
    holds
      for o1 being Element of BOOLEAN st
        (o1 = TRUE iff
          isId.k = TRUE & isResult.w = TRUE)
      holds
        (o1 <> TRUE implies
          ((w = argument.emptyT implies
              ex sk,sw,swn being Integer st
                sk = sizeK.k &
                sw = sizeW.w &
                swn = sizeW.(resultW.0) &
                (0 <= sk + sw &
                 sk + swn < sk + sw) &
                evalK.[k,evalW.(resultW.0)] = Height.t) &
           (for l,r being Element of Tree,
                y being Element of E st
              w = argument.(node.[l,[y,r]])
            holds
              ex sk,sw,skn,swn being Integer st
                sk = sizeK.k &
                sw = sizeW.w &
                skn = sizeK.(kleft.[r,k]) &
                swn = sizeW.(argument.l) &
                (0 <= sk + sw &
                 skn + swn < sk + sw) &
                evalK.[kleft.[r,k],evalW.(argument.l)] =
                  Height.t) &
           (for x being Integer st
              k = ident & w = resultW.x
            holds
              0 = 1) &
           (for u being Element of Tree,
                x2 being Integer,
                k1 being Element of Cont st
              k = kleft.[u,k1] & w = resultW.x2
            holds
              ex sk,sw,skn,swn being Integer st
                sk = sizeK.k &
                sw = sizeW.w &
                skn = sizeK.(kright.[x2,k1]) &
                swn = sizeW.(argument.u) &
                (0 <= sk + sw &
                 skn + swn < sk + sw) &
                evalK.[kright.[x2,k1],evalW.(argument.u)] =
                  Height.t) &
           (for x,x2 being Integer,
                k1 being Element of Cont st
              k = kright.[x,k1] & w = resultW.x2
            holds
              ex sk,sw,skn,swn being Integer st
                sk = sizeK.k &
                sw = sizeW.w &
                skn = sizeK.k1 &
                swn = sizeW.(resultW.(1 + max(x,x2))) &
                (0 <= sk + sw &
                 skn + swn < sk + sw) &
                evalK.[k1,evalW.(resultW.(1 + max(x,x2)))] =
                  Height.t)) &
         (o1 = TRUE implies
           (ex r being Integer st
              w = resultW.r) &
           (for result,r being Integer st
              w = resultW.r & result = r
            holds
              result = Height.t)))
proof
end;
::$P+
