:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/quicksort_Traditional_quick_recqtvc: the traditional two-index
:: quicksort verification condition tracks partition invariants, scans,
:: swaps, termination measures, recursive sortedness, and subarray
:: permutation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nthElem being Function of [:INT*,INT:],INT,
      SortedSub being Subset of [:INT*,[:INT,INT:]:],
      PermSubPrime being Subset of
        [:INT*,[:INT*,[:INT,INT:]:]:],
      Exchange being Subset of
        [:INT*,[:INT*,[:INT,INT:]:]:],
      l,r being Integer,
      a being FinSequence of INT
  st
    (for s being FinSequence of INT, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = 0) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = 0)) &
    (for s being FinSequence of INT, lo,hi being Integer holds
       ([s,[lo,hi]] in SortedSub iff
         for i1,i2 being Integer st
           lo <= i1 & i1 <= i2 & i2 < hi
         holds nthElem.[s,i1] <= nthElem.[s,i2])) &
    (for s,t being FinSequence of INT, lo,hi being Integer holds
       ([s,[t,[lo,hi]]] in PermSubPrime iff
         len s = len t &
         (for q being Integer st
            0 <= q & q < min(max(lo,0),len s)
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for q being Integer st
            max(hi,0) <= q & q < len s
          holds nthElem.[s,q] = nthElem.[t,q]) &
         (for x being Integer holds
           card {q where q is Integer :
             max(lo,0) <= q &
             q < min(max(hi,0),len s) &
             nthElem.[s,q] = x} =
           card {q where q is Integer :
             max(lo,0) <= q &
             q < min(max(hi,0),len t) &
             nthElem.[t,q] = x}))) &
    (for s,t being FinSequence of INT, i,j being Integer holds
       ([s,[t,[i,j]]] in Exchange iff
         len s = len t &
         nthElem.[t,i] = nthElem.[s,j] &
         nthElem.[t,j] = nthElem.[s,i] &
         (for k being Integer st
            0 <= k & k < len s & k <> i & k <> j
          holds nthElem.[t,k] = nthElem.[s,k]))) &
    0 <= l &
    l <= r &
    r <= len a
  holds
    (r <= l+1 implies
      [a,[l,r]] in SortedSub &
      [a,[a,[l,r]]] in PermSubPrime) &
    ((not r <= l+1) implies
      (0 <= l & l < len a) &
      (for v being Integer st v = nthElem.[a,l]
       holds
         ((l <= l & l < r-1) &
          (for k being Integer st l <= k & k <= l
           holds nthElem.[a,k] <= v) &
          (l < r & r <= r) &
          (for k being Integer st r <= k & k < r
           holds v <= nthElem.[a,k]) &
          [a,[a,[l,r]]] in PermSubPrime &
          nthElem.[a,l] = v) &
         (for j,i being Integer,
              a1 being FinSequence of INT st
            len a1 = len a &
            (l <= i & i < r-1) &
            (for k being Integer st l <= k & k <= i
             holds nthElem.[a1,k] <= v) &
            (l < j & j <= r) &
            (for k being Integer st j <= k & k < r
             holds v <= nthElem.[a1,k]) &
            [a,[a1,[l,r]]] in PermSubPrime &
            nthElem.[a1,l] = v
          holds
            ((i < i+1 & i+1 < r) &
             (for k being Integer st l <= k & k < i+1
              holds nthElem.[a1,k] <= v)) &
            (for i1 being Integer st
               (i < i1 & i1 < r) &
               (for k being Integer st l <= k & k < i1
                holds nthElem.[a1,k] <= v)
             holds
               (0 <= i1 & i1 < len a1) &
               ((nthElem.[a1,i1] < v &
                 (not i1 = r-1)
                 implies
                   (0 <= r-i1 &
                    r-(i1+1) < r-i1) &
                   (i < i1+1 & i1+1 < r) &
                   (for k being Integer st
                      l <= k & k < i1+1
                    holds nthElem.[a1,k] <= v)) &
                (((not nthElem.[a1,i1] < v) or
                   i1 = r-1)
                 implies
                   ((l <= j-1 & j-1 < j) &
                    (for k being Integer st
                       j-1 < k & k < r
                     holds v <= nthElem.[a1,k])) &
                   (for j1 being Integer st
                      (l <= j1 & j1 < j) &
                      (for k being Integer st
                         j1 < k & k < r
                       holds v <= nthElem.[a1,k])
                    holds
                      (0 <= j1 & j1 < len a1) &
                      ((j1 <= i1 &
                        ((not v < nthElem.[a1,j1]) or
                         j1 = l)
                        implies
                          ((0 <= l & l < len a1) &
                           0 <= j1 & j1 < len a1) &
                          (for a2 being FinSequence of INT st
                             len a2 = len a1 &
                             [a1,[a2,[l,j1]]] in Exchange
                           holds
                             ((0 <= r-l &
                               j1-l < r-l) &
                              0 <= l & l <= j1 &
                              j1 <= len a2) &
                             (for a3 being
                                FinSequence of INT st
                                len a3 = len a2 &
                                [a3,[l,j1]] in SortedSub &
                                [a2,[a3,[l,j1]]]
                                  in PermSubPrime
                              holds
                                (for o1 being Integer st
                                   o1 = j1+1
                                 holds
                                   ((0 <= r-l &
                                     r-o1 < r-l) &
                                    0 <= o1 & o1 <= r &
                                    r <= len a3) &
                                   (for a4 being
                                      FinSequence of INT st
                                      len a4 = len a3 &
                                      [a4,[o1,r]]
                                        in SortedSub &
                                      [a3,[a4,[o1,r]]]
                                        in PermSubPrime
                                    holds
                                      [a4,[l,r]]
                                        in SortedSub &
                                      [a,[a4,[l,r]]]
                                        in
                                          PermSubPrime))))) &
                       ((not j1 <= i1) &
                        ((not v < nthElem.[a1,j1]) or
                         j1 = l)
                        implies
                          ((0 <= i1 & i1 < len a1) &
                           0 <= j1 & j1 < len a1) &
                          (for a2 being FinSequence of INT st
                             len a2 = len a1 &
                             [a1,[a2,[i1,j1]]] in Exchange
                           holds
                             (0 <= j-i &
                              j1-i1 < j-i) &
                             (l <= i1 & i1 < r-1) &
                             (for k being Integer st
                                l <= k & k <= i1
                              holds nthElem.[a2,k] <= v) &
                             (l < j1 & j1 <= r) &
                             (for k being Integer st
                                j1 <= k & k < r
                              holds v <= nthElem.[a2,k]) &
                             [a,[a2,[l,r]]]
                               in PermSubPrime &
                             nthElem.[a2,l] = v)) &
                       (v < nthElem.[a1,j1] &
                        (not j1 = l)
                        implies
                          (0 <= j1 & j1-1 < j1) &
                          (l <= j1-1 & j1-1 < j) &
                          (for k being Integer st
                             j1-1 < k & k < r
                           holds
                             v <= nthElem.[a1,k]))))))))))
proof
end;
::$P+
