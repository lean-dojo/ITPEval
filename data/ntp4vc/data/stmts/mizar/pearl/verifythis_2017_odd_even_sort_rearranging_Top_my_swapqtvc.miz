:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2017_odd_even_sort_rearranging_Top_my_swapqtvc:
:: swapping two inverted positions of an integer array strictly decreases
:: the index-weighted entropy sum. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1,
    NAT_1, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, ORDINAL1,
    ORDINAL4, BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, ZFMISC_1,
    CARD_3, SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7,
    MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0, PARTFUN1, BINOP_2, SETWISEO,
    BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_0,
    VALUED_1, NAT_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, BINOP_1, SETWISEO,
    NAT_1, BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1,
    SETWOP_2, XXREAL_1, FINSEQ_2, RVSUM_1, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1,
    INT_1, BINOP_2, FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1,
    FUNCOP_1, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for entropy being Function of [:INT*,INT:],INT st
    (for b being FinSequence of INT, z being Integer holds
      ex terms being FinSequence of INT st
        len terms = len b &
        (for k being Nat st k < len b holds
          terms.(k + 1) = k * (z - b.(k + 1))) &
        entropy.[b,z] = Sum terms)
  holds
    for a being FinSequence of INT,
        i,j,m being Integer st
      a.(j + 1) < a.(i + 1) &
      0 <= i &
      i < j &
      j < len a
    holds
      0 <= i &
      i < len a &
      0 <= j &
      j < len a &
      (for a1 being FinSequence of INT st
        len a1 = len a &
        a1.(i + 1) = a.(j + 1) &
        a1.(j + 1) = a.(i + 1) &
        (for k being Integer st
          0 <= k & k < len a & k <> i & k <> j
        holds
          a1.(k + 1) = a.(k + 1))
      holds
        (len a1 = len a &
         a1.(i + 1) = a.(j + 1) &
         a1.(j + 1) = a.(i + 1) &
         (for k being Integer st
           0 <= k & k < len a & k <> i & k <> j
         holds
           a1.(k + 1) = a.(k + 1))) &
        entropy.[a1,m] < entropy.[a,m])
proof
end;
::$P+
