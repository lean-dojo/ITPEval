:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/patience_PatienceCode_push_cardqtvc: the patience-solitaire
:: push-card verification condition preserves nonempty-stack well-formedness
:: through the empty, placement, and recursive-search branches.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, CARD_1,
    ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4, XCMPLX_0, XREAL_0,
    XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5, CLASSES1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, CLASSES1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, CLASSES1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for WF being Subset of (INT*)*,
      stacks1,acc being FinSequence of INT*,
      c being Integer
  st
    (<*>(INT*)) in WF &
    (for stack being FinSequence of INT,
         rem being FinSequence of INT* holds
       (<*stack*> ^ rem in WF iff
         stack <> <*>INT & rem in WF)) &
    stacks1 in WF &
    acc in WF
  holds
    ((stacks1 = <*>(INT*)) or
     (ex stack being FinSequence of INT,
         rem being FinSequence of INT* st
        stacks1 = <*stack*> ^ rem &
        stack <> <*>INT &
        (ex cp being Integer,
            tail being FinSequence of INT st
           stack = <*cp*> ^ tail &
           (not c <= cp implies
             (ex f being FinSequence of INT* st
                stacks1 = <*stack*> ^ f & f = rem) &
             rem in WF &
             <*stack*> ^ acc in WF)))) &
    (for result being FinSequence of INT* holds
       (((stacks1 = <*>(INT*) &
          result =
            Rev (<*(<*c*>)*> ^ acc) ^ <*>(INT*)) or
         (ex stack being FinSequence of INT,
             rem being FinSequence of INT*,
             cp being Integer,
             tail being FinSequence of INT st
            stacks1 = <*stack*> ^ rem &
            stack = <*cp*> ^ tail &
            ((c <= cp &
              result =
                Rev (<*(<*c*> ^ stack)*> ^ acc) ^ rem) or
             (not c <= cp & result in WF))))
        implies
          result in WF))
proof
end;
::$P+
