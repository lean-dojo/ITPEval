:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/ropes_Balance_insertqtvc: the verification condition for inserting
:: an invariant rope into a Fibonacci-indexed balance queue, either updating
:: one slot or carrying the concatenated rope to the next slot. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, FINSEQ_1, FINSEQ_2,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Char,String,Rope being non empty set,
      stringLength being Function of String,INT,
      stringIndex being Function of [:String,INT:],Char,
      emptyString being Element of String,
      stringApp being Function of [:String,String:],String,
      stringSub being Function of [:String,[:INT,INT:]:],String,
      StrRel being Relation of String,String,
      fib being Function of INT,INT,
      emp being Element of Rope,
      str being Function of [:String,[:INT,INT:]:],Rope,
      app being Function of [:Rope,[:Rope,INT:]:],Rope,
      ropeLength being Function of Rope,INT,
      Inv being Subset of Rope,
      ropeString being Function of Rope,String,
      maximum being Integer,
      arrayRead being Function of [:Rope*,INT:],Rope,
      arraySet being Function of [:Rope*,[:INT,Rope:]:],Rope*,
      stringOfArray being
        Function of [:Rope*,[:INT,INT:]:],String,
      i being Integer,
      q being FinSequence of Rope,
      r being Element of Rope
  st
    (for s being Element of String holds 0 <= stringLength.s) &
    stringLength.emptyString = 0 &
    (for s1,s2 being Element of String holds
       ([s1,s2] in StrRel iff
         ex n1,n2 being Integer st
           n1 = stringLength.s1 &
           n2 = stringLength.s2 &
           n1 = n2 &
           (for k being Integer st 0 <= k & k < n1
            holds stringIndex.[s1,k] = stringIndex.[s2,k]))) &
    (for s1,s2 being Element of String st
       [s1,s2] in StrRel
     holds s1 = s2) &
    (for s1,s2 being Element of String holds
       stringLength.(stringApp.[s1,s2]) =
         stringLength.s1 + stringLength.s2) &
    (for s1,s2 being Element of String,
         k being Integer st
       0 <= k & k < stringLength.s1
     holds
       stringIndex.[stringApp.[s1,s2],k] =
         stringIndex.[s1,k]) &
    (for s1,s2 being Element of String,
         k being Integer st
       stringLength.s1 <= k &
       k < stringLength.s1 + stringLength.s2
     holds
       stringIndex.[stringApp.[s1,s2],k] =
         stringIndex.[s2,k-stringLength.s1]) &
    (for s being Element of String,
         offset,nlen being Integer st
       0 <= nlen & 0 <= offset & offset <= stringLength.s &
       offset + nlen <= stringLength.s
     holds
       stringLength.(stringSub.[s,[offset,nlen]]) = nlen) &
    (for s being Element of String,
         offset,nlen,k being Integer st
       0 <= nlen & 0 <= offset & offset <= stringLength.s &
       offset + nlen <= stringLength.s &
       0 <= k & k < nlen
     holds
       stringIndex.[stringSub.[s,[offset,nlen]],k] =
         stringIndex.[s,offset+k]) &
    (for n being Integer st 0 <= n holds
       ex fn,fn1,fn2 being Integer st
         fn = fib.n & fn1 = fib.(n-1) & fn2 = fib.(n-2) &
         (n = 0 implies fn = 0) &
         (n = 1 implies fn = 1) &
         (n <> 0 & n <> 1 implies fn = fn1 + fn2)) &
    (for s1,s2 being Element of String,
         offset1,offset2,len1,len2 being Integer st
       str.[s1,[offset1,len1]] = str.[s2,[offset2,len2]]
     holds s1 = s2 & offset1 = offset2 & len1 = len2) &
    (for l1,l2,r1,r2 being Element of Rope,
         len1,len2 being Integer st
       app.[l1,[r1,len1]] = app.[l2,[r2,len2]]
     holds l1 = l2 & r1 = r2 & len1 = len2) &
    (for s being Element of String,
         offset,nlen being Integer
     holds str.[s,[offset,nlen]] <> emp) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds app.[l,[r1,nlen]] <> emp) &
    (for s being Element of String,
         offset,len1,len2 being Integer,
         l,r1 being Element of Rope
     holds str.[s,[offset,len1]] <> app.[l,[r1,len2]]) &
    (for x being Element of Rope holds
       x = emp or
       (ex s being Element of String,
           offset,nlen being Integer st
          x = str.[s,[offset,nlen]]) or
       ex l,r1 being Element of Rope,
          nlen being Integer st
         x = app.[l,[r1,nlen]]) &
    (for X being Subset of Rope st
       emp in X &
       (for s being Element of String,
            offset,nlen being Integer
        holds str.[s,[offset,nlen]] in X) &
       (for l,r1 being Element of Rope,
            nlen being Integer st l in X & r1 in X
        holds app.[l,[r1,nlen]] in X)
     holds X = Rope) &
    ropeLength.emp = 0 &
    (for s being Element of String,
         offset,nlen being Integer
     holds ropeLength.(str.[s,[offset,nlen]]) = nlen) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds ropeLength.(app.[l,[r1,nlen]]) = nlen) &
    emp in Inv &
    (for s being Element of String,
         offset,nlen being Integer
     holds
       (str.[s,[offset,nlen]] in Inv iff
          0 < nlen &
          0 <= offset & offset < stringLength.s &
          offset + nlen <= stringLength.s)) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds
       (app.[l,[r1,nlen]] in Inv iff
          0 < ropeLength.l & l in Inv &
          0 < ropeLength.r1 & r1 in Inv &
          nlen = ropeLength.l + ropeLength.r1)) &
    ropeString.emp = emptyString &
    (for s being Element of String,
         offset,nlen being Integer
     holds
       ropeString.(str.[s,[offset,nlen]]) =
         stringSub.[s,[offset,nlen]]) &
    (for l,r1 being Element of Rope,
         nlen being Integer
     holds
       ropeString.(app.[l,[r1,nlen]]) =
         stringApp.[ropeString.l,ropeString.r1]) &
    (for xs being FinSequence of Rope,
         k being Integer st 0 <= k & k < len xs
     holds arrayRead.[xs,k] = xs.(k+1)) &
    (for xs being FinSequence of Rope,
         k being Integer,
         x being Element of Rope st
       0 <= k & k < len xs
     holds
       len (arraySet.[xs,[k,x]]) = len xs &
       (for j being Integer holds
          (j = k implies
             arrayRead.[arraySet.[xs,[k,x]],j] = x) &
          (j <> k implies
             arrayRead.[arraySet.[xs,[k,x]],j] =
               arrayRead.[xs,j]))) &
    2 <= maximum &
    (for xs being FinSequence of Rope,
         l being Integer st 0 <= l & l <= len xs
     holds
       [stringOfArray.[xs,[l,l]],emptyString] in StrRel) &
    (for xs being FinSequence of Rope,
         l,u being Integer st
       0 <= l & l < u & u <= len xs
     holds
       [stringOfArray.[xs,[l,u]],
         stringApp.[stringOfArray.[xs,[l+1,u]],
           ropeString.(arrayRead.[xs,l])]] in StrRel) &
    2 <= i &
    i < len q &
    len q = maximum + 1 &
    r in Inv &
    (for j being Integer st 2 <= j & j <= maximum
     holds arrayRead.[q,j] in Inv) &
    (ex qlen,rlen,fmax being Integer st
       qlen = stringLength.(stringOfArray.[q,[i,maximum+1]]) &
       rlen = ropeLength.r &
       fmax = fib.(maximum+1) &
       qlen + rlen < fmax)
  holds
    0 <= i &
    i < len q &
    (for o1 being Element of Rope st o1 = arrayRead.[q,i]
     holds
       o1 in Inv &
       r in Inv &
       (for r1 being Element of Rope st
          r1 in Inv &
          [ropeString.r1,
            stringApp.[ropeString.o1,ropeString.r]] in StrRel
        holds
          0 <= i+1 &
          (ex r1len,fi1 being Integer st
             r1len = ropeLength.r1 &
             fi1 = fib.(i+1) &
             ((r1len < fi1 implies
                (0 <= i & i < len q) &
                (len (arraySet.[q,[i,r1]]) = len q implies
                  ((for j being Integer holds
                     (j = i implies
                        arrayRead.[arraySet.[q,[i,r1]],j] = r1) &
                     (j <> i implies
                        arrayRead.[arraySet.[q,[i,r1]],j] =
                          arrayRead.[q,j]))
                   implies
                     (for j being Integer st
                        2 <= j & j <= maximum
                      holds
                        arrayRead.[arraySet.[q,[i,r1]],j] in Inv) &
                     (for j being Integer st
                        2 <= j & j < i
                      holds
                        arrayRead.[arraySet.[q,[i,r1]],j] =
                          arrayRead.[q,j]) &
                     [stringOfArray.
                        [arraySet.[q,[i,r1]],[i,maximum+1]],
                      stringApp.
                        [stringOfArray.[q,[i,maximum+1]],
                         ropeString.r]] in StrRel))) &
              (not r1len < fi1 implies
                (0 <= i & i < len q) &
                (len (arraySet.[q,[i,emp]]) = len q implies
                  ((for j being Integer holds
                     (j = i implies
                        arrayRead.[arraySet.[q,[i,emp]],j] = emp) &
                     (j <> i implies
                        arrayRead.[arraySet.[q,[i,emp]],j] =
                          arrayRead.[q,j]))
                   implies
                     ((0 <= maximum-i &
                       maximum-(i+1) < maximum-i) &
                      (2 <= i+1 &
                       i+1 < len (arraySet.[q,[i,emp]]) &
                       len (arraySet.[q,[i,emp]]) = maximum+1) &
                      r1 in Inv &
                      (for j being Integer st
                         2 <= j & j <= maximum
                       holds
                         arrayRead.[arraySet.[q,[i,emp]],j] in Inv) &
                      (ex qlen1,rlen1,fmax1 being Integer st
                         qlen1 =
                           stringLength.
                             (stringOfArray.
                               [arraySet.[q,[i,emp]],
                                [i+1,maximum+1]]) &
                         rlen1 = ropeLength.r1 &
                         fmax1 = fib.(maximum+1) &
                         qlen1 + rlen1 < fmax1)) &
                     (for q1 being FinSequence of Rope st
                        len q1 = len (arraySet.[q,[i,emp]])
                      holds
                        ((for j being Integer st
                           2 <= j & j <= maximum
                         holds arrayRead.[q1,j] in Inv) &
                         (for j being Integer st
                           2 <= j & j < i+1
                          holds
                            arrayRead.[q1,j] =
                              arrayRead.[arraySet.[q,[i,emp]],j]) &
                         [stringOfArray.[q1,[i+1,maximum+1]],
                           stringApp.
                             [stringOfArray.
                               [arraySet.[q,[i,emp]],
                                [i+1,maximum+1]],
                              ropeString.r1]] in StrRel
                         implies
                           (for j being Integer st
                              2 <= j & j <= maximum
                            holds arrayRead.[q1,j] in Inv) &
                           (for j being Integer st
                              2 <= j & j < i
                            holds
                              arrayRead.[q1,j] = arrayRead.[q,j]) &
                           [stringOfArray.[q1,[i,maximum+1]],
                             stringApp.
                               [stringOfArray.[q,[i,maximum+1]],
                                ropeString.r]] in StrRel)))))))))
proof
end;
::$P+
