:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/vacid_0_sparse_array_SparseArray_setqtvc: the sparse-array set
:: verification condition preserves the representation invariant and makes
:: the assigned index hold the new value while all other values are unchanged.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,SparseArray,ValueArray,IntArray being non empty set,
      values being Function of SparseArray,ValueArray,
      indexSeq,backSeq being Function of SparseArray,IntArray,
      cardinality,sparseLength being Function of SparseArray,INT,
      defaultValue being Function of SparseArray,A,
      valueLength being Function of ValueArray,INT,
      intLength being Function of IntArray,INT,
      nthValue being Function of [:ValueArray,INT:],A,
      nthInt being Function of [:IntArray,INT:],INT,
      setValue being Function of
        [:ValueArray,[:INT,A:]:],ValueArray,
      setInt being Function of
        [:IntArray,[:INT,INT:]:],IntArray,
      IsElt being Subset of [:SparseArray,INT:],
      Value being Function of [:SparseArray,INT:],A,
      i being Integer,
      a being Element of SparseArray,
      v being Element of A
  st
    (for s being Element of ValueArray holds
       0 <= valueLength.s) &
    (for s being Element of IntArray holds
       0 <= intLength.s) &
    (for s,t being Element of ValueArray st
       valueLength.s = valueLength.t &
       (for q being Integer holds nthValue.[s,q] = nthValue.[t,q])
     holds s = t) &
    (for s,t being Element of IntArray st
       intLength.s = intLength.t &
       (for q being Integer holds nthInt.[s,q] = nthInt.[t,q])
     holds s = t) &
    (for s being Element of ValueArray, j being Integer,
         x being Element of A holds
       valueLength.(setValue.[s,[j,x]]) = valueLength.s &
       (for q being Integer holds
          (q = j implies
             nthValue.[setValue.[s,[j,x]],q] = x) &
          (q <> j implies
             nthValue.[setValue.[s,[j,x]],q] =
               nthValue.[s,q]))) &
    (for s being Element of IntArray, j,x being Integer holds
       intLength.(setInt.[s,[j,x]]) = intLength.s &
       (for q being Integer holds
            (q = j implies
               nthInt.[setInt.[s,[j,x]],q] = x) &
            (q <> j implies
               nthInt.[setInt.[s,[j,x]],q] =
                 nthInt.[s,q]))) &
    (for self being Element of SparseArray holds
       0 <= cardinality.self &
       cardinality.self <= valueLength.(values.self) &
       valueLength.(values.self) <= 1000 &
       valueLength.(values.self) = intLength.(indexSeq.self) &
       intLength.(indexSeq.self) = intLength.(backSeq.self) &
       (for j being Integer st 0 <= j & j < cardinality.self
        holds
          ex backIndex being Integer st
            backIndex = nthInt.[backSeq.self,j] &
            0 <= backIndex &
            backIndex < valueLength.(values.self) &
            nthInt.[indexSeq.self,backIndex] = j)) &
    (for x,y being Element of SparseArray st
       values.x = values.y &
       indexSeq.x = indexSeq.y &
       backSeq.x = backSeq.y &
       cardinality.x = cardinality.y &
       defaultValue.x = defaultValue.y
     holds x = y) &
    (for self being Element of SparseArray holds
       sparseLength.self = valueLength.(values.self)) &
    (for self being Element of SparseArray, j being Integer holds
       ([self,j] in IsElt iff
         ex storedIndex being Integer st
           storedIndex = nthInt.[indexSeq.self,j] &
           0 <= storedIndex &
           storedIndex < cardinality.self &
           nthInt.[backSeq.self,storedIndex] = j)) &
    (for self being Element of SparseArray, j being Integer holds
       ([self,j] in IsElt implies
          Value.[self,j] = nthValue.[values.self,j]) &
       (not [self,j] in IsElt implies
          Value.[self,j] = defaultValue.self)) &
    0 <= i &
    i < sparseLength.a
  holds
    for o1 being Element of ValueArray st o1 = values.a holds
    for o1v being Element of ValueArray st
      o1v = setValue.[o1,[i,v]]
    holds
      (0 <= i & i < valueLength.o1) &
      (for a1 being Element of SparseArray holds
        valueLength.o1v = valueLength.o1 implies
        (valueLength.o1v = valueLength.(values.a)
         implies
         ((for q being Integer holds
             (q = i implies
                nthValue.[o1v,q] = v) &
             (q <> i implies
                nthValue.[o1v,q] = nthValue.[o1,q]))
          implies
          ((0 <= cardinality.a &
            cardinality.a <= valueLength.o1v &
            valueLength.o1v <= 1000) &
           (valueLength.o1v = intLength.(indexSeq.a) &
            intLength.(indexSeq.a) = intLength.(backSeq.a)) &
           (for i1 being Integer st
              0 <= i1 & i1 < cardinality.a
            holds
              ex backIndex being Integer st
                backIndex = nthInt.[backSeq.a,i1] &
                0 <= backIndex &
                backIndex < valueLength.o1v &
                nthInt.[indexSeq.a,backIndex] = i1)) &
          ((defaultValue.a = defaultValue.a1 &
            cardinality.a = cardinality.a1 &
            backSeq.a = backSeq.a1 &
            indexSeq.a = indexSeq.a1 &
            o1v = values.a1)
           implies
            (0 <= i & i < sparseLength.a1) &
            ((not [a1,i] in IsElt implies
               for o2 being Integer st o2 = cardinality.a1 holds
                 for o3 being Element of IntArray st
                   o3 = indexSeq.a1
                 holds
                 for o3v being Element of IntArray st
                   o3v = setInt.[o3,[i,o2]]
                 holds
                   (0 <= i & i < intLength.o3) &
                   (intLength.o3v = intLength.o3
                    implies
                     (intLength.o3v = intLength.(indexSeq.a1)
                     implies
                     ((for q being Integer holds
                         (q = i implies
                            nthInt.[o3v,q] = o2) &
                         (q <> i implies
                            nthInt.[o3v,q] = nthInt.[o3,q]))
                      implies
                       (0 <= cardinality.a1 &
                        cardinality.a1 <
                          intLength.(backSeq.a1)) &
                       (for backv being Element of IntArray st
                          backv = setInt.
                            [backSeq.a1,[cardinality.a1,i]]
                        holds
                         intLength.backv = intLength.(backSeq.a1)
                        implies
                         (intLength.backv = intLength.(backSeq.a1)
                         implies
                         ((for q being Integer holds
                             (q = cardinality.a1 implies
                                nthInt.[backv,q] = i) &
                             (q <> cardinality.a1 implies
                                nthInt.[backv,q] =
                                  nthInt.[backSeq.a1,q]))
                          implies
                           for a2 being Element of SparseArray holds
                            ((0 <= cardinality.a1 + 1 &
                              cardinality.a1 + 1 <=
                                valueLength.(values.a1) &
                              valueLength.(values.a1) <= 1000) &
                             (valueLength.(values.a1) =
                                intLength.o3v &
                              intLength.o3v = intLength.backv) &
                             (for i1 being Integer st
                                0 <= i1 &
                                i1 < cardinality.a1 + 1
                              holds
                                ex backIndex being Integer st
                                  backIndex =
                                    nthInt.[backv,i1] &
                                  0 <= backIndex &
                                  backIndex <
                                    valueLength.(values.a1) &
                                  nthInt.[o3v,backIndex] = i1)) &
                            ((defaultValue.a1 = defaultValue.a2 &
                              cardinality.a1 + 1 =
                                cardinality.a2 &
                              backv = backSeq.a2 &
                              o3v = indexSeq.a2 &
                              values.a1 = values.a2)
                             implies
                               Value.[a2,i] = v &
                               (for j being Integer st j <> i
                                holds
                                  Value.[a2,j] = Value.[a,j]))))))) &
             ([a1,i] in IsElt implies
                Value.[a1,i] = v &
                (for j being Integer st j <> i holds
                   Value.[a1,j] = Value.[a,j])))))))))
proof
end;
::$P+
