:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binary_search_Complexity_binary_searchqtvc: the binary-search
:: verification condition preserves sorted-range exclusion and a logarithmic
:: time bound while shrinking the active interval or returning a result.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for alen,v being Integer,
      a,log2,f being Function of INT,INT st
    0 <= alen &
    (for q being Integer st q < 0 holds a.q = a.0) &
    (for q being Integer st alen <= q holds a.q = 0) &
    (for n being Integer holds
      (n <= 1 implies log2.n = 0) &
      (not n <= 1 implies
        ex ln,lh being Integer st
          ln = log2.n &
          lh = log2.(n div 2) &
          ln = 1 + lh)) &
    (for n being Integer holds
      (n = 0 implies f.n = 0) &
      (n <> 0 implies
        ex fn,ln being Integer st
          fn = f.n &
          ln = log2.n &
          fn = 1 + ln)) &
    (for i1,i2 being Integer st
      0 <= i1 & i1 <= i2 & i2 < alen
     holds
      ex ai1,ai2 being Integer st
        ai1 = a.i1 & ai2 = a.i2 & ai1 <= ai2)
  holds
    ((0 <= 0 & 0 <= alen & alen <= alen) &
      (for i being Integer st
        (0 <= i & i < 0) or
        (alen <= i & i < alen)
       holds a.i <> v) &
      (ex fx,fb being Integer st
        fx = f.(alen - 0) &
        fb = f.alen &
        0 - 0 + fx <= fb)) &
    (for hi,lo,time being Integer st
      (0 <= lo & lo <= hi & hi <= alen) &
      (for i being Integer st
        (0 <= i & i < lo) or
        (hi <= i & i < alen)
       holds a.i <> v) &
      (ex fx,fb being Integer st
        fx = f.(hi - lo) &
        fb = f.alen &
        time - 0 + fx <= fb)
     holds
      (lo < hi implies
        2 <> 0 &
        (for mid being Integer st
          mid = lo + (hi - lo) div 2
         holds
          ex amid being Integer st
            amid = a.mid &
            (0 <= mid & mid < alen) &
            (amid < v implies
              (0 <= hi - lo &
                hi - (mid + 1) < hi - lo) &
              (0 <= mid + 1 & mid + 1 <= hi & hi <= alen) &
              (for i being Integer st
                (0 <= i & i < mid + 1) or
                (hi <= i & i < alen)
               holds a.i <> v) &
              (ex fx,fb being Integer st
                fx = f.(hi - (mid + 1)) &
                fb = f.alen &
                time + 1 - 0 + fx <= fb)) &
            (not amid < v implies
              (0 <= mid & mid < alen) &
              (v < amid implies
                (0 <= hi - lo & mid - lo < hi - lo) &
                (0 <= lo & lo <= mid & mid <= alen) &
                (for i being Integer st
                  (0 <= i & i < lo) or
                  (mid <= i & i < alen)
                 holds a.i <> v) &
                (ex fx,fb being Integer st
                  fx = f.(mid - lo) &
                  fb = f.alen &
                  time + 1 - 0 + fx <= fb)) &
              (not v < amid implies
                ((((0 <= mid & mid < alen) & amid = v) or
                  (mid = -1 &
                    (for i being Integer st
                      0 <= i & i < alen
                     holds a.i <> v))) &
                  (ex fb being Integer st
                    fb = f.alen &
                    time - 0 <= fb)))))) &
      (not lo < hi implies
        ((((0 <= -1 & -1 < alen) & a.(-1) = v) or
          (for i being Integer st
            0 <= i & i < alen
           holds a.i <> v)) &
          (ex fb being Integer st
            fb = f.alen &
            time - 0 <= fb))))
proof
end;
::$P+
