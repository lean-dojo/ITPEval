:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/patience_PatienceAbstract_play_cardsqtvc: the abstract patience-
:: solitaire play-cards verification condition preserves the stack-state
:: invariant and appends the input card values in order. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1, NUMBERS,
    XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1,
    INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL4,
    FINSEQ_1, FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCT_7, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0, FINSEQ_1,
    FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0, ZFMISC_1,
    MCART_1, NAT_1, FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1, XXREAL_0,
    MEMBERED, VALUED_0, VALUED_1, XCMPLX_0, XREAL_0,
    ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Inv being Subset of
        [:INT,[:INT,[:Funcs(INT,INT),[:Funcs(INT,INT),
          [:Funcs([:INT,INT:],INT),[:Funcs(INT,INT),
            [:Funcs(INT,INT),Funcs(INT,INT):]:]:]:]:]:]:],
      nthZ being Function of [:INT*,INT:],INT,
      numStacks,numElts being Element of INT,
      values,stackSizes being Function of INT,INT,
      stacks being Function of [:INT,INT:],INT,
      posStack,posHeight,preds being Function of INT,INT,
      input being FinSequence of INT
  st
    (for xs being FinSequence of INT, k being Element of INT holds
      (k < 0 & len xs = 0 implies nthZ.[xs,k] = 0) &
      (k < 0 & 0 < len xs implies nthZ.[xs,k] = xs.1) &
      (0 <= k & k < len xs implies nthZ.[xs,k] = xs.(k+1)) &
      (len xs <= k implies nthZ.[xs,k] = 0)) &
    (for ns,ne being Element of INT,
         vals,sizes being Function of INT,INT,
         sts being Function of [:INT,INT:],INT,
         pStack,pHeight,pr being Function of INT,INT
     holds
      ([ns,[ne,[vals,[sizes,[sts,[pStack,[pHeight,pr]]]]]]]
        in Inv iff
       (0 <= ns & ns <= ne) &
       (0 < ne implies 0 < ns) &
       (for i being Element of INT st 0 <= i & i < ns holds
          1 <= sizes.i &
          (for j being Element of INT st 0 <= j & j < sizes.i
           holds
             0 <= In(sts.([i,j]),INT) &
             In(sts.([i,j]),INT) < ne)) &
       (for i being Element of INT st 0 <= i & i < ne holds
          0 <= pStack.i & pStack.i < ns &
          0 <= pHeight.i & pHeight.i < sizes.(pStack.i) &
          In(sts.([pStack.i,pHeight.i]),INT) = i) &
       (for si being Element of INT st 0 <= si & si < ns holds
          for ip being Element of INT st 0 <= ip & ip < sizes.si
          holds
            pStack.(In(sts.([si,ip]),INT)) = si &
            pHeight.(In(sts.([si,ip]),INT)) = ip) &
       (for i being Element of INT st 0 <= i & i < ns holds
          for j,k being Element of INT st
            0 <= j & j < k & k < sizes.i
          holds
            In(sts.([i,j]),INT) < In(sts.([i,k]),INT)) &
       (for i being Element of INT st 0 <= i & i < ns holds
          for j,k being Element of INT st
            0 <= j & j <= k & k < sizes.i
          holds
            vals.(In(sts.([i,k]),INT)) <=
            vals.(In(sts.([i,j]),INT))) &
       (for i being Element of INT st 0 <= i & i < ne holds
          -1 <= pr.i & pr.i < ne & pr.i < i &
          (pr.i < 0 implies pStack.i = 0) &
          (not pr.i < 0 implies
            vals.(pr.i) < vals.i &
            0 < pStack.i &
            pStack.(pr.i) = pStack.i - 1)))) &
    [numStacks,[numElts,[values,[stackSizes,
      [stacks,[posStack,[posHeight,preds]]]]]]] in Inv
  holds
    (input = <*>INT implies
      [numStacks,[numElts,[values,[stackSizes,
        [stacks,[posStack,[posHeight,preds]]]]]]] in Inv &
      numElts = numElts + len input &
      (for i being Element of INT st
        numElts <= i & i < numElts
       holds values.i = nthZ.[input,i-numElts])) &
    (for c being Element of INT,
         rem being FinSequence of INT st input = <*c*> ^ rem
     holds
      [numStacks,[numElts,[values,[stackSizes,
        [stacks,[posStack,[posHeight,preds]]]]]]] in Inv &
      (for numStacks1,numElts1 being Element of INT,
           values1,stackSizes1 being Function of INT,INT,
           stacks1 being Function of [:INT,INT:],INT,
           posStack1,posHeight1,preds1 being Function of INT,INT
       st
         [numStacks1,[numElts1,[values1,[stackSizes1,
           [stacks1,[posStack1,[posHeight1,preds1]]]]]]] in Inv &
         numElts1 = numElts + 1 &
         values1 = values+*(numElts,c)
       holds
         (input = <*c*> ^ rem &
          [numStacks1,[numElts1,[values1,[stackSizes1,
            [stacks1,[posStack1,[posHeight1,preds1]]]]]]] in Inv) &
         (for numStacks2,numElts2 being Element of INT,
              values2,stackSizes2 being Function of INT,INT,
              stacks2 being Function of [:INT,INT:],INT,
              posStack2,posHeight2,preds2 being Function of INT,INT
          st
            [numStacks2,[numElts2,[values2,[stackSizes2,
              [stacks2,[posStack2,[posHeight2,preds2]]]]]]] in Inv &
            numElts2 = numElts1 + len rem &
            (for i being Element of INT st 0 <= i & i < numElts1
             holds values2.i = values1.i) &
            (for i being Element of INT st
              numElts1 <= i & i < numElts2
             holds values2.i = nthZ.[rem,i-numElts1])
          holds
            [numStacks2,[numElts2,[values2,[stackSizes2,
              [stacks2,[posStack2,[posHeight2,preds2]]]]]]] in Inv &
            numElts2 = numElts + len input &
            (for i being Element of INT st 0 <= i & i < numElts
             holds values2.i = values.i) &
            (for i being Element of INT st
              numElts <= i & i < numElts2
             holds values2.i = nthZ.[input,i-numElts]))))
proof
end;
::$P+
