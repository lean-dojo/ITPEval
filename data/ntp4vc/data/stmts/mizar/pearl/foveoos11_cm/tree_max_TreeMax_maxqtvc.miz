:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/foveoos11_cm/tree_max_TreeMax_maxqtvc: the maximum computation
:: verification condition for nonempty integer-labeled binary trees, where
:: the returned value bounds every label and occurs in the tree.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Tree being non empty set,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:INT,Tree:]:],Tree,
      Size being Function of Tree,INT,
      Mem,Ge being Subset of [:INT,Tree:],
      t being Element of Tree
  st
    (for l,r being Element of Tree,
         v being Integer
     holds
       node.[l,[v,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          v being Integer st
         u = node.[l,[v,r]]) &
    (for l,l2,r,r2 being Element of Tree,
         v,v2 being Integer st
       node.[l,[v,r]] = node.[l2,[v2,r2]]
     holds
       l = l2 & v = v2 & r = r2) &
    Size.emptyT = 0 &
    (for u being Element of Tree holds 0 <= Size.u) &
    (for l,r being Element of Tree,
         v being Integer
     holds
       Size.(node.[l,[v,r]]) = 1 + Size.l + Size.r) &
    (for x being Integer holds
       not [x,emptyT] in Mem) &
    (for x,v being Integer,
         l,r being Element of Tree
     holds
       ([x,node.[l,[v,r]]] in Mem iff
          x = v or [x,l] in Mem or [x,r] in Mem)) &
    (for x being Integer holds
       [x,emptyT] in Ge) &
    (for x,v being Integer,
         l,r being Element of Tree
     holds
       ([x,node.[l,[v,r]]] in Ge iff
          v <= x & [x,l] in Ge & [x,r] in Ge)) &
    t <> emptyT
  holds
    t <> emptyT &
    (for result being Integer st
       ex v,o1 being Integer,
          l,r being Element of Tree st
         t = node.[l,[v,r]] &
         [o1,r] in Ge &
         v <= o1 &
         (o1 = v or [o1,r] in Mem) &
         [result,l] in Ge &
         o1 <= result &
         (result = o1 or [result,l] in Mem)
     holds
       [result,t] in Ge &
       [result,t] in Mem)
proof
end;
::$P+
