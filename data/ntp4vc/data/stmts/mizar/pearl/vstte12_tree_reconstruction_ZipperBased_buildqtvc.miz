:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/vstte12_tree_reconstruction_ZipperBased_buildqtvc: the initial
:: zipper invariant and the success and failure specifications for
:: reconstructing a binary tree from its leaf-depth list.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSEQ_5;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_5;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Tree being non empty set,
      leafT being Element of Tree,
      node being Function of [:Tree,Tree:],Tree,
      Depths being Function of [:INT,Tree:],INT*,
      ForestDepths being Function of [:INT,Tree:]*,INT*,
      Greedy being Subset of [:INT,[:INT,Tree:]:],
      G,OnlyLeaf being Subset of [:INT,Tree:]*,
      MapLeaf being Function of INT*,[:INT,Tree:]*,
      s being FinSequence of INT
  st
    (for l,r being Element of Tree holds
       node.[l,r] <> leafT) &
    (for u being Element of Tree holds
       u = leafT or
       ex l,r being Element of Tree st
         u = node.[l,r]) &
    (for l,l2,r,r2 being Element of Tree st
       node.[l,r] = node.[l2,r2]
     holds
       l = l2 & r = r2) &
    (for X being Subset of Tree st
       leafT in X &
       (for l,r being Element of Tree st
          l in X & r in X
        holds
          node.[l,r] in X)
     holds
       X = Tree) &
    (for d being Integer holds
       Depths.[d,leafT] = <*d*>) &
    (for d being Integer,
         l,r being Element of Tree
     holds
       Depths.[d,node.[l,r]] =
         Depths.[d+1,l] ^ Depths.[d+1,r]) &
    ForestDepths.(<*>([:INT,Tree:])) = <*>(INT) &
    (for d being Integer,
         t being Element of Tree,
         rest being FinSequence of [:INT,Tree:]
     holds
       ForestDepths.(<*[d,t]*> ^ rest) =
         Depths.[d,t] ^ ForestDepths.rest) &
    (for d,d1 being Integer holds
       ([d,[d1,leafT]] in Greedy iff d <> d1)) &
    (for d,d1 being Integer,
         l,r being Element of Tree
     holds
       ([d,[d1,node.[l,r]]] in Greedy iff
         d <> d1 & [d,[d1+1,l]] in Greedy)) &
    <*>([:INT,Tree:]) in G &
    (for d being Integer,
         t being Element of Tree
     holds
       <*[d,t]*> in G) &
    (for d1,d2 being Integer,
         t1,t2 being Element of Tree,
         rest being FinSequence of [:INT,Tree:]
     holds
       (<*[d2,t2]*> ^ (<*[d1,t1]*> ^ rest) in G iff
         [d1,[d2,t2]] in Greedy &
         <*[d1,t1]*> ^ rest in G)) &
    <*>([:INT,Tree:]) in OnlyLeaf &
    (for d being Integer,
         t being Element of Tree,
         rest being FinSequence of [:INT,Tree:]
     holds
       (<*[d,t]*> ^ rest in OnlyLeaf iff
         t = leafT & rest in OnlyLeaf)) &
    MapLeaf.(<*>(INT)) = <*>([:INT,Tree:]) &
    (for d being Integer,
         rest being FinSequence of INT
     holds
       MapLeaf.(<*d*> ^ rest) =
         <*[d,leafT]*> ^ MapLeaf.rest)
  holds
    (<*>([:INT,Tree:]) in G &
     (for d2 being Integer,
          t2 being Element of Tree,
          rightTail being FinSequence of [:INT,Tree:] st
        MapLeaf.s = <*[d2,t2]*> ^ rightTail
      holds
        rightTail in OnlyLeaf &
        (t2 = leafT or
         ex l2,r2 being Element of Tree st
           t2 = node.[l2,r2] &
           <*[d2+1,l2]*> ^ <*>([:INT,Tree:]) in G))) &
    (for result being Element of Tree st
       Depths.[0,result] =
         ForestDepths.(Rev (<*>([:INT,Tree:])) ^ MapLeaf.s)
     holds
       Depths.[0,result] = s) &
    ((for t being Element of Tree holds
        Depths.[0,t] <>
          ForestDepths.(Rev (<*>([:INT,Tree:])) ^ MapLeaf.s))
     implies
       for t being Element of Tree holds
         Depths.[0,t] <> s)
proof
end;
::$P+
