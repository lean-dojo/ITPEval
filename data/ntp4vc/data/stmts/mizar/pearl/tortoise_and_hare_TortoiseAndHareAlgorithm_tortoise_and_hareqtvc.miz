:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/tortoise_and_hare_TortoiseAndHareAlgorithm_tortoise_and_hareqtvc:
:: Floyd's tortoise-and-hare cycle-detection verification condition over an
:: iterated integer self-map on a finite interval. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1, XBOOLEAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,x0,mu,lambda0 being Integer,
      f,x being Function of INT,INT st
    0 < m &
    (for z being Integer st 0 <= z & z < m
     holds
       ex fz being Integer st
         fz = f.z & 0 <= fz & fz < m) &
    0 <= x0 & x0 < m &
    x.0 = x0 &
    (for k being Integer st 0 <= k
     holds x.(k+1) = f.(x.k)) &
    0 <= mu &
    mu < m &
    1 <= lambda0 &
    lambda0 <= m &
    mu + lambda0 <= m &
    x.(mu + lambda0) = x.mu &
    (for i,j being Integer st
       0 <= i & i < j & j < mu + lambda0
     holds x.i <> x.j)
  holds
    1 <= 1 &
    1 <= mu + lambda0 &
    f.x0 = x.1 &
    f.(f.x0) = x.(2*1) &
    (for i being Integer st 1 <= i & i < 1
     holds x.i <> x.(2*i)) &
    (for n being Integer st
       (1 <= n & n <= mu + lambda0) &
       (for i being Integer st 1 <= i & i < n
        holds x.i <> x.(2*i))
     holds
       ((x.n <> x.(2*n)) &
          (not (mu + lambda0 < n + 1)) &
          ((not (mu + lambda0 < n + 1)) implies
            (0 <= mu + lambda0 - n &
             mu + lambda0 - (n + 1) < mu + lambda0 - n) &
            (1 <= n + 1 & n + 1 <= mu + lambda0) &
            f.(x.n) = x.(n + 1) &
            f.(f.(x.(2*n))) = x.(2*(n + 1)) &
            (for i being Integer st 1 <= i & i < n + 1
             holds x.i <> x.(2*i)))) or
        (x.n = x.(2*n)) &
          (0 <= 0 & 0 <= mu) &
          (x0 = x.0 & x.n = x.(n + 0)) &
          (for j being Integer st 0 <= j & j < 0
           holds x.j <> x.(n + j)) &
          (for j being Integer st 0 < j & j < 0
           holds x.(n + j) <> x.n) &
          (for lam,i being Integer st
             (0 <= i & i <= mu) &
             (for j being Integer st 0 <= j & j < i
              holds x.j <> x.(n + j)) &
             (((lam = 0) &
                (for j being Integer st 0 < j & j < i
                 holds x.(n + j) <> x.n)) or
              ((lam <> 0) & lam = lambda0))
           holds
             ((x.i <> x.(n + i)) &
                (for o1 being Element of BOOLEAN st
                   (((lam = 0) & 0 < i &
                       x.(n + i) = x.n & o1 = TRUE) or
                    ((lam = 0) & 0 < i &
                       x.(n + i) <> x.n & o1 = FALSE) or
                    ((lam = 0) & not (0 < i) & o1 = FALSE) or
                    ((lam <> 0) & o1 = FALSE))
                 holds
                   ((o1 = TRUE) &
                      (0 <= mu - i &
                       mu - (i + 1) < mu - i) &
                      (0 <= i + 1 & i + 1 <= mu) &
                      (f.(x.i) = x.(i + 1) &
                       f.(x.(n + i)) = x.(n + (i + 1))) &
                      (for j being Integer st
                         0 <= j & j < i + 1
                       holds x.j <> x.(n + j)) &
                      (((i = 0) &
                         (for j being Integer st
                            0 < j & j < i + 1
                          holds x.(n + j) <> x.n)) or
                       ((i <> 0) & i = lambda0))) or
                    (o1 <> TRUE) &
                      (0 <= mu - i &
                       mu - (i + 1) < mu - i) &
                      (0 <= i + 1 & i + 1 <= mu) &
                      (f.(x.i) = x.(i + 1) &
                       f.(x.(n + i)) = x.(n + (i + 1))) &
                      (for j being Integer st
                         0 <= j & j < i + 1
                       holds x.j <> x.(n + j)) &
                      (((lam = 0) &
                         (for j being Integer st
                            0 < j & j < i + 1
                          holds x.(n + j) <> x.n)) or
                       ((lam <> 0) & lam = lambda0)))) or
              (x.i = x.(n + i)) &
                (for l being Integer st
                   (((lam = 0) & l = n) or
                    ((lam <> 0) & l = lam))
                 holds
                   ((0 <= i & i < m) &
                    (1 <= l & l <= m) &
                    i + l <= m &
                    x.(i + l) = x.i) &
                   (for i1,j being Integer st
                      0 <= i1 & i1 < j & j < i + l
                    holds x.i1 <> x.j))))
proof
end;
::$P+
