:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/vstte12_bfs_BFS_fill_nextqtvc: the breadth-first-search fill-next
:: verification condition preserves the shortest-path frontier invariant
:: while moving each unvisited successor into visited and next.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for V,SetRep being non empty set,
      nextV being Function of V,(bool V),
      toFset being Function of SetRep,(bool V),
      fcard being Function of (bool V),INT,
      choose1 being Function of SetRep,V,
      nthV being Function of [:V*,INT:],V,
      Path,ShortestPath being Subset of [:V,[:V,INT:]:],
      Inv being
        Subset of
          [:V,[:V,[:(bool V),[:(bool V),[:(bool V),INT:]:]:]:]:],
      Closure being
        Subset of [:(bool V),[:(bool V),[:(bool V),V:]:]:],
      s,t,v being Element of V,
      visited,current,next,acc being Element of SetRep,
      d being Integer
  st
    (for q being FinSequence of V, i being Integer st
       0 <= i & i < len q
     holds nthV.[q,i] = q.(i+1)) &
    (for x being Element of V holds nextV.x is finite) &
    (for q being Element of SetRep holds toFset.q is finite) &
    (for X being finite Subset of V holds fcard.X = card X) &
    (for q being Element of SetRep st toFset.q <> {}
     holds choose1.q in toFset.q) &
    (for x,y being Element of V, n being Integer holds
       ([x,[y,n]] in Path iff
        0 <= n &
        ex walk being FinSequence of V st
          len walk = n+1 &
          nthV.[walk,0] = x &
          nthV.[walk,n] = y &
          for k being Integer st 0 <= k & k < n
          holds nthV.[walk,k+1] in nextV.(nthV.[walk,k]))) &
    (for x,y being Element of V, n being Integer holds
       ([x,[y,n]] in ShortestPath iff
        [x,[y,n]] in Path &
        (for m being Integer st m < n
         holds not [x,[y,m]] in Path))) &
    (for s0,t0 being Element of V,
         visited0,current0,next0 being Subset of V,
         d0 being Integer
     holds
       ([s0,[t0,[visited0,[current0,[next0,d0]]]]] in Inv iff
        current0 c= visited0 &
        (for x being Element of V st x in current0
         holds [s0,[x,d0]] in ShortestPath) &
        next0 c= visited0 &
        (for x being Element of V st x in next0
         holds [s0,[x,d0+1]] in ShortestPath) &
        (for x being Element of V, m being Integer st
           [s0,[x,m]] in Path & m <= d0
         holds x in visited0) &
        (for x being Element of V st x in visited0
         holds
           ex m being Integer st
             [s0,[x,m]] in Path & m <= d0+1) &
        (for x being Element of V st
           [s0,[x,d0+1]] in ShortestPath
         holds x in next0 or not x in visited0) &
        (t0 in visited0 implies
           t0 in current0 or t0 in next0))) &
    (for visited0,current0,next0 being Subset of V,
         x being Element of V
     holds
       ([visited0,[current0,[next0,x]]] in Closure iff
        (x in visited0 & not x in current0 & not x in next0
         implies
           for y being Element of V st y in nextV.x
           holds y in visited0))) &
    [s,[t,[toFset.visited,
      [toFset.current,[toFset.next,d]]]]] in Inv &
    [s,[v,d]] in ShortestPath &
    (for x being Element of V st x <> v
     holds
       [toFset.visited,
        [toFset.current,[toFset.next,x]]] in Closure) &
    toFset.acc = nextV.v
  holds
    [s,[t,[toFset.visited,
      [toFset.current,[toFset.next,d]]]]] in Inv &
    toFset.acc c= nextV.v &
    nextV.v \ toFset.acc c= toFset.visited &
    (for x being Element of V st x <> v
     holds
       [toFset.visited,
        [toFset.current,[toFset.next,x]]] in Closure) &
    (for acc1,next1,visited1 being Element of SetRep st
       [s,[t,[toFset.visited1,
         [toFset.current,[toFset.next1,d]]]]] in Inv &
       toFset.acc1 c= nextV.v &
       nextV.v \ toFset.acc1 c= toFset.visited1 &
       (for x being Element of V st x <> v
        holds
          [toFset.visited1,
           [toFset.current,[toFset.next1,x]]] in Closure)
     holds
       (toFset.acc1 <> {} implies
          toFset.acc1 <> {} &
          (for acc2 being Element of SetRep holds
            (choose1.acc1 in toFset.acc1 &
             toFset.acc2 =
               toFset.acc1 \ {choose1.acc1}
             implies
               ((not choose1.acc1 in toFset.visited1
                 implies
                   for visited2 being Element of SetRep st
                     toFset.visited2 =
                       toFset.visited1 \/ {choose1.acc1} &
                     (choose1.acc1 in toFset.visited1
                      implies
                        fcard.(toFset.visited2) =
                          fcard.(toFset.visited1)) &
                     (not choose1.acc1 in toFset.visited1
                      implies
                        fcard.(toFset.visited2) =
                          fcard.(toFset.visited1) + 1)
                   holds
                     for next2 being Element of SetRep st
                       toFset.next2 =
                         toFset.next1 \/ {choose1.acc1} &
                       (choose1.acc1 in toFset.next1
                        implies
                          fcard.(toFset.next2) =
                            fcard.(toFset.next1)) &
                       (not choose1.acc1 in toFset.next1
                        implies
                          fcard.(toFset.next2) =
                            fcard.(toFset.next1) + 1)
                     holds
                       (0 <= fcard.(toFset.acc1) &
                        fcard.(toFset.acc2) <
                          fcard.(toFset.acc1)) &
                       [s,[t,[toFset.visited2,
                         [toFset.current,
                          [toFset.next2,d]]]]] in Inv &
                       toFset.acc2 c= nextV.v &
                       nextV.v \ toFset.acc2 c=
                         toFset.visited2 &
                       (for x being Element of V st x <> v
                        holds
                          [toFset.visited2,
                           [toFset.current,
                            [toFset.next2,x]]] in Closure)) &
                (choose1.acc1 in toFset.visited1
                 implies
                   (0 <= fcard.(toFset.acc1) &
                    fcard.(toFset.acc2) <
                      fcard.(toFset.acc1)) &
                   [s,[t,[toFset.visited1,
                     [toFset.current,
                      [toFset.next1,d]]]]] in Inv &
                   toFset.acc2 c= nextV.v &
                   nextV.v \ toFset.acc2 c=
                     toFset.visited1 &
                   (for x being Element of V st x <> v
                    holds
                      [toFset.visited1,
                       [toFset.current,
                        [toFset.next1,x]]] in Closure))))) &
       (toFset.acc1 = {} implies
          [s,[t,[toFset.visited1,
            [toFset.current,[toFset.next1,d]]]]] in Inv &
          nextV.v c= toFset.visited1 &
          (for x being Element of V holds
            [toFset.visited1,
             [toFset.current,[toFset.next1,x]]] in Closure))))
proof
end;
::$P+
