:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sumrange_CumulativeArray_updateqtvc: the verification condition for
:: updating an integer array and its cumulative-sum array while preserving
:: the cumulative invariant and unchanged entries. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for c,a being FinSequence of INT,
      i,v being Integer,
      nthInt being Function of [:INT*,INT:],INT,
      setInt being Function of [:INT*,[:INT,INT:]:],INT*,
      rangeSum being Function of [:INT*,[:INT,INT:]:],INT,
      Cumulative being Subset of [:INT*,INT*:]
  st
    (for xs being FinSequence of INT, q being Integer holds
      (q < 0 implies nthInt.[xs,q] = 0) &
      (0 <= q & q < len xs implies
        nthInt.[xs,q] = xs.(q+1)) &
      (len xs <= q implies nthInt.[xs,q] = 0)) &
    (for xs being FinSequence of INT, q,x being Integer holds
      len (setInt.[xs,[q,x]]) = len xs &
      ((0 <= q & q < len xs) implies
        for k being Integer holds
          (k = q implies
            nthInt.[setInt.[xs,[q,x]],k] = x) &
          (k <> q implies
            nthInt.[setInt.[xs,[q,x]],k] =
              nthInt.[xs,k])) &
      ((q < 0 or len xs <= q) implies
        setInt.[xs,[q,x]] = xs)) &
    (for xs being FinSequence of INT, lo,hi being Integer st
      0 <= lo & lo <= hi & hi <= len xs
     holds
      (hi <= lo implies rangeSum.[xs,[lo,hi]] = 0) &
      (not hi <= lo implies
        for x1 being Integer st x1 = nthInt.[xs,lo] holds
          for x2 being Integer st
            x2 = rangeSum.[xs,[lo+1,hi]]
          holds rangeSum.[xs,[lo,hi]] = x1 + x2)) &
    (for cs,xs being FinSequence of INT holds
      ([cs,xs] in Cumulative iff
        len cs = len xs + 1 &
        (for q being Integer st 0 <= q & q < len cs
         holds
          nthInt.[cs,q] = rangeSum.[xs,[0,q]]))) &
    [c,a] in Cumulative &
    0 <= i &
    i < len a
  holds
    0 <= i &
    i < len c &
    (for o1 being Integer st o1 = i + 1 holds
      (0 <= o1 & o1 < len c) &
      (for co1 being Integer st co1 = nthInt.[c,o1] holds
       for ci being Integer st ci = nthInt.[c,i] holds
       for incr being Integer st incr = v - co1 + ci holds
        (0 <= i & i < len a) &
        (len (setInt.[a,[i,v]]) = len a implies
          ((for q being Integer holds
              (q = i implies
                nthInt.[setInt.[a,[i,v]],q] = v) &
              (q <> i implies
                nthInt.[setInt.[a,[i,v]],q] =
                  nthInt.[a,q]))
           implies
            for o2 being Integer st o2 = len c - 1 holds
              for o3 being Integer st o3 = i + 1 holds
                ((o3 <= o2 + 1 implies
                  ((for k being Integer st
                      o3 <= k & k < len c
                    holds
                      for sk being Integer st
                        sk = rangeSum.[setInt.[a,[i,v]],[0,k]]
                      holds nthInt.[c,k] = sk - incr) &
                   (for k being Integer st
                      0 <= k & k < o3
                    holds
                      nthInt.[c,k] =
                        rangeSum.[setInt.[a,[i,v]],[0,k]])) &
                  (for c1 being FinSequence of INT st
                    len c1 = len c
                   holds
                    ((for j being Integer st
                        (o3 <= j & j <= o2) &
                        (for k being Integer st
                          j <= k & k < len c1
                         holds
                          for sk being Integer st
                            sk = rangeSum.[setInt.[a,[i,v]],[0,k]]
                          holds nthInt.[c1,k] = sk - incr) &
                        (for k being Integer st
                          0 <= k & k < j
                         holds
                          nthInt.[c1,k] =
                            rangeSum.[setInt.[a,[i,v]],[0,k]])
                       holds
                        (0 <= j & j < len c1) &
                        (for c1j being Integer st
                          c1j = nthInt.[c1,j]
                         holds
                         for o4 being Integer st o4 = c1j + incr holds
                          (0 <= j & j < len c1) &
                          (len (setInt.[c1,[j,o4]]) = len c1
                           implies
                            ((for q being Integer holds
                                (q = j implies
                                  nthInt.[setInt.[c1,[j,o4]],q] =
                                    o4) &
                                (q <> j implies
                                  nthInt.[setInt.[c1,[j,o4]],q] =
                                    nthInt.[c1,q]))
                             implies
                              (for k being Integer st
                                j + 1 <= k &
                                k < len (setInt.[c1,[j,o4]])
                               holds
                                for sk being Integer st
                                  sk = rangeSum.
                                    [setInt.[a,[i,v]],[0,k]]
                                holds
                                  nthInt.[setInt.[c1,[j,o4]],k] =
                                    sk - incr) &
                              (for k being Integer st
                                0 <= k & k < j + 1
                               holds
                                nthInt.[setInt.[c1,[j,o4]],k] =
                                  rangeSum.
                                    [setInt.[a,[i,v]],[0,k]]))))) &
                     (((for k being Integer st
                          o2 + 1 <= k & k < len c1
                        holds
                          for sk being Integer st
                            sk = rangeSum.[setInt.[a,[i,v]],[0,k]]
                          holds nthInt.[c1,k] = sk - incr) &
                       (for k being Integer st
                          0 <= k & k < o2 + 1
                        holds
                          nthInt.[c1,k] =
                            rangeSum.[setInt.[a,[i,v]],[0,k]]))
                      implies
                        [c1,setInt.[a,[i,v]]] in Cumulative &
                        nthInt.[setInt.[a,[i,v]],i] = v &
                        (for k being Integer st
                          (0 <= k &
                           k < len (setInt.[a,[i,v]])) &
                          k <> i
                         holds
                          nthInt.[setInt.[a,[i,v]],k] =
                            nthInt.[a,k]))))) &
                 (o2 + 1 < o3 implies
                    [c,setInt.[a,[i,v]]] in Cumulative &
                    nthInt.[setInt.[a,[i,v]],i] = v &
                    (for k being Integer st
                      (0 <= k &
                       k < len (setInt.[a,[i,v]])) &
                      k <> i
                     holds
                      nthInt.[setInt.[a,[i,v]],k] =
                        nthInt.[a,k])))))))
proof
end;
::$P+
