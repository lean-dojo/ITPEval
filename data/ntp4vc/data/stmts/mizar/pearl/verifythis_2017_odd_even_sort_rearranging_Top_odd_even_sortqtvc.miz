:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2017_odd_even_sort_rearranging_Top_odd_even_sortqtvc:
:: the odd-even sorting verification condition preserves permutations and
:: parity-indexed ordering invariants while entropy and loop variants decrease
:: through both sorting passes. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_2, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1, XTUPLE_0, BINOP_1, BINOP_2,
    FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2, FINSOP_1,
    RVSUM_1, CLASSES1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_2, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN,
    BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, CLASSES1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, REAL_1,
    INT_1, INT_2, XXREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, PRE_POLY,
    FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, BINOP_1, BINOP_2,
    FUNCOP_1, FINSEQOP, SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1,
    CLASSES1, ZFMISC_1, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_2, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, RVSUM_1, FUNCOP_1, FRAENKEL, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for arrayMax being Function of INT*,INT,
      nthElem being Function of [:INT*,INT:],INT,
      entropy being Function of [:INT*,INT:],INT,
      Sorted,OddFull being Subset of INT*,
      OddPrefix,EvenPrefix being Subset of [:INT*,INT:],
      Exchange being Subset of
        [:INT*,[:INT*,[:INT,INT:]:]:]
  st
    (for s being FinSequence of INT, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = 0) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = 0)) &
    (for b being FinSequence of INT, z being Integer holds
       ex terms being FinSequence of INT st
         len terms = len b &
         (for k being Nat st k < len b holds
            terms.(k+1) = k * (z - b.(k+1))) &
         entropy.[b,z] = Sum terms) &
    (for b being FinSequence of INT holds
       (b in Sorted iff
         for p,q being Integer st
           0 <= p & p <= q & q < len b
         holds nthElem.[b,p] <= nthElem.[b,q])) &
    (for b being FinSequence of INT, u being Integer holds
       ([b,u] in OddPrefix iff
         for j being Integer st 0 <= j & j < u
         holds
           j mod 2 = 1 implies
             nthElem.[b,j] <= nthElem.[b,j+1])) &
    (for b being FinSequence of INT holds
       (b in OddFull iff
         for j being Integer st
           (0 <= j & j < len b - 1) & j mod 2 = 1
         holds nthElem.[b,j] <= nthElem.[b,j+1])) &
    (for b being FinSequence of INT, u being Integer holds
       ([b,u] in EvenPrefix iff
         for j being Integer st
           (0 <= j & j < u) & j mod 2 = 0
         holds nthElem.[b,j] <= nthElem.[b,j+1])) &
    (for s,t being FinSequence of INT, i,j being Integer holds
       ([s,[t,[i,j]]] in Exchange iff
         len s = len t &
         nthElem.[t,i] = nthElem.[s,j] &
         nthElem.[t,j] = nthElem.[s,i] &
         (for k being Integer st
           0 <= k & k < len s & k <> i & k <> j
          holds nthElem.[t,k] = nthElem.[s,k])))
  holds
    for a being FinSequence of INT st 0 < len a holds
      (for j being Integer st 0 <= j & j < len a
       holds nthElem.[a,j] <= arrayMax.a)
      implies
        a,a are_fiberwise_equipotent &
        (for ok being Element of BOOLEAN,
             a1 being FinSequence of INT st
           len a1 = len a
         holds
           (a,a1 are_fiberwise_equipotent &
            (ok = TRUE implies a1 in Sorted))
           implies
             (ok <> TRUE implies
               (a,a1 are_fiberwise_equipotent &
                (0 <= 1 & 1 <= len a1) &
                1 mod 2 = 1 &
                [a1,1] in OddPrefix &
                (FALSE = TRUE implies
                  entropy.[a1,arrayMax.a] <
                    entropy.[a1,arrayMax.a])) &
               (for i being Integer,
                    ok1 being Element of BOOLEAN,
                    a2 being FinSequence of INT
                holds
                  (len a2 = len a1 &
                   a,a2 are_fiberwise_equipotent &
                   (0 <= i & i <= len a2) &
                   i mod 2 = 1 &
                   (ok1 = TRUE implies
                     entropy.[a2,arrayMax.a] =
                       entropy.[a1,arrayMax.a]) &
                   (ok1 = TRUE implies
                     [a2,i] in OddPrefix) &
                   (ok1 <> TRUE implies
                     entropy.[a2,arrayMax.a] <
                       entropy.[a1,arrayMax.a]))
                    implies
                      (i < len a2 - 1 implies
                        (0 <= i+1 & i+1 < len a2) &
                        (0 <= i & i < len a2) &
                        (nthElem.[a2,i+1] < nthElem.[a2,i]
                         implies
                           nthElem.[a2,i+1] <
                             nthElem.[a2,i] &
                           0 <= i & i < i+1 &
                           i+1 < len a2 &
                           (for a3 being FinSequence of INT
                            holds
                              (len a3 = len a2 &
                               [a2,[a3,[i,i+1]]] in Exchange &
                               entropy.[a3,arrayMax.a] <
                                 entropy.[a2,arrayMax.a])
                                implies
                                  (0 <= len a2 - i &
                                   len a3 - (i+2) <
                                     len a2 - i) &
                                  a,a3 are_fiberwise_equipotent &
                                  (0 <= i+2 &
                                   i+2 <= len a3) &
                                  (i+2) mod 2 = 1 &
                                  (FALSE = TRUE implies
                                    entropy.[a3,arrayMax.a] =
                                      entropy.[a1,arrayMax.a]) &
                                  (FALSE = TRUE implies
                                    [a3,i+2] in OddPrefix) &
                                  (FALSE <> TRUE implies
                                    entropy.[a3,arrayMax.a] <
                                      entropy.[a1,arrayMax.a]))) &
                        (not nthElem.[a2,i+1] < nthElem.[a2,i]
                         implies
                           (0 <= len a2 - i &
                            len a2 - (i+2) < len a2 - i) &
                           a,a2 are_fiberwise_equipotent &
                           (0 <= i+2 & i+2 <= len a2) &
                           (i+2) mod 2 = 1 &
                           (ok1 = TRUE implies
                             entropy.[a2,arrayMax.a] =
                               entropy.[a1,arrayMax.a]) &
                           (ok1 = TRUE implies
                             [a2,i+2] in OddPrefix) &
                           (ok1 <> TRUE implies
                             entropy.[a2,arrayMax.a] <
                               entropy.[a1,arrayMax.a]))) &
                       (not i < len a2 - 1 implies
                         (a,a2 are_fiberwise_equipotent &
                          (0 <= 0 & 0 <= len a2) &
                          0 mod 2 = 0 &
                          (ok1 = TRUE implies
                            entropy.[a2,arrayMax.a] =
                              entropy.[a1,arrayMax.a]) &
                          (ok1 = TRUE implies a2 in OddFull) &
                          (ok1 = TRUE implies
                            [a2,0] in EvenPrefix) &
                          (ok1 <> TRUE implies
                            entropy.[a2,arrayMax.a] <
                              entropy.[a1,arrayMax.a])) &
                         (for i1 being Integer,
                              ok2 being Element of BOOLEAN,
                              a3 being FinSequence of INT
                          holds
                            (len a3 = len a2 &
                             a,a3 are_fiberwise_equipotent &
                             (0 <= i1 & i1 <= len a3) &
                             i1 mod 2 = 0 &
                             (ok2 = TRUE implies
                               entropy.[a3,arrayMax.a] =
                                 entropy.[a1,arrayMax.a]) &
                             (ok2 = TRUE implies
                               a3 in OddFull) &
                             (ok2 = TRUE implies
                               [a3,i1] in EvenPrefix) &
                             (ok2 <> TRUE implies
                               entropy.[a3,arrayMax.a] <
                                 entropy.[a1,arrayMax.a]))
                              implies
                                (i1 < len a3 - 1 implies
                                  (0 <= i1+1 &
                                   i1+1 < len a3) &
                                  (0 <= i1 &
                                   i1 < len a3) &
                                  (nthElem.[a3,i1+1] <
                                     nthElem.[a3,i1]
                                   implies
                                     nthElem.[a3,i1+1] <
                                       nthElem.[a3,i1] &
                                     0 <= i1 & i1 < i1+1 &
                                     i1+1 < len a3 &
                                     (for a4 being
                                        FinSequence of INT
                                      holds
                                        (len a4 = len a3 &
                                         [a3,[a4,[i1,i1+1]]]
                                           in Exchange &
                                         entropy.[a4,arrayMax.a] <
                                           entropy.[a3,arrayMax.a])
                                          implies
                                            (0 <= len a3 - i1 &
                                             len a4 - (i1+2) <
                                               len a3 - i1) &
                                            a,a4
                                              are_fiberwise_equipotent &
                                            (0 <= i1+2 &
                                             i1+2 <= len a4) &
                                            (i1+2) mod 2 = 0 &
                                            (FALSE = TRUE implies
                                              entropy.[a4,arrayMax.a] =
                                                entropy.[a1,arrayMax.a]) &
                                            (FALSE = TRUE implies
                                              a4 in OddFull) &
                                            (FALSE = TRUE implies
                                              [a4,i1+2]
                                                in EvenPrefix) &
                                            (FALSE <> TRUE implies
                                              entropy.[a4,arrayMax.a] <
                                                entropy.[a1,arrayMax.a]))) &
                                  (not nthElem.[a3,i1+1] <
                                      nthElem.[a3,i1]
                                   implies
                                     (0 <= len a3 - i1 &
                                      len a3 - (i1+2) <
                                        len a3 - i1) &
                                     a,a3
                                       are_fiberwise_equipotent &
                                     (0 <= i1+2 &
                                      i1+2 <= len a3) &
                                     (i1+2) mod 2 = 0 &
                                     (ok2 = TRUE implies
                                       entropy.[a3,arrayMax.a] =
                                         entropy.[a1,arrayMax.a]) &
                                     (ok2 = TRUE implies
                                       a3 in OddFull) &
                                     (ok2 = TRUE implies
                                       [a3,i1+2]
                                         in EvenPrefix) &
                                     (ok2 <> TRUE implies
                                       entropy.[a3,arrayMax.a] <
                                         entropy.[a1,arrayMax.a]))) &
                                 (not i1 < len a3 - 1 implies
                                   ex d,d2 being Integer st
                                     ((ok = TRUE & d = 0) or
                                      (ok <> TRUE & d = 1)) &
                                     ((ok2 = TRUE & d2 = 0) or
                                      (ok2 <> TRUE & d2 = 1)) &
                                     0 <=
                                       entropy.[a1,arrayMax.a] + d &
                                     entropy.[a3,arrayMax.a] + d2 <
                                       entropy.[a1,arrayMax.a] + d &
                                     a,a3
                                       are_fiberwise_equipotent &
                                     (ok2 = TRUE implies
                                       a3 in Sorted)))))) &
              (ok = TRUE implies
                a1 in Sorted &
                a,a1 are_fiberwise_equipotent))
proof
end;
::$P+
