:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_fm2012_treedel_Treedel_search_tree_delete_minqtvc:
:: the verification condition for deleting the minimum node of a nonempty
:: binary search-tree representation by a left-descending zipper traversal.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L,N,Tree,Zipper being non empty set,
      null being Element of L,
      nodeMk being Function of [:L,[:L,INT:]:],N,
      Left,Right being Function of N,L,
      Data being Function of N,INT,
      EqLoc being Relation of L,L,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:L,Tree:]:],Tree,
      Root being Function of Tree,L,
      Inorder being Function of Tree,L*,
      Distinct being Subset of L*,
      IsTree being
        Subset of [:Funcs(L,N),Tree:],
      top being Element of Zipper,
      leftZ being Function of [:Zipper,[:L,Tree:]:],Zipper,
      ZipFn being Function of [:Tree,Zipper:],Tree,
      initialTree being Element of Tree,
      mem being Function of L,N
  st
    (for l,r being Element of L,
         d being Integer
     holds
       Left.(nodeMk.[l,[r,d]]) = l &
       Right.(nodeMk.[l,[r,d]]) = r &
       Data.(nodeMk.[l,[r,d]]) = d) &
    (for n being Element of N holds
       nodeMk.[Left.n,[Right.n,Data.n]] = n) &
    (for x,y being Element of L holds
       ([x,y] in EqLoc iff x = y)) &

    (for l,r being Element of Tree,
         p being Element of L
     holds
       node.[l,[p,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          p being Element of L st
         u = node.[l,[p,r]]) &
    (for l,l2,r,r2 being Element of Tree,
         p,p2 being Element of L st
       node.[l,[p,r]] = node.[l2,[p2,r2]]
     holds
       l = l2 & p = p2 & r = r2) &
    (for X being Subset of Tree st
       emptyT in X &
       (for l,r being Element of Tree,
            p being Element of L st
          l in X & r in X
        holds
          node.[l,[p,r]] in X)
     holds
       X = Tree) &

    Root.emptyT = null &
    (for l,r being Element of Tree,
         p being Element of L
     holds
       Root.(node.[l,[p,r]]) = p) &
    Inorder.emptyT = <*>(L) &
    (for l,r being Element of Tree,
         p being Element of L
     holds
       Inorder.(node.[l,[p,r]]) =
         Inorder.l ^ <*p*> ^ Inorder.r) &
    <*>(L) in Distinct &
    (for p being Element of L,
         s being FinSequence of L
     holds
       (<*p*> ^ s in Distinct iff
          s in Distinct & not p in rng s)) &
    (for m being Function of L,N holds
       [m,emptyT] in IsTree) &
    (for m being Function of L,N,
         l,r being Element of Tree,
         p being Element of L
     holds
       ([m,node.[l,[p,r]]] in IsTree iff
          p <> null &
          [m,l] in IsTree &
          [m,r] in IsTree &
          Root.l = Left.(m.p) &
          Root.r = Right.(m.p))) &

    (for z being Element of Zipper,
         p being Element of L,
         r being Element of Tree
     holds
       leftZ.[z,[p,r]] <> top) &
    (for z being Element of Zipper holds
       z = top or
       ex z1 being Element of Zipper,
          p being Element of L,
          r being Element of Tree st
         z = leftZ.[z1,[p,r]]) &
    (for z1,z2 being Element of Zipper,
         p1,p2 being Element of L,
         r1,r2 being Element of Tree st
       leftZ.[z1,[p1,r1]] = leftZ.[z2,[p2,r2]]
     holds
       z1 = z2 & p1 = p2 & r1 = r2) &
    (for X being Subset of Zipper st
       top in X &
       (for z being Element of Zipper,
            p being Element of L,
            r being Element of Tree st
          z in X
        holds
          leftZ.[z,[p,r]] in X)
     holds
       X = Zipper) &
    (for t being Element of Tree holds
       ZipFn.[t,top] = t) &
    (for t,r being Element of Tree,
         z being Element of Zipper,
         p being Element of L
     holds
       ZipFn.[t,leftZ.[z,[p,r]]] =
         ZipFn.[node.[t,[p,r]],z]) &

    Root.initialTree <> null &
    [mem,initialTree] in IsTree &
    Inorder.initialTree in Distinct
  holds
    Root.initialTree <> null &
    (for o1,o2 being Element of L st
       o1 = Left.(mem.(Root.initialTree)) &
       o2 = null
     holds
       ([o1,o2] in EqLoc iff o1 = o2) implies
       (([o1,o2] in EqLoc implies
          Root.initialTree <> null &
          Root.initialTree <> null &
          (ex l,r being Element of Tree,
              p being Element of L st
             initialTree = node.[l,[p,r]] &
             [mem,r] in IsTree &
             Root.r = Right.(mem.(Root.initialTree)) &
             ex q being Element of L,
                s being FinSequence of L st
               Inorder.initialTree = <*q*> ^ s &
               Data.(mem.(Root.initialTree)) = Data.(mem.q) &
               Inorder.r = s)) &
        (not [o1,o2] in EqLoc implies
          o1 <> null &
          initialTree <> emptyT &
          (for o3 being Element of Tree st
             ex l,r being Element of Tree,
                p being Element of L st
               initialTree = node.[l,[p,r]] & o3 = r
           holds
             initialTree <> emptyT &
             (for o4 being Element of Tree st
                ex l,r being Element of Tree,
                   p being Element of L st
                  initialTree = node.[l,[p,r]] & o4 = l
              holds
                ((Root.initialTree <> null &
                  Left.(mem.(Root.initialTree)) = o1) &
                 o1 <> null &
                 [mem,node.[o4,[Root.initialTree,o3]]] in IsTree &
                 ZipFn.[node.[o4,[Root.initialTree,o3]],top] =
                   initialTree) &
                (for subtree,ppr being Element of Tree,
                     zipper1 being Element of Zipper,
                     pp being Element of L st
                   pp <> null &
                   Left.(mem.pp) <> null &
                   [mem,node.[subtree,[pp,ppr]]] in IsTree &
                   ZipFn.[node.[subtree,[pp,ppr]],zipper1] =
                     initialTree
                 holds
                   for o5 being Element of L st o5 = null
                   holds
                     ([Left.(mem.(Left.(mem.pp))),o5] in EqLoc iff
                        Left.(mem.(Left.(mem.pp))) = o5) implies
                     ((not
                         [Left.(mem.(Left.(mem.pp))),o5] in EqLoc
                       implies
                         subtree <> emptyT &
                         (for o6 being Element of Tree st
                            ex l,r being Element of Tree,
                               p being Element of L st
                              subtree = node.[l,[p,r]] & o6 = r
                          holds
                            subtree <> emptyT &
                            (for o7 being Element of Tree st
                               ex l,r being Element of Tree,
                                  p being Element of L st
                                 subtree = node.[l,[p,r]] & o7 = l
                             holds
                               Left.(mem.(Left.(mem.pp))) <> null &
                               (ex f,f1 being Element of Tree,
                                   p being Element of L st
                                  subtree = node.[f,[p,f1]] &
                                  (f = o7 or f1 = o7)) &
                               Left.(mem.pp) <> null &
                               Left.(mem.(Left.(mem.pp))) <> null &
                               [mem,
                                 node.[o7,
                                   [Left.(mem.pp),o6]]] in IsTree &
                               ZipFn.[
                                 node.[o7,[Left.(mem.pp),o6]],
                                 leftZ.[zipper1,[pp,ppr]]] =
                                   initialTree))) &
                      ([Left.(mem.(Left.(mem.pp))),o5] in EqLoc
                       implies
                         Left.(mem.pp) <> null &
                         Left.(mem.pp) <> null &
                         pp <> null &
                         (for mem1 being Function of L,N st
                            mem1.pp =
                              nodeMk.[
                                Right.(mem.(Left.(mem.pp))),
                                [Right.(mem.pp),Data.(mem.pp)]] &
                            (for q being Element of L st q <> pp
                             holds
                               mem1.q = mem.q)
                          holds
                            subtree <> emptyT &
                            (for pl being Element of Tree st
                               ex l,r being Element of Tree,
                                  p being Element of L st
                                 subtree = node.[l,[p,r]] & pl = l
                             holds
                               subtree <> emptyT &
                               (for o6 being Element of Tree st
                                  ex l,r being Element of Tree,
                                     p being Element of L st
                                    subtree = node.[l,[p,r]] &
                                    o6 = r
                                holds
                                  (for p being Element of L holds
                                     Data.(mem1.p) = Data.(mem.p)) &
                                  [mem1,
                                    ZipFn.[o6,
                                      leftZ.[zipper1,
                                        [pp,ppr]]]] in IsTree &
                                  Root.(ZipFn.[o6,
                                    leftZ.[zipper1,[pp,ppr]]]) =
                                    Root.initialTree &
                                  (ex q being Element of L,
                                      s being FinSequence of L st
                                     Inorder.initialTree = <*q*> ^ s &
                                     Data.(mem.(Left.(mem.pp))) =
                                       Data.(mem1.q) &
                                     Inorder.(ZipFn.[o6,
                                       leftZ.[zipper1,
                                         [pp,ppr]]]) = s))))))))))))
proof
end;
::$P+
