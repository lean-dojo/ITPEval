:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_lexicographic_permutations_1_Top_nextqtvc: the
:: verification condition for the in-place lexicographic next-permutation
:: algorithm, including pivot search, swapping, suffix reversal, and the
:: absence of an intermediate permutation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FINSET_1, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FINSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, FRAENKEL, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for nthZ being Function of [:INT*,INT:],INT,
      LexLess,Permuting being Subset of [:INT*,INT*:],
      Descending being Subset of [:INT*,[:INT,INT:]:],
      a,a0 being FinSequence of INT
  st
    (for s being FinSequence of INT, k being Integer holds
       (len s = 0 implies nthZ.[s,k] = 0) &
       (0 < len s & k < 0 implies nthZ.[s,k] = s.1) &
       (0 <= k & k < len s implies nthZ.[s,k] = s.(k+1)) &
       (len s <= k implies nthZ.[s,k] = 0)) &
    (for p,q being FinSequence of INT holds
       ([p,q] in LexLess iff
         len p = len q & 0 < len q &
         ex i being Integer st
           0 <= i & i < len p &
           (for j being Integer st 0 <= j & j < i
            holds nthZ.[p,j] = nthZ.[q,j]) &
           nthZ.[p,i] < nthZ.[q,i])) &
    (for p,q being FinSequence of INT holds
       ([p,q] in Permuting iff
         len p = len q &
         for x being Integer holds
           card {k where k is Integer :
             0 <= k & k < len p & nthZ.[p,k] = x} =
           card {k where k is Integer :
             0 <= k & k < len q & nthZ.[q,k] = x})) &
    (for s being FinSequence of INT, lo,hi being Integer holds
       ([s,[lo,hi]] in Descending iff
         0 <= lo & lo <= hi & hi <= len s &
         for i,j being Integer st
           lo <= i & i <= j & j < hi
         holds nthZ.[s,j] <= nthZ.[s,i])) &
    len a = len a0 &
    [a,a0] in Permuting
  holds
    for n being Integer st n = len a
    holds
      for o1 being Integer st o1 = n-1
      holds
        ((-1 <= o1 & o1 < n) &
         ((o1 = -1 & n = 0) or
          (0 <= o1 & [a,[o1,n]] in Descending))) &
        (for i being Integer st
           (-1 <= i & i < n) &
           ((i = -1 & n = 0) or
            (0 <= i & [a,[i,n]] in Descending))
         holds
           (0 < i implies
             (0 <= i & i < len a) &
             (for io2 being Integer st io2 = i-1
              holds 0 <= io2 & io2 < len a)) &
           (for o2 being Element of BOOLEAN st
              ((0 < i &
                ((nthZ.[a,i] <= nthZ.[a,i-1] & o2 = TRUE) or
                 (not nthZ.[a,i] <= nthZ.[a,i-1] &
                  o2 = FALSE))) or
               (not 0 < i & o2 = FALSE))
            holds
              (o2 = TRUE implies
                (0 <= i & i-1 < i) &
                (-1 <= i-1 & i-1 < n) &
                ((i-1 = -1 & n = 0) or
                 (0 <= i-1 & [a,[i-1,n]] in Descending))) &
              (o2 <> TRUE implies
                (i <= 0 implies
                  [a,a0] in Permuting &
                  (for p being FinSequence of INT st
                     [p,a0] in Permuting
                   holds not [a,p] in LexLess)) &
                (not i <= 0 implies
                  for i0 being Integer st i0 = i-1
                  holds
                    (0 <= i0 & i0 < len a) &
                    (for x being Integer st x = nthZ.[a,i0]
                     holds
                       for o3 being Integer st o3 = n-1
                       holds
                         ((i <= o3 & o3 < n) &
                          (for k being Integer st
                             o3 < k & k < n
                           holds nthZ.[a,k] <= x)) &
                         (for j being Integer st
                            (i <= j & j < n) &
                            (for k being Integer st
                               j < k & k < n
                             holds nthZ.[a,k] <= x)
                          holds
                            for o4 being Integer st o4 = i-1
                            holds
                              (0 <= o4 & o4 < len a) &
                              (0 <= j & j < len a) &
                              (nthZ.[a,j] <= nthZ.[a,o4] implies
                                (0 <= j & j-1 < j) &
                                (i <= j-1 & j-1 < n) &
                                (for k being Integer st
                                   j-1 < k & k < n
                                 holds nthZ.[a,k] <= x)) &
                              (not nthZ.[a,j] <= nthZ.[a,o4]
                               implies
                                (0 <= j & j < len a) &
                                (for z being Integer st
                                   z = nthZ.[a,j]
                                 holds
                                   for o5 being Integer st o5 = i-1
                                   holds
                                     (0 <= o5 & o5 < len a) &
                                     (0 <= j & j < len a) &
                                     (for a1 being
                                          FinSequence of INT st
                                        len a1 = len a &
                                        nthZ.[a1,o5] = nthZ.[a,j] &
                                        nthZ.[a1,j] = nthZ.[a,o5] &
                                        (for k being Integer st
                                           0 <= k & k < len a1 &
                                           k <> o5 & k <> j
                                         holds
                                           nthZ.[a1,k] = nthZ.[a,k]) &
                                        [a1,a] in Permuting
                                      holds
                                        ((i0 < i &
                                          i0 < n-1 & n-1 < n) &
                                         [a1,a0] in Permuting &
                                         (for k being Integer st
                                            0 <= k & k < i0
                                          holds
                                            nthZ.[a1,k] =
                                              nthZ.[a,k]) &
                                         nthZ.[a1,i0] = z &
                                         i-i0 = n-(n-1) &
                                         (for k being Integer st
                                            0 < k & k < i-i0
                                          holds
                                            nthZ.[a1,i0+k] =
                                              nthZ.[a1,n-k] &
                                            nthZ.[a1,n-k] =
                                              nthZ.[a1,i0+k])) &
                                        (for j1,i1 being Integer,
                                             a2 being
                                               FinSequence of INT st
                                           len a2 = len a1 &
                                           i0 < i1 & i0 < j1 &
                                           j1 < n &
                                           [a2,a0] in Permuting &
                                           (for k being Integer st
                                              0 <= k & k < i0
                                            holds
                                              nthZ.[a2,k] =
                                                nthZ.[a,k]) &
                                           nthZ.[a2,i0] = z &
                                           i1-i0 = n-j1 &
                                           (for k being Integer st
                                              i1 <= k & k <= j1
                                            holds
                                              nthZ.[a2,k] =
                                                nthZ.[a1,k]) &
                                           (for k being Integer st
                                              0 < k & k < i1-i0
                                            holds
                                              nthZ.[a2,i0+k] =
                                                nthZ.[a1,n-k] &
                                              nthZ.[a2,n-k] =
                                                nthZ.[a1,i0+k])
                                         holds
                                           (i1 < j1 implies
                                             (0 <= i1 &
                                              i1 < len a2) &
                                             (0 <= j1 &
                                              j1 < len a2) &
                                             (for a3 being
                                                  FinSequence of INT st
                                                len a3 = len a2 &
                                                nthZ.[a3,i1] =
                                                  nthZ.[a2,j1] &
                                                nthZ.[a3,j1] =
                                                  nthZ.[a2,i1] &
                                                (for k being Integer st
                                                   0 <= k &
                                                   k < len a3 &
                                                   k <> i1 & k <> j1
                                                 holds
                                                   nthZ.[a3,k] =
                                                     nthZ.[a2,k]) &
                                                [a3,a2] in Permuting
                                              holds
                                                (0 <= j1-i1 &
                                                 j1-1-(i1+1) <
                                                   j1-i1) &
                                                (i0 < i1+1 &
                                                 i0 < j1-1 &
                                                 j1-1 < n) &
                                                [a3,a0] in Permuting &
                                                (for k being Integer st
                                                   0 <= k & k < i0
                                                 holds
                                                   nthZ.[a3,k] =
                                                     nthZ.[a,k]) &
                                                nthZ.[a3,i0] = z &
                                                i1+1-i0 =
                                                  n-(j1-1) &
                                                (for k being Integer st
                                                   i1+1 <= k &
                                                   k <= j1-1
                                                 holds
                                                   nthZ.[a3,k] =
                                                     nthZ.[a1,k]) &
                                                (for k being Integer st
                                                   0 < k &
                                                   k < i1+1-i0
                                                 holds
                                                   nthZ.[a3,i0+k] =
                                                     nthZ.[a1,n-k] &
                                                   nthZ.[a3,n-k] =
                                                     nthZ.[a1,i0+k]))) &
                                           (not i1 < j1 implies
                                             (for p being
                                                  FinSequence of INT st
                                                [p,a0] in Permuting &
                                                [a,p] in LexLess &
                                                [p,a2] in LexLess
                                              holds
                                                for v being Integer st
                                                  v = nthZ.[p,i0]
                                                holds
                                                  (v = x implies
                                                    for o6,o7 being
                                                        Integer st
                                                      o6 = n-1 &
                                                      o7 = i0+1
                                                    holds
                                                      (o7 <= o6+1
                                                       implies
                                                        (for k being
                                                             Integer st
                                                           i0+1 <= k &
                                                           k < o7
                                                         holds
                                                           nthZ.[p,k] =
                                                             nthZ.[a,k]) &
                                                        (for l being
                                                             Integer st
                                                           (o7 <= l &
                                                            l <= o6) &
                                                           (for k being
                                                                Integer st
                                                              i0+1 <= k &
                                                              k < l
                                                            holds
                                                              nthZ.[p,k] =
                                                                nthZ.[a,k])
                                                         holds
                                                           nthZ.[p,l] =
                                                             nthZ.[a,l] &
                                                           (for k being
                                                                Integer st
                                                              i0+1 <= k &
                                                              k < l+1
                                                            holds
                                                              nthZ.[p,k] =
                                                                nthZ.[a,k])) &
                                                        not
                                                          (for k being
                                                               Integer st
                                                             i0+1 <= k &
                                                             k < o6+1
                                                           holds
                                                             nthZ.[p,k] =
                                                               nthZ.[a,k])) &
                                                      not o6+1 < o7) &
                                                  (v <> x implies
                                                    v = z &
                                                    ((len a2 = len a2 &
                                                      (for i2 being
                                                           Integer st
                                                         0 <= i2 &
                                                         i2 < len a2
                                                       holds
                                                         nthZ.[a2,i2] =
                                                           nthZ.[a2,i2]))
                                                     implies
                                                      for o6,o7 being
                                                          Integer st
                                                        o6 = n-1 &
                                                        o7 = i0+1
                                                      holds
                                                        (o7 <= o6+1
                                                         implies
                                                          (for k being
                                                               Integer st
                                                             i0+1 <= k &
                                                             k < o7
                                                           holds
                                                             nthZ.[p,k] =
                                                               nthZ.[a2,k]) &
                                                          (for l being
                                                               Integer st
                                                             (o7 <= l &
                                                              l <= o6) &
                                                             (for k being
                                                                  Integer st
                                                                i0+1 <= k &
                                                                k < l
                                                              holds
                                                                nthZ.[p,k] =
                                                                  nthZ.[a2,k])
                                                           holds
                                                             nthZ.[p,l] =
                                                               nthZ.[a2,l] &
                                                             (for k being
                                                                  Integer st
                                                                i0+1 <= k &
                                                                k < l+1
                                                              holds
                                                                nthZ.[p,k] =
                                                              nthZ.[a2,k])) &
                                                          not
                                                            (for k being
                                                                 Integer st
                                                               i0+1 <= k &
                                                               k < o6+1
                                                             holds
                                                               nthZ.[p,k] =
                                                             nthZ.[a2,k])) &
                                                        not o6+1 < o7)) &
                                             ((for p being
                                                   FinSequence of INT
                                                holds
                                                  not
                                                    ([p,a0] in
                                                       Permuting &
                                                     [a,p] in LexLess &
                                                     [p,a2] in LexLess))
                                              implies
                                                [a2,a0] in Permuting &
                                                [a,a2] in LexLess &
                                                (for p being
                                                     FinSequence of INT st
                                                   [p,a0] in Permuting
                                                 holds
                                                   not
                                                     ([a,p] in LexLess &
                                                      [p,a2] in
                                                        LexLess)))))))))))))))
proof
end;
::$P+
