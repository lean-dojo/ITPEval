:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/counting_sort_InPlaceCountingSort_in_place_counting_sortqtvc:
:: the in-place counting-sort verification condition maintains occurrence
:: counts while constructing a sorted permutation of an integer list.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4, FUNCOP_1,
    FUNCT_7, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, NAT_1, XXREAL_0, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, NAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for k,alen being Integer,
      a being Function of INT,INT st
    0 < k &
    0 <= alen &
    (for q being Integer st q < 0 holds a.q = a.0) &
    (for q being Integer st alen <= q holds a.q = 0) &
    (for i being Integer st 0 <= i & i < alen
      holds ex x being Integer st x = a.i & 0 <= x & x < k)
  holds
    for o1 being Integer st o1 = k holds
      0 <= o1 &
      (for c being Function of INT,INT st
        (for q being Integer st q < 0 holds c.q = c.0) &
        (for q being Integer st o1 <= q holds c.q = 0) &
        (for i being Integer st 0 <= i & i < o1
          holds c.i = 0)
       holds
        for o2 being Integer st o2 = alen - 1 holds
          (0 <= o2 + 1 implies
            (for v being Integer st 0 <= v & v < k
              holds
                c.v =
                  card {q where q is Integer :
                    0 <= q & q < 0 & a.q = v}) &
            (for c1 being Function of INT,INT st
              (for q being Integer st q < 0
                holds c1.q = c1.0) &
              (for q being Integer st o1 <= q
                holds c1.q = 0)
             holds
              (for i being Integer st
                (0 <= i & i <= o2) &
                (for v being Integer st 0 <= v & v < k
                  holds
                    c1.v =
                      card {q where q is Integer :
                        0 <= q & q < i & a.q = v})
               holds
                (0 <= i & i < alen) &
                (for v being Integer st v = a.i holds
                  (0 <= v & v < o1) &
                  (for o3 being Integer st o3 - 1 = c1.v holds
                    (0 <= v & v < o1) &
                    (for c2 being Function of INT,INT st
                      (for q being Integer st q < 0
                        holds c2.q = c2.0) &
                      (for q being Integer st o1 <= q
                        holds c2.q = 0) &
                      (for q being Integer st 0 <= q & q < o1
                        holds
                          (q = v implies c2.q = o3) &
                          (q <> v implies c2.q = c1.q))
                     holds
                      (for v1 being Integer st
                        0 <= v1 & v1 < k
                       holds
                        c2.v1 =
                          card {q where q is Integer :
                            0 <= q & q < i + 1 &
                            a.q = v1}))))) &
              ((for v being Integer st 0 <= v & v < k
                  holds
                    c1.v =
                      card {q where q is Integer :
                        0 <= q & q < o2 + 1 & a.q = v})
               implies
                (for o3 being Integer st o3 = k - 1 holds
                  (0 <= o3 + 1 implies
                    0 =
                      card {q where q is Integer :
                        0 <= q & q < alen &
                        (ex x being Integer st
                          x = a.q & x < 0)} &
                    (for i1,i2 being Integer st
                      0 <= i1 & i1 <= i2 & i2 < 0
                     holds ex x,y being Integer st
                           x = a.i1 & y = a.i2 & x <= y) &
                    (for e being Integer st 0 <= e & e < 0
                      holds ex x being Integer st
                           x = a.e & 0 <= x & x < 0) &
                    (for f being Integer st 0 <= f & f < 0
                      holds
                        card {q where q is Integer :
                          0 <= q & q < 0 & a.q = f} =
                        card {q where q is Integer :
                          0 <= q & q < alen & a.q = f}) &
                    (for j being Integer,
                         a1 being Function of INT,INT st
                      (for q being Integer st q < 0
                        holds a1.q = a1.0) &
                      (for q being Integer st alen <= q
                        holds a1.q = 0)
                     holds
                      (for v being Integer st
                        (0 <= v & v <= o3) &
                        j =
                          card {q where q is Integer :
                            0 <= q & q < alen &
                            (ex x being Integer st
                              x = a.q & x < v)} &
                        (for i1,i2 being Integer st
                          0 <= i1 & i1 <= i2 & i2 < j
                         holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                        (for e being Integer st 0 <= e & e < j
                          holds ex x being Integer st
                           x = a1.e & 0 <= x & x < v) &
                        (for f being Integer st 0 <= f & f < v
                          holds
                            card {q where q is Integer :
                              0 <= q & q < j & a1.q = f} =
                            card {q where q is Integer :
                              0 <= q & q < alen & a.q = f})
                       holds
                        (0 <= v & v < o1) &
                        (for o4 being Integer st o4 = c1.v holds
                          (1 <= o4 + 1 implies
                            j - 1 + 1 =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                (ex x being Integer st
                                  x = a.q & x < v)} &
                            (for i1,i2 being Integer st
                              0 <= i1 & i1 <= i2 & i2 < j
                             holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                            (for e being Integer st
                              0 <= e & e < j
                             holds ex x being Integer st
                           x = a1.e & 0 <= x & x <= v) &
                            (for f being Integer st
                              0 <= f & f < v
                             holds
                              card {q where q is Integer :
                                0 <= q & q < j & a1.q = f} =
                              card {q where q is Integer :
                                0 <= q & q < alen & a.q = f}) &
                            card {q where q is Integer :
                              0 <= q & q < j & a1.q = v} =
                              1 - 1) &
                          (for j1 being Integer,
                               a2 being Function of INT,INT st
                            (for q being Integer st q < 0
                              holds a2.q = a2.0) &
                            (for q being Integer st alen <= q
                              holds a2.q = 0)
                           holds
                            (for i being Integer st
                              (1 <= i & i <= o4) &
                              j1 - i + 1 =
                                card {q where q is Integer :
                                  0 <= q & q < alen &
                                  (ex x being Integer st
                                    x = a.q & x < v)} &
                              (for i1,i2 being Integer st
                                0 <= i1 & i1 <= i2 & i2 < j1
                               holds ex x,y being Integer st
                           x = a2.i1 & y = a2.i2 & x <= y) &
                              (for e being Integer st
                                0 <= e & e < j1
                               holds ex x being Integer st
                           x = a2.e & 0 <= x & x <= v) &
                              (for f being Integer st
                                0 <= f & f < v
                               holds
                                card {q where q is Integer :
                                  0 <= q & q < j1 & a2.q = f} =
                                card {q where q is Integer :
                                  0 <= q & q < alen & a.q = f}) &
                              card {q where q is Integer :
                                0 <= q & q < j1 & a2.q = v} =
                                  i - 1
                             holds
                              (0 <= j1 & j1 < alen) &
                              (for a3 being Function of INT,INT st
                                (for q being Integer st q < 0
                                  holds a3.q = a3.0) &
                                (for q being Integer st alen <= q
                                  holds a3.q = 0) &
                                (for q being Integer st
                                  0 <= q & q < alen
                                 holds
                                  (q = j1 implies a3.q = v) &
                                  (q <> j1 implies
                                    a3.q = a2.q))
                               holds
                                j1 + 1 - (i + 1) + 1 =
                                  card {q where q is Integer :
                                    0 <= q & q < alen &
                                    (ex x being Integer st
                                      x = a.q & x < v)} &
                                (for i1,i2 being Integer st
                                  0 <= i1 & i1 <= i2 &
                                  i2 < j1 + 1
                                 holds ex x,y being Integer st
                                  x = a3.i1 & y = a3.i2 & x <= y) &
                                (for e being Integer st
                                  0 <= e & e < j1 + 1
                                 holds ex x being Integer st
                                  x = a3.e & 0 <= x & x <= v) &
                                (for f being Integer st
                                  0 <= f & f < v
                                 holds
                                  card {q where q is Integer :
                                    0 <= q & q < j1 + 1 &
                                    a3.q = f} =
                                  card {q where q is Integer :
                                    0 <= q & q < alen &
                                    a.q = f}) &
                                card {q where q is Integer :
                                  0 <= q & q < j1 + 1 &
                                  a3.q = v} =
                                    i + 1 - 1) &
                              (j1 - (o4 + 1) + 1 =
                                  card {q where q is Integer :
                                    0 <= q & q < alen &
                                    (ex x being Integer st x = a.q & x < v)} &
                                (for i1,i2 being Integer st
                                  0 <= i1 & i1 <= i2 & i2 < j1
                                 holds ex x,y being Integer st
                           x = a2.i1 & y = a2.i2 & x <= y) &
                                (for e being Integer st
                                  0 <= e & e < j1
                                 holds
                                  ex x being Integer st
                                    x = a2.e & 0 <= x & x <= v) &
                                (for f being Integer st
                                  0 <= f & f < v
                                 holds
                                  card {q where q is Integer :
                                    0 <= q & q < j1 &
                                    a2.q = f} =
                                  card {q where q is Integer :
                                    0 <= q & q < alen &
                                    a.q = f}) &
                                card {q where q is Integer :
                                  0 <= q & q < j1 &
                                  a2.q = v} = o4 + 1 - 1
                               implies
                                j1 =
                                  card {q where q is Integer :
                                    0 <= q & q < alen &
                                    (ex x being Integer st
                                      x = a.q & x < v + 1)} &
                                (for i1,i2 being Integer st
                                  0 <= i1 & i1 <= i2 & i2 < j1
                                 holds ex x,y being Integer st
                           x = a2.i1 & y = a2.i2 & x <= y) &
                                (for e being Integer st
                                  0 <= e & e < j1
                                 holds
                                  ex x being Integer st
                                    x = a2.e & 0 <= x & x < v + 1) &
                                (for f being Integer st
                                  0 <= f & f < v + 1
                                 holds
                                  card {q where q is Integer :
                                    0 <= q & q < j1 &
                                    a2.q = f} =
                                  card {q where q is Integer :
                                    0 <= q & q < alen &
                                    a.q = f}))) &
                          (o4 + 1 < 1 implies
                            j =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                (ex x being Integer st x = a.q & x < v + 1)} &
                            (for i1,i2 being Integer st
                              0 <= i1 & i1 <= i2 & i2 < j
                             holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                            (for e being Integer st
                              0 <= e & e < j
                             holds ex x being Integer st
                           x = a1.e & 0 <= x & x < v + 1) &
                            (for f being Integer st
                              0 <= f & f < v + 1
                             holds
                              card {q where q is Integer :
                                0 <= q & q < j & a1.q = f} =
                              card {q where q is Integer :
                                0 <= q & q < alen & a.q = f})))) &
                      (j =
                          card {q where q is Integer :
                            0 <= q & q < alen &
                            (ex x being Integer st x = a.q & x < o3 + 1)} &
                        (for i1,i2 being Integer st
                          0 <= i1 & i1 <= i2 & i2 < j
                         holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                        (for e being Integer st 0 <= e & e < j
                          holds ex x being Integer st
                           x = a1.e & 0 <= x & x < o3 + 1) &
                        (for f being Integer st
                          0 <= f & f < o3 + 1
                         holds
                          card {q where q is Integer :
                            0 <= q & q < j & a1.q = f} =
                          card {q where q is Integer :
                            0 <= q & q < alen & a.q = f})
                       implies
                        (for i1,i2 being Integer st
                          0 <= i1 & i1 <= i2 & i2 < alen
                         holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                        (for z being Integer st 0 <= z & z < k
                         holds
                          card {q where q is Integer :
                            0 <= q & q < alen & a.q = z} =
                          card {q where q is Integer :
                            0 <= q & q < alen & a1.q = z})))) &
                  (o3 + 1 < 0 implies
                    (for i1,i2 being Integer st
                      0 <= i1 & i1 <= i2 & i2 < alen
                     holds ex x,y being Integer st
                           x = a.i1 & y = a.i2 & x <= y) &
                    (for z being Integer st 0 <= z & z < k
                     holds
                      card {q where q is Integer :
                        0 <= q & q < alen & a.q = z} =
                      card {q where q is Integer :
                        0 <= q & q < alen & a.q = z}))))) &
          (o2 + 1 < 0 implies
            (for o3 being Integer st o3 = k - 1 holds
              (0 <= o3 + 1 implies
                0 =
                  card {q where q is Integer :
                    0 <= q & q < alen &
                    (ex x being Integer st
                      x = a.q & x < 0)} &
                (for i1,i2 being Integer st
                  0 <= i1 & i1 <= i2 & i2 < 0
                 holds ex x,y being Integer st
                           x = a.i1 & y = a.i2 & x <= y) &
                (for e being Integer st 0 <= e & e < 0
                  holds ex x being Integer st
                           x = a.e & 0 <= x & x < 0) &
                (for f being Integer st 0 <= f & f < 0
                  holds
                    card {q where q is Integer :
                      0 <= q & q < 0 & a.q = f} =
                    card {q where q is Integer :
                      0 <= q & q < alen & a.q = f}) &
                (for j being Integer,
                     a1 being Function of INT,INT st
                  (for q being Integer st q < 0
                    holds a1.q = a1.0) &
                  (for q being Integer st alen <= q
                    holds a1.q = 0)
                 holds
                  (for v being Integer st
                    (0 <= v & v <= o3) &
                    j =
                      card {q where q is Integer :
                        0 <= q & q < alen &
                        (ex x being Integer st
                          x = a.q & x < v)} &
                    (for i1,i2 being Integer st
                      0 <= i1 & i1 <= i2 & i2 < j
                     holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                    (for e being Integer st 0 <= e & e < j
                      holds ex x being Integer st
                           x = a1.e & 0 <= x & x < v) &
                    (for f being Integer st 0 <= f & f < v
                      holds
                        card {q where q is Integer :
                          0 <= q & q < j & a1.q = f} =
                        card {q where q is Integer :
                          0 <= q & q < alen & a.q = f})
                   holds
                    (0 <= v & v < o1) &
                    (for o4 being Integer st o4 = c.v holds
                      (1 <= o4 + 1 implies
                        j - 1 + 1 =
                          card {q where q is Integer :
                            0 <= q & q < alen &
                            (ex x being Integer st
                              x = a.q & x < v)} &
                        (for i1,i2 being Integer st
                          0 <= i1 & i1 <= i2 & i2 < j
                         holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                        (for e being Integer st 0 <= e & e < j
                          holds ex x being Integer st
                           x = a1.e & 0 <= x & x <= v) &
                        (for f being Integer st 0 <= f & f < v
                          holds
                            card {q where q is Integer :
                              0 <= q & q < j & a1.q = f} =
                            card {q where q is Integer :
                              0 <= q & q < alen & a.q = f}) &
                        card {q where q is Integer :
                          0 <= q & q < j & a1.q = v} = 1 - 1) &
                      (for j1 being Integer,
                           a2 being Function of INT,INT st
                        (for q being Integer st q < 0
                          holds a2.q = a2.0) &
                        (for q being Integer st alen <= q
                          holds a2.q = 0)
                       holds
                        (for i being Integer st
                          (1 <= i & i <= o4) &
                          j1 - i + 1 =
                            card {q where q is Integer :
                              0 <= q & q < alen &
                              (ex x being Integer st
                                x = a.q & x < v)} &
                          (for i1,i2 being Integer st
                            0 <= i1 & i1 <= i2 & i2 < j1
                           holds ex x,y being Integer st
                           x = a2.i1 & y = a2.i2 & x <= y) &
                          (for e being Integer st
                            0 <= e & e < j1
                           holds ex x being Integer st
                           x = a2.e & 0 <= x & x <= v) &
                          (for f being Integer st 0 <= f & f < v
                           holds
                            card {q where q is Integer :
                              0 <= q & q < j1 & a2.q = f} =
                            card {q where q is Integer :
                              0 <= q & q < alen & a.q = f}) &
                          card {q where q is Integer :
                            0 <= q & q < j1 & a2.q = v} = i - 1
                         holds
                          (0 <= j1 & j1 < alen) &
                          (for a3 being Function of INT,INT st
                            (for q being Integer st q < 0
                              holds a3.q = a3.0) &
                            (for q being Integer st alen <= q
                              holds a3.q = 0) &
                            (for q being Integer st
                              0 <= q & q < alen
                             holds
                              (q = j1 implies a3.q = v) &
                              (q <> j1 implies a3.q = a2.q))
                           holds
                            j1 + 1 - (i + 1) + 1 =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                (ex x being Integer st x = a.q & x < v)} &
                            (for i1,i2 being Integer st
                              0 <= i1 & i1 <= i2 &
                              i2 < j1 + 1
                             holds ex x,y being Integer st
                              x = a3.i1 & y = a3.i2 & x <= y) &
                            (for e being Integer st
                              0 <= e & e < j1 + 1
                             holds ex x being Integer st
                              x = a3.e & 0 <= x & x <= v) &
                            (for f being Integer st
                              0 <= f & f < v
                             holds
                              card {q where q is Integer :
                                0 <= q & q < j1 + 1 &
                                a3.q = f} =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                a.q = f}) &
                            card {q where q is Integer :
                              0 <= q & q < j1 + 1 &
                              a3.q = v} = i + 1 - 1) &
                          (j1 - (o4 + 1) + 1 =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                (ex x being Integer st
                                  x = a.q & x < v)} &
                            (for i1,i2 being Integer st
                              0 <= i1 & i1 <= i2 & i2 < j1
                             holds ex x,y being Integer st
                           x = a2.i1 & y = a2.i2 & x <= y) &
                            (for e being Integer st
                              0 <= e & e < j1
                             holds ex x being Integer st
                           x = a2.e & 0 <= x & x <= v) &
                            (for f being Integer st
                              0 <= f & f < v
                             holds
                              card {q where q is Integer :
                                0 <= q & q < j1 & a2.q = f} =
                              card {q where q is Integer :
                                0 <= q & q < alen & a.q = f}) &
                            card {q where q is Integer :
                              0 <= q & q < j1 & a2.q = v} =
                                o4 + 1 - 1
                           implies
                            j1 =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                (ex x being Integer st x = a.q & x < v + 1)} &
                            (for i1,i2 being Integer st
                              0 <= i1 & i1 <= i2 & i2 < j1
                             holds ex x,y being Integer st
                           x = a2.i1 & y = a2.i2 & x <= y) &
                            (for e being Integer st
                              0 <= e & e < j1
                             holds ex x being Integer st
                           x = a2.e & 0 <= x & x < v + 1) &
                            (for f being Integer st
                              0 <= f & f < v + 1
                             holds
                              card {q where q is Integer :
                                0 <= q & q < j1 & a2.q = f} =
                              card {q where q is Integer :
                                0 <= q & q < alen &
                                a.q = f}))) &
                      (o4 + 1 < 1 implies
                        j =
                          card {q where q is Integer :
                            0 <= q & q < alen &
                            (ex x being Integer st
                              x = a.q & x < v + 1)} &
                        (for i1,i2 being Integer st
                          0 <= i1 & i1 <= i2 & i2 < j
                         holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                        (for e being Integer st 0 <= e & e < j
                          holds ex x being Integer st
                           x = a1.e & 0 <= x & x < v + 1) &
                        (for f being Integer st
                          0 <= f & f < v + 1
                         holds
                          card {q where q is Integer :
                            0 <= q & q < j & a1.q = f} =
                          card {q where q is Integer :
                            0 <= q & q < alen & a.q = f})))) &
                  (j =
                      card {q where q is Integer :
                        0 <= q & q < alen &
                        (ex x being Integer st
                          x = a.q & x < o3 + 1)} &
                    (for i1,i2 being Integer st
                      0 <= i1 & i1 <= i2 & i2 < j
                     holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                    (for e being Integer st 0 <= e & e < j
                      holds ex x being Integer st
                           x = a1.e & 0 <= x & x < o3 + 1) &
                    (for f being Integer st
                      0 <= f & f < o3 + 1
                     holds
                      card {q where q is Integer :
                        0 <= q & q < j & a1.q = f} =
                      card {q where q is Integer :
                        0 <= q & q < alen & a.q = f})
                   implies
                    (for i1,i2 being Integer st
                      0 <= i1 & i1 <= i2 & i2 < alen
                     holds ex x,y being Integer st
                           x = a1.i1 & y = a1.i2 & x <= y) &
                    (for z being Integer st 0 <= z & z < k
                     holds
                      card {q where q is Integer :
                        0 <= q & q < alen & a.q = z} =
                      card {q where q is Integer :
                        0 <= q & q < alen & a1.q = z})))) &
              (o3 + 1 < 0 implies
                (for i1,i2 being Integer st
                  0 <= i1 & i1 <= i2 & i2 < alen
                 holds ex x,y being Integer st
                           x = a.i1 & y = a.i2 & x <= y) &
                (for z being Integer st 0 <= z & z < k
                 holds
                  card {q where q is Integer :
                    0 <= q & q < alen & a.q = z} =
                  card {q where q is Integer :
                    0 <= q & q < alen & a.q = z}))))))))
proof
end;
::$P+
