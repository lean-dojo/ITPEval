:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sf_HoareLogic_factorialqtvc: the factorial-loop verification
:: condition uses an arbitrary integer-valued factorial function satisfying
:: the zero and positive recurrence laws to establish the loop invariant.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for fact being Function of INT,INT,
      x being Integer
  st
    fact.0 = 1 &
    (for n being Integer st 0 < n holds
      ex fn,fn1 being Integer st
        fn = fact.n &
        fn1 = fact.(n - 1) &
        fn = n * fn1) &
    0 <= x
  holds
    for fx being Integer st fx = fact.x holds
      0 <= x &
      1 * fx = fx &
      (for z,y,fz being Integer st
        fz = fact.z &
        0 <= z &
        y * fz = fx
       holds
        (z <> 0 implies
          for fz1 being Integer st fz1 = fact.(z - 1) holds
            (0 <= z & z - 1 < z) &
            0 <= z - 1 &
            y * z * fz1 = fx) &
        (z = 0 implies
          y = fx))
proof
end;
::$P+
