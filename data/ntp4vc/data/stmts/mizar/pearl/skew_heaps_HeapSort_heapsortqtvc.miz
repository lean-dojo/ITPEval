:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/skew_heaps_HeapSort_heapsortqtvc: the skew-heap heapsort
:: verification condition preserves heap and multiplicity invariants while
:: producing a sorted permutation of the input array. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL4, FINSEQ_1, FINSEQ_2, FINSET_1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      defaultElt being Element of E,
      Leq being Relation of E,E,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size being Function of Tree,INT,
      Occ being Function of [:E,Tree:],INT,
      Mem,LeRoot being Subset of [:E,Tree:],
      Heaps being Subset of Tree,
      Minimum being Function of Tree,E,
      nthElem being Function of [:E*,INT:],E,
      NthMap being Function of E*,Funcs(INT,E),
      setList being Function of [:[:E*,INT:],E:],E*,
      MapOcc being Function of
        [:E,[:E*,[:INT,INT:]:]:],INT,
      SortedSub being Subset of [:E*,[:INT,INT:]:],
      Sorted being Subset of E*,
      Perm being Relation of E*,E*,
      SortPhase being Subset of [:E*,Tree:],
      a being FinSequence of E
  st
    (for x being Element of E holds [x,x] in Leq) &
    (for x,y,z being Element of E st
       [x,y] in Leq & [y,z] in Leq
     holds
       [x,z] in Leq) &
    (for x,y being Element of E holds
       [x,y] in Leq or [y,x] in Leq) &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       node.[l,[x,r]] <> emptyT) &
    (for t being Element of Tree holds
       t = emptyT or
       ex l,r being Element of Tree,
          x being Element of E st
         t = node.[l,[x,r]]) &
    (for l,l1,r,r1 being Element of Tree,
         x,x1 being Element of E st
       node.[l,[x,r]] = node.[l1,[x1,r1]]
     holds
       l = l1 & x = x1 & r = r1) &
    Size.emptyT = 0 &
    (for t being Element of Tree holds 0 <= Size.t) &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       Size.(node.[l,[x,r]]) = 1 + Size.l + Size.r) &
    (for x being Element of E holds
       Occ.[x,emptyT] = 0) &
    (for x,y being Element of E,
         l,r being Element of Tree
     holds
       ex whole,leftOcc,rightOcc being Integer st
         whole = Occ.[x,node.[l,[y,r]]] &
         leftOcc = Occ.[x,l] &
         rightOcc = Occ.[x,r] &
         (x = y implies whole = 1 + leftOcc + rightOcc) &
         (x <> y implies whole = leftOcc + rightOcc)) &
    (for x being Element of E,
         t being Element of Tree
     holds
       ([x,t] in Mem iff
         ex n being Nat st Occ.[x,t] = n + 1)) &
    (for x being Element of E holds
       [x,emptyT] in LeRoot) &
    (for x,y being Element of E,
         l,r being Element of Tree
     holds
       ([x,node.[l,[y,r]]] in LeRoot iff [x,y] in Leq)) &
    emptyT in Heaps &
    (for x being Element of E,
         l,r being Element of Tree
     holds
       (node.[l,[x,r]] in Heaps iff
         [x,l] in LeRoot & l in Heaps &
         [x,r] in LeRoot & r in Heaps)) &
    (for x being Element of E,
         l,r being Element of Tree
     holds
       Minimum.(node.[l,[x,r]]) = x) &
    (for s being FinSequence of E,
         i being Integer
     holds
       (len s = 0 implies nthElem.[s,i] = defaultElt) &
       (i < 0 implies nthElem.[s,i] = defaultElt) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = defaultElt)) &
    (for s being FinSequence of E,
         i being Integer
     holds
       (NthMap.s).i = nthElem.[s,i]) &
    (for s being FinSequence of E,
         i being Integer,
         x being Element of E st
       0 <= i & i < len s
     holds
       len (setList.[[s,i],x]) = len s &
       (for q being Integer holds
         (q = i implies nthElem.[setList.[[s,i],x],q] = x) &
         (q <> i implies
            nthElem.[setList.[[s,i],x],q] = nthElem.[s,q]))) &
    (for x being Element of E,
         s being FinSequence of E,
         l,u being Integer
     holds
       MapOcc.[x,[s,[l,u]]] =
         card {q where q is Integer :
           l <= q & q < u & nthElem.[s,q] = x}) &
    (for s being FinSequence of E,
         l,u being Integer
     holds
       ([s,[l,u]] in SortedSub iff
         for i1,i2 being Integer st
           l <= i1 & i1 < i2 & i2 < u
         holds
           [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s being FinSequence of E holds
       (s in Sorted iff
         for i1,i2 being Integer st
           0 <= i1 & i1 < i2 & i2 < len s
         holds
           [nthElem.[s,i1],nthElem.[s,i2]] in Leq)) &
    (for s,s1 being FinSequence of E holds
       ([s,s1] in Perm iff
         len s = len s1 &
         (for x being Element of E holds
           MapOcc.[x,[s,[0,len s]]] =
           MapOcc.[x,[s1,[0,len s1]]]))) &
    (for s being FinSequence of E,
         t being Element of Tree
     holds
       ([s,t] in SortPhase iff
         (0 <= (len s - 1) + 1 implies
           ([s,[0,0]] in SortedSub &
            (t in Heaps & Size.t = len s - 0) &
            (for j being Integer st 0 <= j & j < 0
             holds
               for x being Element of E st [x,t] in Mem
               holds
                 [nthElem.[s,j],x] in Leq) &
            (for x being Element of E holds
               ex prefixOcc,heapOcc,totalOcc being Integer st
                 prefixOcc = MapOcc.[x,[s,[0,0]]] &
                 heapOcc = Occ.[x,t] &
                 totalOcc = MapOcc.[x,[s,[0,len s]]] &
                 prefixOcc + heapOcc = totalOcc)) &
           (for t1 being Element of Tree,
                s1 being FinSequence of E st
              len s1 = len s
            holds
              for i being Integer st
                (0 <= i & i <= len s - 1) &
                [s1,[0,i]] in SortedSub &
                (t1 in Heaps & Size.t1 = len s - i) &
                (for j being Integer st 0 <= j & j < i
                 holds
                   for x being Element of E st [x,t1] in Mem
                   holds
                     [nthElem.[s1,j],x] in Leq) &
                (for x being Element of E holds
                   ex prefixOcc,heapOcc,totalOcc being Integer st
                     prefixOcc = MapOcc.[x,[s1,[0,i]]] &
                     heapOcc = Occ.[x,t1] &
                     totalOcc = MapOcc.[x,[s,[0,len s]]] &
                     prefixOcc + heapOcc = totalOcc)
              holds
                (t1 in Heaps & 0 < Size.t1) &
                ((0 <= i & i < len s1) &
                 (len (setList.[[s1,i],Minimum.t1]) = len s1
                  implies
                    (NthMap.(setList.[[s1,i],Minimum.t1]) =
                       (NthMap.s1)+*(i,Minimum.t1)
                     implies
                    (t1 in Heaps & 0 < Size.t1) &
                    (for t2 being Element of Tree st
                       t2 in Heaps &
                       (ex childOcc,parentOcc being Integer st
                          childOcc = Occ.[Minimum.t1,t2] &
                          parentOcc = Occ.[Minimum.t1,t1] &
                          childOcc = parentOcc - 1) &
                       (for x being Element of E st x <> Minimum.t1
                        holds
                          Occ.[x,t2] = Occ.[x,t1]) &
                       Size.t2 = Size.t1 - 1
                     holds
                       [setList.[[s1,i],Minimum.t1],
                         [0,i+1]] in SortedSub &
                       (t2 in Heaps &
                         Size.t2 = len s - (i+1)) &
                       (for j being Integer st 0 <= j & j < i+1
                        holds
                          for x being Element of E st [x,t2] in Mem
                          holds
                            [nthElem.[
                              setList.[[s1,i],Minimum.t1],j],x]
                              in Leq) &
                       (for x being Element of E holds
                          ex prefixOcc,heapOcc,totalOcc being Integer st
                            prefixOcc = MapOcc.[x,[
                              setList.[[s1,i],Minimum.t1],
                              [0,i+1]]] &
                            heapOcc = Occ.[x,t2] &
                            totalOcc =
                              MapOcc.[x,[s,[0,len s]]] &
                            prefixOcc + heapOcc = totalOcc)))) &
                (([s1,[0,(len s - 1)+1]] in SortedSub &
                  (t1 in Heaps &
                    Size.t1 = len s - ((len s - 1)+1)) &
                  (for j being Integer st
                     0 <= j & j < (len s - 1)+1
                   holds
                     for x being Element of E st [x,t1] in Mem
                     holds
                       [nthElem.[s1,j],x] in Leq) &
                  (for x being Element of E holds
                     ex prefixOcc,heapOcc,totalOcc being Integer st
                       prefixOcc =
                         MapOcc.[x,[s1,[0,(len s - 1)+1]]] &
                       heapOcc = Occ.[x,t1] &
                       totalOcc = MapOcc.[x,[s,[0,len s]]] &
                       prefixOcc + heapOcc = totalOcc))
                 implies
                   s1 in Sorted & [s,s1] in Perm)))) &
         ((len s - 1) + 1 < 0 implies
           s in Sorted & [s,s] in Perm)))
  holds
    (0 <= (len a - 1) + 1 implies
      ((emptyT in Heaps & Size.emptyT = 0) &
       (for x being Element of E holds
          ex prefixOcc,heapOcc,totalOcc being Integer st
            prefixOcc = MapOcc.[x,[a,[0,len a]]] &
            heapOcc = Occ.[x,emptyT] &
            totalOcc = MapOcc.[x,[a,[0,len a]]] &
            prefixOcc + heapOcc = totalOcc)) &
      (for t being Element of Tree st
        ((0 <= Size.t & Size.t <= len a - 1) &
         t in Heaps &
         (for x being Element of E holds
            ex suffixOcc,heapOcc,totalOcc being Integer st
              suffixOcc = MapOcc.[x,[a,[Size.t,len a]]] &
              heapOcc = Occ.[x,t] &
              totalOcc = MapOcc.[x,[a,[0,len a]]] &
              suffixOcc + heapOcc = totalOcc))
       holds
         (0 <= Size.t & Size.t < len a) &
         (t in Heaps &
          (for t1 being Element of Tree st
             t1 in Heaps &
             (ex nextOcc,currentOcc being Integer st
                nextOcc = Occ.[nthElem.[a,Size.t],t1] &
                currentOcc = Occ.[nthElem.[a,Size.t],t] &
                nextOcc = currentOcc + 1) &
             (for x being Element of E st
                x <> nthElem.[a,Size.t]
              holds
                Occ.[x,t1] = Occ.[x,t]) &
             Size.t1 = Size.t + 1
           holds
             (t1 in Heaps & Size.t1 = Size.t + 1) &
             (for x being Element of E holds
                ex suffixOcc,heapOcc,totalOcc being Integer st
                  suffixOcc =
                    MapOcc.[x,[a,[Size.t+1,len a]]] &
                  heapOcc = Occ.[x,t1] &
                  totalOcc = MapOcc.[x,[a,[0,len a]]] &
                  suffixOcc + heapOcc = totalOcc))) &
         (((t in Heaps & Size.t = (len a - 1)+1) &
           (for x being Element of E holds
              ex suffixOcc,heapOcc,totalOcc being Integer st
                suffixOcc =
                  MapOcc.[x,[a,[(len a - 1)+1,len a]]] &
                heapOcc = Occ.[x,t] &
                totalOcc = MapOcc.[x,[a,[0,len a]]] &
                suffixOcc + heapOcc = totalOcc))
          implies
            [a,t] in SortPhase))) &
    ((len a - 1) + 1 < 0 implies
      [a,emptyT] in SortPhase)
proof
end;
::$P+
