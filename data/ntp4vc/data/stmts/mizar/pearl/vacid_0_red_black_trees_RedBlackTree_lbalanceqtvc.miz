:: Statement-only formalization of NTP4VC corpus artifact pearl/vacid_0_red_black_trees_RedBlackTree_lbalanceqtvc: the left-balancing verification condition for integer-keyed red-black search trees, preserving the BST invariant, black height, and key/value membership. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, FUNCT_1, FUNCT_2, PARTFUN1,
      FINSEQ_1, FINSET_1, RELAT_1, TARSKI, ZFMISC_1, XTUPLE_0, TREES_1,
      TREES_2, TREES_3, TREES_4, DTCONSTR, BINTREE1, MARGREL1, XBOOLEAN,
      INT_1, CARD_1, ARYTM_1, ARYTM_3, XXREAL_0, XREAL_0, REAL_1, NAT_1,
      VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, MCART_1, ABSRED_0;
 notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, ORDINAL1,
      CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
      FINSET_1, TREES_1, TREES_2, TREES_3, TREES_4, DTCONSTR, BINTREE1,
      MARGREL1;
 constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1, INT_1,
      XXREAL_0, ZFMISC_1, MCART_1, NAT_1, FINSEQOP, DTCONSTR, BINTREE1,
      MARGREL1, XTUPLE_0;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, TREES_1, TREES_2, TREES_3,
      TREES_4, DTCONSTR, FINSET_1, BINTREE1, MARGREL1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

definition
  let T be DecoratedTree;
  pred T <== means
    for p being Node of T holds
      (p in Leaves dom T iff T.p = {}) &
      (not p in Leaves dom T implies
        ex c being Element of BOOLEAN, k,v being Integer st
          T.p = [c,[k,v]]);
end;

definition
  let T be DecoratedTree;
  let k,v be Integer;
  pred T =01=> k,v means
    ex p being Node of T, c being Element of BOOLEAN st
      not p in Leaves dom T & T.p = [c,[k,v]];
end;

definition
  let T be DecoratedTree;
  let x be Integer;
  pred T =*=> x means
    for k,v being Integer st T =01=> k,v holds k < x;
  pred T =+=> x means
    for k,v being Integer st T =01=> k,v holds x < k;
end;

definition
  let T be DecoratedTree;
  pred T <=01= means
    T <== &
    for p being Node of T, c being Element of BOOLEAN,
        k,v being Integer st
      not p in Leaves dom T & T.p = [c,[k,v]]
    holds
      (T|(p^<*0*>)) =*=> k & (T|(p^<*1*>)) =+=> k;
end;

definition
  let T be DecoratedTree;
  pred T <=*= means
    T <== &
    ({} in Leaves dom T or
      ex k,v being Integer st T.{} = [TRUE,[k,v]]);
end;

definition
  let T be finite binary DecoratedTree;
  let n be Integer;
  pred T <=+= n means
    T <== &
    (for p being Node of T, k,v being Integer st
      not p in Leaves dom T & T.p = [FALSE,[k,v]]
     holds
      (T|(p^<*0*>)) <=*= & (T|(p^<*1*>)) <=*=) &
    for p being Node of T st p in Leaves dom T holds
      n = card {q where q is Node of T:
        q is_a_prefix_of p &
        not q in Leaves dom T &
        ex k,v being Integer st T.q = [TRUE,[k,v]]};
end;

definition
  let T be finite binary DecoratedTree;
  let n be Integer;
  pred T <=01=> n means
    T <== &
    (for p being Node of T, k,v being Integer st
      p <> {} & not p in Leaves dom T & T.p = [FALSE,[k,v]]
     holds
      (T|(p^<*0*>)) <=*= & (T|(p^<*1*>)) <=*=) &
    for p being Node of T st p in Leaves dom T holds
      n = card {q where q is Node of T:
        q is_a_prefix_of p &
        not q in Leaves dom T &
        ex k,v being Integer st T.q = [TRUE,[k,v]]};
end;

definition
  let L be finite binary DecoratedTree;
  pred L <=*=> means
    ex a,b,c being finite binary DecoratedTree,
       kx,vx,ky,vy being Integer st
      a <== & b <== & c <== &
      L = [FALSE,[ky,vy]]-tree
        ([FALSE,[kx,vx]]-tree(a,b),c);
  pred L <=+=> means
    ex a,b,c being finite binary DecoratedTree,
       kx,vx,ky,vy being Integer st
      a <== & b <== & c <== &
      L = [FALSE,[kx,vx]]-tree
        (a,[FALSE,[ky,vy]]-tree(b,c));
end;

definition
  let L,R,Result be finite binary DecoratedTree;
  let k,v be Integer;
  pred L,k,v,R <<>> Result means
    (ex a,b,c being finite binary DecoratedTree,
        kx,vx,ky,vy being Integer st
      a <== & b <== & c <== &
      L = [FALSE,[ky,vy]]-tree
        ([FALSE,[kx,vx]]-tree(a,b),c) &
      Result = [FALSE,[ky,vy]]-tree
        ([TRUE,[kx,vx]]-tree(a,b),
         [TRUE,[k,v]]-tree(c,R))) or
    (not L <=*=> &
      ex a,b,c being finite binary DecoratedTree,
        kx,vx,ky,vy being Integer st
      a <== & b <== & c <== &
      L = [FALSE,[kx,vx]]-tree
        (a,[FALSE,[ky,vy]]-tree(b,c)) &
      Result = [FALSE,[ky,vy]]-tree
        ([TRUE,[kx,vx]]-tree(a,b),
         [TRUE,[k,v]]-tree(c,R))) or
    (not L <=*=> & not L <=+=> &
      Result = [TRUE,[k,v]]-tree(L,R));
end;

::$P-
theorem
  for k,v being Integer,
      L,R being finite binary DecoratedTree st
    L <== & R <== &
    L =*=> k & R =+=> k &
    L <=01= & R <=01=
  holds
    1 = 1 &
    (for Result being finite binary DecoratedTree st
      Result <== & L,k,v,R <<>> Result
     holds
      Result <=01= &
      (for n being Integer st
        L <=01=> n & R <=+= n
       holds Result <=+= n+1) &
      (for k1,v1 being Integer holds
        (Result =01=> k1,v1 iff
          (k1 = k & v1 = v) or
          (k1 <> k &
            (L =01=> k1,v1 or R =01=> k1,v1)))))
proof
end;
::$P+
