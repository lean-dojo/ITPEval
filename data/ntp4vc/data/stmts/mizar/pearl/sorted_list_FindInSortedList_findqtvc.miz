:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/sorted_list_FindInSortedList_findqtvc: searching a sorted integer
:: list preserves sortedness of the recursive tail and returns true exactly
:: when the searched integer occurs in the list. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    XXREAL_0, FINSEQ_1, FINSEQ_2, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, FINSEQ_1,
    FINSEQ_2, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for l being FinSequence of INT,
      x being Integer st
    (for i,j being Nat st
       i in dom l & j in dom l & i < j
     holds l/.i <= l/.j)
  holds
    ((l = <*>INT) or
     (ex y being Integer,
         r being FinSequence of INT st
       l = <*y*> ^ r &
       (x <> y implies
         (y < x implies
           r = r &
           (for i,j being Nat st
              i in dom r & j in dom r & i < j
            holds r/.i <= r/.j))))) &
    (for result being Element of BOOLEAN st
       ((l = <*>INT & result = FALSE) or
        (ex y being Integer,
            r being FinSequence of INT st
          l = <*y*> ^ r &
          ((x = y & result = TRUE) or
           (x <> y & y < x &
            ((x in rng r & result = TRUE) or
             (not x in rng r & result = FALSE))) or
           (x <> y & not y < x & result = FALSE))))
     holds
       (result = TRUE iff x in rng l))
proof
end;
::$P+
