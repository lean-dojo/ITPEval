:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2021_shearsort_ShearSort_sort_columnqtvc: the ShearSort
:: sort-column verification condition copies a selected matrix column into
:: a list, sorts a permutation, writes it back in ascending order, and
:: preserves all other columns and the column multiplicities. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1, XBOOLEAN, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, PBOOLE,
    PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1, MARGREL1, XBOOLEAN;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0,
    FINSEQ_1, FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, FINSET_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FINSET_1, MARGREL1,
    XBOOLEAN, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nthElem being Function of [:INT*,INT:],INT,
      SeqSet being Function of [:INT*,[:INT,INT:]:],INT*,
      ZeroSeq,CopiedPrefix,SetFunctional,SeqSorted,SeqPerm,
      SameExceptColumn,CellUpdate,ColumnPost being set,
      j,r,c being Integer,
      e being Function of [:INT,INT:],INT
  st
    0 <= r & 0 <= c & 0 <= j & j < c &

    (for s being FinSequence of INT, i being Integer holds
       (len s = 0 implies nthElem.[s,i] = 0) &
       (0 < len s & i < 0 implies nthElem.[s,i] = s.1) &
       (0 <= i & i < len s implies
          nthElem.[s,i] = s.(i+1)) &
       (len s <= i implies nthElem.[s,i] = 0)) &

    (for s being FinSequence of INT, i,v being Integer holds
       len (SeqSet.[s,[i,v]]) = len s &
       (for q being Integer st 0 <= q & q < len s holds
          (q = max(i,0) implies
             nthElem.[SeqSet.[s,[i,v]],q] = v) &
          (q <> max(i,0) implies
             nthElem.[SeqSet.[s,[i,v]],q] =
               nthElem.[s,q]))) &

    (for s being FinSequence of INT, n being Integer holds
       ([s,n] in ZeroSeq iff
         len s = n &
         for i being Integer st 0 <= i & i < n
         holds nthElem.[s,i] = 0)) &

    (for s being FinSequence of INT,
         f being Function of [:INT,INT:],INT,
         col,upto being Integer
     holds
       ([s,[f,[col,upto]]] in CopiedPrefix iff
         for k being Integer st 0 <= k & k < upto
         holds nthElem.[s,k] = f.[k,col])) &

    (for t,s being FinSequence of INT, i,v being Integer holds
       ([t,[s,[i,v]]] in SetFunctional iff
         for k being Integer holds
           (k = i implies nthElem.[t,k] = v) &
           (k <> i implies
              nthElem.[t,k] = nthElem.[s,k]))) &

    (for s being FinSequence of INT holds
       (s in SeqSorted iff
         for i,k being Integer st
           0 <= i & i <= k & k < len s
         holds nthElem.[s,i] <= nthElem.[s,k])) &

    (for s,t being FinSequence of INT holds
       ([s,t] in SeqPerm iff
         for v being Integer holds
           card {q where q is Integer :
             0 <= q & q < len s & nthElem.[s,q] = v} =
           card {q where q is Integer :
             0 <= q & q < len s & nthElem.[t,q] = v})) &

    (for f2,f0 being Function of [:INT,INT:],INT,
         nr,nc,col being Integer
     holds
       ([f2,[f0,[nr,[nc,col]]]] in SameExceptColumn iff
         for k,l being Integer st
           0 <= k & k < nr & 0 <= l & l < nc & l <> col
         holds f2.[k,l] = f0.[k,l])) &

    (for f2,f1 being Function of [:INT,INT:],INT,
         row,col,v being Integer
     holds
       ([f2,[f1,[row,[col,v]]]] in CellUpdate iff
         for k,l being Integer holds
           (k = row & l = col implies f2.[k,l] = v) &
           (k <> row or l <> col implies
              f2.[k,l] = f1.[k,l]))) &

    (for f2,f0 being Function of [:INT,INT:],INT,
         nr,nc,col being Integer
     holds
       ([f2,[f0,[nr,[nc,col]]]] in ColumnPost iff
         (for i,k being Integer st
            0 <= i & i < nr & 0 <= k & k < nc & k <> col
          holds f2.[i,k] = f0.[i,k]) &
         (for i,k being Integer st
            0 <= i & i <= k & k < nr
          holds f2.[i,col] <= f2.[k,col]) &
         (for v being Integer holds
            card {i where i is Integer :
              0 <= i & i < nr & f2.[i,col] = v} =
            card {i where i is Integer :
              0 <= i & i < nr & f0.[i,col] = v})))
  holds
    0 <= r &
    (for a being FinSequence of INT st [a,r] in ZeroSeq holds
      (0 <= (r-1)+1 implies
        [a,[e,[j,0]]] in CopiedPrefix &
        (for a1 being FinSequence of INT st len a1 = len a
         holds
           (for i being Integer st
              (0 <= i & i <= r-1) &
              [a1,[e,[j,i]]] in CopiedPrefix
            holds
              (0 <= i & i < r) &
              (0 <= j & j < c) &
              (0 <= i & i < len a1) &
              (len (SeqSet.[a1,[i,e.[i,j]]]) = len a1
               implies
                ([SeqSet.[a1,[i,e.[i,j]]],
                   [a1,[i,e.[i,j]]]] in SetFunctional
                 implies
                   [SeqSet.[a1,[i,e.[i,j]]],
                     [e,[j,i+1]]] in CopiedPrefix))) &

           ([a1,[e,[j,(r-1)+1]]] in CopiedPrefix implies
             for a2 being FinSequence of INT st
               len a2 = len a1
             holds
               (a2 in SeqSorted & [a2,a1] in SeqPerm) implies
                 ((0 <= (r-1)+1 implies
                    [a2,[e,[j,0]]] in CopiedPrefix &
                    (for e1 being Function of [:INT,INT:],INT
                     holds
                       (for i being Integer st
                          (0 <= i & i <= r-1) &
                          [a2,[e1,[j,i]]] in CopiedPrefix &
                          [e1,[e,[r,[c,j]]]]
                            in SameExceptColumn
                        holds
                          (0 <= i & i < len a2) &
                          (0 <= i & i < r) &
                          (0 <= j & j < c) &
                          (for e2 being
                               Function of [:INT,INT:],INT st
                             [e2,[e1,[i,[j,nthElem.[a2,i]]]]]
                               in CellUpdate
                           holds
                             [a2,[e2,[j,i+1]]]
                               in CopiedPrefix &
                             [e2,[e,[r,[c,j]]]]
                               in SameExceptColumn)) &
                       (([a2,[e1,[j,(r-1)+1]]]
                            in CopiedPrefix &
                         [e1,[e,[r,[c,j]]]]
                            in SameExceptColumn)
                        implies
                          [e1,[e,[r,[c,j]]]]
                            in ColumnPost))) &
                  ((r-1)+1 < 0 implies
                    [e,[e,[r,[c,j]]]] in ColumnPost))))) &

      ((r-1)+1 < 0 implies
        for a1 being FinSequence of INT st len a1 = len a
        holds
          (a1 in SeqSorted & [a1,a] in SeqPerm) implies
            ((0 <= (r-1)+1 implies
               [a1,[e,[j,0]]] in CopiedPrefix &
               (for e1 being Function of [:INT,INT:],INT
                holds
                  (for i being Integer st
                     (0 <= i & i <= r-1) &
                     [a1,[e1,[j,i]]] in CopiedPrefix &
                     [e1,[e,[r,[c,j]]]]
                       in SameExceptColumn
                   holds
                     (0 <= i & i < len a1) &
                     (0 <= i & i < r) &
                     (0 <= j & j < c) &
                     (for e2 being
                          Function of [:INT,INT:],INT st
                        [e2,[e1,[i,[j,nthElem.[a1,i]]]]]
                          in CellUpdate
                      holds
                        [a1,[e2,[j,i+1]]] in CopiedPrefix &
                        [e2,[e,[r,[c,j]]]]
                          in SameExceptColumn)) &
                  (([a1,[e1,[j,(r-1)+1]]]
                       in CopiedPrefix &
                    [e1,[e,[r,[c,j]]]]
                       in SameExceptColumn)
                   implies
                     [e1,[e,[r,[c,j]]]] in ColumnPost))) &
             ((r-1)+1 < 0 implies
               [e,[e,[r,[c,j]]]] in ColumnPost))))
proof
end;
::$P+
