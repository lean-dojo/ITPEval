:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/binary_sqrt_BinarySqrt_sqrtqtvc: the binary-square-root verification
:: condition preserves an integer doubling invariant and the enclosing
:: real square bounds for the computed approximation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, MARGREL1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, XXREAL_0,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for r,eps being Real,
      n being Integer,
      o1 being Element of BOOLEAN st
    0 <= r &
    0 < eps &
    1 <= n &
    ((r < (n qua Real) * eps &
        ((1 < (n qua Real) * eps & o1 = TRUE) or
         (not 1 < (n qua Real) * eps & o1 = FALSE))) or
     (not r < (n qua Real) * eps & o1 = FALSE))
  holds
    (o1 <> TRUE implies
      ex o2 being Integer st
        o2 = 2 * n &
        (0 <= [/ max(r,1) / eps \] - n &
         [/ max(r,1) / eps \] - o2 <
           [/ max(r,1) / eps \] - n) &
        0 <= r &
        (0 < eps & 1 <= o2) &
        2 * ((n qua Real) * eps) = (o2 qua Real) * eps) &
    (for result being Real holds
      (((o1 = TRUE & result = 0) or
        (o1 <> TRUE &
          ex o2,r1 being Real st
            o2 = 2 * ((n qua Real) * eps) &
            (r1 * r1 <= r &
             r < (r1 + o2) * (r1 + o2)) &
            ((((r1 + (n qua Real) * eps) *
                 (r1 + (n qua Real) * eps) <= r) &
                result = r1 + (n qua Real) * eps) or
             (not (r1 + (n qua Real) * eps) *
                    (r1 + (n qua Real) * eps) <= r &
                result = r1))))
       implies
        result * result <= r &
        r < (result + (n qua Real) * eps) *
              (result + (n qua Real) * eps)))
proof
end;
::$P+
