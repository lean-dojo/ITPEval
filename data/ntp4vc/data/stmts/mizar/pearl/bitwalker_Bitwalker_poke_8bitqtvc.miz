:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bitwalker_Bitwalker_poke_8bitqtvc: the 8-bit poke
:: verification condition sets or clears one selected bit, preserves every
:: other bit, and relates 32-bit word indices to integer bit positions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1,
    NAT_D, NEWTON, XXREAL_0, MARGREL1, XBOOLEAN;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1, NAT_D, NEWTON,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for left1,byte being Nat,
      flag being Element of BOOLEAN,
      Bit being Function of [:NAT,INT:],BOOLEAN st
    left1 < (2 |^ 32) &
    byte < (2 |^ 8) &
    (for w being Nat, p being Integer holds
      (Bit.[w,p] = TRUE iff
        ex k being Nat st
          ((p < 0 & k = 0) or (0 <= p & k = p)) &
          (w div (2 |^ k)) mod 2 = 1)) &
    left1 < 8
  holds
    (for o1 being Nat st o1 = left1 mod (2 |^ 8) holds
      (o1 <= 7 or 7 >= o1) &
      (for o2 being Nat st
         o2 = (7 + (2 |^ 8) - o1) mod (2 |^ 8)
       holds
        (o2 = 7 - o1 implies
          for mask being Nat st
            mask = (2 |^ o2) mod (2 |^ 8)
          holds
            (flag = TRUE or flag = FALSE) &
            (for result being Nat st result < (2 |^ 8) holds
              (((flag = TRUE &
                  (for j being Integer st 0 <= j & j < 8 holds
                    Bit.[result,j] =
                      Bit.[byte,j] 'or' Bit.[mask,j])) or
                (flag = FALSE &
                  (for j being Integer st 0 <= j & j < 8 holds
                    Bit.[result,j] =
                      Bit.[byte,j] '&' 'not' Bit.[mask,j])))
               implies
                (for i being Nat st
                   i < (2 |^ 32) & i < 8 &
                   not i =
                     (7 + (2 |^ 32) - left1) mod (2 |^ 32)
                 holds
                   Bit.[result,i] = Bit.[byte,i]) &
                Bit.[result,o2] = flag))))) &
    (for result being Nat st result < (2 |^ 8) holds
      (((for i being Nat st
           i < (2 |^ 32) & i < 8 &
           not i =
             (7 + (2 |^ 32) - left1) mod (2 |^ 32)
         holds
           Bit.[result,i] = Bit.[byte,i]) &
        Bit.[result,
          (7 + (2 |^ 8) - (left1 mod (2 |^ 8))) mod (2 |^ 8)]
          = flag)
       implies
        (for i being Integer st
           0 <= i & i < 8 & not i = 7 - left1
         holds
           Bit.[result,i] = Bit.[byte,i]) &
        Bit.[result,7 - left1] = flag))
proof
end;
::$P+
