:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/bitcount_BitCounting32_countqtvc: the 32-bit parallel
:: population-count verification condition relates the successive masked
:: shift-and-add stages to the number of set bits. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1,
    FUNCT_1, FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON,
    RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2,
    NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS,
    RVSUM_1, FINSEQOP, FUNCT_2;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1, MEMBERED, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n < 2 |^ 32 holds
    ex masked1,x1,low2,high2,x2,sum4,x3,x4,x5,result
      being Nat st
      masked1 < 2 |^ 32 &
      (for i being Element of NAT st i < 32 holds
        ((masked1 div (2 |^ i)) mod 2 = 1 iff
          (((n div 2) div (2 |^ i)) mod 2 = 1 &
           ((1431655765 div (2 |^ i)) mod 2 = 1)))) &
      x1 = (n + (2 |^ 32) - masked1) mod (2 |^ 32) &

      low2 < 2 |^ 32 &
      (for i being Element of NAT st i < 32 holds
        ((low2 div (2 |^ i)) mod 2 = 1 iff
          ((x1 div (2 |^ i)) mod 2 = 1 &
           ((858993459 div (2 |^ i)) mod 2 = 1)))) &

      high2 < 2 |^ 32 &
      (for i being Element of NAT st i < 32 holds
        ((high2 div (2 |^ i)) mod 2 = 1 iff
          (((x1 div 4) div (2 |^ i)) mod 2 = 1 &
           ((858993459 div (2 |^ i)) mod 2 = 1)))) &

      x2 = (low2 + high2) mod (2 |^ 32) &
      sum4 = (x2 + x2 div 16) mod (2 |^ 32) &

      x3 < 2 |^ 32 &
      (for i being Element of NAT st i < 32 holds
        ((x3 div (2 |^ i)) mod 2 = 1 iff
          ((sum4 div (2 |^ i)) mod 2 = 1 &
           ((252645135 div (2 |^ i)) mod 2 = 1)))) &

      x4 = (x3 + x3 div 256) mod (2 |^ 32) &
      x5 = (x4 + x4 div 65536) mod (2 |^ 32) &
      result = x5 mod 64 &

      (result =
          card {i where i is Element of NAT :
            i < 32 & (n div (2 |^ i)) mod 2 = 1}
       implies
        result =
          card {i where i is Element of NAT :
            i < 32 & (n div (2 |^ i)) mod 2 = 1})
proof
end;
::$P+
