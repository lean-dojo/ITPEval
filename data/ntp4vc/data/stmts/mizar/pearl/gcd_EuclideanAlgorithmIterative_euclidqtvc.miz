:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/gcd_EuclideanAlgorithmIterative_euclidqtvc: the iterative Euclidean
:: algorithm verification condition preserves nonnegativity and the integer
:: greatest common divisor across a remainder step. This file contains no proof.

environ
  vocabularies NUMBERS, INT_1, INT_2, NAT_1, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, RELAT_1, ORDINAL1, CARD_1, XCMPLX_0,
    SUBSET_1;
  notations SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, NAT_1;
  constructors XXREAL_0, REAL_1, NAT_1, INT_1, INT_2, CARD_1;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for u0,v0 being Integer st
    0 <= u0 &
    0 <= v0
  holds
    0 <= u0 &
    0 <= v0 &
    (for v,u being Integer holds
      ((0 <= u &
        0 <= v) &
       u gcd v = u0 gcd v0)
      implies
        ((v <> 0 implies
            v <> 0 &
            (0 <= v & u mod v < v) &
            (0 <= v & 0 <= u mod v) &
            v gcd (u mod v) = u0 gcd v0) &
         (v = 0 implies
            u = u0 gcd v0)))
proof
end;
::$P+
