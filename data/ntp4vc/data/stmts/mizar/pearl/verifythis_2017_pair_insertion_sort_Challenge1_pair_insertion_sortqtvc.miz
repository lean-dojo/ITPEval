:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/verifythis_2017_pair_insertion_sort_Challenge1_pair_insertion_sortqtvc:
:: the pair-insertion-sort verification condition for nonnegative-length
:: integer arrays represented by total integer maps, including exact updates,
:: loop invariants, permutation preservation, variants, and final sortedness.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSET_1, XTUPLE_0, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, NAT_1, FINSET_1, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSET_1, FRAENKEL,
    XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Permut being Subset of
        [:INT,[:Funcs(INT,INT),Funcs(INT,INT):]:],
      SortedUpto,SortedClosed being Subset of
        [:INT,[:Funcs(INT,INT),INT:]:],
      FirstInv being Subset of
        [:INT,[:Funcs(INT,INT),
          [:INT,[:INT,[:INT,[:INT,Funcs(INT,INT):]:]:]:]:]:],
      SecondInv being Subset of
        [:INT,[:Funcs(INT,INT),
          [:INT,[:INT,[:INT,Funcs(INT,INT):]:]:]:]:],
      OuterNext being Subset of
        [:INT,[:Funcs(INT,INT),
          [:Funcs(INT,INT),[:INT,Funcs(INT,INT):]:]:]:],
      SecondStep,SecondPhase being Subset of
        [:INT,[:Funcs(INT,INT),
          [:Funcs(INT,INT),
            [:INT,[:INT,[:INT,Funcs(INT,INT):]:]:]:]:]:],
      FirstStep,FirstPhase being Subset of
        [:INT,[:Funcs(INT,INT),
          [:Funcs(INT,INT),
            [:INT,[:INT,[:INT,[:INT,Funcs(INT,INT):]:]:]:]:]:]:],
      PairCase being Subset of
        [:INT,[:Funcs(INT,INT),[:Funcs(INT,INT),INT:]:]:],
      SingleInv,SingleStep,SinglePhase being Subset of
        [:INT,[:Funcs(INT,INT),
          [:INT,[:INT,[:INT,Funcs(INT,INT):]:]:]:]:],
      SingleCase being Subset of
        [:INT,[:Funcs(INT,INT),[:Funcs(INT,INT),INT:]:]:]
  st
    (for n being Integer,
         s,t being Function of INT,INT holds
       ([n,[s,t]] in Permut iff
         0 <= n &
         (for z being Integer holds
            card {q where q is Integer :
              0 <= q & q < n & s.q = z} =
            card {q where q is Integer :
              0 <= q & q < n & t.q = z}))) &
    (for n,u being Integer,
         s being Function of INT,INT holds
       ([n,[s,u]] in SortedUpto iff
         0 <= n &
         (for k,l being Integer st
            0 <= k & k <= l & l < u
          holds
            ex sk,sl being Integer st
              sk = s.k & sl = s.l & sk <= sl))) &
    (for n,j being Integer,
         s being Function of INT,INT holds
       ([n,[s,j]] in SortedClosed iff
         0 <= n &
         (for k,l being Integer st
            0 <= k & k <= l & l <= j
          holds
            ex sk,sl being Integer st
              sk = s.k & sl = s.l & sk <= sl))) &
    (for n,i,x,y,j being Integer,
         original,current being Function of INT,INT holds
       ([n,[original,[i,[x,[y,[j,current]]]]]] in FirstInv iff
         0 <= n &
         (-1 <= j & j < i) &
         [n,[current,j]] in SortedClosed &
         (for k,l being Integer st 0 <= k & k <= j
          holds
            (j+2 < l & l < i+2) implies
              ex ck,cl being Integer st
                ck = current.k & cl = current.l & ck <= cl) &
         (for k,l being Integer st
            j+2 < k & k <= l & l < i+2
          holds
            ex ck,cl being Integer st
              ck = current.k & cl = current.l & ck <= cl) &
         (for l being Integer st j+2 < l & l < i+2
          holds
            ex cl being Integer st cl = current.l & x < cl) &
         [n,[original,
           (current+*(j+1,y))+*(j+2,x)]] in Permut)) &
    (for n,i,y,j being Integer,
         original,current being Function of INT,INT holds
       ([n,[original,[i,[y,[j,current]]]]] in SecondInv iff
         0 <= n &
         (-1 <= j & j < i) &
         [n,[current,j]] in SortedClosed &
         (for k,l being Integer st 0 <= k & k <= j
          holds
            (j+1 < l & l < i+2) implies
              ex ck,cl being Integer st
                ck = current.k & cl = current.l & ck <= cl) &
         (for k,l being Integer st
            j+1 < k & k <= l & l < i+2
          holds
            ex ck,cl being Integer st
              ck = current.k & cl = current.l & ck <= cl) &
         (for l being Integer st j+1 < l & l < i+2
          holds
            ex cl being Integer st cl = current.l & y <= cl) &
         [n,[original,current+*(j+1,y)]] in Permut)) &
    (for n,i being Integer,
         original,base,current being Function of INT,INT holds
       ([n,[original,[base,[i,current]]]] in OuterNext iff
         0 <= n &
         (0 <= n-i & n-(i+2) < n-i) &
         (0 <= i+2 & i+2 <= n) &
         [n,[current,i+2]] in SortedUpto &
         [n,[original,current]] in Permut)) &
    (for n,i,y,j being Integer,
         original,base,current being Function of INT,INT holds
       ([n,[original,[base,[i,[y,[j,current]]]]]] in SecondStep iff
         0 <= n &
         (0 <= j implies 0 <= j & j < n) &
         ((0 <= j &
             (ex cj being Integer st cj = current.j & y < cj))
           implies
           (0 <= j & j < n) &
           (0 <= j+1 & j+1 < n) &
           (n = n implies
             (((current+*(j+1,current.j)).(j+1) = current.j &
               (for r being Integer st r <> j+1
                holds
                  (current+*(j+1,current.j)).r = current.r))
              implies
                (0 <= j & j-1 < j) &
                [n,[original,
                  [i,[y,[j-1,
                    current+*(j+1,current.j)]]]]]
                  in SecondInv))) &
         (not (0 <= j &
             (ex cj being Integer st cj = current.j & y < cj))
           implies
           (0 <= j+1 & j+1 < n) &
           (n = n implies
             (((current+*(j+1,y)).(j+1) = y &
               (for r being Integer st r <> j+1
                holds (current+*(j+1,y)).r = current.r))
              implies
                [n,[original,
                  [base,[i,current+*(j+1,y)]]]]
                  in OuterNext))))) &
    (for n,i,y,j being Integer,
         original,base,current being Function of INT,INT holds
       ([n,[original,[base,[i,[y,[j,current]]]]]] in SecondPhase iff
         0 <= n &
         [n,[original,[i,[y,[j,current]]]]] in SecondInv &
         (for j1 being Integer,
              next being Function of INT,INT holds
            [n,[original,[i,[y,[j1,next]]]]] in SecondInv
            implies
              [n,[original,[base,[i,[y,[j1,next]]]]]]
                in SecondStep))) &
    (for n,i,x,y,j being Integer,
         original,base,current being Function of INT,INT holds
       ([n,[original,
          [base,[i,[x,[y,[j,current]]]]]]] in FirstStep iff
         0 <= n &
         (0 <= j implies 0 <= j & j < n) &
         ((0 <= j &
             (ex cj being Integer st cj = current.j & x < cj))
           implies
           (0 <= j & j < n) &
           (0 <= j+2 & j+2 < n) &
           (n = n implies
             (((current+*(j+2,current.j)).(j+2) = current.j &
               (for r being Integer st r <> j+2
                holds
                  (current+*(j+2,current.j)).r = current.r))
              implies
                (0 <= j & j-1 < j) &
                [n,[original,
                  [i,[x,[y,[j-1,
                    current+*(j+2,current.j)]]]]]]
                  in FirstInv))) &
         (not (0 <= j &
             (ex cj being Integer st cj = current.j & x < cj))
           implies
           (0 <= j+2 & j+2 < n) &
           (n = n implies
             (((current+*(j+2,x)).(j+2) = x &
               (for r being Integer st r <> j+2
                holds (current+*(j+2,x)).r = current.r))
              implies
                [n,[original,
                  [base,[i,[y,[j,current+*(j+2,x)]]]]]]
                  in SecondPhase))))) &
    (for n,i,x,y,j being Integer,
         original,base,current being Function of INT,INT holds
       ([n,[original,
          [base,[i,[x,[y,[j,current]]]]]]] in FirstPhase iff
         0 <= n &
         [n,[original,[i,[x,[y,[j,current]]]]]] in FirstInv &
         (for j1 being Integer,
              next being Function of INT,INT holds
            [n,[original,[i,[x,[y,[j1,next]]]]]] in FirstInv
            implies
              [n,[original,
                [base,[i,[x,[y,[j1,next]]]]]]]
                in FirstStep))) &
    (for n,i being Integer,
         original,base being Function of INT,INT holds
       ([n,[original,[base,i]]] in PairCase iff
         0 <= n &
         (0 <= i & i < n) &
         (0 <= i+1 & i+1 < n) &
         ((ex bi,bj being Integer st
             bi = base.i & bj = base.(i+1) & bi < bj)
           implies
           [n,[original,
             [base,[i,[base.(i+1),
               [base.i,[i-1,base]]]]]]]
             in FirstPhase) &
         (not (ex bi,bj being Integer st
             bi = base.i & bj = base.(i+1) & bi < bj)
           implies
           [n,[original,
             [base,[i,[base.i,
               [base.(i+1),[i-1,base]]]]]]]
             in FirstPhase))) &
    (for n,i,y,j being Integer,
         original,current being Function of INT,INT holds
       ([n,[original,[i,[y,[j,current]]]]] in SingleInv iff
         0 <= n &
         (-1 <= j & j < i) &
         [n,[current,j]] in SortedClosed &
         (for k,l being Integer st 0 <= k & k <= j
          holds
            (j+1 < l & l < n) implies
              ex ck,cl being Integer st
                ck = current.k & cl = current.l & ck <= cl) &
         (for k,l being Integer st
            j+1 < k & k <= l & l < n
          holds
            ex ck,cl being Integer st
              ck = current.k & cl = current.l & ck <= cl) &
         (for l being Integer st j+1 < l & l < n
          holds
            ex cl being Integer st cl = current.l & y < cl) &
         [n,[original,current+*(j+1,y)]] in Permut)) &
    (for n,i,y,j being Integer,
         original,current being Function of INT,INT holds
       ([n,[original,[i,[y,[j,current]]]]] in SingleStep iff
         0 <= n &
         (0 <= j implies 0 <= j & j < n) &
         ((0 <= j &
             (ex cj being Integer st cj = current.j & y < cj))
           implies
           (0 <= j & j < n) &
           (0 <= j+1 & j+1 < n) &
           (n = n implies
             (((current+*(j+1,current.j)).(j+1) = current.j &
               (for r being Integer st r <> j+1
                holds
                  (current+*(j+1,current.j)).r = current.r))
              implies
                (0 <= j & j-1 < j) &
                [n,[original,
                  [i,[y,[j-1,
                    current+*(j+1,current.j)]]]]]
                  in SingleInv))) &
         (not (0 <= j &
             (ex cj being Integer st cj = current.j & y < cj))
           implies
           (0 <= j+1 & j+1 < n) &
           (n = n implies
             (((current+*(j+1,y)).(j+1) = y &
               (for r being Integer st r <> j+1
                holds (current+*(j+1,y)).r = current.r))
              implies
                [n,[current+*(j+1,y),n]] in SortedUpto &
                [n,[original,current+*(j+1,y)]]
                  in Permut))))) &
    (for n,i,y,j being Integer,
         original,current being Function of INT,INT holds
       ([n,[original,[i,[y,[j,current]]]]] in SinglePhase iff
         0 <= n &
         [n,[original,[i,[y,[j,current]]]]] in SingleInv &
         (for j1 being Integer,
              next being Function of INT,INT holds
            [n,[original,[i,[y,[j1,next]]]]] in SingleInv
            implies
              [n,[original,[i,[y,[j1,next]]]]]
                in SingleStep))) &
    (for n,i being Integer,
         original,base being Function of INT,INT holds
       ([n,[original,[base,i]]] in SingleCase iff
         0 <= n &
         (0 <= i & i < n) &
         [n,[original,
           [i,[base.i,[i-1,base]]]]]
             in SinglePhase))
  holds
    for n being Integer,
        a being Function of INT,INT st 0 <= n holds
      0 <= 0 &
      0 <= n &
      [n,[a,0]] in SortedUpto &
      [n,[a,a]] in Permut &
      (for i being Integer,
           a1 being Function of INT,INT holds
         ((0 <= i & i <= n) &
          [n,[a1,i]] in SortedUpto &
          [n,[a,a1]] in Permut)
         implies
           (i < n-1 implies
             [n,[a,[a1,i]]] in PairCase) &
           (not i < n-1 implies
             (i = n-1 implies
               [n,[a,[a1,i]]] in SingleCase) &
             (i <> n-1 implies
               [n,[a1,n]] in SortedUpto &
               [n,[a,a1]] in Permut)))
proof
end;
::$P+
