:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/tree_of_array_TreeOfArray_tree_of_arrayqtvc: the verification
:: condition for converting an array into an inorder-preserving binary tree
:: whose positive size lies between consecutive powers of two determined by
:: its height. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1,
    FINSEQ_2, MCART_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1, FINSEQ_2, NEWTON;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    FINSEQ_1, FINSEQ_2, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size,Height being Function of Tree,INT,
      Inorder being Function of Tree,E*,
      Pow2 being Function of INT,INT,
      a being FinSequence of E
  st
    (for l,r being Element of Tree,
         x being Element of E
     holds
       node.[l,[x,r]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex l,r being Element of Tree,
          x being Element of E st
         u = node.[l,[x,r]]) &
    (for l,l2,r,r2 being Element of Tree,
         x,x2 being Element of E st
       node.[l,[x,r]] = node.[l2,[x2,r2]]
     holds
       l = l2 & x = x2 & r = r2) &
    (for X being Subset of Tree st
       emptyT in X &
       (for l,r being Element of Tree,
            x being Element of E st
          l in X & r in X
        holds
          node.[l,[x,r]] in X)
     holds
       X = Tree) &
    Size.emptyT = 0 &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       Size.(node.[l,[x,r]]) = 1 + Size.l + Size.r) &
    Height.emptyT = 0 &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       Height.(node.[l,[x,r]]) =
         1 + max(Height.l,Height.r)) &
    Inorder.emptyT = <*>(E) &
    (for l,r being Element of Tree,
         x being Element of E
     holds
       Inorder.(node.[l,[x,r]]) =
         Inorder.l ^ <*x*> ^ Inorder.r) &
    (for e being Integer st 0 <= e holds
       ex n being Nat st
         n = e &
         Pow2.e = 2 |^ n)
  holds
    for o1 being Integer st o1 = len a holds
      (0 <= 0 & 0 <= o1 & o1 <= len a) &
      (for result being Element of Tree st
         Size.result = o1 &
         Inorder.result = a &
         (0 < o1 implies
            for h being Element of INT st h = Height.result holds
              for hm1 being Element of INT st hm1 = h-1 holds
                Pow2.hm1 <= o1 & o1 < Pow2.h)
       holds
         Inorder.result = a &
         (0 < Size.result implies
            for h being Element of INT st h = Height.result holds
              for hm1 being Element of INT st hm1 = h-1 holds
                Pow2.hm1 <= Size.result &
                Size.result < Pow2.h))
proof
end;
::$P+
