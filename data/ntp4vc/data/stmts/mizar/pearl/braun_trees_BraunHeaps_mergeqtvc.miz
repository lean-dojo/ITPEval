:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/braun_trees_BraunHeaps_mergeqtvc: the Braun-heap merge
:: verification condition preserves heap order, Braun balance, element
:: multiplicities, and total size across all empty and node branches.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E,Tree being non empty set,
      Leq being Relation of E,E,
      emptyT being Element of Tree,
      node being Function of [:Tree,[:E,Tree:]:],Tree,
      Size being Function of Tree,INT,
      Occ being Function of [:E,Tree:],INT,
      LeRoot being Subset of [:E,Tree:],
      Heaps,Inv being Subset of Tree,
      Minimum being Function of Tree,E,
      l,r being Element of Tree
  st
    (for a being Element of E holds [a,a] in Leq) &
    (for a,b,c being Element of E st
       [a,b] in Leq & [b,c] in Leq
     holds
       [a,c] in Leq) &
    (for a,b being Element of E holds
       [a,b] in Leq or [b,a] in Leq) &
    (for left,right being Element of Tree,
         y being Element of E
     holds
       node.[left,[y,right]] <> emptyT) &
    (for u being Element of Tree holds
       u = emptyT or
       ex left,right being Element of Tree,
          y being Element of E st
         u = node.[left,[y,right]]) &
    (for left,left2,right,right2 being Element of Tree,
         y,y2 being Element of E st
       node.[left,[y,right]] = node.[left2,[y2,right2]]
     holds
       left = left2 & y = y2 & right = right2) &
    Size.emptyT = 0 &
    (for u being Element of Tree holds 0 <= Size.u) &
    (for left,right being Element of Tree,
         y being Element of E
     holds
       Size.(node.[left,[y,right]]) = 1 + Size.left + Size.right) &
    (for a being Element of E holds
       Occ.[a,emptyT] = 0) &
    (for a,y being Element of E,
         left,right being Element of Tree
     holds
       ex whole,leftOcc,rightOcc being Integer st
         whole = Occ.[a,node.[left,[y,right]]] &
         leftOcc = Occ.[a,left] &
         rightOcc = Occ.[a,right] &
         (a = y implies whole = 1 + leftOcc + rightOcc) &
         (a <> y implies whole = leftOcc + rightOcc)) &
    (for a being Element of E holds
       [a,emptyT] in LeRoot) &
    (for a,y being Element of E,
         left,right being Element of Tree
     holds
       ([a,node.[left,[y,right]]] in LeRoot iff [a,y] in Leq)) &
    emptyT in Heaps &
    (for y being Element of E,
         left,right being Element of Tree
     holds
       (node.[left,[y,right]] in Heaps iff
          [y,left] in LeRoot & left in Heaps &
          [y,right] in LeRoot & right in Heaps)) &
    emptyT in Inv &
    (for y being Element of E,
         left,right being Element of Tree
     holds
       (node.[left,[y,right]] in Inv iff
          (Size.left = Size.right or Size.left = Size.right + 1) &
          left in Inv & right in Inv)) &
    (for y being Element of E,
         left,right being Element of Tree
     holds
       Minimum.(node.[left,[y,right]]) = y) &
    l in Heaps &
    r in Heaps &
    l in Inv &
    r in Inv &
    Size.r <= Size.l &
    Size.l <= Size.r + 1
  holds
    (r = emptyT or
      ex rl,rr,ll,lr being Element of Tree,
         rootR,rootL being Element of E st
        r = node.[rl,[rootR,rr]] &
        l = node.[ll,[rootL,lr]] &
        (([rootL,rootR] in Leq &
          0 <= Size.l + Size.r &
          Size.ll + Size.lr < Size.l + Size.r &
          ll in Heaps & lr in Heaps &
          ll in Inv & lr in Inv &
          Size.lr <= Size.ll &
          Size.ll <= Size.lr + 1) or
         (not [rootL,rootR] in Leq &
          l in Heaps & l in Inv & 0 < Size.l &
          (for removed being Element of E,
               l1 being Element of Tree st
             l1 in Heaps &
             l1 in Inv &
             Size.l1 = Size.l - 1 &
             (ex removedL1,removedL being Integer st
                removedL1 = Occ.[removed,l1] &
                removedL = Occ.[removed,l] &
                removedL1 = removedL - 1) &
             (for other being Element of E st other <> removed holds
                Occ.[other,l1] = Occ.[other,l])
           holds
             r in Heaps & r in Inv & 0 < Size.r)))) &
    (for result being Element of Tree st
      ((r = emptyT & result = l) or
       ex rl,rr,ll,lr being Element of Tree,
          rootR,rootL being Element of E st
         r = node.[rl,[rootR,rr]] &
         l = node.[ll,[rootL,lr]] &
         (([rootL,rootR] in Leq &
           ex o1 being Element of Tree st
             o1 in Heaps &
             o1 in Inv &
             (for e being Element of E holds
                ex eo1,ell,elr being Integer st
                  eo1 = Occ.[e,o1] &
                  ell = Occ.[e,ll] &
                  elr = Occ.[e,lr] &
                  eo1 = ell + elr) &
             Size.o1 = Size.ll + Size.lr &
             result = node.[r,[rootL,o1]]) or
          (not [rootL,rootR] in Leq &
           ex removed being Element of E,
              t1 being Element of Tree st
             t1 in Heaps &
             t1 in Inv &
             Size.t1 = Size.l - 1 &
             (ex removedT1,removedL being Integer st
                removedT1 = Occ.[removed,t1] &
                removedL = Occ.[removed,l] &
                removedT1 = removedL - 1) &
             (for other being Element of E st other <> removed holds
                Occ.[other,t1] = Occ.[other,l]) &
             ex o1 being Element of Tree st
               o1 in Heaps &
               o1 in Inv &
               ((removed = Minimum.r &
                 Occ.[removed,o1] = Occ.[removed,r]) or
                (removed <> Minimum.r &
                 ex removedO1,removedR,minimumO1,minimumR being Integer st
                   removedO1 = Occ.[removed,o1] &
                   removedR = Occ.[removed,r] &
                   minimumO1 = Occ.[Minimum.r,o1] &
                   minimumR = Occ.[Minimum.r,r] &
                   removedO1 = removedR + 1 &
                   minimumO1 = minimumR - 1)) &
               (for other being Element of E st
                  other <> removed & other <> Minimum.r
                holds
                  Occ.[other,o1] = Occ.[other,r]) &
               Size.o1 = Size.r &
               result = node.[o1,[rootR,t1]])))
     holds
       result in Heaps &
       result in Inv &
       (for e being Element of E holds
          ex eresult,el,er being Integer st
            eresult = Occ.[e,result] &
            el = Occ.[e,l] &
            er = Occ.[e,r] &
            eresult = el + er) &
       Size.result = Size.l + Size.r)
proof
end;
::$P+
