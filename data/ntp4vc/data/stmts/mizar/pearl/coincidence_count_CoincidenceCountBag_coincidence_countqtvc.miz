:: Statement-only formalization of the NTP4VC corpus artifact
:: pearl/coincidence_count_CoincidenceCountBag_coincidence_countqtvc:
:: the coincidence-count loop verification condition preserves the cardinality
:: invariant for intersecting suffix multisets of two increasing integer lists.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      ORDINAL4, FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7,
      MARGREL1, XBOOLEAN, MCART_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, MCART_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
      FINSEQ_1, FINSEQ_2, PBOOLE, PRE_POLY, FUNCT_4, FUNCT_7, MARGREL1,
      XBOOLEAN;
 constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, XXREAL_0, FINSEQ_1,
      FINSEQ_2, PRE_POLY, FUNCT_4, FUNCT_7, MARGREL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
      XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1, FINSEQ_2, PBOOLE,
      PRE_POLY, MARGREL1, XBOOLEAN;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a, b being FinSequence of INT,
      nthElem being Function of [:INT*,INT:],INT,
      bagInsert being Function of [:Bags INT,INT:],Bags INT,
      bagMeet being Function of [:Bags INT,Bags INT:],Bags INT,
      bagSize being Function of Bags INT,INT,
      bagSub being Function of [:INT*,[:INT,INT:]:],Bags INT,
      bagOf being Function of INT*,Bags INT,
      dropBag being Function of [:INT*,INT:],Bags INT
  st
    (for xs being FinSequence of INT, i being Integer
       st 0 <= i & i < len xs
       holds nthElem.[xs,i] = xs.(i+1)) &
    (for q being Element of Bags INT, x, y being Integer
       holds
         (y = x implies (bagInsert.[q,x]).y = q.y+1) &
         (y <> x implies (bagInsert.[q,x]).y = q.y)) &
    (for p, q being Element of Bags INT, x being Integer
       holds (bagMeet.[p,q]).x = min(p.x,q.x)) &
    bagSize.(EmptyBag INT) = 0 &
    (for q being Element of Bags INT, x being Integer
       holds bagSize.(bagInsert.[q,x]) = bagSize.q+1) &
    (for xs being FinSequence of INT, lo, hi being Integer
       st 0 <= lo & lo <= hi & hi <= len xs
       holds
         (hi <= lo implies bagSub.[xs,[lo,hi]] = EmptyBag INT) &
         (not hi <= lo implies
            bagSub.[xs,[lo,hi]] =
              bagInsert.[bagSub.[xs,[lo+1,hi]],nthElem.[xs,lo]])) &
    (for xs being FinSequence of INT
       holds bagOf.xs = bagSub.[xs,[0,len xs]]) &
    (for xs being FinSequence of INT, i being Integer
       holds dropBag.[xs,i] = bagSub.[xs,[i,len xs]]) &
    (for i, j being Integer
       st 0 <= i & i < j & j < len a
       holds nthElem.[a,i] <= nthElem.[a,j]) &
    (for i, j being Integer
       st 0 <= i & i < j & j < len b
       holds nthElem.[b,i] <= nthElem.[b,j])
  holds
    0 <= 0 & 0 <= len a &
    0 <= 0 & 0 <= len b &
    0 + bagSize.(bagMeet.[dropBag.[a,0],dropBag.[b,0]]) =
      bagSize.(bagMeet.[bagOf.a,bagOf.b]) &
    (for c, j, i being Integer
       st
         0 <= i & i <= len a &
         0 <= j & j <= len b &
         c + bagSize.(bagMeet.[dropBag.[a,i],dropBag.[b,j]]) =
           bagSize.(bagMeet.[bagOf.a,bagOf.b])
       holds
         for o1 being Element of BOOLEAN
           st
             (i < len a &
                ((j < len b & o1 = TRUE) or
                 (not j < len b & o1 = FALSE))) or
             (not i < len a & o1 = FALSE)
           holds
             (o1 = TRUE &
                j < len b & i < len a &
                ((nthElem.[a,i] < nthElem.[b,j] &
                    0 <= (len a + len b) - (i + j) &
                    (len a + len b) - ((i+1) + j) <
                      (len a + len b) - (i + j) &
                    0 <= i+1 & i+1 <= len a &
                    0 <= j & j <= len b &
                    c + bagSize.(
                      bagMeet.[dropBag.[a,i+1],dropBag.[b,j]]) =
                      bagSize.(bagMeet.[bagOf.a,bagOf.b])) or
                 (not nthElem.[a,i] < nthElem.[b,j] &
                    nthElem.[b,j] < nthElem.[a,i] &
                    0 <= (len a + len b) - (i + j) &
                    (len a + len b) - (i + (j+1)) <
                      (len a + len b) - (i + j) &
                    0 <= i & i <= len a &
                    0 <= j+1 & j+1 <= len b &
                    c + bagSize.(
                      bagMeet.[dropBag.[a,i],dropBag.[b,j+1]]) =
                      bagSize.(bagMeet.[bagOf.a,bagOf.b])) or
                 (not nthElem.[a,i] < nthElem.[b,j] &
                    not nthElem.[b,j] < nthElem.[a,i] &
                    0 <= (len a + len b) - (i + j) &
                    (len a + len b) - ((i+1) + (j+1)) <
                      (len a + len b) - (i + j) &
                    0 <= i+1 & i+1 <= len a &
                    0 <= j+1 & j+1 <= len b &
                    c+1 + bagSize.(
                      bagMeet.[dropBag.[a,i+1],dropBag.[b,j+1]]) =
                      bagSize.(bagMeet.[bagOf.a,bagOf.b])))) or
             (o1 = FALSE &
                c = bagSize.(bagMeet.[bagOf.a,bagOf.b])))
proof
end;
::$P+
