:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_quat_of_rmat/float_quat_of_rmat_Why3_ide_VCfloat_quat_of_rmat_a11_max_post_goal10:
:: the a11-max branch converts a special orthogonal 3-by-3 real rotation
:: matrix stored in memory to quaternion components. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0, SQUARE_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1, SQUARE_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,a7,a8,a9,a10,a11,a12,a13,a14,a15,a16
        being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1,t8,t7,t4,t6,t5,t9,t2,t3,m,m1,m2,m3,m4,m5,m6,m7,m8,m9,m10
        being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL,
      r,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r13,r15,r16,r17,
      r19,r20,r22,r23 being Real
  st
    (for x being Real holds x in Float32 & x in Finite32) &
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    a2 = [ba,oa + 0] &
    a3 = [ba,(oa + 0) + 0] &
    r8 = t1.a3 &
    a4 = [ba,(oa + 0) + 4] &
    r9 = t1.a4 &
    a5 = [ba,(oa + 0) + 8] &
    r10 = t1.a5 &
    r11 = r8 + r9 + r10 &
    a7 = [ba1,oa1 + 0] &
    (for x being Element of [:INT,INT:] holds
      (x = a7 implies m.x = (1/2)*r3) &
      (x <> a7 implies m.x = t8.x)) &
    a8 = [ba1,oa1 + 1] &
    a9 = [ba,(oa + 0) + 5] &
    a10 = [ba,(oa + 0) + 7] &
    (for x being Element of [:INT,INT:] holds
      (x = a8 implies m1.x = (m.a9 - m.a10)/r7) &
      (x <> a8 implies m1.x = m.x)) &
    a11 = [ba1,oa1 + 2] &
    a12 = [ba,(oa + 0) + 6] &
    a13 = [ba,(oa + 0) + 2] &
    (for x being Element of [:INT,INT:] holds
      (x = a11 implies m2.x = (m1.a12 - m1.a13)/r7) &
      (x <> a11 implies m2.x = m1.x)) &
    a14 = [ba1,oa1 + 3] &
    a15 = [ba,(oa + 0) + 1] &
    a16 = [ba,(oa + 0) + 3] &
    r13 = 1 + (t8.a3 + t8.a4 + t8.a5) &
    (for x being Element of [:INT,INT:] holds
      (x = a8 implies m3.x = (1/2)*r2) &
      (x <> a8 & x = a7 implies
        m3.x = (t7.a9 - t7.a10)/r6) &
      (x <> a8 & x <> a7 implies m3.x = t7.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = a11 implies m4.x = (m3.a15 + m3.a16)/r6) &
      (x <> a11 implies m4.x = m3.x)) &
    r15 = t7.a3 - t7.a4 - t7.a5 + 1 &
    r16 = t4.a5 &
    r17 = t4.a4 &
    r19 = 2*r1 &
    (for x being Element of [:INT,INT:] holds
      (x = a7 implies m5.x = (t6.a12 - t6.a13)/r5) &
      (x <> a7 implies m5.x = t6.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = a11 implies m6.x = (1/2)*r1) &
      (x <> a11 & x = a8 implies
        m6.x = (m5.a15 + m5.a16)/r5) &
      (x <> a11 & x <> a8 implies m6.x = m5.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = a14 implies m7.x = (m6.a9 + m6.a10)/r5) &
      (x <> a14 implies m7.x = m6.x)) &
    r20 = t6.a4 - t6.a3 - t6.a5 + 1 &
    r22 = 2*r &
    (for x being Element of [:INT,INT:] holds
      (x = a7 implies m8.x = (t5.a15 - t5.a16)/r4) &
      (x <> a7 implies m8.x = t5.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = a8 implies m9.x = (m8.a12 + m8.a13)/r4) &
      (x <> a8 implies m9.x = m8.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = a14 implies m10.x = (1/2)*r) &
      (x <> a14 & x = a11 implies
        m10.x = (m9.a9 + m9.a10)/r4) &
      (x <> a14 & x <> a11 implies m10.x = m9.x)) &
    r23 = t5.a5 - t5.a3 - t5.a4 + 1 &
    r8 + r9 + r10 <= 0 &
    rega <= 0 &
    rega1 <= 0 &
    r8 <= r9 &
    r10 < r9 &
    t in Linked &
    r in Float32 &
    r1 in Float32 &
    r2 in Float32 &
    r3 in Float32 &
    r4 in Float32 &
    r5 in Float32 &
    r6 in Float32 &
    r7 in Float32 &
    0 < ba1 &
    0 <= oa1 &
    oa1 + 4 <= ta1 &
    t1.a3 in Finite32 &
    t1.a15 in Finite32 &
    t1.a13 in Finite32 &
    t1.a16 in Finite32 &
    t1.a4 in Finite32 &
    t1.a9 in Finite32 &
    t1.a12 in Finite32 &
    t1.a10 in Finite32 &
    t1.a5 in Finite32 &
    ba <> 0 &
    0 <= oa &
    oa + 9 <= ta &
    (ba <> ba1 or oa1 + 4 <= oa or oa + 9 <= oa1) &
    t1.a3*t1.a3 + t1.a15*t1.a15 + t1.a13*t1.a13 = 1 &
    t1.a3*t1.a16 + t1.a15*t1.a4 + t1.a13*t1.a9 = 0 &
    t1.a3*t1.a12 + t1.a15*t1.a10 + t1.a13*t1.a5 = 0 &
    t1.a16*t1.a3 + t1.a4*t1.a15 + t1.a9*t1.a13 = 0 &
    t1.a16*t1.a16 + t1.a4*t1.a4 + t1.a9*t1.a9 = 1 &
    t1.a16*t1.a12 + t1.a4*t1.a10 + t1.a9*t1.a5 = 0 &
    t1.a12*t1.a3 + t1.a10*t1.a15 + t1.a5*t1.a13 = 0 &
    t1.a12*t1.a16 + t1.a10*t1.a4 + t1.a5*t1.a9 = 0 &
    t1.a12*t1.a12 + t1.a10*t1.a10 + t1.a5*t1.a5 = 1 &
    t1.a3*t1.a4*t1.a5 +
      t1.a15*t1.a9*t1.a12 +
      t1.a13*t1.a16*t1.a10 -
      t1.a3*t1.a9*t1.a10 -
      t1.a15*t1.a16*t1.a5 -
      t1.a13*t1.a4*t1.a12 = 1 &
    r8 in Float32 &
    r9 in Float32 &
    r10 in Float32 &
    r11 in Float32 &
    (
      (0 < r11 &
        t8 = t1 &
        2*r3 = r7 &
        (for x being Element of [:INT,INT:] holds
          (x = a14 implies t9.x = (m2.a15 - m2.a16)/r7) &
          (x <> a14 implies t9.x = m2.x)) &
        0 <= r3 &
        0 <= r13 &
        r3 in Finite32 &
        r13 in Finite32)
      or
      (r11 <= 0 &
        t2 = t1 &
        (
          (t2.a4 < t2.a3 &
            t3 = t2 &
            (
              (t3.a5 < t3.a3 &
                t7 = t3 &
                2*r2 = r6 &
                (for x being Element of [:INT,INT:] holds
                  (x = a14 implies
                    t9.x = (m4.a12 + m4.a13)/r6) &
                  (x <> a14 implies t9.x = m4.x)) &
                0 <= r2 &
                0 <= r15 &
                r2 in Finite32 &
                r15 in Finite32)
              or
              (t3.a3 <= t3.a5 &
                t4 = t3 &
                (
                  (r16 < r17 &
                    t6 = t4 &
                    r19 = r5 &
                    m7 = t9 &
                    0 <= r1 &
                    0 <= r20 &
                    r1 in Finite32 &
                    r20 in Finite32)
                  or
                  (r17 <= r16 &
                    t5 = t4 &
                    r22 = r4 &
                    m10 = t9 &
                    0 <= r &
                    0 <= r23 &
                    r in Finite32 &
                    r23 in Finite32)))))
          or
          (t2.a3 <= t2.a4 &
            t4 = t2 &
            (
              (r16 < r17 &
                t6 = t4 &
                r19 = r5 &
                m7 = t9 &
                0 <= r1 &
                0 <= r20 &
                r1 in Finite32 &
                r20 in Finite32)
              or
              (r17 <= r16 &
                t5 = t4 &
                r22 = r4 &
                m10 = t9 &
                0 <= r &
                0 <= r23 &
                r in Finite32 &
                r23 in Finite32))))))
    & r1 = sqrt r20
  holds
    t9.a7 =
      (t9.a12 - t9.a13) /
        (2 * sqrt(1 + t9.a4 - t9.a3 - t9.a5)) &
    t9.a8 =
      (t9.a16 + t9.a15) /
        (2 * sqrt(1 + t9.a4 - t9.a3 - t9.a5)) &
    t9.a11 = (1/2) * sqrt(1 + t9.a4 - t9.a3 - t9.a5) &
    t9.a14 =
      (t9.a10 + t9.a9) /
        (2 * sqrt(1 + t9.a4 - t9.a3 - t9.a5))
proof
end;
::$P+
