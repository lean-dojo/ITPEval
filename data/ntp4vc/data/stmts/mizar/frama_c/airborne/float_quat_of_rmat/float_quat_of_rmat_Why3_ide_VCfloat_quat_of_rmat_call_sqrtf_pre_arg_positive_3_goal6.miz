:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_quat_of_rmat/float_quat_of_rmat_Why3_ide_VCfloat_quat_of_rmat_call_sqrtf_pre_arg_positive_3_goal6:
:: memory-valid special orthogonal 3-by-3 real rotation-matrix hypotheses
:: make the selected square-root argument nonnegative. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,p0,p1,p2,p3,p4,p5,p6,p7,p8
        being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1 being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL,
      r,r1,r2,r3 being Real
  st
    (for x being Real holds x in Float32 & x in Finite32) &
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    a2 = [ba,oa + 0] &
    p0 = [ba,(oa + 0) + 0] &
    p1 = [ba,(oa + 0) + 1] &
    p2 = [ba,(oa + 0) + 2] &
    p3 = [ba,(oa + 0) + 3] &
    p4 = [ba,(oa + 0) + 4] &
    p5 = [ba,(oa + 0) + 5] &
    p6 = [ba,(oa + 0) + 6] &
    p7 = [ba,(oa + 0) + 7] &
    p8 = [ba,(oa + 0) + 8] &
    r = t1.p8 &
    r1 = t1.p4 &
    r2 = t1.p0 &
    r3 = r2 + r1 + r &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    rega <= 0 &
    rega1 <= 0 &
    r < r1 &
    r3 <= 0 &
    t in Linked &
    0 < ba1 &
    0 <= oa1 &
    oa1 + 4 <= ta1 &
    t1.p0 in Finite32 &
    t1.p1 in Finite32 &
    t1.p2 in Finite32 &
    t1.p3 in Finite32 &
    t1.p4 in Finite32 &
    t1.p5 in Finite32 &
    t1.p6 in Finite32 &
    t1.p7 in Finite32 &
    t1.p8 in Finite32 &
    ba <> 0 &
    0 <= oa &
    oa + 9 <= ta &
    (ba <> ba1 or oa1 + 4 <= oa or oa + 9 <= oa1) &
    t1.p0*t1.p0 + t1.p1*t1.p1 + t1.p2*t1.p2 = 1 &
    t1.p0*t1.p3 + t1.p1*t1.p4 + t1.p2*t1.p5 = 0 &
    t1.p0*t1.p6 + t1.p1*t1.p7 + t1.p2*t1.p8 = 0 &
    t1.p3*t1.p0 + t1.p4*t1.p1 + t1.p5*t1.p2 = 0 &
    t1.p3*t1.p3 + t1.p4*t1.p4 + t1.p5*t1.p5 = 1 &
    t1.p3*t1.p6 + t1.p4*t1.p7 + t1.p5*t1.p8 = 0 &
    t1.p6*t1.p0 + t1.p7*t1.p1 + t1.p8*t1.p2 = 0 &
    t1.p6*t1.p3 + t1.p7*t1.p4 + t1.p8*t1.p5 = 0 &
    t1.p6*t1.p6 + t1.p7*t1.p7 + t1.p8*t1.p8 = 1 &
    t1.p0*t1.p4*t1.p8 +
      t1.p1*t1.p5*t1.p6 +
      t1.p2*t1.p3*t1.p7 -
      t1.p0*t1.p5*t1.p7 -
      t1.p1*t1.p3*t1.p8 -
      t1.p2*t1.p4*t1.p6 = 1 &
    r2 in Float32 &
    t1.p2 in Float32 &
    r1 in Float32 &
    t1.p6 in Float32 &
    r in Float32 &
    r3 in Float32 &
    (r2 <= r1 or r2 <= r)
  holds
    0 <= r1 + -r2 + -r + 1
proof
end;
::$P+
