:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_quat_of_rmat/float_quat_of_rmat_Why3_ide_VCfloat_quat_of_rmat_trace_pos_post_goal12:
:: the positive-trace branch converts a special orthogonal 3-by-3 real
:: rotation matrix stored in memory to quaternion components. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0, SQUARE_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1, SQUARE_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,p0,p1,p2,p3,p4,p5,p6,p7,p8,q0,q1,q2,q3
        being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1,t8,t7,t4,t6,t5,t9,t2,t3,m,m1,m2,m3,m4,m5,m6,m7,m8,m9,m10
        being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL,
      r,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r13,r15,r16,r17,
      r19,r20,r22,r23 being Real
  st
    (for x being Real holds x in Float32 & x in Finite32) &
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    p0 = [ba,(oa + 0) + 0] &
    p1 = [ba,(oa + 0) + 1] &
    p2 = [ba,(oa + 0) + 2] &
    p3 = [ba,(oa + 0) + 3] &
    p4 = [ba,(oa + 0) + 4] &
    p5 = [ba,(oa + 0) + 5] &
    p6 = [ba,(oa + 0) + 6] &
    p7 = [ba,(oa + 0) + 7] &
    p8 = [ba,(oa + 0) + 8] &
    r8 = t1.p0 &
    r9 = t1.p4 &
    r10 = t1.p8 &
    r11 = r8 + r9 + r10 &
    q0 = [ba1,oa1 + 0] &
    q1 = [ba1,oa1 + 1] &
    q2 = [ba1,oa1 + 2] &
    q3 = [ba1,oa1 + 3] &
    (for x being Element of [:INT,INT:] holds
      (x = q0 implies m.x = (1/2)*r3) &
      (x <> q0 implies m.x = t8.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q1 implies m1.x = (m.p5 - m.p7)/r7) &
      (x <> q1 implies m1.x = m.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q2 implies m2.x = (m1.p6 - m1.p2)/r7) &
      (x <> q2 implies m2.x = m1.x)) &
    r13 = 1 + (t8.p0 + t8.p4 + t8.p8) &
    (for x being Element of [:INT,INT:] holds
      (x = q1 implies m3.x = (1/2)*r2) &
      (x <> q1 & x = q0 implies
        m3.x = (t7.p5 - t7.p7)/r6) &
      (x <> q1 & x <> q0 implies m3.x = t7.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q2 implies m4.x = (m3.p1 + m3.p3)/r6) &
      (x <> q2 implies m4.x = m3.x)) &
    r15 = t7.p0 - t7.p4 - t7.p8 + 1 &
    r16 = t4.p8 &
    r17 = t4.p4 &
    r19 = 2*r1 &
    (for x being Element of [:INT,INT:] holds
      (x = q0 implies m5.x = (t6.p6 - t6.p2)/r5) &
      (x <> q0 implies m5.x = t6.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q2 implies m6.x = (1/2)*r1) &
      (x <> q2 & x = q1 implies
        m6.x = (m5.p1 + m5.p3)/r5) &
      (x <> q2 & x <> q1 implies m6.x = m5.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q3 implies m7.x = (m6.p5 + m6.p7)/r5) &
      (x <> q3 implies m7.x = m6.x)) &
    r20 = t6.p4 - t6.p0 - t6.p8 + 1 &
    r22 = 2*r &
    (for x being Element of [:INT,INT:] holds
      (x = q0 implies m8.x = (t5.p1 - t5.p3)/r4) &
      (x <> q0 implies m8.x = t5.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q1 implies m9.x = (m8.p6 + m8.p2)/r4) &
      (x <> q1 implies m9.x = m8.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = q3 implies m10.x = (1/2)*r) &
      (x <> q3 & x = q2 implies
        m10.x = (m9.p5 + m9.p7)/r4) &
      (x <> q3 & x <> q2 implies m10.x = m9.x)) &
    r23 = t5.p8 - t5.p0 - t5.p4 + 1 &
    0 < r11 &
    rega <= 0 &
    rega1 <= 0 &
    t in Linked &
    r in Float32 &
    r1 in Float32 &
    r2 in Float32 &
    r3 in Float32 &
    r4 in Float32 &
    r5 in Float32 &
    r6 in Float32 &
    r7 in Float32 &
    0 < ba1 &
    0 <= oa1 &
    oa1 + 4 <= ta1 &
    t1.p0 in Finite32 &
    t1.p1 in Finite32 &
    t1.p2 in Finite32 &
    t1.p3 in Finite32 &
    t1.p4 in Finite32 &
    t1.p5 in Finite32 &
    t1.p6 in Finite32 &
    t1.p7 in Finite32 &
    t1.p8 in Finite32 &
    ba <> 0 &
    0 <= oa &
    oa + 9 <= ta &
    (ba <> ba1 or oa1 + 4 <= oa or oa + 9 <= oa1) &
    t1.p0*t1.p0 + t1.p1*t1.p1 + t1.p2*t1.p2 = 1 &
    t1.p0*t1.p3 + t1.p1*t1.p4 + t1.p2*t1.p5 = 0 &
    t1.p0*t1.p6 + t1.p1*t1.p7 + t1.p2*t1.p8 = 0 &
    t1.p3*t1.p0 + t1.p4*t1.p1 + t1.p5*t1.p2 = 0 &
    t1.p3*t1.p3 + t1.p4*t1.p4 + t1.p5*t1.p5 = 1 &
    t1.p3*t1.p6 + t1.p4*t1.p7 + t1.p5*t1.p8 = 0 &
    t1.p6*t1.p0 + t1.p7*t1.p1 + t1.p8*t1.p2 = 0 &
    t1.p6*t1.p3 + t1.p7*t1.p4 + t1.p8*t1.p5 = 0 &
    t1.p6*t1.p6 + t1.p7*t1.p7 + t1.p8*t1.p8 = 1 &
    t1.p0*t1.p4*t1.p8 +
      t1.p1*t1.p5*t1.p6 +
      t1.p2*t1.p3*t1.p7 -
      t1.p0*t1.p5*t1.p7 -
      t1.p1*t1.p3*t1.p8 -
      t1.p2*t1.p4*t1.p6 = 1 &
    r8 in Float32 &
    r9 in Float32 &
    r10 in Float32 &
    r11 in Float32 &
    (
      (0 < r11 &
        t8 = t1 &
        2*r3 = r7 &
        (for x being Element of [:INT,INT:] holds
          (x = q3 implies t9.x = (m2.p1 - m2.p3)/r7) &
          (x <> q3 implies t9.x = m2.x)) &
        0 <= r3 &
        0 <= r13 &
        r3 in Finite32 &
        r13 in Finite32)
      or
      (r11 <= 0 &
        t2 = t1 &
        (
          (t2.p4 < t2.p0 &
            t3 = t2 &
            (
              (t3.p8 < t3.p0 &
                t7 = t3 &
                2*r2 = r6 &
                (for x being Element of [:INT,INT:] holds
                  (x = q3 implies
                    t9.x = (m4.p6 + m4.p2)/r6) &
                  (x <> q3 implies t9.x = m4.x)) &
                0 <= r2 &
                0 <= r15 &
                r2 in Finite32 &
                r15 in Finite32)
              or
              (t3.p0 <= t3.p8 &
                t4 = t3 &
                (
                  (r16 < r17 &
                    t6 = t4 &
                    r19 = r5 &
                    m7 = t9 &
                    0 <= r1 &
                    0 <= r20 &
                    r1 in Finite32 &
                    r20 in Finite32)
                  or
                  (r17 <= r16 &
                    t5 = t4 &
                    r22 = r4 &
                    m10 = t9 &
                    0 <= r &
                    0 <= r23 &
                    r in Finite32 &
                    r23 in Finite32)))))
          or
          (t2.p0 <= t2.p4 &
            t4 = t2 &
            (
              (r16 < r17 &
                t6 = t4 &
                r19 = r5 &
                m7 = t9 &
                0 <= r1 &
                0 <= r20 &
                r1 in Finite32 &
                r20 in Finite32)
              or
              (r17 <= r16 &
                t5 = t4 &
                r22 = r4 &
                m10 = t9 &
                0 <= r &
                0 <= r23 &
                r in Finite32 &
                r23 in Finite32))))))
    & r3 = sqrt r13
  holds
    t9.q0 =
      (1/4) /
        ((1/2) / sqrt(1 + t9.p0 + t9.p4 + t9.p8)) &
    t9.q1 =
      (t9.p5 - t9.p7) *
        ((1/2) / sqrt(1 + t9.p0 + t9.p4 + t9.p8)) &
    t9.q2 =
      (t9.p6 - t9.p2) *
        ((1/2) / sqrt(1 + t9.p0 + t9.p4 + t9.p8)) &
    t9.q3 =
      (t9.p1 - t9.p3) *
        ((1/2) / sqrt(1 + t9.p0 + t9.p4 + t9.p8))
proof
end;
::$P+
