:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_rmat_of_eulers_321/float_rmat_of_eulers_321_Why3_ide_VCfloat_rmat_of_eulers_321_post_2_goal1:
:: Euler-321 sine and cosine entries written to a 3-by-3 real matrix have
:: determinant one under the stated memory-validity and float-classification
:: assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0, SIN_COS;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,p0,p1,p2,p3,p4,p5,p6,p7,p8,q0,q1,q2
        being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1 being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL,
      r,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,
      a00,a01,a02,a10,a11,a12,a20,a21,a22 being Real
  st
    (for x being Real holds x in Float32) &
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    p0 = [ba,(oa + 0) + 0] &
    p1 = [ba,(oa + 0) + 1] &
    p2 = [ba,(oa + 0) + 2] &
    p3 = [ba,(oa + 0) + 3] &
    p4 = [ba,(oa + 0) + 4] &
    p5 = [ba,(oa + 0) + 5] &
    p6 = [ba,(oa + 0) + 6] &
    p7 = [ba,(oa + 0) + 7] &
    p8 = [ba,(oa + 0) + 8] &
    q0 = [ba1,oa1 + 0] &
    q1 = [ba1,oa1 + 1] &
    q2 = [ba1,oa1 + 2] &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    r = t1.q0 &
    r1 = sin.r &
    r2 = t1.q2 &
    r3 = sin.r2 &
    r4 = t1.q1 &
    r5 = sin.r4 &
    r6 = cos.r &
    r7 = cos.r2 &
    r8 = cos.r4 &
    r9 = r1*r5 &
    r10 = r6*r5 &
    a00 = r8*r7 &
    a01 = r8*r3 &
    a02 = -r5 &
    a10 = r9*r7 - r6*r3 &
    a11 = r9*r3 + r6*r7 &
    a12 = r1*r8 &
    a20 = r10*r7 + r1*r3 &
    a21 = r10*r3 - r1*r7 &
    a22 = r6*r8 &
    rega <= 0 &
    rega1 <= 0 &
    r1 <= 1 &
    r3 <= 1 &
    r5 <= 1 &
    r6 <= 1 &
    r7 <= 1 &
    r8 <= 1 &
    -1 <= r1 &
    -1 <= r3 &
    -1 <= r5 &
    -1 <= r6 &
    -1 <= r7 &
    -1 <= r8 &
    t in Linked &
    0 < ba &
    0 <= oa &
    oa + 9 <= ta &
    t1.q0 in Finite32 &
    t1.q2 in Finite32 &
    t1.q1 in Finite32 &
    ba1 <> 0 &
    0 <= oa1 &
    oa1 + 3 <= ta1 &
    r in Finite32 &
    r2 in Finite32 &
    r4 in Finite32 &
    r in Float32 &
    r2 in Float32 &
    r4 in Float32 &
    r1 in Finite32 &
    r3 in Finite32 &
    r5 in Finite32 &
    r6 in Finite32 &
    r7 in Finite32 &
    r8 in Finite32 &
    r1 in Float32 &
    r3 in Float32 &
    r5 in Float32 &
    r6 in Float32 &
    r7 in Float32 &
    r8 in Float32
  holds
    a00*a11*a22 + a01*a12*a20 + a02*a10*a21 -
      a00*a12*a21 - a01*a10*a22 - a02*a11*a20 = 1
proof
end;
::$P+
