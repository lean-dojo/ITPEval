:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_rmat_integrate_fi/float_rmat_integrate_fi_Why3_ide_VCfloat_rmat_integrate_fi_call_float_rmat_comp_pre_2_goal0:
:: region, linkage, writable matrix memory, and valid finite float-rate
:: hypotheses imply read validity and finite32 classification for the
:: nine-cell float matrix at the output address. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,p0,p1,p2,p3,p4,p5,p6,p7,p8,q0,q1,q2
        being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1 being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL
  st
    (for x being Real holds x in Float32 & x in Finite32) &
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    p0 = [ba,oa + 0] &
    p1 = [ba,oa + 1] &
    p2 = [ba,oa + 2] &
    p3 = [ba,oa + 3] &
    p4 = [ba,oa + 4] &
    p5 = [ba,oa + 5] &
    p6 = [ba,oa + 6] &
    p7 = [ba,oa + 7] &
    p8 = [ba,oa + 8] &
    q0 = [ba1,oa1 + 0] &
    q1 = [ba1,oa1 + 1] &
    q2 = [ba1,oa1 + 2] &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    rega <= 0 &
    rega1 <= 0 &
    t in Linked &
    0 < ba &
    0 <= oa &
    oa + 9 <= ta &
    t1.q0 in Finite32 &
    t1.q1 in Finite32 &
    t1.q2 in Finite32 &
    ba1 <> 0 &
    0 <= oa1 &
    oa1 + 3 <= ta1 &
    t1.q0 in Float32 &
    t1.q1 in Float32 &
    t1.q2 in Float32
  holds
    t1.p0 in Finite32 &
    t1.p1 in Finite32 &
    t1.p2 in Finite32 &
    t1.p3 in Finite32 &
    t1.p4 in Finite32 &
    t1.p5 in Finite32 &
    t1.p6 in Finite32 &
    t1.p7 in Finite32 &
    t1.p8 in Finite32 &
    ba <> 0 &
    0 <= oa &
    oa + 9 <= ta
proof
end;
::$P+
