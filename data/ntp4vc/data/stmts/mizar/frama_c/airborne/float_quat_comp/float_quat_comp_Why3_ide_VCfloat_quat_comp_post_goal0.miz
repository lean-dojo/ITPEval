:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_quat_comp/float_quat_comp_Why3_ide_VCfloat_quat_comp_post_goal0:
:: four real-valued memory updates compute the Hamilton product of two
:: quaternions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14
        being Element of [:INT,INT:],
      ba1,oa1,ba,oa,ba2,oa2,
      rega1,rega,rega2,ta1,ta,ta2 being Integer,
      t1,m,m1,m2,m3 being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Finite32 being Subset of REAL,
      r0,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,r15,
      r16,r17,r18,r19,r20,r21,r22,r23,r24,r25,r26,r27,r28,r29,
      r30,r31 being Real
  st
    a1 = [ba1,oa1] &
    a = [ba,oa] &
    a2 = [ba2,oa2] &
    a3 = [ba1,oa1 + 0] &
    a4 = [ba,oa + 0] &
    a5 = [ba2,oa2 + 0] &
    a6 = [ba,oa + 1] &
    a7 = [ba1,oa1 + 1] &
    a8 = [ba2,oa2 + 1] &
    a9 = [ba,oa + 2] &
    a10 = [ba1,oa1 + 2] &
    a11 = [ba2,oa2 + 2] &
    a12 = [ba,oa + 3] &
    a13 = [ba1,oa1 + 3] &
    a14 = [ba2,oa2 + 3] &
    rega1 = reg.ba1 &
    rega = reg.ba &
    rega2 = reg.ba2 &
    ta1 = t.ba1 &
    ta = t.ba &
    ta2 = t.ba2 &
    r0 = t1.a4 &
    r1 = t1.a5 &
    r2 = t1.a6 &
    r3 = t1.a8 &
    r4 = t1.a9 &
    r5 = t1.a11 &
    r6 = t1.a12 &
    r7 = t1.a14 &
    (for x being Element of [:INT,INT:] holds
      (x = a3 implies
        m.x = r1*r0 - r3*r2 - r5*r4 - r7*r6) &
      (x <> a3 implies m.x = t1.x)) &
    r8 = m.a4 &
    r9 = m.a5 &
    r10 = m.a6 &
    r11 = m.a8 &
    r12 = m.a9 &
    r13 = m.a11 &
    r14 = m.a12 &
    r15 = m.a14 &
    (for x being Element of [:INT,INT:] holds
      (x = a7 implies
        m1.x = r9*r10 + r11*r8 + r13*r14 - r15*r12) &
      (x <> a7 implies m1.x = m.x)) &
    r16 = m1.a4 &
    r17 = m1.a5 &
    r18 = m1.a6 &
    r19 = m1.a8 &
    r20 = m1.a9 &
    r21 = m1.a11 &
    r22 = m1.a12 &
    r23 = m1.a14 &
    (for x being Element of [:INT,INT:] holds
      (x = a10 implies
        m2.x = r17*r20 - r19*r22 + r21*r16 + r23*r18) &
      (x <> a10 implies m2.x = m1.x)) &
    r24 = m2.a4 &
    r25 = m2.a5 &
    r26 = m2.a6 &
    r27 = m2.a8 &
    r28 = m2.a9 &
    r29 = m2.a11 &
    r30 = m2.a12 &
    r31 = m2.a14 &
    (for x being Element of [:INT,INT:] holds
      (x = a13 implies
        m3.x = r25*r30 + r27*r28 - r29*r26 + r31*r24) &
      (x <> a13 implies m3.x = m2.x)) &
    a3 <> a4 &
    a5 <> a4 &
    a5 <> a3 &
    a6 <> a3 &
    a6 <> a5 &
    a7 <> a4 &
    a7 <> a5 &
    a7 <> a6 &
    a8 <> a4 &
    a8 <> a3 &
    a8 <> a6 &
    a8 <> a7 &
    a9 <> a3 &
    a9 <> a5 &
    a9 <> a7 &
    a9 <> a8 &
    a10 <> a4 &
    a10 <> a5 &
    a10 <> a6 &
    a10 <> a8 &
    a10 <> a9 &
    a11 <> a4 &
    a11 <> a3 &
    a11 <> a6 &
    a11 <> a7 &
    a11 <> a9 &
    a11 <> a10 &
    a12 <> a3 &
    a12 <> a5 &
    a12 <> a7 &
    a12 <> a8 &
    a12 <> a10 &
    a12 <> a11 &
    a13 <> a4 &
    a13 <> a5 &
    a13 <> a6 &
    a13 <> a8 &
    a13 <> a9 &
    a13 <> a11 &
    a13 <> a12 &
    a14 <> a4 &
    a14 <> a3 &
    a14 <> a6 &
    a14 <> a7 &
    a14 <> a9 &
    a14 <> a10 &
    a14 <> a12 &
    a14 <> a13 &
    rega <= 0 &
    rega1 <= 0 &
    rega2 <= 0 &
    t in Linked &
    0 < ba1 &
    0 <= oa1 &
    oa1 + 4 <= ta1 &
    t1.a4 in Finite32 &
    t1.a6 in Finite32 &
    t1.a9 in Finite32 &
    t1.a12 in Finite32 &
    ba <> 0 &
    0 <= oa &
    oa + 4 <= ta &
    t1.a5 in Finite32 &
    t1.a8 in Finite32 &
    t1.a11 in Finite32 &
    t1.a14 in Finite32 &
    ba2 <> 0 &
    0 <= oa2 &
    oa2 + 4 <= ta2
  holds
    m3.a3 =
      -(m3.a8*m3.a6 + m3.a11*m3.a9 + m3.a14*m3.a12)
        + m3.a5*m3.a4 &
    m3.a7 =
      m3.a5*m3.a6 + m3.a4*m3.a8
        + (m3.a11*m3.a12 - m3.a14*m3.a9) &
    m3.a10 =
      m3.a5*m3.a9 + m3.a4*m3.a11
        + (m3.a14*m3.a6 - m3.a8*m3.a12) &
    m3.a13 =
      m3.a5*m3.a12 + m3.a4*m3.a14
        + (m3.a8*m3.a9 - m3.a11*m3.a6)
proof
end;
::$P+
