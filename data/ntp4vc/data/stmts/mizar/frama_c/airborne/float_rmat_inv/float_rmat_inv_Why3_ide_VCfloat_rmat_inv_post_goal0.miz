:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_rmat_inv/float_rmat_inv_Why3_ide_VCfloat_rmat_inv_post_goal0:
:: nine updates copy the transpose of a finite 3-by-3 real float matrix
:: between separated memory regions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,p0,p1,p2,p3,p4,p5,p6,p7,p8,
      q0,q1,q2,q3,q4,q5,q6,q7,q8 being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1,m,m1,m2,m3,m4,m5,m6,m7,m8
        being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Finite32 being Subset of REAL
  st
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    p0 = [ba,(oa + 0) + 0] &
    p1 = [ba,(oa + 0) + 1] &
    p2 = [ba,(oa + 0) + 2] &
    p3 = [ba,(oa + 0) + 3] &
    p4 = [ba,(oa + 0) + 4] &
    p5 = [ba,(oa + 0) + 5] &
    p6 = [ba,(oa + 0) + 6] &
    p7 = [ba,(oa + 0) + 7] &
    p8 = [ba,(oa + 0) + 8] &
    q0 = [ba1,(oa1 + 0) + 0] &
    q1 = [ba1,(oa1 + 0) + 1] &
    q2 = [ba1,(oa1 + 0) + 2] &
    q3 = [ba1,(oa1 + 0) + 3] &
    q4 = [ba1,(oa1 + 0) + 4] &
    q5 = [ba1,(oa1 + 0) + 5] &
    q6 = [ba1,(oa1 + 0) + 6] &
    q7 = [ba1,(oa1 + 0) + 7] &
    q8 = [ba1,(oa1 + 0) + 8] &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    (for x being Element of [:INT,INT:] holds
      (x = p0 implies m.x = t1.q0) &
      (x <> p0 implies m.x = t1.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p1 implies m1.x = m.q3) &
      (x <> p1 implies m1.x = m.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p2 implies m2.x = m1.q6) &
      (x <> p2 implies m2.x = m1.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p3 implies m3.x = m2.q1) &
      (x <> p3 implies m3.x = m2.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p4 implies m4.x = m3.q4) &
      (x <> p4 implies m4.x = m3.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p5 implies m5.x = m4.q7) &
      (x <> p5 implies m5.x = m4.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p6 implies m6.x = m5.q2) &
      (x <> p6 implies m6.x = m5.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p7 implies m7.x = m6.q5) &
      (x <> p7 implies m7.x = m6.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p8 implies m8.x = m7.q8) &
      (x <> p8 implies m8.x = m7.x)) &
    rega <= 0 &
    rega1 <= 0 &
    t in Linked &
    0 < ba &
    0 <= oa &
    oa + 9 <= ta &
    t1.q0 in Finite32 &
    t1.q1 in Finite32 &
    t1.q2 in Finite32 &
    t1.q3 in Finite32 &
    t1.q4 in Finite32 &
    t1.q5 in Finite32 &
    t1.q6 in Finite32 &
    t1.q7 in Finite32 &
    t1.q8 in Finite32 &
    ba1 <> 0 &
    0 <= oa1 &
    oa1 + 9 <= ta1 &
    (ba <> ba1 or oa1 + 9 <= oa or oa + 9 <= oa1)
  holds
    m8.p0 = m8.q0 &
    m8.p1 = m8.q3 &
    m8.p2 = m8.q6 &
    m8.p3 = m8.q1 &
    m8.p4 = m8.q4 &
    m8.p5 = m8.q7 &
    m8.p6 = m8.q2 &
    m8.p7 = m8.q5 &
    m8.p8 = m8.q8
proof
end;
::$P+
