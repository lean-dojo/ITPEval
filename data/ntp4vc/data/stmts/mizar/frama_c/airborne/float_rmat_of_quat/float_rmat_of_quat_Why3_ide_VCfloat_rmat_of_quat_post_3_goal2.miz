:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_rmat_of_quat/float_rmat_of_quat_Why3_ide_VCfloat_rmat_of_quat_post_3_goal2:
:: a unit real quaternion stored in valid memory is converted by nine updates
:: into a 3-by-3 real matrix with determinant one. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,p0,p1,p2,p3,p4,p5,p6,p7,p8,q0,q1,q2,q3
        being Element of [:INT,INT:],
      ba,oa,ba1,oa1,rega,rega1,ta,ta1 being Integer,
      t1,m,m1,m2,m3,m4,m5,m6,m7,m8
        being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL,
      r,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13 being Real
  st
    (for x being Real holds x in Float32 & x in Finite32) &
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    a2 = [ba,oa + 0] &
    p0 = [ba,(oa + 0) + 0] &
    p1 = [ba,(oa + 0) + 1] &
    p2 = [ba,(oa + 0) + 2] &
    p3 = [ba,(oa + 0) + 3] &
    p4 = [ba,(oa + 0) + 4] &
    p5 = [ba,(oa + 0) + 5] &
    p6 = [ba,(oa + 0) + 6] &
    p7 = [ba,(oa + 0) + 7] &
    p8 = [ba,(oa + 0) + 8] &
    q0 = [ba1,oa1 + 0] &
    q1 = [ba1,oa1 + 1] &
    q2 = [ba1,oa1 + 2] &
    q3 = [ba1,oa1 + 3] &
    rega = reg.ba &
    rega1 = reg.ba1 &
    ta = t.ba &
    ta1 = t.ba1 &
    r = t1.q0 &
    r1 = t1.q1 &
    r2 = t1.q2 &
    r3 = t1.q3 &
    r4 = 2*r &
    r5 = 2*r1 &
    r6 = 2*r3 &
    r7 = r4*r1 &
    r8 = r4*r2 &
    r9 = r4*r3 &
    r10 = r5*r2 &
    r11 = r5*r3 &
    r12 = r2*r6 &
    r13 = r4*r - 1 &
    (for x being Element of [:INT,INT:] holds
      (x = p0 implies m.x = r13 + r5*r1) &
      (x <> p0 implies m.x = t1.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p1 implies m1.x = r10 + r9) &
      (x <> p1 implies m1.x = m.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p2 implies m2.x = r11 - r8) &
      (x <> p2 implies m2.x = m1.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p3 implies m3.x = r10 - r9) &
      (x <> p3 implies m3.x = m2.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p4 implies m4.x = r13 + 2*r2*r2) &
      (x <> p4 implies m4.x = m3.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p5 implies m5.x = r12 + r7) &
      (x <> p5 implies m5.x = m4.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p6 implies m6.x = r11 + r8) &
      (x <> p6 implies m6.x = m5.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p7 implies m7.x = r12 - r7) &
      (x <> p7 implies m7.x = m6.x)) &
    (for x being Element of [:INT,INT:] holds
      (x = p8 implies m8.x = r13 + r6*r3) &
      (x <> p8 implies m8.x = m7.x)) &
    rega <= 0 &
    rega1 <= 0 &
    t in Linked &
    t1.q0*t1.q0 + t1.q1*t1.q1 + t1.q2*t1.q2 +
      t1.q3*t1.q3 = 1 &
    0 < ba &
    0 <= oa &
    oa + 9 <= ta &
    t1.q0 in Finite32 &
    t1.q1 in Finite32 &
    t1.q2 in Finite32 &
    t1.q3 in Finite32 &
    ba1 <> 0 &
    0 <= oa1 &
    oa1 + 4 <= ta1 &
    (ba <> ba1 or oa1 + 4 <= oa or oa + 9 <= oa1) &
    r in Float32 &
    r1 in Float32 &
    r2 in Float32 &
    r3 in Float32 &
    r4 in Float32 &
    r5 in Float32 &
    r6 in Float32 &
    r7 in Float32 &
    r8 in Float32 &
    r9 in Float32 &
    r10 in Float32 &
    r11 in Float32 &
    r12 in Float32 &
    r13 in Float32
  holds
    m8.p0*m8.p4*m8.p8 + m8.p1*m8.p5*m8.p6 +
      m8.p2*m8.p3*m8.p7 - m8.p0*m8.p5*m8.p7 -
      m8.p1*m8.p3*m8.p8 - m8.p2*m8.p4*m8.p6 = 1
proof
end;
::$P+
