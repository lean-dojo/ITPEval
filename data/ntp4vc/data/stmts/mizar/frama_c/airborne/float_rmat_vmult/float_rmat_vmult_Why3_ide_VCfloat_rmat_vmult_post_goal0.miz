:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/airborne/float_rmat_vmult/float_rmat_vmult_Why3_ide_VCfloat_rmat_vmult_post_goal0:
:: three sequential real-valued memory updates compute the product of a
:: 3-by-3 float matrix and a three-vector under the stated memory validity,
:: separation, and float-model assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1,
    XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a2,a,v0,v1,v2,b0,b1,b2,b3,b4,b5,b6,b7,b8,w0,w1,w2
        being Element of [:INT,INT:],
      ba1,oa1,ba2,oa2,ba,oa,
      rega1,rega2,rega,ta1,ta2,ta being Integer,
      t1,m,m1,m2 being Function of [:INT,INT:],REAL,
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Float32,Finite32 being Subset of REAL,
      r0,r1,r2,r3,r4,r5,r6,r7,r8,r9,r10,r11,r12,r13,r14,
      r15,r16,r17 being Real
  st
    (for x being Real holds x in Float32) &
    a1 = [ba1,oa1] &
    a2 = [ba2,oa2] &
    a = [ba,oa] &
    v0 = [ba1,oa1 + 0] &
    v1 = [ba1,oa1 + 1] &
    v2 = [ba1,oa1 + 2] &
    b0 = [ba2,(oa2 + 0) + 0] &
    b1 = [ba2,(oa2 + 0) + 1] &
    b2 = [ba2,(oa2 + 0) + 2] &
    b3 = [ba2,(oa2 + 0) + 3] &
    b4 = [ba2,(oa2 + 0) + 4] &
    b5 = [ba2,(oa2 + 0) + 5] &
    b6 = [ba2,(oa2 + 0) + 6] &
    b7 = [ba2,(oa2 + 0) + 7] &
    b8 = [ba2,(oa2 + 0) + 8] &
    w0 = [ba,oa + 0] &
    w1 = [ba,oa + 1] &
    w2 = [ba,oa + 2] &
    rega1 = reg.ba1 &
    rega2 = reg.ba2 &
    rega = reg.ba &
    ta1 = t.ba1 &
    ta2 = t.ba2 &
    ta = t.ba &
    r0 = t1.v0 &
    r1 = t1.v1 &
    r2 = t1.v2 &
    r3 = t1.b0 &
    r4 = t1.b1 &
    r5 = t1.b2 &
    (for x being Element of [:INT,INT:] holds
      (x = w0 implies m.x = r3*r0 + r4*r1 + r5*r2) &
      (x <> w0 implies m.x = t1.x)) &
    r6 = m.v0 &
    r7 = m.v1 &
    r8 = m.v2 &
    r9 = m.b3 &
    r10 = m.b4 &
    r11 = m.b5 &
    (for x being Element of [:INT,INT:] holds
      (x = w1 implies m1.x = r9*r6 + r10*r7 + r11*r8) &
      (x <> w1 implies m1.x = m.x)) &
    r12 = m1.v0 &
    r13 = m1.v1 &
    r14 = m1.v2 &
    r15 = m1.b6 &
    r16 = m1.b7 &
    r17 = m1.b8 &
    (for x being Element of [:INT,INT:] holds
      (x = w2 implies m2.x = r15*r12 + r16*r13 + r17*r14) &
      (x <> w2 implies m2.x = m1.x)) &
    rega <= 0 &
    rega1 <= 0 &
    rega2 <= 0 &
    t in Linked &
    0 < ba &
    0 <= oa &
    oa + 3 <= ta &
    t1.v0 in Finite32 &
    t1.v1 in Finite32 &
    t1.v2 in Finite32 &
    ba1 <> 0 &
    0 <= oa1 &
    oa1 + 3 <= ta1 &
    t1.b0 in Finite32 &
    t1.b1 in Finite32 &
    t1.b2 in Finite32 &
    t1.b3 in Finite32 &
    t1.b4 in Finite32 &
    t1.b5 in Finite32 &
    t1.b6 in Finite32 &
    t1.b7 in Finite32 &
    t1.b8 in Finite32 &
    ba2 <> 0 &
    0 <= oa2 &
    oa2 + 9 <= ta2 &
    (ba <> ba1 or oa1 + 3 <= oa or oa + 3 <= oa1) &
    (ba <> ba2 or oa2 + 9 <= oa or oa + 3 <= oa2) &
    (ba1 <> ba2 or oa2 + 9 <= oa1 or oa1 + 3 <= oa2) &
    r0 in Float32 &
    r1 in Float32 &
    r2 in Float32 &
    r3 in Float32 &
    r4 in Float32 &
    r5 in Float32 &
    r6 in Float32 &
    r7 in Float32 &
    r8 in Float32 &
    r9 in Float32 &
    r10 in Float32 &
    r11 in Float32 &
    r12 in Float32 &
    r13 in Float32 &
    r14 in Float32 &
    r15 in Float32 &
    r16 in Float32 &
    r17 in Float32
  holds
    m2.w0 = m2.b0*m2.v0 + m2.b1*m2.v1 + m2.b2*m2.v2 &
    m2.w1 = m2.b3*m2.v0 + m2.b4*m2.v1 + m2.b5*m2.v2 &
    m2.w2 = m2.b6*m2.v0 + m2.b7*m2.v1 + m2.b8*m2.v2
proof
end;
::$P+
