:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_complete_not_newly_idle_without_idle_no____goal0:
:: the should-we-balance verification condition classifies the scheduler state
:: by task presence, balance mode, idle CPUs, and idle cores under the stated
:: address, separation, memory-validity, framing, and integer-range assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a5,a6,a7 being Element of [:INT,INT:],
      t2,SchedGroupCpus,SchedGroupMask,GroupBalanceMask
        being Function of [:INT,INT:],[:INT,INT:],
      CpuSmtMask being Function of INT,[:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,IdleCpu being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,x,x1,x2,x3,lsize being Integer
  st
    (for b,o being Integer holds Base.[b,o] = b & Offset.[b,o] = o) &
    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p+k]) &
    (for p,q being Element of [:INT,INT:], m,n being Integer holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q+n <= Offset.p or Offset.p+m <= Offset.q) &
    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies Base.p <> 0 & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &
    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies 0 < Base.p & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),k]) <> 0) &

    x = t1.(shft.[a1,1]) &
    x1 = t1.(shft.[a1,3]) &
    a2 = t2.(shft.[a1,4]) &
    a3 = t2.(shft.[a1,0]) &
    x2 = t1.(shft.[a3,1]) &
    a4 = t2.(shft.[a3,0]) &
    a5 = t2.(shft.[a2,0]) &
    x3 = t1.(shft.[a5,x]) &
    a6 = shft.[a5,0] &
    a7 = t2.(shft.[GroupBalanceMask.a4,0]) &

    0 <= i & i < lsize &
    0 <= x & x < lsize &
    Region.(Base.a) <= 0 & Region.(Base.a1) <= 0 &
    (for p being Element of [:INT,INT:] holds
       Region.(Base.(t2.p)) <= 0) &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    [t,[a1,5]] in ValidRD &
    0 <= x1 & x1 < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= x & x < 2147483647 + 1 &
    [t,[a2,1]] in ValidRD &
    [t,[t2.(shft.[a1,2]),2]] in ValidRD &
    [t,[a3,2]] in ValidRD &
    -(2147483647)-1 <= x2 & x2 < 2147483647 + 1 &
    [t,[a4,1]] in ValidRD &
    0 <= x3 & x3 < 256 &
    [t,[a6,lsize]] in ValidRD &

    (for j being Integer st 0 <= j & j < lsize holds
       [a6,
        [lsize,
          [shft.[t2.(shft.[shft.[a,j],0]),0],lsize]]]
        in Sep) &
    (for j being Integer st 0 <= j & j < lsize holds
       [t,[shft.[a,j],1]] in ValidRD &
       [t,[shft.[t2.(shft.[shft.[a,j],0]),0],lsize]]
         in ValidRW) &
    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupCpus.p,1]] in ValidRD &
       [t,[shft.[t2.(shft.[SchedGroupCpus.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t2.(shft.[SchedGroupCpus.p,0]),0],
          [lsize,
            [shft.[t2.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &
    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupMask.p,1]] in ValidRD &
       [t,[shft.[t2.(shft.[SchedGroupMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t2.(shft.[SchedGroupMask.p,0]),0],
          [lsize,
            [shft.[t2.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &
    (for p being Element of [:INT,INT:] holds
       [t,[GroupBalanceMask.p,1]] in ValidRD &
       [t,[shft.[t2.(shft.[GroupBalanceMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t2.(shft.[GroupBalanceMask.p,0]),0],
          [lsize,
            [shft.[t2.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &
    (for j being Integer st 0 <= j & j < lsize holds
       [t,[CpuSmtMask.j,1]] in ValidRD &
       [t,[shft.[t2.(shft.[CpuSmtMask.j,0]),0],lsize]]
         in ValidRD &
       (for k being Integer st 0 <= k & k < lsize holds
         [shft.[t2.(shft.[CpuSmtMask.j,0]),0],
          [lsize,
            [shft.[t2.(shft.[shft.[a,k],0]),0],lsize]]]
          in Sep))
  holds
    x3 = 0 or
    (x1 = 2 & x3 <> 0) or
    (x1 <> 2 & x3 <> 0 &
      (for j being Integer st
         t1.(shft.[a5,j]) <> 0 &
         t1.(shft.[a7,j]) <> 0 &
         0 <= j & j < lsize
       holds IdleCpu.j = 0)) or
    (x1 <> 2 &
      (ex q being Integer st x2 = 8*q) &
      x3 <> 0 &
      (ex j being Integer st
         t1.(shft.[a5,j]) <> 0 &
         t1.(shft.[a7,j]) <> 0 &
         0 <= j & j < lsize &
         (for k being Integer st
            t1.(shft.[t2.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
            0 <= k & k < lsize
          holds IdleCpu.k <> 0))) or
    (x1 <> 2 &
      (not ex q being Integer st x2 = 8*q) &
      x3 <> 0 &
      (ex j being Integer st
         IdleCpu.j <> 0 &
         t1.(shft.[a5,j]) <> 0 &
         t1.(shft.[a7,j]) <> 0 &
         0 <= j & j < lsize)) or
    (x1 <> 2 &
      (ex q being Integer st x2 = 8*q) &
      x3 <> 0 &
      (for j being Integer st
         t1.(shft.[a5,j]) <> 0 &
         t1.(shft.[a7,j]) <> 0 &
         0 <= j & j < lsize
       holds
         not (for k being Integer st
           t1.(shft.[t2.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
           0 <= k & k < lsize
         holds IdleCpu.k <> 0)) &
      (ex j being Integer st
         IdleCpu.j <> 0 &
         t1.(shft.[a5,j]) <> 0 &
         t1.(shft.[a7,j]) <> 0 &
         0 <= j & j < lsize))
proof
end;
::$P+
