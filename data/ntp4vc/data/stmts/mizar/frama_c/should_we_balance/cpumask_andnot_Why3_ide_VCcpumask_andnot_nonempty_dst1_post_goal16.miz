:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/cpumask_andnot_Why3_ide_VCcpumask_andnot_nonempty_dst1_post_goal16:
:: the cpumask-andnot verification condition states that the output mask is
:: nonzero at the selected destination index exactly when the corresponding
:: first input is zero and second input is nonzero, under the stated address,
:: havoc, separation, framing, integer-range, and memory-validity assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,a6,a7,a8 being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2,a9 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      CpuMask being Function of INT,[:INT,INT:],
      IdleCpu being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,i1,lsize being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),k]) <> 0) &

    a3 = t3.(shft.[a,0]) &
    a4 = shft.[a3,0] &
    a5 = t3.(shft.[a1,0]) &
    a6 = shft.[a5,0] &
    a7 = t3.(shft.[a2,0]) &
    a8 = shft.[a7,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a8,lsize]]] in Sep implies a9.q = t2.q) &
       (not [q,[1,[a8,lsize]]] in Sep implies
         a9.q = t1.q)) &

    a2 <> [0,0] &
    ToUint32.i = lsize &
    0 <= i &
    0 <= i1 &
    i1 < lsize &
    i <= lsize &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    reg.(Base.a2) <= 0 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i &
    i < 2147483647 + 1 &
    [t,[a,1]] in ValidRD &
    [t,[a1,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    [t,[a4,lsize]] in ValidRD &
    [t,[a6,lsize]] in ValidRD &
    [t,[a8,lsize]] in ValidRW &

    (a2 <> a implies
       [a8,[lsize,[a4,lsize]]] in Sep) &

    (a2 <> a1 implies
       [a8,[lsize,[a6,lsize]]] in Sep) &

    (for i2 being Integer st 0 <= i2 & i2 < lsize holds
       [a8,[lsize,
         [shft.[t3.(shft.[CpuMask.i2,0]),0],lsize]]]
         in Sep) &

    (for i2 being Integer st i <= i2 & i2 < lsize holds
       (a9.(shft.[a7,i2]) <> 0 iff
        t2.(shft.[a7,i2]) <> 0)) &

    (for i2 being Integer st 0 <= i2 & i2 < i holds
       (t2.(shft.[a3,i2]) = 0 &
        t2.(shft.[a5,i2]) <> 0 iff
        a9.(shft.[a7,i2]) <> 0))
  holds
    (t2.(shft.[a3,i1]) = 0 &
     t2.(shft.[a5,i1]) <> 0 iff
     a9.(shft.[a7,i1]) <> 0)
proof
end;
::$P+
