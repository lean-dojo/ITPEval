:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_loop_inv_i2_preserved_goal18:
:: the should-we-balance loop-invariant preservation verification condition
:: concludes that the selected CPU is idle under the stated scheduler-mask,
:: havoc-updated memory, address, separation, validity, framing, linkage, and
:: C integer-range assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a13,a14,a15,
      a16,a17,a18,a19,a20,a22,a23,a26
        being Element of [:INT,INT:],
      t4,GroupBalanceMask,SchedGroupCpus,SchedGroupMask
        being Function of [:INT,INT:],[:INT,INT:],
      CpuSmtMask being Function of INT,[:INT,INT:],
      t1,t2,t3,a12,a21 being Function of [:INT,INT:],INT,
      t,Region,IdleCpu,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,i1,i2,i3,x,x1,x2,x3,a24,a25,lsize being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p+k]) &

    (for p,q being Element of [:INT,INT:], m,n being Integer holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q+n <= Offset.p or Offset.p+m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),k]) <> 0) &

    a2 = shft.[a1,3] &
    x = t3.a2 &
    a3 = shft.[a1,4] &
    a4 = t4.a3 &
    a5 = shft.[a4,0] &
    a6 = t4.a5 &
    a7 = shft.[a1,1] &
    x1 = t3.a7 &
    x2 = t3.(shft.[a6,x1]) &
    a8 = shft.[a,i] &
    a9 = shft.[a8,0] &
    a10 = t4.a9 &
    a11 = shft.[a10,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a11,lsize]]] in Sep implies a12.q = t3.q) &
       (not [q,[1,[a11,lsize]]] in Sep implies a12.q = t2.q)) &

    a13 = shft.[a1,0] &
    a14 = t4.a13 &
    a15 = shft.[a14,0] &
    a16 = t4.a15 &
    a17 = GroupBalanceMask.a16 &
    a18 = t4.(shft.[a17,0]) &
    a19 = shft.[a14,1] &
    a20 = shft.[a6,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a11,lsize]]] in Sep implies a21.q = t3.q) &
       (not [q,[1,[a11,lsize]]] in Sep implies a21.q = t1.q)) &

    a22 = shft.[a6,-(1)] &
    a23 = shft.[a18,-(1)] &
    a24 = a12.(shft.[a10,i2]) &
    a25 = a12.(shft.[a6,i2]) &
    a26 = shft.[a18,0] &
    x3 = ToUint32.i3 &

    IdleCpu.i2 = 0 &
    x <> 2 &
    x2 <> 0 &
    a12.(shft.[a6,i1]) <> 0 &
    a12.(shft.[a18,i1]) <> 0 &
    0 <= i &
    i < lsize &
    0 <= i1 &
    i1 < lsize &
    0 <= i2 &
    i1 <= i2 &
    i2 < lsize &
    0 <= i3 &
    i3 <= lsize &
    (ex u being Integer st
       u = ToUint32.i2 &
       u < lsize) &
    0 <= x1 &
    x1 < lsize &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    i2 <= 2147483646 &
    (for p being Element of [:INT,INT:] holds
       Region.(Base.(t4.p)) <= 0) &
    t in Linked &
    0 <= i &
    i < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= i2 &
    i2 < 2147483647 + 1 &
    -(2147483647)-1 <= i3 &
    i3 < 2147483647 + 1 &
    [t,[a1,5]] in ValidRD &
    0 <= x &
    x < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= 1+i2 &
    1+i2 < 2147483647 + 1 &
    -(2147483647)-1 <= x1 &
    x1 < 2147483647 + 1 &
    [t,[a3,1]] in ValidRD &
    [t,[a7,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    [t,[a13,1]] in ValidRD &
    [t,[a8,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    [t,[t4.(shft.[a1,2]),2]] in ValidRD &
    [t,[a14,2]] in ValidRD &
    -(2147483647)-1 <= t3.a19 &
    t3.a19 < 2147483647 + 1 &
    [t,[a9,1]] in ValidRD &
    [t,[a5,1]] in ValidRD &
    [t,[a15,1]] in ValidRD &
    [t,[a16,1]] in ValidRD &
    [t,[a17,1]] in ValidRD &
    0 <= x2 &
    x2 < 256 &
    [t,[a11,lsize]] in ValidRD &
    [t,[a20,lsize]] in ValidRD &
    [t,[a11,lsize]] in ValidRW &
    0 <= a21.a22 &
    a21.a22 < 256 &
    0 <= a21.a23 &
    a21.a23 < 256 &
    0 <= a24 &
    a24 < 256 &
    0 <= a12.a22 &
    a12.a22 < 256 &
    0 <= a25 &
    a25 < 256 &
    0 <= a12.a23 &
    a12.a23 < 256 &
    -(2147483647)-1 <= a21.a19 &
    a21.a19 < 2147483647 + 1 &
    -(2147483647)-1 <= a12.a19 &
    a12.a19 < 2147483647 + 1 &
    [t,[a26,lsize]] in ValidRD &
    [a11,[lsize,[a26,lsize]]] in Sep &

    ((ex j being Integer st
       a12.(shft.[a10,j]) <> 0 &
       a12.(shft.[a6,j]) <> 0 &
       j < lsize &
       x3 <= j)
     implies
       x3 <= i2) &

    ((ex j being Integer st
       a12.(shft.[a10,j]) <> 0 &
       a12.(shft.[a6,j]) <> 0 &
       j < lsize &
       x3 <= j)
     implies
       a24 <> 0 & a25 <> 0) &

    ((for j being Integer st
       j < lsize &
       x3 <= j
     holds
       a12.(shft.[a10,j]) = 0 or
       a12.(shft.[a6,j]) = 0)
     implies
       lsize = i2) &

    ((ex j being Integer st
       a12.(shft.[a10,j]) <> 0 &
       a12.(shft.[a6,j]) <> 0 &
       j < lsize &
       x3 <= j)
     implies
       (for j being Integer st
          j < i2 &
          x3 <= j
        holds
          a12.(shft.[a10,j]) = 0 or
          a12.(shft.[a6,j]) = 0)) &

    (for j being Integer st
       0 <= j & j < lsize
     holds
       [a20,[lsize,
        [shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]] in Sep) &

    (for j being Integer st
       0 <= j & j < lsize
     holds
       [t,[shft.[a,j],1]] in ValidRD &
       [t,[shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]
         in ValidRW) &

    (for j being Integer st
       0 <= j & j < lsize
     holds
       (a21.(shft.[a18,j]) <> 0 iff
        a21.(shft.[a10,j]) <> 0)) &

    (for j being Integer st
       a12.(shft.[a18,j]) <> 0 &
       0 <= j &
       j < lsize
     holds
       a12.(shft.[a10,j]) <> 0) &

    (for j being Integer st
       a12.(shft.[a10,j]) <> 0 &
       0 <= j &
       j < lsize
     holds
       a12.(shft.[a18,j]) <> 0) &

    (for j being Integer st
       a12.(shft.[a6,j]) <> 0 &
       a12.(shft.[a18,j]) <> 0 &
       0 <= j &
       j < i3 &
       j < lsize
     holds
       IdleCpu.j = 0) &

    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupCpus.p,1]] in ValidRD &
       [t,[shft.[t4.(shft.[SchedGroupCpus.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st
          0 <= j & j < lsize
        holds
          [shft.[t4.(shft.[SchedGroupCpus.p,0]),0],
           [lsize,
            [shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]]
            in Sep)) &

    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupMask.p,1]] in ValidRD &
       [t,[shft.[t4.(shft.[SchedGroupMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st
          0 <= j & j < lsize
        holds
          [shft.[t4.(shft.[SchedGroupMask.p,0]),0],
           [lsize,
            [shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]]
            in Sep)) &

    (for p being Element of [:INT,INT:] holds
       [t,[GroupBalanceMask.p,1]] in ValidRD &
       [t,[shft.[t4.(shft.[GroupBalanceMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st
          0 <= j & j < lsize
        holds
          [shft.[t4.(shft.[GroupBalanceMask.p,0]),0],
           [lsize,
            [shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]]
            in Sep)) &

    (for j being Integer st
       0 <= j & j < lsize
     holds
       [t,[CpuSmtMask.j,1]] in ValidRD &
       [t,[shft.[t4.(shft.[CpuSmtMask.j,0]),0],lsize]]
         in ValidRD &
       (for k being Integer st
          0 <= k & k < lsize
        holds
          [shft.[t4.(shft.[CpuSmtMask.j,0]),0],
           [lsize,
            [shft.[t4.(shft.[shft.[a,k],0]),0],lsize]]]
            in Sep))
  holds
    IdleCpu.i1 = 0
proof
end;
::$P+
