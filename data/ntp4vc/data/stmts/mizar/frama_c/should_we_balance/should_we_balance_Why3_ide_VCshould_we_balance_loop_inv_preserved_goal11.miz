:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_loop_inv_preserved_goal11:
:: the should-we-balance loop-invariant preservation verification condition
:: concludes that the current CPU-loop index is at least -1 under the stated
:: scheduler-mask, havoc-updated memory, address, separation, validity,
:: framing, linkage, Boolean-branch, and C integer-range assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14,
      a15,a16,a17,a18,a19,a20,a21,a23,a30
        being Element of [:INT,INT:],
      t5,GroupBalanceMask,SchedGroupCpus,SchedGroupMask
        being Function of [:INT,INT:],[:INT,INT:],
      CpuSmtMask being Function of INT,[:INT,INT:],
      t1,t2,t3,t4,a22,a24 being Function of [:INT,INT:],INT,
      t,Region,IdleCpu,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      p being Element of BOOLEAN,
      i,i1,i2,i3,i4,x,x1,x2,x3,x4,x5,
      a25,a26,a27,a28,a29,lsize being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for q being Element of [:INT,INT:], k being Integer holds
       shft.[q,k] = [Base.q,Offset.q+k]) &

    (for q,r being Element of [:INT,INT:], m,n being Integer holds
       [q,[m,[r,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.q <> Base.r or
       Offset.r+n <= Offset.q or Offset.q+m <= Offset.r) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:], n being Integer holds
       [malloc,[q,n]] in ValidRD iff
       (0 < n implies
         Base.q <> 0 & 0 <= Offset.q &
         Offset.q+n <= malloc.(Base.q))) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:], n being Integer holds
       [malloc,[q,n]] in ValidRW iff
       (0 < n implies
         0 < Base.q & 0 <= Offset.q &
         Offset.q+n <= malloc.(Base.q))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),k]) <> 0) &

    x = IdleCpu.i3 &
    a3 = shft.[a1,3] &
    x1 = t3.a3 &
    a4 = shft.[a1,4] &
    a5 = t5.a4 &
    a6 = shft.[a5,0] &
    a7 = t5.a6 &
    a8 = shft.[a1,1] &
    x2 = t3.a8 &
    x3 = t3.(shft.[a7,x2]) &
    a9 = shft.[a1,0] &
    a10 = shft.[a,i] &
    a11 = t5.a9 &
    a12 = shft.[a11,1] &
    a13 = shft.[a2,0] &
    a14 = shft.[t5.a13,1] &
    x4 = t4.a14 &
    a15 = shft.[a10,0] &
    a16 = shft.[a11,0] &
    a17 = t5.a16 &
    a18 = GroupBalanceMask.a17 &
    a19 = t5.a15 &
    a20 = shft.[a19,0] &
    a21 = shft.[a7,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a20,lsize]]] in Sep implies a22.q = t3.q) &
       (not [q,[1,[a20,lsize]]] in Sep implies a22.q = t1.q)) &

    a23 = t5.(shft.[a18,0]) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a20,lsize]]] in Sep implies a24.q = t3.q) &
       (not [q,[1,[a20,lsize]]] in Sep implies a24.q = t2.q)) &

    a25 = a24.(shft.[a19,i3]) &
    a26 = a24.(shft.[a7,i1]) &
    a27 = a24.(shft.[a7,i3]) &
    a28 = a24.(shft.[a23,i1]) &
    a29 = a24.a12 &
    a30 = shft.[a23,0] &
    x5 = ToUint32.i4 &

    (x <> 0 iff i2 <> 0) &
    x1 <> 2 &
    x3 <> 0 &
    0 <= i &
    i < lsize &
    0 <= i3 &
    i3 < lsize &
    0 <= i4 &
    i4 <= lsize &
    (ex u being Integer st
       u = ToUint32.i3 &
       u < lsize) &
    0 <= x2 &
    x2 < lsize &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    (for q being Element of [:INT,INT:] holds
       Region.(Base.(t5.q)) <= 0) &
    t in Linked &
    0 <= i2 &
    i2 < 256 &
    0 <= i &
    i < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= i1 &
    i1 < 2147483647 + 1 &
    -(2147483647)-1 <= i3 &
    i3 < 2147483647 + 1 &
    -(2147483647)-1 <= i4 &
    i4 < 2147483647 + 1 &
    [t,[a1,5]] in ValidRD &
    0 <= x1 &
    x1 < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= 1+i3 &
    1+i3 < 2147483647 + 1 &
    -(2147483647)-1 <= x2 &
    x2 < 2147483647 + 1 &
    [t,[a4,1]] in ValidRD &
    [t,[a8,1]] in ValidRD &
    [t,[a3,1]] in ValidRD &
    [t,[a9,1]] in ValidRD &
    [t,[a10,1]] in ValidRD &
    [t,[a5,1]] in ValidRD &
    [t,[t5.(shft.[a1,2]),2]] in ValidRD &
    [t,[a11,2]] in ValidRD &
    -(2147483647)-1 <= t3.a12 &
    t3.a12 < 2147483647 + 1 &
    -(2147483647)-1 <= x4 &
    x4 < 2147483647 + 1 &
    [t,[a15,1]] in ValidRD &
    [t,[a6,1]] in ValidRD &
    [t,[a16,1]] in ValidRD &
    [t,[a17,1]] in ValidRD &
    [t,[a18,1]] in ValidRD &
    0 <= x3 &
    x3 < 256 &
    [t,[a20,lsize]] in ValidRD &
    [t,[a21,lsize]] in ValidRD &
    [t,[a20,lsize]] in ValidRW &
    (ex u being Integer st
       u = a22.(shft.[a7,-(1)]) &
       0 <= u &
       u < 256) &
    (ex u being Integer st
       u = a22.(shft.[a23,-(1)]) &
       0 <= u &
       u < 256) &
    0 <= a25 &
    a25 < 256 &
    0 <= a26 &
    a26 < 256 &
    0 <= a27 &
    a27 < 256 &
    0 <= a28 &
    a28 < 256 &
    -(2147483647)-1 <= a22.a12 &
    a22.a12 < 2147483647 + 1 &
    -(2147483647)-1 <= a29 &
    a29 < 2147483647 + 1 &
    [t,[a30,lsize]] in ValidRD &
    [a20,[lsize,[a30,lsize]]] in Sep &

    (i2 = 0 implies
       i3 <= 2147483646) &

    (i2 <> 0 implies
       p = FALSE &
       a2 = a1 &
       x <> 0 &
       (ex q being Integer st x4 = 8*q) &
       a24 = t4 &
       i3 <= 2147483646 &
       not (for k being Integer st
         t4.(shft.[t5.(shft.[CpuSmtMask.i3,0]),k]) <> 0 &
         0 <= k &
         k < lsize
       holds
         IdleCpu.k <> 0) &
       [t,[a13,1]] in ValidRD &
       [t,[a14,1]] in ValidRD) &

    ((not ex q being Integer st a29 = 8*q) implies
       i1 = -1) &

    (i1 <> -1 implies
       IdleCpu.i1 <> 0 &
       a26 <> 0 &
       a28 <> 0 &
       0 <= i1 &
       i1 < lsize) &

    (i1 = -1 implies
       for j being Integer st
         a24.(shft.[a23,j]) <> 0 &
         0 <= j &
         j < lsize
       holds
         a24.(shft.[a19,j]) <> 0) &

    ((ex j being Integer st
       a24.(shft.[a19,j]) <> 0 &
       a24.(shft.[a7,j]) <> 0 &
       j < lsize &
       x5 <= j)
     implies
       x5 <= i3) &

    ((ex j being Integer st
       a24.(shft.[a19,j]) <> 0 &
       a24.(shft.[a7,j]) <> 0 &
       j < lsize &
       x5 <= j)
     implies
       a25 <> 0 &
       a27 <> 0) &

    ((for j being Integer st
       j < lsize &
       x5 <= j
     holds
       a24.(shft.[a19,j]) = 0 or
       a24.(shft.[a7,j]) = 0)
     implies
       lsize = i3) &

    (i1 <> -1 implies
       for j being Integer st
         a24.(shft.[a7,j]) <> 0 &
         a24.(shft.[a23,j]) <> 0 &
         0 <= j &
         j < i1 &
         j < lsize
       holds
         IdleCpu.j = 0) &

    (i1 = -1 implies
       for j being Integer st
         a24.(shft.[a7,j]) <> 0 &
         a24.(shft.[a23,j]) <> 0 &
         0 <= j &
         j < i4 &
         j < lsize
       holds
         IdleCpu.j = 0) &

    ((ex j being Integer st
       a24.(shft.[a19,j]) <> 0 &
       a24.(shft.[a7,j]) <> 0 &
       j < lsize &
       x5 <= j)
     implies
       (for j being Integer st
          j < i3 &
          x5 <= j
        holds
          a24.(shft.[a19,j]) = 0 or
          a24.(shft.[a7,j]) = 0)) &

    (i1 <> -1 implies
       for j being Integer st
         a24.(shft.[a7,j]) <> 0 &
         a24.(shft.[a23,j]) <> 0 &
         0 <= j &
         i1 <= j &
         j < i4 &
         j < lsize
       holds
         not (for k being Integer st
           a24.(shft.[t5.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
           0 <= k &
           k < lsize
         holds
           IdleCpu.k <> 0)) &

    (i1 <> -1 implies
       for j being Integer st
         a24.(shft.[a23,j]) <> 0 &
         0 <= j &
         j < lsize
       holds
         a24.(shft.[a19,j]) <> 0 or
         not (for k being Integer st
           a24.(shft.[t5.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
           0 <= k &
           k < lsize
         holds
           IdleCpu.k <> 0)) &

    (i2 = 0 or i2 = 1) &

    (for j being Integer st
       0 <= j &
       j < lsize
     holds
       [a21,[lsize,
        [shft.[t5.(shft.[shft.[a,j],0]),0],lsize]]] in Sep) &

    (for j being Integer st
       0 <= j &
       j < lsize
     holds
       [t,[shft.[a,j],1]] in ValidRD &
       [t,[shft.[t5.(shft.[shft.[a,j],0]),0],lsize]]
         in ValidRW) &

    (for j being Integer st
       0 <= j &
       j < lsize
     holds
       (a22.(shft.[a23,j]) <> 0 iff
        a22.(shft.[a19,j]) <> 0)) &

    (for j being Integer st
       a24.(shft.[a19,j]) <> 0 &
       0 <= j &
       j < lsize
     holds
       a24.(shft.[a23,j]) <> 0) &

    (for q being Element of [:INT,INT:] holds
       [t,[SchedGroupCpus.q,1]] in ValidRD &
       [t,[shft.[t5.(shft.[SchedGroupCpus.q,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st
          0 <= j &
          j < lsize
        holds
          [shft.[t5.(shft.[SchedGroupCpus.q,0]),0],
           [lsize,
            [shft.[t5.(shft.[shft.[a,j],0]),0],lsize]]]
            in Sep)) &

    (for q being Element of [:INT,INT:] holds
       [t,[SchedGroupMask.q,1]] in ValidRD &
       [t,[shft.[t5.(shft.[SchedGroupMask.q,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st
          0 <= j &
          j < lsize
        holds
          [shft.[t5.(shft.[SchedGroupMask.q,0]),0],
           [lsize,
            [shft.[t5.(shft.[shft.[a,j],0]),0],lsize]]]
            in Sep)) &

    (for q being Element of [:INT,INT:] holds
       [t,[GroupBalanceMask.q,1]] in ValidRD &
       [t,[shft.[t5.(shft.[GroupBalanceMask.q,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st
          0 <= j &
          j < lsize
        holds
          [shft.[t5.(shft.[GroupBalanceMask.q,0]),0],
           [lsize,
            [shft.[t5.(shft.[shft.[a,j],0]),0],lsize]]]
            in Sep)) &

    (for j being Integer st
       0 <= j &
       j < lsize
     holds
       [t,[CpuSmtMask.j,1]] in ValidRD &
       [t,[shft.[t5.(shft.[CpuSmtMask.j,0]),0],lsize]]
         in ValidRD &
       (for k being Integer st
          0 <= k &
          k < lsize
        holds
          [shft.[t5.(shft.[CpuSmtMask.j,0]),0],
           [lsize,
            [shft.[t5.(shft.[shft.[a,k],0]),0],lsize]]]
            in Sep))
  holds
    -1 <= i3
proof
end;
::$P+
