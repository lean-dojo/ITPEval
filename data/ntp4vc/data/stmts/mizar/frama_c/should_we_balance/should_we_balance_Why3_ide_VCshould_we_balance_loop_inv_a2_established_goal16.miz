:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_loop_inv_a2_established_goal16:
:: the should-we-balance verification condition establishes that a selected
:: entry remains nonzero across the havoc-updated scheduler-mask views, under
:: the stated address, separation, memory-validity, framing, linkage, and C
:: integer-range assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a5,a6,a7,a8,a9,a11,a12,a13,a14,a15,
      a16,a17,a18 being Element of [:INT,INT:],
      t3,GroupBalanceMask,SchedGroupCpus,SchedGroupMask
        being Function of [:INT,INT:],[:INT,INT:],
      CpuSmtMask being Function of INT,[:INT,INT:],
      t1,t2,a10 being Function of [:INT,INT:],INT,
      t,Region being Function of INT,INT,
      IdleCpu being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,i1,x,x1,x2,x3,lsize being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p+k]) &

    (for p,q being Element of [:INT,INT:], m,n being Integer holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q+n <= Offset.p or Offset.p+m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),k]) <> 0) &


    a2 = shft.[a1,3] &
    x = t2.a2 &
    a3 = shft.[a1,4] &
    a4 = t3.a3 &
    a5 = t3.(shft.[a4,0]) &
    a6 = shft.[a1,1] &
    x1 = t2.a6 &
    x2 = t2.(shft.[a5,x1]) &
    a7 = shft.[a,i] &
    a8 = t3.(shft.[a7,0]) &
    a9 = shft.[a8,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a9,lsize]]] in Sep implies a10.q = t2.q) &
       (not [q,[1,[a9,lsize]]] in Sep implies a10.q = t1.q)) &

    a11 = shft.[a1,0] &
    a12 = t3.a11 &
    a13 = shft.[a12,0] &
    a14 = t3.a13 &
    a15 = GroupBalanceMask.a14 &
    a16 = t3.(shft.[a15,0]) &
    a17 = shft.[a5,0] &
    a18 = shft.[a16,0] &
    x3 = t2.(shft.[a12,1]) &

    x <> 2 &
    x2 <> 0 &
    a10.(shft.[a16,i1]) <> 0 &
    0 <= i & i < lsize &
    0 <= i1 & i1 < lsize &
    0 <= x1 & x1 < lsize &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    (for p being Element of [:INT,INT:] holds
       Region.(Base.(t3.p)) <= 0) &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    [t,[a1,5]] in ValidRD &
    0 <= x & x < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= x1 & x1 < 2147483647 + 1 &
    [t,[a3,1]] in ValidRD &
    [t,[a6,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    [t,[a11,1]] in ValidRD &
    [t,[a7,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    [t,[t3.(shft.[a1,2]),2]] in ValidRD &
    [t,[a12,2]] in ValidRD &
    -(2147483647)-1 <= x3 & x3 < 2147483647 + 1 &
    [t,[a13,1]] in ValidRD &
    [t,[a14,1]] in ValidRD &
    [t,[a15,1]] in ValidRD &
    0 <= x2 & x2 < 256 &
    [t,[a17,lsize]] in ValidRD &
    [t,[a9,lsize]] in ValidRW &
    [t,[a18,lsize]] in ValidRD &
    [a9,[lsize,[a18,lsize]]] in Sep &

    (for j being Integer st 0 <= j & j < lsize holds
       [a17,[lsize,
         [shft.[t3.(shft.[shft.[a,j],0]),0],lsize]]] in Sep) &

    (for j being Integer st 0 <= j & j < lsize holds
       [t,[shft.[a,j],1]] in ValidRD &
       [t,[shft.[t3.(shft.[shft.[a,j],0]),0],lsize]]
         in ValidRW) &

    (for j being Integer st 0 <= j & j < lsize holds
       (a10.(shft.[a16,j]) <> 0 iff
        a10.(shft.[a8,j]) <> 0)) &

    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupCpus.p,1]] in ValidRD &
       [t,[shft.[t3.(shft.[SchedGroupCpus.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t3.(shft.[SchedGroupCpus.p,0]),0],
          [lsize,[shft.[t3.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &

    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupMask.p,1]] in ValidRD &
       [t,[shft.[t3.(shft.[SchedGroupMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t3.(shft.[SchedGroupMask.p,0]),0],
          [lsize,[shft.[t3.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &

    (for p being Element of [:INT,INT:] holds
       [t,[GroupBalanceMask.p,1]] in ValidRD &
       [t,[shft.[t3.(shft.[GroupBalanceMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t3.(shft.[GroupBalanceMask.p,0]),0],
          [lsize,[shft.[t3.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &

    (for j being Integer st 0 <= j & j < lsize holds
       [t,[CpuSmtMask.j,1]] in ValidRD &
       [t,[shft.[t3.(shft.[CpuSmtMask.j,0]),0],lsize]]
         in ValidRD &
       (for k being Integer st 0 <= k & k < lsize holds
         [shft.[t3.(shft.[CpuSmtMask.j,0]),0],
          [lsize,[shft.[t3.(shft.[shft.[a,k],0]),0],lsize]]]
          in Sep))
  holds
    a10.(shft.[a8,i1]) <> 0
proof
end;
::$P+
