:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/cpumask_andnot_Why3_ide_VCcpumask_andnot_assert_rte_signed_overflow_goal14:
:: the cpumask-andnot verification condition combines address, havoc,
:: separation, memory-validity, framing, and C integer-range assumptions to
:: require the signed 32-bit increment bound. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a2,a,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12,a14
        being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2,a13 being Function of [:INT,INT:],INT,
      t,reg,ToUint32,IdleCpu being Function of INT,INT,
      CpuMask being Function of INT,[:INT,INT:],
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,a15,a16,lsize being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),k]) <> 0) &

    a3 = shft.[a1,0] &
    a4 = shft.[a2,0] &
    a5 = shft.[a,0] &
    a6 = t3.a5 &
    a7 = shft.[a6,0] &
    a8 = t3.a3 &
    a9 = shft.[a8,0] &
    a10 = shft.[a8,i] &
    a11 = t3.a4 &
    a12 = shft.[a11,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a12,lsize]]] in Sep implies a13.q = t2.q) &
       (not [q,[1,[a12,lsize]]] in Sep implies
         a13.q = t1.q)) &

    a14 = shft.[a6,i] &
    a15 = a13.a14 &
    a16 = a13.a10 &

    a2 <> [0,0] &
    ToUint32.i <> lsize &
    0 <= i &
    i <= lsize &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    reg.(Base.a2) <= 0 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i &
    i < 2147483647 + 1 &
    [t,[a,1]] in ValidRD &
    [t,[a1,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    [t,[a3,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    [t,[a7,lsize]] in ValidRD &
    [t,[a9,lsize]] in ValidRD &
    [t,[a10,1]] in ValidRD &
    [t,[a12,lsize]] in ValidRW &
    [t,[shft.[a11,i],1]] in ValidRW &
    0 <= a15 & a15 < 256 &
    0 <= a16 & a16 < 256 &

    (a2 <> a implies
       [a12,[lsize,[a7,lsize]]] in Sep) &

    (a2 <> a1 implies
       [a12,[lsize,[a9,lsize]]] in Sep) &

    (a16 = 0 or a16 = 1) &

    (a16 = 0 or
       ([t,[a5,1]] in ValidRD &
        [t,[a14,1]] in ValidRD &
        (a15 = 0 or a15 = 1))) &

    (for i1 being Integer st 0 <= i1 & i1 < lsize holds
       [a12,[lsize,
         [shft.[t3.(shft.[CpuMask.i1,0]),0],lsize]]]
         in Sep) &

    (for i1 being Integer st i <= i1 & i1 < lsize holds
       (a13.(shft.[a11,i1]) <> 0 iff
        t2.(shft.[a11,i1]) <> 0)) &

    (for i1 being Integer st 0 <= i1 & i1 < i holds
       (t2.(shft.[a6,i1]) = 0 &
        t2.(shft.[a8,i1]) <> 0 iff
        a13.(shft.[a11,i1]) <> 0))
  holds
    i <= 2147483646
proof
end;
::$P+
