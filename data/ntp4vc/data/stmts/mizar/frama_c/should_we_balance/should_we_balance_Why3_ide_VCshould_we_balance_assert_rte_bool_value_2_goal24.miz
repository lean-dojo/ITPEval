:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/should_we_balance_Why3_ide_VCshould_we_balance_assert_rte_bool_value_2_goal24:
:: the should-we-balance verification condition requires a C Boolean result
:: to be exactly zero or one under the stated scheduler-mask, address, havoc,
:: separation, memory-validity, and integer-range assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14,a15,
      a16,a17,a18,a20,a27,am1,am2 being Element of [:INT,INT:],
      t4,GroupBalanceMask,SchedGroupCpus,SchedGroupMask
        being Function of [:INT,INT:],[:INT,INT:],
      CpuSmtMask being Function of INT,[:INT,INT:],
      t1,t2,t3,a19,a21 being Function of [:INT,INT:],INT,
      t,Region,IdleCpu being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i1,i3,i2,i4,i,x,x1,x2,x3,a22,a23,a24,a25,a26,
      lsize being Integer
  st
    (for b,o being Integer holds Base.[b,o] = b & Offset.[b,o] = o) &
    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &
    (for p,q being Element of [:INT,INT:], m,n being Integer holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q+n <= Offset.p or Offset.p+m <= Offset.q) &
    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies Base.p <> 0 & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &
    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:], n being Integer holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies 0 < Base.p & 0 <= Offset.p &
         Offset.p+n <= malloc.(Base.p))) &
    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuSmtMask.idx,0]),k]) <> 0) &

    a2 = shft.[a1,3] & x = t3.a2 &
    a3 = shft.[a1,4] & a4 = t4.a3 & a5 = shft.[a4,0] &
    a6 = t4.a5 & a7 = shft.[a1,1] & x1 = t3.a7 &
    x2 = t3.(shft.[a6,x1]) & a8 = shft.[a1,0] &
    a9 = shft.[a,i1] & a10 = t4.a8 & a11 = shft.[a10,1] &
    a12 = shft.[a9,0] & a13 = shft.[a10,0] & a14 = t4.a13 &
    a15 = GroupBalanceMask.a14 & a16 = t4.a12 &
    a17 = shft.[a16,0] & a18 = shft.[a6,0] &
    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a17,lsize]]] in Sep implies a19.q = t3.q) &
       (not [q,[1,[a17,lsize]]] in Sep implies a19.q = t1.q)) &
    a20 = t4.(shft.[a15,0]) &
    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a17,lsize]]] in Sep implies a21.q = t3.q) &
       (not [q,[1,[a17,lsize]]] in Sep implies a21.q = t2.q)) &
    a22 = a21.(shft.[a16,i3]) &
    a23 = a21.(shft.[a6,i2]) &
    a24 = a21.(shft.[a6,i3]) &
    a25 = a21.(shft.[a20,i2]) &
    a26 = a21.a11 & a27 = shft.[a20,0] &
    x3 = i4 &

    (IdleCpu.i3 <> 0 iff i <> 0) &
    x <> 2 & x2 <> 0 &
    0 <= i1 & i1 < lsize & 0 <= i3 & i3 < lsize &
    0 <= i4 & i4 <= lsize &
    i3 < lsize &
    0 <= x1 & x1 < lsize &
    Region.(Base.a) <= 0 & Region.(Base.a1) <= 0 &
    (for p being Element of [:INT,INT:] holds
       Region.(Base.(t4.p)) <= 0) &
    t in Linked &
    0 <= i & i < 256 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= i2 & i2 < 2147483647 + 1 &
    -(2147483647)-1 <= i3 & i3 < 2147483647 + 1 &
    -(2147483647)-1 <= i4 & i4 < 2147483647 + 1 &
    [t,[a1,5]] in ValidRD &
    0 <= x & x < 2147483647 + 2147483647 + 2 &
    -(2147483647)-1 <= x1 & x1 < 2147483647 + 1 &
    [t,[a3,1]] in ValidRD & [t,[a7,1]] in ValidRD &
    [t,[a2,1]] in ValidRD & [t,[a8,1]] in ValidRD &
    [t,[a9,1]] in ValidRD & [t,[a4,1]] in ValidRD &
    [t,[t4.(shft.[a1,2]),2]] in ValidRD &
    [t,[a10,2]] in ValidRD &
    -(2147483647)-1 <= t3.a11 & t3.a11 < 2147483647 + 1 &
    [t,[a12,1]] in ValidRD & [t,[a5,1]] in ValidRD &
    [t,[a13,1]] in ValidRD & [t,[a14,1]] in ValidRD &
    [t,[a15,1]] in ValidRD &
    0 <= x2 & x2 < 256 &
    [t,[a17,lsize]] in ValidRD & [t,[a18,lsize]] in ValidRD &
    [t,[a17,lsize]] in ValidRW &
    am1 = shft.[a6,-(1)] & am2 = shft.[a20,-(1)] &
    0 <= a19.am1 & a19.am1 < 256 &
    0 <= a19.am2 & a19.am2 < 256 &
    0 <= a22 & a22 < 256 & 0 <= a23 & a23 < 256 &
    0 <= a24 & a24 < 256 & 0 <= a25 & a25 < 256 &
    -(2147483647)-1 <= a19.a11 & a19.a11 < 2147483647 + 1 &
    -(2147483647)-1 <= a26 & a26 < 2147483647 + 1 &
    [t,[a27,lsize]] in ValidRD &
    [a17,[lsize,[a27,lsize]]] in Sep &
    ((not ex q being Integer st a26 = 8*q) implies i2 = -1) &
    (i2 <> -1 implies
       IdleCpu.i2 <> 0 & a23 <> 0 & a25 <> 0 &
       0 <= i2 & i2 < lsize) &
    (i2 = -1 implies
       for j being Integer st a21.(shft.[a20,j]) <> 0 &
         0 <= j & j < lsize holds a21.(shft.[a16,j]) <> 0) &
    ((ex j being Integer st a21.(shft.[a16,j]) <> 0 &
         a21.(shft.[a6,j]) <> 0 & j < lsize & x3 <= j)
       implies x3 <= i3) &
    ((ex j being Integer st a21.(shft.[a16,j]) <> 0 &
         a21.(shft.[a6,j]) <> 0 & j < lsize & x3 <= j)
       implies a22 <> 0 & a24 <> 0) &
    ((for j being Integer st j < lsize & x3 <= j holds
         a21.(shft.[a16,j]) = 0 or a21.(shft.[a6,j]) = 0)
       implies lsize = i3) &
    (i2 <> -1 implies
       for j being Integer st a21.(shft.[a6,j]) <> 0 &
         a21.(shft.[a20,j]) <> 0 & 0 <= j & j < i2 & j < lsize
       holds IdleCpu.j = 0) &
    (i2 = -1 implies
       for j being Integer st a21.(shft.[a6,j]) <> 0 &
         a21.(shft.[a20,j]) <> 0 & 0 <= j & j < i4 & j < lsize
       holds IdleCpu.j = 0) &
    ((ex j being Integer st a21.(shft.[a16,j]) <> 0 &
         a21.(shft.[a6,j]) <> 0 & j < lsize & x3 <= j)
       implies
       for j being Integer st j < i3 & x3 <= j holds
         a21.(shft.[a16,j]) = 0 or a21.(shft.[a6,j]) = 0) &
    (i2 <> -1 implies
       for j being Integer st a21.(shft.[a6,j]) <> 0 &
         a21.(shft.[a20,j]) <> 0 & 0 <= j & i2 <= j &
         j < i4 & j < lsize
       holds
         not (for k being Integer st
           a21.(shft.[t4.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
           0 <= k & k < lsize holds IdleCpu.k <> 0)) &
    (i2 <> -1 implies
       for j being Integer st a21.(shft.[a20,j]) <> 0 &
         0 <= j & j < lsize holds
         a21.(shft.[a16,j]) <> 0 or
         not (for k being Integer st
           a21.(shft.[t4.(shft.[CpuSmtMask.j,0]),k]) <> 0 &
           0 <= k & k < lsize holds IdleCpu.k <> 0)) &
    (for j being Integer st 0 <= j & j < lsize holds
       [a18,[lsize,
        [shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]] in Sep) &
    (for j being Integer st 0 <= j & j < lsize holds
       [t,[shft.[a,j],1]] in ValidRD &
       [t,[shft.[t4.(shft.[shft.[a,j],0]),0],lsize]] in ValidRW) &
    (for j being Integer st 0 <= j & j < lsize holds
       (a19.(shft.[a20,j]) <> 0 iff a19.(shft.[a16,j]) <> 0)) &
    (for j being Integer st a21.(shft.[a16,j]) <> 0 &
       0 <= j & j < lsize holds a21.(shft.[a20,j]) <> 0) &
    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupCpus.p,1]] in ValidRD &
       [t,[shft.[t4.(shft.[SchedGroupCpus.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t4.(shft.[SchedGroupCpus.p,0]),0],
          [lsize,[shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &
    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupMask.p,1]] in ValidRD &
       [t,[shft.[t4.(shft.[SchedGroupMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t4.(shft.[SchedGroupMask.p,0]),0],
          [lsize,[shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &
    (for p being Element of [:INT,INT:] holds
       [t,[GroupBalanceMask.p,1]] in ValidRD &
       [t,[shft.[t4.(shft.[GroupBalanceMask.p,0]),0],lsize]]
         in ValidRD &
       (for j being Integer st 0 <= j & j < lsize holds
         [shft.[t4.(shft.[GroupBalanceMask.p,0]),0],
          [lsize,[shft.[t4.(shft.[shft.[a,j],0]),0],lsize]]]
          in Sep)) &
    (for j being Integer st 0 <= j & j < lsize holds
       [t,[CpuSmtMask.j,1]] in ValidRD &
       [t,[shft.[t4.(shft.[CpuSmtMask.j,0]),0],lsize]]
         in ValidRD &
       (for k being Integer st 0 <= k & k < lsize holds
         [shft.[t4.(shft.[CpuSmtMask.j,0]),0],
          [lsize,[shft.[t4.(shft.[shft.[a,k],0]),0],lsize]]]
          in Sep))
  holds i = 0 or i = 1
proof
end;
::$P+
