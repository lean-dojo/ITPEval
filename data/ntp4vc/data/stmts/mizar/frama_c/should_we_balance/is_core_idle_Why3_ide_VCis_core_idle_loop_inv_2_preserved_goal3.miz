:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/should_we_balance/is_core_idle_Why3_ide_VCis_core_idle_loop_inv_2_preserved_goal3:
:: the is-core-idle loop-preservation verification condition concludes that
:: the selected CPU is non-idle under the stated integer-range, SMT-mask,
:: address-framing, linkage, memory-validity, and separation assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2 being Element of [:INT,INT:],
      t2,SchedGroupCpus,SchedGroupMask,GroupBalanceMask
        being Function of [:INT,INT:],[:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint32,IdleCpu being Function of INT,INT,
      CpuMask being Function of INT,[:INT,INT:],
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i5,i4,i2,i3,i,i1,x,x1,lsize being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    0 < lsize &
    lsize <= 2147483647 &

    (for cpu being Integer holds
       ex idle being Integer st
         idle = IdleCpu.cpu &
         0 <= idle & idle < 256) &

    (for idx being Integer,
         mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:]
     st
       0 <= idx & idx < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),idx]) <> 0) &

    (for mint being Function of [:INT,INT:],INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         j,idx being Integer
     st
       mint.(shft.[mptr.(shft.[CpuMask.j,0]),idx]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),j]) <> 0) &

    (for mptr being Function of [:INT,INT:],[:INT,INT:],
         idx being Integer,
         mint being Function of [:INT,INT:],INT,
         j,k being Integer
     st
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),j]) <> 0 &
       mint.(shft.[mptr.(shft.[CpuMask.j,0]),k]) <> 0 &
       0 <= idx & idx < lsize &
       0 <= j & j < lsize &
       0 <= k & k < lsize
     holds
       mint.(shft.[mptr.(shft.[CpuMask.idx,0]),k]) <> 0) &

    a1 = shft.[CpuMask.i5,0] &
    a2 = t2.a1 &
    x = t1.(shft.[a2,i4]) &
    x1 = ToUint32.i2 &

    IdleCpu.i5 <> 0 &
    t1.(shft.[a2,i3]) <> 0 &
    0 <= i &
    i < lsize &
    i3 <= i1 &
    0 <= i2 &
    0 <= i3 &
    0 <= i5 &
    i5 < lsize &
    i2 <= lsize &
    (ex u being Integer st
       u = ToUint32.i4 &
       u < lsize) &
    reg.(Base.a) <= 0 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t2.p)) <= 0) &
    t in Linked &

    0 <= i &
    i < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i1 &
    i1 < 2147483647 + 1 &
    -(2147483647) - 1 <= i2 &
    i2 < 2147483647 + 1 &
    -(2147483647) - 1 <= i4 &
    i4 < 2147483647 + 1 &
    -(2147483647) - 1 <= i5 &
    i5 < 2147483647 + 1 &
    -(2147483647) - 1 <= 1 + i1 &
    1 + i1 < 2147483647 + 1 &

    [t,[a1,1]] in ValidRD &
    0 <= x &
    x < 256 &
    [t,[shft.[a2,0],lsize]] in ValidRD &

    ((i5 = i4 &
      i5 = i1 &
      i5 <= 2147483646) or
     (i5 <> i4 &
      i4 = i1 &
      IdleCpu.i4 <> 0 &
      0 <= i4 &
      i4 < lsize &
      i4 <= 2147483646)) &

    ((for i6 being Integer st
        i6 < lsize &
        x1 <= i6
      holds
        t1.(shft.[a2,i6]) = 0)
     implies
       lsize = i4) &

    ((ex i6 being Integer st
        t1.(shft.[a2,i6]) <> 0 &
        i6 < lsize &
        x1 <= i6)
     implies
       x <> 0) &

    ((ex i6 being Integer st
        t1.(shft.[a2,i6]) <> 0 &
        i6 < lsize &
        x1 <= i6)
     implies
       i4 < lsize) &

    ((ex i6 being Integer st
        t1.(shft.[a2,i6]) <> 0 &
        i6 < lsize &
        x1 <= i6)
     implies
       i4 < lsize & x1 <= i4) &

    ((ex i6 being Integer st
        t1.(shft.[a2,i6]) <> 0 &
        i6 < lsize &
        x1 <= i6)
     implies
       (for i6 being Integer st
          i6 < i4 &
          x1 <= i6
        holds
          t1.(shft.[a2,i6]) = 0)) &

    (for i6 being Integer st
       t1.(shft.[a2,i6]) <> 0 &
       0 <= i6 &
       i6 < i2
     holds
       IdleCpu.i6 <> 0) &

    (for i6 being Integer st
       0 <= i6 &
       i6 < lsize
     holds
       [t,[shft.[a,i6],1]] in ValidRD &
       [t,[shft.[t2.(shft.[shft.[a,i6],0]),0],lsize]]
         in ValidRW) &

    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupCpus.p,1]] in ValidRD &
       [t,[shft.[t2.(shft.[SchedGroupCpus.p,0]),0],lsize]]
         in ValidRD &
       (for i6 being Integer st
          0 <= i6 &
          i6 < lsize
        holds
          [shft.[t2.(shft.[SchedGroupCpus.p,0]),0],
           [lsize,
            [shft.[t2.(shft.[shft.[a,i6],0]),0],lsize]]]
            in Sep)) &

    (for p being Element of [:INT,INT:] holds
       [t,[SchedGroupMask.p,1]] in ValidRD &
       [t,[shft.[t2.(shft.[SchedGroupMask.p,0]),0],lsize]]
         in ValidRD &
       (for i6 being Integer st
          0 <= i6 &
          i6 < lsize
        holds
          [shft.[t2.(shft.[SchedGroupMask.p,0]),0],
           [lsize,
            [shft.[t2.(shft.[shft.[a,i6],0]),0],lsize]]]
            in Sep)) &

    (for p being Element of [:INT,INT:] holds
       [t,[GroupBalanceMask.p,1]] in ValidRD &
       [t,[shft.[t2.(shft.[GroupBalanceMask.p,0]),0],lsize]]
         in ValidRD &
       (for i6 being Integer st
          0 <= i6 &
          i6 < lsize
        holds
          [shft.[t2.(shft.[GroupBalanceMask.p,0]),0],
           [lsize,
            [shft.[t2.(shft.[shft.[a,i6],0]),0],lsize]]]
            in Sep)) &

    (for i6 being Integer st
       0 <= i6 &
       i6 < lsize
     holds
       [t,[CpuMask.i6,1]] in ValidRD &
       [t,[shft.[t2.(shft.[CpuMask.i6,0]),0],lsize]]
         in ValidRD &
       (for i7 being Integer st
          0 <= i7 &
          i7 < lsize
        holds
          [shft.[t2.(shft.[CpuMask.i6,0]),0],
           [lsize,
            [shft.[t2.(shft.[shft.[a,i7],0]),0],lsize]]]
            in Sep))
  holds
    IdleCpu.i3 <> 0
proof
end;
::$P+
