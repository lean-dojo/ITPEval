:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/x509_parser/parse_generalizedTime_Why3_ide_VCparse_generalizedTime_call_compute_decimal_pre_part1_5_goal32:
:: the generalized-time parser decimal precondition verification condition
:: concludes that the byte at offset fourteen is at least the ASCII code for
:: zero, from the stated digit-range, address-separation, memory-validity,
:: integer-range, linkage, and fixed-byte assumptions. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a7,a1,a,a2,a3,a4,a5,a6 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      i,i2,i3,i4,i5,i6,i1,
      x,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x15
        being Integer,
      t,Region being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    a1 <> a &
    a2 <> a &
    a2 <> a1 &
    a3 <> a &
    a3 <> a1 &
    a3 <> a2 &
    a4 <> a &
    a4 <> a1 &
    a4 <> a2 &
    a4 <> a3 &
    a5 <> a &
    a5 <> a1 &
    a5 <> a2 &
    a5 <> a3 &
    a5 <> a4 &
    a6 <> a &
    a6 <> a1 &
    a6 <> a2 &
    a6 <> a3 &
    a6 <> a4 &
    a6 <> a5 &
    a7 <> [0,0] &

    t1.(shft.[a7,0]) = 24 &
    t1.(shft.[a7,1]) = 15 &
    t1.(shft.[a7,16]) = 90 &
    x = t1.(shft.[a7,2]) &
    x1 = t1.(shft.[a7,3]) &
    x2 = t1.(shft.[a7,4]) &
    x3 = t1.(shft.[a7,5]) &
    x4 = t1.(shft.[a7,6]) &
    x5 = t1.(shft.[a7,7]) &
    x6 = t1.(shft.[a7,8]) &
    x7 = t1.(shft.[a7,9]) &
    x8 = t1.(shft.[a7,10]) &
    x9 = t1.(shft.[a7,11]) &
    x10 = t1.(shft.[a7,12]) &
    x11 = t1.(shft.[a7,13]) &
    x12 = t1.(shft.[a7,14]) &
    x15 = t1.(shft.[a7,15]) &

    0 <= i &
    0 <= i2 &
    0 <= i3 &
    0 <= i4 &
    0 <= i5 &
    0 <= i6 &

    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    Region.(Base.a2) <= 0 &
    Region.(Base.a3) <= 0 &
    Region.(Base.a4) <= 0 &
    Region.(Base.a5) <= 0 &
    Region.(Base.a6) <= 0 &
    Region.(Base.a7) <= 0 &

    14 <= i1 &
    17 <= i &
    i3 <= 99 &
    i4 <= 99 &
    i5 <= 99 &
    i6 <= 99 &
    i2 <= 9999 &

    48 <= x &
    48 <= x1 &
    48 <= x2 &
    48 <= x3 &
    48 <= x4 &
    48 <= x5 &
    48 <= x6 &
    48 <= x7 &
    48 <= x8 &
    48 <= x9 &
    48 <= x10 &
    48 <= x11 &

    x <= 57 &
    x1 <= 57 &
    x2 <= 57 &
    x3 <= 57 &
    x4 <= 57 &
    x5 <= 57 &
    x6 <= 57 &
    x7 <= 57 &
    x8 <= 57 &
    x9 <= 57 &
    x10 <= 57 &
    x11 <= 57 &

    t in Linked &

    0 <= i1 & i1 < 256 &
    0 <= i3 & i3 < 256 &
    0 <= i4 & i4 < 256 &
    0 <= i5 & i5 < 256 &
    0 <= i6 & i6 < 256 &
    0 <= i & i < 65536 &
    0 <= i2 & i2 < 65536 &

    [t,[a,1]] in ValidRW &
    [t,[a1,1]] in ValidRW &
    [t,[a2,1]] in ValidRW &
    [t,[a3,1]] in ValidRW &
    [t,[a4,1]] in ValidRW &
    [t,[a5,1]] in ValidRW &
    [t,[a6,1]] in ValidRW &

    0 <= x & x < 256 &
    0 <= x1 & x1 < 256 &
    0 <= x2 & x2 < 256 &
    0 <= x3 & x3 < 256 &
    0 <= x4 & x4 < 256 &
    0 <= x5 & x5 < 256 &
    0 <= x6 & x6 < 256 &
    0 <= x7 & x7 < 256 &
    0 <= x8 & x8 < 256 &
    0 <= x9 & x9 < 256 &
    0 <= x10 & x10 < 256 &
    0 <= x11 & x11 < 256 &
    0 <= x12 & x12 < 256 &
    0 <= x15 & x15 < 256 &

    [t,[shft.[a7,0],1]] in ValidRD &
    [t,[shft.[a7,1],1]] in ValidRD &
    [t,[shft.[a7,2],1]] in ValidRD &
    [t,[shft.[a7,3],1]] in ValidRD &
    [t,[shft.[a7,4],1]] in ValidRD &
    [t,[shft.[a7,5],1]] in ValidRD &
    [t,[shft.[a7,6],1]] in ValidRD &
    [t,[shft.[a7,7],1]] in ValidRD &
    [t,[shft.[a7,8],1]] in ValidRD &
    [t,[shft.[a7,9],1]] in ValidRD &
    [t,[shft.[a7,10],1]] in ValidRD &
    [t,[shft.[a7,11],1]] in ValidRD &
    [t,[shft.[a7,12],1]] in ValidRD &
    [t,[shft.[a7,13],1]] in ValidRD &
    [t,[shft.[a7,14],1]] in ValidRD &
    [t,[shft.[a7,15],1]] in ValidRD &
    [t,[shft.[a7,16],1]] in ValidRD &

    [a,[1,[shft.[a7,0],i]]] in Sep &
    [a1,[1,[shft.[a7,0],i]]] in Sep &
    [a2,[1,[shft.[a7,0],i]]] in Sep &
    [a3,[1,[shft.[a7,0],i]]] in Sep &
    [a4,[1,[shft.[a7,0],i]]] in Sep &
    [a5,[1,[shft.[a7,0],i]]] in Sep &
    [a6,[1,[shft.[a7,0],i]]] in Sep &

    [t,[shft.[a7,2 + i1],1]] in ValidRD &
    (0 < i implies
       [t,[shft.[a7,0],i]] in ValidRD) &

    (for i7 being Integer holds
       ex x13 being Integer st
         x13 = t1.(shft.[a7,2 + i7]) &
         (0 <= i7 & i7 < i1 implies
           48 <= x13 & x13 <= 57))
  holds
    48 <= x12
proof
end;
::$P+
