:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/x509_parser/parse_NoticeReference_Why3_ide_VCparse_NoticeReference_loop_inv_preserved_goal1:
:: the NoticeReference parser loop-invariant preservation condition concludes
:: validity of a read from the remaining suffix after an address shift, under
:: the stated address, allocation, linkage, integer-range, and prior
:: memory-validity assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2 being Element of [:INT,INT:],
      t,Region being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      ValidRD,ValidRW being set,
      i4,i5,i,i1,i2,i3,i6 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p)))
  holds
    i <> 0 &
    i1 <> 0 &
    i3 <> 0 &
    i5 <> 0 &
    [0,0] <> a1 &
    [0,0] <> a2 &
    Base.a1 <> Base.a &
    shft.[a1,i4] <> [0,0] &
    shft.[a1,i4+i5-i] <> [0,0] &
    0 <= i &
    i6 <= i &
    0 <= i1 &
    i2 <= i1 &
    0 <= i3 &
    i4 <= i3 &
    i5 <= i3 &
    0 <= i5 &
    0 <= i6 &
    i4+i5 <= i3 &
    0 <= i4+i5 &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    -(2147483647)-1 <= i &
    -(2147483647)-1 <= i6 &
    2 <= i4 &
    3 <= i2 &
    i <= 65535 &
    i6 <= 65535 &
    i <= 2147483647 &
    i6 <= 2147483647 &
    -(2147483647)-1 <= i4+i5 &
    i4+i5 <= 65535 &
    i4+i5 <= 2147483647 &
    2+i6 <= i &
    i1 <= 65535+i2 &
    i1 <= 2147483647+i2 &
    i2 <= 2147483647+1+i1 &
    t in Linked &
    0 <= i & i < 65536 &
    0 <= i1 & i1 < 65536 &
    0 <= i2 & i2 < 65536 &
    0 <= i3 & i3 < 65536 &
    0 <= i4 & i4 < 65536 &
    0 <= i5 & i5 < 65536 &
    0 <= i6 & i6 < 65536 &
    [t,[a,1]] in ValidRW &
    0 <= i-i6 & i-i6 < 65536 &
    0 <= i1-i2 & i1-i2 < 65536 &
    0 <= i5-i & i5-i < 65536 &
    [t,[shft.[a2,0],i1]] in ValidRD &
    (0 < i3 implies
       [t,[shft.[a1,0],i3]] in ValidRD) &
    (0 < i5 implies
       [t,[shft.[a1,i4],i5]] in ValidRD) &
    (0 < i implies
       [t,[shft.[a1,i4+i5-i],i]] in ValidRD)
  implies
    [t,[shft.[a2,i2],i1-i2]] in ValidRD
proof
end;
::$P+
