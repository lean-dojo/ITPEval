:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/x509_parser/_parse_arc_Why3_ide_VC_parse_arc_assert_rte_mem_access_part1_goal5:
:: the parse-arc memory-access verification condition derives validity of a
:: one-byte read after a bounded address shift from allocation, integer-range,
:: bit-prefix, linkage, and distinct-base assumptions. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Lsl being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      Bit7 being Subset of INT,
      ValidRD,ValidRW being set,
      i1,i,i2,u,s1,s2 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint32.z &
         0 <= w &
         w < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for z being Integer holds
       ex w being Integer st
         w = Lsl.[z,0] & w = z) &

    (for z,k being Integer st 0 <= k holds
       ex v,w being Integer st
         v = Lsl.[z,k + 1] &
         w = Lsl.[z,k] &
         v = 2*w) &

    (for z being Integer holds
       (z in Bit7 iff
        ex q,r being Integer st
          z = 256*q + r &
          128 <= r & r < 256)) &

    i1 <> 0 &
    a2 <> a &
    a1 <> [0,0] &
    Base.a1 <> Base.a &
    Base.a2 <> Base.a1 &
    0 <= i &
    0 <= i1 &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    Region.(Base.a2) <= 0 &
    u = ToUint32.(7*i) &
    s1 = Lsl.[1,u] &
    s2 = Lsl.[i2,7] &
    i2 < s1 &
    i <= 3 &
    i <= 4 &
    5 <= i1 &
    s2 <= 2147483647 + 2147483647 + 1 &
    t in Linked &
    0 <= i & i < 65536 &
    0 <= i1 & i1 < 65536 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    [t,[a,1]] in ValidRW &
    [t,[a2,1]] in ValidRW &
    (0 < i1 implies
       [t,[shft.[a1,0],i1]] in ValidRD) &
    (for i3 being Integer st 0 <= i3 & i3 < i holds
       t1.(shft.[a1,i3]) in Bit7)
  holds
    [t,[shft.[a1,i],1]] in ValidRD
proof
end;
::$P+
