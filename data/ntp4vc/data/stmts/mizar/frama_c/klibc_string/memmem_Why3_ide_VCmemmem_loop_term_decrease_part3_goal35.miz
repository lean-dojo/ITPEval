:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/klibc_string/memmem_Why3_ide_VCmemmem_loop_term_decrease_part3_goal35:
:: the memmem loop-termination verification condition states that the current
:: nonnegative search offset is strictly below its unsigned 32-bit successor,
:: under the stated memory, separation, byte-range, and loop hypotheses.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a8,a9,a1,a,a6,a7,a5,a4,a3,a2,
      a10,a11,a12,a13 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW being set,
      i2,i1,i,x,x1,x2,x3,x4,x5,x6,x7,r,r1,u being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint32.z &
         0 <= w & w < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    x = Base.a8 &
    x1 = Base.a9 &
    x2 = t1.(shft.[a1,0]) &
    x3 = t1.(shft.[a,i2]) &
    x4 = t1.(shft.[a1,1]) &
    x5 = ToUint32.(1 + i2) &
    x6 = t1.(shft.[a,x5]) &
    a10 = shft.[a8,0] &
    a11 = shft.[a9,0] &
    a12 = shft.[a6,0] &
    x7 = ToUint32.(i1 - 2) &
    a13 = shft.[a7,0] &
    r = reg.x &
    r1 = reg.x1 &
    u = ToUint32.(i - i1) &

    i <> 0 &
    i1 <> 0 &
    i1 <> 1 &
    x = Base.a1 &
    x1 = Base.a &
    x2 <> x3 &
    x4 = x2 &
    x6 = x4 &
    0 <= i &
    i1 <= i &
    0 <= i1 &
    0 <= i2 &
    r <= 0 &
    r1 <= 0 &
    i2 <= u &
    i1 + i2 <= 2 + i &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= x3 & x3 < 256 &
    0 <= x2 & x2 < 256 &
    0 <= x4 & x4 < 256 &
    [t,[a10,i1]] in ValidRW &
    [t,[a11,i]] in ValidRW &
    [a11,[i,[a10,i1]]] in Sep &
    [t,[a12,x7]] in ValidRW &
    [t,[a13,x7]] in ValidRW &
    [a13,[x7,[a12,x7]]] in Sep &
    0 <= x6 & x6 < 256 &

    (0 < x7 implies
      not (ex i3 being Integer st
        t1.(shft.[a5,i3]) <> t1.(shft.[a4,i3]) &
        0 <= i3 & i3 < x7)) &

    (for i3 being Integer holds
       (0 <= i3 implies
         (i3 < i2 implies
           (ex i4 being Integer st
             (0 <= i4 implies
               (3 + i4 <= i1 implies
                 t1.(shft.[a3,2 + i4 + i3]) <>
                   t1.(shft.[a2,2 + i4])))))))
  holds
    i2 < x5
proof
end;
::$P+
