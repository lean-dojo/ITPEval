:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/klibc_string/strcat_Why3_ide_VCstrcat_call_strcpy_pre_6_goal9:
:: the strcat verification condition concludes separation of the destination
:: and selected source regions from the stated string-length, memory-validity,
:: null-character, address-order, linkage, and separation hypotheses.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a2,a,a1 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToSint8 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LLength being Function of
        [:Funcs([:INT,INT:],INT),[:INT,INT:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,Sep,ValidRW,PLength being set,
      i,i3,i1,i2,i4,x2,x3 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[mchar,[s,n]]] in PLength iff
       mchar.(shft.[s,n]) = 0 &
       0 <= n &
       [malloc,[shft.[s,0],1 + n]] in ValidRW &
       (for j being Integer st 0 <= j & j < n holds
          mchar.(shft.[s,j]) <> 0)) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         n being Integer
       st [malloc,[mchar,[s,n]]] in PLength
     holds
       LLength.[mchar,s] = n) &

    (for z being Integer holds
       ex w being Integer st
         w = ToSint8.z & -(128) <= w & w < 128) &

    (for z being Integer st -(128) <= z & z < 128 holds
       ToSint8.z = z) &

    x2 = LLength.[t1,a1] &
    x3 = LLength.[t1,a2] &
    reg.(Base.a1) <= 0 &
    reg.(Base.a2) <= 0 &
    t in Linked &
    t1 in SConst &
    -(128) <= t1.a & t1.a < 128 &
    [t,[t1,[a1,i]]] in PLength &
    [t,[t1,[a1,i3]]] in PLength &
    [t,[t1,[a2,i1]]] in PLength &
    [t,[t1,[a2,i2]]] in PLength &
    [t,[t1,[a2,i4]]] in PLength &
    [t,[shft.[a2,0],x2 + x3]] in ValidRW &
    [shft.[a2,0],
      [1 + x3,[shft.[a1,0],1 + x2]]] in Sep &

    ((for j being Integer
        st 0 <= j & j < x3
      holds
        t1.(shft.[a2,j]) <> 0)
     implies [0,0] = a) &

    ((ex j being Integer st
        t1.(shft.[a2,j]) = 0 &
        0 <= j & j < x3)
     implies t1.a = 0) &

    ((ex j being Integer st
        t1.(shft.[a2,j]) = 0 &
        0 <= j & j < x3)
     implies Base.a2 = Base.a) &

    ((ex j being Integer st
        t1.(shft.[a2,j]) = 0 &
        0 <= j & j < x3)
     implies
       t1.(shft.[a2,Offset.a - Offset.a2]) = ToSint8.0 &
       0 <= Offset.a - Offset.a2 &
       Offset.a - Offset.a2 <= x3 &
       -(128) <= 0 & 0 <= 127 &
       [t,[shft.[a2,0],1 + x3]] in ValidRW &
       (for j being Integer
          st 0 <= j & j < Offset.a - Offset.a2
        holds
          t1.(shft.[a2,j]) <> ToSint8.0)) &

    ((ex j being Integer st
        t1.(shft.[a2,j]) = 0 &
        0 <= j & j < x3)
     implies
       [a2,a] in AddrLE &
       [a,shft.[a2,x3]] in AddrLE)
  holds
    [shft.[a1,0],[1 + x2,[shft.[a,0],1 + x2]]] in Sep
proof
end;
::$P+
