:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/klibc_string/strcasecmp_Why3_ide_VCstrcasecmp_not_eq_post_part2_goal19:
:: the strcasecmp verification condition states that, under the given memory,
:: string-length, character-range, address-order, separation, and case-mapping
:: hypotheses, the compared prefixes cannot have equal uppercase characters
:: at every preceding nonnegative offset. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint8,ToUpper being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LLength being Function of
        [:Funcs([:INT,INT:],INT),[:INT,INT:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Lower,Upper being Subset of INT,
      AddrLE,Sep,ValidRW,PLength being set,
      i5,i6,i,i1,i4,i2,i3,
      x,x1,x2,x3,x4,x5,x6 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint8.z & 0 <= w & w < 256) &

    (for z being Integer st 0 <= z & z < 256 holds
       ToUint8.z = z) &

    (for z being Integer holds
       (z in Lower iff 97 <= z & z <= 122) &
       (z in Upper iff 65 <= z & z <= 90)) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[mchar,[s,n]]] in PLength iff
       mchar.(shft.[s,n]) = 0 &
       0 <= n &
       [malloc,[shft.[s,0],1 + n]] in ValidRW &
       (for j being Integer st 0 <= j & j < n holds
          mchar.(shft.[s,j]) <> 0)) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         n being Integer
       st [malloc,[mchar,[s,n]]] in PLength
     holds
       LLength.[mchar,s] = n) &

    (for c being Integer st 0 <= c & c < 256 holds
       ex u being Integer st
         u = ToUpper.c & -(128) <= u & u < 128) &

    (for c being Integer
     st 0 <= c & c < 256 & c in Lower
     holds
       ex u being Integer st
         u = ToUpper.c &
         32 + u = c &
         (for j being Integer
            st 0 <= j & j < 256 & j in Upper
          holds
            ToUpper.j = j &
            (for k being Integer
               st 0 <= k & k < 256 &
                  not k in Lower & not k in Upper
             holds
               ToUpper.k = k))) &

    x = Base.a &
    x1 = Offset.a1 &
    x2 = Offset.a &
    a3 = shft.[a2,x1 - x2] &
    x3 = t1.a1 &
    x4 = LLength.[t1,a] &
    x5 = LLength.[t1,a2] &
    x6 = ToUint8.x3 &

    Base.a1 = x &
    ToUpper.(ToUint8.(t1.(shft.[a2,i5]))) <>
      ToUpper.(ToUint8.(t1.(shft.[a,i5]))) &
    t1.a3 = 0 &
    0 <= i5 &
    i5 <= i6 &
    0 <= x3 &
    reg.(Base.a) <= 0 &
    reg.(Base.a2) <= 0 &
    x3 <= 255 &
    t in Linked &
    t1 in SConst &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    [a,a1] in AddrLE &
    -(128) <= x3 & x3 < 128 &
    [t,[t1,[a,i1]]] in PLength &
    [t,[t1,[a,i4]]] in PLength &
    [t,[t1,[a,i6]]] in PLength &
    [t,[t1,[a2,i2]]] in PLength &
    [t,[t1,[a2,i3]]] in PLength &
    [t,[t1,[a2,i6]]] in PLength &
    [a1,shft.[a,x4]] in AddrLE &
    [shft.[a2,0],[1 + x5,[shft.[a,0],1 + x4]]] in Sep &
    [a2,a3] in AddrLE &
    [a3,shft.[a2,x5]] in AddrLE &
    (0 in Lower implies i = -(32)) &
    (0 in Upper implies i = 0) &
    (not 0 in Lower implies
      (not 0 in Upper implies i = 0)) &
    (x6 in Upper implies x3 = i) &
    (x6 in Lower implies x3 = 32 + i) &
    (not x6 in Lower implies
      (not x6 in Upper implies x3 = i))
  holds
    not (for i7 being Integer
           st 0 <= i7 & i7 + x2 < x1
         holds
           ToUpper.(ToUint8.(t1.(shft.[a2,i7]))) =
             ToUpper.(ToUint8.(t1.(shft.[a,i7]))))
proof
end;
::$P+
