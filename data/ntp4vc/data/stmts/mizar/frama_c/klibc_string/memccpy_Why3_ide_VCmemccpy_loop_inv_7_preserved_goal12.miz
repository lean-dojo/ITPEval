:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/klibc_string/memccpy_Why3_ide_VCmemccpy_loop_inv_7_preserved_goal12:
:: the memccpy loop verification condition preserves equality of the updated
:: source and destination memory cells under the stated bounds, framing,
:: linkage, C-integer, validity, separation, address-order, copied-region,
:: and stopping-byte hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t1,t2,a3 being Function of [:INT,INT:],INT,
      a1,a,a2,a4,a6,a7 being Element of [:INT,INT:],
      t,reg,ToSint8,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,Sep,ValidRW being set,
      i1,i,i3,i2,x,a5,x1,u being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex s being Integer st
         s = ToSint8.z & -(128) <= s & s < 128) &

    (for z being Integer st -(128) <= z & z < 128 holds
       ToSint8.z = z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint32.z &
         0 <= w & w < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    a2 = shft.[a1,0] &
    x = i1 - i &
    (for p being Element of [:INT,INT:] holds
       ([p,[1,[a2,x]]] in Sep implies a3.p = t2.p) &
       (not [p,[1,[a2,x]]] in Sep implies a3.p = t1.p)) &
    a4 = shft.[a,x] &
    a5 = a3.a4 &
    x1 = ToSint8.i3 &
    a6 = shft.[a,0] &
    a7 = shft.[a1,x] &
    u = ToUint32.(i - 1) &

    i <> 0 &
    a5 <> x1 &
    0 < i1 &
    0 <= i &
    i <= i1 &
    0 <= i2 &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    i2 + u < i1 &
    -(128) <= i3 &
    i3 <= 127 &
    t in Linked &
    t2 in SConst &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i3 & i3 < 2147483647 + 1 &
    [t,[a6,i1]] in ValidRW &
    [t,[a2,i1]] in ValidRW &
    [a6,[i1,[a2,i1]]] in Sep &
    [a,a4] in AddrLE &
    [a1,a7] in AddrLE &
    [a4,shft.[a,i1]] in AddrLE &
    [a7,shft.[a1,i1]] in AddrLE &
    -(128) <= a5 & a5 < 128 &

    (for i4 being Integer st
       0 <= i4 & i4 + i < i1
     holds
       a3.(shft.[a1,i4]) = a3.(shft.[a,i4])) &

    (for i4 being Integer st
       0 <= i4 & i4 + i < i1
     holds
       a3.(shft.[a1,i4]) <> x1)
  holds
    (a3+*(a7,a5)).(shft.[a1,i2]) =
      (a3+*(a7,a5)).(shft.[a,i2])
proof
end;
::$P+
