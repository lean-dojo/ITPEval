:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/klibc_stdio/__fflush_Why3_ide_VC__fflush_call_write_pre_goal31:
:: the fflush write-call verification condition uses address ordering, framing,
:: C integer ranges, I/O-file validity, and writable memory to require a
:: nonnegative stored buffer position. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t2 being Function of [:INT,INT:],[:INT,INT:],
      a1,a,a2,a6 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      AddrLE,AddrLT,Sep,ValidRW,
        PValidFile,PValidNoRec,PValid being set,
      i,i1,x,x1,x2,x3,x4 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLT iff Offset.p < Offset.q)) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mint being Function of [:INT,INT:],INT,
         f being Element of [:INT,INT:]
     holds
       [malloc,[mint,f]] in PValidFile iff
       (ex pos being Integer st
          pos = mint.(shft.[f,0]) &
          0 <= pos &
          [malloc,[f,3]] in ValidRW)) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         mint being Function of [:INT,INT:],INT,
         f being Element of [:INT,INT:]
     holds
       [malloc,[mptr,[mint,f]]] in PValidNoRec iff
       ex xn,x7,x8,span being Integer,
          p5,p6,p4,p3,p50 being Element of [:INT,INT:]
       st
         xn = mint.(shft.[f,9]) &
         x7 = mint.(shft.[f,7]) &
         x8 = mint.(shft.[f,8]) &
         p5 = mptr.(shft.[f,5]) &
         p6 = mptr.(shft.[f,6]) &
         p4 = mptr.(shft.[f,4]) &
         p3 = mptr.(shft.[f,3]) &
         p50 = shft.[p5,0] &
         span = 32 + xn &
         xn = 16384 &
         0 <= x7 & x7 < xn &
         0 <= x8 & x8 < xn &
         [malloc,[f,11]] in ValidRW &
         [p5,p6] in AddrLE &
         [malloc,[mint,shft.[f,0]]] in PValidFile &
         [malloc,[p4,11]] in ValidRW &
         [malloc,[p3,11]] in ValidRW &
         [f,[11,[p4,11]]] in Sep &
         [f,[11,[p3,11]]] in Sep &
         [p4,[11,[p3,11]]] in Sep &
         [malloc,[p50,span]] in ValidRW &
         [f,[11,[p50,span]]] in Sep &
         [p4,[11,[p50,span]]] in Sep &
         [p3,[11,[p50,span]]] in Sep &
         [p6,shft.[p5,span]] in AddrLT) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         mint being Function of [:INT,INT:],INT,
         f being Element of [:INT,INT:]
     holds
       [malloc,[mptr,[mint,f]]] in PValid iff
       ex x9,x7,x8,span being Integer,
          p6,p5,p3,p4,p50 being Element of [:INT,INT:]
       st
         x9 = mint.(shft.[f,9]) &
         x7 = mint.(shft.[f,7]) &
         x8 = mint.(shft.[f,8]) &
         p6 = mptr.(shft.[f,6]) &
         p5 = mptr.(shft.[f,5]) &
         p3 = mptr.(shft.[f,3]) &
         p4 = mptr.(shft.[f,4]) &
         p50 = shft.[p5,0] &
         span = 32 + x9 &
         x9 = 16384 &
         Base.p6 = Base.p5 &
         mptr.(shft.[p3,4]) = f &
         mptr.(shft.[p4,3]) = f &
         0 <= x7 & x7 < x9 &
         0 <= x8 & x8 < x9 &
         [malloc,[f,11]] in ValidRW &
         [p5,p6] in AddrLE &
         [malloc,[mint,shft.[f,0]]] in PValidFile &
         [f,[11,[p4,11]]] in Sep &
         [f,[11,[p3,11]]] in Sep &
         [p4,[11,[p3,11]]] in Sep &
         [malloc,[mptr,[mint,p4]]] in PValidNoRec &
         [malloc,[mptr,[mint,p3]]] in PValidNoRec &
         [malloc,[p50,span]] in ValidRW &
         [f,[11,[p50,span]]] in Sep &
         [p4,[11,[p50,span]]] in Sep &
         [p3,[11,[p50,span]]] in Sep &
         [p6,shft.[p5,span]] in AddrLT) &

    a2 = t2.(shft.[a1,5]) &
    x = Base.a2 &
    x1 = Base.a &
    a6 = t2.(shft.[a1,6]) &
    x2 = Base.a6 &
    x3 = t1.(shft.[a1,9]) &
    x4 = t1.(shft.[shft.[a1,0],0]) &

    i <> 0 &
    t1.(shft.[a1,7]) = 0 &
    x = x1 &
    x2 = x1 &
    x2 = x &
    0 <= i &
    i1 <= i &
    reg.(Base.a1) <= 0 &
    -1 <= i1 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t2.p)) <= 0) &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    0 <= x3 & x3 < 2147483647 + 2147483647 + 2 &
    (ex x8 being Integer st
       x8 = t1.(shft.[a1,8]) &
       0 <= x8 & x8 < 2147483647 + 2147483647 + 2) &
    [t,[t2,[t1,a1]]] in PValid &
    [a2,a] in AddrLE &
    [t,[shft.[a,0],i]] in ValidRW &
    -(2147483647) - 1 <= x4 & x4 < 2147483647 + 1 &
    [a,shft.[a2,32 + x3]] in AddrLE
  holds
    0 <= x4
proof
end;
::$P+
