:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/klibc_stdio/_fwrite_Why3_ide_VC_fwrite_call___fflush_pre_part4_goal16:
:: the fwrite-to-fflush verification condition requires that three integer-map
:: updates preserve private I/O-file validity under framing, linkage, C
:: unsigned-32-bit ranges, writable-memory, and buffer-content assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t1,t2 being Function of [:INT,INT:],INT,
      a4,a5,a2,a,a1,a3 being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t,reg,ToUInt32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,AddrLT,Sep,ValidRW,
        PValidFile,PValidNoRec,PValid being set,
      i3,i4,i5,i,i1,i2,x,x7 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLT iff Offset.p < Offset.q)) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUInt32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUInt32.z = z) &

    (for malloc being Function of INT,INT,
         mint being Function of [:INT,INT:],INT,
         f being Element of [:INT,INT:]
     holds
       [malloc,[mint,f]] in PValidFile iff
       (ex pos being Integer st
          pos = mint.(shft.[f,0]) &
          0 <= pos &
          [malloc,[f,3]] in ValidRW)) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         mint being Function of [:INT,INT:],INT,
         f being Element of [:INT,INT:]
     holds
       [malloc,[mptr,[mint,f]]] in PValidNoRec iff
       ex xn,x7,x8,span being Integer,
          p5,p6,p4,p3,p50 being Element of [:INT,INT:]
       st
         xn = mint.(shft.[f,9]) &
         x7 = mint.(shft.[f,7]) &
         x8 = mint.(shft.[f,8]) &
         p5 = mptr.(shft.[f,5]) &
         p6 = mptr.(shft.[f,6]) &
         p4 = mptr.(shft.[f,4]) &
         p3 = mptr.(shft.[f,3]) &
         p50 = shft.[p5,0] &
         span = 32 + xn &
         xn = 16384 &
         0 <= x7 & x7 < xn &
         0 <= x8 & x8 < xn &
         [malloc,[f,11]] in ValidRW &
         [p5,p6] in AddrLE &
         [malloc,[mint,shft.[f,0]]] in PValidFile &
         [malloc,[p4,11]] in ValidRW &
         [malloc,[p3,11]] in ValidRW &
         [f,[11,[p4,11]]] in Sep &
         [f,[11,[p3,11]]] in Sep &
         [p4,[11,[p3,11]]] in Sep &
         [malloc,[p50,span]] in ValidRW &
         [f,[11,[p50,span]]] in Sep &
         [p4,[11,[p50,span]]] in Sep &
         [p3,[11,[p50,span]]] in Sep &
         [p6,shft.[p5,span]] in AddrLT) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         mint being Function of [:INT,INT:],INT,
         f being Element of [:INT,INT:]
     holds
       [malloc,[mptr,[mint,f]]] in PValid iff
       ex x9,x7,x8,span being Integer,
          p6,p5,p3,p4,p50 being Element of [:INT,INT:]
       st
         x9 = mint.(shft.[f,9]) &
         x7 = mint.(shft.[f,7]) &
         x8 = mint.(shft.[f,8]) &
         p6 = mptr.(shft.[f,6]) &
         p5 = mptr.(shft.[f,5]) &
         p3 = mptr.(shft.[f,3]) &
         p4 = mptr.(shft.[f,4]) &
         p50 = shft.[p5,0] &
         span = 32 + x9 &
         x9 = 16384 &
         Base.p6 = Base.p5 &
         mptr.(shft.[p3,4]) = f &
         mptr.(shft.[p4,3]) = f &
         0 <= x7 & x7 < x9 &
         0 <= x8 & x8 < x9 &
         [malloc,[f,11]] in ValidRW &
         [p5,p6] in AddrLE &
         [malloc,[mint,shft.[f,0]]] in PValidFile &
         [f,[11,[p4,11]]] in Sep &
         [f,[11,[p3,11]]] in Sep &
         [p4,[11,[p3,11]]] in Sep &
         [malloc,[mptr,[mint,p4]]] in PValidNoRec &
         [malloc,[mptr,[mint,p3]]] in PValidNoRec &
         [malloc,[p50,span]] in ValidRW &
         [f,[11,[p50,span]]] in Sep &
         [p4,[11,[p50,span]]] in Sep &
         [p3,[11,[p50,span]]] in Sep &
         [p6,shft.[p5,span]] in AddrLT) &

    x = i3 + i4 &
    x7 = t1.(shft.[a5,7]) &
    i4 <> 0 &
    shft.[a2,0] = shft.[a,0] &
    t1.(shft.[a5,10]) = 1 &
    t1.(shft.[a5,9]) = 16384 &
    Base.(t3.(shft.[a5,6])) = Base.(t3.(shft.[a5,5])) &
    t3.(shft.[t3.(shft.[a5,4]),3]) = a5 &
    t3.(shft.[t3.(shft.[a5,3]),4]) = a5 &
    t2.(shft.[a4,ToUInt32.(i4 - 1)]) = 10 &
    0 <= i &
    0 <= i3 &
    0 <= i4 &
    0 <= i5 &
    0 <= x &
    0 <= x7 &
    reg.(Base.a2) <= 0 &
    reg.(Base.a4) <= 0 &
    i <= 16383 &
    x7 <= 16383 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    t2 in SConst &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= i4 & i4 < 2147483647 + 2147483647 + 2 &
    0 <= i5 & i5 < 2147483647 + 2147483647 + 2 &
    [t,[a5,11]] in ValidRW &
    0 <= x & x < 2147483647 + 2147483647 + 2 &
    0 <= x7 & x7 < 2147483647 + 2147483647 + 2 &
    [t,[t3,[t1,a1]]] in PValid &
    [t,[t3,[t1,a3]]] in PValid &
    [t,[t3,[t1,a5]]] in PValid &
    [t3.(shft.[a5,5]),t3.(shft.[a5,6])] in AddrLE &
    [t,[shft.[a4,0],i4]] in ValidRW &
    [t,[shft.[a4,0],x]] in ValidRW &
    [a5,[11,[t3.(shft.[a5,3]),11]]] in Sep &
    [a5,[11,[t3.(shft.[a5,4]),11]]] in Sep &
    [t3.(shft.[a5,3]),
      [11,[t3.(shft.[a5,4]),11]]] in Sep &
    [t3.(shft.[a5,6]),
      shft.[t3.(shft.[a5,5]),16416]] in AddrLT &
    [t,[shft.[t3.(shft.[a5,5]),0],16416]] in ValidRW &
    [t,
      [((t1+*(shft.[a5,8],i))
          +*(shft.[shft.[a5,0],1],i1))
          +*(shft.[shft.[a5,0],2],i2),
       shft.[a5,0]]] in PValidFile &
    [a5,[11,[shft.[t3.(shft.[a5,5]),0],16416]]] in Sep &
    [t3.(shft.[a5,3]),
      [11,[shft.[t3.(shft.[a5,5]),0],16416]]] in Sep &
    [t3.(shft.[a5,4]),
      [11,[shft.[t3.(shft.[a5,5]),0],16416]]] in Sep &
    [t,[t3,
      [((t1+*(shft.[a5,8],i))
          +*(shft.[shft.[a5,0],1],i1))
          +*(shft.[shft.[a5,0],2],i2),
       t3.(shft.[a5,3])]]] in PValidNoRec &
    [t,[t3,
      [((t1+*(shft.[a5,8],i))
          +*(shft.[shft.[a5,0],1],i1))
          +*(shft.[shft.[a5,0],2],i2),
       t3.(shft.[a5,4])]]] in PValidNoRec &
    (for i6 being Integer st i4 < i6 & i6 <= x holds
       t2.(shft.[a4,i6 - 1]) <> 10)
  holds
    [t,[t3,
      [((t1+*(shft.[a5,8],i))
          +*(shft.[shft.[a5,0],1],i1))
          +*(shft.[shft.[a5,0],2],i2),a5]]] in PValid
proof
end;
::$P+
