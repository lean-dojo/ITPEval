:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/verker/strncmp_Why3_ide_VCstrncmp_len_diff_post_2_goal23:
:: the strncmp length-difference postcondition concludes that the comparison
:: result is one, under the stated bounded-length, byte, string-validity,
:: address-order, memory, prefix-equality, linkage, and constancy assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a2,a,a3 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToUint8,ToUint64 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LStrlen being Function of
        [:Funcs([:INT,INT:],INT),[:INT,INT:]:],INT,
      LStrnlen being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],INT:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,ValidRW,PValidStr,PValidStrn being set,
      i1,i2,i3,i,x,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10
        being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint8.z & 0 <= w & w < 256) &
    (for z being Integer st 0 <= z & z < 256 holds
       ToUint8.z = z) &
    (for z being Integer holds
       ToUint8.(ToUint8.z) = ToUint8.z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint64.z &
         0 <= w &
         w < 65536 * 65536 * 65536 * 65536) &
    (for z being Integer
       st 0 <= z & z < 65536 * 65536 * 65536 * 65536
     holds
       ToUint64.z = z) &
    (for z being Integer holds
       ToUint64.(ToUint64.z) = ToUint64.z) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:]
     holds
       ex len0,len1,cast being Integer st
         len0 = LStrlen.[mchar,s] &
         len1 = LStrlen.[mchar,shft.[s,1]] &
         cast = ToUint64.(1 + len1) &
         (mchar.(shft.[s,0]) = 0 implies len0 = 0) &
         (mchar.(shft.[s,0]) <> 0 implies cast = len0) &
         0 <= len0 &
         len0 < 65536 * 65536 * 65536 * 65536) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         cnt being Integer
     holds
       ex len0,len1,nextcnt,cast being Integer st
         len0 = LStrnlen.[mchar,[s,cnt]] &
         nextcnt = ToUint64.(cnt - 1) &
         len1 = LStrnlen.[mchar,[shft.[s,1],nextcnt]] &
         cast = ToUint64.(1 + len1) &
         ((cnt = 0 or mchar.(shft.[s,0]) = 0)
           implies len0 = 0) &
         (cnt <> 0 & mchar.(shft.[s,0]) <> 0
           implies cast = len0) &
         0 <= len0 &
         len0 < 65536 * 65536 * 65536 * 65536) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:]
     holds
       [malloc,[mchar,s]] in PValidStr iff
       ex j being Integer st
         mchar.(shft.[s,j]) = 0 &
         0 <= j &
         j < 65536 * 65536 * 65536 * 65536 &
         [malloc,[shft.[s,0],1+j]] in ValidRW &
         (for k being Integer st k <= j holds
            ex c being Integer st
              c = mchar.(shft.[s,k]) &
              -(128) <= c & c < 128)) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         cnt being Integer
     holds
       [malloc,[mchar,[s,cnt]]] in PValidStrn iff
       [malloc,[shft.[s,0],1+cnt]] in ValidRW or
       ((ex j being Integer st
           mchar.(shft.[s,j]) = 0 &
           j < cnt &
           0 <= j &
           j < 65536 * 65536 * 65536 * 65536 &
           [malloc,[shft.[s,0],1+j]] in ValidRW) &
        (for k being Integer st k <= cnt holds
           ex c being Integer st
             c = mchar.(shft.[s,k]) &
             -(128) <= c & c < 128))) &

    x = Offset.a1 &
    x1 = Offset.a2 &
    x2 = Offset.a &
    x3 = Offset.a3 &
    x4 = i1 + x - x2 &
    x5 = LStrnlen.[t1,[a1,i1]] &
    x6 = x + x5 &
    x7 = LStrnlen.[t1,[a3,i1]] &
    x8 = i1 + x &
    x9 = LStrnlen.[t1,[a,x4]] &
    x10 = LStrnlen.[t1,[a2,x4]] &

    x + x1 = x2 + x3 &
    x2 + x9 = x6 &
    x1 + x10 = x3 + x7 &
    0 < i1 &
    x <= x2 &
    Region.(Base.a1) <= 0 &
    Region.(Base.a3) <= 0 &
    x5 < x7 &
    x2 <= x8 &
    t in Linked &
    t1 in SConst &
    0 <= i2 & i2 < 256 &
    0 <= i3 & i3 < 256 &
    -(32768 * 65536) <= i & i < 32768 * 65536 &
    0 <= i1 & i1 < 65536 * 65536 * 65536 * 65536 &
    [a1,a] in AddrLE &
    [a3,a2] in AddrLE &
    [t,[t1,[a1,i1]]] in PValidStrn &
    [t,[t1,[a3,i1]]] in PValidStrn &
    0 <= x4 & x4 < 65536 * 65536 * 65536 * 65536 &
    [a,shft.[a1,x5]] in AddrLE &
    [a2,shft.[a3,x7]] in AddrLE &
    [t,[t1,[a,x4]]] in PValidStrn &
    [t,[t1,[a2,x4]]] in PValidStrn &

    (x8 = x2 implies i = 0) &
    (x8 <> x2 implies
       ToUint8.(t1.a) = i2 &
       ToUint8.(t1.a2) = i3 &
       (i3 = i2 implies i = 0 & i3 = 0) &
       (i3 <> i2 & i3 < i2 implies i = -1) &
       (i3 <> i2 & not i3 < i2 implies i = 1) &
       (i2 = 0 implies
          x5 = LStrlen.[t1,a1] &
          x6 = x2 &
          [t,[t1,a1]] in PValidStr) &
       (i3 = 0 implies
          x7 = LStrlen.[t1,a3] &
          x + x7 = x2 &
          [t,[t1,a3]] in PValidStr)) &

    (for i4 being Integer
       st 0 <= i4 & i4 < x7
     holds
       t1.(shft.[a3,i4]) = t1.(shft.[a1,i4])) &

    (for i4 being Integer
       st 0 <= i4 & i4 + x < x2
     holds
       t1.(shft.[a3,i4]) = t1.(shft.[a1,i4])) &

    (for i4 being Integer
       st 0 <= i4 & i4 < x7
     holds
       (ToUint8.(t1.(shft.[a3,i4])) =
          ToUint8.(t1.(shft.[a1,i4]))
        iff
        t1.(shft.[a3,i4]) = t1.(shft.[a1,i4])))
  holds
    i = 1
proof
end;
::$P+
