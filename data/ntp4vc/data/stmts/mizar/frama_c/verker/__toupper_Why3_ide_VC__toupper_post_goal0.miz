:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/verker/__toupper_Why3_ide_VC__toupper_post_goal0:
:: the toupper postcondition verification condition relates unsigned
:: bytes, a signed-byte lowercase test controlled by an integer flag,
:: subtraction of 32 modulo 256, and the corresponding uppercase byte.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, NUMBERS, XREAL_0, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ToUpper,ToUint8,ToSint8 being Function of INT,INT,
      i1,i,i2 being Integer
  st
    (for z being Integer holds
       ex w being Integer st
         w = ToUint8.z & 0 <= w & w < 256) &
    (for z being Integer st 0 <= z & z < 256 holds
       ToUint8.z = z) &
    (for z being Integer holds
       ex w being Integer st
         w = ToSint8.z & -(128) <= w & w < 128) &
    (for z being Integer st -(128) <= z & z < 128 holds
       ToSint8.z = z) &
    (for z being Integer holds
       ToUint8.(ToUint8.z) = ToUint8.z) &
    (for z being Integer holds
       ToSint8.(ToSint8.z) = ToSint8.z) &
    (for z being Integer holds
       ToSint8.(ToUint8.z) = ToSint8.z) &
    (for z being Integer st 97 <= z & z <= 122 holds
       ToUpper.z = z - 32) &
    (for z being Integer st not (97 <= z & z <= 122) holds
       ToUpper.z = z) &
    (ex s being Integer st
       s = ToSint8.i1 &
       ((97 <= s & s <= 122) iff not i = 0)) &
    0 <= i & i < 256 &
    0 <= i1 & i1 < 256 &
    0 <= i2 & i2 < 256 &
    ((i = 0 & i2 = i1) or
     (i <> 0 & ToUint8.(i1 - 32) = i2))
  holds
    ToUpper.i1 = i2
proof
end;
::$P+
