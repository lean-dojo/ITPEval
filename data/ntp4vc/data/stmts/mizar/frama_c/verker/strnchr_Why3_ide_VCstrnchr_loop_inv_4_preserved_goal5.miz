:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/verker/strnchr_Why3_ide_VCstrnchr_loop_inv_4_preserved_goal5:
:: the strnchr loop-invariant preservation condition says that advancing the
:: current address by one byte preserves bounded-string validity for the
:: remaining unsigned count, under the stated byte, address-order, length,
:: linkage, constancy, integer-range, and bounded-string assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToSint8,ToUint64 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LStrnlen being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],INT:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,AddrLT,ValidRW,PValidStrn being set,
      i1,i,x,x1,x2,x3,x4,x5,x6,x7 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLT iff Offset.p < Offset.q)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToSint8.z & -(128) <= w & w < 128) &
    (for z being Integer st -(128) <= z & z < 128 holds
       ToSint8.z = z) &
    (for z being Integer holds
       ToSint8.(ToSint8.z) = ToSint8.z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint64.z &
         0 <= w &
         w < 65536 * 65536 * 65536 * 65536) &
    (for z being Integer
       st 0 <= z & z < 65536 * 65536 * 65536 * 65536
     holds
       ToUint64.z = z) &
    (for z being Integer holds
       ToUint64.(ToUint64.z) = ToUint64.z) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         cnt being Integer
     holds
       ex len0,len1,nextcnt,cast being Integer st
         len0 = LStrnlen.[mchar,[s,cnt]] &
         nextcnt = ToUint64.(cnt - 1) &
         len1 = LStrnlen.[mchar,[shft.[s,1],nextcnt]] &
         cast = ToUint64.(1 + len1) &
         ((cnt = 0 or mchar.(shft.[s,0]) = 0)
           implies len0 = 0) &
         (cnt <> 0 & mchar.(shft.[s,0]) <> 0
           implies cast = len0) &
         0 <= len0 &
         len0 < 65536 * 65536 * 65536 * 65536) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         cnt being Integer
     holds
       [malloc,[mchar,[s,cnt]]] in PValidStrn iff
       [malloc,[shft.[s,0],1+cnt]] in ValidRW or
       ((ex j being Integer st
           mchar.(shft.[s,j]) = 0 &
           j < cnt &
           0 <= j &
           j < 65536 * 65536 * 65536 * 65536 &
           [malloc,[shft.[s,0],1+j]] in ValidRW) &
        (for k being Integer st k <= cnt holds
           ex c being Integer st
             c = mchar.(shft.[s,k]) &
             -(128) <= c & c < 128))) &

    x = t1.a &
    x1 = ToSint8.i1 &
    x2 = Offset.a1 &
    x3 = i + x2 &
    x4 = Offset.a &
    x5 = LStrnlen.[t1,[a,x6]] &
    x6 = i + x2 - x4 &
    x7 = LStrnlen.[t1,[a1,i]] &
    x <> 0 &
    x <> x1 &
    x3 <> x4 &
    x4 + x5 = x2 + x7 &
    x2 <= x4 &
    Region.(Base.a1) <= 0 &
    x4 <= x3 &
    t in Linked &
    t1 in SConst &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    0 <= i &
    i < 65536 * 65536 * 65536 * 65536 &
    [a1,a] in AddrLE &
    -(128) <= x & x < 128 &
    [t,[t1,[a1,i]]] in PValidStrn &
    0 <= x6 &
    x6 < 65536 * 65536 * 65536 * 65536 &
    [a,shft.[a1,x7]] in AddrLE &
    [t,[t1,[a,x6]]] in PValidStrn &
    (for a2 being Element of [:INT,INT:]
       st [a2,a] in AddrLT & [a1,a2] in AddrLE
     holds
       t1.a2 <> x1)
  holds
    [t,[t1,
      [shft.[a,1],ToUint64.(i + x2 - 1 - x4)]]]
      in PValidStrn
proof
end;
::$P+
