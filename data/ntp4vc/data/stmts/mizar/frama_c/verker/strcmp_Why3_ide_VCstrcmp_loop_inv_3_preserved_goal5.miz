:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/verker/strcmp_Why3_ide_VCstrcmp_loop_inv_3_preserved_goal5:
:: the strcmp loop-invariant preservation condition places the address one
:: byte after the current pointer between the comparison-string start and its
:: terminating address, under the stated byte, string, memory, address-order,
:: linkage, constancy, and prefix-equality assumptions. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToUint8,ToSint8,ToUint64,ToSint64
        being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LCmp being Function of [:INT,INT:],INT,
      LStrlen being Function of
        [:Funcs([:INT,INT:],INT),[:INT,INT:]:],INT,
      LStrncmp being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:[:INT,INT:],INT:]:]:],INT,
      LStrcmp being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,INT:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,ValidRW,PValidStr being set,
      x,x1,x2,x3,x4,x5,x6,x7,x8,x9 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint8.z & 0 <= w & w < 256) &
    (for z being Integer st 0 <= z & z < 256 holds
       ToUint8.z = z) &
    (for z being Integer holds
       ToUint8.(ToUint8.z) = ToUint8.z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToSint8.z & -(128) <= w & w < 128) &
    (for z being Integer st -(128) <= z & z < 128 holds
       ToSint8.z = z) &
    (for z being Integer holds
       ToSint8.(ToSint8.z) = ToSint8.z) &
    (for z being Integer holds
       ToSint8.(ToUint8.z) = ToSint8.z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint64.z &
         0 <= w &
         w < 65536 * 65536 * 65536 * 65536) &
    (for z being Integer
       st 0 <= z & z < 65536 * 65536 * 65536 * 65536
     holds
       ToUint64.z = z) &
    (for z being Integer holds
       ToUint64.(ToUint64.z) = ToUint64.z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToSint64.z &
         -(32768 * 65536 * 65536 * 65536) <= w &
         w < 32768 * 65536 * 65536 * 65536) &
    (for z being Integer
       st -(32768 * 65536 * 65536 * 65536) <= z &
          z < 32768 * 65536 * 65536 * 65536
     holds
       ToSint64.z = z) &
    (for z being Integer holds
       ToSint64.(ToSint64.z) = ToSint64.z) &
    (for z being Integer holds
       ToSint64.(ToUint64.z) = ToSint64.z) &

    (for u,v being Integer holds
       (u = v implies LCmp.[u,v] = 0) &
       (u <> v & u < v implies LCmp.[u,v] = -1) &
       (u <> v & not u < v implies LCmp.[u,v] = 1)) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:]
     holds
       ex len0,len1,cast being Integer st
         len0 = LStrlen.[mchar,s] &
         len1 = LStrlen.[mchar,shft.[s,1]] &
         cast = ToUint64.(1 + len1) &
         (mchar.(shft.[s,0]) = 0 implies len0 = 0) &
         (mchar.(shft.[s,0]) <> 0 implies cast = len0) &
         0 <= len0 &
         len0 < 65536 * 65536 * 65536 * 65536) &

    (for mchar being Function of [:INT,INT:],INT,
         cs,ct being Element of [:INT,INT:],
         n being Integer
     holds
       (n = -1 implies
          LStrncmp.[mchar,[cs,[ct,n]]] = 0) &
       (n <> -1 &
          mchar.(shft.[ct,0]) = mchar.(shft.[cs,0])
        implies
          LStrncmp.[mchar,
            [shft.[cs,1],[shft.[ct,1],n-1]]] =
          LStrncmp.[mchar,[cs,[ct,n]]]) &
       (n <> -1 &
          mchar.(shft.[ct,0]) <> mchar.(shft.[cs,0])
        implies
          LCmp.[ToUint8.(mchar.(shft.[cs,0])),
            ToUint8.(mchar.(shft.[ct,0]))] =
          LStrncmp.[mchar,[cs,[ct,n]]])) &

    (for mchar being Function of [:INT,INT:],INT,
         cs,ct being Element of [:INT,INT:]
     holds
       LStrcmp.[mchar,[cs,ct]] =
         LStrncmp.[mchar,[cs,[ct,LStrlen.[mchar,cs]]]]) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:]
     holds
       [malloc,[mchar,s]] in PValidStr iff
       ex j being Integer st
         mchar.(shft.[s,j]) = 0 &
         0 <= j &
         j < 65536 * 65536 * 65536 * 65536 &
         [malloc,[shft.[s,0],1+j]] in ValidRW &
         (for k being Integer st k <= j holds
            ex c being Integer st
              c = mchar.(shft.[s,k]) &
              -(128) <= c & c < 128)) &

    x = t1.a &
    x1 = ToUint8.x &
    x2 = t1.a2 &
    x3 = Offset.a2 &
    x4 = Offset.a3 &
    x5 = LStrlen.[t1,a3] &
    x6 = x3 - x4 &
    x7 = t1.(shft.[a3,x6]) &
    x8 = t1.(shft.[a1,x6]) &
    x9 = LStrlen.[t1,a2] &
    a4 = shft.[a1,LStrlen.[t1,a1]] &
    a5 = shft.[a,1] &

    x1 <> 0 &
    ToUint8.x2 = x1 &
    LStrcmp.[t1,[a3,a1]] = LStrcmp.[t1,[a2,a]] &
    Offset.a1 + x3 = Offset.a + x4 &
    x4 + x5 = x3 + x9 &
    x7 = x8 &

    ((for i being Integer st 0 <= i & i <= x5 holds
        ToUint8.(t1.(shft.[a3,i])) =
          ToUint8.(t1.(shft.[a1,i])))
      iff
     (for i being Integer st 0 <= i & i <= x5 holds
        t1.(shft.[a3,i]) = t1.(shft.[a1,i]))) &

    Region.(Base.a1) <= 0 &
    Region.(Base.a3) <= 0 &
    t in Linked &
    t1 in SConst &
    [a1,a] in AddrLE &
    [a3,a2] in AddrLE &
    -(128) <= x & x < 128 &
    -(128) <= x2 & x2 < 128 &
    [t,[t1,a]] in PValidStr &
    [t,[t1,a1]] in PValidStr &
    [t,[t1,a2]] in PValidStr &
    [t,[t1,a3]] in PValidStr &
    [a,a4] in AddrLE &
    [a2,shft.[a3,x5]] in AddrLE &
    -(128) <= x8 & x8 < 128 &
    -(128) <= x7 & x7 < 128 &

    (for i being Integer
       st 0 <= i & i + x4 < x3
     holds
       t1.(shft.[a3,i]) = t1.(shft.[a1,i]))
  holds
    [a1,a5] in AddrLE & [a5,a4] in AddrLE
proof
end;
::$P+
