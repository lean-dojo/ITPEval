:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/verker/strncmp_Why3_ide_VCstrncmp_loop_inv_5_preserved_goal11:
:: the fifth strncmp loop-invariant preservation condition concludes that
:: both strings remain valid after advancing their current addresses by one
:: byte and decrementing the unsigned bound, under the stated byte, offset,
:: address-order, string-validity, linkage, constancy, integer-range, and
:: prefix-equality assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a3,a,a2 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToUint8,ToUint64 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LStrnlen being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],INT:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,ValidRW,PValidStrn being set,
      i,x,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x12,x13,x14,x15,
      len1,len3
        being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint8.z & 0 <= w & w < 256) &
    (for z being Integer st 0 <= z & z < 256 holds
       ToUint8.z = z) &
    (for z being Integer holds
       ToUint8.(ToUint8.z) = ToUint8.z) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint64.z &
         0 <= w &
         w < 65536 * 65536 * 65536 * 65536) &
    (for z being Integer
       st 0 <= z & z < 65536 * 65536 * 65536 * 65536
     holds
       ToUint64.z = z) &
    (for z being Integer holds
       ToUint64.(ToUint64.z) = ToUint64.z) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         cnt being Integer
     holds
       ex len0,len1,nextcnt,cast being Integer st
         len0 = LStrnlen.[mchar,[s,cnt]] &
         nextcnt = ToUint64.(cnt - 1) &
         len1 = LStrnlen.[mchar,[shft.[s,1],nextcnt]] &
         cast = ToUint64.(1 + len1) &
         ((cnt = 0 or mchar.(shft.[s,0]) = 0)
           implies len0 = 0) &
         (cnt <> 0 & mchar.(shft.[s,0]) <> 0
           implies cast = len0) &
         0 <= len0 &
         len0 < 65536 * 65536 * 65536 * 65536) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         cnt being Integer
     holds
       [malloc,[mchar,[s,cnt]]] in PValidStrn iff
       [malloc,[shft.[s,0],1+cnt]] in ValidRW or
       ((ex j being Integer st
           mchar.(shft.[s,j]) = 0 &
           j < cnt &
           0 <= j &
           j < 65536 * 65536 * 65536 * 65536 &
           [malloc,[shft.[s,0],1+j]] in ValidRW) &
        (for k being Integer st k <= cnt holds
           ex c being Integer st
             c = mchar.(shft.[s,k]) &
             -(128) <= c & c < 128))) &

    x = t1.a1 &
    x1 = ToUint8.x &
    x2 = t1.a3 &
    x3 = Offset.a &
    x4 = i + x3 &
    x5 = Offset.a1 &
    x6 = Offset.a2 &
    x7 = Offset.a3 &
    x8 = x7 - x6 &
    x9 = t1.(shft.[a2,x8]) &
    x10 = t1.(shft.[a,x8]) &
    x12 = i + x3 - x5 &
    x13 = LStrnlen.[t1,[a,i]] &
    x14 = LStrnlen.[t1,[a2,i]] &
    x15 = ToUint64.(i + x3 - 1 - x5) &
    len1 = LStrnlen.[t1,[a1,x12]] &
    len3 = LStrnlen.[t1,[a3,x12]] &

    x1 <> 0 &
    ToUint8.x2 = x1 &
    x4 <> x5 &
    x5 + x6 = x3 + x7 &
    x9 = x10 &
    x5 + len1 = x3 + x13 &
    x7 + len3 = x6 + x14 &
    x3 <= x5 &
    Region.(Base.a) <= 0 &
    Region.(Base.a2) <= 0 &
    x5 <= x4 &
    t in Linked &
    t1 in SConst &
    0 <= i &
    i < 65536 * 65536 * 65536 * 65536 &
    [a,a1] in AddrLE &
    [a2,a3] in AddrLE &
    -(128) <= x & x < 128 &
    -(128) <= x2 & x2 < 128 &
    [t,[t1,[a,i]]] in PValidStrn &
    [t,[t1,[a2,i]]] in PValidStrn &
    0 <= x12 &
    x12 < 65536 * 65536 * 65536 * 65536 &
    [a1,shft.[a,x13]] in AddrLE &
    [a3,shft.[a2,x14]] in AddrLE &
    -(128) <= x10 & x10 < 128 &
    -(128) <= x9 & x9 < 128 &
    [t,[t1,[a1,x12]]] in PValidStrn &
    [t,[t1,[a3,x12]]] in PValidStrn &

    (for i1 being Integer
       st 0 <= i1 & i1 + x3 < x5
     holds
       t1.(shft.[a2,i1]) = t1.(shft.[a,i1])) &

    (for i1 being Integer
       st 0 <= i1 & i1 < x14
     holds
       (ToUint8.(t1.(shft.[a2,i1])) =
          ToUint8.(t1.(shft.[a,i1]))
        iff
        t1.(shft.[a2,i1]) = t1.(shft.[a,i1])))
  holds
    [t,[t1,[shft.[a1,1],x15]]] in PValidStrn &
    [t,[t1,[shft.[a3,1],x15]]] in PValidStrn
proof
end;
::$P+
