:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/verker/strspn_Why3_ide_VCstrspn_loop_inv_9_preserved_goal16:
:: the ninth strspn loop-invariant preservation condition concludes that
:: advancing the current accept-string address by one yields a valid string,
:: under the stated span-offset, address-order, valid-string, byte-range,
:: linkage, constancy, propagation, no-earlier-match, and occurrence-witness
:: assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a3,a,a2,a4 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToUint64 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LStrlen being Function of
        [:Funcs([:INT,INT:],INT),[:INT,INT:]:],INT,
      LStrspn being Function of
        [:[:INT,INT:],[:INT,INT:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      AddrLE,AddrLT,ValidRW,PValidStr,PInArray being set,
      x,x1,x2,x3,x4,spn1,spn0 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLE iff Offset.p <= Offset.q)) &

    (for p,q being Element of [:INT,INT:]
       st Base.p = Base.q
     holds
       ([p,q] in AddrLT iff Offset.p < Offset.q)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex w being Integer st
         w = ToUint64.z &
         0 <= w &
         w < 65536 * 65536 * 65536 * 65536) &

    (for z being Integer
       st 0 <= z & z < 65536 * 65536 * 65536 * 65536
     holds
       ToUint64.z = z) &

    (for z being Integer holds
       ToUint64.(ToUint64.z) = ToUint64.z) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:]
     holds
       ex len0,len1,cast being Integer st
         len0 = LStrlen.[mchar,s] &
         len1 = LStrlen.[mchar,shft.[s,1]] &
         cast = ToUint64.(1 + len1) &
         (mchar.(shft.[s,0]) = 0 implies len0 = 0) &
         (mchar.(shft.[s,0]) <> 0 implies cast = len0) &
         0 <= len0 &
         len0 < 65536 * 65536 * 65536 * 65536) &

    (for malloc being Function of INT,INT,
         mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:]
     holds
       [malloc,[mchar,s]] in PValidStr iff
       ex j being Integer st
         mchar.(shft.[s,j]) = 0 &
         0 <= j &
         j < 65536 * 65536 * 65536 * 65536 &
         [malloc,[shft.[s,0],1+j]] in ValidRW &
         (for k being Integer st k <= j holds
            ex c being Integer st
              c = mchar.(shft.[s,k]) &
              -(128) <= c & c < 128)) &

    (for mchar being Function of [:INT,INT:],INT,
         s being Element of [:INT,INT:],
         c being Integer
     holds
       [mchar,[s,c]] in PInArray iff
       ex p being Element of [:INT,INT:] st
         mchar.p = c &
         [s,p] in AddrLE &
         [p,shft.[s,LStrlen.[mchar,s]]] in AddrLT) &

    (for mchar being Function of [:INT,INT:],INT,
         s,accept being Element of [:INT,INT:]
     holds
       ex span0,span1 being Integer st
         span0 = LStrspn.[s,accept] &
         span1 = LStrspn.[shft.[s,1],accept] &
         (mchar.s = 0 implies span0 = 0) &
         (mchar.s <> 0 &
            not [mchar,[accept,mchar.s]] in PInArray implies
            span0 = 0) &
         (mchar.s <> 0 &
            [mchar,[accept,mchar.s]] in PInArray implies
            1 + span1 = span0)) &

    x = t1.a1 &
    x1 = t1.a3 &
    x2 = Offset.a1 &
    x3 = Offset.a &
    x4 = LStrlen.[t1,a] &
    a4 = shft.[a2,LStrlen.[t1,a2]] &
    spn1 = LStrspn.[a1,a2] &
    spn0 = LStrspn.[a,a2] &
    x <> 0 &
    x1 <> 0 &
    x1 <> x &
    x2 + spn1 = x3 + spn0 &
    x3 <= x2 &
    Region.(Base.a) <= 0 &
    Region.(Base.a2) <= 0 &
    x2 <= x3 + x4 &
    t in Linked &
    t1 in SConst &
    [a,a1] in AddrLE &
    [a2,a3] in AddrLE &
    -(128) <= x & x < 128 &
    -(128) <= x1 & x1 < 128 &
    [t,[t1,a]] in PValidStr &
    [t,[t1,a1]] in PValidStr &
    [t,[t1,a2]] in PValidStr &
    [t,[t1,a3]] in PValidStr &
    0 <= x2 - x3 &
    x2 - x3 <
      65536 * 65536 * 65536 * 65536 &
    [a1,shft.[a,x4]] in AddrLE &
    [a3,a4] in AddrLE &
    ([t1,[a2,x]] in PInArray implies
       [t1,[a3,x]] in PInArray) &

    (for a5 being Element of [:INT,INT:]
     st [a5,a3] in AddrLT & [a2,a5] in AddrLE
     holds
       x <> t1.a5) &

    (for a5 being Element of [:INT,INT:]
       st [a5,a1] in AddrLT & [a,a5] in AddrLE
     holds
       ex a6 being Element of [:INT,INT:] st
         t1.a5 = t1.a6 &
         [a2,a6] in AddrLE &
         [a6,a4] in AddrLT)
  holds
    [t,[t1,shft.[a3,1]]] in PValidStr
proof
end;
::$P+
