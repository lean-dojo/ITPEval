:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_chop_Why3_ide_VClist_chop_call_linked_n_before_last_pre_Linked_goal41:
:: the list-chop verification condition shortens a linked-list segment before
:: its last node under signed bounds, framing, allocation validity, separation,
:: uniqueness, and linked-chain hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for i1,i2,i being Integer,
      t1 being Function of [:INT,INT:],[:INT,INT:],
      a1,a,a2,a3,a4,a5,a6 being Element of [:INT,INT:],
      t,reg being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:]
       st
         n = N &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.(shft.[array,idx + j]) = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) =
             mptr.(shft.[chain/.(j + 1),0]))) &

    a2 = t1.(shft.[a1,i1 + i2]) &
    a3 = t1.(shft.[a2,0]) &
    a4 = t1.(shft.[a3,0]) &
    a5 = t1.a &
    a6 = shft.[a1,0] &

    a4 = [0,0] &
    a4 <> a5 &
    a4 <> t1.(shft.[a5,0]) &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    2 + i2 <= i &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t1.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    -(2147483647) - 1 <= i2 & i2 < 2147483647 + 1 &
    [t,[a,1]] in ValidRW &
    [t,[a6,2147483646]] in ValidRW &
    [a,[1,[a6,2147483646]]] in Sep &
    [a5,[4,[a6,2147483646]]] in Sep &
    [t,[a3,4]] in ValidRW &
    [t,[t1,[a5,[a1,[i1,[i,a4]]]]]] in PLinkedN &
    [t,[t1,[a2,[a1,[i1 + i2,[i - i2,a4]]]]]]
      in PLinkedN &

    (for i3 being Integer st i1 <= i3 & i3 < i + i1 holds
       [a,[1,[t1.(shft.[a1,i3]),4]]] in Sep) &

    (for i3 being Integer st i1 <= i3 & i3 < i + i1 holds
       [t1.(shft.[a1,i3]),
         [4,[a6,2147483646]]] in Sep) &

    (for i4,i3 being Integer st
       i4 <> i3 &
       i1 <= i3 & i1 <= i4 &
       i3 < i + i1 & i4 < i + i1
     holds
       t1.(shft.[a1,i4]) <> t1.(shft.[a1,i3])) &

    (for i4,i3 being Integer st
       i4 <> i3 &
       i1 <= i3 & i1 <= i4 &
       i3 < i + i1 & i4 < i + i1
     holds
       [t1.(shft.[a1,i4]),
         [4,[t1.(shft.[a1,i3]),4]]] in Sep)
  holds
    [t,[t1,[a5,[a1,[i1,[i - 1,
      t1.(shft.[a1,i + i1 - 1])]]]]]]
      in PLinkedN
proof
end;
::$P+
