:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_add_Why3_ide_VClist_add_call_list_final_add_pre_Linked_2_part1_goal43:
:: the final list-add verification condition preserves a one-node linked-list
:: segment after pointer-memory updates, under the stated memory separation,
:: framing, index, allocation, and linked-segment hypotheses. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for i,i1 being Integer,
      a4,a2,a,a1,a3,a5 being Element of [:INT,INT:],
      t3,t2,m,a6,a7 being
        Function of [:INT,INT:],[:INT,INT:],
      t,reg being Function of INT,INT,
      t1 being Function of [:INT,INT:],REAL,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      LIndex being Function of
        [:Funcs([:INT,INT:],[:INT,INT:]),
          [:[:INT,INT:],[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN,PUnchanged being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:]
       st
         n = N &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.(shft.[array,idx + j]) = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) =
             mptr.(shft.[chain/.(j + 1),0]))) &

    (for malloc0,malloc1 being Function of INT,INT,
         mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         mflt0,mflt1 being Function of [:INT,INT:],REAL,
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [malloc0,[mptr0,[mflt0,[malloc1,[mptr1,
         [mflt1,[array,[down,up]]]]]]]] in PUnchanged iff
       (for z being Integer st down <= z & z < up holds
         mptr0.(shft.[array,z]) = mptr1.(shft.[array,z]) &
         mptr1.(shft.[mptr1.(shft.[array,z]),0]) =
           mptr0.(shft.[mptr0.(shft.[array,z]),0]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),1]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),1]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),2]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),2]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),3]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),3]) &
         ([malloc1,[mptr1.(shft.[array,z]),4]] in ValidRW
           implies
          [malloc0,[mptr0.(shft.[array,z]),4]] in ValidRW))) &

    (for up,down being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st up <= down & 0 <= up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = up) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) = item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = down) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) <> item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down + 1,up]]]] =
         LIndex.[mptr,[item,[array,[down,up]]]]) &

    a5 = shft.[a4,i + i1 - 1] &

    (for q being Element of [:INT,INT:] holds
       (q = shft.[t3.a5,0] implies m.q = a1) &
       (q <> shft.[t3.a5,0] & q = a2 implies m.q = a) &
       (q <> shft.[t3.a5,0] & q <> a2 implies m.q = t3.q)) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a4,i + i1],0]]] in Sep
          implies a6.q = m.q) &
       (not [q,[1,[shft.[a4,i + i1],0]]] in Sep
          implies a6.q = t2.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = shft.[a3,0] implies a7.q = [0,0]) &
       (q <> shft.[a3,0] implies a7.q = a6.q)) &

    [0,0] <> a3 &
    i + i1 = LIndex.[t3,[a3,[a4,[i1,i + i1]]]] &
    a7.a2 <> [0,0] &
    a7.a5 <> [0,0] &
    0 <= i &
    0 <= i1 &
    reg.(Base.a2) <= 0 &
    reg.(Base.a3) <= 0 &
    reg.(Base.a4) <= 0 &
    i <= 2147483645 &
    i1 <= 2147483645 &
    i + i1 <= 2147483645 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a2,1]] in ValidRW &
    [t,[a3,4]] in ValidRW &
    [a2,[1,[a3,4]]] in Sep &
    -(2147483647) - 1 <= i + i1 &
      i + i1 < 2147483647 + 1 &
    [t,[shft.[a4,0],2147483646]] in ValidRW &
    [t,[shft.[a4,i1],i]] in ValidRW &
    [a2,[1,[shft.[a4,0],2147483646]]] in Sep &
    [a3,[4,[shft.[a4,0],2147483646]]] in Sep &
    [t3.a2,[4,[shft.[a4,0],2147483646]]] in Sep &
    [t,[t3,[t3.a2,[a4,[i1,[i,[0,0]]]]]]]
      in PLinkedN &
    [m.a2,[4,[shft.[a4,0],2147483646]]] in Sep &
    a6.(shft.[a3,0]) = t3.(shft.[a3,0]) &
    [t,[a6,[m.a2,[a4,[i1,[i,[0,0]]]]]]]
      in PLinkedN &
    [t,[a7,[a7.a2,[a4,[i1,[i,[0,0]]]]]]]
      in PLinkedN &
    [t,[a7,[a7.a2,[a4,[i1,[i - 1,a7.a5]]]]]]
      in PLinkedN &
    [t,[a6,[t1,[t,[t3,[t1,
      [a4,[i1,i + i1]]]]]]]] in PUnchanged &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       t3.(shft.[a4,i2]) <> a3) &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       [a2,[1,[t3.(shft.[a4,i2]),4]]] in Sep) &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       [t3.(shft.[a4,i2]),
         [4,[shft.[a4,0],2147483646]]] in Sep) &

    (for i2 being Integer st
       t3.(shft.[a4,i2]) <> a3 &
       i1 <= i2 & i2 < i + i1
     holds
       [a3,[4,[t3.(shft.[a4,i2]),4]]] in Sep) &

    (for i3,i2 being Integer st
       i3 <> i2 &
       i1 <= i2 & i1 <= i3 &
       i2 < i + i1 & i3 < i + i1
     holds
       t3.(shft.[a4,i3]) <> t3.(shft.[a4,i2])) &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       m.(shft.[a4,i2]) <> a3) &

    (for i3,i2 being Integer st
       i3 <> i2 &
       i1 <= i2 & i1 <= i3 &
       i2 < i + i1 & i3 < i + i1
     holds
       [t3.(shft.[a4,i3]),
         [4,[t3.(shft.[a4,i2]),4]]] in Sep) &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       [a2,[1,[m.(shft.[a4,i2]),4]]] in Sep) &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       [a3,[4,[m.(shft.[a4,i2]),4]]] in Sep) &

    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       [m.(shft.[a4,i2]),
         [4,[shft.[a4,0],2147483646]]] in Sep) &

    (for i3,i2 being Integer st
       i3 <> i2 &
       i1 <= i2 & i1 <= i3 &
       i2 < i + i1 & i3 < i + i1
     holds
       m.(shft.[a4,i3]) <> m.(shft.[a4,i2])) &

    (for i3,i2 being Integer st
       i3 <> i2 &
       i1 <= i2 & i1 <= i3 &
       i2 < i + i1 & i3 < i + i1
     holds
       [m.(shft.[a4,i3]),
         [4,[m.(shft.[a4,i2]),4]]] in Sep)
  holds
    [t,[a7,[a7.a5,[a4,[i + i1 - 1,
      [1,a7.(shft.[a7.a5,0])]]]]]]
      in PLinkedN
proof
end;
::$P+
