:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_push_Why3_ide_VClist_push_contains_item_post_Separation_2_part4_goal41:
:: the list-push verification condition establishes separation between two
:: updated pointer-map entries at distinct integer array indices, under the
:: stated bounds, framing, validity, separation, uniqueness, and linked-segment
:: hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for i3,i2,i1,i,i5,i4,x,x1,x2,x3,x4,x5 being Integer,
      a3,a2,a,a1,a4,a5,a6,a7,a8,a9,a10,a12
        being Element of [:INT,INT:],
      t3,t2,t4,a11,a16,a13,a14 being
        Function of [:INT,INT:],[:INT,INT:],
      t,reg being Function of INT,INT,
      t1 being Function of [:INT,INT:],REAL,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LIndex being Function of
        [:Funcs([:INT,INT:],[:INT,INT:]),
          [:[:INT,INT:],[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN,PUnchanged,PSwipeLeft,PSwipeRight being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:]
       st
         n = N &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.(shft.[array,idx + j]) = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) =
             mptr.(shft.[chain/.(j + 1),0]))) &

    (for malloc0,malloc1 being Function of INT,INT,
         mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         mflt0,mflt1 being Function of [:INT,INT:],REAL,
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [malloc0,[mptr0,[mflt0,[malloc1,[mptr1,
         [mflt1,[array,[down,up]]]]]]]] in PUnchanged iff
       (for z being Integer st down <= z & z < up holds
         mptr0.(shft.[array,z]) = mptr1.(shft.[array,z]) &
         mptr1.(shft.[mptr1.(shft.[array,z]),0]) =
           mptr0.(shft.[mptr0.(shft.[array,z]),0]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),1]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),1]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),2]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),2]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),3]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),3]) &
         ([malloc1,[mptr1.(shft.[array,z]),4]] in ValidRW
           implies
          [malloc0,[mptr0.(shft.[array,z]),4]] in ValidRW))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeLeft iff
       (for z being Integer st down <= z & z < up holds
         mptr1.(shft.[array,1 + z]) =
           mptr0.(shft.[array,z]))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeRight iff
       (for z being Integer st down <= z & z < up holds
         mptr1.(shft.[array,z - 1]) =
           mptr0.(shft.[array,z]))) &

    (for up,down being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st up <= down & 0 <= up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = up) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) = item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = down) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) <> item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down + 1,up]]]] =
         LIndex.[mptr,[item,[array,[down,up]]]]) &

    a4 = t3.(shft.[a3,i3]) &
    a5 = t3.(shft.[a3,i2]) &
    x = i1 - 1 &
    x1 = i + i1 &
    x2 = LIndex.[t3,[a4,[a3,[x,x1]]]] &
    x3 = LIndex.[t3,[a5,[a3,[x,x1]]]] &
    x4 = 1 + i &
    a6 = shft.[a3,0] &
    a7 = t3.a2 &
    a8 = shft.[a3,x] &
    x5 = x2 - 1 &
    a9 = shft.[a3,x5] &
    a10 = t3.a9 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a3,x2],i + i1 - x2]]] in Sep implies
         ((q = shft.[a10,0] implies a11.q = a1) &
          (q <> shft.[a10,0] & q = a2 implies a11.q = a) &
          (q <> shft.[a10,0] & q <> a2 implies
            a11.q = t3.q))) &
       (not [q,[1,[shft.[a3,x2],i + i1 - x2]]] in Sep
          implies a11.q = t2.q)) &

    a12 = a11.a2 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a3,x],x4]]] in Sep implies
          a16.q = a11.q) &
       (not [q,[1,[shft.[a3,x],x4]]] in Sep implies
          a16.q = t4.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = a8 implies a13.q = a4) &
       (q <> a8 & q = shft.[a4,0] implies a13.q = a12) &
       (q <> a8 & q <> shft.[a4,0] implies a13.q = a16.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = a2 implies a14.q = a4) &
       (q <> a2 implies a14.q = a13.q)) &

    i5 <> i4 &
    a4 <> [0,0] &
    a4 = a5 &
    x2 = x3 &
    x1 <> x2 &
    0 < i1 &
    i2 < x1 &
    i3 < x1 &
    i4 < x1 &
    i5 < x1 &
    reg.(Base.a2) <= 0 &
    reg.(Base.a3) <= 0 &
    reg.(Base.a4) <= 0 &
    x2 < x1 &
    x2 <= x1 &
    -1 <= i &
    i <= 2147483644 &
    x1 <= 2147483645 &
    i1 <= 1 + i2 &
    i1 <= 1 + i3 &
    i1 <= 1 + i4 &
    i1 <= 1 + i5 &
    i1 <= 1 + x2 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a2,1]] in ValidRW &
    -(2147483647) - 1 <= x & x < 2147483647 + 1 &
    -(2147483647) - 1 <= x4 & x4 < 2147483647 + 1 &
    [t,[a6,2147483646]] in ValidRW &
    [t,[a5,4]] in ValidRW &
    [a2,[1,[a6,2147483646]]] in Sep &
    [a7,[4,[a6,2147483646]]] in Sep &
    [a2,[1,[a5,4]]] in Sep &
    [a5,[4,[a6,2147483646]]] in Sep &
    [t,[a8,x4]] in ValidRW &
    [t,[t3,[a7,[a3,[x,[x4,[0,0]]]]]]]
      in PLinkedN &
    -(2147483647) - 1 <= x3 & x3 < 2147483647 + 1 &
    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1 &
    [a12,[4,[a6,2147483646]]] in Sep &
    a11.(shft.[a4,0]) = t3.(shft.[a4,0]) &
    t1.(shft.[a4,1]) = t1.(shft.[a4,1]) &
    t1.(shft.[a4,2]) = t1.(shft.[a4,2]) &
    t1.(shft.[a4,3]) = t1.(shft.[a4,3]) &
    [t,[a14,[t1,[t,[a13,[t1,
      [a3,[x,x1]]]]]]]] in PUnchanged &

    (i1 <= x2 implies
      ((ex z being Integer st
          a4 = t3.(shft.[a3,z]) &
          z < x1 & i1 <= 1 + z)
       implies a11.a9 = a10)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       [a11,[t3,[a3,[x2,i + i1 - 1]]]]
         in PSwipeLeft) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x1 & i1 <= 1 + z holds
          a11.(shft.[a3,z]) <> a4)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x1
        holds
          a11.(shft.[a3,z]) <> a4)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       [t,[a11,[a12,[a3,[x,[i,[0,0]]]]]]]
         in PLinkedN) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       [t,[a11,[a12,[a3,[x,[x4,[0,0]]]]]]]
         in PLinkedN) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       [t,[a11,[t1,[t,[t3,[t1,
         [a3,[x,x1]]]]]]]] in PUnchanged) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       [t,[a11,[t1,[t,[t3,[t1,
         [a3,[x,x5]]]]]]]] in PUnchanged) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x1 & i1 <= 1 + z holds
          [a2,[1,[a11.(shft.[a3,z]),4]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x1
        holds
          [a2,[1,[a11.(shft.[a3,z]),4]]] in Sep)) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x1 & i1 <= 1 + z holds
          [a4,[4,[a11.(shft.[a3,z]),4]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x1
        holds
          [a4,[4,[a11.(shft.[a3,z]),4]]] in Sep)) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x1 & i1 <= 1 + z holds
          [a11.(shft.[a3,z]),
            [4,[a6,2147483646]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x1
        holds
          [a11.(shft.[a3,z]),
            [4,[a6,2147483646]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z being Integer st x2 <= z & 2 + z <= x1 holds
          a11.(shft.[a11.(shft.[a3,z]),0]) =
            t3.(shft.[t3.(shft.[a3,1 + z]),0]) &
          t1.(shft.[a11.(shft.[a3,z]),1]) =
            t1.(shft.[t3.(shft.[a3,1 + z]),1]) &
          t1.(shft.[a11.(shft.[a3,z]),2]) =
            t1.(shft.[t3.(shft.[a3,1 + z]),2]) &
          t1.(shft.[a11.(shft.[a3,z]),3]) =
            t1.(shft.[t3.(shft.[a3,1 + z]),3]))) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z5,z4 being Integer st
          z5 <> z4 &
          z4 < x1 & z5 < x1 &
          i1 <= 1 + z4 & i1 <= 1 + z5
        holds
          a11.(shft.[a3,z5]) <> a11.(shft.[a3,z4]))) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z5,z4 being Integer st
          z5 <> z4 &
          i1 <= 1 + z4 & i1 <= 1 + z5 &
          2 + z4 <= x1 & 2 + z5 <= x1
        holds
          a11.(shft.[a3,z5]) <> a11.(shft.[a3,z4]))) &

    ((for z being Integer st z < x1 & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z5,z4 being Integer st
          z5 <> z4 &
          z4 < x1 & z5 < x1 &
          i1 <= 1 + z4 & i1 <= 1 + z5
        holds
          [a11.(shft.[a3,z5]),
            [4,[a11.(shft.[a3,z4]),4]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x1 & i1 <= 1 + z)
     implies
       (for z5,z4 being Integer st
          z5 <> z4 &
          i1 <= 1 + z4 & i1 <= 1 + z5 &
          2 + z4 <= x1 & 2 + z5 <= x1
        holds
          [a11.(shft.[a3,z5]),
            [4,[a11.(shft.[a3,z4]),4]]] in Sep)) &

    (for z being Integer st z < x1 & i1 <= 1 + z holds
       [a2,[1,[t3.(shft.[a3,z]),4]]] in Sep) &

    (for z being Integer st z < x1 & i1 <= 1 + z holds
       [t3.(shft.[a3,z]),
         [4,[a6,2147483646]]] in Sep) &

    (for z being Integer st
       a5 <> t3.(shft.[a3,z]) &
       z < x1 & i1 <= 1 + z
     holds
       [a5,[4,[t3.(shft.[a3,z]),4]]] in Sep) &

    (for z being Integer st
       a4 <> t3.(shft.[a3,z]) &
       z < x1 & i1 <= 1 + z
     holds
       [a4,[4,[t3.(shft.[a3,z]),4]]] in Sep) &

    (for z5,z4 being Integer st
       z5 <> z4 &
       z4 < x1 & z5 < x1 &
       i1 <= 1 + z4 & i1 <= 1 + z5
     holds
       t3.(shft.[a3,z5]) <> t3.(shft.[a3,z4])) &

    (for z5,z4 being Integer st
       z5 <> z4 &
       z4 < x1 & z5 < x1 &
       i1 <= 1 + z4 & i1 <= 1 + z5
     holds
       [t3.(shft.[a3,z5]),
         [4,[t3.(shft.[a3,z4]),4]]] in Sep) &

    a16.a2 = a12 &
    [a16.a2,[4,[a6,2147483646]]] in Sep &

    (for z being Integer st i1 <= z & z < x1 holds
       [a2,[1,[a16.(shft.[a3,z]),4]]] in Sep) &

    (for z being Integer st i1 <= z & z < x1 holds
       [a16.(shft.[a3,z]),
         [4,[a6,2147483646]]] in Sep) &

    (for z5,z4 being Integer st
       z5 <> z4 &
       i1 <= z4 & i1 <= z5 &
       z4 < x1 & z5 < x1
     holds
       [a16.(shft.[a3,z5]),
         [4,[a16.(shft.[a3,z4]),4]]] in Sep) &

    (for z5,z4 being Integer st
       z5 <> z4 &
       x <= z4 & x <= z5 &
       z4 < x1 & z5 < x1
     holds
       a16.(shft.[a3,z5]) <> a16.(shft.[a3,z4])) &

    [a16,[a11,[a3,[i1,x1]]]] in PSwipeRight &
    [t,[a16,[a12,[a3,[i1,[i,[0,0]]]]]]]
      in PLinkedN
  holds
    [a14.(shft.[a3,i5]),
      [4,[a14.(shft.[a3,i4]),4]]] in Sep
proof
end;
::$P+
