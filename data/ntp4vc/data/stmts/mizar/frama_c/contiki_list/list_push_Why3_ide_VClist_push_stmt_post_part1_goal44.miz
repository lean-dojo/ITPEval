:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_push_Why3_ide_VClist_push_stmt_post_part1_goal44:
:: the list-push verification condition establishes unchanged pointer and
:: record memory over an integer-indexed array interval after two pointer-map
:: havocs and updates, under the stated bounds, framing, validity, separation,
:: linked-segment, uniqueness, and branch-preservation hypotheses. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for i1,i,x,x1,x2,x3,x4 being Integer,
      a3,a4,a2,a,a1,a5,a6,a7,a8,a9,a10
        being Element of [:INT,INT:],
      t3,t2,t4,m,a11,a14,a12,afinal being
        Function of [:INT,INT:],[:INT,INT:],
      t,reg being Function of INT,INT,
      t1 being Function of [:INT,INT:],REAL,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LIndex being Function of
        [:Funcs([:INT,INT:],[:INT,INT:]),
          [:[:INT,INT:],[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN,PUnchanged,PSwipeLeft,PSwipeRight
        being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:]
       st
         n = N &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.(shft.[array,idx + j]) = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) =
             mptr.(shft.[chain/.(j + 1),0]))) &

    (for malloc0,malloc1 being Function of INT,INT,
         mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         mflt0,mflt1 being Function of [:INT,INT:],REAL,
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [malloc0,[mptr0,[mflt0,[malloc1,[mptr1,
         [mflt1,[array,[down,up]]]]]]]] in PUnchanged iff
       (for z being Integer st down <= z & z < up holds
         mptr0.(shft.[array,z]) = mptr1.(shft.[array,z]) &
         mptr1.(shft.[mptr1.(shft.[array,z]),0]) =
           mptr0.(shft.[mptr0.(shft.[array,z]),0]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),1]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),1]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),2]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),2]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),3]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),3]) &
         ([malloc1,[mptr1.(shft.[array,z]),4]] in ValidRW
           implies
          [malloc0,[mptr0.(shft.[array,z]),4]] in ValidRW))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeLeft iff
       (for z being Integer st down <= z & z < up holds
         mptr1.(shft.[array,1 + z]) =
           mptr0.(shft.[array,z]))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]]
         in PSwipeRight iff
       (for z being Integer st down <= z & z < up holds
         mptr1.(shft.[array,z - 1]) =
           mptr0.(shft.[array,z]))) &

    (for up,down being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st up <= down & 0 <= up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = up) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) = item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = down) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) <> item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down + 1,up]]]] =
         LIndex.[mptr,[item,[array,[down,up]]]]) &

    x = i1 - 1 &
    x1 = i + i1 - 1 &
    x2 = LIndex.[t3,[a3,[a4,[x,x1]]]] &
    x3 = i + i1 &
    a5 = shft.[a4,0] &
    a6 = t3.a2 &
    a7 = shft.[a4,x] &
    x4 = i + i1 - 2 &
    a8 = shft.[a4,x4] &
    a9 = t3.a8 &

    (for q being Element of [:INT,INT:] holds
       (q = shft.[a9,0] implies m.q = a1) &
       (q <> shft.[a9,0] & q = a2 implies m.q = a) &
       (q <> shft.[a9,0] & q <> a2 implies m.q = t3.q)) &

    a10 = m.a2 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a4,x1],0]]] in Sep
          implies a11.q = m.q) &
       (not [q,[1,[shft.[a4,x1],0]]] in Sep
          implies a11.q = t2.q)) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a4,x],1 + i]]] in Sep
          implies a14.q = a11.q) &
       (not [q,[1,[shft.[a4,x],1 + i]]] in Sep
          implies a14.q = t4.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = a7 implies a12.q = a3) &
       (q <> a7 & q = shft.[a3,0] implies a12.q = a10) &
       (q <> a7 & q <> shft.[a3,0] implies a12.q = a14.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = a2 implies afinal.q = a3) &
       (q <> a2 implies afinal.q = a12.q)) &

    a3 <> [0,0] &
    1 + x2 = x3 &
    0 < i1 &
    0 <= i &
    reg.(Base.a2) <= 0 &
    reg.(Base.a3) <= 0 &
    reg.(Base.a4) <= 0 &
    i <= 2147483645 &
    x3 <= 2147483646 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a2,1]] in ValidRW &
    [t,[a3,4]] in ValidRW &
    [a2,[1,[a3,4]]] in Sep &
    -(2147483647) - 1 <= x & x < 2147483647 + 1 &
    -(2147483647) - 1 <= x1 & x1 < 2147483647 + 1 &
    [t,[a5,2147483646]] in ValidRW &
    [a2,[1,[a5,2147483646]]] in Sep &
    [a3,[4,[a5,2147483646]]] in Sep &
    [a6,[4,[a5,2147483646]]] in Sep &
    [t,[a7,i]] in ValidRW &
    [t,[t3,[a6,[a4,[x,[i,[0,0]]]]]]]
      in PLinkedN &
    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1 &
    [a10,[4,[a5,2147483646]]] in Sep &

    a11.(shft.[a3,0]) = t3.(shft.[a3,0]) &
    t1.(shft.[a3,1]) = t1.(shft.[a3,1]) &
    t1.(shft.[a3,2]) = t1.(shft.[a3,2]) &
    t1.(shft.[a3,3]) = t1.(shft.[a3,3]) &

    (0 < i implies
      ((ex z being Integer st
          t3.(shft.[a4,z]) = a3 &
          i1 <= 1 + z & 2 + z <= x3)
       implies m.a8 = a9)) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x3
        holds
          m.(shft.[a4,z]) <> a3)) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 3 + z <= x3
        holds
          m.(shft.[a4,z]) <> a3)) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       [a11,[t3,[a4,[x1,x4]]]] in PSwipeLeft) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x3
        holds
          [a2,[1,[m.(shft.[a4,z]),4]]] in Sep)) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 3 + z <= x3
        holds
          [a2,[1,[m.(shft.[a4,z]),4]]] in Sep)) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x3
        holds
          [a3,[4,[m.(shft.[a4,z]),4]]] in Sep)) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 3 + z <= x3
        holds
          [a3,[4,[m.(shft.[a4,z]),4]]] in Sep)) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x3
        holds
          [m.(shft.[a4,z]),
            [4,[a5,2147483646]]] in Sep)) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z being Integer st
          i1 <= 1 + z & 3 + z <= x3
        holds
          [m.(shft.[a4,z]),
            [4,[a5,2147483646]]] in Sep)) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       [t,[a11,[a10,[a4,[x,[i,[0,0]]]]]]]
         in PLinkedN) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       [t,[a11,[a10,[a4,[x,[i - 1,[0,0]]]]]]]
         in PLinkedN) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       (for z3,z2 being Integer st
          z3 <> z2 &
          i1 <= 1 + z2 & i1 <= 1 + z3 &
          2 + z2 <= x3 & 2 + z3 <= x3
        holds
          m.(shft.[a4,z3]) <> m.(shft.[a4,z2]))) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z3,z2 being Integer st
          z3 <> z2 &
          i1 <= 1 + z2 & i1 <= 1 + z3 &
          3 + z2 <= x3 & 3 + z3 <= x3
        holds
          m.(shft.[a4,z3]) <> m.(shft.[a4,z2]))) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       [t,[a11,[t1,[t,[t3,[t1,
         [a4,[x,x4]]]]]]]] in PUnchanged) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       [t,[a11,[t1,[t,[t3,[t1,
         [a4,[x,x1]]]]]]]] in PUnchanged) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z being Integer st
          x3 <= 1 + z & 3 + z <= x3
        holds
          a11.(shft.[m.(shft.[a4,z]),0]) =
            t3.(shft.[t3.(shft.[a4,1 + z]),0]) &
          t1.(shft.[m.(shft.[a4,z]),1]) =
            t1.(shft.[t3.(shft.[a4,1 + z]),1]) &
          t1.(shft.[m.(shft.[a4,z]),2]) =
            t1.(shft.[t3.(shft.[a4,1 + z]),2]) &
          t1.(shft.[m.(shft.[a4,z]),3]) =
            t1.(shft.[t3.(shft.[a4,1 + z]),3]))) &

    ((for z being Integer st
        i1 <= 1 + z & 2 + z <= x3
      holds
        t3.(shft.[a4,z]) <> a3)
     implies
       (for z3,z2 being Integer st
          z3 <> z2 &
          i1 <= 1 + z2 & i1 <= 1 + z3 &
          2 + z2 <= x3 & 2 + z3 <= x3
        holds
          [m.(shft.[a4,z3]),
            [4,[m.(shft.[a4,z2]),4]]] in Sep)) &

    ((ex z being Integer st
        t3.(shft.[a4,z]) = a3 &
        i1 <= 1 + z & 2 + z <= x3)
     implies
       (for z3,z2 being Integer st
          z3 <> z2 &
          i1 <= 1 + z2 & i1 <= 1 + z3 &
          3 + z2 <= x3 & 3 + z3 <= x3
        holds
          [m.(shft.[a4,z3]),
            [4,[m.(shft.[a4,z2]),4]]] in Sep)) &

    (for z being Integer st
       i1 <= 1 + z & 2 + z <= x3
     holds
       (-(2147483647) - 1 <= z & z < 2147483647 + 1
        implies t3.(shft.[a4,z]) <> a3)) &

    (for z being Integer st
       i1 <= 1 + z & 2 + z <= x3
     holds
       [a2,[1,[t3.(shft.[a4,z]),4]]] in Sep) &

    (for z being Integer st
       i1 <= 1 + z & 2 + z <= x3
     holds
       [t3.(shft.[a4,z]),
         [4,[a5,2147483646]]] in Sep) &

    (for z being Integer st
       t3.(shft.[a4,z]) <> a3 &
       i1 <= 1 + z & 2 + z <= x3
     holds
       [a3,[4,[t3.(shft.[a4,z]),4]]] in Sep) &

    (for z3,z2 being Integer st
       z3 <> z2 &
       i1 <= 1 + z2 & i1 <= 1 + z3 &
       2 + z2 <= x3 & 2 + z3 <= x3
     holds
       t3.(shft.[a4,z3]) <> t3.(shft.[a4,z2])) &

    (for z3,z2 being Integer st
       z3 <> z2 &
       i1 <= 1 + z2 & i1 <= 1 + z3 &
       2 + z2 <= x3 & 2 + z3 <= x3
     holds
       [t3.(shft.[a4,z3]),
         [4,[t3.(shft.[a4,z2]),4]]] in Sep) &

    a14.a2 = a10 &
    [a14.a2,[4,[a5,2147483646]]] in Sep &

    (for j being Integer st
       i1 <= j & j < x3
     holds
       [a2,[1,[a14.(shft.[a4,j]),4]]] in Sep) &

    (for j being Integer st
       i1 <= j & j < x3
     holds
       [a14.(shft.[a4,j]),
         [4,[a5,2147483646]]] in Sep) &

    (for k,j being Integer st
       k <> j &
       i1 <= j & i1 <= k &
       j < x3 & k < x3
     holds
       [a14.(shft.[a4,k]),
         [4,[a14.(shft.[a4,j]),4]]] in Sep) &

    (for k,j being Integer st
       k <> j &
       x <= j & x <= k &
       j < x3 & k < x3
     holds
       a14.(shft.[a4,k]) <> a14.(shft.[a4,j])) &

    [a14,[a11,[a4,[i1,x3]]]] in PSwipeRight &
    [t,[a14,[a10,[a4,[i1,[i,[0,0]]]]]]]
      in PLinkedN
  holds
    [t,[afinal,[t1,[t,[a12,[t1,
      [a4,[x,x3]]]]]]]] in PUnchanged
proof
end;
::$P+
