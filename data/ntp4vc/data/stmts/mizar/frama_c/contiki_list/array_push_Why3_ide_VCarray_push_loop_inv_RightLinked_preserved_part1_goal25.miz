:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/array_push_Why3_ide_VCarray_push_loop_inv_RightLinked_preserved_part1_goal25:
:: preservation of the right linked-list segment invariant during an array-push
:: loop after a havoc region and one pointer-array update. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t2,t3,a6,a9 being
        Function of [:INT,INT:],[:INT,INT:],
      a4,a,a2,a3,a1 being Element of [:INT,INT:],
      t being Function of INT,INT,
      t1 being Function of [:INT,INT:],REAL,
      reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN,PUnchanged,PSwipeRight being set,
      i1,i2,i,ba4,oa4,ba,oa,ba2,oa2,ba3,oa3,ba1,oa1,
      rba4,rba,rba2,rba3
        being Integer
  st
    a4 = [ba4,oa4] &
    a = [ba,oa] &
    a2 = [ba2,oa2] &
    a3 = [ba3,oa3] &
    a1 = [ba1,oa1] &
    rba4 = reg.ba4 &
    rba = reg.ba &
    rba2 = reg.ba2 &
    rba3 = reg.ba3 &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:],
          barray,oarray being Integer st
         n = N &
         array = [barray,oarray] &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.[barray,oarray + (idx + j)] = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) = mptr.(chain/.(j + 1)))) &

    (for malloc0,malloc1 being Function of INT,INT,
         mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         mflt0,mflt1 being Function of [:INT,INT:],REAL,
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [malloc0,[mptr0,[mflt0,[malloc1,[mptr1,
         [mflt1,[array,[down,up]]]]]]]] in PUnchanged iff
       ex barray,oarray being Integer st
         array = [barray,oarray] &
         (for z being Integer st down <= z & z < up holds
           ex b0,o0,b1,o1 being Integer st
             mptr0.[barray,oarray + z] = [b0,o0] &
             mptr1.[barray,oarray + z] = [b1,o1] &
             [b0,o0] = [b1,o1] &
             mptr0.[b0,o0] = mptr1.[b1,o1] &
             mflt0.[b0,o0 + 1] = mflt1.[b1,o1 + 1] &
             mflt0.[b0,o0 + 2] = mflt1.[b1,o1 + 2] &
             mflt0.[b0,o0 + 3] = mflt1.[b1,o1 + 3] &
             ([malloc1,[[b1,o1],4]] in ValidRW implies
               [malloc0,[[b0,o0],4]] in ValidRW))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeRight iff
       ex barray,oarray being Integer st
         array = [barray,oarray] &
         (for z being Integer st down <= z & z < up holds
           mptr1.[barray,oarray + (z - 1)] =
             mptr0.[barray,oarray + z])) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[[ba4,oa4 + i1],1 + i2]]] in Sep implies
          a6.q = t3.q) &
       (not [q,[1,[[ba4,oa4 + i1],1 + i2]]] in Sep implies
          a6.q = t2.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = [ba4,oa4 + i1] implies
          a9.q = a6.[ba4,oa4 + (i1 - 1)]) &
       (q <> [ba4,oa4 + i1] implies a9.q = a6.q)) &

    i2 <> -1 &
    (i2 = 0 iff i = 0) &
    (0 < i2 iff i = 1) &
    a6.a = t3.a &
    0 <= i2 &
    rba <= 0 &
    rba2 <= 0 &
    rba3 <= 0 &
    rba4 <= 0 &
    i1 + i2 <= 2147483645 &
    (for p being Element of [:INT,INT:] holds
      ex bp,op,rp being Integer st
        t3.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a,1]] in ValidRW &
    -(2147483647) - 1 <= i1 - 1 &
      i1 - 1 < 2147483647 + 1 &
    -(2147483647) - 1 <= 1 + i2 &
      1 + i2 < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 + i2 &
      i1 + i2 < 2147483647 + 1 &
    [t,[a4,2147483646]] in ValidRW &
    [a,[1,[a4,2147483646]]] in Sep &
    [t3.a,[4,[a4,2147483646]]] in Sep &
    [t,[t3,[a2,[a4,[i1 - 1,[1 + i2,a3]]]]]]
      in PLinkedN &
    [a6,[t3,[a4,[1 + i1,1 + i1 + i2]]]]
      in PSwipeRight &
    [t,[a6,[a1,[a4,[1 + i1,[i2,a3]]]]]]
      in PLinkedN &
    [t,[a6,[a2,[a4,[i1 - 1,[1,a1]]]]]]
      in PLinkedN &
    [t,[a6,[t1,[t,[t3,[t1,
      [a4,[i1 - 1,i1]]]]]]]] in PUnchanged &
    (for i4 being Integer st
       i4 < i1 + i2 & i1 <= 1 + i4
     holds
       [a,[1,[t3.[ba4,oa4 + i4],4]]] in Sep) &
    (for i4 being Integer st
       i4 < i1 + i2 & i1 <= 1 + i4
     holds
       [t3.[ba4,oa4 + i4],
         [4,[a4,2147483646]]] in Sep) &
    (for i5,i4 being Integer st
       i5 <> i4 &
       i4 < i1 + i2 & i5 < i1 + i2 &
       i1 <= 1 + i4 & i1 <= 1 + i5
     holds
       t3.[ba4,oa4 + i5] <> t3.[ba4,oa4 + i4]) &
    (for i4 being Integer st
       i1 < i4 & i4 <= i1 + i2
     holds
       [a,[1,[a6.[ba4,oa4 + i4],4]]] in Sep) &
    (for i4 being Integer st
       i4 < i + i1 + i2 & i1 <= 1 + i4
     holds
       [a6.[ba4,oa4 + i4],
         [4,[a4,2147483646]]] in Sep) &
    (for i5,i4 being Integer st
       i5 <> i4 &
       i4 < i1 + i2 & i5 < i1 + i2 &
       i1 <= 1 + i4 & i1 <= 1 + i5
     holds
       [t3.[ba4,oa4 + i5],
         [4,[t3.[ba4,oa4 + i4],4]]] in Sep)
  holds
    [t,[a9,[a2,[a4,[i1,[1 + i2,a3]]]]]]
      in PLinkedN
proof
end;
::$P+
