:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_push_Why3_ide_VClist_push_stmt_post_part4_goal45:
:: the list-push verification condition establishes unchanged pointer and
:: record memory over an integer-indexed array interval after memory havoc
:: and pointer-map updates, under the stated bounds, framing, validity,
:: separation, linked-segment, uniqueness, and branch-preservation
:: hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for i2,i,i1,x,x1,x2,x3,x4 being Integer,
      a3,a2,a,a1,a4,a5,a6,a7,a8,a9,a11
        being Element of [:INT,INT:],
      t3,t2,t4,a10,a14,a12,a13 being
        Function of [:INT,INT:],[:INT,INT:],
      t,reg being Function of INT,INT,
      t1 being Function of [:INT,INT:],REAL,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LIndex being Function of
        [:Funcs([:INT,INT:],[:INT,INT:]),
          [:[:INT,INT:],[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN,PUnchanged,PSwipeLeft,PSwipeRight being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:]
       st
         n = N &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.(shft.[array,idx + j]) = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) =
             mptr.(shft.[chain/.(j + 1),0]))) &

    (for malloc0,malloc1 being Function of INT,INT,
         mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         mflt0,mflt1 being Function of [:INT,INT:],REAL,
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [malloc0,[mptr0,[mflt0,[malloc1,[mptr1,
         [mflt1,[array,[down,up]]]]]]]] in PUnchanged iff
       (for z being Integer st down <= z & z < up holds
         mptr0.(shft.[array,z]) = mptr1.(shft.[array,z]) &
         mptr1.(shft.[mptr1.(shft.[array,z]),0]) =
           mptr0.(shft.[mptr0.(shft.[array,z]),0]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),1]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),1]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),2]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),2]) &
         mflt1.(shft.[mptr1.(shft.[array,z]),3]) =
           mflt0.(shft.[mptr0.(shft.[array,z]),3]) &
         ([malloc1,[mptr1.(shft.[array,z]),4]] in ValidRW
           implies
          [malloc0,[mptr0.(shft.[array,z]),4]] in ValidRW))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeLeft iff
       (for z being Integer st down <= z & z < up holds
         mptr1.(shft.[array,1 + z]) =
           mptr0.(shft.[array,z]))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeRight iff
       (for z being Integer st down <= z & z < up holds
         mptr1.(shft.[array,z - 1]) =
           mptr0.(shft.[array,z]))) &

    (for up,down being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st up <= down & 0 <= up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = up) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) = item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = down) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) <> item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down + 1,up]]]] =
         LIndex.[mptr,[item,[array,[down,up]]]]) &

    a4 = t3.(shft.[a3,i2]) &
    x = i + i1 &
    x1 = i1 - 1 &
    x2 = LIndex.[t3,[a4,[a3,[x1,x]]]] &
    x3 = 1 + i &
    a5 = shft.[a3,0] &
    a6 = t3.a2 &
    a7 = shft.[a3,x1] &
    x4 = x2 - 1 &
    a8 = shft.[a3,x4] &
    a9 = t3.a8 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a3,x2],i + i1 - x2]]] in Sep implies
         ((q = shft.[a9,0] implies a10.q = a1) &
          (q <> shft.[a9,0] & q = a2 implies a10.q = a) &
          (q <> shft.[a9,0] & q <> a2 implies
            a10.q = t3.q))) &
       (not [q,[1,[shft.[a3,x2],i + i1 - x2]]] in Sep
          implies a10.q = t2.q)) &

    a11 = a10.a2 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a3,x1],1 + i]]] in Sep implies
          a14.q = a10.q) &
       (not [q,[1,[shft.[a3,x1],1 + i]]] in Sep
          implies a14.q = t4.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = a7 implies a12.q = a4) &
       (q <> a7 & q = shft.[a4,0] implies a12.q = a11) &
       (q <> a7 & q <> shft.[a4,0] implies a12.q = a14.q)) &

    (for q being Element of [:INT,INT:] holds
       (q = a2 implies a13.q = a4) &
       (q <> a2 implies a13.q = a12.q)) &

    a4 <> [0,0] &
    x <> x2 &
    0 < i1 &
    i2 < x &
    reg.(Base.a2) <= 0 &
    reg.(Base.a3) <= 0 &
    reg.(Base.a4) <= 0 &
    x2 < x &
    x2 <= x &
    -1 <= i &
    i <= 2147483644 &
    x <= 2147483645 &
    i1 <= 1 + i2 &
    i1 <= 1 + x2 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t3.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a2,1]] in ValidRW &
    -(2147483647) - 1 <= x1 & x1 < 2147483647 + 1 &
    -(2147483647) - 1 <= x3 & x3 < 2147483647 + 1 &
    [t,[a5,2147483646]] in ValidRW &
    [t,[a4,4]] in ValidRW &
    [a2,[1,[a5,2147483646]]] in Sep &
    [a6,[4,[a5,2147483646]]] in Sep &
    [a2,[1,[a4,4]]] in Sep &
    [a4,[4,[a5,2147483646]]] in Sep &
    [t,[a7,x3]] in ValidRW &
    [t,[t3,[a6,[a3,[x1,[x3,[0,0]]]]]]]
      in PLinkedN &
    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1 &
    [a11,[4,[a5,2147483646]]] in Sep &

    a10.(shft.[a4,0]) = t3.(shft.[a4,0]) &
    t1.(shft.[a4,1]) = t1.(shft.[a4,1]) &
    t1.(shft.[a4,2]) = t1.(shft.[a4,2]) &
    t1.(shft.[a4,3]) = t1.(shft.[a4,3]) &

    (i1 <= x2 implies
      ((ex z being Integer st
          a4 = t3.(shft.[a3,z]) &
          z < x & i1 <= 1 + z)
       implies a10.a8 = a9)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       [a10,[t3,[a3,[x2,i + i1 - 1]]]]
         in PSwipeLeft) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x & i1 <= 1 + z holds
          a10.(shft.[a3,z]) <> a4)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x
        holds
          a10.(shft.[a3,z]) <> a4)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       [t,[a10,[a11,[a3,[x1,[i,[0,0]]]]]]]
         in PLinkedN) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       [t,[a10,[a11,[a3,[x1,[x3,[0,0]]]]]]]
         in PLinkedN) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       [t,[a10,[t1,[t,[t3,[t1,
         [a3,[x1,x]]]]]]]] in PUnchanged) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       [t,[a10,[t1,[t,[t3,[t1,
         [a3,[x1,x4]]]]]]]] in PUnchanged) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x & i1 <= 1 + z holds
          [a2,[1,[a10.(shft.[a3,z]),4]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x
        holds
          [a2,[1,[a10.(shft.[a3,z]),4]]] in Sep)) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x & i1 <= 1 + z holds
          [a4,[4,[a10.(shft.[a3,z]),4]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x
        holds
          [a4,[4,[a10.(shft.[a3,z]),4]]] in Sep)) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z being Integer st z < x & i1 <= 1 + z holds
          [a10.(shft.[a3,z]),
            [4,[a5,2147483646]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z being Integer st
          i1 <= 1 + z & 2 + z <= x
        holds
          [a10.(shft.[a3,z]),
            [4,[a5,2147483646]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z being Integer st x2 <= z & 2 + z <= x holds
          a10.(shft.[a10.(shft.[a3,z]),0]) =
            t3.(shft.[t3.(shft.[a3,1 + z]),0]) &
          t1.(shft.[a10.(shft.[a3,z]),1]) =
            t1.(shft.[t3.(shft.[a3,1 + z]),1]) &
          t1.(shft.[a10.(shft.[a3,z]),2]) =
            t1.(shft.[t3.(shft.[a3,1 + z]),2]) &
          t1.(shft.[a10.(shft.[a3,z]),3]) =
            t1.(shft.[t3.(shft.[a3,1 + z]),3]))) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z4,z3 being Integer st
          z4 <> z3 &
          z3 < x & z4 < x &
          i1 <= 1 + z3 & i1 <= 1 + z4
        holds
          a10.(shft.[a3,z4]) <> a10.(shft.[a3,z3]))) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z4,z3 being Integer st
          z4 <> z3 &
          i1 <= 1 + z3 & i1 <= 1 + z4 &
          2 + z3 <= x & 2 + z4 <= x
        holds
          a10.(shft.[a3,z4]) <> a10.(shft.[a3,z3]))) &

    ((for z being Integer st z < x & i1 <= 1 + z holds
        a4 <> t3.(shft.[a3,z]))
     implies
       (for z4,z3 being Integer st
          z4 <> z3 &
          z3 < x & z4 < x &
          i1 <= 1 + z3 & i1 <= 1 + z4
        holds
          [a10.(shft.[a3,z4]),
            [4,[a10.(shft.[a3,z3]),4]]] in Sep)) &

    ((ex z being Integer st
        a4 = t3.(shft.[a3,z]) &
        z < x & i1 <= 1 + z)
     implies
       (for z4,z3 being Integer st
          z4 <> z3 &
          i1 <= 1 + z3 & i1 <= 1 + z4 &
          2 + z3 <= x & 2 + z4 <= x
        holds
          [a10.(shft.[a3,z4]),
            [4,[a10.(shft.[a3,z3]),4]]] in Sep)) &

    (for z being Integer st z < x & i1 <= 1 + z holds
       [a2,[1,[t3.(shft.[a3,z]),4]]] in Sep) &

    (for z being Integer st z < x & i1 <= 1 + z holds
       [t3.(shft.[a3,z]),
         [4,[a5,2147483646]]] in Sep) &

    (for z being Integer st
       a4 <> t3.(shft.[a3,z]) &
       z < x & i1 <= 1 + z
     holds
       [a4,[4,[t3.(shft.[a3,z]),4]]] in Sep) &

    (for z4,z3 being Integer st
       z4 <> z3 &
       z3 < x & z4 < x &
       i1 <= 1 + z3 & i1 <= 1 + z4
     holds
       t3.(shft.[a3,z4]) <> t3.(shft.[a3,z3])) &

    (for z4,z3 being Integer st
       z4 <> z3 &
       z3 < x & z4 < x &
       i1 <= 1 + z3 & i1 <= 1 + z4
     holds
       [t3.(shft.[a3,z4]),
         [4,[t3.(shft.[a3,z3]),4]]] in Sep) &

    a14.a2 = a11 &
    [a14.a2,[4,[a5,2147483646]]] in Sep &

    (for z being Integer st i1 <= z & z < x holds
       [a2,[1,[a14.(shft.[a3,z]),4]]] in Sep) &

    (for z being Integer st i1 <= z & z < x holds
       [a14.(shft.[a3,z]),
         [4,[a5,2147483646]]] in Sep) &

    (for z4,z3 being Integer st
       z4 <> z3 &
       i1 <= z3 & i1 <= z4 &
       z3 < x & z4 < x
     holds
       [a14.(shft.[a3,z4]),
         [4,[a14.(shft.[a3,z3]),4]]] in Sep) &

    (for z4,z3 being Integer st
       z4 <> z3 &
       x1 <= z3 & x1 <= z4 &
       z3 < x & z4 < x
     holds
       a14.(shft.[a3,z4]) <> a14.(shft.[a3,z3])) &

    [a14,[a10,[a3,[i1,x]]]] in PSwipeRight &
    [t,[a14,[a11,[a3,[i1,[i,[0,0]]]]]]]
      in PLinkedN
  holds
    [t,[a13,[t1,[t,[a12,[t1,
      [a3,[x1,x]]]]]]]] in PUnchanged
proof
end;
::$P+
