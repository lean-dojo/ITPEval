:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_copy_Why3_ide_VClist_copy_post_2_goal1:
:: updating the copied list's pointer map at one address preserves its
:: linked-list segment under framing, allocation, separation, and signed
:: 32-bit hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, FINSEQ_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t1 being Function of [:INT,INT:],[:INT,INT:],
      a,a1,a2 being Element of [:INT,INT:],
      t,reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN being set,
      i,i1,ba,oa,ba1,oa1,ba2,oa2,
      rba,rba1,rba2 being Integer
  st
    a = [ba,oa] &
    a1 = [ba1,oa1] &
    a2 = [ba2,oa2] &
    rba = reg.ba &
    rba1 = reg.ba1 &
    rba2 = reg.ba2 &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:],
          barray,oarray being Integer st
         n = N &
         array = [barray,oarray] &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.[barray,oarray + (idx + j)] = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) = mptr.(chain/.(j + 1)))) &

    rba <= 0 &
    rba1 <= 0 &
    rba2 <= 0 &
    (for p being Element of [:INT,INT:] holds
       ex bp,op,rp being Integer st
         t1.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a,1]] in ValidRW &
    [t,[a1,1]] in ValidRW &
    [t,[a2,2147483646]] in ValidRW &
    [a1,[1,[a2,2147483646]]] in Sep &
    [t1.a1,[4,[a2,2147483646]]] in Sep &
    [t,[t1,[t1.a,[a2,[i1,[i,[0,0]]]]]]] in PLinkedN &
    (for i2 being Integer st i1 <= i2 & i2 < i + i1 holds
       [a1,[1,[t1.[ba2,oa2 + i2],4]]] in Sep)
  holds
    [t,[t1+*(a1,t1.a),[(t1+*(a1,t1.a)).a,
      [a2,[i1,[i,[0,0]]]]]]] in PLinkedN
proof
end;
::$P+
