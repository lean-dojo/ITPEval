:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/array_pop_Why3_ide_VCarray_pop_post_Separation_2_goal7:
:: separation of two distinct pointer-array entries after a havoc region,
:: under linked-list, framing, validity, and separation invariants. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t2,t3,a5 being Function of [:INT,INT:],[:INT,INT:],
      a4,a1,a,a3,a2 being Element of [:INT,INT:],
      t being Function of INT,INT,
      t1 being Function of [:INT,INT:],REAL,
      reg being Function of INT,INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN,PUnchanged,PSwipeLeft being set,
      i2,i,i5,i1,i4,i3,ba4,oa4,ba1,oa1,ba,oa,ba3,oa3,
      rba4,rba1,rba,rba3 being Integer
  st
    a4 = [ba4,oa4] &
    a1 = [ba1,oa1] &
    a = [ba,oa] &
    a3 = [ba3,oa3] &
    rba4 = reg.ba4 &
    rba1 = reg.ba1 &
    rba = reg.ba &
    rba3 = reg.ba3 &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:],
          barray,oarray being Integer st
         n = N &
         array = [barray,oarray] &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.[barray,oarray + (idx + j)] = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) = mptr.(chain/.(j + 1)))) &

    (for malloc0,malloc1 being Function of INT,INT,
         mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         mflt0,mflt1 being Function of [:INT,INT:],REAL,
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [malloc0,[mptr0,[mflt0,[malloc1,[mptr1,
         [mflt1,[array,[down,up]]]]]]]] in PUnchanged iff
       ex barray,oarray being Integer st
         array = [barray,oarray] &
         (for z being Integer st down <= z & z < up holds
           ex b0,o0,b1,o1 being Integer st
             mptr0.[barray,oarray + z] = [b0,o0] &
             mptr1.[barray,oarray + z] = [b1,o1] &
             [b0,o0] = [b1,o1] &
             mptr0.[b0,o0] = mptr1.[b1,o1] &
             mflt0.[b0,o0 + 1] = mflt1.[b1,o1 + 1] &
             mflt0.[b0,o0 + 2] = mflt1.[b1,o1 + 2] &
             mflt0.[b0,o0 + 3] = mflt1.[b1,o1 + 3] &
             ([malloc1,[[b1,o1],4]] in ValidRW implies
               [malloc0,[[b0,o0],4]] in ValidRW))) &

    (for mptr0,mptr1 being
           Function of [:INT,INT:],[:INT,INT:],
         array being Element of [:INT,INT:],
         down,up being Integer
     holds
       [mptr0,[mptr1,[array,[down,up]]]] in PSwipeLeft iff
       ex barray,oarray being Integer st
         array = [barray,oarray] &
         (for z being Integer st down <= z & z < up holds
           mptr1.[barray,oarray + (1 + z)] =
             mptr0.[barray,oarray + z])) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[[ba4,oa4 + i2],i - 1]]] in Sep implies
          a5.q = t3.q) &
       (not [q,[1,[[ba4,oa4 + i2],i - 1]]] in Sep implies
          a5.q = t2.q)) &

    i4 <> i3 &
    a5.a1 = t3.a1 &
    0 < i &
    0 <= i1 &
    i1 <= i2 &
    i1 <= i3 &
    i1 <= i4 &
    i2 <= i5 &
    i5 < i + i2 &
    rba <= 0 &
    rba1 <= 0 &
    rba3 <= 0 &
    rba4 <= 0 &
    2 + i3 <= i + i2 &
    2 + i4 <= i + i2 &
    i + i2 <= 1 + i5 &
    (for p being Element of [:INT,INT:] holds
      ex bp,op,rp being Integer st
        t3.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    -(2147483647) - 1 <= i2 & i2 < 2147483647 + 1 &
    -(2147483647) - 1 <= i5 & i5 < 2147483647 + 1 &
    [t,[a4,2147483646]] in ValidRW &
    [a1,[1,[a4,2147483646]]] in Sep &
    [t3.a1,[4,[a4,2147483646]]] in Sep &
    [t,[t3,[a,[a4,[i2,[i,a3]]]]]] in PLinkedN &
    [t,[t3,[t3.[ba4,oa4 + i1],
      [a4,[i1,[i2 - i1,a]]]]]] in PLinkedN &
    [a5,[t3,[a4,[i2,i5]]]] in PSwipeLeft &
    [t,[a5,[a2,[a4,[1 + i5,
      [i + i2 - 1 - i5,a3]]]]]] in PLinkedN &
    [t,[a5,[t3.[ba4,oa4 + i1],
      [a4,[i1,[i2 - i1,a]]]]]] in PLinkedN &
    [t,[a5,[a5.a,[a4,[i2,[i5 - i2,a2]]]]]]
      in PLinkedN &
    [t,[a5,[t1,[t,[t3,[t1,[a4,[i1,i2]]]]]]]]
      in PUnchanged &
    [t,[a5,[t1,[t,[t3,[t1,[a4,[i5,i + i2]]]]]]]]
      in PUnchanged &
    (for i6 being Integer st i1 <= i6 & i6 < i + i2 holds
       [a1,[1,[t3.[ba4,oa4 + i6],4]]] in Sep) &
    (for i6 being Integer st i1 <= i6 & i6 < i + i2 holds
       [t3.[ba4,oa4 + i6],[4,[a4,2147483646]]] in Sep) &
    (for i7,i6 being Integer st
       i7 <> i6 & i1 <= i6 & i1 <= i7 &
       i6 < i + i2 & i7 < i + i2
     holds t3.[ba4,oa4 + i7] <> t3.[ba4,oa4 + i6]) &
    (for i7,i6 being Integer st
       i7 <> i6 & i1 <= i6 & i1 <= i7 &
       i6 < i + i2 & i7 < i + i2
     holds
       [t3.[ba4,oa4 + i7],
         [4,[t3.[ba4,oa4 + i6],4]]] in Sep)
  holds
    [a5.[ba4,oa4 + i4],
      [4,[a5.[ba4,oa4 + i3],4]]] in Sep
proof
end;
::$P+
