:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_list/list_remove_Why3_ide_VClist_remove_contains_item_post_Swiped_part2_goal62:
:: a list-removal verification condition states that updating the list-head
:: pointer map shifts each array entry one position to the left on the
:: specified index interval, under the stated framing, linked-chain, validity,
:: separation, uniqueness, index, and signed-integer assumptions. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, FINSEQ_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, FINSEQ_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for t1,t2,t3,t1Upd being Function of [:INT,INT:],[:INT,INT:],
      a,a1,a2,a3,a4,a5 being Element of [:INT,INT:],
      i2,i,i1,x,indexResult being Integer,
      t,reg being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LIndex being Function of
        [:Funcs([:INT,INT:],[:INT,INT:]),
          [:[:INT,INT:],[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PLinkedN being set
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or Base.p <> Base.q or
       Offset.q + qlen <= Offset.p or
       Offset.p + plen <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         root,array,bound being Element of [:INT,INT:],
         idx,n being Integer
     holds
       [malloc,[mptr,[root,[array,[idx,[n,bound]]]]]]
         in PLinkedN iff
       ex N being Nat,
          chain being FinSequence of [:INT,INT:]
       st
         n = N &
         len chain = N + 1 &
         chain/.1 = root &
         chain/.(N + 1) = bound &
         0 <= idx &
         0 <= idx + n &
         idx + n <= 2147483646 &
         (for j being Nat st j < N holds
           mptr.(shft.[array,idx + j]) = chain/.(j + 1) &
           [malloc,[chain/.(j + 1),4]] in ValidRW &
           chain/.(j + 2) =
             mptr.(shft.[chain/.(j + 1),0]))) &

    (for up,down being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st up <= down & 0 <= up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = up) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) = item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down,up]]]] = down) &

    (for down,up being Integer,
         mptr being Function of [:INT,INT:],[:INT,INT:],
         item,array being Element of [:INT,INT:]
     st mptr.(shft.[array,down]) <> item &
        0 <= down & down < up
     holds
       LIndex.[mptr,[item,[array,[down + 1,up]]]] =
         LIndex.[mptr,[item,[array,[down,up]]]]) &

    a2 = t1.a &
    a3 = t1.(shft.[a1,i2]) &
    x = i + i1 &
    a4 = shft.[a1,0] &
    a5 = t1.(shft.[a2,0]) &
    indexResult = LIndex.[t1,[a3,[a1,[i1,x]]]] &

    (for q being Element of [:INT,INT:] holds
       (q = a implies t1Upd.q = a5) &
       (q <> a implies t1Upd.q = t2.q)) &

    a2 <> [0,0] &
    a3 <> [0,0] &
    a3 = a2 &
    0 <= i &
    0 <= i1 &
    i1 <= i2 &
    i2 < x &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    reg.(Base.a2) <= 0 &
    i <= 2147483645 &
    (for p being Element of [:INT,INT:] holds
       reg.(Base.(t1.p)) <= 0) &
    t in Linked &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    [t,[a,1]] in ValidRW &
    [t,[a4,2147483646]] in ValidRW &
    [a,[1,[a4,2147483646]]] in Sep &
    [a2,[4,[a4,2147483646]]] in Sep &
    [t,[t1,[a2,[a1,[i1,[i,[0,0]]]]]]]
      in PLinkedN &
    -(2147483647) - 1 <= indexResult &
      indexResult < 2147483647 + 1 &

    (for i3 being Integer st i1 <= i3 & i3 < x holds
       [a,[1,[t1.(shft.[a1,i3]),4]]] in Sep) &

    (for i3 being Integer st i1 <= i3 & i3 < x holds
       [t1.(shft.[a1,i3]),
         [4,[a4,2147483646]]] in Sep) &

    (for i3 being Integer st
       a3 <> t1.(shft.[a1,i3]) &
       i1 <= i3 & i3 < x
     holds
       [a3,[4,[t1.(shft.[a1,i3]),4]]] in Sep) &

    (for i4,i3 being Integer st
       i4 <> i3 &
       i1 <= i3 & i1 <= i4 &
       i3 < x & i4 < x
     holds
       t1.(shft.[a1,i4]) <> t1.(shft.[a1,i3])) &

    (for i4,i3 being Integer st
       i4 <> i3 &
       i1 <= i3 & i1 <= i4 &
       i3 < x & i4 < x
     holds
       [t1.(shft.[a1,i4]),
         [4,[t1.(shft.[a1,i3]),4]]] in Sep) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a1,i1],i - 1]]] in Sep
          implies t2.q = t1.q) &
       (not [q,[1,[shft.[a1,i1],i - 1]]] in Sep
          implies t2.q = t3.q)) &

    (for i3 being Integer st
       i1 <= i3 & i3 < i + i1 - 1
     holds
       t1.(shft.[a1,1 + i3]) = t2.(shft.[a1,i3]))
  holds
    for i3 being Integer st
      indexResult <= i3 & i3 < i + i1 - 1
    holds
      t1.(shft.[a1,1 + i3]) = t1Upd.(shft.[a1,i3])
proof
end;
::$P+
