:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_numfree_Why3_ide_VCmemb_numfree_assert_rte_signed_overflow_goal9:
:: the memb free-slot count, address, framing, C integer-range, and
:: memory-validity assumptions imply the required signed 32-bit upper bound
:: for the number of free slots before the current index. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a0,a1,a2,a3,a4,aux,pool0,aux0
        being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      LOcc being Function of
        [:Funcs([:INT,INT:],INT),
          [:INT,[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      i,x,x1,esize,ts being Integer
  st
    (for p being Element of [:INT,INT:], k being Integer holds
       ex b,o being Integer st
         p = [b,o] & shft.[p,k] = [b,o + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           bp <> 0 & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    (for mchar being Function of [:INT,INT:],INT,
         e,from0,to0 being Integer,
         p being Element of [:INT,INT:]
     st to0 <= from0
     holds
       LOcc.[mchar,[e,[p,[from0,to0]]]] = 0) &

    (for mchar being Function of [:INT,INT:],INT,
         e,from0,to0,prev,curr being Integer,
         p being Element of [:INT,INT:]
     st mchar.(shft.[p,to0 - 1]) = e & from0 < to0 &
        prev = LOcc.[mchar,[e,[p,[from0,to0 - 1]]]] &
        curr = LOcc.[mchar,[e,[p,[from0,to0]]]]
     holds
       1 + prev = curr) &

    (for mchar being Function of [:INT,INT:],INT,
         e,from0,to0 being Integer,
         p being Element of [:INT,INT:]
     st mchar.(shft.[p,to0 - 1]) <> e & from0 < to0
     holds
       LOcc.[mchar,[e,[p,[from0,to0 - 1]]]] =
         LOcc.[mchar,[e,[p,[from0,to0]]]]) &

    a1 = shft.[a,2] &
    a2 = t3.a1 &
    a3 = shft.[a2,i] &
    a4 = shft.[a,1] &
    x = t1.a4 &
    x1 = LOcc.[t2,[0,[a2,[0,i]]]] &

    t2.a3 = 0 &
    0 <= i &
    i < x &
    i <= x &
    (ex ba,oa,rba being Integer st
       a = [ba,oa] & rba = reg.ba & rba <= 0) &
    x1 <= i &
    (for p being Element of [:INT,INT:] holds
       ex bp,op,rp being Integer st
         t3.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    t2 in SConst &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    0 <= x & x < 65536 &

    a0 = shft.[a,0] &
    esize = t1.a0 &
    ts = x * esize &
    aux = t3.(shft.[a,3]) &
    pool0 = shft.[a2,0] &
    aux0 = shft.[aux,0] &
    0 < esize &
    ts <= 2147483647 &
    [t,[a,4]] in ValidRW &
    [t,[a2,1]] in ValidRW &
    [t,[aux,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,ts]] in ValidRW &
    [pool0,[x,[aux0,ts]]] in Sep &

    [t,[a1,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    [t,[a3,1]] in ValidRD &
    -(2147483647) - 1 <= x1 & x1 < 2147483647 + 1
  holds
    x1 <= 2147483646
proof
end;
::$P+
