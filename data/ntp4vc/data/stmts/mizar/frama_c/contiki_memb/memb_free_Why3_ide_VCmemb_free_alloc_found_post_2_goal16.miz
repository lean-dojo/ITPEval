:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_free_Why3_ide_VCmemb_free_alloc_found_post_2_goal16:
:: the memb deallocator's address, framing, C integer-range, memory-validity,
:: allocation, update, and non-aliasing assumptions imply that freeing the
:: allocated slot increases the counted number of free slots by one.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, INT_3, NAT_1, VALUED_0, VALUED_1,
    ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, INT_3,
    XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,pool,aux,pool0,aux0,ptri
        being Element of [:INT,INT:],
      t5 being Function of [:INT,INT:],[:INT,INT:],
      t2,t4,t3 being Function of [:INT,INT:],INT,
      t,t1,reg being Function of INT,INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      LOcc being Function of
        [:Funcs([:INT,INT:],INT),
          [:INT,[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      i1,i,x,esize,indexi,indexa,count4,count3 being Integer
  st
    (for p being Element of [:INT,INT:], k being Integer holds
       ex b,o being Integer st
         p = [b,o] & shft.[p,k] = [b,o + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           bp <> 0 & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    (for mchar being Function of [:INT,INT:],INT,
         e,from0,to0 being Integer,
         p being Element of [:INT,INT:]
     st to0 <= from0
     holds
       LOcc.[mchar,[e,[p,[from0,to0]]]] = 0) &

    (for mchar being Function of [:INT,INT:],INT,
         e,from0,to0,prev,curr being Integer,
         p being Element of [:INT,INT:]
     st mchar.(shft.[p,to0 - 1]) = e & from0 < to0 &
        prev = LOcc.[mchar,[e,[p,[from0,to0 - 1]]]] &
        curr = LOcc.[mchar,[e,[p,[from0,to0]]]]
     holds
       1 + prev = curr) &

    (for mchar being Function of [:INT,INT:],INT,
         e,from0,to0 being Integer,
         p being Element of [:INT,INT:]
     st mchar.(shft.[p,to0 - 1]) <> e & from0 < to0
     holds
       LOcc.[mchar,[e,[p,[from0,to0 - 1]]]] =
         LOcc.[mchar,[e,[p,[from0,to0]]]]) &

    a2 = shft.[a1,1] &
    x = t2.a2 &
    a3 = shft.[a1,3] &
    a4 = shft.[a1,2] &
    pool = t5.a4 &
    aux = t5.a3 &
    a5 = shft.[pool,i1] &
    esize = t2.(shft.[a1,0]) &
    pool0 = shft.[pool,0] &
    aux0 = shft.[aux,0] &
    ptri = shft.[aux,i * esize] &

    (ex bi,oi,baux,oaux,ba,oa being Integer st
       ptri = [bi,oi] &
       aux = [baux,oaux] &
       a = [ba,oa] &
       indexi = TDiv.[oi - oaux,esize] &
       indexa = TDiv.[oa - oaux,esize]) &

    indexi = i &
    0 <= i &
    i <= x &
    (ex ba,oa,rba being Integer st
       a = [ba,oa] & rba = reg.ba & rba <= 0) &
    (ex ba1,oa1,rba1 being Integer st
       a1 = [ba1,oa1] & rba1 = reg.ba1 & rba1 <= 0) &
    (for p being Element of [:INT,INT:] holds
       ex bp,op,rp being Integer st
         t5.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    t4 in SConst &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    0 <= x & x < 65536 &

    0 < esize &
    x * esize <= 2147483647 &
    [t,[a1,4]] in ValidRW &
    [t,[pool,1]] in ValidRW &
    [t,[aux,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,x * esize]] in ValidRW &
    [pool0,[x,[aux0,x * esize]]] in Sep &

    (ex j being Integer st
       shft.[aux,j * esize] = a &
       0 <= j & j < x) &
    [t,[a3,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    t4.(shft.[pool,indexa]) <> 0 &
    (ex j being Integer st
       shft.[aux,j * esize] = a &
       0 <= j & j < x) &

    ((i < x implies
        i1 = i &
        t1 = t &
        shft.[aux,i1 * esize] = a &
        t4+*(a5,0) = t3 &
        [t1,[a4,1]] in ValidRD &
        [t1,[a5,1]] in ValidRD &
        [t1,[a5,1]] in ValidRW) &
     (not i < x implies t4 = t3)) &

    (for i2 being Integer st 0 <= i2 & i2 < i holds
       shft.[aux,i2 * esize] <> a) &
    count4 = LOcc.[t4,[0,[pool,[0,x]]]] &
    count3 = LOcc.[t3,[0,[pool,[0,x]]]]
  holds
    1 + count4 = count3
proof
end;
::$P+
