:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_alloc_Why3_ide_VCmemb_alloc_free_found_post_goal15:
:: the memb allocator's memory-model, framing, integer-range, validity,
:: update, and nonzero-prefix assumptions yield an index for the found free
:: slot together with the required unchanged-memory property. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,a6,a7,a8,pool0,aux0
        being Element of [:INT,INT:],
      t4 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2,t3 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      i2,i,i1,x,x1,x2,ts being Integer
  st
    (for p being Element of [:INT,INT:], k being Integer holds
       ex b,o being Integer st
         p = [b,o] & shft.[p,k] = [b,o + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           bp <> 0 & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    a2 = shft.[a1,2] &
    a3 = t4.a2 &
    a4 = shft.[a1,1] &
    x = t1.a4 &
    a5 = shft.[a1,0] &
    x1 = t1.a5 &
    a6 = shft.[a3,i2] &
    a7 = shft.[a1,3] &
    a8 = t4.a7 &
    x2 = i2 * x1 &
    pool0 = shft.[a3,0] &
    aux0 = shft.[a8,0] &
    ts = x * x1 &

    t3.(shft.[a3,i]) = 0 &
    0 <= i &
    0 <= i1 &
    i < x &
    i1 <= x &
    (ex ba,oa,rba being Integer st
       a1 = [ba,oa] & rba = reg.ba & rba <= 0) &
    (for p being Element of [:INT,INT:] holds
       ex bp,op,rp being Integer st
         t4.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    t3 in SConst &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &
    -(2147483647) - 1 <= i2 & i2 < 2147483647 + 1 &
    0 <= x & x < 65536 &
    0 <= x1 & x1 < 65536 &

    0 < x1 &
    ts <= 2147483647 &
    [t,[a1,4]] in ValidRW &
    [t,[a3,1]] in ValidRW &
    [t,[a8,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,ts]] in ValidRW &
    [pool0,[x,[aux0,ts]]] in Sep &

    [t,[a4,1]] in ValidRD &
    ((i1 < x implies
        i2 = i1 &
        t3.a6 = 0 &
        t3+*(a6,1) = t2 &
        shft.[a8,x2] = a &
        -(2147483647) - 1 <= x2 &
        x2 <= 2147483647 &
        [t,[a2,1]] in ValidRD &
        [t,[a7,1]] in ValidRD &
        [t,[a5,1]] in ValidRD &
        [t,[a6,1]] in ValidRD &
        [t,[a6,1]] in ValidRW) &
     (not i1 < x implies
        t3 = t2 & a = [0,0])) &
    (for i3 being Integer st 0 <= i3 & i3 < i1 holds
       t3.(shft.[a3,i3]) <> 0)
  holds
    ex i3 being Integer st
      t2.(shft.[a3,i3]) = 1 &
      t3.(shft.[a3,i3]) = 0 &
      shft.[a8,i3 * x1] = a &
      0 <= i3 &
      i3 < x &
      (for i4 being Integer st
         (0 <= i4 & i4 < i3) or (i3 < i4 & i4 < x)
       holds
         t3.(shft.[a3,i4]) = t2.(shft.[a3,i4]))
proof
end;
::$P+
