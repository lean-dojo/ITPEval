:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_free_Why3_ide_VCmemb_free_loop_inv_established_goal3:
:: the memb deallocator's region, framing, integer-range, allocation-layout,
:: separation, and read-validity assumptions imply that its stored unsigned
:: 16-bit field is nonnegative. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,pool,aux,pool0,aux0 being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      bas,offs being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      x,esize being Integer
  st
    (for b,o being Integer holds
       bas.[b,o] = b & offs.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [bas.p,offs.p + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or bas.p <> bas.q or
       offs.q + qlen <= offs.p or offs.p + plen <= offs.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         bas.p <> 0 & 0 <= offs.p &
         offs.p + n <= malloc.(bas.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < bas.p & 0 <= offs.p &
         offs.p + n <= malloc.(bas.p))) &

    x = t1.(shft.[a1,1]) &
    esize = t1.(shft.[a1,0]) &
    pool = t3.(shft.[a1,2]) &
    aux = t3.(shft.[a1,3]) &
    pool0 = shft.[pool,0] &
    aux0 = shft.[aux,0] &

    reg.(bas.a) <= 0 &
    reg.(bas.a1) <= 0 &
    (for p being Element of [:INT,INT:] holds
       reg.(bas.(t3.p)) <= 0) &
    t in Linked &
    t2 in SConst &
    0 <= x & x < 65536 &

    0 < esize &
    x * esize <= 2147483647 &
    [t,[a1,4]] in ValidRW &
    [t,[pool,1]] in ValidRW &
    [t,[aux,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,x * esize]] in ValidRW &
    [pool0,[x,[aux0,x * esize]]] in Sep &

    [t,[shft.[a1,3],1]] in ValidRD
  holds
    0 <= x
proof
end;
::$P+
