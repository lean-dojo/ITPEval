:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_init_Why3_ide_VCmemb_init_call_memset_pre_valid_s_2_goal10:
:: the memb initializer's framing, integer-range, record-validity,
:: memory-validity, zeroing, and separation assumptions imply that the
:: auxiliary block is valid or empty at the converted product size.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,a6,pool0,aux0
        being Element of [:INT,INT:],
      t4 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2,t3 being Function of [:INT,INT:],INT,
      t,reg,BaseOffset,BaseIndex,ToUint32 being Function of INT,INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      x,x1,x2 being Integer
  st
    (for p being Element of [:INT,INT:], k being Integer holds
       ex b,o being Integer st
         p = [b,o] & shft.[p,k] = [b,o + k]) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           bp <> 0 & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    BaseOffset.0 = 0 &
    (for i being Integer holds
       ex oi being Integer st
         oi = BaseOffset.i & BaseIndex.oi = i) &
    (for i,j being Integer st i < j holds
       ex oi,oj being Integer st
         oi = BaseOffset.i & oj = BaseOffset.j & oi < oj) &

    (for i being Integer holds
       ex ui being Integer st
         ui = ToUint32.i & 0 <= ui & ui < 65536 * 65536) &
    (for i being Integer st 0 <= i & i < 65536 * 65536 holds
       ToUint32.i = i) &

    a1 = shft.[a,1] &
    x = t1.a1 &
    a2 = shft.[a,0] &
    x1 = t1.a2 &
    x2 = x * x1 &
    a3 = shft.[a,2] &
    a4 = shft.[a,3] &
    a5 = t4.a3 &
    a6 = t4.a4 &
    pool0 = shft.[a5,0] &
    aux0 = shft.[a6,0] &

    (ex ba,oa,rba being Integer st
       a = [ba,oa] & rba = reg.ba & rba <= 0) &
    -(2147483647) - 1 <= x2 &
    x2 <= 2147483647 &
    (for p being Element of [:INT,INT:] holds
       ex bp,op,rp being Integer st
         t4.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    t3 in SConst &
    0 <= x & x < 65536 &
    0 <= x1 & x1 < 65536 &

    0 < x1 &
    x2 <= 2147483647 &
    [t,[a,4]] in ValidRW &
    [t,[a5,1]] in ValidRW &
    [t,[a6,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,x2]] in ValidRW &
    [pool0,[x,[aux0,x2]]] in Sep &

    [t,[a3,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    [t,[a1,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &

    [t,[pool0,x]] in ValidRW &
    ((ex b5,o5 being Integer st
        a5 = [b5,o5] & t.b5 = 0 & BaseOffset.o5 = 0) or
      [t,[a5,1]] in ValidRD) &

    (for i being Integer st 0 <= i & i < x holds
       ([shft.[a5,i],[1,[pool0,x]]] in Sep implies
          t3.(shft.[a5,i]) = 0) &
       (not [shft.[a5,i],[1,[pool0,x]]] in Sep implies
          t2.(shft.[a5,i]) = 0))
  holds
    [t,[aux0,ToUint32.x2]] in ValidRW &
    ((ex b6,o6 being Integer st
        a6 = [b6,o6] & t.b6 = 0 & BaseOffset.o6 = 0) or
      [t,[a6,1]] in ValidRD)
proof
end;
::$P+
