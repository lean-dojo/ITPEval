:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_free_Why3_ide_VCmemb_free_elem_notfound_post_goal21:
:: the memb deallocator's address, framing, C integer-range, memory-validity,
:: allocation-layout, non-membership, and preceding-slot assumptions imply
:: that the byte read at the candidate pool slot is zero.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,pool,aux,pool0,aux0
        being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      i,x,x1,esize,indexi being Integer
  st
    (for p being Element of [:INT,INT:], k being Integer holds
       ex b,o being Integer st
         p = [b,o] & shft.[p,k] = [b,o + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       ex bp,op,bq,oq being Integer st
         p = [bp,op] & q = [bq,oq] &
         (plen <= 0 or qlen <= 0 or bp <> bq or
          oq + qlen <= op or op + plen <= oq)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           bp <> 0 & 0 <= op & op + n <= mv)) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       ex bp,op,mv being Integer st
         p = [bp,op] &
         mv = malloc.bp &
         (0 < n implies
           0 < bp & 0 <= op & op + n <= mv)) &

    a2 = shft.[a,1] &
    x = t1.a2 &
    a3 = shft.[a,2] &
    a4 = shft.[a,3] &
    pool = t3.a3 &
    aux = t3.a4 &
    a5 = shft.[pool,i] &
    x1 = t2.a5 &
    esize = t1.(shft.[a,0]) &
    pool0 = shft.[pool,0] &
    aux0 = shft.[aux,0] &
    a1 = shft.[aux,i * esize] &

    (ex ba1,oa1,baux,oaux being Integer st
       a1 = [ba1,oa1] &
       aux = [baux,oaux] &
       indexi = TDiv.[oa1 - oaux,esize]) &
    indexi = i &
    0 <= i &
    i < x &

    (ex ba,oa,rba being Integer st
       a = [ba,oa] & rba = reg.ba & rba <= 0) &
    (ex ba1,oa1,rba1 being Integer st
       a1 = [ba1,oa1] & rba1 = reg.ba1 & rba1 <= 0) &
    (for p being Element of [:INT,INT:] holds
       ex bp,op,rp being Integer st
         t3.p = [bp,op] & rp = reg.bp & rp <= 0) &
    t in Linked &
    t2 in SConst &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    0 <= x & x < 65536 &

    0 < esize &
    x * esize <= 2147483647 &
    [t,[a,4]] in ValidRW &
    [t,[pool,1]] in ValidRW &
    [t,[aux,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,x * esize]] in ValidRW &
    [pool0,[x,[aux0,x * esize]]] in Sep &

    [t,[a3,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    -(127) - 1 <= x1 & x1 < 127 + 1 &
    [t,[a5,1]] in ValidRD &
    [t,[a5,1]] in ValidRW &

    not (ex j being Integer st
       shft.[aux,j * esize] = a1 &
       0 <= j & j < x) &
    (for i1 being Integer st 0 <= i1 & i1 < i holds
       shft.[aux,i1 * esize] <> a1)
  holds
    x1 = 0
proof
end;
::$P+
