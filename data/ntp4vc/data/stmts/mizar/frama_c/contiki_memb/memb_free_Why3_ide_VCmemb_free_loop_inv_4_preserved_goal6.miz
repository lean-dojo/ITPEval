:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/contiki_memb/memb_free_Why3_ide_VCmemb_free_loop_inv_4_preserved_goal6:
:: the memb deallocator's address, framing, C integer-range, memory-validity,
:: separation, and preceding-index assumptions imply that the pointer at the
:: successor index maps back to that successor index. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,pool,aux,pool0,aux0,ptr2
        being Element of [:INT,INT:],
      t3 being Function of [:INT,INT:],[:INT,INT:],
      t1,t2 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      bas,offs being Function of [:INT,INT:],INT,
      shft being Function of [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      SConst being Subset of Funcs([:INT,INT:],INT),
      Sep,ValidRD,ValidRW being set,
      i,x,x1,x2 being Integer
  st
    (for b,o being Integer holds
       bas.[b,o] = b & offs.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [bas.p,offs.p + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for p,q being Element of [:INT,INT:],
         plen,qlen being Integer
     holds
       [p,[plen,[q,qlen]]] in Sep iff
       plen <= 0 or qlen <= 0 or bas.p <> bas.q or
       offs.q + qlen <= offs.p or offs.p + plen <= offs.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         bas.p <> 0 & 0 <= offs.p &
         offs.p + n <= malloc.(bas.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < bas.p & 0 <= offs.p &
         offs.p + n <= malloc.(bas.p))) &

    a5 = shft.[a1,3] &
    aux = t3.a5 &
    x1 = t1.(shft.[a1,0]) &
    a2 = shft.[aux,i * x1] &
    a3 = shft.[a1,1] &
    x = t1.a3 &
    a4 = shft.[a1,0] &
    x2 = 1 + i &
    pool = t3.(shft.[a1,2]) &
    pool0 = shft.[pool,0] &
    aux0 = shft.[aux,0] &
    ptr2 = shft.[aux,x2 * x1] &

    a2 <> a &
    TDiv.[offs.a2 - offs.aux,x1] = i &
    0 <= i &
    i < x &
    i <= x &
    reg.(bas.a) <= 0 &
    reg.(bas.a1) <= 0 &
    i <= 2147483646 &
    (for p being Element of [:INT,INT:] holds
       reg.(bas.(t3.p)) <= 0) &
    t in Linked &
    t2 in SConst &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    0 <= x & x < 65536 &
    0 <= x1 & x1 < 65536 &
    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1 &

    0 < x1 &
    x * x1 <= 2147483647 &
    [t,[a1,4]] in ValidRW &
    [t,[pool,1]] in ValidRW &
    [t,[aux,1]] in ValidRW &
    [t,[pool0,x]] in ValidRW &
    [t,[aux0,x * x1]] in ValidRW &
    [pool0,[x,[aux0,x * x1]]] in Sep &

    [t,[a5,1]] in ValidRD &
    [t,[a3,1]] in ValidRD &
    [t,[a4,1]] in ValidRD &
    (for i1 being Integer st 0 <= i1 & i1 < i holds
       shft.[t3.a5,i1 * x1] <> a)
  holds
    x2 = TDiv.[offs.ptr2 - offs.aux,x1]
proof
end;
::$P+
