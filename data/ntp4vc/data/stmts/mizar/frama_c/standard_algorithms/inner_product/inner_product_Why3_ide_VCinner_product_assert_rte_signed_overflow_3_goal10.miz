:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/inner_product/inner_product_Why3_ide_VCinner_product_assert_rte_signed_overflow_3_goal10:
:: the inner-product verification condition requires the next accumulated
:: product to remain above the signed 32-bit minimum under the stated index,
:: memory-validity, product-bound, and partial-sum-bound assumptions.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToSint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LInner being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:[:INT,INT:],[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      ValidRD being set,
      i2,i1,i,x,x1,x2,y being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z,u being Integer st u = ToSint32.z holds
       -(2147483647) - 1 <= u &
       u < 2147483647 + 1) &

    (for z being Integer st
       -(2147483647) - 1 <= z & z < 2147483647 + 1
     holds
       ToSint32.z = z) &

    (for m being Function of [:INT,INT:],INT,
         p,q being Element of [:INT,INT:],
         n,init being Integer
     st
       n <= 0 &
       -(2147483647) - 1 <= init & init < 2147483647 + 1
     holds
       LInner.[m,[p,[q,[n,init]]]] = init) &

    (for m being Function of [:INT,INT:],INT,
         p,q being Element of [:INT,INT:],
         n,init,prev,curr,u,v being Integer
     st
       0 < n &
       -(2147483647) - 1 <= init & init < 2147483647 + 1 &
       prev = LInner.[m,[p,[q,[n - 1,init]]]] &
       curr = LInner.[m,[p,[q,[n,init]]]] &
       u = m.(shft.[p,n - 1]) &
       v = m.(shft.[q,n - 1])
     holds
       prev + u * v = curr) &

    (for m0,m1 being Function of [:INT,INT:],INT,
         p,q being Element of [:INT,INT:],
         n,init being Integer
     st
       -(2147483647) - 1 <= init & init < 2147483647 + 1 &
       (for j being Integer st 0 <= j & j < n holds
          m1.(shft.[p,j]) = m0.(shft.[p,j]) &
          m1.(shft.[q,j]) = m0.(shft.[q,j]))
     holds
       LInner.[m1,[p,[q,[n,init]]]] =
       LInner.[m0,[p,[q,[n,init]]]]) &

    x = t1.(shft.[a,i2]) &
    x1 = t1.(shft.[a1,i2]) &
    x2 = LInner.[t1,[a1,[a,[i2,i1]]]] &
    y = ToSint32.(x * x1) &

    i2 <= i &
    0 <= i2 &
    i2 < i &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i1 & i1 < 2147483647 + 1 &

    (for j,u,v being Integer st
       u = t1.(shft.[a1,j]) &
       v = t1.(shft.[a,j]) &
       0 <= j & j < i
     holds
       -(2147483647) - 1 <= u * v &
       u * v <= 2147483647) &

    -(2147483647) - 1 <= x & x < 2147483647 + 1 &
    -(2147483647) - 1 <= x1 & x1 < 2147483647 + 1 &

    (for j,s being Integer st
       s = LInner.[t1,[a1,[a,[j,i1]]]] &
       j <= i & 0 <= j
     holds
       -(2147483647) - 1 <= s &
       s <= 2147483647) &

    [t,[shft.[a,0],i]] in ValidRD &
    [t,[shft.[a1,0],i]] in ValidRD &
    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1
  holds
    -(2147483647) - 1 <= x2 + y
proof
end;
::$P+
