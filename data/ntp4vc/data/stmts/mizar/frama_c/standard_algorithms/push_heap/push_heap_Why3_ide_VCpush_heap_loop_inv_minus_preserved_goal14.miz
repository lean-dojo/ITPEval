:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/push_heap/push_heap_Why3_ide_VCpush_heap_loop_inv_minus_preserved_goal14:
:: the push-heap loop verification condition preserves the multiset-minus
:: invariant for the displaced child value after updating that child with its
:: parent value, under the stated heap, memory-validity, linkage, region,
:: multiset-count, and C integer-range hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3,a5,a7,a9 being Element of [:INT,INT:],
      t2,t1,m,a4,a10 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,i1,x,x1,x2,x3,a6,x4,a8,hp1 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for p,q being Element of [:INT,INT:],
         lenp,lenq being Integer
     holds
       [p,[lenp,[q,lenq]]] in Sep iff
       lenp <= 0 or lenq <= 0 or Base.p <> Base.q or
       Offset.q + lenq <= Offset.p or
       Offset.p + lenp <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for n,first0,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st n <= first0 &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[first0,[n,v]]]] = 0) &

    (for n,first0,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) = v &
          first0 < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[p,[first0,[n-1,v]]]] &
         c1 = Count.[mint,[p,[first0,[n,v]]]] &
         1 + c0 = c1) &

    (for n,first0,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) <> v &
          first0 < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[first0,[n-1,v]]]] =
         Count.[mint,[p,[first0,[n,v]]]]) &

    (for first0,last0,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st first0 <= j & j < last0 holds
             mint1.(shft.[p,j]) = mint0.(shft.[p,j]))
     holds
       Count.[mint1,[p,[first0,[last0,v]]]] =
         Count.[mint0,[p,[first0,[last0,v]]]]) &

    x = i - 1 &
    x1 = TDiv.[x-1,2] &
    a1 = shft.[a,x1] &
    x2 = t2.a1 &
    a2 = shft.[a,x] &
    x3 = t2.a2 &

    (for q being Element of [:INT,INT:] holds
       (q = a2 implies m.q = x2) &
       (q <> a2 implies m.q = t2.q)) &

    a3 = shft.[a,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a3,i]]] in Sep implies a4.q = m.q) &
       (not [q,[1,[a3,i]]] in Sep implies a4.q = t1.q)) &

    a5 = shft.[a,i1] &
    a6 = a4.a5 &
    x4 = TDiv.[i1-1,2] &
    a7 = shft.[a,x4] &
    a8 = a4.a7 &
    a9 = shft.[a,ToUint32.x] &

    (for q being Element of [:INT,INT:] holds
       (q = a5 implies a10.q = a8) &
       (q <> a5 implies a10.q = a4.q)) &

    hp1 = TDiv.[x1-1,2] &

    0 < i &
    0 < i1 &
    0 <= i1 &
    reg.(Base.a) <= 0 &
    0 < x1 &
    x2 < x3 &
    a6 < x3 &
    a6 < a8 &
    a8 < x3 &
    2 <= i &
    2 + i1 <= i &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= x4 & x4 < 2147483647 + 2147483647 + 2 &
    [t,[a5,1]] in ValidRD &
    [t,[a3,i]] in ValidRW &
    [t,[a5,1]] in ValidRW &
    0 <= x1 & x1 < 2147483647 + 2147483647 + 2 &

    (for j being Integer st 0 < j & j < x holds
       ex child,parent being Integer st
         child = t2.(shft.[a,j]) &
         parent = t2.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    [t,[a7,1]] in ValidRD &
    0 <= hp1 & hp1 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= x3 & x3 < 2147483647 + 1 &
    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1 &
    [t,[a9,1]] in ValidRD &
    [t,[a1,1]] in ValidRD &
    [t,[a9,1]] in ValidRW &
    -(2147483647) - 1 <= m.a1 & m.a1 < 2147483647 + 1 &
    -(2147483647) - 1 <= a6 & a6 < 2147483647 + 1 &
    -(2147483647) - 1 <= a8 & a8 < 2147483647 + 1 &

    (for j being Integer st 0 < j & j < i holds
       ex child,parent being Integer st
         child = a4.(shft.[a,j]) &
         parent = a4.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    -(2147483647) - 1 <= a10.a7 &
    a10.a7 < 2147483647 + 1 &

    (ex oldCount,newCount being Integer st
       oldCount = Count.[a4,[a,[0,[i,x3]]]] &
       newCount = Count.[t2,[a,[0,[i,x3]]]] &
       1 + oldCount = newCount) &

    (ex oldCount,newCount being Integer st
       oldCount = Count.[t2,[a,[0,[i,a6]]]] &
       newCount = Count.[a4,[a,[0,[i,a6]]]] &
       1 + oldCount = newCount) &

    (for v being Integer st
       v <> x3 &
       v <> a6 &
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t2,[a,[0,[i,v]]]] =
         Count.[a4,[a,[0,[i,v]]]])
  holds
    ex oldCount,newCount being Integer st
      oldCount = Count.[a10,[a,[0,[i,x3]]]] &
      newCount = Count.[t2,[a,[0,[i,x3]]]] &
      1 + oldCount = newCount
proof
end;
::$P+
