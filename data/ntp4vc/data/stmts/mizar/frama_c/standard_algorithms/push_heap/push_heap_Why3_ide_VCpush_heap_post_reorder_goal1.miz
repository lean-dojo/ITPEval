:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/push_heap/push_heap_Why3_ide_VCpush_heap_post_reorder_goal1:
:: the push-heap post-reorder verification condition preserves the occurrence
:: count of every signed 32-bit value in the array prefix after the stated
:: conditional memory updates, under the heap, validity, linkage, region,
:: multiset-count, and C integer-range assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5,a6 being Element of [:INT,INT:],
      t4,t2,t3,t1,m being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      p1,p being Element of BOOLEAN,
      i1,i5,i3,i,i2,i4,x,x1,x2,x3 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for q being Element of [:INT,INT:], k being Integer holds
       shft.[q,k] = [Base.q,Offset.q + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for q,r being Element of [:INT,INT:],
         lenq,lenr being Integer
     holds
       [q,[lenq,[r,lenr]]] in Sep iff
       lenq <= 0 or lenr <= 0 or Base.q <> Base.r or
       Offset.r + lenr <= Offset.q or
       Offset.q + lenq <= Offset.r) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRD iff
       (0 < n implies
         Base.q <> 0 &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRW iff
       (0 < n implies
         0 < Base.q &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    (for n,first0,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st n <= first0 &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[q,[first0,[n,v]]]] = 0) &

    (for n,first0,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st mint.(shft.[q,n-1]) = v &
          first0 < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[q,[first0,[n-1,v]]]] &
         c1 = Count.[mint,[q,[first0,[n,v]]]] &
         1 + c0 = c1) &

    (for n,first0,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st mint.(shft.[q,n-1]) <> v &
          first0 < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[q,[first0,[n-1,v]]]] =
         Count.[mint,[q,[first0,[n,v]]]]) &

    (for first0,last0,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st first0 <= j & j < last0 holds
             mint1.(shft.[q,j]) = mint0.(shft.[q,j]))
     holds
       Count.[mint1,[q,[first0,[last0,v]]]] =
         Count.[mint0,[q,[first0,[last0,v]]]]) &

    a1 = shft.[a,0] &
    x = i1 - 1 &
    a2 = shft.[a,i5] &
    a3 = shft.[a,ToUint32.x] &
    x1 = t4.a2 &
    a4 = shft.[a,x] &
    x2 = t4.a4 &
    a5 = shft.[a,i3] &

    (for q being Element of [:INT,INT:] holds
       (q = a4 implies m.q = x1) &
       (q <> a4 implies m.q = t4.q)) &

    x3 = t2.a5 &
    a6 = shft.[a,i] &

    0 < i1 &
    reg.(Base.a) <= 0 &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= i4 & i4 < 2147483647 + 2147483647 + 2 &
    0 <= i5 & i5 < 2147483647 + 2147483647 + 2 &
    [t,[a1,i1]] in ValidRW &

    (for j being Integer st 0 < j & j < x holds
       ex child,parent being Integer st
         child = t4.(shft.[a,j]) &
         parent = t4.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    ((2 <= i1 &
       p1 = FALSE &
       TDiv.[x-1,2] = i5 &
       [t,[a2,1]] in ValidRD &
       [t,[a3,1]] in ValidRD &

       ((x1 < x2 &
         (for q being Element of [:INT,INT:] holds
            (q = a5 implies t3.q = x2) &
            (q <> a5 implies t3.q = t2.q)) &
         [t,[a5,1]] in ValidRW &
         [t,[a3,1]] in ValidRW &

         ((0 < i5 &
           p = FALSE &
           i3 = i2 &
           i4 = i2 &
           i4 = i3 &
           TDiv.[i3-1,2] = i &

           (for q being Element of [:INT,INT:] holds
              ([q,[1,[a1,i1]]] in Sep implies t2.q = m.q) &
              (not [q,[1,[a1,i1]]] in Sep implies t2.q = t1.q)) &

           0 <= i3 &
           x3 < x2 &
           2 + i3 <= i1 &

           (for j being Integer st 0 < j & j < i1 holds
              ex child,parent being Integer st
                child = t2.(shft.[a,j]) &
                parent = t2.(shft.[a,TDiv.[j-1,2]]) &
                child <= parent) &

           (ex oldCount,newCount being Integer st
              oldCount = Count.[t4,[a,[0,[i1,x3]]]] &
              newCount = Count.[t2,[a,[0,[i1,x3]]]] &
              1 + oldCount = newCount) &

           (ex oldCount,newCount being Integer st
              oldCount = Count.[t2,[a,[0,[i1,x2]]]] &
              newCount = Count.[t4,[a,[0,[i1,x2]]]] &
              1 + oldCount = newCount) &

           (for v being Integer st
              v <> x2 &
              v <> x3 &
              -(2147483647) - 1 <= v & v < 2147483647 + 1
            holds
              Count.[t4,[a,[0,[i1,v]]]] =
                Count.[t2,[a,[0,[i1,v]]]]) &

           (i3 <= 0 or
             (x2 <= t2.a6 & [t,[a6,1]] in ValidRD)))
          or
          (not 0 < i5 & i5 = i3 & m = t2)))
        or
        (not x1 < x2 & t4 = t3)))
     or
     (not 2 <= i1 & t4 = t3))
  holds
    for v being Integer st
      -(2147483647) - 1 <= v & v < 2147483647 + 1
    holds
      Count.[t4,[a,[0,[i1,v]]]] =
        Count.[t3,[a,[0,[i1,v]]]]
proof
end;
::$P+
