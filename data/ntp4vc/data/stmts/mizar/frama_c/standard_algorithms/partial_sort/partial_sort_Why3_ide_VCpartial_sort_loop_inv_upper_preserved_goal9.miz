:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/partial_sort/partial_sort_Why3_ide_VCpartial_sort_loop_inv_upper_preserved_goal9:
:: the partial-sort loop verification condition preserves that the updated
:: heap prefix is bounded above by its root value, under the stated havoc,
:: swap, heap, multiset, memory, region, linkage, and C integer-range
:: assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a5,a8 being Element of [:INT,INT:],
      t1,t5,t2,t3,t4,a2,a3,a4,a10,a13
        being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i2,i1,i3,i,x,a6,a7,a9,a11,a12,x1,a14 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for p,q being Element of [:INT,INT:],
         m,n being Integer
     holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q + n <= Offset.p or
       Offset.p + m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st n <= m &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[m,[n,v]]]] = 0) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) = v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[p,[m,[n-1,v]]]] &
         c1 = Count.[mint,[p,[m,[n,v]]]] &
         1 + c0 = c1) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) <> v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[m,[n-1,v]]]] =
         Count.[mint,[p,[m,[n,v]]]]) &

    (for m,n,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st m <= j & j < n holds
             mint1.(shft.[p,j]) = mint0.(shft.[p,j]))
     holds
       Count.[mint1,[p,[m,[n,v]]]] =
         Count.[mint0,[p,[m,[n,v]]]]) &

    a1 = shft.[a,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i2]]] in Sep implies a2.q = t5.q) &
       (not [q,[1,[a1,i2]]] in Sep implies a2.q = t1.q)) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i1]]] in Sep implies a3.q = a2.q) &
       (not [q,[1,[a1,i1]]] in Sep implies a3.q = t2.q)) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i2]]] in Sep implies a4.q = a3.q) &
       (not [q,[1,[a1,i2]]] in Sep implies a4.q = t3.q)) &

    x = i2 - 1 &
    a5 = shft.[a,x] &
    a6 = a4.a5 &
    a7 = a3.a1 &
    a8 = shft.[a,i3] &
    a9 = a4.a8 &

    (for q being Element of [:INT,INT:] holds
       (q = a5 implies a10.q = a9) &
       (q <> a5 & q = a8 implies a10.q = i) &
       (q <> a5 & q <> a8 implies a10.q = a4.q)) &

    a11 = a10.a8 &
    a12 = a3.a8 &
    x1 = 1 + i3 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i2]]] in Sep implies a13.q = a10.q) &
       (not [q,[1,[a1,i2]]] in Sep implies a13.q = t4.q)) &

    a14 = a13.a1 &

    a6 = a7 &
    a11 = a6 &
    0 < i2 &
    i2 <= i1 &
    i3 <= i1 &
    0 <= i2 &
    i3 < i1 &
    i2 <= i3 &
    reg.(Base.a) <= 0 &
    a12 < a7 &
    i3 <= 2147483647 + 2147483647 &
    t in Linked &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    [t,[a1,1]] in ValidRD &
    [t,[a8,1]] in ValidRD &
    [t,[a1,i1]] in ValidRW &
    [t,[a1,i2]] in ValidRW &
    [t,[a8,1]] in ValidRW &
    [t,[a5,1]] in ValidRW &
    -(2147483647) - 1 <= a2.a1 &
    a2.a1 < 2147483647 + 1 &

    (for j being Integer st 0 < j & j < i2 holds
       ex child,parent being Integer st
         child = a2.(shft.[a,j]) &
         parent = a2.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t5,[a,[0,[i2,v]]]] =
         Count.[a2,[a,[0,[i2,v]]]]) &

    -(2147483647) - 1 <= a7 & a7 < 2147483647 + 1 &
    -(2147483647) - 1 <= a12 & a12 < 2147483647 + 1 &

    (for j being Integer st 0 < j & j < i2 holds
       ex child,parent being Integer st
         child = a3.(shft.[a,j]) &
         parent = a3.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t5,[a,[0,[i3,v]]]] =
         Count.[a3,[a,[0,[i3,v]]]]) &

    (for j being Integer st i3 <= j & j < i1 holds
       t5.(shft.[a,j]) = a3.(shft.[a,j])) &

    (for j being Integer st 0 <= j & j < i2 holds
       ex value being Integer st
         value = a3.(shft.[a,j]) &
         value <= a7) &

    (for j being Integer st i2 <= j & j < i3 holds
       ex value being Integer st
         value = a3.(shft.[a,j]) &
         a7 <= value) &

    -(2147483647) - 1 <= a9 & a9 < 2147483647 + 1 &
    -(2147483647) - 1 <= a6 & a6 < 2147483647 + 1 &

    (for j being Integer st 0 < j & j < x holds
       ex child,parent being Integer st
         child = a4.(shft.[a,j]) &
         parent = a4.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    -(2147483647) - 1 <= a11 & a11 < 2147483647 + 1 &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t5,[a,[0,[x1,v]]]] =
         Count.[a4,[a,[0,[x1,v]]]]) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[a3,[a,[0,[i2,v]]]] =
         Count.[a4,[a,[0,[i2,v]]]]) &

    0 <= x &
    x < i2 &
    (for j being Integer st 0 <= j & j < i2 holds
       ex value,maximum being Integer st
         value = a4.(shft.[a,j]) &
         maximum = a4.(shft.[a,x]) &
         value <= maximum) &

    (for j being Integer st 0 < j & j < x holds
       ex child,parent being Integer st
         child = a10.(shft.[a,j]) &
         parent = a10.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[a4,[a,[0,[x1,v]]]] =
         Count.[a10,[a,[0,[x1,v]]]]) &

    (for j being Integer st x1 <= j & j < i1 holds
       a4.(shft.[a,j]) = a10.(shft.[a,j])) &

    a4.(shft.[a,x]) = a10.(shft.[a,i3]) &
    a4.(shft.[a,i3]) = a10.(shft.[a,x]) &
    0 <= x &
    x < i3 &
    i3 < x1 &
    (for j being Integer st 0 <= j & j < x holds
       a4.(shft.[a,j]) = a10.(shft.[a,j])) &
    (for j being Integer st 1+x <= j & j < i3 holds
       a4.(shft.[a,j]) = a10.(shft.[a,j])) &
    (for j being Integer st 1+i3 <= j & j < x1 holds
       a4.(shft.[a,j]) = a10.(shft.[a,j])) &

    -(2147483647) - 1 <= a14 & a14 < 2147483647 + 1 &

    (for j being Integer st 0 < j & j < i2 holds
       ex child,parent being Integer st
         child = a13.(shft.[a,j]) &
         parent = a13.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[a10,[a,[0,[i2,v]]]] =
         Count.[a13,[a,[0,[i2,v]]]]) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[a10,[a,[0,[x1,v]]]] =
         Count.[a13,[a,[0,[x1,v]]]]) &

    (for j being Integer st i2 <= j & j < x1 holds
       ex value being Integer st
         value = a13.(shft.[a,j]) &
         a14 <= value)
  holds
    for j being Integer st 0 <= j & j < i2 holds
      ex value being Integer st
        value = a13.(shft.[a,j]) &
        value <= a14
proof
end;
::$P+
