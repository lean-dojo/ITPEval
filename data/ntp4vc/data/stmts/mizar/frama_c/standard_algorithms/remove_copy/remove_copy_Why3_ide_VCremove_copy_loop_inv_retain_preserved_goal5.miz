:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/remove_copy/remove_copy_Why3_ide_VCremove_copy_loop_inv_retain_preserved_goal5:
:: the remove-copy loop verification condition preserves, after the next
:: branch-dependent memory state, the occurrence counts of every signed
:: 32-bit value other than the removed value, under the stated range,
:: memory-validity, separation, linkage, unchanged-region, and count
:: hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0,
    MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a1,a,a2,a3,a4,a7 being Element of [:INT,INT:],
      t3,t1,t2,a5 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      p being Element of BOOLEAN,
      i5,i,i2,i1,i3,i4,x,x1,x2,a6 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for q being Element of [:INT,INT:], k being Integer holds
       shft.[q,k] = [Base.q,Offset.q + k]) &

    (for q,r being Element of [:INT,INT:],
         m,n being Integer
     holds
       [q,[m,[r,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.q <> Base.r or
       Offset.r + n <= Offset.q or
       Offset.q + m <= Offset.r) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRD iff
       (0 < n implies
         Base.q <> 0 &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRW iff
       (0 < n implies
         0 < Base.q &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st n <= m &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[q,[m,[n,v]]]] = 0) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st mint.(shft.[q,n-1]) = v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[q,[m,[n-1,v]]]] &
         c1 = Count.[mint,[q,[m,[n,v]]]] &
         1 + c0 = c1) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st mint.(shft.[q,n-1]) <> v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[q,[m,[n-1,v]]]] =
         Count.[mint,[q,[m,[n,v]]]]) &

    (for m,n,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st m <= j & j < n holds
             mint1.(shft.[q,j]) = mint0.(shft.[q,j]))
     holds
       Count.[mint1,[q,[m,[n,v]]]] =
         Count.[mint0,[q,[m,[n,v]]]]) &

    x = Count.[t3,[a1,[0,[i5,i]]]] &
    x1 = 1 + i5 &
    a2 = shft.[a1,0] &
    a3 = shft.[a1,i5] &
    a4 = shft.[a,0] &
    x2 = i5 - x &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a4,i2]]] in Sep implies a5.q = t3.q) &
       (not [q,[1,[a4,i2]]] in Sep implies a5.q = t1.q)) &

    a6 = a5.a3 &
    a7 = shft.[a,x2] &

    i5 <= i2 &
    i5 < i2 &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    x <= i5 &
    0 <= x &
    i5 <= 2147483647 + 2147483647 &
    t in Linked &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= i4 & i4 < 2147483647 + 2147483647 + 2 &
    0 <= i5 & i5 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    0 <= x1 & x1 < 2147483647 + 2147483647 + 2 &
    [t,[a2,i2]] in ValidRD &
    [t,[a3,1]] in ValidRD &
    [t,[a4,i2]] in ValidRW &
    [a2,[i2,[a,1]]] in Sep &
    0 <= x2 & x2 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= a6 & a6 < 2147483647 + 1 &

    (not ex j being Integer st
       a5.(shft.[a,j]) = i &
       0 <= j & j < x2) &

    (for j being Integer st i5 <= j & j < i2 holds
       t3.(shft.[a1,j]) = a5.(shft.[a1,j])) &

    (for j being Integer st x2 <= j & j < i2 holds
       t3.(shft.[a,j]) = a5.(shft.[a,j])) &

    (for v being Integer st
       v <> i &
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t3,[a1,[0,[i5,v]]]] =
         Count.[a5,[a,[0,[x2,v]]]]) &

    ((a6 = i &
       a5 = t2 &
       (ex c being Integer st
          c = Count.[t3,[a1,[0,[i5,t2.a3]]]] &
          i4 + c = i5))
     or
     (a6 <> i &
       p = FALSE &
       i3 = i1 &
       i1 + x = i5 &
       i3 + x = i5 &
       i4 + x = x1 &
       a5+*(a7,a6) = t2 &
       i5 <= 2147483647 + 2147483647 + x &
       [t,[a7,1]] in ValidRW))
  holds
    for v being Integer st
      v <> i &
      -(2147483647) - 1 <= v & v < 2147483647 + 1
    holds
      Count.[t3,[a1,[0,[x1,v]]]] =
        Count.[t2,[a,[0,[i4,v]]]]
proof
end;
::$P+
