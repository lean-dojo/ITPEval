:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/replace_copy/replace_copy_Why3_ide_VCreplace_copy_post_replace_goal0:
:: the replace-copy postcondition verification condition transfers the
:: pointwise replace relation from a havoced memory at bound i2 to the
:: corresponding havoced memory at bound i3, under equal-bound, C integer
:: range, memory-validity, separation, linkage, and unchanged-region
:: hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a1,a,a2,a3 being Element of [:INT,INT:],
      t1,t2,a4,a5 being Function of [:INT,INT:],INT,
      t,reg being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i2,i3,i,i1 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         m,n being Integer
     holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q + n <= Offset.p or
       Offset.p + m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    a2 = shft.[a1,0] &
    a3 = shft.[a,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a3,i2]]] in Sep implies a4.q = t2.q) &
       (not [q,[1,[a3,i2]]] in Sep implies a4.q = t1.q)) &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a3,i3]]] in Sep implies a5.q = t2.q) &
       (not [q,[1,[a3,i3]]] in Sep implies a5.q = t1.q)) &

    i3 <= i2 &
    0 <= i3 &
    i2 <= i3 &
    reg.(Base.a) <= 0 &
    reg.(Base.a1) <= 0 &
    t in Linked &
    0 <= i2 &
    i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 &
    i3 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i &
    i < 2147483647 + 1 &
    -(2147483647) - 1 <= i1 &
    i1 < 2147483647 + 1 &
    [t,[a2,i2]] in ValidRD &
    [t,[a3,i2]] in ValidRW &
    [a2,[i2,[a,1]]] in Sep &

    (for j being Integer st i3 <= j & j < i2 holds
       t2.(shft.[a1,j]) = a4.(shft.[a1,j])) &

    (for j being Integer st 0 <= j & j < i3 holds
       (t2.(shft.[a1,j]) = i1 implies
          a4.(shft.[a,j]) = i) &
       (t2.(shft.[a1,j]) <> i1 implies
          a4.(shft.[a,j]) = t2.(shft.[a1,j])))
  holds
    for j being Integer st 0 <= j & j < i3 holds
      (t2.(shft.[a1,j]) = i1 implies
         a5.(shft.[a,j]) = i) &
      (t2.(shft.[a1,j]) <> i1 implies
         a5.(shft.[a,j]) = t2.(shft.[a1,j]))
proof
end;
::$P+
