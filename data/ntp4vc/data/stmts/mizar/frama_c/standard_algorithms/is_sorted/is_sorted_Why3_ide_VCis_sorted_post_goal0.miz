:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/is_sorted/is_sorted_Why3_ide_VCis_sorted_post_goal0:
:: the is-sorted postcondition states that, under the C-integer-range,
:: linkage, readable-memory, weak-sortedness, and final comparison
:: hypotheses, the array range is sorted exactly when the returned integer
:: flag is nonzero. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      ValidRD being set,
      p being Element of BOOLEAN,
      i2,i,i1 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for q being Element of [:INT,INT:], k being Integer holds
       shft.[q,k] = [Base.q,Offset.q + k]) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRD iff
       (0 < n implies
         Base.q <> 0 &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    reg.(Base.a) <= 0 &
    t in Linked &
    0 <= i &
    i < 2147483647 + 2147483647 + 2 &
    0 <= i2 &
    i2 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i1 &
    i1 < 2147483647 + 1 &
    [t,[shft.[a,0],i]] in ValidRD &

    ((0 < i &
      p = FALSE &
      (for j being Integer st
         0 <= j & 2 + j <= 1 + i2
       holds
         ex v0,v1 being Integer st
           v0 = t1.(shft.[a,j]) &
           v1 = t1.(shft.[a,1 + j]) &
           v0 <= v1) &
      ((2 + i2 <= i &
        i1 = 0 &
        (ex vnext,vcur being Integer st
           vnext = t1.(shft.[a,1 + i2]) &
           vcur = t1.(shft.[a,i2]) &
           vnext < vcur) &
        i2 <= 2147483647 + 2147483647 &
        [t,[shft.[a,i2],1]] in ValidRD &
        [t,[shft.[a,ToUint32.(1 + i2)],1]] in ValidRD)
       or
       (not 2 + i2 <= i & i1 = 1)))
     or
     (not 0 < i & i1 = 1))
  holds
    ((for j1,j being Integer st
        j < i & 0 <= j1 & j1 < j
      holds
        ex v1,v being Integer st
          v1 = t1.(shft.[a,j1]) &
          v = t1.(shft.[a,j]) &
          v1 <= v)
     iff i1 <> 0)
proof
end;
::$P+
