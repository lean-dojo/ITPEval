:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/search_n/search_n_Why3_ide_VCsearch_n_has_match_post_match_goal14:
:: the search_n match-post verification condition concludes that a known
:: constant range extends across the matched subrange, under the stated C
:: integer bounds, memory-validity, linkage, and branch conditions. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      ValidRD being set,
      i,i6,i1,i2,i3,i4,i5,i7,x,x1,x2,x3 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    x = t1.(shft.[a,i - 1]) &
    x1 = 1 + i6 &
    x2 = i1 + i2 &
    a1 = shft.[a,i6] &
    x3 = ToUint32.x1 &

    Region.(Base.a) <= 0 &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= i4 & i4 < 2147483647 + 2147483647 + 2 &
    0 <= i5 & i5 < 2147483647 + 2147483647 + 2 &
    0 <= i6 & i6 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i7 & i7 < 2147483647 + 1 &

    (ex j being Integer st
       0 <= j &
       i2 + j <= i4 &
       (for k being Integer st j <= k & k < i2 + j holds
          t1.(shft.[a,k]) = i7)) &

    [t,[shft.[a,0],i4]] in ValidRD &
    -(2147483647) - 1 <= x & x < 2147483647 + 1 &

    ((0 < i2 implies
       ((i2 <= i4 implies
          i5 = i3 &
          i5 = i4 &
          i <= x1 &
          (for k being Integer st i <= k & k < i6 holds
             t1.(shft.[a,k]) = i7) &
          (not ex j being Integer st
             0 <= j &
             i2 + j <= i6 &
             (for k being Integer st j <= k & k < i2 + j holds
                t1.(shft.[a,k]) = i7)) &
          ((i6 < i5 implies
             i1 = i &
             x2 = x1 &
             t1.a1 = i7 &
             i1 <= x3 &
             i6 <= 2147483647 + 2147483647 &
             x3 <= 2147483647 + 2147483647 + 1 + i1 &
             [t,[a1,1]] in ValidRD) &
           (not i6 < i5 implies i5 = i1)) &
          (0 < i implies x <> i7)) &
        (not i2 <= i4 implies i4 = i1))) &
     (not 0 < i2 implies i1 = 0))
  holds
    for k being Integer st i1 <= k & k < x2 holds
      t1.(shft.[a,k]) = i7
proof
end;
::$P+
