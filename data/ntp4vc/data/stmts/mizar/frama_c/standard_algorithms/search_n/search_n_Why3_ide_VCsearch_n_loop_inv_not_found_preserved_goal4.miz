:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/search_n/search_n_Why3_ide_VCsearch_n_loop_inv_not_found_preserved_goal4:
:: the search_n loop verification condition preserves the absence of a
:: constant subrange after advancing the scan, under the stated integer
:: bounds, memory-validity, linkage, range, and branch hypotheses. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a0,a1 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,Region being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Linked being Subset of Funcs(INT,INT),
      i4,i,i2,i3,i1,i5,x1,x2 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    a0 = shft.[a,0] &
    a1 = shft.[a,i4] &
    x1 = t1.a1 &
    x2 = t1.(shft.[a,i - 1]) &

    0 < i2 &
    i2 <= i3 &
    i4 < i3 &
    Region.(Base.a) <= 0 &
    i4 <= 2147483647 + 2147483647 &
    i <= 1 + i4 &
    t in Linked &

    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= i4 & i4 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i5 & i5 < 2147483647 + 1 &
    0 <= 1 + i4 & 1 + i4 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= x1 & x1 < 2147483647 + 1 &

    (for k being Integer st i <= k & k < i4 holds
       t1.(shft.[a,k]) = i5) &

    (not ex j being Integer st
       0 <= j &
       i2 + j <= i4 &
       (for k being Integer st j <= k & k < i2 + j holds
          t1.(shft.[a,k]) = i5)) &

    (0 < i3 implies
       Base.a0 <> 0 &
       0 <= Offset.a0 &
       Offset.a0 + i3 <= t.(Base.a0)) &

    (0 < 1 implies
       Base.a1 <> 0 &
       0 <= Offset.a1 &
       Offset.a1 + 1 <= t.(Base.a1)) &

    -(2147483647) - 1 <= x2 & x2 < 2147483647 + 1 &

    (0 < i implies x2 <> i5) &

    (x1 <> i5 or
      (i1 = i &
       i1 + i2 <> 1 + i4 &
       i1 <= 1 + i4 &
       i4 <= 2147483647 + 2147483647 + i1))
  holds
    not ex j being Integer st
      0 <= j &
      i2 + j <= 1 + i4 &
      (for k being Integer st j <= k & k < i2 + j holds
         t1.(shft.[a,k]) = i5)
proof
end;
::$P+
