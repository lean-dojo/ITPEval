:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/equal_range2/equal_range_Why3_ide_VCequal_range_post_left_goal1:
:: the equal-range left postcondition states that every element before the
:: computed left boundary of a logically indexed integer range is strictly
:: below the midpoint value, under the sorted-range, partition, integer-range,
:: linkage, and readable-memory hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s,a,a1,a2,a3 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft,shft32 being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      ValidRD being set,
      i1,i3,i2,i,x,x1,x2,x4,x5,x6,x7,x9,x10,x11,
      x12,x14,x15,u,q,w being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft32.[p,k] = [Base.p,Offset.p + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex y being Integer st
         y = ToUint32.z &
         0 <= y & y < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    s = [x1,x] &
    x2 = i1 + i3 &
    x4 = i1 + i3 - x1 &
    x5 = TDiv.[x4,2] &
    x6 = x1 + x5 &
    u = ToUint32.x4 &
    q = TDiv.[u,2] &
    w = ToUint32.q &
    x7 = x1 + w &
    x9 = x1 + x5 - i1 &
    a1 = shft32.[a,x9] &
    x10 = t1.a1 &
    x11 = x1 - i1 &
    a2 = shft32.[a,x11] &
    x12 = 1 + x1 + x5 - i1 &
    x14 = i1 + x - 1 - x1 - x5 &
    a3 = shft32.[a,x12] &
    x15 = i1 + i3 - 1 - x1 - x5 &

    0 <= i1 &
    i3 <= i2 &
    x <= i3 &
    0 <= x1 &
    i1 <= x1 &
    0 <= x &
    x1 < x2 &
    reg.(Base.a) <= 0 &
    0 <= x5 &
    i1 <= x5 &
    x6 < x2 &
    x6 < i1 + x &
    i1 <= x7 &
    x10 <= i &
    i <= x10 &
    x1 <= 2147483647 + 2147483647 + 1 &
    x <= 2147483647 + 2147483647 + 1 &
    x2 <= 2147483647 + 2147483647 + 1 + x1 &
    x5 <= 2147483647 + 2147483647 + 1 &
    x6 <= 2147483647 + 2147483647 + i1 &
    x2 <= 2147483647 + 2147483647 + 2 + x1 + x5 &
    x7 <= 2147483647 + 2147483647 + 1 + i1 &

    0 <= x1 & x1 < 2147483647 + 2147483647 + 2 &
    0 <= x & x < 2147483647 + 2147483647 + 2 &
    t in Linked &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &
    0 <= x1 & x1 < 2147483647 + 2147483647 + 2 &
    0 <= x & x < 2147483647 + 2147483647 + 2 &

    (for j1,j being Integer st
       j < i2 & 0 <= j1 & j1 < j
     holds
       ex v1,v being Integer st
         v1 = t1.(shft.[a,j1]) &
         v = t1.(shft.[a,j]) &
         v1 <= v) &

    0 <= x11 & x11 < 2147483647 + 2147483647 + 2 &

    (for j being Integer st i3 <= j & j < i2 holds
       ex v being Integer st
         v = t1.(shft.[a,j]) & i < v) &

    [t,[shft32.[a,0],i2]] in ValidRD &

    (for j being Integer st 0 <= j & j < x11 holds
       ex v being Integer st
         v = t1.(shft.[a,j]) & v < i) &

    [t,[a2,x5]] in ValidRD &

    (for j1,j being Integer st
       j < x5 & 0 <= j1 & j1 < j
     holds
       ex v1,v being Integer st
         v1 = t1.(shft.[a2,j1]) &
         v = t1.(shft.[a2,j]) &
         v1 <= v) &

    0 <= x9 & x9 < 2147483647 + 2147483647 + 2 &
    0 <= x12 & x12 < 2147483647 + 2147483647 + 2 &
    0 <= x14 & x14 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= x10 & x10 < 2147483647 + 1 &
    [t,[a1,1]] in ValidRD &
    [t,[a3,x15]] in ValidRD &

    (for j1,j being Integer st
       j < x15 & 0 <= j1 & j1 < j
     holds
       ex v1,v being Integer st
         v1 = t1.(shft.[a3,j1]) &
         v = t1.(shft.[a3,j]) &
         v1 <= v) &

    (for j being Integer st 0 <= j & j < i1 holds
       ex v being Integer st
         v = t1.(shft.[a2,j]) & v < x10) &

    (for j being Integer st x14 <= j & j < x15 holds
       ex v being Integer st
         v = t1.(shft.[a3,j]) & x10 < v) &

    (for j being Integer st i1 <= j & j < x5 holds
       ex v being Integer st
         v = t1.(shft.[a2,j]) & x10 <= v) &

    (for j being Integer st 0 <= j & j < x14 holds
       ex v being Integer st
         v = t1.(shft.[a3,j]) & v <= x10)
  holds
    for j being Integer st 0 <= j & j < x1 holds
      ex v being Integer st
        v = t1.(shft.[a,j]) & v < x10
proof
end;
::$P+
