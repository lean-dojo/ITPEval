:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/equal_range2/equal_range_Why3_ide_VCequal_range_post_right_goal3:
:: the equal-range right postcondition states that every element from the
:: computed upper boundary to the end of the original logically indexed range
:: is strictly above the searched value, under the sorted-range, partition, midpoint,
:: C-integer-range, linkage, and readable-memory hypotheses.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for s,a,a1,a2,a3 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft,shft32 being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      ValidRD being set,
      p1,p2,p3,p being Element of BOOLEAN,
      i8,i10,i7,i11,i1,i2,i3,i4,i5,i6,i9,i,
      x,x2,x3,x4,x5,x6,x7,x9,x10,x11,u,q,w
        being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for r being Element of [:INT,INT:], k being Integer holds
       shft.[r,k] = [Base.r,Offset.r + k]) &

    (for r being Element of [:INT,INT:], k being Integer holds
       shft32.[r,k] = [Base.r,Offset.r + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex y being Integer st
         y = ToUint32.z &
         0 <= y & y < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for malloc being Function of INT,INT,
         r being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[r,n]] in ValidRD iff
       (0 < n implies
         Base.r <> 0 &
         0 <= Offset.r &
         Offset.r + n <= malloc.(Base.r))) &

    s = [x,x5] &
    x2 = i8 - i10 &
    x3 = TDiv.[x2,2] &
    x4 = i10 + x3 &
    a1 = shft32.[a,x4] &
    x6 = t1.a1 &
    u = ToUint32.x2 &
    q = TDiv.[u,2] &
    w = ToUint32.q &
    x7 = i10 + w &
    a2 = shft32.[a,i10] &
    a3 = shft32.[a,1 + i10 + x3] &
    x9 = i8 - 1 - i10 - x3 &
    x10 = x - i10 &
    x11 = x5 - 1 - i10 - x3 &

    i8 <= i7 &
    i11 <= i8 &
    0 <= i11 &
    reg.(Base.a) <= 0 &
    0 <= x & x < 2147483647 + 2147483647 + 2 &
    0 <= x5 & x5 < 2147483647 + 2147483647 + 2 &
    t in Linked &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= i4 & i4 < 2147483647 + 2147483647 + 2 &
    0 <= i5 & i5 < 2147483647 + 2147483647 + 2 &
    0 <= i6 & i6 < 2147483647 + 2147483647 + 2 &
    0 <= i7 & i7 < 2147483647 + 2147483647 + 2 &
    0 <= i8 & i8 < 2147483647 + 2147483647 + 2 &
    0 <= i9 & i9 < 2147483647 + 2147483647 + 2 &
    0 <= i10 & i10 < 2147483647 + 2147483647 + 2 &
    0 <= i11 & i11 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= i & i < 2147483647 + 1 &

    (for j1,j being Integer st
       j < i7 & 0 <= j1 & j1 < j
     holds
       ex v1,v being Integer st
         v1 = t1.(shft.[a,j1]) &
         v = t1.(shft.[a,j]) &
         v1 <= v) &

    (for j being Integer st 0 <= j & j < i11 holds
       ex v being Integer st
         v = t1.(shft.[a,j]) & v < i) &

    (for j being Integer st i8 <= j & j < i7 holds
       ex v being Integer st
         v = t1.(shft.[a,j]) & i < v) &

    [t,[shft32.[a,0],i7]] in ValidRD &

    (i11 < i8 implies
       p1 = FALSE &
       p2 = FALSE &
       p3 = FALSE &
       i2 = i1 &
       i5 = i4 &
       i10 = i9 &
       i11 = i10 &
       x = i3 + i10 &
       x = i6 + i10 &
       x4 = i4 &
       x4 = i5 &
       x5 = 1 + i1 + i10 + x3 &
       x5 = 1 + i2 + i10 + x3 &
       x5 <= i8 &
       0 <= x &
       i10 <= x &
       0 <= x5 &
       0 <= x3 &
       x4 < i8 &
       x <= x4 &
       x4 < x5 &
       x6 <= i &
       0 <= x7 &
       i <= x6 &
       x <= 2147483647 + 2147483647 + 1 &
       x5 <= 2147483647 + 2147483647 + 1 &
       i8 <= 2147483647 + 2147483647 + 1 + i10 &
       x3 <= 2147483647 + 2147483647 + 1 &
       x4 <= 2147483647 + 2147483647 &
       i8 <= 2147483647 + 2147483647 + 2 + i10 + x3 &
       x7 <= 2147483647 + 2147483647 + 1 &
       [t,[a2,x3]] in ValidRD &

       (for j1,j being Integer st
          j < x3 & 0 <= j1 & j1 < j
        holds
          ex v1,v being Integer st
            v1 = t1.(shft.[a2,j1]) &
            v = t1.(shft.[a2,j]) &
            v1 <= v) &

       [t,[a1,1]] in ValidRD &
       [t,[a3,x9]] in ValidRD &

       (for j1,j being Integer st
          j < x9 & 0 <= j1 & j1 < j
        holds
          ex v1,v being Integer st
            v1 = t1.(shft.[a3,j1]) &
            v = t1.(shft.[a3,j]) &
            v1 <= v) &

       (for j being Integer st 0 <= j & j < x10 holds
          ex v being Integer st
            v = t1.(shft.[a2,j]) & v < x6) &

       (for j being Integer st x11 <= j & j < x9 holds
          ex v being Integer st
            v = t1.(shft.[a3,j]) & x6 < v) &

       (for j being Integer st x10 <= j & j < x3 holds
          ex v being Integer st
            v = t1.(shft.[a2,j]) & x6 <= v) &

       (for j being Integer st 0 <= j & j < x11 holds
          ex v being Integer st
            v = t1.(shft.[a3,j]) & v <= x6)) &

    (not i11 < i8 implies
       p = FALSE &
       x = i11 &
       x5 = x)
  holds
    for j being Integer st x5 <= j & j < i7 holds
      ex v being Integer st
        v = t1.(shft.[a,j]) & i < v
proof
end;
::$P+
