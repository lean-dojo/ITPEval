:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/reverse/reverse_Why3_ide_VCreverse_loop_inv_right_preserved_goal7:
:: the reverse-loop verification condition preserves the right-hand reversed
:: array segment after a havoc-modeled memory exchange, under the stated
:: index, C integer-range, memory-validity, region, linkage, unchanged-range,
:: and reversed-segment assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a3,a4 being Element of [:INT,INT:],
      t1,t2,a2,a6 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRW,PUnchanged,PReverse being set,
      i1,i2,i,a5,a7,a8,x1,x2,x3,x4 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for p,q being Element of [:INT,INT:],
         m,n being Integer
     holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q + n <= Offset.p or
       Offset.p + m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for mint0,mint1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:],
         m,n being Integer
     holds
       [mint0,[mint1,[p,[m,n]]]] in PUnchanged iff
       (for j being Integer st m <= j & j < n holds
          mint1.(shft.[p,j]) = mint0.(shft.[p,j]))) &

    (for mint0,mint1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:],
         m,n,s being Integer
     holds
       [mint0,[mint1,[p,[m,[n,s]]]]] in PReverse iff
       (for j being Integer st 0 <= j & j < n-m holds
          mint0.(shft.[shft.[p,s],n-m-1-j]) =
            mint1.(shft.[shft.[p,m],j]))) &

    a1 = shft.[a,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i1]]] in Sep implies a2.q = t2.q) &
       (not [q,[1,[a1,i1]]] in Sep implies a2.q = t1.q)) &

    x1 = i1 - 1 - i2 &
    a3 = shft.[a,x1] &
    a4 = shft.[a,i2] &
    a5 = a2.a3 &

    (for q being Element of [:INT,INT:] holds
       (q = a4 implies a6.q = a5) &
       (q <> a4 & q = a3 implies a6.q = i) &
       (q <> a4 & q <> a3 implies a6.q = a2.q)) &

    a7 = a6.a3 &
    a8 = a2.a4 &
    x2 = TDiv.[i1,2] &
    x3 = ToUint32.(i1-1) &
    x4 = i1-i2 &

    a7 = a8 &
    0 < i1 &
    0 <= i2 &
    i2 < x2 &
    i2 <= x2 &
    reg.(Base.a) <= 0 &
    i2 + x2 <= i1 &
    i2 <= x3 &
    i2 <= 2147483647 + 2147483647 &
    x3 <= 2147483647 + 2147483647 + 1 + i2 &
    t in Linked &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= x2 & x2 < 2147483647 + 2147483647 + 2 &
    0 <= 1+i2 & 1+i2 < 2147483647 + 2147483647 + 2 &
    [t,[a1,i1]] in ValidRW &
    [t,[a4,1]] in ValidRW &
    -(2147483647)-1 <= a8 & a8 < 2147483647+1 &
    -(2147483647)-1 <= a5 & a5 < 2147483647+1 &
    [t,[a3,1]] in ValidRW &
    -(2147483647)-1 <= a7 & a7 < 2147483647+1 &
    [a2,[t2,[a,[i2,x4]]]] in PUnchanged &
    [a2,[t2,[a,[0,[i2,x4]]]]] in PReverse &
    [a2,[t2,[a,[x4,[i1,0]]]]] in PReverse
  holds
    [a6,[t2,[a,[x1,[i1,0]]]]] in PReverse
proof
end;
::$P+
