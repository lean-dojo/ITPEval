:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/pop_heap/pop_heap_Why3_ide_VCpop_heap_post_result_goal1:
:: the pop-heap post-result verification condition states that the value at
:: the former last position after the conditional havoc-modeled update equals
:: the original heap root, under the stated heap, memory-validity, region,
:: linkage, and C integer-range assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0, MARGREL1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a,a1,a2,a3,a4,a5 being Element of [:INT,INT:],
      t5,t4,t3,t2 being Function of [:INT,INT:],INT,
      t,t1,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      p,p1 being Element of BOOLEAN,
      i,i1,i2,i3,x,x1,x2,x3 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for q being Element of [:INT,INT:], k being Integer holds
       shft.[q,k] = [Base.q,Offset.q + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for q,r being Element of [:INT,INT:],
         m,n being Integer
     holds
       [q,[m,[r,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.q <> Base.r or
       Offset.r + n <= Offset.q or
       Offset.q + m <= Offset.r) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRD iff
       (0 < n implies
         Base.q <> 0 &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    (for malloc being Function of INT,INT,
         q being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[q,n]] in ValidRW iff
       (0 < n implies
         0 < Base.q &
         0 <= Offset.q &
         Offset.q + n <= malloc.(Base.q))) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st n <= m &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[q,[m,[n,v]]]] = 0) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st mint.(shft.[q,n-1]) = v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[q,[m,[n-1,v]]]] &
         c1 = Count.[mint,[q,[m,[n,v]]]] &
         1 + c0 = c1) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st mint.(shft.[q,n-1]) <> v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[q,[m,[n-1,v]]]] =
         Count.[mint,[q,[m,[n,v]]]]) &

    (for m,n,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         q being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st m <= j & j < n holds
             mint1.(shft.[q,j]) = mint0.(shft.[q,j]))
     holds
       Count.[mint1,[q,[m,[n,v]]]] =
         Count.[mint0,[q,[m,[n,v]]]]) &

    a1 = shft.[a,0] &
    x = t5.a1 &
    x1 = i - 1 &
    a2 = shft.[a,x1] &
    x2 = t4.a2 &
    a3 = shft.[a,ToUint32.x1] &
    a4 = shft.[a,i1] &
    x3 = t3.a2 &
    a5 = shft.[a,i3] &

    0 < i &
    reg.(Base.a) <= 0 &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &

    (for j being Integer st 0 < j & j < i holds
       ex child,parent being Integer st
         child = t5.(shft.[a,j]) &
         parent = t5.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    -(2147483647) - 1 <= x &
    x < 2147483647 + 1 &
    [t,[a1,i]] in ValidRW &
    -(2147483647) - 1 <= x2 &
    x2 < 2147483647 + 1 &

    ((2 <= i &
      [t,[a1,1]] in ValidRD &
      [t,[a3,1]] in ValidRD &

      ((t5.a2 < x &
        p = FALSE &
        p1 = FALSE &
        t1 = t &

        (for q being Element of [:INT,INT:] holds
           ([q,[1,[a1,x1]]] in Sep implies t3.q = t5.q) &
           (not [q,[1,[a1,x1]]] in Sep implies t3.q = t2.q)) &

        (for q being Element of [:INT,INT:] holds
           (q = a2 implies t4.q = x) &
           (q <> a2 & q = a4 implies t4.q = x3) &
           (q <> a2 & q <> a4 implies t4.q = t3.q)) &

        0 < i2 &
        0 <= i1 &
        i1 < i3 &
        (ex parentvalue being Integer st
           parentvalue = t3.(shft.[a,TDiv.[i1-1,2]]) &
           x3 < parentvalue) &
        2 + i1 <= i &

        (for j being Integer st 0 < j & j < i holds
           ex child,parent being Integer st
             child = t3.(shft.[a,j]) &
             parent = t3.(shft.[a,TDiv.[j-1,2]]) &
             child <= parent) &

        0 <= i1 &
        2 + i1 <= i &
        (i1 <= 2147483646 implies
           TDiv.[i3-1,2] = i1) &
        (2 + (1 + 2 * i1) <= i implies
           ex child,maximum being Integer st
             child = t3.(shft.[a,1 + 2 * i1]) &
             maximum = t3.(shft.[a,i3]) &
             child <= maximum) &
        (2 + (2 + 2 * i1) <= i implies
           ex child,maximum being Integer st
             child = t3.(shft.[a,2 + 2 * i1]) &
             maximum = t3.(shft.[a,i3]) &
             child <= maximum) &

        0 <= 0 &
        2 + 0 <= i &
        (0 <= 2147483646 implies
           TDiv.[i2-1,2] = 0) &
        (2 + (1 + 2 * 0) <= i implies
           ex child,maximum being Integer st
             child = t5.(shft.[a,1 + 2 * 0]) &
             maximum = t5.(shft.[a,i2]) &
             child <= maximum) &
        (2 + (2 + 2 * 0) <= i implies
           ex child,maximum being Integer st
             child = t5.(shft.[a,2 + 2 * 0]) &
             maximum = t5.(shft.[a,i2]) &
             child <= maximum) &

        [t1,[a1,i]] in ValidRW &
        [t1,[a4,1]] in ValidRW &

        (for j being Integer st 0 <= j & j < i holds
           ex value being Integer st
             value = t3.(shft.[a,j]) &
             value <= x) &

        [t1,[a3,1]] in ValidRD &
        [t1,[a3,1]] in ValidRW &
        (2 + i2 <= i implies TDiv.[i2-1,2] = 0) &
        (2 + i3 <= i implies TDiv.[i3-1,2] = i1) &
        (i <= 1 + i3 or
          t3.a5 <= x3 & [t1,[a5,1]] in ValidRD) &

        (for v being Integer st
         -(2147483647) - 1 <= v & v < 2147483647 + 1
         holds
           ex leftHit,rightHit,leftCount,rightCount being Integer st
             ((t3.a4 = v & leftHit = 1) or
              (t3.a4 <> v & leftHit = 0)) &
             ((x = v & rightHit = 1) or
              (x <> v & rightHit = 0)) &
             leftCount = Count.[t5,[a,[0,[i,v]]]] &
             rightCount = Count.[t3,[a,[0,[i,v]]]] &
             leftCount + leftHit = rightCount + rightHit))
       or
       (not t5.a2 < x & t5 = t4)))
     or
     (not 2 <= i & t5 = t4))
  holds
    x2 = x
proof
end;
::$P+
