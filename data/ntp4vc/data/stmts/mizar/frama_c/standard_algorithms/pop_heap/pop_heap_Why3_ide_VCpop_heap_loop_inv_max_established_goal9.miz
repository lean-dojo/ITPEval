:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/pop_heap/pop_heap_Why3_ide_VCpop_heap_loop_inv_max_established_goal9:
:: the pop-heap loop verification condition establishes that the root value
:: bounds the whole heap prefix under the stated heap, maximum-child, memory,
:: region, linkage, and C integer-range assumptions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_3, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_3, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, INT_3, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, INT_3, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1 being Element of [:INT,INT:],
      t1 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      TDiv being Function of [:INT,INT:],INT,
      Linked being Subset of Funcs(INT,INT),
      ValidRD,ValidRW being set,
      i,i1,x,x1,x2 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for n,d being Integer holds
       (d = 0 implies TDiv.[n,d] = 0) &
       (0 <= n & 0 < d implies TDiv.[n,d] = n div d) &
       (n < 0 & 0 < d implies TDiv.[n,d] = - ((-n) div d)) &
       (0 <= n & d < 0 implies TDiv.[n,d] = - (n div (-d))) &
       (n < 0 & d < 0 implies TDiv.[n,d] = (-n) div (-d))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u & u < 2147483647 + 2147483647 + 2) &

    (for z being Integer
       st 0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    x = i - 1 &
    x1 = t1.(shft.[a,x]) &
    a1 = shft.[a,0] &
    x2 = t1.a1 &

    0 < i &
    0 < i1 &
    reg.(Base.a) <= 0 &
    x1 < x2 &
    2 <= i &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &

    (for j being Integer st 0 < j & j < i holds
       ex child,parent being Integer st
         child = t1.(shft.[a,j]) &
         parent = t1.(shft.[a,TDiv.[j-1,2]]) &
         child <= parent) &

    -(2147483647) - 1 <= x2 &
    x2 < 2147483647 + 1 &

    0 <= 0 &
    2 + 0 <= i &
    (0 <= 2147483646 implies TDiv.[i1-1,2] = 0) &
    (2 + (1 + 2 * 0) <= i implies
       ex child,maximum being Integer st
         child = t1.(shft.[a,1 + 2 * 0]) &
         maximum = t1.(shft.[a,i1]) &
         child <= maximum) &
    (2 + (2 + 2 * 0) <= i implies
       ex child,maximum being Integer st
         child = t1.(shft.[a,2 + 2 * 0]) &
         maximum = t1.(shft.[a,i1]) &
         child <= maximum) &

    [t,[a1,1]] in ValidRD &
    [t,[a1,i]] in ValidRW &
    (ex parentvalue being Integer st
       parentvalue = t1.(shft.[a,TDiv.[0-1,2]]) &
       -(2147483647) - 1 <= parentvalue &
       parentvalue < 2147483647 + 1) &
    -(2147483647) - 1 <= x1 &
    x1 < 2147483647 + 1 &
    [t,[shft.[a,ToUint32.x],1]] in ValidRD &
    (2 + i1 <= i implies TDiv.[i1-1,2] = 0)
  holds
    for j being Integer st 0 <= j & j < i holds
      ex value being Integer st
        value = t1.(shft.[a,j]) &
        value <= x2
proof
end;
::$P+
