:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/insertion_sort/insertion_sort_Why3_ide_VCinsertion_sort_loop_inv_reorder_preserved_goal4:
:: the insertion-sort loop verification condition preserves the multiset of
:: array values after a havoc-modeled reorder, under the stated ordering,
:: equal-range, memory-validity, linkage, and C integer-range hypotheses.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3 being Element of [:INT,INT:],
      t1,t2,t3,a4,a6 being Function of [:INT,INT:],INT,
      t,reg,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i2,i1,i,x1,x2,x3,a5 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         m,n being Integer
     holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q + n <= Offset.p or
       Offset.p + m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st n <= m &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[m,[n,v]]]] = 0) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) = v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[p,[m,[n-1,v]]]] &
         c1 = Count.[mint,[p,[m,[n,v]]]] &
         1 + c0 = c1) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) <> v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[m,[n-1,v]]]] =
         Count.[mint,[p,[m,[n,v]]]]) &

    (for m,n,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st m <= j & j < n holds
             mint1.(shft.[p,j]) = mint0.(shft.[p,j]))
     holds
       Count.[mint1,[p,[m,[n,v]]]] =
         Count.[mint0,[p,[m,[n,v]]]]) &

    x1 = i2 - i1 &
    x2 = 1 + i2 &
    a1 = shft.[a,0] &
    a2 = shft.[a,i2] &
    a3 = shft.[a,i1] &
    x3 = 1 + i2 - i1 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i]]] in Sep implies a4.q = t3.q) &
       (not [q,[1,[a1,i]]] in Sep implies a4.q = t1.q)) &

    a5 = a4.a2 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a3,x3]]] in Sep implies a6.q = a4.q) &
       (not [q,[1,[a3,x3]]] in Sep implies a6.q = t2.q)) &

    i2 <= i &
    0 <= i1 &
    0 <= i2 &
    i2 < i &
    i1 <= i2 &
    reg.(Base.a) <= 0 &
    i2 <= 2147483647 + 2147483647 &
    i2 <= 2147483647 + 2147483647 + 1 + i1 &
    (ex u being Integer st
       u = ToUint32.x1 &
       u <= 2147483647 + 2147483647) &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= x2 & x2 < 2147483647 + 2147483647 + 2 &
    [t,[a1,i2]] in ValidRD &
    [t,[a2,1]] in ValidRD &
    [t,[a1,i]] in ValidRW &
    [t,[a3,x3]] in ValidRW &
    -(2147483647) - 1 <= a5 & a5 < 2147483647 + 1 &

    (for j1,j being Integer st
       j < i2 & 0 <= j1 & j1 < j
     holds
       ex v1,v being Integer st
         v1 = a4.(shft.[a,j1]) &
         v = a4.(shft.[a,j]) &
         v1 <= v) &

    (for j being Integer st i2 <= j & j < i holds
       t3.(shft.[a,j]) = a4.(shft.[a,j])) &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t3,[a,[0,[i2,v]]]] =
         Count.[a4,[a,[0,[i2,v]]]]) &

    (for j being Integer st 0 <= j & j < i1 holds
       ex v being Integer st
         v = a4.(shft.[a,j]) &
         v <= a5) &

    (for j being Integer st i1 <= j & j < i2 holds
       ex v being Integer st
         v = a4.(shft.[a,j]) &
         a5 < v) &

    (for j being Integer st 0 <= j & j < x1 - 0 holds
       a4.(shft.[shft.[a3,0],j]) =
         a6.(shft.[shft.[a3,1],j])) &

    (for j being Integer st 0 <= j & j < x3 - x1 holds
       a4.(shft.[shft.[a3,x1],j]) =
         a6.(shft.[shft.[a3,0],j]))
  holds
    for v being Integer st
      -(2147483647) - 1 <= v & v < 2147483647 + 1
    holds
      Count.[t3,[a,[0,[x2,v]]]] =
        Count.[a6,[a,[0,[x2,v]]]]
proof
end;
::$P+
