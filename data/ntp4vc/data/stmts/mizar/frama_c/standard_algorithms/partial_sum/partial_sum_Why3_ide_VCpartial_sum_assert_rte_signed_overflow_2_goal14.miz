:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/partial_sum/partial_sum_Why3_ide_VCpartial_sum_assert_rte_signed_overflow_2_goal14:
:: the partial-sum verification condition requires the sum of the next input
:: value and the preceding stored partial sum to stay at or below the signed
:: 32-bit maximum under the stated bounds, memory, and partial-sum invariants.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a2,a3 being Element of [:INT,INT:],
      t1,t2,a4 being Function of [:INT,INT:],INT,
      t,Region,ToUint32 being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      LAcc being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,INT:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i,i1,x,x1,a5,a6,a7 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         m,n being Integer
     holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q + n <= Offset.p or
       Offset.p + m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for z being Integer holds
       ex u being Integer st
         u = ToUint32.z &
         0 <= u &
         u < 2147483647 + 2147483647 + 2) &

    (for z being Integer st
       0 <= z & z < 2147483647 + 2147483647 + 2
     holds
       ToUint32.z = z) &

    (for m being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:],
         n,init,s being Integer
     st
       s = LAcc.[m,[p,[n,init]]]
     holds
       -(2147483647) - 1 <= s &
       s < 2147483647 + 1) &

    (for m being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:],
         n,init being Integer
     st
       n <= 0 &
       -(2147483647) - 1 <= init & init < 2147483647 + 1
     holds
       LAcc.[m,[p,[n,init]]] = init) &

    (for m being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:],
         n,init,prev,curr,u being Integer
     st
       0 < n &
       -(2147483647) - 1 <= init & init < 2147483647 + 1 &
       prev = LAcc.[m,[p,[n - 1,init]]] &
       curr = LAcc.[m,[p,[n,init]]] &
       u = m.(shft.[p,n - 1])
     holds
       u + prev = curr) &

    (for m0,m1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:],
         n,init being Integer
     st
       -(2147483647) - 1 <= init & init < 2147483647 + 1 &
       (for j being Integer st 0 <= j & j < n holds
          m1.(shft.[p,j]) = m0.(shft.[p,j]))
     holds
       LAcc.[m1,[p,[n,init]]] =
       LAcc.[m0,[p,[n,init]]]) &

    a2 = shft.[a,0] &
    a3 = shft.[a1,0] &
    x = t2.a3 &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[shft.[a,1],i - 1]]] in Sep implies
         ((q = a2 implies a4.q = x) &
          (q <> a2 implies a4.q = t2.q))) &
       (not [q,[1,[shft.[a,1],i - 1]]] in Sep implies
         a4.q = t1.q)) &

    x1 = i1 - 1 &
    a5 = a4.(shft.[a,x1]) &
    a6 = a4.(shft.[a1,i1]) &
    a7 = a4.(shft.[a,ToUint32.x1]) &

    a5 = LAcc.[a4,[a1,[i1,0]]] &
    0 < i &
    0 < i1 &
    i1 <= i &
    i1 < i &
    Region.(Base.a) <= 0 &
    Region.(Base.a1) <= 0 &
    t in Linked &
    0 <= i & i < 2147483647 + 2147483647 + 2 &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= x & x < 2147483647 + 1 &
    [t,[a3,1]] in ValidRD &
    [t,[a3,i]] in ValidRD &
    [t,[a2,1]] in ValidRW &
    [t,[a2,i]] in ValidRW &

    (for j,s being Integer st
       s = LAcc.[t2,[a1,[j,0]]] &
       j <= 1 + i & 0 <= j
     holds
       -(2147483647) - 1 <= s &
       s <= 2147483647) &

    [a3,[i,[a2,i]]] in Sep &
    -(2147483647) - 1 <= a6 & a6 < 2147483647 + 1 &
    -(2147483647) - 1 <= a5 & a5 < 2147483647 + 1 &
    -(2147483647) - 1 <= a7 & a7 < 2147483647 + 1 &

    (for j being Integer st 0 <= j & j < i holds
       t2.(shft.[a1,j]) = a4.(shft.[a1,j])) &

    (for j being Integer st 0 <= j & j < i1 holds
       a4.(shft.[a,j]) =
       LAcc.[a4,[a1,[1 + j,0]]])
  holds
    a6 + a7 <= 2147483647
proof
end;
::$P+
