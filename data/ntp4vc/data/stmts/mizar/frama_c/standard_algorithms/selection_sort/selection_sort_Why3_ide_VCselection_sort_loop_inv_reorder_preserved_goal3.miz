:: Statement-only formalization of the NTP4VC corpus artifact
:: frama_c/standard_algorithms/selection_sort/selection_sort_Why3_ide_VCselection_sort_loop_inv_reorder_preserved_goal3:
:: the selection-sort loop verification condition preserves the multiset of
:: array values after the stated havoc-modeled memory change and two point
:: updates, under the ordering, minimum-element, unchanged-range, validity,
:: linkage, region, and C integer-range hypotheses. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, PARTFUN1, ZFMISC_1,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0,
    MCART_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FUNCT_4, FUNCOP_1, FUNCT_7, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, FUNCOP_1, CARD_1, REAL_1, INT_1, XXREAL_0,
    ZFMISC_1, MCART_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCT_4, FUNCT_7, FUNCOP_1, NUMBERS, CARD_1,
    XXREAL_0, MEMBERED, VALUED_0, VALUED_1, XCMPLX_0,
    XREAL_0, ORDINAL1, INT_1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,a1,a3,a4 being Element of [:INT,INT:],
      t1,t2,a2,a6 being Function of [:INT,INT:],INT,
      t,Region being Function of INT,INT,
      Base,Offset being Function of [:INT,INT:],INT,
      shft being Function of
        [:[:INT,INT:],INT:],[:INT,INT:],
      Count being Function of
        [:Funcs([:INT,INT:],INT),
          [:[:INT,INT:],[:INT,[:INT,INT:]:]:]:],INT,
      Linked being Subset of Funcs(INT,INT),
      Sep,ValidRD,ValidRW being set,
      i2,i3,i1,i,a5,a7,a8,x1,x2,a9,im1,a10 being Integer
  st
    (for b,o being Integer holds
       Base.[b,o] = b & Offset.[b,o] = o) &

    (for p being Element of [:INT,INT:], k being Integer holds
       shft.[p,k] = [Base.p,Offset.p + k]) &

    (for p,q being Element of [:INT,INT:],
         m,n being Integer
     holds
       [p,[m,[q,n]]] in Sep iff
       m <= 0 or n <= 0 or Base.p <> Base.q or
       Offset.q + n <= Offset.p or
       Offset.p + m <= Offset.q) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRD iff
       (0 < n implies
         Base.p <> 0 &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for malloc being Function of INT,INT,
         p being Element of [:INT,INT:],
         n being Integer
     holds
       [malloc,[p,n]] in ValidRW iff
       (0 < n implies
         0 < Base.p &
         0 <= Offset.p &
         Offset.p + n <= malloc.(Base.p))) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st n <= m &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[m,[n,v]]]] = 0) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) = v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       ex c0,c1 being Integer st
         c0 = Count.[mint,[p,[m,[n-1,v]]]] &
         c1 = Count.[mint,[p,[m,[n,v]]]] &
         1 + c0 = c1) &

    (for n,m,v being Integer,
         mint being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st mint.(shft.[p,n-1]) <> v &
          m < n &
          -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[mint,[p,[m,[n-1,v]]]] =
         Count.[mint,[p,[m,[n,v]]]]) &

    (for m,n,v being Integer,
         mint0,mint1 being Function of [:INT,INT:],INT,
         p being Element of [:INT,INT:]
       st -(2147483647) - 1 <= v & v < 2147483647 + 1 &
          (for j being Integer st m <= j & j < n holds
             mint1.(shft.[p,j]) = mint0.(shft.[p,j]))
     holds
       Count.[mint1,[p,[m,[n,v]]]] =
         Count.[mint0,[p,[m,[n,v]]]]) &

    a1 = shft.[a,0] &

    (for q being Element of [:INT,INT:] holds
       ([q,[1,[a1,i2]]] in Sep implies a2.q = t2.q) &
       (not [q,[1,[a1,i2]]] in Sep implies a2.q = t1.q)) &

    a3 = shft.[a,i3] &
    a4 = shft.[a,i1] &
    a5 = a2.a3 &
    a6 = (a2+*(a3,i))+*(a4,a5) &
    a7 = a6.a3 &
    a8 = a2.a4 &
    x1 = i1 - i3 &
    x2 = i2 - i3 &
    a9 = a2.(shft.[a,i3-1]) &
    im1 = -1 &
    a10 = t2.(shft.[a,im1]) &

    a7 = a8 &
    0 <= i1 &
    i1 < i2 &
    i3 <= i1 &
    i1 <= i2 &
    i3 <= i2 &
    0 <= i3 &
    i3 < i2 &
    Region.(Base.a) <= 0 &
    i3 <= 2147483647 + 2147483647 &
    i1 <= 2147483647 + 2147483647 + 1 &
    i2 <= 2147483647 + 2147483647 + 1 + i3 &
    t in Linked &
    0 <= i1 & i1 < 2147483647 + 2147483647 + 2 &
    0 <= i2 & i2 < 2147483647 + 2147483647 + 2 &
    0 <= i3 & i3 < 2147483647 + 2147483647 + 2 &
    0 <= x1 & x1 < 2147483647 + 2147483647 + 2 &
    -(2147483647) - 1 <= a10 & a10 < 2147483647 + 1 &
    [t,[a1,i2]] in ValidRW &
    [t,[a3,x2]] in ValidRD &
    -(2147483647) - 1 <= a8 & a8 < 2147483647 + 1 &
    -(2147483647) - 1 <= a5 & a5 < 2147483647 + 1 &
    -(2147483647) - 1 <= a9 & a9 < 2147483647 + 1 &

    (for j1,j being Integer st
       j < i3 & 0 <= j1 & j1 < j
     holds
       ex v1,v being Integer st
         v1 = a2.(shft.[a,j1]) &
         v = a2.(shft.[a,j]) &
         v1 <= v) &

    -(2147483647) - 1 <= a7 & a7 < 2147483647 + 1 &

    (for v being Integer st
       -(2147483647) - 1 <= v & v < 2147483647 + 1
     holds
       Count.[t2,[a,[0,[i2,v]]]] =
         Count.[a2,[a,[0,[i2,v]]]]) &

    0 <= x1 &
    x1 < x2 &
    (for j being Integer st 0 <= j & j < x2 holds
       ex minimum,value being Integer st
         minimum = a2.(shft.[a3,x1]) &
         value = a2.(shft.[a3,j]) &
         minimum <= value) &

    (for j being Integer st 0 <= j & j < x1 holds
       ex value being Integer st
         value = a2.(shft.[a3,j]) &
         a8 < value) &

    (for j being Integer st 0 <= j & j < i3 holds
       a2.(shft.[a,j]) = a6.(shft.[a,j])) &

    (for j being Integer st 1+i1 <= j & j < i2 holds
       a2.(shft.[a,j]) = a6.(shft.[a,j])) &

    (for j being Integer st 1+i3 <= j & j < i1 holds
       a2.(shft.[a,j]) = a6.(shft.[a,j])) &

    (0 < i3 implies
       for j being Integer st i3 <= j & j < i2 holds
         ex value being Integer st
           value = a2.(shft.[a,j]) &
           a9 <= value)
  holds
    for v being Integer st
      -(2147483647) - 1 <= v & v < 2147483647 + 1
    holds
      Count.[t2,[a,[0,[i2,v]]]] =
        Count.[a6,[a,[0,[i2,v]]]]
proof
end;
::$P+
