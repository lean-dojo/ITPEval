(*
  Corrected semantic authority for the imported A_StrPBrk theory.
  The pinned generated theory is retained unchanged elsewhere.
*)

theory A_StrPBrkCorrected

  use import int.Int

  type addr
  type char_memory

  constant null_addr : addr
  function shift addr int : addr
  function read char_memory addr : int
  function l_strlen char_memory addr : int
  predicate addr_le addr addr
  predicate addr_lt addr addr

  predicate p_in_array (mchar: char_memory) (s: addr) (c: int) =
    exists a: addr.
      read mchar a = c /\
      addr_le s a /\
      addr_lt a (shift s (l_strlen mchar s))

  function l_strpbrk char_memory addr addr : addr

  axiom Q_strpbrk_base_case:
    forall mchar: char_memory, s accept: addr.
      read mchar s = 0 ->
      l_strpbrk mchar s accept = null_addr

  axiom Q_strpbrk_found:
    forall mchar: char_memory, s accept: addr.
      read mchar s <> 0 ->
      p_in_array mchar accept (read mchar s) ->
      l_strpbrk mchar s accept = s

  axiom Q_strpbrk_not_found:
    forall mchar: char_memory, s accept: addr.
      read mchar s <> 0 ->
      not p_in_array mchar accept (read mchar s) ->
      l_strpbrk mchar (shift s 1) accept =
      l_strpbrk mchar s accept

end
