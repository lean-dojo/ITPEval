% Statement-only formalization of the VERINA corpus artifact verina_basic_98
% (verina__pvs__verina_basic_98), catalog title "Triple": the total executable
% integer program multiplies its input by three and satisfies its exact
% integer-division correctness contract. This file contains no proof.

verina_basic_98: THEORY
BEGIN

  Triple_precond(x: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  Triple(x: int): int =
    x * 3

  % The source precondition proof argument is logically irrelevant here.
  Triple_postcond(
      x, result: int): bool =
    ndiv(result, 3) = x
      AND ndiv(result, 3) * 3 = result

  Triple_spec_satisfied: bool =
    FORALL (x: int):
      Triple_precond(x)
        IMPLIES
          Triple_postcond(
            x,
            Triple(x))

END verina_basic_98
