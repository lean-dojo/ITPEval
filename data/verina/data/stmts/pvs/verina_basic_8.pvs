% Statement-only formalization of the VERINA corpus artifact verina_basic_8
% (verina__pvs__verina_basic_8), catalog title "myMin": the deterministic
% integer program returns the smaller of two inputs and satisfies its
% lower-bound and input-membership correctness contract. This file contains no proof.

verina_basic_8: THEORY
BEGIN

  myMin_precond(
      a, b: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  myMin(
      a, b: int): int =
    IF a <= b THEN
      a
    ELSE
      b
    ENDIF

  % The source proof argument to the postcondition is logically irrelevant.
  myMin_postcond(
      a, b, result: int): bool =
    (result <= a
      AND result <= b)
      AND
    (result = a
      OR result = b)

  myMin_spec_satisfied: bool =
    FORALL (a, b: int):
      myMin_precond(a, b)
        IMPLIES
          myMin_postcond(
            a,
            b,
            myMin(a, b))

END verina_basic_8
