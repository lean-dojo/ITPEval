% Statement-only formalization of the VERINA corpus artifact verina_basic_11,
% catalog title "lastDigit": computing a natural number's final decimal digit
% and specifying its range and equality to the remainder modulo ten. This file
% contains no proof.

verina_basic_11: THEORY
BEGIN

  lastDigit_precond(n: nat): bool =
    TRUE

  % Lean natural-number subtraction is truncated at zero.
  nat_subtract(first, second: nat): nat =
    IF first >= second THEN first - second ELSE 0 ENDIF

  % The source precondition proof argument is computationally irrelevant.
  lastDigit(n: nat): nat =
    mod(n, 10)

  lastDigit_postcond(
      n, result: nat): bool =
    (0 <= result AND result < 10)
      AND
        (nat_subtract(mod(n, 10), result) = 0
          AND nat_subtract(result, mod(n, 10)) = 0)

  lastDigit_spec_satisfied: bool =
    FORALL (n: nat):
      lastDigit_precond(n)
        IMPLIES
          lastDigit_postcond(
            n,
            lastDigit(n))

END verina_basic_11
