% Statement-only formalization of the VERINA corpus artifact verina_basic_78
% (verina__pvs__verina_basic_78), catalog title "MultipleReturns": computing
% the sum and difference of two integers as a pair and stating the complete
% program correctness contract. This file contains no proof.

verina_basic_78: THEORY
BEGIN

  int_pair: TYPE =
    [# first_value: int,
       second_value: int #]

  MultipleReturns_precond(
      x, y: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  MultipleReturns(
      x, y: int): int_pair =
    LET more: int = x + y,
        less: int = x - y
    IN
      (# first_value := more,
         second_value := less #)

  % The source proof argument to the postcondition is logically irrelevant.
  MultipleReturns_postcond(
      x, y: int,
      result: int_pair): bool =
    first_value(result) = x + y
      AND second_value(result) + y = x

  MultipleReturns_spec_satisfied: bool =
    FORALL (x, y: int):
      MultipleReturns_precond(x, y)
        IMPLIES
          MultipleReturns_postcond(
            x,
            y,
            MultipleReturns(x, y))

END verina_basic_78
