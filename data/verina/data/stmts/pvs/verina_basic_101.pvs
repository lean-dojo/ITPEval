% Statement-only formalization of the VERINA corpus artifact verina_basic_101,
% catalog title "Triple": computing three times any integer by first doubling
% it and then adding the original input. This file contains no proof.

verina_basic_101: THEORY
BEGIN

  Triple_precond(x: int): bool =
    TRUE

  Triple(x: int): int =
    LET y: int = x * 2
    IN y + x

  Triple_postcond(
      x, result: int): bool =
    ndiv(result, 3) = x
      AND ndiv(result, 3) * 3 = result

  Triple_spec_satisfied: bool =
    FORALL (x: int):
      Triple_precond(x)
        IMPLIES
          Triple_postcond(
            x,
            Triple(x))

END verina_basic_101
