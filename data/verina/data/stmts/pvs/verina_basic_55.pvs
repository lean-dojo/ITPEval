% Statement-only formalization of the VERINA corpus artifact verina_basic_55
% (verina__pvs__verina_basic_55), catalog title "Compare": comparing two
% integers for equality returns true exactly when they are equal and false
% otherwise. This file contains no proof.

verina_basic_55: THEORY
BEGIN

  Compare_precond(
      a, b: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  Compare(
      a, b: int): bool =
    IF a = b THEN TRUE ELSE FALSE ENDIF

  Compare_postcond(
      a, b: int,
      result: bool): bool =
    (a = b IMPLIES result = TRUE)
      AND (a /= b IMPLIES result = FALSE)

  Compare_spec_satisfied: bool =
    FORALL (a, b: int):
      Compare_precond(a, b)
        IMPLIES
          Compare_postcond(
            a,
            b,
            Compare(a, b))

END verina_basic_55
