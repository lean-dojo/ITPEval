% Statement-only formalization of the VERINA corpus artifact
% verina_advanced_41, catalog title "maxOfThree": deterministically selecting
% the maximum of three integers and specifying upper-bound and input-membership
% correctness. This file contains no proof.

verina_advanced_41: THEORY
BEGIN

  maxOfThree_precond(a, b, c: int): bool =
    TRUE

  maxOfThree(a, b, c: int): int =
    IF a >= b AND a >= c THEN
      a
    ELSE
      IF b >= a AND b >= c THEN
        b
      ELSE
        c
      ENDIF
    ENDIF

  maxOfThree_postcond(
      a, b, c, result: int): bool =
    (result >= a AND result >= b AND result >= c)
      AND (result = a OR result = b OR result = c)

  maxOfThree_spec_satisfied: bool =
    FORALL (a, b, c: int):
      maxOfThree_precond(a, b, c) IMPLIES
        maxOfThree_postcond(
          a,
          b,
          c,
          maxOfThree(a, b, c))

END verina_advanced_41
