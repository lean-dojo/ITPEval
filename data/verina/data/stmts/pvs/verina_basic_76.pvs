% Statement-only formalization of the VERINA corpus artifact verina_basic_76
% (verina__pvs__verina_basic_76), catalog title "myMin": the deterministic
% integer comparison returns the smaller input and satisfies its conditional
% minimum correctness contract. This file contains no proof.

verina_basic_76: THEORY
BEGIN

  myMin_precond(
      x, y: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  myMin(
      x, y: int): int =
    IF x < y THEN
      x
    ELSE
      y
    ENDIF

  % The source proof argument to the postcondition is logically irrelevant.
  myMin_postcond(
      x, y, result: int): bool =
    (x <= y IMPLIES result = x)
      AND
    (x > y IMPLIES result = y)

  myMin_spec_satisfied: bool =
    FORALL (x, y: int):
      myMin_precond(x, y)
        IMPLIES
          myMin_postcond(
            x,
            y,
            myMin(x, y))

END verina_basic_76
