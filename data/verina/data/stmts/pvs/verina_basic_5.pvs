% Statement-only formalization of the VERINA corpus artifact verina_basic_5,
% catalog title "multiply": computing the product of two integers and
% specifying it by the source's two subtraction equalities. This file contains
% no proof.

verina_basic_5: THEORY
BEGIN

  multiply_precond(
      a, b: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  multiply(
      a, b: int): int =
    a * b

  multiply_postcond(
      a, b, result: int): bool =
    result - a * b = 0
      AND a * b - result = 0

  multiply_spec_satisfied: bool =
    FORALL (a, b: int):
      multiply_precond(a, b)
        IMPLIES
          multiply_postcond(
            a,
            b,
            multiply(a, b))

END verina_basic_5
