% Statement-only formalization of the VERINA corpus artifact verina_basic_59
% (verina__pvs__verina_basic_59), catalog title "DoubleQuadruple": computing
% an integer pair whose first component is twice the input and whose second
% component is twice the first. This file contains no proof.

verina_basic_59: THEORY
BEGIN

  int_pair: TYPE =
    [# fst: int, snd: int #]

  DoubleQuadruple_precond(
      x: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  DoubleQuadruple(
      x: int): int_pair =
    LET a: int = 2 * x,
        b: int = 2 * a
    IN
      (# fst := a, snd := b #)

  % The source precondition proof argument is logically irrelevant here.
  DoubleQuadruple_postcond(
      x: int,
      result: int_pair): bool =
    fst(result) = 2 * x
      AND snd(result) = 2 * fst(result)

  DoubleQuadruple_spec_satisfied: bool =
    FORALL (x: int):
      DoubleQuadruple_precond(x)
        IMPLIES
          DoubleQuadruple_postcond(
            x,
            DoubleQuadruple(x))

END verina_basic_59
