% Statement-only formalization of the VERINA corpus artifact verina_basic_100,
% catalog title "Triple": computing three times any integer by a zero branch
% and otherwise adding the input to twice itself. This file contains no proof.

verina_basic_100: THEORY
BEGIN

  Triple_precond(x: int): bool =
    TRUE

  Triple(x: int): int =
    IF x = 0 THEN
      0
    ELSE
      LET y: int = 2 * x
      IN x + y
    ENDIF

  Triple_postcond(
      x, result: int): bool =
    ndiv(result, 3) = x
      AND ndiv(result, 3) * 3 = result

  Triple_spec_satisfied: bool =
    FORALL (x: int):
      Triple_precond(x)
        IMPLIES
          Triple_postcond(
            x,
            Triple(x))

END verina_basic_100
