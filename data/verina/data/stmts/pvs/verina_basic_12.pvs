% Statement-only formalization of the VERINA corpus artifact verina_basic_12,
% catalog title "cubeSurfaceArea": computing the natural-number surface area
% of a cube from its edge length. This file contains no proof.

verina_basic_12: THEORY
BEGIN

  cubeSurfaceArea_precond(size: nat): bool =
    TRUE

  % Lean natural-number subtraction is truncated at zero.
  nat_subtract(first, second: nat): nat =
    IF first >= second THEN first - second ELSE 0 ENDIF

  % The source precondition proof argument is computationally irrelevant.
  cubeSurfaceArea(size: nat): nat =
    6 * size * size

  cubeSurfaceArea_postcond(
      size, result: nat): bool =
    nat_subtract(result, 6 * size * size) = 0
      AND nat_subtract(6 * size * size, result) = 0

  cubeSurfaceArea_spec_satisfied: bool =
    FORALL (size: nat):
      cubeSurfaceArea_precond(size)
        IMPLIES
          cubeSurfaceArea_postcond(
            size,
            cubeSurfaceArea(size))

END verina_basic_12
