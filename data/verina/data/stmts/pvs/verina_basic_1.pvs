% Statement-only formalization of the VERINA corpus artifact verina_basic_1,
% catalog title "hasOppositeSign": integer multiplication detects exactly when
% two integers have opposite nonzero signs. This file contains no proof.

verina_basic_1: THEORY
BEGIN

  hasOppositeSign_precond(
      a, b: int): bool =
    TRUE

  hasOppositeSign(
      a, b: int): bool =
    a * b < 0

  hasOppositeSign_postcond(
      a, b: int,
      result: bool): bool =
    LET opposite_sign: bool =
      (a < 0 AND b > 0)
        OR (a > 0 AND b < 0)
    IN
      (opposite_sign IMPLIES result)
        AND
      (NOT opposite_sign IMPLIES NOT result)

  hasOppositeSign_spec_satisfied: bool =
    FORALL (a, b: int):
      hasOppositeSign_precond(a, b)
        IMPLIES
          hasOppositeSign_postcond(
            a,
            b,
            hasOppositeSign(a, b))

END verina_basic_1
