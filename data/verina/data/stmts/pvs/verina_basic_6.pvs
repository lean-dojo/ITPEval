% Statement-only formalization of the VERINA corpus artifact verina_basic_6,
% catalog title "minOfThree": the deterministic integer program returns the
% minimum of three inputs and satisfies its lower-bound and input-membership
% correctness contract. This file contains no proof.

verina_basic_6: THEORY
BEGIN

  minOfThree_precond(
      a, b, c: int): bool =
    TRUE

  % The source precondition proof argument is computationally irrelevant.
  minOfThree(
      a, b, c: int): int =
    IF a <= b AND a <= c THEN
      a
    ELSIF b <= a AND b <= c THEN
      b
    ELSE
      c
    ENDIF

  minOfThree_postcond(
      a, b, c, result: int): bool =
    (result <= a
      AND result <= b
      AND result <= c)
      AND
    (result = a
      OR result = b
      OR result = c)

  minOfThree_spec_satisfied: bool =
    FORALL (a, b, c: int):
      minOfThree_precond(a, b, c)
        IMPLIES
          minOfThree_postcond(
            a,
            b,
            c,
            minOfThree(a, b, c))

END verina_basic_6
