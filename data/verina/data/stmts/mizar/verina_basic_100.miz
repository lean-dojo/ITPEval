:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_100, catalog title "Triple": the unconditional precondition,
:: exact conditional integer implementation, integer-division postcondition,
:: and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, INT_1, INT_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2,
    NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELAT_1, FUNCT_1, CARD_1, NUMBERS,
    NAT_1, INT_1, INT_2, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NAT_1, INT_1, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x,result being Integer st
    0 = 0 &
    ((x = 0 & result = 0) or
     (x <> 0 & result = x + 2 * x))
  holds
    result div (3 qua Integer) = x &
    (result div (3 qua Integer)) * 3 = result
proof
end;
::$P+
