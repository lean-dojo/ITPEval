:: Statement-only formalization of the VERINA corpus artifact verina_basic_67
:: (verina__mizar__verina_basic_67), catalog title "IsPalindrome": an exact
:: Unicode-scalar finite-sequence encoding of the unconditional precondition,
:: recursive optional-index Boolean implementation, mirrored-index
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex isPalindromePrecond being Function of NAT*,BOOLEAN,
     isPalindromeHelper being Function of [:NAT*,NAT,NAT:],BOOLEAN,
     isPalindrome being Function of NAT*,BOOLEAN,
     isPalindromePostcond being
       Function of [:NAT*,BOOLEAN:],BOOLEAN st
    (for x being FinSequence of NAT holds
      isPalindromePrecond/.x = TRUE) &
    (for x being FinSequence of NAT, i,j being Nat holds
      (not i < j &
        isPalindromeHelper/.[x,i,j] = TRUE) or
      (i < j & (len x <= i or len x <= j) &
        isPalindromeHelper/.[x,i,j] = FALSE) or
      (i < j & i < len x & j < len x &
        x/.(i + 1) <> x/.(j + 1) &
        isPalindromeHelper/.[x,i,j] = FALSE) or
      (i < j & i < len x & j < len x &
        x/.(i + 1) = x/.(j + 1) &
        isPalindromeHelper/.[x,i,j] =
          isPalindromeHelper/.[x,i + 1,j -' 1])) &
    (for x being FinSequence of NAT holds
      (len x = 0 & isPalindrome/.x = TRUE) or
      (len x <> 0 &
        isPalindrome/.x =
          isPalindromeHelper/.[x,0,len x -' 1])) &
    (for x being FinSequence of NAT,
         result being Element of BOOLEAN holds
      (isPalindromePostcond/.[x,result] = TRUE iff
        (result = TRUE iff
          for i being Nat st i < len x holds
            x/.(i + 1) =
              x/.(((len x -' i) -' 1) + 1))) &
      (isPalindromePostcond/.[x,result] = FALSE iff
        not
          (result = TRUE iff
            for i being Nat st i < len x holds
              x/.(i + 1) =
                x/.(((len x -' i) -' 1) + 1)))) &
    (for x being FinSequence of NAT st
      (for i being Nat st i in dom x holds
        x/.i < 1114112 &
        (x/.i < 55296 or 57343 < x/.i)) &
      isPalindromePrecond/.x = TRUE
    holds
      isPalindromePostcond/.[x,isPalindrome/.x] = TRUE)
proof
end;
::$P+
