:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_37, catalog title "findFirstOccurrence": the non-decreasing
:: integer-array precondition, exact zero-based recursive search with early
:: greater-than termination, first-occurrence postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex findFirstOccurrencePrecond being
       Function of [:INT*,INT:],BOOLEAN,
     findFirstOccurrenceLoop being
       Function of [:NAT,INT*,INT:],INT,
     findFirstOccurrence being Function of [:INT*,INT:],INT,
     findFirstOccurrencePostcond being
       Function of [:INT*,INT,INT:],BOOLEAN st
    (for a being FinSequence of INT, target being Integer holds
      (((for i,j being Nat st
          i in dom a & j in dom a & i < j
        holds a/.i <= a/.j) &
          findFirstOccurrencePrecond/.[a,target] = TRUE) or
       (not (for i,j being Nat st
          i in dom a & j in dom a & i < j
        holds a/.i <= a/.j) &
          findFirstOccurrencePrecond/.[a,target] = FALSE))) &
    (for a being FinSequence of INT, target being Integer,
         i being Nat st i < len a
    holds
      ((a/.(i + 1) = target &
          findFirstOccurrenceLoop/.[i,a,target] = i) or
       (a/.(i + 1) > target &
          findFirstOccurrenceLoop/.[i,a,target] = -1) or
       (a/.(i + 1) < target &
          findFirstOccurrenceLoop/.[i,a,target] =
            findFirstOccurrenceLoop/.[i + 1,a,target]))) &
    (for a being FinSequence of INT, target being Integer,
         i being Nat st len a <= i
    holds
      findFirstOccurrenceLoop/.[i,a,target] = -1) &
    (for a being FinSequence of INT, target being Integer holds
      findFirstOccurrence/.[a,target] =
        findFirstOccurrenceLoop/.[0,a,target]) &
    (for a being FinSequence of INT, target,result being Integer holds
      (((result = -1 or 0 <= result) &
        (0 <= result implies
          ex i being Nat st
            result = i &
            i < len a &
            a/.(i + 1) = target &
            (for k being Nat st k < i holds
              a/.(k + 1) <> target)) &
        (result = -1 implies
          for i being Nat st i < len a holds
            a/.(i + 1) <> target) &
        findFirstOccurrencePostcond/.[a,target,result] = TRUE) or
       (not ((result = -1 or 0 <= result) &
        (0 <= result implies
          ex i being Nat st
            result = i &
            i < len a &
            a/.(i + 1) = target &
            (for k being Nat st k < i holds
              a/.(k + 1) <> target)) &
        (result = -1 implies
          for i being Nat st i < len a holds
            a/.(i + 1) <> target)) &
        findFirstOccurrencePostcond/.[a,target,result] = FALSE))) &
    (for a being FinSequence of INT, target being Integer st
      findFirstOccurrencePrecond/.[a,target] = TRUE
    holds
      findFirstOccurrencePostcond/.
        [a,target,findFirstOccurrence/.[a,target]] = TRUE)
proof
end;
::$P+
