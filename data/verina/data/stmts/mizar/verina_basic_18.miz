:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_18, catalog title "sumOfDigits": the unconditional
:: precondition, exact recursive base-10 quotient-and-remainder computation,
:: decimal digit-sum postcondition, and final correctness contract. This file
:: contains no proof.

environ
  vocabularies NUMBERS, SUBSET_1, FUNCT_1, NAT_1, TARSKI, RELAT_1,
    AFINSQ_1, ARYTM_1, ARYTM_3, FINSEQ_1, XXREAL_0, CARD_1, XBOOLE_0,
    ORDINAL4, CARD_3, FINSOP_1, BINOP_2, INT_1, SERIES_1, VALUED_1,
    PREPOWER, NEWTON, POWER, NUMERAL1, RAT_1, REAL_1, SEQ_1, SEQ_2,
    ORDINAL2, SQUARE_1, XXREAL_2, SEQ_4, COMPLEX1, VALUED_0, ABIAN,
    ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, RELAT_1,
    FUNCT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, AFINSQ_1, VALUED_1,
    RELSET_1, FUNCT_2, BINOP_1, NAT_1, BINOP_2, RECDEF_1, SERIES_1,
    NEWTON, PREPOWER, AFINSQ_2, NAT_D, INT_1, RAT_1, REAL_1, COMPLEX1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SQUARE_1, SEQ_4, ABIAN, XXREAL_2,
    POWER, NUMERAL1;
  constructors PREPOWER, SERIES_1, PARTFUN3, BINOM, SETWISEO, REAL_1,
    NAT_D, RECDEF_1, BINOP_2, RELSET_1, AFINSQ_2, BINOP_1, NEWTON,
    SQUARE_1, NAT_1, SEQ_2, SEQM_3, SEQ_4, XXREAL_2, ABIAN, COMSEQ_2,
    POWER, NUMERAL1;
  registrations XBOOLE_0, RELAT_1, ORDINAL1, XXREAL_0, XREAL_0, NAT_1,
    CARD_1, NUMBERS, INT_1, BINOP_2, MEMBERED, NEWTON, AFINSQ_1,
    VALUED_1, FUNCT_2, POWER, FINSET_1, AFINSQ_2, RELSET_1, VALUED_0,
    FUNCT_1, SQUARE_1, RAT_1, PREPOWER, SEQ_4, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,result being Nat st
    0 = 0 &
    (ex k being Nat,
        values,accumulators being XFinSequence of NAT st
      len values = k + 1 &
      len accumulators = k + 1 &
      values.0 = n &
      accumulators.0 = 0 &
      values.k = 0 &
      result = accumulators.k &
      for j being Nat st j < k holds
        0 < values.j &
        values.(j + 1) = (values.j) div 10 &
        accumulators.(j + 1) =
          accumulators.j + ((values.j) mod 10))
  holds
    result -' (Sum digits(n,10)) = 0 &
    (Sum digits(n,10)) -' result = 0
proof
end;
::$P+
