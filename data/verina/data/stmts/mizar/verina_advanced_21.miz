:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_21, catalog title "isPalindrome": an exact Unicode-scalar
:: finite-sequence encoding of the unconditional precondition, recursive
:: index-check and list-reversal helpers, Boolean implementation,
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0,
    XREAL_0, XXREAL_0, NEWTON, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, NEWTON, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    FINSEQOP, NEWTON, WSIERP_1, XXREAL_0, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, NEWTON, WSIERP_1, VALUED_0,
    VALUED_1, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for s being FinSequence of NAT,
      result being Element of BOOLEAN st
    (for i being Nat st i in dom s holds
      s/.i < 1114112 &
      (s/.i < 55296 or 57343 < s/.i)) &
    0 = 0 &
    ((len s <= 1 & result = TRUE) or
     (len s > 1 &
      ex approach1,approach2 being Element of BOOLEAN,
         lefts,rights being FinSequence of NAT,
         accumulators,remainders being FinSequence of NAT*,
         reversed being FinSequence of NAT st
        0 < len lefts &
        len rights = len lefts &
        lefts/.1 = 0 &
        rights/.1 = len s - 1 &
        (for j being Nat st 1 <= j & j < len lefts holds
          lefts/.j < rights/.j &
          lefts/.j + 1 in dom s &
          rights/.j + 1 in dom s &
          s/.(lefts/.j + 1) = s/.(rights/.j + 1) &
          lefts/.(j + 1) = lefts/.j + 1 &
          rights/.(j + 1) + 1 = rights/.j) &
        ((approach1 = TRUE &
            lefts/.(len lefts) >= rights/.(len rights)) or
         (approach1 = FALSE &
            lefts/.(len lefts) < rights/.(len rights) &
            lefts/.(len lefts) + 1 in dom s &
            rights/.(len rights) + 1 in dom s &
            s/.(lefts/.(len lefts) + 1) <>
              s/.(rights/.(len rights) + 1))) &
        len accumulators = len s + 1 &
        len remainders = len s + 1 &
        accumulators/.1 = <*>NAT &
        remainders/.1 = s &
        (for k being Nat st k in dom s holds
          ex h being Nat, t being FinSequence of NAT st
            remainders/.k = (<*h*> ^ t) &
            accumulators/.(k + 1) = (<*h*> ^ accumulators/.k) &
            remainders/.(k + 1) = t) &
        remainders/.(len s + 1) = <*>NAT &
        reversed = accumulators/.(len s + 1) &
        ((approach2 = TRUE & s = reversed) or
         (approach2 = FALSE & s <> reversed)) &
        ((result = TRUE & approach1 = TRUE & approach2 = TRUE) or
         (result = FALSE &
            (approach1 = FALSE or approach2 = FALSE)))))
  holds
    (result = TRUE implies s = Rev s) &
    (result = FALSE implies len s <> 0 & s <> Rev s)
proof
end;
::$P+
