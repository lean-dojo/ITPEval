:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_103, catalog title "UpdateElements": the length precondition,
:: exact two-position integer-array update, its elementwise postcondition,
:: and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0,
    XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1,
    RELSET_1, FUNCT_2, NAT_1, FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,result being FinSequence of INT st
    8 <= len a &
    result = (a +* (5,a/.5 + 3)) +* (8,516)
  holds
    len result = len a &
    result/.5 = a/.5 + 3 &
    result/.8 = 516 &
    (for i being Nat st
      i < len a & i <> 4 & i <> 7
    holds result/.(i + 1) = a/.(i + 1))
proof
end;
::$P+
