:: Statement-only formalization of the VERINA corpus artifact verina_basic_84
:: (verina__mizar__verina_basic_84), catalog title "replace": the
:: unconditional precondition, exact zero-based bounds-checked replacement
:: loop, pointwise threshold postcondition, and final correctness contract.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    ORDINAL4, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, NAT_D, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0,
    XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex replacePrecond being Function of [:INT*,INT:],BOOLEAN,
     readDefault being Function of [:INT*,NAT:],INT,
     setBang being Function of [:INT*,NAT,INT:],INT*,
     replaceLoop being Function of [:INT*,INT,NAT,INT*:],INT*,
     replaceProgram being Function of [:INT*,INT:],INT*,
     replacePostcond being Function of [:INT*,INT,INT*:],BOOLEAN st
    (for arr being FinSequence of INT, k being Integer holds
      replacePrecond/.[arr,k] = TRUE) &
    (for arr being FinSequence of INT, i being Nat holds
      ((i < len arr &
          readDefault/.[arr,i] = arr/.(i + 1)) or
       (len arr <= i &
          readDefault/.[arr,i] = 0))) &
    (for arr being FinSequence of INT, i being Nat,
         value being Integer holds
      ((i < len arr &
          setBang/.[arr,i,value] = arr +* ((i + 1),value)) or
       (len arr <= i &
          setBang/.[arr,i,value] = arr))) &
    (for oldArr,acc being FinSequence of INT, k being Integer,
         i being Nat holds
      (i < len oldArr & readDefault/.[oldArr,i] > k &
        replaceLoop/.[oldArr,k,i,acc] =
          replaceLoop/.
            [oldArr,k,i + 1,setBang/.[acc,i,-1]]) or
      (i < len oldArr & not readDefault/.[oldArr,i] > k &
        replaceLoop/.[oldArr,k,i,acc] =
          replaceLoop/.[oldArr,k,i + 1,acc]) or
      (len oldArr <= i &
        replaceLoop/.[oldArr,k,i,acc] = acc)) &
    (for arr being FinSequence of INT, k being Integer holds
      replaceProgram/.[arr,k] =
        replaceLoop/.[arr,k,0,arr]) &
    (for arr,result being FinSequence of INT, k being Integer holds
      (replacePostcond/.[arr,k,result] = TRUE iff
        len result = len arr &
        (for i being Nat st i < len arr holds
          (arr/.(i + 1) > k implies result/.(i + 1) = -1)) &
        (for i being Nat st i < len arr holds
          (arr/.(i + 1) <= k implies
            result/.(i + 1) = arr/.(i + 1)))) &
      (replacePostcond/.[arr,k,result] = FALSE iff
        not
          (len result = len arr &
           (for i being Nat st i < len arr holds
             (arr/.(i + 1) > k implies result/.(i + 1) = -1)) &
           (for i being Nat st i < len arr holds
             (arr/.(i + 1) <= k implies
               result/.(i + 1) = arr/.(i + 1)))))) &
    (for arr being FinSequence of INT, k being Integer st
      replacePrecond/.[arr,k] = TRUE
    holds
      replacePostcond/.[arr,k,replaceProgram/.[arr,k]] = TRUE)
proof
end;
::$P+
