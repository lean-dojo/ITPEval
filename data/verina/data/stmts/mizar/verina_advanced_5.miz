:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_5, catalog title "addTwoNumbers": reverse-decimal
:: list evaluation, the canonical-digit precondition, exact recursive
:: carry-propagating addition, its postcondition, and final correctness
:: contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, FINSEQ_5;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for l1,l2,result being FinSequence of NAT,
      n1,n2,nr being Nat st
    0 < len l1 &
    0 < len l2 &
    (for i being Nat st i in dom l1 holds l1/.i < 10) &
    (for i being Nat st i in dom l2 holds l2/.i < 10) &
    (l1/.(len l1) <> 0 or l1 = <*0*>) &
    (l2/.(len l2) <> 0 or l2 = <*0*>) &
    (ex listToNat being Function of NAT*,NAT,
        addAux being Function of [:NAT*,NAT*,NAT:],NAT* st
      listToNat/.(<*>NAT) = 0 &
      (for d being Nat, ds being FinSequence of NAT holds
        listToNat/.(<*d*> ^ ds) =
          d + (10 qua Nat) * listToNat/.ds) &
      (for carry being Nat holds
        ((carry = 0 &
            addAux/.[<*>NAT,<*>NAT,carry] = <*>NAT) or
         (carry <> 0 &
            addAux/.[<*>NAT,<*>NAT,carry] = <*carry*>))) &
      (for h1,carry being Nat, t1 being FinSequence of NAT holds
        addAux/.[<*h1*> ^ t1,<*>NAT,carry] =
          <*((h1 + carry) mod (10 qua Nat))*>
            ^ addAux/.[t1,<*>NAT,
                (h1 + carry) div (10 qua Nat)]) &
      (for h2,carry being Nat, t2 being FinSequence of NAT holds
        addAux/.[<*>NAT,<*h2*> ^ t2,carry] =
          <*((h2 + carry) mod (10 qua Nat))*>
            ^ addAux/.[<*>NAT,t2,
                (h2 + carry) div (10 qua Nat)]) &
      (for h1,h2,carry being Nat,
           t1,t2 being FinSequence of NAT holds
        addAux/.[<*h1*> ^ t1,<*h2*> ^ t2,carry] =
          <*((h1 + h2 + carry) mod (10 qua Nat))*>
            ^ addAux/.[t1,t2,
                (h1 + h2 + carry) div (10 qua Nat)]) &
      result = addAux/.[l1,l2,0] &
      n1 = listToNat/.l1 &
      n2 = listToNat/.l2 &
      nr = listToNat/.result)
  holds
    nr = n1 + n2 &
    (for i being Nat st i in dom result holds result/.i < 10) &
    ((0 < len result & result/.(len result) <> 0) or
      (l1 = <*0*> & l2 = <*0*> & result = <*0*>))
proof
end;
::$P+
