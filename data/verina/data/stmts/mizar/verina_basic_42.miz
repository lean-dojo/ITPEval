:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_42, catalog title "countDigits": an exact Unicode-scalar
:: finite-sequence encoding of the ASCII digit test, unconditional
:: precondition, deterministic left-to-right counting implementation,
:: truncated-subtraction postcondition, and final correctness contract.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex isDigit being Function of NAT,BOOLEAN,
     countDigitsPrecond being Function of NAT*,BOOLEAN,
     countDigits being Function of NAT*,NAT,
     countDigitsPostcond being Function of [:NAT*,NAT:],BOOLEAN st
    (for c being Nat holds
      ((48 <= c & c <= 57 & isDigit/.c = TRUE) or
       ((c < 48 or 57 < c) & isDigit/.c = FALSE))) &
    (for s being FinSequence of NAT holds
      countDigitsPrecond/.s = TRUE) &
    (for s being FinSequence of NAT holds
      ex counts being FinSequence of NAT st
        len counts = len s + 1 &
        counts/.1 = 0 &
        (for k being Nat st k in dom s holds
          ((isDigit/.(s/.k) = TRUE &
            counts/.(k + 1) = counts/.k + 1) or
           (isDigit/.(s/.k) = FALSE &
            counts/.(k + 1) = counts/.k))) &
        countDigits/.s = counts/.(len s + 1)) &
    (for s being FinSequence of NAT, result being Nat holds
      (((result -' countDigits/.s = 0 &
          countDigits/.s -' result = 0) &
        countDigitsPostcond/.[s,result] = TRUE) or
       (not (result -' countDigits/.s = 0 &
             countDigits/.s -' result = 0) &
        countDigitsPostcond/.[s,result] = FALSE))) &
    (for s being FinSequence of NAT st
      (for i being Nat st i in dom s holds
        s/.i < 1114112 &
        (s/.i < 55296 or 57343 < s/.i)) &
      countDigitsPrecond/.s = TRUE
    holds
      countDigitsPostcond/.[s,countDigits/.s] = TRUE)
proof
end;
::$P+
