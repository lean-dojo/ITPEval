:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_16, catalog title "replaceChars": an exact Unicode-scalar
:: finite-sequence encoding of the unconditional precondition, deterministic
:: character-replacement map implementation, its length-and-pointwise
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0,
    XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1,
    FINSEQ_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s,result being FinSequence of NAT,
      oldChar,newChar being Nat st
    (for i being Nat st i in dom s holds
      s/.i < 1114112 &
      (s/.i < 55296 or 57343 < s/.i)) &
    oldChar < 1114112 &
    (oldChar < 55296 or 57343 < oldChar) &
    newChar < 1114112 &
    (newChar < 55296 or 57343 < newChar) &
    0 = 0 &
    (ex replace being Function of NAT,NAT st
      (for c being Element of NAT holds
        (c = oldChar & replace.c = newChar) or
        (c <> oldChar & replace.c = c)) &
      result = replace * s)
  holds
    len result = len s &
    (for i being Nat st i in dom s holds
      (s/.i = oldChar implies result/.i = newChar) &
      (s/.i <> oldChar implies result/.i = s/.i))
proof
end;
::$P+
