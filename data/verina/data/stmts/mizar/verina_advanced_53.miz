:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_53, catalog title "minimumRightShifts": the distinct-
:: integer-list precondition, exact repeated right-shift implementation with
:: adjacent-order stopping checks, minimum-shift postcondition using pairwise
:: sortedness, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_5, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FINSEQ_5;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    FINSEQOP, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nums being FinSequence of INT,
      result being Integer st
    nums is one-to-one &
    ((len nums <= 1 & result = 0) or
     (1 < len nums &
      ex rotations being FinSequence of INT* st
        len rotations = len nums &
        rotations/.1 = nums &
        (for k being Nat st 1 <= k & k < len rotations holds
          ex current,next being FinSequence of INT st
            current = rotations/.k &
            next = rotations/.(k + 1) &
            len next = len current &
            next/.1 = current/.(len current) &
            for i being Nat st 1 <= i & i < len current holds
              next/.(i + 1) = current/.i) &
        (((for i being Nat st 1 <= i & i < len nums holds
              nums/.i <= nums/.(i + 1)) &
            result = 0) or
         (not (for i being Nat st 1 <= i & i < len nums holds
              nums/.i <= nums/.(i + 1)) &
          ((ex q being Nat, shifted being FinSequence of INT st
              1 <= q & q < len nums &
              shifted = rotations/.(q + 1) &
              result = q &
              (for i being Nat st 1 <= i & i < len shifted holds
                shifted/.i <= shifted/.(i + 1)) &
              for j being Nat st 1 <= j & j < q holds
                ex earlier being FinSequence of INT st
                  earlier = rotations/.(j + 1) &
                  not (for i being Nat st
                    1 <= i & i < len earlier
                  holds earlier/.i <= earlier/.(i + 1))) or
           (result = -1 &
            for q being Nat st 1 <= q & q < len nums holds
              ex shifted being FinSequence of INT st
                shifted = rotations/.(q + 1) &
                not (for i being Nat st
                  1 <= i & i < len shifted
                holds shifted/.i <= shifted/.(i + 1))))))))
  holds
    (len nums <= 1 & result = 0) or
    (1 < len nums &
     ex rotations being FinSequence of INT* st
       len rotations = len nums &
       rotations/.1 = nums &
       (for k being Nat st 1 <= k & k < len rotations holds
         ex current,next being FinSequence of INT st
           current = rotations/.k &
           next = rotations/.(k + 1) &
           len next = len current &
           next/.1 = current/.(len current) &
           for i being Nat st 1 <= i & i < len current holds
             next/.(i + 1) = current/.i) &
       ((0 <= result & result < len nums &
         ex q being Nat, shifted being FinSequence of INT st
           result = q &
           q < len nums &
           shifted = rotations/.(q + 1) &
           (for i,j being Nat st
             i in dom shifted & j in dom shifted & i < j
           holds shifted/.i <= shifted/.j) &
           for h being Nat st h < q holds
             ex earlier being FinSequence of INT st
               earlier = rotations/.(h + 1) &
               not (for i,j being Nat st
                 i in dom earlier & j in dom earlier & i < j
               holds earlier/.i <= earlier/.j)) or
        (result = -1 &
         for q being Nat st q < len nums holds
           ex shifted being FinSequence of INT st
             shifted = rotations/.(q + 1) &
             not (for i,j being Nat st
               i in dom shifted & j in dom shifted & i < j
             holds shifted/.i <= shifted/.j))))
proof
end;
::$P+
