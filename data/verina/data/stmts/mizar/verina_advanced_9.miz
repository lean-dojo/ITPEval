:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_9, catalog title "countSumDivisibleBy": exact execution-
:: graph encodings of decimal digit summation, the positive-divisor
:: precondition, divisibility test, counting implementation, postcondition,
:: and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, CARD_3, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, VALUED_0,
    VALUED_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2;
  constructors REAL_1, NAT_D, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1,
    FUNCT_2, CARD_1, NUMBERS, NAT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, VALUED_0,
    VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,d,result being Nat st
    d > 0 &
    (ex indices,accumulators,digitSums being FinSequence of NAT st
      len indices = n + 1 &
      len accumulators = n + 1 &
      len digitSums = n &
      indices/.1 = n &
      accumulators/.1 = 0 &
      indices/.(n + 1) = 0 &
      result = accumulators/.(n + 1) &
      for k being Nat st 1 <= k & k <= n holds
        0 < indices/.k &
        indices/.(k + 1) + 1 = indices/.k &
        (ex values,sums being FinSequence of NAT st
          0 < len values &
          len sums = len values &
          values/.1 = indices/.(k + 1) &
          sums/.1 = 0 &
          values/.(len values) = 0 &
          sums/.(len sums) = digitSums/.k &
          for j being Nat st 1 <= j & j < len values holds
            0 < values/.j &
            values/.(j + 1) = (values/.j) div 10 &
            sums/.(j + 1) = sums/.j + ((values/.j) mod 10)) &
        (((digitSums/.k) mod d = 0 &
          accumulators/.(k + 1) = accumulators/.k + 1) or
         ((digitSums/.k) mod d <> 0 &
          accumulators/.(k + 1) = accumulators/.k)))
  holds
    ex counts,digitSums being FinSequence of NAT st
      len counts = n + 1 &
      len digitSums = n &
      counts/.1 = 0 &
      (for k being Nat st k < n holds
        (ex values,sums being FinSequence of NAT st
          0 < len values &
          len sums = len values &
          values/.1 = k &
          sums/.1 = 0 &
          values/.(len values) = 0 &
          sums/.(len sums) = digitSums/.(k + 1) &
          for j being Nat st 1 <= j & j < len values holds
            0 < values/.j &
            values/.(j + 1) = (values/.j) div 10 &
            sums/.(j + 1) = sums/.j + ((values/.j) mod 10)) &
        (((digitSums/.(k + 1)) mod d = 0 &
          counts/.(k + 2) = counts/.(k + 1) + 1) or
         ((digitSums/.(k + 1)) mod d <> 0 &
          counts/.(k + 2) = counts/.(k + 1)))) &
      counts/.(n + 1) -' result = 0 &
      result <= counts/.(n + 1)
proof
end;
::$P+
