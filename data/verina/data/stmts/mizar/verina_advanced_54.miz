:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_54, catalog title "missingNumber": the bounded distinct-
:: natural-list precondition, exact triangular-sum-minus-fold implementation
:: with natural subtraction, unique-missing-number postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, CARD_1,
    ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    VALUED_0, VALUED_1, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2,
    NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0,
    VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nums being FinSequence of NAT,
      result being Nat st
    (for i being Nat st i in dom nums holds nums/.i <= len nums) &
    nums is one-to-one &
    result = ((len nums * (len nums + 1)) div 2) -' Sum nums
  holds
    result <= len nums &
    not result in rng nums &
    for x being Nat st x <= len nums & x <> result holds
      x in rng nums
proof
end;
::$P+
