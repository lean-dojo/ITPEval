:: Statement-only formalization of the VERINA corpus artifact verina_basic_99
:: (verina__mizar__verina_basic_99), catalog title "Triple": the
:: unconditional integer precondition, exact branch-at-18 arithmetic
:: implementation, integer-division postcondition, and final correctness
:: contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, CARD_1,
    ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    MCART_1, XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, XBOOLEAN, MARGREL1;
  constructors REAL_1, NAT_D, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1,
    FUNCT_2, CARD_1, NUMBERS, NAT_1, INT_1, INT_2, XXREAL_0,
    XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex triplePrecond being Function of INT,BOOLEAN,
     tripleProgram being Function of INT,INT,
     triplePostcond being Function of [:INT,INT:],BOOLEAN st
    (for x being Integer holds
      triplePrecond/.x = TRUE) &
    (for x being Integer holds
      ((x < 18 &
          tripleProgram/.x =
            ((2 qua Integer) * x + (4 qua Integer) * x)
              div (2 qua Integer)) or
       (not x < 18 &
          tripleProgram/.x = x + (2 qua Integer) * x))) &
    (for x,result being Integer holds
      (triplePostcond/.[x,result] = TRUE iff
        result div (3 qua Integer) = x &
        (result div (3 qua Integer)) * 3 = result) &
      (triplePostcond/.[x,result] = FALSE iff
        not
          (result div (3 qua Integer) = x &
           (result div (3 qua Integer)) * 3 = result))) &
    (for x being Integer st
      triplePrecond/.x = TRUE
    holds
      triplePostcond/.[x,tripleProgram/.x] = TRUE)
proof
end;
::$P+
