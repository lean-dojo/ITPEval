:: Statement-only formalization of the VERINA corpus artifact verina_basic_78
:: (verina__mizar__verina_basic_78), catalog title "MultipleReturns": the
:: unconditional two-integer precondition, exact sum-and-difference pair
:: implementation, tuple postcondition, and final correctness contract. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex multipleReturnsPrecond being Function of [:INT,INT:],BOOLEAN,
     multipleReturns being Function of [:INT,INT:],[:INT,INT:],
     multipleReturnsPostcond being
       Function of [:[:INT,INT:],[:INT,INT:]:],BOOLEAN st
    (for x,y being Integer holds
      multipleReturnsPrecond/.[x,y] = TRUE) &
    (for x,y being Integer holds
      multipleReturns/.[x,y] = [x + y,x - y]) &
    (for x,y,a,b being Integer holds
      (multipleReturnsPostcond/.[[x,y],[a,b]] = TRUE iff
        a = x + y & b + y = x) &
      (multipleReturnsPostcond/.[[x,y],[a,b]] = FALSE iff
        not (a = x + y & b + y = x))) &
    (for x,y being Integer st
      multipleReturnsPrecond/.[x,y] = TRUE
    holds
      multipleReturnsPostcond/.
        [[x,y],multipleReturns/.[x,y]] = TRUE)
proof
end;
::$P+
