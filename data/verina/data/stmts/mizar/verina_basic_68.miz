:: Statement-only formalization of the VERINA corpus artifact verina_basic_68
:: (verina__mizar__verina_basic_68), catalog title "LinearSearch": the
:: unconditional precondition, exact zero-based recursive linear-search
:: implementation, first-occurrence-or-array-size postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex linearSearchPrecond being Function of [:INT*,INT:],BOOLEAN,
     readDefault being Function of [:INT*,NAT:],INT,
     linearSearchLoop being Function of [:INT*,INT,NAT:],NAT,
     linearSearchProgram being Function of [:INT*,INT:],NAT,
     linearSearchPostcond being
       Function of [:INT*,INT,NAT:],BOOLEAN st
    (for a being FinSequence of INT, e being Integer holds
      linearSearchPrecond/.[a,e] = TRUE) &
    (for a being FinSequence of INT, i being Nat holds
      ((i < len a &
          readDefault/.[a,i] = a/.(i + 1)) or
       (len a <= i &
          readDefault/.[a,i] = 0))) &
    (for a being FinSequence of INT, e being Integer,
         n being Nat holds
      ((n < len a &
          readDefault/.[a,n] = e &
          linearSearchLoop/.[a,e,n] = n) or
       (n < len a &
          readDefault/.[a,n] <> e &
          linearSearchLoop/.[a,e,n] =
            linearSearchLoop/.[a,e,n + 1]) or
       (len a <= n &
          linearSearchLoop/.[a,e,n] = n))) &
    (for a being FinSequence of INT, e being Integer holds
      linearSearchProgram/.[a,e] =
        linearSearchLoop/.[a,e,0]) &
    (for a being FinSequence of INT, e being Integer,
         result being Nat holds
      (linearSearchPostcond/.[a,e,result] = TRUE iff
        result <= len a &
        (result = len a or readDefault/.[a,result] = e) &
        (for i being Nat st i < result holds
          readDefault/.[a,i] <> e)) &
      (linearSearchPostcond/.[a,e,result] = FALSE iff
        not
          (result <= len a &
           (result = len a or readDefault/.[a,result] = e) &
           (for i being Nat st i < result holds
             readDefault/.[a,i] <> e)))) &
    (for a being FinSequence of INT, e being Integer st
      linearSearchPrecond/.[a,e] = TRUE
    holds
      linearSearchPostcond/.
        [a,e,linearSearchProgram/.[a,e]] = TRUE)
proof
end;
::$P+
