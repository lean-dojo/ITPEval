:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_6, catalog title "minOfThree": the unconditional precondition,
:: exact nested integer-comparison implementation, minimum-and-input-membership
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex minOfThreePrecond being Function of [:INT,INT,INT:],BOOLEAN,
     minOfThreeProgram being Function of [:INT,INT,INT:],INT,
     minOfThreePostcond being
       Function of [:[:INT,INT,INT:],INT:],BOOLEAN st
    (for a,b,c being Integer holds
      minOfThreePrecond/.[a,b,c] = TRUE) &
    (for a,b,c being Integer holds
      ((a <= b & a <= c &
          minOfThreeProgram/.[a,b,c] = a) or
       (not (a <= b & a <= c) &
          b <= a & b <= c &
          minOfThreeProgram/.[a,b,c] = b) or
       (not (a <= b & a <= c) &
          not (b <= a & b <= c) &
          minOfThreeProgram/.[a,b,c] = c))) &
    (for a,b,c,result being Integer holds
      (minOfThreePostcond/.[[a,b,c],result] = TRUE iff
        (result <= a & result <= b & result <= c) &
        (result = a or result = b or result = c)) &
      (minOfThreePostcond/.[[a,b,c],result] = FALSE iff
        not ((result <= a & result <= b & result <= c) &
             (result = a or result = b or result = c)))) &
    (for a,b,c being Integer st
      minOfThreePrecond/.[a,b,c] = TRUE
    holds
      minOfThreePostcond/.
        [[a,b,c],minOfThreeProgram/.[a,b,c]] = TRUE)
proof
end;
::$P+
