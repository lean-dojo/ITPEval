:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_30, catalog title "longestIncreasingStreak": an exact
:: finite-sequence operational graph of the unconditional precondition,
:: recursive contiguous-streak scan, maximal-streak postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ZFMISC_1, NUMBERS, XREAL_0, CARD_1,
    XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL4, FINSEQ_1, FINSEQ_2,
    CLASSES1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1, NAT_1, NAT_D,
    XXREAL_0, FINSEQ_1, FINSEQ_2, CLASSES1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1,
    REAL_1, INT_1, XXREAL_0, ZFMISC_1, NAT_1, NAT_D, FINSEQ_1,
    FINSEQ_2, CLASSES1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, INT_1, NAT_1,
    FINSEQ_1, FINSEQ_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nums being FinSequence of INT,
      result being Nat st
    0 = 0 &
    (ex currStates,maxStates being FinSequence of NAT st
      len currStates = len nums + 1 &
      len maxStates = len nums + 1 &
      currStates/.1 = 0 &
      maxStates/.1 = 0 &
      currStates/.(len nums + 1) <= result &
      maxStates/.(len nums + 1) <= result &
      (result = currStates/.(len nums + 1) or
       result = maxStates/.(len nums + 1)) &
      for i being Nat st i in dom nums holds
        (i = 1 &
          currStates/.(i + 1) = 1 &
          maxStates/.(i + 1) = 1) or
        (1 < i &
          ((nums/.(i -' 1) < nums/.i &
            currStates/.(i + 1) = currStates/.i + 1 &
            currStates/.i + 1 <= maxStates/.(i + 1) &
            maxStates/.i <= maxStates/.(i + 1) &
            (maxStates/.(i + 1) = currStates/.i + 1 or
             maxStates/.(i + 1) = maxStates/.i)) or
           (nums/.i <= nums/.(i -' 1) &
            currStates/.(i + 1) = 1 &
            currStates/.i <= maxStates/.(i + 1) &
            maxStates/.i <= maxStates/.(i + 1) &
            (maxStates/.(i + 1) = currStates/.i or
             maxStates/.(i + 1) = maxStates/.i)))))
  holds
    (nums = <*>INT implies result = 0) &
    (0 < result implies
      ex start being Nat st
        start < (len nums -' result) + 1 &
        start + result <= len nums &
        (for i being Nat st i < result -' 1 holds
          nums/.(start + i + 1) <
            nums/.(start + i + 2)) &
        (start = 0 or
          nums/.start >= nums/.(start + 1)) &
        (start + result = len nums or
          nums/.(start + result) >=
            nums/.(start + result + 1))) &
    (for start being Nat st start < (len nums -' result) holds
      ex i being Nat st i < result &
        (start + i + 1 >= len nums or
          nums/.(start + i + 1) >=
            nums/.(start + i + 2)))
proof
end;
::$P+
