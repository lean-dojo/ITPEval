:: Statement-only formalization of the VERINA corpus artifact verina_basic_93
:: (verina__mizar__verina_basic_93), catalog title "SwapBitvectors": the
:: unconditional UInt8 precondition, exact three-step bitwise-XOR swap
:: implementation, full pair postcondition including distinct-input position
:: changes, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0,
    MARGREL1,
    XBOOLEAN, BVFUNC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1, BVFUNC_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1, BVFUNC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1, BVFUNC_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex swapBitvectorsPrecond being Function of
       [:Funcs(Segm 8,BOOLEAN),Funcs(Segm 8,BOOLEAN):],BOOLEAN,
     swapBitvectorsProgram being Function of
       [:Funcs(Segm 8,BOOLEAN),Funcs(Segm 8,BOOLEAN):],
       [:Funcs(Segm 8,BOOLEAN),Funcs(Segm 8,BOOLEAN):],
     swapBitvectorsPostcond being Function of
       [:[:Funcs(Segm 8,BOOLEAN),Funcs(Segm 8,BOOLEAN):],
         [:Funcs(Segm 8,BOOLEAN),Funcs(Segm 8,BOOLEAN):]:],BOOLEAN st
    (for X,Y being Function of Segm 8,BOOLEAN holds
      swapBitvectorsPrecond/.[X,Y] = TRUE) &
    (for X,Y being Function of Segm 8,BOOLEAN holds
      ex temp,newY,newX being Function of Segm 8,BOOLEAN st
        temp = X 'xor' Y &
        newY = temp 'xor' Y &
        newX = temp 'xor' newY &
        swapBitvectorsProgram/.[X,Y] = [newX,newY]) &
    (for X,Y,a,b being Function of Segm 8,BOOLEAN holds
      (swapBitvectorsPostcond/.[[X,Y],[a,b]] = TRUE iff
        a = Y & b = X &
        (X <> Y implies a <> X & b <> Y)) &
      (swapBitvectorsPostcond/.[[X,Y],[a,b]] = FALSE iff
        not
          (a = Y & b = X &
           (X <> Y implies a <> X & b <> Y)))) &
    (for X,Y being Function of Segm 8,BOOLEAN st
      swapBitvectorsPrecond/.[X,Y] = TRUE
    holds
      swapBitvectorsPostcond/.
        [[X,Y],swapBitvectorsProgram/.[X,Y]] = TRUE)
proof
end;
::$P+
