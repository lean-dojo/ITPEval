:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_20, catalog title "isItEight": an exact finite-trace
:: encoding of the unconditional precondition, recursive decimal-digit-eight
:: helper, divisibility-or-digit Boolean implementation, postcondition, and
:: final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0,
    REAL_1, XXREAL_0, COMPLEX1, NEWTON, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1,
    NAT_D, FINSEQ_1, FINSEQ_2, NEWTON, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, REAL_1, COMPLEX1, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, FINSEQOP, NEWTON, WSIERP_1, XXREAL_0, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, NEWTON, WSIERP_1, VALUED_0,
    VALUED_1, COMPLEX1, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for n being Integer, result being Element of BOOLEAN st
    0 = 0 &
    (ex absN being Nat, digitResult being Element of BOOLEAN,
        trace being FinSequence of NAT st
      absN = |.n.| &
      0 < len trace &
      trace/.1 = absN &
      (for j being Nat st 1 <= j & j < len trace holds
        trace/.j <> 0 &
        trace/.j mod (10 qua Nat) <> 8 &
        trace/.(j + 1) = trace/.j div (10 qua Nat)) &
      ((digitResult = TRUE &
          trace/.(len trace) <> 0 &
          trace/.(len trace) mod (10 qua Nat) = 8) or
       (digitResult = FALSE & trace/.(len trace) = 0)) &
      ((result = TRUE &
          (n mod (8 qua Integer) = 0 or digitResult = TRUE)) or
       (result = FALSE &
          n mod (8 qua Integer) <> 0 & digitResult = FALSE)))
  holds
    ex absN being Nat st
      absN = |.n.| &
      ((n mod (8 qua Integer) = 0 or
        ex i being Nat st
          (absN div ((10 qua Nat) |^ i)) mod (10 qua Nat) = 8)
        iff result = TRUE)
proof
end;
::$P+
