:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_1, catalog title "hasOppositeSign": the unconditional
:: precondition, exact integer-product sign-test Boolean implementation,
:: opposite-sign postcondition, and final correctness contract. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, INT_1, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0,
    XREAL_0, XXREAL_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, NAT_1, INT_1, XXREAL_0,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, FUNCT_1, CARD_1, NUMBERS, NAT_1, INT_1,
    XXREAL_0, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, CARD_1, NAT_1,
    INT_1, XCMPLX_0, XREAL_0, XXREAL_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a,b being Integer, result being Element of BOOLEAN st
    0 = 0 &
    ((result = TRUE & a * b < 0) or
     (result = FALSE & not a * b < 0))
  holds
    (((a < 0 & 0 < b) or (0 < a & b < 0)) implies result = TRUE) &
    (not ((a < 0 & 0 < b) or (0 < a & b < 0))
      implies result = FALSE)
proof
end;
::$P+
