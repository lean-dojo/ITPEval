:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_43, catalog title "sumOfFourthPowerOfOddNumbers": the
:: unconditional precondition, exact recursive sum of fourth powers of the
:: first n odd natural numbers, closed-form postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, NEWTON,
    PREPOWER, MCART_1, XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, NEWTON, PREPOWER, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, XXREAL_0, NEWTON, PREPOWER,
    XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1, INT_1,
    XCMPLX_0, XREAL_0, XXREAL_0, NEWTON, PREPOWER, XTUPLE_0,
    XBOOLEAN, MARGREL1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex sumOfFourthPowerOfOddNumbersPrecond being
       Function of NAT,BOOLEAN,
     sumOfFourthPowerOfOddNumbers being Function of NAT,NAT,
     sumOfFourthPowerOfOddNumbersPostcond being
       Function of [:NAT,NAT:],BOOLEAN st
    (for n being Nat holds
      sumOfFourthPowerOfOddNumbersPrecond/.n = TRUE) &
    sumOfFourthPowerOfOddNumbers/.0 = 0 &
    (for n being Nat holds
      sumOfFourthPowerOfOddNumbers/.(n + 1) =
        sumOfFourthPowerOfOddNumbers/.n + ((2 * n + 1) |^ 4)) &
    (for n,result being Nat holds
      (sumOfFourthPowerOfOddNumbersPostcond/.[n,result] = TRUE iff
        15 * result =
          n * (2 * n + 1) *
            (((7 + 24 * (n |^ 3)) -' 12 * (n |^ 2)) -' 14 * n)) &
      (sumOfFourthPowerOfOddNumbersPostcond/.[n,result] = FALSE iff
        not
          15 * result =
            n * (2 * n + 1) *
              (((7 + 24 * (n |^ 3)) -' 12 * (n |^ 2)) -' 14 * n))) &
    (for n being Nat st
      sumOfFourthPowerOfOddNumbersPrecond/.n = TRUE
    holds
      sumOfFourthPowerOfOddNumbersPostcond/.
        [n,sumOfFourthPowerOfOddNumbers/.n] = TRUE)
proof
end;
::$P+
