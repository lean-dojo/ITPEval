:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_29, catalog title "removeElement": the valid-index
:: precondition, exact array erase-index implementation, zero-based prefix
:: and shifted-suffix postcondition, and final correctness contract. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_3, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1,
    FINSEQ_2, FINSEQ_3;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, FINSEQ_1, FINSEQ_2, FINSEQ_3,
    FINSEQOP, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s,result being FinSequence of INT,
      k being Nat st
    k < len s &
    result = Del(s,k + 1)
  holds
    len result = len s -' 1 &
    (for i being Nat st i < k holds
      result/.(i + 1) = s/.(i + 1)) &
    (for i being Nat st i < len result & k <= i holds
      result/.(i + 1) = s/.(i + 2))
proof
end;
::$P+
