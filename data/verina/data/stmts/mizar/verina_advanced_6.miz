:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_6, catalog title "allVowels": an exact Unicode-scalar
:: finite-sequence encoding of ASCII lowercasing and normalization, the
:: unconditional precondition, deterministic all-vowels Boolean
:: implementation, postcondition, and final correctness contract.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0,
    XREAL_0, XXREAL_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1,
    FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for s being FinSequence of NAT,
      result being Element of BOOLEAN st
    (for i being Nat st i in dom s holds
      s/.i < 1114112 &
      (s/.i < 55296 or 57343 < s/.i)) &
    0 = 0 &
    (ex lower being Function of NAT,NAT,
        chars being FinSequence of NAT st
      (for c being Nat holds
        (65 <= c & c <= 90 & lower/.c = c + 32) or
        ((c < 65 or 90 < c) & lower/.c = c)) &
      len chars = len s &
      (for i being Nat st i in dom s holds
        chars/.i = lower/.(s/.i)) &
      ((result = TRUE &
          97 in rng chars &
          101 in rng chars &
          105 in rng chars &
          111 in rng chars &
          117 in rng chars) or
       (result = FALSE &
          not (97 in rng chars &
               101 in rng chars &
               105 in rng chars &
               111 in rng chars &
               117 in rng chars))))
  holds
    ex lower being Function of NAT,NAT,
       chars being FinSequence of NAT st
      (for c being Nat holds
        (65 <= c & c <= 90 & lower/.c = c + 32) or
        ((c < 65 or 90 < c) & lower/.c = c)) &
      len chars = len s &
      (for i being Nat st i in dom s holds
        chars/.i = lower/.(s/.i)) &
      (result = TRUE iff
        97 in rng chars &
        101 in rng chars &
        105 in rng chars &
        111 in rng chars &
        117 in rng chars)
proof
end;
::$P+
