:: Statement-only formalization of the VERINA corpus artifact verina_basic_61
:: (verina__mizar__verina_basic_61), catalog title "allDigits": an exact
:: Unicode-scalar finite-sequence encoding of the ASCII digit helper,
:: unconditional precondition, deterministic iterator-style Boolean scan,
:: universal-character postcondition, and final correctness contract. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex isDigit being Function of NAT,BOOLEAN,
     allDigitsPrecond being Function of NAT*,BOOLEAN,
     allDigitsLoop being Function of [:NAT*,NAT:],BOOLEAN,
     allDigits being Function of NAT*,BOOLEAN,
     allDigitsPostcond being Function of [:NAT*,BOOLEAN:],BOOLEAN st
    (for c being Nat holds
      ((48 <= c & c <= 57 & isDigit/.c = TRUE) or
       ((c < 48 or 57 < c) & isDigit/.c = FALSE))) &
    (for s being FinSequence of NAT holds
      allDigitsPrecond/.s = TRUE) &
    (for s being FinSequence of NAT, i being Nat holds
      (len s <= i &
        allDigitsLoop/.[s,i] = TRUE) or
      (i < len s &
        isDigit/.(s/.(i + 1)) = FALSE &
        allDigitsLoop/.[s,i] = FALSE) or
      (i < len s &
        isDigit/.(s/.(i + 1)) = TRUE &
        allDigitsLoop/.[s,i] =
          allDigitsLoop/.[s,i + 1])) &
    (for s being FinSequence of NAT holds
      allDigits/.s = allDigitsLoop/.[s,0]) &
    (for s being FinSequence of NAT,
         result being Element of BOOLEAN holds
      (allDigitsPostcond/.[s,result] = TRUE iff
        (result = TRUE iff
          for i being Nat st i in dom s holds
            isDigit/.(s/.i) = TRUE)) &
      (allDigitsPostcond/.[s,result] = FALSE iff
        not
          (result = TRUE iff
            for i being Nat st i in dom s holds
              isDigit/.(s/.i) = TRUE))) &
    (for s being FinSequence of NAT st
      (for i being Nat st i in dom s holds
        s/.i < 1114112 &
        (s/.i < 55296 or 57343 < s/.i)) &
      allDigitsPrecond/.s = TRUE
    holds
      allDigitsPostcond/.[s,allDigits/.s] = TRUE)
proof
end;
::$P+
