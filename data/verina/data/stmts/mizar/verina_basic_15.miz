:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_15, catalog title "containsConsecutiveNumbers": the
:: unconditional precondition, exact indexed adjacent-pair Boolean search,
:: its existential postcondition, and final correctness contract. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    INT_1, RELSET_1, FUNCT_2, NAT_1, FINSEQ_1, FINSEQ_2, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, FINSEQOP, XXREAL_0,
    XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a being FinSequence of INT,
      result being Element of BOOLEAN st
    0 = 0 &
    ((len a <= 1 & result = FALSE) or
     (1 < len a &
      ex found being FinSequence of BOOLEAN st
        len found = len a + 1 &
        found/.1 = FALSE &
        (for i being Nat st i in dom a holds
          (found/.i = TRUE & found/.(i + 1) = TRUE) or
          (found/.i = FALSE &
           i < len a & a/.i + 1 = a/.(i + 1) &
           found/.(i + 1) = TRUE) or
          (found/.i = FALSE &
           (not i < len a or a/.i + 1 <> a/.(i + 1)) &
           found/.(i + 1) = FALSE)) &
        result = found/.(len a + 1)))
  holds
    ((ex i being Nat st
        i in dom a & i < len a & a/.i + 1 = a/.(i + 1))
      iff result = TRUE)
proof
end;
::$P+
