:: Statement-only formalization of the VERINA corpus artifact verina_basic_56
:: (verina__mizar__verina_basic_56), catalog title "copy": the bounded
:: integer-array segment-copy precondition, exact descending-update
:: implementation, complete postcondition, and final correctness contract.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    ORDINAL4, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2,
    CARD_1, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex copyPrecond being
       Function of [:[:INT*,INT*:],[:NAT,NAT:],NAT:],BOOLEAN,
     readDefault being Function of [:INT*,NAT:],INT,
     setBang being Function of [:INT*,NAT,INT:],INT*,
     updateSegment being
       Function of [:[:INT*,INT*:],[:NAT,NAT:],NAT:],INT*,
     copyProgram being
       Function of [:[:INT*,INT*:],[:NAT,NAT:],NAT:],INT*,
     copyPostcond being
       Function of
         [:[:INT*,INT*:],[:NAT,NAT:],[:NAT,INT*:]:],BOOLEAN st
    (for src,dest being FinSequence of INT,
         sStart,dStart,copyLen being Nat holds
      (copyPrecond/.[[src,dest],[sStart,dStart],copyLen] = TRUE iff
        sStart + copyLen <= len src &
        dStart + copyLen <= len dest) &
      (copyPrecond/.[[src,dest],[sStart,dStart],copyLen] = FALSE iff
        not
          (sStart + copyLen <= len src &
           dStart + copyLen <= len dest))) &
    (for s being FinSequence of INT, i being Nat holds
      ((i < len s &
          readDefault/.[s,i] = s/.(i + 1)) or
       (len s <= i &
          readDefault/.[s,i] = 0))) &
    (for r being FinSequence of INT, i being Nat,
         value being Integer holds
      ex rNew being FinSequence of INT st
        rNew = setBang/.[r,i,value] &
        len rNew = len r &
        (for j being Nat st j in dom r holds
          ((j = i + 1 & rNew/.j = value) or
           (j <> i + 1 & rNew/.j = r/.j)))) &
    (for r,src being FinSequence of INT,
         sStart,dStart being Nat holds
      updateSegment/.[[r,src],[sStart,dStart],0] = r) &
    (for r,src being FinSequence of INT,
         sStart,dStart,n being Nat holds
      updateSegment/.[[r,src],[sStart,dStart],n + 1] =
        updateSegment/.
          [[setBang/.
              [r,dStart + n,readDefault/.[src,sStart + n]],src],
           [sStart,dStart],n]) &
    (for src,dest being FinSequence of INT,
         sStart,dStart,copyLen being Nat holds
      ((copyLen = 0 &
          copyProgram/.[[src,dest],[sStart,dStart],copyLen] = dest) or
       (copyLen <> 0 &
          copyProgram/.[[src,dest],[sStart,dStart],copyLen] =
            updateSegment/.[[dest,src],[sStart,dStart],copyLen]))) &
    (for src,dest,result being FinSequence of INT,
         sStart,dStart,copyLen being Nat holds
      (copyPostcond/.[[src,dest],[sStart,dStart],[copyLen,result]] = TRUE iff
        len result = len dest &
        (for i being Nat st i < dStart holds
          readDefault/.[result,i] = readDefault/.[dest,i]) &
        (for i being Nat st
          dStart + copyLen <= i & i < len result
        holds
          readDefault/.[result,i] = readDefault/.[dest,i]) &
        (for i being Nat st i < copyLen holds
          readDefault/.[result,dStart + i] =
            readDefault/.[src,sStart + i])) &
      (copyPostcond/.[[src,dest],[sStart,dStart],[copyLen,result]] =
          FALSE iff
        not
          (len result = len dest &
           (for i being Nat st i < dStart holds
             readDefault/.[result,i] = readDefault/.[dest,i]) &
           (for i being Nat st
             dStart + copyLen <= i & i < len result
           holds
             readDefault/.[result,i] = readDefault/.[dest,i]) &
           (for i being Nat st i < copyLen holds
             readDefault/.[result,dStart + i] =
               readDefault/.[src,sStart + i])))) &
    (for src,dest being FinSequence of INT,
         sStart,dStart,copyLen being Nat st
      copyPrecond/.[[src,dest],[sStart,dStart],copyLen] = TRUE
    holds
      copyPostcond/.
        [[src,dest],[sStart,dStart],
         [copyLen,
          copyProgram/.[[src,dest],[sStart,dStart],copyLen]]] = TRUE)
proof
end;
::$P+
