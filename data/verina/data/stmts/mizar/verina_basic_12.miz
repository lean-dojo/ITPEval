:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_12, catalog title "cubeSurfaceArea": the unconditional
:: precondition, exact natural-number computation 6 * size * size,
:: truncated-subtraction postcondition, and final correctness contract.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, INT_1, INT_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2,
    NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELAT_1, FUNCT_1, CARD_1, NUMBERS,
    NAT_1, INT_1, INT_2, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NAT_1, INT_1, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for size,result being Nat st
    0 = 0 &
    result = 6 * size * size
  holds
    result -' (6 * size * size) = 0 &
    (6 * size * size) -' result = 0
proof
end;
::$P+
