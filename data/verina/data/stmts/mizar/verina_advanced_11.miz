:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_11, catalog title "findMajorityElement": an exact finite-
:: sequence encoding of occurrence counting, the unconditional precondition,
:: the first-majority search program with default -1, its postcondition, and
:: the final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, INT_1, FINSEQ_1, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    XCMPLX_0, XREAL_0, REAL_1, XXREAL_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1, NAT_D, INT_1,
    FINSEQ_1, XXREAL_0;
  constructors RELAT_1, FUNCT_1, CARD_1, NUMBERS, REAL_1, NAT_1, NAT_D,
    INT_1, FINSEQ_1, XXREAL_0;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, CARD_1, NAT_1,
    INT_1, FINSEQ_1, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for lst being FinSequence of INT,
      result being Integer st
    (ex i being Nat st
      i in dom lst &
      result = lst.i &
      len lst < 2 * len Seq (lst | {j where j is Nat :
        j in dom lst & lst.j = lst.i}) &
      (for j being Nat st j in dom lst & j < i holds
        2 * len Seq (lst | {k where k is Nat :
          k in dom lst & lst.k = lst.j}) <= len lst)) or
    (result + 1 = 0 &
      for i being Nat st i in dom lst holds
        2 * len Seq (lst | {j where j is Nat :
          j in dom lst & lst.j = lst.i}) <= len lst)
  holds
    (result + 1 = 0 implies
      (for i being Nat st i in dom lst holds
        2 * len Seq (lst | {j where j is Nat :
          j in dom lst & lst.j = lst.i}) <= len lst) or
      (len lst < 2 * len Seq (lst | {i where i is Nat :
          i in dom lst & lst.i = result}) &
        for i being Nat st i in dom lst holds
          2 * len Seq (lst | {j where j is Nat :
            j in dom lst & lst.j = lst.i}) <= len lst or
          lst.i = result)) &
    (result + 1 <> 0 implies
      len lst < 2 * len Seq (lst | {i where i is Nat :
        i in dom lst & lst.i = result}) &
      for i being Nat st i in dom lst holds
        2 * len Seq (lst | {j where j is Nat :
          j in dom lst & lst.j = lst.i}) <= len lst or
        lst.i = result)
proof
end;
::$P+
