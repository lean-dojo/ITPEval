:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_5, catalog title "multiply": the unconditional precondition,
:: exact integer-multiplication implementation, two-sided zero-difference
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex multiplyPrecond being Function of [:INT,INT:],BOOLEAN,
     multiply being Function of [:INT,INT:],INT,
     multiplyPostcond being Function of [:INT,INT,INT:],BOOLEAN st
    (for a,b being Integer holds
      multiplyPrecond/.[a,b] = TRUE) &
    (for a,b being Integer holds
      multiply/.[a,b] = a * b) &
    (for a,b,result being Integer holds
      (multiplyPostcond/.[a,b,result] = TRUE iff
        result - a * b = 0 & a * b - result = 0) &
      (multiplyPostcond/.[a,b,result] = FALSE iff
        not (result - a * b = 0 & a * b - result = 0))) &
    (for a,b being Integer st
      multiplyPrecond/.[a,b] = TRUE
    holds
      multiplyPostcond/.[a,b,multiply/.[a,b]] = TRUE)
proof
end;
::$P+
