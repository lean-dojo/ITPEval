:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_15, catalog title "increasingTriplet": an exact finite-
:: state trace of the unconditional precondition, one-pass two-threshold
:: Boolean implementation, increasing-index-triplet postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    INT_1, RELSET_1, FUNCT_2, NAT_1, FINSEQ_1, FINSEQ_2, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, FINSEQOP, XXREAL_0,
    XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XBOOLEAN, MARGREL1;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for nums being FinSequence of INT,
      result being Element of BOOLEAN st
    0 = 0 &
    ((len nums < 3 & result = FALSE) or
     (3 <= len nums &
      ex firstSet,secondSet,found being FinSequence of BOOLEAN,
         firstValue,secondValue being FinSequence of INT st
        len firstSet = len nums + 1 &
        len secondSet = len nums + 1 &
        len found = len nums + 1 &
        len firstValue = len nums + 1 &
        len secondValue = len nums + 1 &
        firstSet/.1 = FALSE &
        secondSet/.1 = FALSE &
        found/.1 = FALSE &
        firstValue/.1 = 0 &
        secondValue/.1 = 0 &
        (for i being Nat st i in dom nums holds
          (found/.i = TRUE &
           found/.(i + 1) = TRUE &
           firstSet/.(i + 1) = firstSet/.i &
           secondSet/.(i + 1) = secondSet/.i &
           firstValue/.(i + 1) = firstValue/.i &
           secondValue/.(i + 1) = secondValue/.i) or
          (found/.i = FALSE & firstSet/.i = FALSE &
           found/.(i + 1) = FALSE &
           firstSet/.(i + 1) = TRUE &
           secondSet/.(i + 1) = FALSE &
           firstValue/.(i + 1) = nums/.i &
           secondValue/.(i + 1) = secondValue/.i) or
          (found/.i = FALSE & firstSet/.i = TRUE &
           nums/.i <= firstValue/.i &
           found/.(i + 1) = FALSE &
           firstSet/.(i + 1) = TRUE &
           secondSet/.(i + 1) = secondSet/.i &
           firstValue/.(i + 1) = nums/.i &
           secondValue/.(i + 1) = secondValue/.i) or
          (found/.i = FALSE & firstSet/.i = TRUE &
           firstValue/.i < nums/.i & secondSet/.i = FALSE &
           found/.(i + 1) = FALSE &
           firstSet/.(i + 1) = TRUE &
           secondSet/.(i + 1) = TRUE &
           firstValue/.(i + 1) = firstValue/.i &
           secondValue/.(i + 1) = nums/.i) or
          (found/.i = FALSE & firstSet/.i = TRUE &
           firstValue/.i < nums/.i & secondSet/.i = TRUE &
           nums/.i <= secondValue/.i &
           found/.(i + 1) = FALSE &
           firstSet/.(i + 1) = TRUE &
           secondSet/.(i + 1) = TRUE &
           firstValue/.(i + 1) = firstValue/.i &
           secondValue/.(i + 1) = nums/.i) or
          (found/.i = FALSE & firstSet/.i = TRUE &
           firstValue/.i < nums/.i & secondSet/.i = TRUE &
           secondValue/.i < nums/.i &
           found/.(i + 1) = TRUE &
           firstSet/.(i + 1) = TRUE &
           secondSet/.(i + 1) = TRUE &
           firstValue/.(i + 1) = firstValue/.i &
           secondValue/.(i + 1) = secondValue/.i)) &
        result = found/.(len nums + 1)))
  holds
    (result = TRUE implies
      ex i,j,k being Nat st
        i in dom nums & j in dom nums & k in dom nums &
        i < j & j < k & nums/.i < nums/.j & nums/.j < nums/.k) &
    (result = FALSE implies
      for i,j,k being Nat st
        i in dom nums & j in dom nums & k in dom nums
      holds
        j <= i or k <= j or nums/.j <= nums/.i or nums/.k <= nums/.j)
proof
end;
::$P+
