:: Statement-only formalization of the VERINA corpus artifact verina_basic_77
:: (verina__mizar__verina_basic_77), catalog title "modify_array_element":
:: zero-based nested natural-number arrays, the valid-index precondition,
:: exact bounds-checked inner and outer updates, the frame postcondition, and
:: the final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, NAT_D, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, FINSEQ_1, FINSEQ_2,
    FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex modifyArrayElementPrecond being
       Function of [:(NAT*)*,NAT,NAT,NAT:],BOOLEAN,
     readOuterDefault being Function of [:(NAT*)*,NAT:],NAT*,
     updateInner being Function of [:NAT*,NAT,NAT:],NAT*,
     setOuterBang being
       Function of [:(NAT*)*,NAT,NAT*:],(NAT*)*,
     modifyArrayElement being
       Function of [:(NAT*)*,NAT,NAT,NAT:],(NAT*)*,
     modifyArrayElementPostcond being
       Function of [:[:(NAT*)*,NAT,NAT,NAT:],(NAT*)*:],BOOLEAN st
    (for arr being FinSequence of NAT*, index1,index2,val being Nat holds
      (modifyArrayElementPrecond/.[arr,index1,index2,val] = TRUE iff
        index1 < len arr &
        index2 < len (arr/.(index1 + 1))) &
      (modifyArrayElementPrecond/.[arr,index1,index2,val] = FALSE iff
        not
          (index1 < len arr &
           index2 < len (arr/.(index1 + 1))))) &
    (for arr being FinSequence of NAT*, index1 being Nat holds
      ((index1 < len arr &
          readOuterDefault/.[arr,index1] = arr/.(index1 + 1)) or
       (len arr <= index1 &
          readOuterDefault/.[arr,index1] = <*>NAT))) &
    (for inner being FinSequence of NAT, index2,val being Nat holds
      ((index2 < len inner &
          updateInner/.[inner,index2,val] =
            inner +* ((index2 + 1),val)) or
       (len inner <= index2 &
          updateInner/.[inner,index2,val] = inner))) &
    (for arr being FinSequence of NAT*, index1 being Nat,
         inner being FinSequence of NAT holds
      ((index1 < len arr &
          setOuterBang/.[arr,index1,inner] =
            arr +* ((index1 + 1),inner)) or
       (len arr <= index1 &
          setOuterBang/.[arr,index1,inner] = arr))) &
    (for arr being FinSequence of NAT*, index1,index2,val being Nat holds
      modifyArrayElement/.[arr,index1,index2,val] =
        setOuterBang/.
          [arr,index1,
           updateInner/.
             [readOuterDefault/.[arr,index1],index2,val]]) &
    (for arr,result being FinSequence of NAT*,
         index1,index2,val being Nat holds
      (modifyArrayElementPostcond/.
          [[arr,index1,index2,val],result] = TRUE iff
        len result = len arr &
        len (result/.(index1 + 1)) =
          len (arr/.(index1 + 1)) &
        (for i being Nat st i < len arr & i <> index1 holds
          result/.(i + 1) = arr/.(i + 1)) &
        (for j being Nat st
          j < len (arr/.(index1 + 1)) & j <> index2
        holds
          (result/.(index1 + 1)).(j + 1) =
            (arr/.(index1 + 1)).(j + 1)) &
        (result/.(index1 + 1)).(index2 + 1) = val) &
      (modifyArrayElementPostcond/.
          [[arr,index1,index2,val],result] = FALSE iff
        not
          (len result = len arr &
           len (result/.(index1 + 1)) =
             len (arr/.(index1 + 1)) &
           (for i being Nat st i < len arr & i <> index1 holds
             result/.(i + 1) = arr/.(i + 1)) &
           (for j being Nat st
             j < len (arr/.(index1 + 1)) & j <> index2
           holds
             (result/.(index1 + 1)).(j + 1) =
               (arr/.(index1 + 1)).(j + 1)) &
           (result/.(index1 + 1)).(index2 + 1) = val))) &
    (for arr being FinSequence of NAT*, index1,index2,val being Nat st
      modifyArrayElementPrecond/.[arr,index1,index2,val] = TRUE
    holds
      modifyArrayElementPostcond/.
        [[arr,index1,index2,val],
         modifyArrayElement/.[arr,index1,index2,val]] = TRUE)
proof
end;
::$P+
