:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_1, catalog title "FindSingleNumber": an exact finite-
:: sequence encoding of the occurrence filter, input precondition, first-
:: unique-element search program, output postcondition, and their correctness
:: contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, INT_1, FINSEQ_1, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    XXREAL_0;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    XXREAL_0;
  constructors RELAT_1, FUNCT_1, CARD_1, NUMBERS, NAT_1, INT_1,
    FINSEQ_1, XXREAL_0;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, CARD_1, NAT_1,
    INT_1, FINSEQ_1, XXREAL_0;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for nums being FinSequence of INT st
    (for i being Nat st i in dom nums holds
      len Seq (nums | {j where j is Nat :
        j in dom nums & nums.j = nums.i}) = 1 or
      len Seq (nums | {j where j is Nat :
        j in dom nums & nums.j = nums.i}) = 2) &
    card {i where i is Nat :
      i in dom nums &
      len Seq (nums | {j where j is Nat :
        j in dom nums & nums.j = nums.i}) = 1} = 1
  holds
    for result being Integer st
      (ex i being Nat st
        i in dom nums &
        result = nums.i &
        len Seq (nums | {j where j is Nat :
          j in dom nums & nums.j = nums.i}) = 1 &
        (for j being Nat st j in dom nums & j < i holds
          len Seq (nums | {k where k is Nat :
            k in dom nums & nums.k = nums.j}) <> 1)) or
      (result = 0 &
        for i being Nat st i in dom nums holds
          len Seq (nums | {j where j is Nat :
            j in dom nums & nums.j = nums.i}) <> 1)
    holds
      0 < len nums &
      len Seq (nums | {i where i is Nat :
        i in dom nums & nums.i = result}) = 1 &
      (for x being Integer st x in rng nums holds
        x = result or
        len Seq (nums | {i where i is Nat :
          i in dom nums & nums.i = x}) = 2)
proof
end;
::$P+
