:: Statement-only formalization of the VERINA corpus artifact verina_basic_73
:: (verina__mizar__verina_basic_73), catalog title "Match": an exact Unicode-
:: scalar finite-sequence encoding of the equal-length precondition,
:: deterministic question-mark wildcard loop, biconditional postcondition,
:: and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex matchPrecond being Function of [:NAT*,NAT*:],BOOLEAN,
     matchLoop being Function of [:NAT*,NAT*,NAT:],BOOLEAN,
     matchProgram being Function of [:NAT*,NAT*:],BOOLEAN,
     matchPostcond being Function of [:NAT*,NAT*,BOOLEAN:],BOOLEAN st
    (for s,p being FinSequence of NAT holds
      (matchPrecond/.[s,p] = TRUE iff len s = len p) &
      (matchPrecond/.[s,p] = FALSE iff len s <> len p)) &
    (for s,p being FinSequence of NAT, i being Nat st len s = len p
    holds
      (i < len s &
        s/.(i + 1) <> p/.(i + 1) &
        p/.(i + 1) <> 63 &
        matchLoop/.[s,p,i] = FALSE) or
      (i < len s &
        (s/.(i + 1) = p/.(i + 1) or p/.(i + 1) = 63) &
        matchLoop/.[s,p,i] = matchLoop/.[s,p,i + 1]) or
      (len s <= i &
        matchLoop/.[s,p,i] = TRUE)) &
    (for s,p being FinSequence of NAT st
      matchPrecond/.[s,p] = TRUE
    holds
      matchProgram/.[s,p] = matchLoop/.[s,p,0]) &
    (for s,p being FinSequence of NAT,
         result being Element of BOOLEAN holds
      (matchPostcond/.[s,p,result] = TRUE iff
        (result = TRUE iff
          for n being Nat st n < len s holds
            s/.(n + 1) = p/.(n + 1) or p/.(n + 1) = 63)) &
      (matchPostcond/.[s,p,result] = FALSE iff
        not
          (result = TRUE iff
            for n being Nat st n < len s holds
              s/.(n + 1) = p/.(n + 1) or p/.(n + 1) = 63))) &
    (for s,p being FinSequence of NAT st
      (for i being Nat st i in dom s holds
        s/.i < 1114112 &
        (s/.i < 55296 or 57343 < s/.i)) &
      (for i being Nat st i in dom p holds
        p/.i < 1114112 &
        (p/.i < 55296 or 57343 < p/.i)) &
      matchPrecond/.[s,p] = TRUE
    holds
      matchPostcond/.[s,p,matchProgram/.[s,p]] = TRUE)
proof
end;
::$P+
