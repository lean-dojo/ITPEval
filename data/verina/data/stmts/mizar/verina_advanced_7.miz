:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_7, catalog title "binaryToDecimal": the binary-digit
:: precondition, exact positional-power helper and executable conversion,
:: left-fold postcondition, and final correctness contract for big-endian
:: finite sequences of natural numbers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, CARD_3, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, NEWTON,
    REALSET1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, NEWTON;
  constructors REAL_1, NAT_D, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1,
    FUNCT_2, CARD_1, NUMBERS, NAT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, NEWTON,
    VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for digits being FinSequence of NAT st
    (for i being Nat st i in dom digits holds
      digits/.i = 0 or digits/.i = 1)
  holds
    for result being Nat st
      ex helper being Function of NAT*,NAT st
        helper/.(<*>NAT) = 0 &
        (for first being Nat, rest being FinSequence of NAT holds
          helper/.(<*first*> ^ rest) =
            first * ((2 qua Nat) |^ len rest) + helper/.rest) &
        result = helper/.digits
    holds
      ex folded being Function of [:NAT,NAT*:],NAT st
        (for accumulator being Nat holds
          folded/.[accumulator,<*>NAT] = accumulator) &
        (for accumulator,bit being Nat,
             rest being FinSequence of NAT holds
          folded/.[accumulator,<*bit*> ^ rest] =
            folded/.[accumulator * 2 + bit,rest]) &
        result -' folded/.[0,digits] = 0 &
        folded/.[0,digits] -' result = 0
proof
end;
::$P+
