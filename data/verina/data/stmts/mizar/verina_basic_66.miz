:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_66 (verina__mizar__verina_basic_66), catalog title
:: "ComputeIsEven": the unconditional integer precondition, exact
:: remainder-test Boolean implementation, evenness-witness postcondition,
:: and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, CARD_1,
    ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    MCART_1, XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, XXREAL_0, XTUPLE_0,
    MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex computeIsEvenPrecond,computeIsEven being Function of INT,BOOLEAN,
     computeIsEvenPostcond being Function of [:INT,BOOLEAN:],BOOLEAN st
    (for x being Integer holds
      computeIsEvenPrecond/.x = TRUE) &
    (for x being Integer holds
      ((x mod (2 qua Integer) = 0 &
          computeIsEven/.x = TRUE) or
       (x mod (2 qua Integer) <> 0 &
          computeIsEven/.x = FALSE))) &
    (for x being Integer, result being Element of BOOLEAN holds
      (computeIsEvenPostcond/.[x,result] = TRUE iff
        (result = TRUE iff
          ex k being Integer st x = (2 qua Integer) * k)) &
      (computeIsEvenPostcond/.[x,result] = FALSE iff
        not
          (result = TRUE iff
            ex k being Integer st x = (2 qua Integer) * k))) &
    (for x being Integer st computeIsEvenPrecond/.x = TRUE holds
      computeIsEvenPostcond/.[x,computeIsEven/.x] = TRUE)
proof
end;
::$P+
