:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_32, catalog title "swapFirstAndLast": the nonempty-array
:: precondition, exact first/last reads and ordered two-update implementation,
:: endpoint-and-interior postcondition, and final correctness contract. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0,
    XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex swapFirstAndLastPrecond being Function of INT*,BOOLEAN,
     swapFirstAndLast being Function of INT*,INT*,
     swapFirstAndLastPostcond being
       Function of [:INT*,INT*:],BOOLEAN st
    (for a being FinSequence of INT holds
      ((0 < len a &
          swapFirstAndLastPrecond/.a = TRUE) or
       (len a = 0 &
          swapFirstAndLastPrecond/.a = FALSE))) &
    (for a being FinSequence of INT st
      swapFirstAndLastPrecond/.a = TRUE
    holds
      swapFirstAndLast/.a =
        (a +* (1,a/.(len a))) +* (len a,a/.1)) &
    (for a,result being FinSequence of INT st
      swapFirstAndLastPrecond/.a = TRUE
    holds
      (swapFirstAndLastPostcond/.[a,result] = TRUE iff
        (len result = len a &
         result/.1 = a/.(len a) &
         result/.(len result) = a/.1 &
         (for i being Nat st i < len result -' 2 holds
           result/.(i + 2) = a/.(i + 2)))) &
      (swapFirstAndLastPostcond/.[a,result] = FALSE iff
        not (len result = len a &
         result/.1 = a/.(len a) &
         result/.(len result) = a/.1 &
         (for i being Nat st i < len result -' 2 holds
           result/.(i + 2) = a/.(i + 2))))) &
    (for a being FinSequence of INT st
      swapFirstAndLastPrecond/.a = TRUE
    holds
      swapFirstAndLastPostcond/.[a,swapFirstAndLast/.a] = TRUE)
proof
end;
::$P+
