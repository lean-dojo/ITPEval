:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_72, catalog title "singleDigitPrimeFactor": the
:: unconditional precondition, exact ordered divisibility-test implementation,
:: its finite-list and smaller-tested-factor postcondition, and the final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0,
    XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,result being Nat st
    0 = 0 &
    ((n = 0 & result = 0) or
     (n <> 0 &
       n mod (2 qua Nat) = 0 &
       result = 2) or
     (n <> 0 &
       n mod (2 qua Nat) <> 0 &
       n mod (3 qua Nat) = 0 &
       result = 3) or
     (n <> 0 &
       n mod (2 qua Nat) <> 0 &
       n mod (3 qua Nat) <> 0 &
       n mod (5 qua Nat) = 0 &
       result = 5) or
     (n <> 0 &
       n mod (2 qua Nat) <> 0 &
       n mod (3 qua Nat) <> 0 &
       n mod (5 qua Nat) <> 0 &
       n mod (7 qua Nat) = 0 &
       result = 7) or
     (n <> 0 &
       n mod (2 qua Nat) <> 0 &
       n mod (3 qua Nat) <> 0 &
       n mod (5 qua Nat) <> 0 &
       n mod (7 qua Nat) <> 0 &
       result = 0))
  holds
    (result = 0 or result = 2 or result = 3 or result = 5 or result = 7) &
    (result = 0 implies
      n = 0 or
      (n mod (2 qua Nat) <> 0 &
       n mod (3 qua Nat) <> 0 &
       n mod (5 qua Nat) <> 0 &
       n mod (7 qua Nat) <> 0)) &
    (result <> 0 implies
      n <> 0 &
      n mod result = 0 &
      (for x being Nat st
        x < result &
        (x = 2 or x = 3 or x = 5 or x = 7)
       holds n mod x <> 0))
proof
end;
::$P+
