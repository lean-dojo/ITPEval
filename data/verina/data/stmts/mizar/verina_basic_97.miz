:: Statement-only formalization of the VERINA corpus artifact verina_basic_97
:: (verina__mizar__verina_basic_97), catalog title "TestArrayElements": the
:: valid zero-based integer-array index precondition, exact bounds-checked
:: update setting that element to 60, frame postcondition, and final
:: correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    ORDINAL4, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, NAT_D, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0,
    XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex testArrayElementsPrecond being
       Function of [:INT*,NAT:],BOOLEAN,
     readDefault being Function of [:INT*,NAT:],INT,
     setBang being Function of [:INT*,NAT,INT:],INT*,
     testArrayElements being Function of [:INT*,NAT:],INT*,
     testArrayElementsPostcond being
       Function of [:INT*,NAT,INT*:],BOOLEAN st
    (for a being FinSequence of INT, j being Nat holds
      (testArrayElementsPrecond/.[a,j] = TRUE iff
        j < len a) &
      (testArrayElementsPrecond/.[a,j] = FALSE iff
        not j < len a)) &
    (for a being FinSequence of INT, i being Nat holds
      ((i < len a &
          readDefault/.[a,i] = a/.(i + 1)) or
       (len a <= i &
          readDefault/.[a,i] = 0))) &
    (for a being FinSequence of INT, i being Nat,
         value being Integer holds
      ((i < len a &
          setBang/.[a,i,value] = a +* ((i + 1),value)) or
       (len a <= i &
          setBang/.[a,i,value] = a))) &
    (for a being FinSequence of INT, j being Nat holds
      testArrayElements/.[a,j] = setBang/.[a,j,60]) &
    (for a,result being FinSequence of INT, j being Nat holds
      (testArrayElementsPostcond/.[a,j,result] = TRUE iff
        len result = len a &
        readDefault/.[result,j] = 60 &
        (for k being Nat st k < len a & k <> j holds
          readDefault/.[result,k] = readDefault/.[a,k])) &
      (testArrayElementsPostcond/.[a,j,result] = FALSE iff
        not
          (len result = len a &
           readDefault/.[result,j] = 60 &
           (for k being Nat st k < len a & k <> j holds
             readDefault/.[result,k] = readDefault/.[a,k])))) &
    (for a being FinSequence of INT, j being Nat st
      testArrayElementsPrecond/.[a,j] = TRUE
    holds
      testArrayElementsPostcond/.
        [a,j,testArrayElements/.[a,j]] = TRUE)
proof
end;
::$P+
