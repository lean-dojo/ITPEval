:: Statement-only formalization of the VERINA corpus artifact verina_basic_58
:: (verina__mizar__verina_basic_58), catalog title
:: "double_array_elements": the unconditional precondition, exact recursive
:: bounds-checked element-doubling implementation, same-length pointwise
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    ORDINAL4, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, NAT_D, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0,
    XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex doubleArrayElementsPrecond being Function of INT*,BOOLEAN,
     readDefault being Function of [:INT*,NAT:],INT,
     setBang being Function of [:INT*,NAT,INT:],INT*,
     doubleArrayElementsAux being
       Function of [:INT*,INT*,NAT:],INT*,
     doubleArrayElements being Function of INT*,INT*,
     doubleArrayElementsPostcond being
       Function of [:INT*,INT*:],BOOLEAN st
    (for s being FinSequence of INT holds
      doubleArrayElementsPrecond/.s = TRUE) &
    (for s being FinSequence of INT, i being Nat holds
      ((i < len s &
          readDefault/.[s,i] = s/.(i + 1)) or
       (len s <= i &
          readDefault/.[s,i] = 0))) &
    (for s being FinSequence of INT, i being Nat,
         value being Integer holds
      ((i < len s &
          setBang/.[s,i,value] = s +* ((i + 1),value)) or
       (len s <= i &
          setBang/.[s,i,value] = s))) &
    (for sOld,s being FinSequence of INT, i being Nat holds
      ((i < len s &
          doubleArrayElementsAux/.[sOld,s,i] =
            doubleArrayElementsAux/.
              [sOld,
               setBang/.[s,i,2 * readDefault/.[sOld,i]],
               i + 1]) or
       (len s <= i &
          doubleArrayElementsAux/.[sOld,s,i] = s))) &
    (for s being FinSequence of INT holds
      doubleArrayElements/.s =
        doubleArrayElementsAux/.[s,s,0]) &
    (for s,result being FinSequence of INT holds
      (doubleArrayElementsPostcond/.[s,result] = TRUE iff
        len result = len s &
        (for i being Nat st i < len s holds
          result/.(i + 1) = 2 * s/.(i + 1))) &
      (doubleArrayElementsPostcond/.[s,result] = FALSE iff
        not
          (len result = len s &
           (for i being Nat st i < len s holds
             result/.(i + 1) = 2 * s/.(i + 1))))) &
    (for s being FinSequence of INT st
      doubleArrayElementsPrecond/.s = TRUE
    holds
      doubleArrayElementsPostcond/.[s,doubleArrayElements/.s] = TRUE)
proof
end;
::$P+
