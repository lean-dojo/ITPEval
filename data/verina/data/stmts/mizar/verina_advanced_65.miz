:: Statement-only formalization of the VERINA corpus artifact
:: verina_advanced_65, catalog title "reverseString": an exact Unicode-scalar
:: finite-sequence encoding of the unconditional precondition, tail-recursive
:: reverse helper and executable implementation, length-and-reversal
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FINSEQ_5;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    FINSEQOP, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s,result being FinSequence of NAT st
    (for i being Nat st i in dom s holds
      s/.i < 1114112 &
      (s/.i < 55296 or 57343 < s/.i)) &
    0 = 0 &
    (ex accumulators,remainders being FinSequence of NAT* st
      len accumulators = len s + 1 &
      len remainders = len s + 1 &
      accumulators/.1 = <*>NAT &
      remainders/.1 = s &
      (for k being Nat st k in dom s holds
        ex h being Nat, t being FinSequence of NAT st
          remainders/.k = <*h*> ^ t &
          accumulators/.(k + 1) = <*h*> ^ accumulators/.k &
          remainders/.(k + 1) = t) &
      remainders/.(len s + 1) = <*>NAT &
      result = accumulators/.(len s + 1))
  holds
    len result = len s &
    result = Rev s
proof
end;
::$P+
