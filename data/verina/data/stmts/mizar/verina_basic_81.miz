:: Statement-only formalization of the VERINA corpus artifact verina_basic_81
:: (verina__mizar__verina_basic_81), catalog title "DivisionFunction": the
:: unconditional natural-number precondition, exact remainder-first and
:: quotient-second div/mod helper and zero-divisor branch, integer-pair
:: postcondition, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, CARD_1,
    ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    MCART_1, XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, XXREAL_0, XTUPLE_0,
    MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex divisionFunctionPrecond being
       Function of [:NAT,NAT:],BOOLEAN,
     divMod being Function of [:NAT,NAT:],[:INT,INT:],
     divisionFunction being Function of [:NAT,NAT:],[:INT,INT:],
     divisionFunctionPostcond being
       Function of [:[:NAT,NAT:],[:INT,INT:]:],BOOLEAN st
    (for x,y being Nat holds
      divisionFunctionPrecond/.[x,y] = TRUE) &
    (for x,y being Nat holds
      ((y = 0 &
          divMod/.[x,y] = [x,0]) or
       (y <> 0 &
          divMod/.[x,y] = [x mod y,x div y]))) &
    (for x,y being Nat holds
      ((y = 0 &
          divisionFunction/.[x,y] = [x,0]) or
       (y <> 0 &
          divisionFunction/.[x,y] = divMod/.[x,y]))) &
    (for x,y being Nat, r,q being Integer holds
      (divisionFunctionPostcond/.[[x,y],[r,q]] = TRUE iff
        (y = 0 implies r = x & q = 0) &
        (y <> 0 implies
          q * y + r = x &
          (0 <= r & r < y) &
          0 <= q)) &
      (divisionFunctionPostcond/.[[x,y],[r,q]] = FALSE iff
        not
          ((y = 0 implies r = x & q = 0) &
           (y <> 0 implies
             q * y + r = x &
             (0 <= r & r < y) &
             0 <= q)))) &
    (for x,y being Nat st
      divisionFunctionPrecond/.[x,y] = TRUE
    holds
      divisionFunctionPostcond/.
        [[x,y],divisionFunction/.[x,y]] = TRUE)
proof
end;
::$P+
