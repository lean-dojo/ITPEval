:: Statement-only formalization of the VERINA corpus artifact verina_basic_9
:: (verina__mizar__verina_basic_9), catalog title "hasCommonElement": the
:: nonempty-array precondition, exact deterministic nested Boolean scan,
:: common-index postcondition, and final correctness contract over finite
:: integer sequences. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex hasCommonElementPrecond being
       Function of [:INT*,INT*:],BOOLEAN,
     hasCommonElementAnyEq being
       Function of [:INT,INT*:],BOOLEAN,
     hasCommonElement being Function of [:INT*,INT*:],BOOLEAN,
     hasCommonElementPostcond being
       Function of [:INT*,INT*,BOOLEAN:],BOOLEAN st
    (for a,b being FinSequence of INT holds
      (hasCommonElementPrecond/.[a,b] = TRUE iff
        0 < len a & 0 < len b) &
      (hasCommonElementPrecond/.[a,b] = FALSE iff
        not (0 < len a & 0 < len b))) &
    (for x being Integer holds
      hasCommonElementAnyEq/.[x,<*>INT] = FALSE) &
    (for x,y being Integer, rest being FinSequence of INT holds
      (x = y &
        hasCommonElementAnyEq/.[x,<*y*> ^ rest] = TRUE) or
      (x <> y &
        hasCommonElementAnyEq/.[x,<*y*> ^ rest] =
          hasCommonElementAnyEq/.[x,rest])) &
    (for b being FinSequence of INT holds
      hasCommonElement/.[<*>INT,b] = FALSE) &
    (for x being Integer, rest,b being FinSequence of INT holds
      (hasCommonElementAnyEq/.[x,b] = TRUE &
        hasCommonElement/.[<*x*> ^ rest,b] = TRUE) or
      (hasCommonElementAnyEq/.[x,b] = FALSE &
        hasCommonElement/.[<*x*> ^ rest,b] =
          hasCommonElement/.[rest,b])) &
    (for a,b being FinSequence of INT,
         result being Element of BOOLEAN holds
      (hasCommonElementPostcond/.[a,b,result] = TRUE iff
        ((ex i,j being Nat st
            i in dom a & j in dom b & a/.i = b/.j)
          iff result = TRUE)) &
      (hasCommonElementPostcond/.[a,b,result] = FALSE iff
        not
          ((ex i,j being Nat st
              i in dom a & j in dom b & a/.i = b/.j)
            iff result = TRUE))) &
    (for a,b being FinSequence of INT st
      hasCommonElementPrecond/.[a,b] = TRUE
    holds
      hasCommonElementPostcond/.
        [a,b,hasCommonElement/.[a,b]] = TRUE)
proof
end;
::$P+
