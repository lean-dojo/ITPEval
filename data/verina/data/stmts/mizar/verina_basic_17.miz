:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_17, catalog title "toLowercase": an exact Unicode-scalar
:: finite-sequence encoding of the ASCII-uppercase test, Char.ofNat shift,
:: unconditional precondition, deterministic character-map implementation,
:: length-and-pointwise postcondition, and final correctness contract. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, XCMPLX_0,
    XREAL_0, XXREAL_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1,
    FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQOP,
    XXREAL_0, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for s,result being FinSequence of NAT st
    (for i being Nat st i in dom s holds
      s/.i < 1114112 &
      (s/.i < 55296 or 57343 < s/.i)) &
    0 = 0 &
    (ex isUpperCase being Function of NAT,BOOLEAN,
        shift32,toLowerMap being Function of NAT,NAT st
      (for c being Nat holds
        (65 <= c & c <= 90 & isUpperCase/.c = TRUE) or
        ((c < 65 or 90 < c) & isUpperCase/.c = FALSE)) &
      (for c being Nat holds
        ((c + 32 < 1114112 &
          (c + 32 < 55296 or 57343 < c + 32) &
          shift32/.c = c + 32) or
         ((1114112 <= c + 32 or
           (55296 <= c + 32 & c + 32 <= 57343)) &
          shift32/.c = 0))) &
      (for c being Nat holds
        (isUpperCase/.c = TRUE &
          toLowerMap/.c = shift32/.c) or
        (isUpperCase/.c = FALSE &
          toLowerMap/.c = c)) &
      result = toLowerMap * s)
  holds
    len result = len s &
    (for i being Nat st i in dom s holds
      (65 <= s/.i & s/.i <= 90
        implies result/.i = s/.i + 32) &
      ((s/.i < 65 or 90 < s/.i)
        implies result/.i = s/.i))
proof
end;
::$P+
