:: Statement-only formalization of the VERINA corpus artifact verina_basic_76
:: (verina__mizar__verina_basic_76), catalog title "myMin": the unconditional
:: precondition, exact two-integer comparison implementation, conditional
:: minimum postcondition, and final correctness contract. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex myMinPrecond being Function of [:INT,INT:],BOOLEAN,
     myMinProgram being Function of [:INT,INT:],INT,
     myMinPostcond being Function of [:INT,INT,INT:],BOOLEAN st
    (for x,y being Integer holds
      myMinPrecond/.[x,y] = TRUE) &
    (for x,y being Integer holds
      ((x < y &
          myMinProgram/.[x,y] = x) or
       (not x < y &
          myMinProgram/.[x,y] = y))) &
    (for x,y,result being Integer holds
      (myMinPostcond/.[x,y,result] = TRUE iff
        (x <= y implies result = x) &
        (x > y implies result = y)) &
      (myMinPostcond/.[x,y,result] = FALSE iff
        not
          ((x <= y implies result = x) &
           (x > y implies result = y)))) &
    (for x,y being Integer st
      myMinPrecond/.[x,y] = TRUE
    holds
      myMinPostcond/.[x,y,myMinProgram/.[x,y]] = TRUE)
proof
end;
::$P+
