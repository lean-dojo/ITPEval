:: Statement-only formalization of the VERINA corpus artifact verina_basic_55
:: (verina__mizar__verina_basic_55), catalog title "Compare": the
:: unconditional precondition, exact integer-equality Boolean implementation,
:: equality postcondition, and final correctness contract. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex comparePrecond being Function of [:INT,INT:],BOOLEAN,
     compareProgram being Function of [:INT,INT:],BOOLEAN,
     comparePostcond being Function of [:INT,INT,BOOLEAN:],BOOLEAN st
    (for a,b being Integer holds
      comparePrecond/.[a,b] = TRUE) &
    (for a,b being Integer holds
      (compareProgram/.[a,b] = TRUE iff a = b) &
      (compareProgram/.[a,b] = FALSE iff a <> b)) &
    (for a,b being Integer, result being Element of BOOLEAN holds
      (comparePostcond/.[a,b,result] = TRUE iff
        ((a = b implies result = TRUE) &
         (a <> b implies result = FALSE))) &
      (comparePostcond/.[a,b,result] = FALSE iff
        not
          ((a = b implies result = TRUE) &
           (a <> b implies result = FALSE)))) &
    (for a,b being Integer st
      comparePrecond/.[a,b] = TRUE
    holds
      comparePostcond/.[a,b,compareProgram/.[a,b]] = TRUE)
proof
end;
::$P+
