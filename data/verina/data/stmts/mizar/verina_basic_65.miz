:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_65, catalog title "SquareRoot": the unconditional
:: natural-number precondition, exact bounded recursive integer-square-root
:: implementation, bounding-square postcondition, and final correctness
:: contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex squareRootPrecond being Function of NAT,BOOLEAN,
     boundedLoop being Function of [:NAT,NAT,NAT:],NAT,
     squareRoot being Function of NAT,NAT,
     squareRootPostcond being Function of [:NAT,NAT:],BOOLEAN st
    (for n being Nat holds
      squareRootPrecond/.n = TRUE) &
    (for n,r being Nat holds
      boundedLoop/.[n,0,r] = r) &
    (for n,bound,r being Nat holds
      (((r + 1) * (r + 1) <= n &
          boundedLoop/.[n,bound + 1,r] =
            boundedLoop/.[n,bound,r + 1]) or
       (not (r + 1) * (r + 1) <= n &
          boundedLoop/.[n,bound + 1,r] = r))) &
    (for n being Nat holds
      squareRoot/.n = boundedLoop/.[n,n + 1,0]) &
    (for n,result being Nat holds
      (squareRootPostcond/.[n,result] = TRUE iff
        result * result <= n &
        n < (result + 1) * (result + 1)) &
      (squareRootPostcond/.[n,result] = FALSE iff
        not
          (result * result <= n &
           n < (result + 1) * (result + 1)))) &
    (for n being Nat st
      squareRootPrecond/.n = TRUE
    holds
      squareRootPostcond/.[n,squareRoot/.n] = TRUE)
proof
end;
::$P+
