:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_23, catalog title "differenceMinMax": the nonempty integer-
:: array precondition, exact minimum/maximum scan implementation, independent
:: left-fold postcondition, and final correctness contract. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, FINSEQ_5, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FINSEQ_5, XTUPLE_0, MCART_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_2, FINSEQ_1, FINSEQ_2, FINSEQ_5,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being FinSequence of INT st
    0 < len a &
    (ex scan being Function of [:INT*,INT,INT:],INT,
        foldMinimum,foldMaximum being Function of [:INT*,INT:],INT st
      (for minimum,maximum being Integer holds
        scan/.[<*>INT,minimum,maximum] = maximum - minimum) &
      (for x,minimum,maximum being Integer,
           rest being FinSequence of INT holds
        scan/.[<*x*> ^ rest,minimum,maximum] =
          scan/.[rest,min(x,minimum),max(x,maximum)]) &
      (for accumulator being Integer holds
        foldMinimum/.[<*>INT,accumulator] = accumulator) &
      (for x,accumulator being Integer,
           rest being FinSequence of INT holds
        foldMinimum/.[<*x*> ^ rest,accumulator] =
          foldMinimum/.[rest,min(x,accumulator)]) &
      (for accumulator being Integer holds
        foldMaximum/.[<*>INT,accumulator] = accumulator) &
      (for x,accumulator being Integer,
           rest being FinSequence of INT holds
        foldMaximum/.[<*x*> ^ rest,accumulator] =
          foldMaximum/.[rest,max(x,accumulator)]))
  holds
    for scan being Function of [:INT*,INT,INT:],INT,
        foldMinimum,foldMaximum being Function of [:INT*,INT:],INT st
      (for minimum,maximum being Integer holds
        scan/.[<*>INT,minimum,maximum] = maximum - minimum) &
      (for x,minimum,maximum being Integer,
           rest being FinSequence of INT holds
        scan/.[<*x*> ^ rest,minimum,maximum] =
          scan/.[rest,min(x,minimum),max(x,maximum)]) &
      (for accumulator being Integer holds
        foldMinimum/.[<*>INT,accumulator] = accumulator) &
      (for x,accumulator being Integer,
           rest being FinSequence of INT holds
        foldMinimum/.[<*x*> ^ rest,accumulator] =
          foldMinimum/.[rest,min(x,accumulator)]) &
      (for accumulator being Integer holds
        foldMaximum/.[<*>INT,accumulator] = accumulator) &
      (for x,accumulator being Integer,
           rest being FinSequence of INT holds
        foldMaximum/.[<*x*> ^ rest,accumulator] =
          foldMaximum/.[rest,max(x,accumulator)])
    holds
      for first being Integer,
          rest being FinSequence of INT st
        a = <*first*> ^ rest
      holds
        scan/.[rest,first,first] +
          foldMinimum/.[a,first] =
        foldMaximum/.[a,first]
proof
end;
::$P+
