:: Statement-only formalization of the VERINA corpus artifact verina_basic_86
:: (verina__mizar__verina_basic_86), catalog title "rotate": the nonnegative-
:: offset precondition, exact initialized-array recursive left-rotation
:: implementation, length-and-pointwise postcondition, and final correctness
:: contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FUNCT_4, FUNCT_7, PARTFUN1, NUMBERS, NAT_1, INT_1,
    INT_2, FINSEQ_1, FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1,
    ORDINAL4, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0,
    MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, FUNCT_4, FUNCT_7, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCT_4,
    FUNCT_7, CARD_1, NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FUNCT_7, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0,
    XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex rotatePrecond being Function of [:INT*,INT:],BOOLEAN,
     readDefault being Function of [:INT*,NAT:],INT,
     setBang being Function of [:INT*,NAT,INT:],INT*,
     intToNat being Function of INT,NAT,
     mkArray being Function of [:NAT,INT:],INT*,
     defaultValue being Function of INT*,INT,
     rotateAux being
       Function of [:[:INT*,INT:],[:NAT,NAT:],INT*:],INT*,
     rotateProgram being Function of [:INT*,INT:],INT*,
     rotatePostcond being Function of [:INT*,INT,INT*:],BOOLEAN st
    (for a being FinSequence of INT, offset being Integer holds
      (rotatePrecond/.[a,offset] = TRUE iff 0 <= offset) &
      (rotatePrecond/.[a,offset] = FALSE iff not 0 <= offset)) &
    (for a being FinSequence of INT, i being Nat holds
      ((i < len a &
          readDefault/.[a,i] = a/.(i + 1)) or
       (len a <= i &
          readDefault/.[a,i] = 0))) &
    (for a being FinSequence of INT, i being Nat,
         value being Integer holds
      ((i < len a &
          setBang/.[a,i,value] = a +* ((i + 1),value)) or
       (len a <= i &
          setBang/.[a,i,value] = a))) &
    (for z being Integer holds
      ((z < 0 & intToNat/.z = 0) or
       (0 <= z & (intToNat/.z qua Integer) = z))) &
    (for n being Nat, value being Integer holds
      len (mkArray/.[n,value]) = n &
      (for j being Nat st j < n holds
        (mkArray/.[n,value]).(j + 1) = value)) &
    (for a being FinSequence of INT holds
      ((0 < len a &
          defaultValue/.a = readDefault/.[a,0]) or
       (len a = 0 &
          defaultValue/.a = 0))) &
    (for a,b being FinSequence of INT, offset being Integer,
         i,arrayLen being Nat holds
      ((i < arrayLen &
        ex idxInt,idxAdjusted being Integer, idxNat being Nat st
          idxInt =
            ((i qua Integer) + offset) mod (arrayLen qua Integer) &
          ((idxInt < 0 & idxAdjusted = idxInt + arrayLen) or
           (not idxInt < 0 & idxAdjusted = idxInt)) &
          idxNat = intToNat/.idxAdjusted &
          rotateAux/.[[a,offset],[i,arrayLen],b] =
            rotateAux/.
              [[a,offset],[i + 1,arrayLen],
               setBang/.[b,i,readDefault/.[a,idxNat]]]) or
       (arrayLen <= i &
          rotateAux/.[[a,offset],[i,arrayLen],b] = b))) &
    (for a being FinSequence of INT, offset being Integer holds
      rotateProgram/.[a,offset] =
        rotateAux/.
          [[a,offset],[0,len a],
           mkArray/.[len a,defaultValue/.a]]) &
    (for a,result being FinSequence of INT, offset being Integer holds
      (rotatePostcond/.[a,offset,result] = TRUE iff
        len result = len a &
        (for i being Nat st i < len a holds
          readDefault/.[result,i] =
            readDefault/.
              [a,intToNat/.
                (((i qua Integer) + offset) mod
                  (len a qua Integer))])) &
      (rotatePostcond/.[a,offset,result] = FALSE iff
        not
          (len result = len a &
           (for i being Nat st i < len a holds
             readDefault/.[result,i] =
               readDefault/.
                 [a,intToNat/.
                   (((i qua Integer) + offset) mod
                     (len a qua Integer))])))) &
    (for a being FinSequence of INT, offset being Integer st
      rotatePrecond/.[a,offset] = TRUE
    holds
      rotatePostcond/.
        [a,offset,rotateProgram/.[a,offset]] = TRUE)
proof
end;
::$P+
