:: Statement-only formalization of the VERINA corpus artifact
:: verina_basic_24, catalog title "firstEvenOddDifference": the integer-array
:: parity helpers, size and parity precondition, exact first-even/first-odd
:: recursive scan, minimal-index postcondition, and final correctness
:: contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, CARD_1, ARYTM_1, ARYTM_3, ORDINAL1, ORDINAL4,
    XCMPLX_0, XREAL_0, XXREAL_0, MCART_1, XTUPLE_0, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELSET_1, FUNCT_2,
    NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, NAT_D, INT_1, INT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, XCMPLX_0, XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN,
    MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for a being FinSequence of INT,
      result being Integer st
    ex isEven,isOdd being Function of INT,BOOLEAN,
       firstEvenUpdate,firstOddUpdate being
         Function of [:NAT,NAT:],NAT,
       findFirstEvenOdd being Function of [:NAT,NAT,NAT:],INT st
      (for n being Integer holds
        ((n mod (2 qua Integer) = 0 &
            isEven/.n = TRUE) or
         (n mod (2 qua Integer) <> 0 &
            isEven/.n = FALSE)) &
        ((n mod (2 qua Integer) <> 0 &
            isOdd/.n = TRUE) or
         (n mod (2 qua Integer) = 0 &
            isOdd/.n = FALSE))) &
      1 < len a &
      (ex i being Nat st
        i < len a & isEven/.(a/.(i + 1)) = TRUE) &
      (ex j being Nat st
        j < len a & isOdd/.(a/.(j + 1)) = TRUE) &
      (for i,e being Nat holds
        ((i < len a & e = len a &
            isEven/.(a/.(i + 1)) = TRUE &
            firstEvenUpdate/.[i,e] = i) or
         (not (i < len a & e = len a &
            isEven/.(a/.(i + 1)) = TRUE) &
            firstEvenUpdate/.[i,e] = e))) &
      (for i,o being Nat holds
        ((i < len a & o = len a &
            isOdd/.(a/.(i + 1)) = TRUE &
            firstOddUpdate/.[i,o] = i) or
         (not (i < len a & o = len a &
            isOdd/.(a/.(i + 1)) = TRUE) &
            firstOddUpdate/.[i,o] = o))) &
      (for i,e,o being Nat holds
        ((i < len a &
          ((firstEvenUpdate/.[i,e] < len a &
              firstOddUpdate/.[i,o] < len a &
              findFirstEvenOdd/.[i,e,o] =
                a/.(firstEvenUpdate/.[i,e] + 1) -
                a/.(firstOddUpdate/.[i,o] + 1)) or
           (not (firstEvenUpdate/.[i,e] < len a &
              firstOddUpdate/.[i,o] < len a) &
              findFirstEvenOdd/.[i,e,o] =
                findFirstEvenOdd/.[i + 1,
                  firstEvenUpdate/.[i,e],
                  firstOddUpdate/.[i,o]]))) or
         (not i < len a &
            findFirstEvenOdd/.[i,e,o] = 0))) &
      result = findFirstEvenOdd/.[0,len a,len a]
  holds
    ex i,j being Nat st
      i < len a & j < len a &
      a/.(i + 1) mod (2 qua Integer) = 0 &
      a/.(j + 1) mod (2 qua Integer) <> 0 &
      result = a/.(i + 1) - a/.(j + 1) &
      (for k being Nat st k < i holds
        a/.(k + 1) mod (2 qua Integer) <> 0) &
      (for k being Nat st k < j holds
        a/.(k + 1) mod (2 qua Integer) = 0)
proof
end;
::$P+
