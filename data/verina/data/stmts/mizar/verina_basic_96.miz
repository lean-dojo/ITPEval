:: Statement-only formalization of the VERINA corpus artifact verina_basic_96
:: (verina__mizar__verina_basic_96), catalog title "SwapSimultaneous": the
:: unconditional two-integer precondition, exact simultaneous pair-swap
:: implementation, full tuple postcondition including distinct-input position
:: changes, and final correctness contract. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, ARYTM_1,
    ARYTM_3, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, MCART_1,
    XTUPLE_0, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, FUNCT_1, PARTFUN1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELSET_1, FUNCT_2, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, CARD_1,
    NUMBERS, NAT_1, INT_1, XXREAL_0, XTUPLE_0, MCART_1, XBOOLEAN,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NAT_1, INT_1, XCMPLX_0,
    XREAL_0, XXREAL_0, XTUPLE_0, XBOOLEAN, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  ex swapSimultaneousPrecond being Function of [:INT,INT:],BOOLEAN,
     swapSimultaneousProgram being Function of [:INT,INT:],[:INT,INT:],
     swapSimultaneousPostcond being
       Function of [:[:INT,INT:],[:INT,INT:]:],BOOLEAN st
    (for X,Y being Integer holds
      swapSimultaneousPrecond/.[X,Y] = TRUE) &
    (for X,Y being Integer holds
      swapSimultaneousProgram/.[X,Y] = [Y,X]) &
    (for X,Y,a,b being Integer holds
      (swapSimultaneousPostcond/.[[X,Y],[a,b]] = TRUE iff
        a = Y & b = X &
        (X <> Y implies a <> X & b <> Y)) &
      (swapSimultaneousPostcond/.[[X,Y],[a,b]] = FALSE iff
        not
          (a = Y & b = X &
           (X <> Y implies a <> X & b <> Y)))) &
    (for X,Y being Integer st
      swapSimultaneousPrecond/.[X,Y] = TRUE
    holds
      swapSimultaneousPostcond/.
        [[X,Y],swapSimultaneousProgram/.[X,Y]] = TRUE)
proof
end;
::$P+
