% Statement-only formalization of PutnamBench artifact putnam_1963_a2:
% a strictly increasing positive-integer-valued function on the natural
% numbers that fixes 2 and is multiplicative on coprime positive inputs is
% the identity on the positive natural numbers. This file contains no proof.

putnam_1963_a2: THEORY
BEGIN
  nat_divides(d, n: nat): bool =
    EXISTS (k: nat):
      n = d * k

  relatively_prime(m, n: nat): bool =
    FORALL (d: nat):
      nat_divides(d, m) AND nat_divides(d, n) IMPLIES d = 1

  putnam_1963_a2: bool =
    FORALL (f: [nat -> nat]):
      ((FORALL (n: nat):
          f(n) > 0)
        AND (FORALL (i, j: nat):
          i > 0 AND i < j IMPLIES f(i) < f(j))
        AND f(2) = 2
        AND (FORALL (m, n: nat):
          m > 0 AND n > 0 AND relatively_prime(m, n)
            IMPLIES f(m * n) = f(m) * f(n)))
      IMPLIES
        FORALL (n: nat):
          n > 0 IMPLIES f(n) = n
END putnam_1963_a2
