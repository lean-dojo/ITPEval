% Statement-only formalization of PutnamBench corpus artifact putnam_1998_b5:
% the thousandth digit after the decimal point of the square root of the
% 1998-digit base-10 repunit is 1. This file contains no proof.

putnam_1998_b5: THEORY
BEGIN
  repunit_sum(term_count: nat): RECURSIVE nat =
    IF term_count = 0 THEN
      0
    ELSE
      repunit_sum(term_count - 1) + 10 ^ (term_count - 1)
    ENDIF
  MEASURE term_count

  nonnegative_square_root(root, radicand: real): bool =
    root >= 0 AND root ^ 2 = radicand

  putnam_1998_b5_solution: nat = 1

  putnam_1998_b5: bool =
    FORALL (N: nat):
      N = repunit_sum(1998)
        IMPLIES
          EXISTS (root: real):
            nonnegative_square_root(root, N :: real)
              AND mod(floor((10 :: real) ^ 1000 * root), 10)
                = (putnam_1998_b5_solution :: int)
END putnam_1998_b5
