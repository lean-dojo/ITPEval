% Statement-only formalization of PutnamBench corpus artifact putnam_1978_b4:
% integers a, b, c, and d can be arbitrarily large while satisfying the
% specified symmetric Diophantine equation. This file contains no proof.

putnam_1978_b4: THEORY
BEGIN
  putnam_1978_b4: bool =
    FORALL (N: real):
      EXISTS (a, b, c, d: int):
        (a :: real) > N
          AND (b :: real) > N
          AND (c :: real) > N
          AND (d :: real) > N
          AND a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2
            = a * b * c + a * b * d + a * c * d + b * c * d
END putnam_1978_b4
