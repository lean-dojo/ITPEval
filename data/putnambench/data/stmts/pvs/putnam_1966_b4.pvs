% Statement-only formalization of PutnamBench artifact putnam_1966_b4:
% every finite set of m*n+1 positive natural numbers contains either a
% divisibility antichain of size m+1 or a divisibility chain of size n+1.
% This file contains no proof.

putnam_1966_b4: THEORY
BEGIN
  IMPORTING finite_sets[nat]

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  finite_subset(A, B: finite_set[nat]): bool =
    FORALL (value: nat):
      A(value) IMPLIES B(value)

  putnam_1966_b4: bool =
    FORALL (m, n: nat), (S: finite_set[nat]):
      ((FORALL (value: nat):
          S(value) IMPLIES value > 0)
        AND card(S) = m * n + 1)
      IMPLIES
        EXISTS (T: finite_set[nat]):
          finite_subset(T, S)
            AND
              ((card(T) = m + 1
                AND FORALL (left, right: nat):
                  T(left) AND T(right) AND left /= right
                    IMPLIES NOT nat_divides(left, right))
                OR
               (card(T) = n + 1
                AND FORALL (lower, upper: nat):
                  T(lower) AND T(upper) AND lower < upper
                    IMPLIES nat_divides(lower, upper)))
END putnam_1966_b4
