% Statement-only formalization of PutnamBench artifact putnam_1972_a3:
% the functions on [0, 1] that preserve existence of Cesaro limits for every
% sequence in [0, 1] are exactly the affine functions. This file contains no proof.

putnam_1972_a3: THEORY
BEGIN
  real_sequence: TYPE = [nat -> real]
  real_function: TYPE = [real -> real]

  partial_sum(values: real_sequence, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      partial_sum(values, count - 1) + values(count - 1)
    ENDIF
  MEASURE count

  cesaro_average(values: real_sequence, count: nat): real =
    IF count = 0 THEN
      0
    ELSE
      partial_sum(values, count) / (count :: real)
    ENDIF

  converges_to(values: real_sequence, limit: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (count: nat):
          cutoff <= count IMPLIES
            abs(values(count) - limit) < epsilon_value

  climit_exists(values: real_sequence): bool =
    EXISTS (limit: real):
      converges_to(
        LAMBDA (count: nat): cesaro_average(values, count),
        limit)

  in_closed_unit_interval(value: real): bool =
    0 <= value AND value <= 1

  supercontinuous(f: real_function): bool =
    FORALL (values: real_sequence):
      ((FORALL (index: nat):
          in_closed_unit_interval(values(index)))
        AND climit_exists(values))
      IMPLIES
        climit_exists(
          LAMBDA (index: nat): f(values(index)))

  affine_on_unit_interval(f: real_function): bool =
    EXISTS (A, B: real):
      FORALL (x: real):
        in_closed_unit_interval(x) IMPLIES
          f(x) = A * x + B

  putnam_1972_a3: bool =
    FORALL (f: real_function):
      supercontinuous(f) IFF affine_on_unit_interval(f)
END putnam_1972_a3
