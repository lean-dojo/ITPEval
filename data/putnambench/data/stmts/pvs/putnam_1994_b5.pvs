% Statement-only formalization of PutnamBench corpus artifact putnam_1994_b5:
% for every positive natural n, some real alpha makes both the first n
% iterates of x |-> floor(alpha*x) at n^2 and the maps using alpha^k equal
% n^2 - k for 1 <= k <= n. This file contains no proof.

putnam_1994_b5: THEORY
BEGIN
  floor_map(alpha: real, x: int): int =
    floor(alpha * (x :: real))

  floor_iterate(
      alpha: real,
      x: int,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      x
    ELSE
      floor_map(alpha, floor_iterate(alpha, x, count - 1))
    ENDIF
  MEASURE count

  integer_square(n: nat): int =
    (n * n) :: int

  putnam_1994_b5: bool =
    FORALL (n: nat):
      n > 0 IMPLIES
        EXISTS (alpha: real):
          FORALL (k: nat):
            (1 <= k AND k <= n) IMPLIES
              (floor_iterate(alpha, integer_square(n), k)
                  = integer_square(n) - (k :: int)
                AND floor_map(alpha ^ k, integer_square(n))
                  = integer_square(n) - (k :: int))
END putnam_1994_b5
