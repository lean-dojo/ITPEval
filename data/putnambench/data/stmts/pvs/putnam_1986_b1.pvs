% Statement-only formalization of PutnamBench corpus artifact putnam_1986_b1:
% positive real base and height satisfying the stated unit-circle and
% equal-area equations have height 2/5. This file contains no proof.

putnam_1986_b1: THEORY
BEGIN
  putnam_1986_b1_solution: real = 2 / 5

  putnam_1986_b1: bool =
    FORALL (b, h: real):
      (b > 0
        AND h > 0
        AND b ^ 2 + h ^ 2 = 2 ^ 2
        AND b * h = (1 / 2) * b * (1 - h / 2))
      IMPLIES h = putnam_1986_b1_solution
END putnam_1986_b1
