% Statement-only formalization of PutnamBench corpus artifact putnam_1982_a5:
% positive integers satisfying a sum bound and a strict fractional inequality
% obey the stated lower bound on the remaining gap. This file contains no proof.

putnam_1982_a5: THEORY
BEGIN
  putnam_1982_a5: bool =
    FORALL (a, b, c, d: nat):
      (a > 0
        AND b > 0
        AND c > 0
        AND d > 0
        AND a + c <= 1982
        AND (a :: real) / (b :: real)
              + (c :: real) / (d :: real) < 1)
      IMPLIES
        1 - (a :: real) / (b :: real)
            - (c :: real) / (d :: real)
          > 1 / ((1983 :: real) ^ 3)
END putnam_1982_a5
