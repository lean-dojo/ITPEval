% Statement-only formalization of PutnamBench corpus artifact putnam_2017_b2:
% the least positive starting integer whose sum of 2017 consecutive positive
% integers has no representation of any other length greater than 1 is 16.
% This file contains no proof.

putnam_2017_b2: THEORY
BEGIN
  consecutive_sum(a: int, k: nat): RECURSIVE int =
    IF k = 0 THEN
      0
    ELSE
      consecutive_sum(a, k - 1) + a + ((k - 1) :: int)
    ENDIF
  MEASURE k

  valid_start(a: int): bool =
    a > 0
      AND FORALL (b: int), (k: nat):
        (b > 0
          AND k > 1
          AND consecutive_sum(a, 2017) = consecutive_sum(b, k))
        IMPLIES
          k = 2017

  putnam_2017_b2_solution: int = 16

  putnam_2017_b2: bool =
    valid_start(putnam_2017_b2_solution)
      AND FORALL (a: int):
        valid_start(a) IMPLIES putnam_2017_b2_solution <= a
END putnam_2017_b2
