% Statement-only formalization of PutnamBench artifact putnam_1966_a3:
% a real sequence starting strictly between zero and one and satisfying
% x(n + 1) = x(n) * (1 - x(n)) has n * x(n) converge to one. This file
% contains no proof.

putnam_1966_a3: THEORY
BEGIN
  real_sequence: TYPE = [nat -> real]

  converges_to(sequence: real_sequence, value: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(sequence(index) - value) < epsilon_value

  putnam_1966_a3: bool =
    FORALL (x: real_sequence):
      (0 < x(1)
        AND x(1) < 1
        AND FORALL (n: nat):
          n >= 1 IMPLIES
            x(n + 1) = x(n) * (1 - x(n)))
      IMPLIES
        converges_to(
          LAMBDA (n: nat): (n :: real) * x(n),
          1)
END putnam_1966_a3
