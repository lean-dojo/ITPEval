% Statement-only formalization of PutnamBench artifact putnam_1971_a5:
% positive integer solitaire scores a > b have exactly 35 unattainable
% natural totals including 58 exactly when (a, b) = (11, 8). This file
% contains no proof.

putnam_1971_a5: THEORY
BEGIN
  IMPORTING finite_sets[nat]

  score_pair: TYPE = [# first: int, second: int #]

  putnam_1971_a5_solution: score_pair =
    (# first := 11, second := 8 #)

  unattainable(x, y: int, score: nat): bool =
    NOT (EXISTS (m, n: nat):
      (m :: int) * x + (n :: int) * y = (score :: int))

  has_exactly_35_unattainable_scores(x, y: int): bool =
    EXISTS (scores: finite_set[nat]):
      card(scores) = 35
        AND (FORALL (score: nat):
          scores(score) IFF unattainable(x, y, score))

  characterizes_scores(pab: [int, int -> bool]): bool =
    FORALL (x, y: int):
      pab(x, y)
        IFF (has_exactly_35_unattainable_scores(x, y)
          AND unattainable(x, y, 58))

  putnam_1971_a5: bool =
    FORALL (a, b: int), (pab: [int, int -> bool]):
      (a > 0
        AND b > 0
        AND a > b
        AND characterizes_scores(pab))
      IMPLIES
        (pab(a, b)
          IFF (a = first(putnam_1971_a5_solution)
            AND b = second(putnam_1971_a5_solution)))
END putnam_1971_a5
