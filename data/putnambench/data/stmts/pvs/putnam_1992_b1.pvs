% Statement-only formalization of PutnamBench corpus artifact putnam_1992_b1:
% the least number of distinct averages of pairs of distinct elements of an
% n-element set of real numbers is 2*n - 3 for n >= 2. This file contains no
% proof.

putnam_1992_b1: THEORY
BEGIN
  IMPORTING finite_sets[real]

  is_distinct_pair_average_set(
      S, A: finite_set[real]): bool =
    FORALL (x: real):
      A(x) IFF
        EXISTS (a, b: real):
          S(a) AND S(b) AND a /= b
            AND x = (a + b) / 2

  putnam_1992_b1: bool =
    FORALL (n: nat):
      n >= 2 IMPLIES
        (EXISTS (S, A: finite_set[real]):
          card(S) = n
            AND is_distinct_pair_average_set(S, A)
            AND card(A) = 2 * n - 3)
        AND (FORALL (S, A: finite_set[real]):
          card(S) = n
            AND is_distinct_pair_average_set(S, A)
            IMPLIES 2 * n - 3 <= card(A))
END putnam_1992_b1
