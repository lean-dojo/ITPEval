% Statement-only formalization of PutnamBench corpus artifact putnam_2003_a4:
% pointwise absolute-value domination between two real quadratics with nonzero
% leading coefficients implies domination of their absolute discriminants.
% This file contains no proof.

putnam_2003_a4: THEORY
BEGIN
  putnam_2003_a4: bool =
    FORALL (left_a, left_b, left_c, right_a, right_b, right_c: real):
      (left_a /= 0
        AND right_a /= 0
        AND (FORALL (x: real):
          abs(left_a * x ^ 2 + left_b * x + left_c)
            <= abs(right_a * x ^ 2 + right_b * x + right_c)))
      IMPLIES
        abs(left_b ^ 2 - 4 * left_a * left_c)
          <= abs(right_b ^ 2 - 4 * right_a * right_c)
END putnam_2003_a4
