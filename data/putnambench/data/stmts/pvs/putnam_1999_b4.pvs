% Statement-only formalization of PutnamBench corpus artifact putnam_1999_b4:
% a positive real function with positive first three derivatives and continuous
% third derivative satisfying f'''(x) <= f(x) has f'(x) < 2*f(x) everywhere.
% This file contains no proof.

putnam_1999_b4: THEORY
BEGIN
  real_function: TYPE = [real -> real]

  continuous(f: real_function): bool =
    FORALL (x: real), (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (y: real):
          abs(y - x) < delta IMPLIES
            abs(f(y) - f(x)) < epsilon_value

  has_derivative_at(
      f: real_function,
      derivative, x: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (h: real):
          (NOT (h = 0) AND abs(h) < delta)
            IMPLIES
              abs(
                f(x + h) - f(x)
                  - derivative * h)
                < epsilon_value * abs(h)

  derivative_chain(
      f, first_derivative, second_derivative,
      third_derivative: real_function): bool =
    FORALL (x: real):
      has_derivative_at(f, first_derivative(x), x)
        AND has_derivative_at(
          first_derivative, second_derivative(x), x)
        AND has_derivative_at(
          second_derivative, third_derivative(x), x)

  putnam_1999_b4: bool =
    FORALL
        (f, first_derivative, second_derivative,
         third_derivative: real_function):
      (derivative_chain(
          f, first_derivative, second_derivative,
          third_derivative)
        AND continuous(third_derivative)
        AND (FORALL (x: real):
          f(x) > 0
            AND first_derivative(x) > 0
            AND second_derivative(x) > 0
            AND third_derivative(x) > 0
            AND third_derivative(x) <= f(x)))
      IMPLIES
        FORALL (x: real):
          first_derivative(x) < 2 * f(x)
END putnam_1999_b4
