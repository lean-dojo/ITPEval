% Statement-only formalization of PutnamBench artifact putnam_1980_b3:
% the real initial values a for which the recurrence u(0) = a and
% u(n + 1) = 2*u(n) - n^2 stays positive are exactly a >= 3.
% This file contains no proof.

putnam_1980_b3: THEORY
BEGIN
  real_sequence: TYPE = [nat -> real]

  putnam_1980_b3_solution(a: real): bool =
    a >= 3

  putnam_1980_b3: bool =
    FORALL (a: real), (u: real_sequence):
      (u(0) = a
        AND (FORALL (n: nat):
          u(n + 1) = 2 * u(n) - (n :: real) ^ 2))
      IMPLIES
        ((FORALL (n: nat): u(n) > 0)
          IFF putnam_1980_b3_solution(a))
END putnam_1980_b3
