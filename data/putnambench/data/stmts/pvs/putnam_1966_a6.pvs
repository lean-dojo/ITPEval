% Statement-only formalization of PutnamBench artifact putnam_1966_a6:
% the finite backward square-root recurrences defining nested radicals have
% first terms converging to three. This file contains no proof.

putnam_1966_a6: THEORY
BEGIN
  real_bisequence: TYPE = [nat -> [nat -> real]]
  real_sequence: TYPE = [nat -> real]

  nonnegative_square_root(value: real): real =
    IF 0 <= value
    THEN
      epsilon(
        LAMBDA (root: real):
          0 <= root AND root * root = value)
    ELSE
      0
    ENDIF

  converges_to(sequence: real_sequence, value: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(sequence(index) - value) < epsilon_value

  putnam_1966_a6: bool =
    FORALL (a: real_bisequence):
      (FORALL (n: nat):
        n >= 1 IMPLIES
          (a(n)(n) = (n :: real)
            AND FORALL (m: nat):
              (m >= 1 AND m < n) IMPLIES
                a(n)(m) =
                  (m :: real)
                    * nonnegative_square_root(
                        1 + a(n)(m + 1))))
      IMPLIES
        converges_to(
          LAMBDA (n: nat): a(n)(1),
          3)
END putnam_1966_a6
