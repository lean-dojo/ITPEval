% Statement-only formalization of PutnamBench artifact putnam_1972_a1:
% no four consecutive binomial coefficients with positive lower index form
% an arithmetic progression. This file contains no proof.

putnam_1972_a1: THEORY
BEGIN
  binomial_coefficient(n, k: nat): RECURSIVE nat =
    IF k = 0 THEN
      1
    ELSIF n = 0 THEN
      0
    ELSE
      binomial_coefficient(n - 1, k - 1)
        + binomial_coefficient(n - 1, k)
    ENDIF
  MEASURE n

  four_in_arithmetic_progression(a, b, c, d: int): bool =
    d - c = c - b AND c - b = b - a

  putnam_1972_a1: bool =
    FORALL (n: nat):
      n > 0 IMPLIES
        NOT (EXISTS (r: nat):
          r > 0
            AND r + 3 <= n
            AND four_in_arithmetic_progression(
              (binomial_coefficient(n, r) :: int),
              (binomial_coefficient(n, r + 1) :: int),
              (binomial_coefficient(n, r + 2) :: int),
              (binomial_coefficient(n, r + 3) :: int)))
END putnam_1972_a1
