% Statement-only formalization of PutnamBench corpus artifact putnam_2000_a2:
% arbitrarily large triples of consecutive integers are each sums of two
% integer squares. This file contains no proof.

putnam_2000_a2: THEORY
BEGIN
  sum_of_two_integer_squares(value: int): bool =
    EXISTS (a, b: int):
      value = a * a + b * b

  putnam_2000_a2: bool =
    FORALL (lower_bound: int):
      EXISTS (n: int):
        n > lower_bound
          AND sum_of_two_integer_squares(n)
          AND sum_of_two_integer_squares(n + 1)
          AND sum_of_two_integer_squares(n + 2)
END putnam_2000_a2
