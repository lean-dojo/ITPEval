% Statement-only formalization of PutnamBench artifact putnam_1967_a6:
% the maximum number of distinct sign 4-tuples arising from nonzero real
% solutions of two independent homogeneous equations is eight. This file
% contains no proof.

putnam_1967_a6: THEORY
BEGIN
  vector4: TYPE =
    [# c0: real, c1: real, c2: real, c3: real #]
  vector4_set: TYPE = [vector4 -> bool]
  vector4_enumeration: TYPE = [nat -> vector4]

  sign_of_real(value: real): real =
    IF value < 0 THEN
      -1
    ELSIF value = 0 THEN
      0
    ELSE
      1
    ENDIF

  sign_vector(x: vector4): vector4 =
    (# c0 := sign_of_real(c0(x)),
       c1 := sign_of_real(c1(x)),
       c2 := sign_of_real(c2(x)),
       c3 := sign_of_real(c3(x)) #)

  all_coordinates_nonzero(x: vector4): bool =
    c0(x) /= 0
      AND c1(x) /= 0
      AND c2(x) /= 0
      AND c3(x) /= 0

  dot_product(a, x: vector4): real =
    c0(a) * c0(x)
      + c1(a) * c1(x)
      + c2(a) * c2(x)
      + c3(a) * c3(x)

  independent_first_two_columns(a, b: vector4): bool =
    c0(a) * c1(b) - c1(a) * c0(b) /= 0

  attainable_sign_vector(
      a, b: vector4,
      signs: vector4): bool =
    EXISTS (x: vector4):
      all_coordinates_nonzero(x)
        AND dot_product(a, x) = 0
        AND dot_product(b, x) = 0
        AND signs = sign_vector(x)

  attainable_sign_vectors(a, b: vector4): vector4_set =
    LAMBDA (signs: vector4):
      attainable_sign_vector(a, b, signs)

  injective_below(
      enumeration: vector4_enumeration,
      cardinality: nat): bool =
    FORALL (i, j: nat):
      i < cardinality
        AND j < cardinality
        AND enumeration(i) = enumeration(j)
      IMPLIES i = j

  enumerates_exactly(
      enumeration: vector4_enumeration,
      set_value: vector4_set,
      cardinality: nat): bool =
    FORALL (signs: vector4):
      set_value(signs)
        IFF
          EXISTS (position: nat):
            position < cardinality
              AND enumeration(position) = signs

  has_cardinality(
      set_value: vector4_set,
      cardinality: nat): bool =
    EXISTS (enumeration: vector4_enumeration):
      injective_below(enumeration, cardinality)
        AND enumerates_exactly(
          enumeration, set_value, cardinality)

  putnam_1967_a6: bool =
    (EXISTS (a, b: vector4):
      independent_first_two_columns(a, b)
        AND has_cardinality(
          attainable_sign_vectors(a, b), 8))
      AND
        (FORALL (a, b: vector4):
          independent_first_two_columns(a, b)
          IMPLIES
            EXISTS (cardinality: nat):
              has_cardinality(
                attainable_sign_vectors(a, b),
                cardinality)
                AND cardinality <= 8)
END putnam_1967_a6
