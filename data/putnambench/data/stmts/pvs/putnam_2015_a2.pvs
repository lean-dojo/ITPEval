% Statement-only formalization of PutnamBench corpus artifact putnam_2015_a2:
% the integer sequence beginning 1, 2 and satisfying the stated recurrence
% has 181 as an odd prime factor of its 2015th term. This file contains no proof.

putnam_2015_a2: THEORY
BEGIN
  integer_sequence: TYPE = [nat -> int]

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  prime_nat(value: nat): bool =
    value >= 2
      AND FORALL (divisor: posnat):
        nat_divides(divisor, value)
          IMPLIES divisor = 1 OR divisor = value

  odd_nat(value: nat): bool =
    EXISTS (half: nat):
      value = 2 * half + 1

  int_divides(divisor, value: int): bool =
    EXISTS (quotient: int):
      value = divisor * quotient

  putnam_2015_a2_solution: nat = 181

  putnam_2015_a2: bool =
    FORALL (a: integer_sequence):
      (a(0) = 1
        AND a(1) = 2
        AND (FORALL (n: nat):
          n >= 2 IMPLIES
            a(n) = 4 * a(n - 1) - a(n - 2)))
      IMPLIES
        odd_nat(putnam_2015_a2_solution)
          AND prime_nat(putnam_2015_a2_solution)
          AND int_divides(
            putnam_2015_a2_solution :: int,
            a(2015))
END putnam_2015_a2
