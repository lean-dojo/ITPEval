% Statement-only formalization of PutnamBench corpus artifact putnam_1992_a1:
% an integer function is n |-> 1 - n exactly when it satisfies the three
% stated functional equations. This file contains no proof.

putnam_1992_a1: THEORY
BEGIN
  integer_function: TYPE = [int -> int]

  satisfies_conditions(f: integer_function): bool =
    (FORALL (n: int): f(f(n)) = n)
      AND (FORALL (n: int): f(f(n + 2) + 2) = n)
      AND f(0) = 1

  putnam_1992_a1: bool =
    FORALL (f: integer_function):
      f = (LAMBDA (n: int): 1 - n)
        IFF satisfies_conditions(f)
END putnam_1992_a1
