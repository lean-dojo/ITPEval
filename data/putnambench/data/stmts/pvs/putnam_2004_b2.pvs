% Statement-only formalization of PutnamBench corpus artifact putnam_2004_b2:
% for positive natural numbers m and n, the factorial ratio at m + n is
% strictly less than the product of the corresponding ratios at m and n.
% This file contains no proof.

putnam_2004_b2: THEORY
BEGIN
  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  nat_factorial(index: nat): RECURSIVE nat =
    IF index = 0 THEN
      1
    ELSE
      index * nat_factorial(index - 1)
    ENDIF
  MEASURE index

  putnam_2004_b2: bool =
    FORALL (m, n: nat):
      (m > 0 AND n > 0)
        IMPLIES
          safe_div(
            nat_factorial(m + n) :: real,
            ((m + n) :: real) ^ (m + n))
            <
              safe_div(
                nat_factorial(m) :: real,
                (m :: real) ^ m)
                * safe_div(
                    nat_factorial(n) :: real,
                    (n :: real) ^ n)
END putnam_2004_b2
