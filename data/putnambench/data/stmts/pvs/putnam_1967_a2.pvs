% Statement-only formalization of PutnamBench artifact putnam_1967_a2:
% counting symmetric nonnegative-integer matrices with unit column sums gives
% a recurrence and an exponential generating function. This file contains no proof.

putnam_1967_a2: THEORY
BEGIN
  integer_sequence: TYPE = [nat -> int]
  real_sequence: TYPE = [nat -> real]
  matrix_value: TYPE = [nat, nat -> nat]
  matrix_set: TYPE = [matrix_value -> bool]
  matrix_enumeration: TYPE = [nat -> matrix_value]

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN 0 ELSE numerator / denominator ENDIF

  factorial(index: nat): RECURSIVE nat =
    IF index = 0 THEN
      1
    ELSE
      index * factorial(index - 1)
    ENDIF
  MEASURE index

  column_sum(
      A: matrix_value,
      column, count: nat): RECURSIVE nat =
    IF count = 0 THEN
      0
    ELSE
      column_sum(A, column, count - 1) + A(count - 1, column)
    ENDIF
  MEASURE count

  admissible_matrix(A: matrix_value, n: nat): bool =
    (FORALL (i, j: nat):
      i < n AND j < n IMPLIES A(i, j) = A(j, i))
      AND
        (FORALL (j: nat):
          j < n IMPLIES column_sum(A, j, n) = 1)
      AND
        (FORALL (i, j: nat):
          (i >= n OR j >= n) IMPLIES A(i, j) = 0)

  admissible_matrices(n: nat): matrix_set =
    LAMBDA (A: matrix_value): admissible_matrix(A, n)

  injective_below(
      enumeration: matrix_enumeration,
      bound: nat): bool =
    FORALL (i, j: nat):
      i < bound
        AND j < bound
        AND enumeration(i) = enumeration(j)
      IMPLIES i = j

  enumerates_exactly(
      enumeration: matrix_enumeration,
      set_value: matrix_set,
      bound: nat): bool =
    FORALL (A: matrix_value):
      set_value(A)
        IFF
          EXISTS (position: nat):
            position < bound AND enumeration(position) = A

  has_cardinality(
      set_value: matrix_set,
      cardinality: nat): bool =
    EXISTS (enumeration: matrix_enumeration):
      injective_below(enumeration, cardinality)
        AND enumerates_exactly(enumeration, set_value, cardinality)

  counts_admissible_matrices(S: integer_sequence): bool =
    FORALL (n: nat):
      n >= 1 IMPLIES
        EXISTS (cardinality: nat):
          S(n) = (cardinality :: int)
            AND has_cardinality(
              admissible_matrices(n),
              cardinality)

  partial_sum(values: real_sequence, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      partial_sum(values, count - 1) + values(count - 1)
    ENDIF
  MEASURE count

  series_sums_to(values: real_sequence, total: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (count: nat):
          cutoff <= count IMPLIES
            abs(partial_sum(values, count) - total) < epsilon_value

  generating_terms(S: integer_sequence, x: real): real_sequence =
    LAMBDA (index: nat):
      (S(index) :: real)
        * safe_div(x ^ index, factorial(index) :: real)

  exponential_terms(x: real): real_sequence =
    LAMBDA (index: nat):
      safe_div(x ^ index, factorial(index) :: real)

  recurrence(S: integer_sequence): bool =
    FORALL (n: nat):
      n >= 1 IMPLIES
        S(n + 1) = S(n) + (n :: int) * S(n - 1)

  exponential_generating_function(S: integer_sequence): bool =
    FORALL (x: real):
      EXISTS (total: real):
        series_sums_to(generating_terms(S, x), total)
          AND series_sums_to(
            exponential_terms(x + safe_div(x ^ 2, 2)),
            total)

  putnam_1967_a2: bool =
    FORALL (S: integer_sequence):
      (S(0) = 1 AND counts_admissible_matrices(S))
        IMPLIES
          recurrence(S)
            AND exponential_generating_function(S)
END putnam_1967_a2
