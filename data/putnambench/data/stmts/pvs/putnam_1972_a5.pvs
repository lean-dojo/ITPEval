% Statement-only formalization of PutnamBench artifact putnam_1972_a5:
% no natural number greater than one divides one less than its corresponding
% power of two. This file contains no proof.

putnam_1972_a5: THEORY
BEGIN
  int_divides(divisor, value: int): bool =
    EXISTS (quotient: int):
      value = divisor * quotient

  putnam_1972_a5: bool =
    FORALL (n: nat):
      n > 1 IMPLIES
        NOT int_divides((n :: int), (2 :: int) ^ n - 1)
END putnam_1972_a5
