% Statement-only formalization of PutnamBench corpus artifact putnam_2008_a1:
% a real-valued binary function whose cyclic three-term sum is zero is the
% difference of values of a real-valued unary function. This file contains
% no proof.

putnam_2008_a1: THEORY
BEGIN
  putnam_2008_a1: bool =
    FORALL (f: [real, real -> real]):
      (FORALL (x, y, z: real):
        f(x, y) + f(y, z) + f(z, x) = 0)
      IMPLIES
        EXISTS (g: [real -> real]):
          FORALL (x, y: real):
            f(x, y) = g(x) - g(y)
END putnam_2008_a1
