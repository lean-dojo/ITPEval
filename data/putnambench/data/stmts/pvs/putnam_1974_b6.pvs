% Statement-only formalization of PutnamBench artifact putnam_1974_b6:
% the subsets of a 1000-element set in the three cardinality classes modulo
% 3 have the specified respective counts. This file contains no proof.

putnam_1974_b6: THEORY
BEGIN
  IMPORTING
    finite_sets[below(1000)],
    finite_sets_of_sets[below(1000)]

  element: TYPE = below(1000)
  element_set: TYPE = finite_set[element]
  subset_family: TYPE = finite_set[element_set]

  residue_family(
      universe: element_set,
      residue: below(3)): subset_family =
    intersection(
      powerset(universe),
      {S: element_set | mod(card(S), 3) = residue})

  expected_count: nat =
    ndiv(2 ^ 1000, 3)

  putnam_1974_b6: bool =
    EXISTS (universe: element_set):
      (FORALL (x: element): universe(x))
        AND card(residue_family(universe, 0)) = expected_count
        AND card(residue_family(universe, 1)) = expected_count
        AND card(residue_family(universe, 2)) = expected_count + 1
END putnam_1974_b6
