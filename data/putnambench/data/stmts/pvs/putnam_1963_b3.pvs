% Statement-only formalization of PutnamBench artifact putnam_1963_b3:
% the globally twice-differentiable real solutions of the stated quadratic
% functional equation are exactly the sinh, linear, and sine families.
% This file contains no proof.

putnam_1963_b3: THEORY
BEGIN
  real_function: TYPE = [real -> real]

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  nat_factorial(index: nat): RECURSIVE nat =
    IF index = 0 THEN
      1
    ELSE
      index * nat_factorial(index - 1)
    ENDIF
  MEASURE index

  exponential_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        exponential_partial(x, count - 1)
          + safe_div(
              x ^ index,
              nat_factorial(index) :: real)
    ENDIF
  MEASURE count

  sine_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        sine_partial(x, count - 1)
          + safe_div(
              ((-1 :: real) ^ index) * x ^ (2 * index + 1),
              nat_factorial(2 * index + 1) :: real)
    ENDIF
  MEASURE count

  converges_to(sequence: [nat -> real], value: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(sequence(index) - value) < epsilon_value

  real_exponential(x: real): real =
    epsilon(
      LAMBDA (value: real):
        converges_to(
          (LAMBDA (count: nat):
            exponential_partial(x, count)),
          value))

  real_sine(x: real): real =
    epsilon(
      LAMBDA (value: real):
        converges_to(
          (LAMBDA (count: nat):
            sine_partial(x, count)),
          value))

  hyperbolic_sine(x: real): real =
    (real_exponential(x) - real_exponential(-x)) / 2

  has_derivative_at(
      f: real_function,
      derivative, x: real): bool =
    FORALL (epsilon_value: real):
      epsilon_value > 0 IMPLIES
        EXISTS (delta: real):
          delta > 0
            AND FORALL (h: real):
              (NOT (h = 0) AND abs(h) < delta)
                IMPLIES
                  abs(
                    f(x + h) - f(x)
                      - derivative * h)
                    < epsilon_value * abs(h)

  differentiable_at(f: real_function, x: real): bool =
    EXISTS (derivative: real):
      has_derivative_at(f, derivative, x)

  derivative_value(f: real_function, x: real): real =
    IF differentiable_at(f, x) THEN
      epsilon(
        LAMBDA (derivative: real):
          has_derivative_at(f, derivative, x))
    ELSE
      0
    ENDIF

  derivative_function(f: real_function): real_function =
    LAMBDA (x: real): derivative_value(f, x)

  twice_differentiable(f: real_function): bool =
    FORALL (x: real):
      differentiable_at(f, x)
        AND differentiable_at(derivative_function(f), x)

  satisfies_functional_equation(f: real_function): bool =
    FORALL (x, y: real):
      f(x) ^ 2 - f(y) ^ 2
        = f(x + y) * f(x - y)

  putnam_1963_b3_solution(f: real_function): bool =
    (EXISTS (A, k: real):
      f = (LAMBDA (x: real):
        A * hyperbolic_sine(k * x)))
      OR (EXISTS (A: real):
        f = (LAMBDA (x: real): A * x))
      OR (EXISTS (A, k: real):
        f = (LAMBDA (x: real):
          A * real_sine(k * x)))

  putnam_1963_b3: bool =
    FORALL (f: real_function):
      twice_differentiable(f) IMPLIES
        (satisfies_functional_equation(f)
          IFF putnam_1963_b3_solution(f))
END putnam_1963_b3
