% Statement-only formalization of PutnamBench corpus artifact putnam_1983_a1:
% exactly 2301 positive integers divide at least one of 10^40 and 20^30.
% This file contains no proof.

putnam_1983_a1: THEORY
BEGIN
  IMPORTING finite_sets[int]

  integer_divides(divisor, value: int): bool =
    EXISTS (quotient: int):
      value = divisor * quotient

  qualifying(n: int): bool =
    n > 0
      AND (integer_divides(n, (10 :: int) ^ 40)
        OR integer_divides(n, (20 :: int) ^ 30))

  putnam_1983_a1_solution: nat = 2301

  putnam_1983_a1: bool =
    EXISTS (solutions: finite_set[int]):
      card(solutions) = putnam_1983_a1_solution
        AND (FORALL (n: int):
          solutions(n) IFF qualifying(n))
END putnam_1983_a1
