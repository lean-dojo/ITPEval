% Statement-only formalization of PutnamBench artifact putnam_1967_a3:
% the least positive leading coefficient of an integer quadratic having two
% distinct real zeros in the open unit interval is five. This file contains no proof.

putnam_1967_a3: THEORY
BEGIN
  quadratic_value(
      leading, linear, constant: int,
      x: real): real =
    (leading :: real) * x ^ 2
      + (linear :: real) * x
      + (constant :: real)

  admissible_leading_coefficient(leading: int): bool =
    leading > 0
      AND EXISTS (linear, constant: int), (z1, z2: real):
        0 < z1
          AND z1 < 1
          AND 0 < z2
          AND z2 < 1
          AND z1 /= z2
          AND quadratic_value(leading, linear, constant, z1) = 0
          AND quadratic_value(leading, linear, constant, z2) = 0

  putnam_1967_a3_solution: nat = 5

  putnam_1967_a3: bool =
    admissible_leading_coefficient(
      putnam_1967_a3_solution :: int)
      AND FORALL (leading: int):
        admissible_leading_coefficient(leading)
          IMPLIES
            (putnam_1967_a3_solution :: int) <= leading
END putnam_1967_a3
