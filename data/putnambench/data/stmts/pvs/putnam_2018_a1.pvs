% Statement-only formalization of PutnamBench corpus artifact putnam_2018_a1:
% the ordered positive-integer solutions of 1/a + 1/b = 3/2018 are the six
% specified pairs. This file contains no proof.

putnam_2018_a1: THEORY
BEGIN
  safe_div(numerator, denominator: rat): rat =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  putnam_2018_a1_solution(a, b: nat): bool =
    (a = 673 AND b = 1358114)
      OR (a = 674 AND b = 340033)
      OR (a = 1009 AND b = 2018)
      OR (a = 2018 AND b = 1009)
      OR (a = 340033 AND b = 674)
      OR (a = 1358114 AND b = 673)

  reciprocal_equation(a, b: nat): bool =
    safe_div(1, a :: rat) + safe_div(1, b :: rat)
      = safe_div(3, 2018)

  putnam_2018_a1: bool =
    FORALL (a, b: nat):
      (a > 0 AND b > 0 AND reciprocal_equation(a, b))
        IFF putnam_2018_a1_solution(a, b)
END putnam_2018_a1
