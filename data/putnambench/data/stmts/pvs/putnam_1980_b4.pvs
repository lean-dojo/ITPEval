% Statement-only formalization of PutnamBench artifact putnam_1980_b4:
% ten elements of a finite set can be chosen to meet each of 1066 subsets
% having more than half the cardinality of the set. This file contains no proof.

putnam_1980_b4[Element: TYPE]: THEORY
BEGIN
  IMPORTING finite_sets[Element]

  element_set: TYPE = finite_set[Element]
  index: TYPE = below(1066)

  subset_of(A, B: element_set): bool =
    FORALL (x: Element):
      A(x) IMPLIES B(x)

  putnam_1980_b4: bool =
    FORALL (X: element_set), (A: [index -> element_set]):
      (card(X) >= 10
        AND
          (FORALL (i: index):
            subset_of(A(i), X)
              AND 2 * card(A(i)) > card(X)))
      IMPLIES
        EXISTS (Y: element_set):
          subset_of(Y, X)
            AND card(Y) = 10
            AND
              (FORALL (i: index):
                EXISTS (y: Element):
                  Y(y) AND A(i)(y))
END putnam_1980_b4
