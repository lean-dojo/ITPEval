% Statement-only formalization of PutnamBench corpus artifact putnam_1975_b4:
% nonexistence of a topologically closed subset of the real unit circle that
% contains exactly one point from each antipodal pair. This file contains no proof.

putnam_1975_b4: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]
  point_set: TYPE = [point -> bool]

  squared_distance(P, Q: point): real =
    (x_coord(P) - x_coord(Q)) ^ 2
      + (y_coord(P) - y_coord(Q)) ^ 2

  unit_circle: point_set =
    LAMBDA (P: point):
      x_coord(P) ^ 2 + y_coord(P) ^ 2 = 1

  antipode(P: point): point =
    (# x_coord := -x_coord(P),
       y_coord := -y_coord(P) #)

  closed_point_set(B: point_set): bool =
    FORALL (P: point):
      NOT B(P) IMPLIES
        EXISTS (radius: real):
          radius > 0
            AND FORALL (Q: point):
              squared_distance(P, Q) < radius ^ 2
                IMPLIES NOT B(Q)

  subset_of_unit_circle(B: point_set): bool =
    FORALL (P: point):
      B(P) IMPLIES unit_circle(P)

  selects_one_from_each_antipodal_pair(B: point_set): bool =
    FORALL (P: point):
      unit_circle(P) IMPLIES
        ((B(P) AND NOT B(antipode(P)))
          OR (NOT B(P) AND B(antipode(P))))

  putnam_1975_b4_solution: bool = FALSE

  putnam_1975_b4: bool =
    (EXISTS (B: point_set):
      subset_of_unit_circle(B)
        AND closed_point_set(B)
        AND selects_one_from_each_antipodal_pair(B))
      IFF putnam_1975_b4_solution
END putnam_1975_b4
