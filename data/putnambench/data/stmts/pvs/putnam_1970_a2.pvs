% Statement-only formalization of PutnamBench artifact putnam_1970_a2:
% a real cubic polynomial whose quadratic part has negative discriminant has
% no nonzero zero in some sufficiently small disk. This file contains no proof.

putnam_1970_a2: THEORY
BEGIN
  putnam_1970_a2: bool =
    FORALL (A, B, C, D, E, F, G: real):
      B ^ 2 - 4 * A * C < 0
        IMPLIES
          EXISTS (delta: real):
            delta > 0
              AND NOT EXISTS (x, y: real):
                0 < x ^ 2 + y ^ 2
                  AND x ^ 2 + y ^ 2 < delta ^ 2
                  AND A * x ^ 2
                    + B * x * y
                    + C * y ^ 2
                    + D * x ^ 3
                    + E * x ^ 2 * y
                    + F * x * y ^ 2
                    + G * y ^ 3
                    = 0
END putnam_1970_a2
