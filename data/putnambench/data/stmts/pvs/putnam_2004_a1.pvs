% Statement-only formalization of PutnamBench corpus artifact putnam_2004_a1:
% a free-throw prefix success rate that moves from below 80 percent to above
% 80 percent must equal 80 percent at an intermediate attempt count. This file
% contains no proof.

putnam_2004_a1: THEORY
BEGIN
  attempt_sequence: TYPE = [nat -> bool]
  score_function: TYPE = [attempt_sequence, nat -> real]

  success_count(
      attempts: attempt_sequence,
      count: nat): RECURSIVE nat =
    IF count = 0 THEN
      0
    ELSE
      success_count(attempts, count - 1)
        + IF attempts(count - 1) THEN 1 ELSE 0 ENDIF
    ENDIF
  MEASURE count

  prefix_rate(
      attempts: attempt_sequence,
      count: nat): real =
    IF count = 0 THEN
      0
    ELSE
      (success_count(attempts, count) :: real) / (count :: real)
    ENDIF

  rate_definition(S: score_function): bool =
    FORALL (attempts: attempt_sequence), (count: nat):
      count >= 1 IMPLIES
        S(attempts, count) = prefix_rate(attempts, count)

  four_fifths: real = (4 :: real) / 5
  putnam_2004_a1_solution: bool = TRUE

  crossing_property(S: score_function): bool =
    FORALL (attempts: attempt_sequence), (a, b: nat):
      (1 <= a
        AND a < b
        AND S(attempts, a) < four_fifths
        AND S(attempts, b) > four_fifths)
      IMPLIES
        EXISTS (c: nat):
          a < c
            AND c < b
            AND S(attempts, c) = four_fifths

  putnam_2004_a1: bool =
    FORALL (S: score_function):
      rate_definition(S)
        IMPLIES
          (crossing_property(S) IFF putnam_2004_a1_solution)
END putnam_2004_a1
