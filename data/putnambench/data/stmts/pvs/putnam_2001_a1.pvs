% Statement-only formalization of PutnamBench artifact putnam_2001_a1:
% a binary operation satisfying (a op b) op a = b also satisfies
% a op (b op a) = b. This file contains no proof.

putnam_2001_a1[S: TYPE, op: [S, S -> S]]: THEORY
BEGIN
  putnam_2001_a1: bool =
    (FORALL (a, b: S):
      op(op(a, b), a) = b)
    IMPLIES
      (FORALL (a, b: S):
        op(a, op(b, a)) = b)
END putnam_2001_a1
