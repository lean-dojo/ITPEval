% Statement-only formalization of PutnamBench corpus artifact putnam_1984_b2:
% the minimum of (u-v)^2 + (sqrt(2-u^2)-9/v)^2 over 0 < u < sqrt(2)
% and v > 0 is 8. This file contains no proof.

putnam_1984_b2: THEORY
BEGIN
  sqrt_value(root, radicand: real): bool =
    0 <= root AND root * root = radicand

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  feasible(u, v, sqrt_2: real): bool =
    0 < u AND u < sqrt_2 AND 0 < v

  objective_value(u, v, value: real): bool =
    EXISTS (root: real):
      sqrt_value(root, 2 - u ^ 2)
        AND value =
          (u - v) ^ 2
            + (root - safe_div(9, v)) ^ 2

  is_minimum_value(value, sqrt_2: real): bool =
    (FORALL (u, v, objective: real):
      (feasible(u, v, sqrt_2)
        AND objective_value(u, v, objective))
      IMPLIES value <= objective)
      AND
        (EXISTS (u, v: real):
          feasible(u, v, sqrt_2)
            AND objective_value(u, v, value))

  putnam_1984_b2: bool =
    EXISTS (sqrt_2: real):
      sqrt_value(sqrt_2, 2)
        AND is_minimum_value(8, sqrt_2)
END putnam_1984_b2
