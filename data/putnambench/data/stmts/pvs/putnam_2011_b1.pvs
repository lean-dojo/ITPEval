% Statement-only formalization of PutnamBench corpus artifact putnam_2011_b1:
% positive integer multiples of square roots can differ by an amount strictly
% between epsilon and twice epsilon. This file contains no proof.

putnam_2011_b1: THEORY
BEGIN
  sqrt_value(root, radicand: real): bool =
    root >= 0 AND root * root = radicand

  putnam_2011_b1: bool =
    FORALL (h, k: int):
      (h > 0 AND k > 0) IMPLIES
        FORALL (epsilon_value: posreal):
          EXISTS (m, n: int), (sqrt_m, sqrt_n: real):
            m > 0
              AND n > 0
              AND sqrt_value(sqrt_m, (m :: real))
              AND sqrt_value(sqrt_n, (n :: real))
              AND epsilon_value
                < abs((h :: real) * sqrt_m - (k :: real) * sqrt_n)
              AND abs((h :: real) * sqrt_m - (k :: real) * sqrt_n)
                < 2 * epsilon_value
END putnam_2011_b1
