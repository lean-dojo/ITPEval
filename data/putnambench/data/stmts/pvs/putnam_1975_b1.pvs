% Statement-only formalization of PutnamBench artifact putnam_1975_b1:
% the integer lattice generated by (3, 8), (4, -1), and (5, 4) has generators
% (1, b) and (0, 7) for some integer b, with 7 positive. This file contains no proof.

putnam_1975_b1: THEORY
BEGIN
  integer_pair: TYPE =
    [# first_coordinate: int, second_coordinate: int #]

  integer_pair_set: TYPE = [integer_pair -> bool]

  putnam_1975_b1_solution: int = 7

  generated_lattice: integer_pair_set =
    LAMBDA (pair: integer_pair):
      EXISTS (u, v, w: int):
        first_coordinate(pair) = u * 3 + v * 4 + w * 5
          AND second_coordinate(pair) = u * 8 - v + w * 4

  normal_form_lattice(b: int): integer_pair_set =
    LAMBDA (pair: integer_pair):
      EXISTS (u, v: int):
        first_coordinate(pair) = u
          AND second_coordinate(pair) =
            u * b + v * putnam_1975_b1_solution

  putnam_1975_b1: bool =
    FORALL (H: integer_pair_set):
      H = generated_lattice
        IMPLIES
          ((EXISTS (b: int):
              H = normal_form_lattice(b))
            AND putnam_1975_b1_solution > 0)
END putnam_1975_b1
