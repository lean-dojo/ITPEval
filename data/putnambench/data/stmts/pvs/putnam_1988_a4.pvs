% Statement-only formalization of PutnamBench corpus artifact putnam_1988_a4:
% every three-coloring of the Euclidean plane has a monochromatic pair at
% unit distance, whereas this is false for nine colors. This file contains no proof.

putnam_1988_a4: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]
  three_coloring: TYPE = [point -> below(3)]
  nine_coloring: TYPE = [point -> below(9)]

  squared_distance(p, q: point): real =
    (x_coord(p) - x_coord(q)) ^ 2
      + (y_coord(p) - y_coord(q)) ^ 2

  three_color_property: bool =
    FORALL (color: three_coloring):
      EXISTS (p, q: point):
        color(p) = color(q)
          AND squared_distance(p, q) = 1

  nine_color_property: bool =
    FORALL (color: nine_coloring):
      EXISTS (p, q: point):
        color(p) = color(q)
          AND squared_distance(p, q) = 1

  putnam_1988_a4: bool =
    three_color_property AND NOT nine_color_property
END putnam_1988_a4
