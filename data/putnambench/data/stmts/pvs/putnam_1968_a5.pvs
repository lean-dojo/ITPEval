% Statement-only formalization of PutnamBench artifact putnam_1968_a5:
% the supremum of the absolute derivative at zero over real quadratic
% polynomials bounded in absolute value by 1 on [0, 1] is 8, and is attained.
% This file contains no proof.

putnam_1968_a5: THEORY
BEGIN
  real_set: TYPE = [real -> bool]

  admissible_quadratic(a, b, c: real): bool =
    a /= 0
      AND FORALL (x: real):
        (0 <= x AND x <= 1)
          IMPLIES abs(a * x ^ 2 + b * x + c) <= 1

  derivative_values: real_set =
    LAMBDA (value: real):
      EXISTS (a, b, c: real):
        admissible_quadratic(a, b, c)
          AND value = abs(b)

  is_upper_bound(values: real_set, bound: real): bool =
    FORALL (value: real):
      values(value) IMPLIES value <= bound

  is_supremum(values: real_set, supremum_value: real): bool =
    is_upper_bound(values, supremum_value)
      AND FORALL (bound: real):
        is_upper_bound(values, bound)
          IMPLIES supremum_value <= bound

  putnam_1968_a5_solution: real = 8

  putnam_1968_a5: bool =
    is_supremum(
      derivative_values,
      putnam_1968_a5_solution)
      AND derivative_values(putnam_1968_a5_solution)
END putnam_1968_a5
