% Statement-only formalization of PutnamBench corpus artifact putnam_1991_a2:
% distinct real square matrices satisfying A^3 = B^3 and A^2 B = B^2 A
% cannot have A^2 + B^2 invertible. This file contains no proof.

putnam_1991_a2: THEORY
BEGIN
  matrix(n: posnat): TYPE = [below(n), below(n) -> real]

  bounded_real_sum(
      n: posnat,
      values: [below(n) -> real],
      count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      bounded_real_sum(n, values, count - 1)
        + IF count <= n THEN
            values(count - 1)
          ELSE
            0
          ENDIF
    ENDIF
  MEASURE count

  identity_matrix(n: posnat): matrix(n) =
    LAMBDA (row, column: below(n)):
      IF row = column THEN 1 ELSE 0 ENDIF

  matrix_add(n: posnat)(A, B: matrix(n)): matrix(n) =
    LAMBDA (row, column: below(n)):
      A(row, column) + B(row, column)

  matrix_multiply(n: posnat)(A, B: matrix(n)): matrix(n) =
    LAMBDA (row, column: below(n)):
      bounded_real_sum(
        n,
        LAMBDA (inner: below(n)):
          A(row, inner) * B(inner, column),
        n)

  matrix_square(n: posnat)(A: matrix(n)): matrix(n) =
    matrix_multiply(n)(A, A)

  matrix_cube(n: posnat)(A: matrix(n)): matrix(n) =
    matrix_multiply(n)(matrix_square(n)(A), A)

  matrix_invertible(n: posnat)(A: matrix(n)): bool =
    EXISTS (inverse: matrix(n)):
      matrix_multiply(n)(A, inverse) = identity_matrix(n)
        AND matrix_multiply(n)(inverse, A) = identity_matrix(n)

  putnam_1991_a2_solution: bool = FALSE

  putnam_1991_a2: bool =
    FORALL (n: posnat):
      (EXISTS (A, B: matrix(n)):
        A /= B
          AND matrix_cube(n)(A) = matrix_cube(n)(B)
          AND matrix_multiply(n)(matrix_square(n)(A), B)
            = matrix_multiply(n)(matrix_square(n)(B), A)
          AND matrix_invertible(
            n)(
            matrix_add(
              n)(
              matrix_square(n)(A),
              matrix_square(n)(B))))
        IFF putnam_1991_a2_solution
END putnam_1991_a2
