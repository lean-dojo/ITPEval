% Statement-only formalization of PutnamBench corpus artifact putnam_1990_a4:
% three paper punches, each removing points at irrational Euclidean distance
% from its center, are necessary and sufficient to cover the plane. This file contains no proof.

putnam_1990_a4: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]

  IMPORTING finite_sets[point]

  point_set: TYPE = finite_set[point]

  squared_distance(P, Q: point): real =
    (x_coord(P) - x_coord(Q)) ^ 2
      + (y_coord(P) - y_coord(Q)) ^ 2

  irrational_distance(P, Q: point): bool =
    EXISTS (distance: real):
      0 <= distance
        AND distance * distance = squared_distance(P, Q)
        AND NOT rational?(distance)

  covers_plane(S: point_set): bool =
    FORALL (Q: point):
      EXISTS (P: point):
        S(P) AND irrational_distance(P, Q)

  has_punch_configuration(count: nat): bool =
    EXISTS (S: point_set):
      card(S) = count AND covers_plane(S)

  putnam_1990_a4_solution: nat = 3

  putnam_1990_a4: bool =
    has_punch_configuration(putnam_1990_a4_solution)
      AND FORALL (count: nat):
        has_punch_configuration(count)
          IMPLIES putnam_1990_a4_solution <= count
END putnam_1990_a4
