% Statement-only formalization of PutnamBench corpus artifact putnam_2009_b6:
% every positive integer is reachable at index 2009 by power-of-two additions
% and remainders of earlier positive terms. This file contains no proof.

putnam_2009_b6: THEORY
BEGIN
  integer_sequence: TYPE = [nat -> int]

  positive_remainder(value, divisor, remainder: int): bool =
    divisor > 0
      AND remainder >= 0
      AND remainder < divisor
      AND EXISTS (quotient: int):
        value = divisor * quotient + remainder

  putnam_2009_b6: bool =
    FORALL (n: posnat):
      EXISTS (a: integer_sequence):
        a(0) = 0
          AND a(2009) = (n :: int)
          AND (FORALL (i: nat):
            (i >= 1 AND i <= 2009)
              IMPLIES
                ((EXISTS (j, k: nat):
                    j < i
                      AND a(i) = a(j) + (2 :: int) ^ k)
                  OR
                  (EXISTS (b, c: nat):
                    b < i
                      AND c < i
                      AND a(b) > 0
                      AND a(c) > 0
                      AND positive_remainder(a(b), a(c), a(i)))))
END putnam_2009_b6
