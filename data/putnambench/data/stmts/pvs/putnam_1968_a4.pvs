% Statement-only formalization of PutnamBench artifact putnam_1968_a4:
% the sum of squared distances among n points on the unit sphere in real
% three-dimensional space is at most n squared. This file contains no proof.

putnam_1968_a4: THEORY
BEGIN
  point: TYPE =
    [# x_coord: real, y_coord: real, z_coord: real #]
  point_sequence: TYPE = [nat -> point]

  squared_norm(P: point): real =
    x_coord(P) ^ 2 + y_coord(P) ^ 2 + z_coord(P) ^ 2

  squared_distance(P, Q: point): real =
    (x_coord(P) - x_coord(Q)) ^ 2
      + (y_coord(P) - y_coord(Q)) ^ 2
      + (z_coord(P) - z_coord(Q)) ^ 2

  distances_to_point(
      S: point_sequence,
      point_index, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      distances_to_point(S, point_index, count - 1)
        + squared_distance(S(count - 1), S(point_index))
    ENDIF
  MEASURE count

  pair_distance_sum(
      S: point_sequence,
      count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      pair_distance_sum(S, count - 1)
        + distances_to_point(S, count - 1, count - 1)
    ENDIF
  MEASURE count

  putnam_1968_a4: bool =
    FORALL (n: nat), (S: point_sequence):
      (FORALL (i: nat):
        i < n IMPLIES squared_norm(S(i)) = 1)
      IMPLIES
        pair_distance_sum(S, n) <= (n :: real) ^ 2
END putnam_1968_a4
