% Statement-only formalization of PutnamBench corpus artifact putnam_1990_b1:
% the globally continuously differentiable real functions satisfying the
% stated squared-value integral equation are exactly plus or minus
% sqrt(1990) times the real exponential. This file contains no proof.

putnam_1990_b1: THEORY
BEGIN
  real_function: TYPE = [real -> real]
  real_sequence: TYPE = [nat -> real]

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  nat_factorial(index: nat): RECURSIVE nat =
    IF index = 0 THEN
      1
    ELSE
      index * nat_factorial(index - 1)
    ENDIF
  MEASURE index

  exponential_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        exponential_partial(x, count - 1)
          + safe_div(
              x ^ index,
              nat_factorial(index) :: real)
    ENDIF
  MEASURE count

  converges_to(sequence: real_sequence, value: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(sequence(index) - value) < epsilon_value

  real_exponential(x: real): real =
    epsilon(
      LAMBDA (value: real):
        converges_to(
          LAMBDA (count: nat):
            exponential_partial(x, count),
          value))

  nonnegative_sqrt(x: real): real =
    IF x >= 0 THEN
      epsilon(
        LAMBDA (root: real):
          root >= 0 AND root * root = x)
    ELSE
      0
    ENDIF

  continuous(f: real_function): bool =
    FORALL (x: real), (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (z: real):
          abs(z - x) < delta IMPLIES
            abs(f(z) - f(x)) < epsilon_value

  has_derivative_at(
      f: real_function,
      derivative, x: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (h: real):
          (NOT (h = 0) AND abs(h) < delta)
            IMPLIES
              abs(
                f(x + h) - f(x)
                  - derivative * h)
                < epsilon_value * abs(h)

  differentiable_at(f: real_function, x: real): bool =
    EXISTS (derivative: real):
      has_derivative_at(f, derivative, x)

  derivative_value(f: real_function, x: real): real =
    IF differentiable_at(f, x) THEN
      epsilon(
        LAMBDA (derivative: real):
          has_derivative_at(f, derivative, x))
    ELSE
      0
    ENDIF

  derivative_function(f: real_function): real_function =
    LAMBDA (x: real): derivative_value(f, x)

  continuously_differentiable(f: real_function): bool =
    (FORALL (x: real): differentiable_at(f, x))
      AND continuous(derivative_function(f))

  valid_tagged_partition(
      left, right: real,
      points, tags: real_sequence,
      count: nat): bool =
    count > 0
      AND points(0) = left
      AND points(count) = right
      AND FORALL (index: nat):
        index < count IMPLIES
          (points(index) < points(index + 1)
            AND points(index) <= tags(index)
            AND tags(index) <= points(index + 1))

  mesh_less_than(
      points: real_sequence,
      count: nat,
      bound: real): bool =
    FORALL (index: nat):
      index < count IMPLIES
        points(index + 1) - points(index) < bound

  riemann_sum(
      function_value: real_function,
      points, tags: real_sequence,
      count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      riemann_sum(
        function_value, points, tags, count - 1)
        + function_value(tags(count - 1))
            * (points(count) - points(count - 1))
    ENDIF
  MEASURE count

  has_interval_integral(
      function_value: real_function,
      left, right, integral_value: real): bool =
    left < right
      AND FORALL (epsilon_value: posreal):
        EXISTS (mesh_bound: posreal):
          FORALL
              (points, tags: real_sequence),
              (count: nat):
            (valid_tagged_partition(
                left, right, points, tags, count)
              AND mesh_less_than(
                points, count, mesh_bound))
            IMPLIES
              abs(
                riemann_sum(
                  function_value, points, tags, count)
                  - integral_value)
                < epsilon_value

  interval_integral(
      function_value: real_function,
      left, right: real): real =
    IF left = right THEN
      0
    ELSIF left < right THEN
      IF EXISTS (integral_value: real):
          has_interval_integral(
            function_value, left, right, integral_value)
      THEN
        epsilon(
          LAMBDA (integral_value: real):
            has_interval_integral(
              function_value, left, right, integral_value))
      ELSE
        0
      ENDIF
    ELSE
      IF EXISTS (integral_value: real):
          has_interval_integral(
            function_value, right, left, integral_value)
      THEN
        -epsilon(
          LAMBDA (integral_value: real):
            has_interval_integral(
              function_value, right, left, integral_value))
      ELSE
        0
      ENDIF
    ENDIF

  equation_integrand(f: real_function): real_function =
    LAMBDA (t: real):
      f(t) ^ 2 + derivative_function(f)(t) ^ 2

  satisfies_integral_equation(f: real_function): bool =
    FORALL (x: real):
      f(x) ^ 2
        = interval_integral(equation_integrand(f), 0, x)
            + 1990

  putnam_1990_b1_solution(f: real_function): bool =
    f = (LAMBDA (x: real):
      nonnegative_sqrt(1990) * real_exponential(x))
      OR f = (LAMBDA (x: real):
        -nonnegative_sqrt(1990) * real_exponential(x))

  putnam_1990_b1: bool =
    FORALL (f: real_function):
      (continuously_differentiable(f)
        AND satisfies_integral_equation(f))
      IFF putnam_1990_b1_solution(f)
END putnam_1990_b1
