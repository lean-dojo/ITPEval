% Statement-only formalization of PutnamBench corpus artifact putnam_2003_b1:
% no four real polynomials a, b, c, d give the identity
% 1 + xy + x^2 y^2 = a(x)c(y) + b(x)d(y). This file contains no proof.

putnam_2003_b1: THEORY
BEGIN
  polynomial: TYPE = list[real]

  polynomial_value(p: polynomial, x: real): RECURSIVE real =
    CASES p OF
      null: 0,
      cons(coefficient, tail):
        coefficient + x * polynomial_value(tail, x)
    ENDCASES
  MEASURE p BY <<

  putnam_2003_b1_solution: bool = FALSE

  putnam_2003_b1: bool =
    (EXISTS (a, b, c, d: polynomial):
      FORALL (x, y: real):
        1 + x * y + x ^ 2 * y ^ 2
          = polynomial_value(a, x) * polynomial_value(c, y)
              + polynomial_value(b, x) * polynomial_value(d, y))
      IFF putnam_2003_b1_solution
END putnam_2003_b1
