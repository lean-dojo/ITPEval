% Statement-only formalization of PutnamBench corpus artifact putnam_1993_a2:
% a nonzero real sequence satisfying x(n)^2 - x(n-1)*x(n+1) = 1 has a
% constant-coefficient second-order recurrence. This file contains no proof.

putnam_1993_a2: THEORY
BEGIN
  real_sequence: TYPE = [nat -> real]

  putnam_1993_a2: bool =
    FORALL (x: real_sequence):
      ((FORALL (n: nat):
          x(n) /= 0)
        AND (FORALL (n: nat):
          n >= 1 IMPLIES
            x(n) ^ 2 - x(n - 1) * x(n + 1) = 1))
      IMPLIES
        EXISTS (a: real):
          FORALL (n: nat):
            n >= 1 IMPLIES
              x(n + 1) = a * x(n) - x(n - 1)
END putnam_1993_a2
