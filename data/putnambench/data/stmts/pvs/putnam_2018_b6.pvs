% Statement-only formalization of PutnamBench corpus artifact putnam_2018_b6:
% the number of length-2018 integer sequences with entries in
% {1, 2, 3, 4, 5, 6, 10} and sum 3860 satisfies the stated real upper bound.
% This file contains no proof.

putnam_2018_b6: THEORY
BEGIN
  sequence_index: TYPE = below(2018)
  integer_sequence: TYPE = [sequence_index -> int]

  IMPORTING finite_sets[integer_sequence]

  allowed_entry(value: int): bool =
    value = 1
      OR value = 2
      OR value = 3
      OR value = 4
      OR value = 5
      OR value = 6
      OR value = 10

  sequence_sum(
      values: integer_sequence,
      count: upto(2018)): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      sequence_sum(values, count - 1) + values(count - 1)
    ENDIF
  MEASURE count

  qualifying(values: integer_sequence): bool =
    (FORALL (index: sequence_index):
      allowed_entry(values(index)))
      AND sequence_sum(values, 2018) = 3860

  putnam_2018_b6: bool =
    EXISTS (S: finite_set[integer_sequence]):
      (FORALL (values: integer_sequence):
        S(values) IFF qualifying(values))
        AND
      (card(S) :: real)
        <= (2 :: real) ^ 3860
          * ((2018 :: real) / (2048 :: real)) ^ 2018
END putnam_2018_b6
