% Statement-only formalization of PutnamBench artifact putnam_1965_b3:
% exactly three positive integer-sided right triangles with ordered legs have
% area equal to twice their perimeter. This file contains no proof.

putnam_1965_b3: THEORY
BEGIN
  triangle_sides: TYPE = [# a: int, b: int, c: int #]

  IMPORTING finite_sets[triangle_sides]

  qualifying(t: triangle_sides): bool =
    a(t) > 0
      AND a(t) <= b(t)
      AND c(t) > 0
      AND a(t) ^ 2 + b(t) ^ 2 = c(t) ^ 2
      AND a(t) * b(t) = 4 * (a(t) + b(t) + c(t))

  putnam_1965_b3: bool =
    EXISTS (solutions: finite_set[triangle_sides]):
      card(solutions) = 3
        AND (FORALL (t: triangle_sides):
          solutions(t) IFF qualifying(t))
END putnam_1965_b3
