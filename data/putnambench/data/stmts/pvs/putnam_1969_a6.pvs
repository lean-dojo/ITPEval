% Statement-only formalization of PutnamBench artifact putnam_1969_a6:
% convergence of a real sequence from convergence of the sequence formed by
% x(n-1) + 2*x(n) for all n at least two. This file contains no proof.

putnam_1969_a6: THEORY
BEGIN
  real_sequence: TYPE = [nat -> real]

  converges_to(sequence: real_sequence, value: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(sequence(index) - value) < epsilon_value

  putnam_1969_a6: bool =
    FORALL (x, y: real_sequence):
      ((FORALL (n: nat):
          n >= 2 IMPLIES
            y(n) = x(n - 1) + 2 * x(n))
        AND (EXISTS (c: real):
          converges_to(y, c)))
      IMPLIES
        EXISTS (C: real):
          converges_to(x, C)
END putnam_1969_a6
