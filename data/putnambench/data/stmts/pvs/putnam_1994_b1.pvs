% Statement-only formalization of PutnamBench corpus artifact putnam_1994_b1:
% the positive integers within 250 of exactly 15 natural-number squares are
% precisely those in two specified integer intervals. This file contains no proof.

putnam_1994_b1: THEORY
BEGIN
  IMPORTING finite_sets[nat]

  within_250_of_square(n: int, m: nat): bool =
    abs(n - (m :: int) ^ 2) <= 250

  has_exactly_fifteen_nearby_squares(n: int): bool =
    EXISTS (squares: finite_set[nat]):
      card(squares) = 15
        AND (FORALL (m: nat):
          squares(m) IFF within_250_of_square(n, m))

  putnam_1994_b1_solution(n: int): bool =
    (315 <= n AND n <= 325)
      OR (332 <= n AND n <= 350)

  putnam_1994_b1_statement: bool =
    FORALL (n: int):
      (n > 0 AND has_exactly_fifteen_nearby_squares(n))
        IFF putnam_1994_b1_solution(n)
END putnam_1994_b1
