% Statement-only formalization of PutnamBench corpus artifact putnam_1979_a5:
% two distinct real roots of x^3 - 10*x^2 + 29*x - 25 have floor-multiple
% sequences sharing arbitrarily large integers. This file contains no proof.

putnam_1979_a5: THEORY
BEGIN
  polynomial_value(x: real): real =
    x ^ 3 - 10 * x ^ 2 + 29 * x - 25

  polynomial_root(x: real): bool =
    polynomial_value(x) = 0

  sequence_value(x: real, n: nat): int =
    floor((n :: real) * x)

  putnam_1979_a5: bool =
    EXISTS (alpha, beta: real):
      NOT alpha = beta
        AND polynomial_root(alpha)
        AND polynomial_root(beta)
        AND FORALL (n: nat):
          EXISTS (m: int):
            m > (n :: int)
              AND EXISTS (c, d: nat):
                sequence_value(alpha, c) = m
                  AND sequence_value(beta, d) = m
END putnam_1979_a5
