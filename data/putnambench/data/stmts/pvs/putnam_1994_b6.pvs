% Statement-only formalization of PutnamBench corpus artifact putnam_1994_b6:
% for indices from 0 through 99, congruent sums of the integers
% n_a = 101*a - 100*2^a modulo 10100 determine the same unordered pair.
% This file contains no proof.

putnam_1994_b6: THEORY
BEGIN
  n_value(a: nat): int =
    101 * (a :: int) - 100 * (2 :: int) ^ a

  integer_congruent(left, right, modulus: int): bool =
    EXISTS (quotient: int):
      left - right = modulus * quotient

  same_unordered_pair(a, b, c, d: nat): bool =
    (a = c AND b = d) OR (a = d AND b = c)

  putnam_1994_b6: bool =
    FORALL (a, b, c, d: nat):
      (a <= 99 AND b <= 99 AND c <= 99 AND d <= 99)
        IMPLIES
          (integer_congruent(
              n_value(a) + n_value(b),
              n_value(c) + n_value(d),
              10100)
            IMPLIES same_unordered_pair(a, b, c, d))
END putnam_1994_b6
