% Statement-only formalization of PutnamBench corpus artifact putnam_2004_a3:
% a real sequence beginning with three ones and having each consecutive
% two-by-two determinant equal to n factorial is integer-valued at every
% index. This file contains no proof.

putnam_2004_a3: THEORY
BEGIN
  real_sequence: TYPE = [nat -> real]

  nat_factorial(n: nat): RECURSIVE nat =
    IF n = 0 THEN
      1
    ELSE
      n * nat_factorial(n - 1)
    ENDIF
  MEASURE n

  putnam_2004_a3: bool =
    FORALL (u: real_sequence):
      (u(0) = 1
        AND u(1) = 1
        AND u(2) = 1
        AND (FORALL (n: nat):
          u(n) * u(n + 3) - u(n + 1) * u(n + 2)
            = (nat_factorial(n) :: real)))
      IMPLIES
        FORALL (n: nat):
          EXISTS (m: int):
            u(n) = (m :: real)
END putnam_2004_a3
