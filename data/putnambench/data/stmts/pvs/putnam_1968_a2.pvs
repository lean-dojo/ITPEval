% Statement-only formalization of PutnamBench artifact putnam_1968_a2:
% for integer coefficients with nonzero determinant and every positive real
% epsilon, rational coefficients make both absolute linear-form errors
% nonzero and smaller than epsilon. This file contains no proof.

putnam_1968_a2: THEORY
BEGIN
  putnam_1968_a2: bool =
    FORALL
        (a, b, c, d, e, f: int),
        (epsilon_value: real):
      (a * d /= b * c AND epsilon_value > 0)
        IMPLIES
          EXISTS (r, s: rat):
            0
              < abs(
                  (r :: real) * (a :: real)
                    + (s :: real) * (b :: real)
                    - (e :: real))
              AND abs(
                    (r :: real) * (a :: real)
                      + (s :: real) * (b :: real)
                      - (e :: real))
                < epsilon_value
              AND 0
                < abs(
                    (r :: real) * (c :: real)
                      + (s :: real) * (d :: real)
                      - (f :: real))
              AND abs(
                    (r :: real) * (c :: real)
                      + (s :: real) * (d :: real)
                      - (f :: real))
                < epsilon_value
END putnam_1968_a2
