% Statement-only formalization of PutnamBench corpus artifact putnam_2000_a6:
% an integer polynomial iterated from zero can return to zero at a positive
% time only if its first or second iterate is zero. This file contains no proof.

putnam_2000_a6: THEORY
BEGIN
  integer_polynomial: TYPE = list[int]
  integer_sequence: TYPE = [nat -> int]

  polynomial_value(
      polynomial: integer_polynomial,
      x: int): RECURSIVE int =
    CASES polynomial OF
      null: 0,
      cons(coefficient, tail):
        coefficient + x * polynomial_value(tail, x)
    ENDCASES
  MEASURE polynomial BY <<

  putnam_2000_a6: bool =
    FORALL (f: integer_polynomial), (a: integer_sequence):
      (a(0) = 0
        AND (FORALL (n: nat):
          a(n + 1) = polynomial_value(f, a(n))))
      IMPLIES
        ((EXISTS (m: nat):
          m > 0 AND a(m) = 0)
        IMPLIES
          (a(1) = 0 OR a(2) = 0))
END putnam_2000_a6
