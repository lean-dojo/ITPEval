% Statement-only formalization of PutnamBench corpus artifact putnam_2003_b4:
% an integer-coefficient quartic with four real roots has rational root
% product r1*r2 when the pair sum r1+r2 is rational and differs from r3+r4.
% This file contains no proof.

putnam_2003_b4: THEORY
BEGIN
  real_function: TYPE = [real -> real]

  putnam_2003_b4: bool =
    FORALL
        (f: real_function),
        (a, b, c, d, e: int),
        (r1, r2, r3, r4: real):
      (a /= 0
        AND (FORALL (z: real):
          f(z) =
            a * z ^ 4
              + b * z ^ 3
              + c * z ^ 2
              + d * z
              + e)
        AND (FORALL (z: real):
          f(z) =
            a * (z - r1) * (z - r2)
              * (z - r3) * (z - r4))
        AND rational?(r1 + r2)
        AND r1 + r2 /= r3 + r4)
      IMPLIES rational?(r1 * r2)
END putnam_2003_b4
