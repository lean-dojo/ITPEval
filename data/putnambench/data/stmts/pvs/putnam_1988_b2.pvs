% Statement-only formalization of PutnamBench corpus artifact putnam_1988_b2:
% the stated real inequality implication holds for all real x and y, so the
% answer to the prove-or-disprove question is true. This file contains no proof.

putnam_1988_b2: THEORY
BEGIN
  putnam_1988_b2_solution: bool = TRUE

  putnam_1988_b2: bool =
    (FORALL (x, y: real):
      (y >= 0 AND y * (y + 1) <= (x + 1) ^ 2)
        IMPLIES y * (y - 1) <= x ^ 2)
    IFF putnam_1988_b2_solution
END putnam_1988_b2
