% Statement-only formalization of PutnamBench artifact putnam_1964_b6:
% the real unit disk cannot be partitioned into two disjoint congruent sets.
% This file contains no proof.

putnam_1964_b6: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]
  point_set: TYPE = [point -> bool]
  point_map: TYPE = [point -> point]

  zero_point: point =
    (# x_coord := 0, y_coord := 0 #)

  squared_distance(P, Q: point): real =
    (x_coord(P) - x_coord(Q)) ^ 2
      + (y_coord(P) - y_coord(Q)) ^ 2

  unit_disk: point_set =
    LAMBDA (P: point):
      squared_distance(zero_point, P) <= 1

  image_of(A: point_set, f: point_map): point_set =
    LAMBDA (Q: point):
      EXISTS (P: point):
        A(P) AND Q = f(P)

  congruent(A, B: point_set): bool =
    EXISTS (f: point_map):
      B = image_of(A, f)
        AND FORALL (P, Q: point):
          squared_distance(P, Q)
            = squared_distance(f(P), f(Q))

  disjoint(A, B: point_set): bool =
    FORALL (P: point):
      NOT (A(P) AND B(P))

  union_is(A, B, D: point_set): bool =
    FORALL (P: point):
      D(P) IFF A(P) OR B(P)

  putnam_1964_b6: bool =
    NOT EXISTS (A, B: point_set):
      congruent(A, B)
        AND disjoint(A, B)
        AND union_is(A, B, unit_disk)
END putnam_1964_b6
