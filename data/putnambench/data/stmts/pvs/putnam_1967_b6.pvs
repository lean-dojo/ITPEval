% Statement-only formalization of PutnamBench artifact putnam_1967_b6:
% a bounded real function on the closed unit disk with both partial
% derivatives in its interior has an interior point where their squared sum
% is at most 16.
% This file contains no proof.

putnam_1967_b6: THEORY
BEGIN
  real_function: TYPE = [real -> real]
  bivariate_function: TYPE = [real, real -> real]

  has_derivative_at(
      f: real_function,
      derivative, x: real): bool =
    FORALL (epsilon_value: real):
      epsilon_value > 0 IMPLIES
        EXISTS (delta: real):
          delta > 0
            AND FORALL (h: real):
              (NOT (h = 0) AND abs(h) < delta)
                IMPLIES
                  abs(
                    f(x + h) - f(x)
                      - derivative * h)
                    < epsilon_value * abs(h)

  differentiable_at(f: real_function, x: real): bool =
    EXISTS (derivative: real):
      has_derivative_at(f, derivative, x)

  derivative_value(f: real_function, x: real): real =
    IF differentiable_at(f, x) THEN
      epsilon(
        LAMBDA (derivative: real):
          has_derivative_at(f, derivative, x))
    ELSE
      0
    ENDIF

  partial_x(f: bivariate_function, x, y: real): real =
    derivative_value(
      LAMBDA (variable: real): f(variable, y), x)

  partial_y(f: bivariate_function, x, y: real): real =
    derivative_value(
      LAMBDA (variable: real): f(x, variable), y)

  partially_differentiable_on_open_unit_disk(
      f: bivariate_function): bool =
    FORALL (x, y: real):
      x ^ 2 + y ^ 2 < 1 IMPLIES
        (
        differentiable_at(
          LAMBDA (variable: real): f(variable, y), x)
        AND
        differentiable_at(
          LAMBDA (variable: real): f(x, variable), y)
        )

  bounded_on_unit_disk(f: bivariate_function): bool =
    FORALL (x, y: real):
      x ^ 2 + y ^ 2 <= 1 IMPLIES abs(f(x, y)) <= 1

  putnam_1967_b6: bool =
    FORALL (f: bivariate_function):
      (partially_differentiable_on_open_unit_disk(f)
        AND bounded_on_unit_disk(f))
      IMPLIES
        EXISTS (x0, y0: real):
          x0 ^ 2 + y0 ^ 2 < 1
            AND partial_x(f, x0, y0) ^ 2
              + partial_y(f, x0, y0) ^ 2
              <= 16
END putnam_1967_b6
