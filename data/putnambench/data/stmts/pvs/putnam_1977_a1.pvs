% Statement-only formalization of PutnamBench corpus artifact putnam_1977_a1:
% four distinct points on the quartic y = 2*x^4 + 7*x^3 + 3*x - 5 that lie
% on one line have average x-coordinate -7/8. This file contains no proof.

putnam_1977_a1: THEORY
BEGIN
  IMPORTING finite_sets@finite_sets_sum_real[real]

  quartic(x: real): real =
    2 * x ^ 4 + 7 * x ^ 3 + 3 * x - 5

  lies_on_one_line(S: finite_set[real]): bool =
    EXISTS (m, b: real):
      FORALL (x: real):
        S(x) IMPLIES quartic(x) = m * x + b

  putnam_1977_a1_solution: real = -7 / 8

  putnam_1977_a1: bool =
    FORALL (S: finite_set[real]):
      (card(S) = 4 AND lies_on_one_line(S))
        IMPLIES
          sum(S, (LAMBDA (x: real): x)) / 4
            = putnam_1977_a1_solution
END putnam_1977_a1
