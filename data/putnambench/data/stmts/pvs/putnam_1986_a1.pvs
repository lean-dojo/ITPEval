% Statement-only formalization of PutnamBench artifact putnam_1986_a1:
% the maximum of x^3 - 3*x over the real numbers satisfying
% x^4 + 36 <= 13*x^2 is 18. This file contains no proof.

putnam_1986_a1: THEORY
BEGIN
  putnam_1986_a1_solution: real = 18

  admissible(x: real): bool =
    x ^ 4 + 36 <= 13 * x ^ 2

  objective(x: real): real =
    x ^ 3 - 3 * x

  putnam_1986_a1: bool =
    (FORALL (x: real):
      admissible(x) IMPLIES objective(x) <= putnam_1986_a1_solution)
      AND (EXISTS (x: real):
        admissible(x) AND objective(x) = putnam_1986_a1_solution)
END putnam_1986_a1
