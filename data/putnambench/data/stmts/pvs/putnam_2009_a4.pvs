% Statement-only formalization of PutnamBench corpus artifact putnam_2009_a4:
% whether every set of rational numbers containing zero and closed under
% shifts by one and the stated reciprocal operation contains all rationals.
% This file contains no proof.

putnam_2009_a4: THEORY
BEGIN
  rational_set: TYPE = [rat -> bool]

  safe_div(numerator, denominator: rat): rat =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  putnam_2009_a4_solution: bool = FALSE

  putnam_2009_a4: bool =
    (FORALL (S: rational_set):
      S(0)
        IMPLIES
          ((FORALL (x: rat):
              S(x) IMPLIES
                (S(x + 1) AND S(x - 1)))
            IMPLIES
              ((FORALL (x: rat):
                  (S(x) AND x /= 0 AND x /= 1)
                    IMPLIES
                      S(safe_div(1, x * (x - 1))))
                IMPLIES
                  (FORALL (r: rat):
                    S(r)))))
      IFF putnam_2009_a4_solution
END putnam_2009_a4
