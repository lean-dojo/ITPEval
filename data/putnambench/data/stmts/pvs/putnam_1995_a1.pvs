% Statement-only formalization of PutnamBench corpus artifact putnam_1995_a1:
% a multiplicatively closed set of reals partitioned into two disjoint
% triple-product-closed subsets has a multiplicatively closed part. This file
% contains no proof.

putnam_1995_a1: THEORY
BEGIN
  real_set: TYPE = [real -> bool]

  subset_of(A, B: real_set): bool =
    FORALL (x: real):
      A(x) IMPLIES B(x)

  union_is(A, B, S: real_set): bool =
    FORALL (x: real):
      S(x) IFF (A(x) OR B(x))

  disjoint(A, B: real_set): bool =
    FORALL (x: real):
      NOT (A(x) AND B(x))

  closed_under_multiplication(A: real_set): bool =
    FORALL (a, b: real):
      (A(a) AND A(b)) IMPLIES A(a * b)

  closed_under_triple_products(A: real_set): bool =
    FORALL (a, b, c: real):
      (A(a) AND A(b) AND A(c)) IMPLIES
        A(a * b * c)

  putnam_1995_a1: bool =
    FORALL (S, T, U: real_set):
      (closed_under_multiplication(S)
        AND subset_of(T, S)
        AND subset_of(U, S)
        AND union_is(T, U, S)
        AND disjoint(T, U)
        AND closed_under_triple_products(T)
        AND closed_under_triple_products(U))
      IMPLIES
        (closed_under_multiplication(T)
          OR closed_under_multiplication(U))
END putnam_1995_a1
