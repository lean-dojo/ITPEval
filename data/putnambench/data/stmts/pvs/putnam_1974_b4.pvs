% Statement-only formalization of PutnamBench artifact putnam_1974_b4:
% every separately continuous real function on the real plane is the
% pointwise limit of a sequence of jointly continuous functions.
% This file contains no proof.

putnam_1974_b4: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]
  plane_function: TYPE = [point -> real]
  plane_function_sequence: TYPE = [nat -> plane_function]

  separately_continuous(f: plane_function): bool =
    (FORALL (y, x: real), (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (z: real):
          abs(z - x) < delta IMPLIES
            abs(
              f((# x_coord := z, y_coord := y #))
                - f((# x_coord := x, y_coord := y #)))
              < epsilon_value)
      AND
    (FORALL (x, y: real), (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (z: real):
          abs(z - y) < delta IMPLIES
            abs(
              f((# x_coord := x, y_coord := z #))
                - f((# x_coord := x, y_coord := y #)))
              < epsilon_value)

  jointly_continuous(f: plane_function): bool =
    FORALL (P: point), (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (Q: point):
          (abs(x_coord(Q) - x_coord(P)) < delta
            AND abs(y_coord(Q) - y_coord(P)) < delta)
          IMPLIES
            abs(f(Q) - f(P)) < epsilon_value

  pointwise_converges_to(
      functions: plane_function_sequence,
      f: plane_function): bool =
    FORALL (P: point), (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (n: nat):
          cutoff <= n IMPLIES
            abs(functions(n)(P) - f(P)) < epsilon_value

  putnam_1974_b4: bool =
    FORALL (f: plane_function):
      separately_continuous(f)
      IMPLIES
        EXISTS (g: plane_function_sequence):
          (FORALL (n: nat): jointly_continuous(g(n)))
            AND pointwise_converges_to(g, f)
END putnam_1974_b4
