% Statement-only formalization of PutnamBench corpus artifact putnam_1986_a2:
% the units digit of the floor of 10^20000 divided by 10^100 + 3 is 3.
% This file contains no proof.

putnam_1986_a2: THEORY
BEGIN
  putnam_1986_a2_solution: nat = 3

  putnam_1986_a2: bool =
    mod(ndiv(10 ^ 20000, 10 ^ 100 + 3), 10)
      = putnam_1986_a2_solution
END putnam_1986_a2
