% Statement-only formalization of PutnamBench artifact putnam_1993_a4:
% bounded positive integer sequences of lengths 19 and 93 have a nonempty
% subset sum from the first equal to a subset sum from the second.
% This file contains no proof.

putnam_1993_a4: THEORY
BEGIN
  integer_sequence: TYPE = [nat -> int]
  index_set: TYPE = [nat -> bool]

  selected_sum(
      values: integer_sequence,
      selected: index_set,
      count: nat): RECURSIVE int =
    IF count = 0 THEN
      0
    ELSE
      selected_sum(values, selected, count - 1)
        + IF selected(count - 1) THEN
            values(count - 1)
          ELSE
            0
          ENDIF
    ENDIF
  MEASURE count

  putnam_1993_a4: bool =
    FORALL (x, y: integer_sequence):
      ((FORALL (i: nat):
          i < 19 IMPLIES 0 < x(i) AND x(i) <= 93)
        AND
        (FORALL (j: nat):
          j < 93 IMPLIES 0 < y(j) AND y(j) <= 19))
      IMPLIES
        EXISTS (is, js: index_set):
          (EXISTS (i: nat): i < 19 AND is(i))
            AND selected_sum(x, is, 19)
              = selected_sum(y, js, 93)
END putnam_1993_a4
