% Statement-only formalization of PutnamBench corpus artifact putnam_1988_b6:
% infinitely many ordered pairs of integers preserve triangular-number
% membership under t |-> a*t+b for every positive integer t. This file
% contains no proof.

putnam_1988_b6: THEORY
BEGIN
  integer_pair: TYPE = [# multiplier: int, offset: int #]
  pair_sequence: TYPE = [nat -> integer_pair]

  triangular(t: int): bool =
    EXISTS (n: int):
      n >= 0 AND 2 * t = n * (n + 1)

  admissible(pair: integer_pair): bool =
    FORALL (t: int):
      t > 0 IMPLIES
        (triangular(multiplier(pair) * t + offset(pair))
          IFF triangular(t))

  injective(sequence: pair_sequence): bool =
    FORALL (i, j: nat):
      sequence(i) = sequence(j) IMPLIES i = j

  putnam_1988_b6: bool =
    EXISTS (sequence: pair_sequence):
      injective(sequence)
        AND FORALL (index: nat):
          admissible(sequence(index))
END putnam_1988_b6
