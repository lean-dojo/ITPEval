% Statement-only formalization of PutnamBench corpus artifact putnam_1997_a5:
% the number of ordered ten-tuples of positive integers whose reciprocals
% sum to one is odd. This file contains no proof.

putnam_1997_a5: THEORY
BEGIN
  positive_ten_tuple: TYPE = [below(10) -> posnat]

  IMPORTING finite_sets[positive_ten_tuple]

  reciprocal_sum(t: positive_ten_tuple): real =
      1 / (t(0) :: real)
    + 1 / (t(1) :: real)
    + 1 / (t(2) :: real)
    + 1 / (t(3) :: real)
    + 1 / (t(4) :: real)
    + 1 / (t(5) :: real)
    + 1 / (t(6) :: real)
    + 1 / (t(7) :: real)
    + 1 / (t(8) :: real)
    + 1 / (t(9) :: real)

  qualifying(t: positive_ten_tuple): bool =
    reciprocal_sum(t) = 1

  is_odd(value: nat): bool =
    EXISTS (half: nat):
      value = 2 * half + 1

  putnam_1997_a5_solution: bool = TRUE

  putnam_1997_a5: bool =
    (EXISTS (solutions: finite_set[positive_ten_tuple]):
      (FORALL (t: positive_ten_tuple):
        solutions(t) IFF qualifying(t))
        AND is_odd(card(solutions)))
      IFF putnam_1997_a5_solution
END putnam_1997_a5
