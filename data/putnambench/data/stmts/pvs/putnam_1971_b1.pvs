% Statement-only formalization of PutnamBench artifact putnam_1971_b1:
% an idempotent binary operation satisfying the cyclic law
% (x op y) op z = (y op z) op x is associative and commutative.
% This file contains no proof.

putnam_1971_b1[S: TYPE, op: [S, S -> S]]: THEORY
BEGIN
  putnam_1971_b1: bool =
    ((FORALL (x: S): op(x, x) = x)
      AND (FORALL (x, y, z: S):
        op(op(x, y), z) = op(op(y, z), x)))
    IMPLIES
      (FORALL (x, y, z: S):
        op(op(x, y), z) = op(x, op(y, z)))
      AND (FORALL (x, y: S):
        op(x, y) = op(y, x))
END putnam_1971_b1
