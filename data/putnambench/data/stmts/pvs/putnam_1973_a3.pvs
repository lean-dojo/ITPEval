% Statement-only formalization of PutnamBench artifact putnam_1973_a3:
% the minimum of k + n/k over positive integers has the same integer part
% as the square root of 4n + 1. This file contains no proof.

putnam_1973_a3: THEORY
BEGIN
  integer_real_function: TYPE = [int -> real]

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  candidate_value(n, k: int): real =
    (k :: real) + safe_div(n :: real, k :: real)

  is_minimum_value(
      b: integer_real_function,
      n: int): bool =
    (FORALL (k: int):
      k > 0 IMPLIES b(n) <= candidate_value(n, k))
      AND EXISTS (k: int):
        k > 0 AND b(n) = candidate_value(n, k)

  sqrt_value(root, radicand: real): bool =
    0 <= root AND root * root = radicand

  putnam_1973_a3: bool =
    FORALL (b: integer_real_function):
      (FORALL (n: int): is_minimum_value(b, n))
      IMPLIES
        FORALL (n: int):
          n > 0 IMPLIES
            EXISTS (root: real):
              sqrt_value(root, 4 * (n :: real) + 1)
                AND floor(b(n)) = floor(root)
END putnam_1973_a3
