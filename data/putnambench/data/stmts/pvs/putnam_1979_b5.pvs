% Statement-only formalization of PutnamBench artifact putnam_1979_b5:
% a closed convex planar set containing no nonzero lattice point and having
% equal Lebesgue area in the four quadrants has total area at most four.
% This file contains no proof.

putnam_1979_b5: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]
  point_set: TYPE = [point -> bool]
  real_sequence: TYPE = [nat -> real]

  box: TYPE =
    [# left: real, right: real, bottom: real, top: real #]
  box_sequence: TYPE = [nat -> box]

  measure_value: TYPE =
    [# infinite_flag: bool, finite_part: real #]

  zero_point: point =
    (# x_coord := 0, y_coord := 0 #)

  finite_measure(value: nonneg_real): measure_value =
    (# infinite_flag := FALSE, finite_part := value #)

  infinite_measure: measure_value =
    (# infinite_flag := TRUE, finite_part := 0 #)

  canonical_measure(value: measure_value): bool =
    IF infinite_flag(value) THEN
      finite_part(value) = 0
    ELSE
      finite_part(value) >= 0
    ENDIF

  measure_le(left_value, right_value: measure_value): bool =
    canonical_measure(left_value)
      AND canonical_measure(right_value)
      AND IF infinite_flag(right_value) THEN
        TRUE
      ELSIF infinite_flag(left_value) THEN
        FALSE
      ELSE
        finite_part(left_value) <= finite_part(right_value)
      ENDIF

  squared_distance(P, Q: point): real =
    (x_coord(P) - x_coord(Q)) ^ 2
      + (y_coord(P) - y_coord(Q)) ^ 2

  affine_combination(t: real, P, Q: point): point =
    (# x_coord := (1 - t) * x_coord(P) + t * x_coord(Q),
       y_coord := (1 - t) * y_coord(P) + t * y_coord(Q) #)

  closed_set(C: point_set): bool =
    FORALL (P: point):
      NOT C(P) IMPLIES
        EXISTS (radius: real):
          radius > 0
            AND FORALL (Q: point):
              squared_distance(P, Q) < radius ^ 2
                IMPLIES NOT C(Q)

  convex_set(C: point_set): bool =
    FORALL (P, Q: point), (t: real):
      C(P) AND C(Q) AND 0 <= t AND t <= 1
        IMPLIES C(affine_combination(t, P, Q))

  set_intersection(A, B: point_set): point_set =
    LAMBDA (P: point): A(P) AND B(P)

  quadrant_one: point_set =
    LAMBDA (P: point):
      x_coord(P) >= 0 AND y_coord(P) >= 0

  quadrant_four: point_set =
    LAMBDA (P: point):
      x_coord(P) >= 0 AND y_coord(P) <= 0

  quadrant_two: point_set =
    LAMBDA (P: point):
      x_coord(P) <= 0 AND y_coord(P) >= 0

  quadrant_three: point_set =
    LAMBDA (P: point):
      x_coord(P) <= 0 AND y_coord(P) <= 0

  lattice_point(a, b: int): point =
    (# x_coord := a, y_coord := b #)

  no_nonzero_lattice_point(C: point_set): bool =
    FORALL (a, b: int):
      (a /= 0 OR b /= 0) IMPLIES NOT C(lattice_point(a, b))

  in_open_box(P: point, B: box): bool =
    left(B) < x_coord(P)
      AND x_coord(P) < right(B)
      AND bottom(B) < y_coord(P)
      AND y_coord(P) < top(B)

  box_area(B: box): real =
    IF left(B) < right(B) AND bottom(B) < top(B) THEN
      (right(B) - left(B)) * (top(B) - bottom(B))
    ELSE
      0
    ENDIF

  partial_box_area(
      boxes: box_sequence,
      count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      partial_box_area(boxes, count - 1)
        + box_area(boxes(count - 1))
    ENDIF
  MEASURE count

  converges_to(sequence: real_sequence, value: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(sequence(index) - value) < epsilon_value

  unbounded_above(sequence: real_sequence): bool =
    FORALL (bound: real):
      EXISTS (index: nat):
        bound < sequence(index)

  box_series_value(
      boxes: box_sequence,
      value: measure_value): bool =
    canonical_measure(value)
      AND IF infinite_flag(value) THEN
        unbounded_above(
          LAMBDA (count: nat):
            partial_box_area(boxes, count))
      ELSE
        converges_to(
          LAMBDA (count: nat):
            partial_box_area(boxes, count),
          finite_part(value))
      ENDIF

  covers(C: point_set, boxes: box_sequence): bool =
    FORALL (P: point):
      C(P) IMPLIES
        EXISTS (index: nat):
          in_open_box(P, boxes(index))

  cover_has_area(
      C: point_set,
      boxes: box_sequence,
      value: measure_value): bool =
    covers(C, boxes) AND box_series_value(boxes, value)

  is_lebesgue_outer_area(
      C: point_set,
      area: measure_value): bool =
    canonical_measure(area)
      AND (FORALL (boxes: box_sequence), (cover_area: measure_value):
        cover_has_area(C, boxes, cover_area)
          IMPLIES measure_le(area, cover_area))
      AND (FORALL (lower_bound: measure_value):
        (canonical_measure(lower_bound)
          AND FORALL (boxes: box_sequence), (cover_area: measure_value):
            cover_has_area(C, boxes, cover_area)
              IMPLIES measure_le(lower_bound, cover_area))
        IMPLIES measure_le(lower_bound, area))

  lebesgue_area(C: point_set): measure_value =
    epsilon(
      LAMBDA (area: measure_value):
        is_lebesgue_outer_area(C, area))

  equal_quadrant_areas(C: point_set): bool =
    lebesgue_area(set_intersection(C, quadrant_one))
      = lebesgue_area(set_intersection(C, quadrant_four))
      AND lebesgue_area(set_intersection(C, quadrant_four))
        = lebesgue_area(set_intersection(C, quadrant_two))
      AND lebesgue_area(set_intersection(C, quadrant_two))
        = lebesgue_area(set_intersection(C, quadrant_three))

  putnam_1979_b5: bool =
    FORALL (C: point_set):
      (closed_set(C)
        AND convex_set(C)
        AND C(zero_point)
        AND no_nonzero_lattice_point(C)
        AND equal_quadrant_areas(C))
      IMPLIES
        measure_le(lebesgue_area(C), finite_measure(4))
END putnam_1979_b5
