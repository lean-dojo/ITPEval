% Statement-only formalization of PutnamBench artifact putnam_1985_a4:
% the only last-two-digit residue occurring infinitely often in the iterated
% power-of-three sequence beginning with 3 is 87. This file contains no proof.

putnam_1985_a4: THEORY
BEGIN
  natural_sequence: TYPE = [nat -> nat]

  occurs_infinitely_often(
      a: natural_sequence, residue: nat): bool =
    residue < 100
      AND (FORALL (bound: nat):
        EXISTS (index: nat):
          index >= bound
            AND mod(a(index), 100) = residue)

  putnam_1985_a4_solution(residue: nat): bool =
    residue = 87

  putnam_1985_a4: bool =
    FORALL (a: natural_sequence):
      (a(1) = 3
        AND (FORALL (index: nat):
          index >= 1 IMPLIES
            a(index + 1) = 3 ^ a(index)))
      IMPLIES
        (FORALL (residue: nat):
          occurs_infinitely_often(a, residue)
            IFF putnam_1985_a4_solution(residue))
END putnam_1985_a4
