% Statement-only formalization of PutnamBench artifact putnam_1962_a6:
% a set of rational numbers closed under addition and multiplication and
% selecting exactly one of each nonzero pair r and -r is the set of positive
% rational numbers. This file contains no proof.

putnam_1962_a6: THEORY
BEGIN
  putnam_1962_a6: bool =
    FORALL (S: [rat -> bool]):
      ((FORALL (a, b: rat):
          S(a) AND S(b) IMPLIES S(a + b))
        AND (FORALL (a, b: rat):
          S(a) AND S(b) IMPLIES S(a * b))
        AND (FORALL (r: rat):
          (S(r) OR S(-r) OR r = 0)
            AND NOT (S(r) AND S(-r))
            AND NOT (S(r) AND r = 0)
            AND NOT (S(-r) AND r = 0)))
      IMPLIES
        FORALL (r: rat):
          S(r) IFF r > 0
END putnam_1962_a6
