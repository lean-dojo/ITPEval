% Statement-only formalization of PutnamBench corpus artifact putnam_2018_b3:
% the positive integers below 10^100 satisfying the three stated divisibility
% conditions are exactly 2^2, 2^4, 2^16, and 2^256. This file contains no proof.

putnam_2018_b3: THEORY
BEGIN
  int_divides(divisor, value: int): bool =
    EXISTS (quotient: int):
      value = divisor * quotient

  qualifies(n: nat): bool =
    n > 0
      AND n < 10 ^ 100
      AND int_divides((n :: int), (2 :: int) ^ n)
      AND int_divides((n :: int) - 1, (2 :: int) ^ n - 1)
      AND int_divides((n :: int) - 2, (2 :: int) ^ n - 2)

  putnam_2018_b3_solution(n: nat): bool =
    n = 2 ^ 2
      OR n = 2 ^ 4
      OR n = 2 ^ 16
      OR n = 2 ^ 256

  putnam_2018_b3: bool =
    FORALL (n: nat):
      qualifies(n) IFF putnam_2018_b3_solution(n)
END putnam_2018_b3
