% Statement-only formalization of PutnamBench corpus artifact putnam_2025_a6:
% the recursively defined integer sequence has an exact divisibility by a
% specified power of two at paired power-of-two indices. This file contains no proof.

putnam_2025_a6: THEORY
BEGIN
  b(n: nat): RECURSIVE int =
    IF n = 0 THEN
      0
    ELSE
      2 * b(n - 1) ^ 2 + b(n - 1) + 1
    ENDIF
  MEASURE n

  int_divides(divisor, value: int): bool =
    EXISTS (quotient: int):
      value = divisor * quotient

  putnam_2025_a6: bool =
    FORALL (k: nat):
      k >= 1
        IMPLIES
          int_divides(
            (2 :: int) ^ (2 * k + 2),
            b(2 ^ (k + 1)) - 2 * b(2 ^ k))
          AND NOT int_divides(
            (2 :: int) ^ (2 * k + 3),
            b(2 ^ (k + 1)) - 2 * b(2 ^ k))
END putnam_2025_a6
