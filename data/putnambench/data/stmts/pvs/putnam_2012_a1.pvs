% Statement-only formalization of PutnamBench corpus artifact putnam_2012_a1:
% among twelve real numbers in the open interval (1, 12), three entries at
% distinct indices form an acute triangle. This file contains no proof.

putnam_2012_a1: THEORY
BEGIN
  index: TYPE = below(12)
  length_sequence: TYPE = [index -> real]

  admissible(d: length_sequence): bool =
    FORALL (i: index):
      1 < d(i) AND d(i) < 12

  putnam_2012_a1: bool =
    FORALL (d: length_sequence):
      admissible(d) IMPLIES
        EXISTS (i, j, k: index):
          i /= j
            AND i /= k
            AND j /= k
            AND d(k) >= d(i)
            AND d(k) >= d(j)
            AND d(i) ^ 2 + d(j) ^ 2 > d(k) ^ 2
END putnam_2012_a1
