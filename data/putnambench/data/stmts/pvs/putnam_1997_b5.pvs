% Statement-only formalization of PutnamBench corpus artifact putnam_1997_b5:
% successive height-n and height-(n-1) towers of twos are congruent modulo n
% for every natural n at least two. This file contains no proof.

putnam_1997_b5: THEORY
BEGIN
  tetration(base, height: nat): RECURSIVE nat =
    IF height = 0 THEN
      1
    ELSE
      base ^ tetration(base, height - 1)
    ENDIF
  MEASURE height

  putnam_1997_b5: bool =
    FORALL (n: nat):
      n >= 2 IMPLIES
        mod(tetration(2, n), n)
          = mod(tetration(2, n - 1), n)
END putnam_1997_b5
