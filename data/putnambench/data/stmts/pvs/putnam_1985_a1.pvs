% Statement-only formalization of PutnamBench artifact putnam_1985_a1:
% the ordered triples of sets whose union is {1,...,10} and whose triple
% intersection is empty have cardinality 2^10 * 3^10 * 5^0 * 7^0. This file
% contains no proof.

putnam_1985_a1: THEORY
BEGIN
  nat_set: TYPE = [nat -> bool]

  set_triple: TYPE =
    [# first_set: nat_set, second_set: nat_set, third_set: nat_set #]

  solution_exponents: TYPE =
    [# a: nat, b: nat, c: nat, d: nat #]

  IMPORTING finite_sets[set_triple]

  qualifying(sets: set_triple): bool =
    (FORALL (n: nat):
      (first_set(sets)(n)
        OR second_set(sets)(n)
        OR third_set(sets)(n))
        IFF (1 <= n AND n <= 10))
      AND
        (FORALL (n: nat):
          NOT (first_set(sets)(n)
            AND second_set(sets)(n)
            AND third_set(sets)(n)))

  putnam_1985_a1_solution: solution_exponents =
    (# a := 10, b := 10, c := 0, d := 0 #)

  solution_value(exponents: solution_exponents): nat =
    2 ^ a(exponents)
      * 3 ^ b(exponents)
      * 5 ^ c(exponents)
      * 7 ^ d(exponents)

  putnam_1985_a1: bool =
    EXISTS (solutions: finite_set[set_triple]):
      card(solutions) = solution_value(putnam_1985_a1_solution)
        AND (FORALL (sets: set_triple):
          solutions(sets) IFF qualifying(sets))
END putnam_1985_a1
