-- Statement-only formalization of PutnamBench corpus artifact putnam_1975_b1:
-- the integer-pair subgroup generated by (3, 8), (4, -1), and (5, 4) has a
-- two-generator description using (1, b) and (0, 7). This file contains no
-- proof.

{-# OPTIONS --safe #-}

open import Agda.Builtin.Equality renaming (_≡_ to _==_)
open import Agda.Builtin.Int using (Int; pos; negsuc)
open import Agda.Builtin.Nat using (Nat; zero; suc; _+_; _*_)

infixr 3 _and_

record _and_ (A B : Set) : Set where
  constructor both
  field
    first  : A
    second : B

record Iff (A B : Set) : Set where
  constructor equivalence
  field
    forward  : A -> B
    backward : B -> A

record Exists (A : Set) (P : A -> Set) : Set where
  constructor witness
  field
    value    : A
    property : P value

record _×_ (A B : Set) : Set where
  constructor pair
  field
    first-component  : A
    second-component : B

negative : Nat -> Int
negative zero =
  pos zero
negative (suc n) =
  negsuc n

difference : Nat -> Nat -> Int
difference zero zero =
  pos zero
difference (suc m) zero =
  pos (suc m)
difference zero (suc n) =
  negsuc n
difference (suc m) (suc n) =
  difference m n

addInt : Int -> Int -> Int
addInt (pos m) (pos n) =
  pos (m + n)
addInt (pos m) (negsuc n) =
  difference m (suc n)
addInt (negsuc m) (pos n) =
  difference n (suc m)
addInt (negsuc m) (negsuc n) =
  negsuc (suc (m + n))

negateInt : Int -> Int
negateInt (pos n) =
  negative n
negateInt (negsuc n) =
  pos (suc n)

multiplyInt : Int -> Int -> Int
multiplyInt (pos m) (pos n) =
  pos (m * n)
multiplyInt (pos m) (negsuc n) =
  negative (m * suc n)
multiplyInt (negsuc m) (pos n) =
  negative (suc m * n)
multiplyInt (negsuc m) (negsuc n) =
  pos (suc m * suc n)

PairOfIntegers : Set
PairOfIntegers =
  Int × Int

IntegerPairSet : Set1
IntegerPairSet =
  PairOfIntegers -> Set

SetEqual : IntegerPairSet -> IntegerPairSet -> Set
SetEqual A B =
  (point : PairOfIntegers) ->
  Iff (A point) (B point)

PositiveInt : Int -> Set
PositiveInt x =
  Exists Nat (\ n -> x == pos (suc n))

threeZ : Int
threeZ =
  pos 3

fourZ : Int
fourZ =
  pos 4

fiveZ : Int
fiveZ =
  pos 5

sevenZ : Int
sevenZ =
  pos 7

eightZ : Int
eightZ =
  pos 8

putnam-1975-b1-solution : Int
putnam-1975-b1-solution =
  sevenZ

GeneratedByThree : PairOfIntegers -> Set
GeneratedByThree point =
  Exists Int
    (\ u ->
      Exists Int
        (\ v ->
          Exists Int
            (\ w ->
              point
              ==
              pair
                (addInt
                  (addInt
                    (multiplyInt u threeZ)
                    (multiplyInt v fourZ))
                  (multiplyInt w fiveZ))
                (addInt
                  (addInt
                    (multiplyInt u eightZ)
                    (negateInt v))
                  (multiplyInt w fourZ)))))

GeneratedByTwo : Int -> PairOfIntegers -> Set
GeneratedByTwo b point =
  Exists Int
    (\ u ->
      Exists Int
        (\ v ->
          point
          ==
          pair
            u
            (addInt
              (multiplyInt u b)
              (multiplyInt v putnam-1975-b1-solution))))

putnam-1975-b1 : Set1
putnam-1975-b1 =
  (H : IntegerPairSet) ->
  SetEqual H GeneratedByThree ->
  Exists Int
    (\ b ->
      SetEqual H (GeneratedByTwo b))
  and
  PositiveInt putnam-1975-b1-solution
