;; Statement-only formalization of PutnamBench corpus artifact putnam_2009_b6:
;; every positive integer is the final term of a length-2010 integer sequence
;; generated by earlier-term power-of-two additions or positive-term
;; remainders. This file contains no proof.

(in-package "ACL2")

;; Only the entries at indices 0 through 2009 occur in the source proposition,
;; so a true list of length 2010 is equivalent to the restriction of the
;; source's natural-indexed function to those indices. A second length-2009
;; list carries one existential certificate for each later entry:
;;
;;   (0 j k) records a_i = a_j + 2^k with j < i and k natural;
;;   (1 b c) records a_i = a_b mod a_c with b,c < i and positive entries.
;;
;; Bundling these finitely many certificates with the sequence preserves all
;; inner existential quantifiers. The outer negated FN-EQUAL keeps the bundled
;; witness existentially quantified inside the statement. Every function
;; passed to APPLY$ is built solely from badged primitives and tame LOOP$
;; scions; no user-defined predicate is invoked through APPLY$.

(defun putnam-2009-b6-quoted (object)
  (list 'quote object))

(defun putnam-2009-b6-list-term (terms)
  (if (consp terms)
      (list
       'cons
       (car terms)
       (putnam-2009-b6-list-term (cdr terms)))
    (putnam-2009-b6-quoted nil)))

(defun putnam-2009-b6-and-terms (terms)
  (if (consp terms)
      (list
       'if
       (car terms)
       (putnam-2009-b6-and-terms (cdr terms))
       (putnam-2009-b6-quoted nil))
    (putnam-2009-b6-quoted t)))

(defun putnam-2009-b6-or-terms (terms)
  (if (consp terms)
      (list
       'if
       (car terms)
       (putnam-2009-b6-quoted t)
       (putnam-2009-b6-or-terms (cdr terms)))
    (putnam-2009-b6-quoted nil)))

(defun putnam-2009-b6-add-term (left right)
  (list 'binary-+ left right))

(defun putnam-2009-b6-range-term (lower upper)
  (list
   'from-to-by
   (putnam-2009-b6-quoted lower)
   (putnam-2009-b6-quoted upper)
   (putnam-2009-b6-quoted 1)))

(defun putnam-2009-b6-iteration-term (carrier)
  (list
   'loop$-as
   (putnam-2009-b6-list-term
    (list carrier))))

(defun putnam-2009-b6-integer-entry-function ()
  '(lambda (globals entry)
     (integerp (car entry))))

(defun putnam-2009-b6-step-function ()
  (let* ((i
          (list 'car 'entry))
         (sequence
          (list 'car 'globals))
         (certificates
          (list
           'nth
           (putnam-2009-b6-quoted 1)
           'globals))
         (certificate-index
          (putnam-2009-b6-add-term
           i
           (putnam-2009-b6-quoted -1)))
         (certificate
          (list
           'nth
           certificate-index
           certificates))
         (tag
          (list
           'nth
           (putnam-2009-b6-quoted 0)
           certificate))
         (first-witness
          (list
           'nth
           (putnam-2009-b6-quoted 1)
           certificate))
         (second-witness
          (list
           'nth
           (putnam-2009-b6-quoted 2)
           certificate))
         (current-value
          (list 'nth i sequence))
         (first-value
          (list 'nth first-witness sequence))
         (second-value
          (list 'nth second-witness sequence))
         (add-certificate
          (putnam-2009-b6-and-terms
           (list
            (list
             'equal
             tag
             (putnam-2009-b6-quoted 0))
            (list 'natp first-witness)
            (list 'natp second-witness)
            (list '< first-witness i)
            (list
             'equal
             current-value
             (putnam-2009-b6-add-term
              first-value
              (list
               'expt
               (putnam-2009-b6-quoted 2)
               second-witness))))))
         (mod-certificate
          (putnam-2009-b6-and-terms
           (list
            (list
             'equal
             tag
             (putnam-2009-b6-quoted 1))
            (list 'natp first-witness)
            (list 'natp second-witness)
            (list '< first-witness i)
            (list '< second-witness i)
            (list
             '<
             (putnam-2009-b6-quoted 0)
             first-value)
            (list
             '<
             (putnam-2009-b6-quoted 0)
             second-value)
            (list
             'equal
             current-value
             (list
              'mod
              first-value
              second-value))))))
    (list
     'lambda
     '(globals entry)
     (putnam-2009-b6-and-terms
      (list
       (list 'true-listp certificate)
       (list
        'equal
        (list 'len certificate)
        (putnam-2009-b6-quoted 3))
       (putnam-2009-b6-or-terms
        (list add-certificate mod-certificate)))))))

(defun putnam-2009-b6-all-integers-term (sequence)
  (list
   'always$+
   (putnam-2009-b6-quoted
    (putnam-2009-b6-integer-entry-function))
   (putnam-2009-b6-quoted nil)
   (putnam-2009-b6-iteration-term sequence)))

(defun putnam-2009-b6-all-steps-term
    (sequence certificates)
  (list
   'always$+
   (putnam-2009-b6-quoted
    (putnam-2009-b6-step-function))
   (putnam-2009-b6-list-term
    (list sequence certificates))
   (putnam-2009-b6-iteration-term
    (putnam-2009-b6-range-term 1 2009))))

(defun putnam-2009-b6-witness-failure-function (n)
  (let* ((sequence
          (list
           'nth
           (putnam-2009-b6-quoted 0)
           'witness))
         (certificates
          (list
           'nth
           (putnam-2009-b6-quoted 1)
           'witness))
         (witness-conditions
          (putnam-2009-b6-and-terms
           (list
            (list 'true-listp 'witness)
            (list
             'equal
             (list 'len 'witness)
             (putnam-2009-b6-quoted 2))
            (list 'true-listp sequence)
            (list
             'equal
             (list 'len sequence)
             (putnam-2009-b6-quoted 2010))
            (putnam-2009-b6-all-integers-term sequence)
            (list 'true-listp certificates)
            (list
             'equal
             (list 'len certificates)
             (putnam-2009-b6-quoted 2009))
            (list
             'equal
             (list
              'nth
              (putnam-2009-b6-quoted 0)
              sequence)
             (putnam-2009-b6-quoted 0))
            (list
             'equal
             (list
              'nth
              (putnam-2009-b6-quoted 2009)
              sequence)
             (putnam-2009-b6-quoted n))
            (putnam-2009-b6-all-steps-term
             sequence certificates)))))
    (list
     'lambda
     '(witness)
     (list
      'if
      witness-conditions
      (putnam-2009-b6-quoted nil)
      (putnam-2009-b6-quoted t)))))

(defun putnam-2009-b6-true-function ()
  '(lambda (witness) 't))

(defun putnam-2009-b6-witness-exists-p (n)
  (let ((integer-function
         (putnam-2009-b6-integer-entry-function))
        (step-function
         (putnam-2009-b6-step-function))
        (failure-function
         (putnam-2009-b6-witness-failure-function n))
        (true-function
         (putnam-2009-b6-true-function)))
    (and
     (tamep-functionp integer-function)
     (tamep-functionp step-function)
     (tamep-functionp failure-function)
     (tamep-functionp true-function)
     (not
      (fn-equal failure-function true-function)))))

(defun putnambench-putnam-2009-b6-statement (n)
  (implies
   (and
    (integerp n)
    (< 0 n))
   (putnam-2009-b6-witness-exists-p n)))

(value-triple :itpeval-statement-checked)
:q
