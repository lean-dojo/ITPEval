;; Statement-only formalization of PutnamBench corpus artifact putnam_1995_a1:
;; a multiplicatively closed set of real numbers partitioned into two
;; triple-product-closed subsets has a multiplication-closed part. This file
;; contains no proof.

(in-package "ACL2")

;; S, T, and U are characteristic-function objects for arbitrary subsets.
;; The matrices below restrict their arguments to exact rationals and use
;; FN-EQUAL to express the source universal quantifiers.
;;
;; This rational presentation is bidirectionally equivalent to the real
;; statement. A rational instance is already a real instance. Conversely, a
;; real counterexample would have witnesses to the failure of closure of both
;; T and U. The multiplicative subsemigroup generated by those finitely many
;; witnesses lies in S. Its nonzero part embeds in the finitely generated
;; subgroup of R*, which is Z^r times at most the sign group and therefore
;; embeds in Q* by sending free generators to distinct primes; zero, if
;; present, maps to zero. Transporting the partition along this injective
;; homomorphism gives a rational counterexample with exactly the same closure
;; hypotheses and failures.

(defun putnam-1995-a1-quoted (object)
  (list 'quote object))

(defun putnam-1995-a1-apply1-term (function argument)
  (list 'apply$
        (putnam-1995-a1-quoted function)
        (list 'cons argument nil)))

(defun putnam-1995-a1-member-term (set element)
  (list 'if
        (putnam-1995-a1-apply1-term set element)
        (putnam-1995-a1-quoted t)
        (putnam-1995-a1-quoted nil)))

(defun putnam-1995-a1-and-terms (terms)
  (if (consp terms)
      (list 'if
            (car terms)
            (putnam-1995-a1-and-terms (cdr terms))
            (putnam-1995-a1-quoted nil))
    (putnam-1995-a1-quoted t)))

(defun putnam-1995-a1-or-term (left right)
  (list 'if
        left
        (putnam-1995-a1-quoted t)
        right))

(defun putnam-1995-a1-implies-term (hypothesis conclusion)
  (list 'if
        hypothesis
        conclusion
        (putnam-1995-a1-quoted t)))

(defun putnam-1995-a1-product-term (left right)
  (list 'binary-* left right))

(defun putnam-1995-a1-true-function (formals)
  (list 'lambda formals (putnam-1995-a1-quoted t)))

(defun putnam-1995-a1-binary-closure-function (set)
  (let ((product
         (putnam-1995-a1-product-term 'a 'b)))
    (list
     'lambda
     '(a b)
     (putnam-1995-a1-implies-term
      (putnam-1995-a1-and-terms
       (list
        (list 'rationalp 'a)
        (list 'rationalp 'b)
        (putnam-1995-a1-member-term set 'a)
        (putnam-1995-a1-member-term set 'b)))
      (putnam-1995-a1-member-term set product)))))

(defun putnam-1995-a1-subset-function (left right)
  (list
   'lambda
   '(a)
   (putnam-1995-a1-implies-term
    (putnam-1995-a1-and-terms
     (list
      (list 'rationalp 'a)
      (putnam-1995-a1-member-term left 'a)))
    (putnam-1995-a1-member-term right 'a))))

(defun putnam-1995-a1-union-function (s t-set u-set)
  (list
   'lambda
   '(a)
   (putnam-1995-a1-implies-term
    (list 'rationalp 'a)
    (list
     'equal
     (putnam-1995-a1-member-term s 'a)
     (putnam-1995-a1-or-term
      (putnam-1995-a1-member-term t-set 'a)
      (putnam-1995-a1-member-term u-set 'a))))))

(defun putnam-1995-a1-disjoint-function (t-set u-set)
  (list
   'lambda
   '(a)
   (putnam-1995-a1-implies-term
    (list 'rationalp 'a)
    (list
     'if
     (putnam-1995-a1-member-term t-set 'a)
     (list 'if
           (putnam-1995-a1-member-term u-set 'a)
           (putnam-1995-a1-quoted nil)
           (putnam-1995-a1-quoted t))
     (putnam-1995-a1-quoted t)))))

(defun putnam-1995-a1-triple-closure-function (set)
  (let* ((ab
          (putnam-1995-a1-product-term 'a 'b))
         (abc
          (putnam-1995-a1-product-term ab 'c)))
    (list
     'lambda
     '(a b c)
     (putnam-1995-a1-implies-term
      (putnam-1995-a1-and-terms
       (list
        (list 'rationalp 'a)
        (list 'rationalp 'b)
        (list 'rationalp 'c)
        (putnam-1995-a1-member-term set 'a)
        (putnam-1995-a1-member-term set 'b)
        (putnam-1995-a1-member-term set 'c)))
      (putnam-1995-a1-member-term set abc)))))

(defun putnambench-putnam-1995-a1-statement (s t-set u-set)
  (implies
   (and
    (tamep-functionp s)
    (tamep-functionp t-set)
    (tamep-functionp u-set)
    (fn-equal
     (putnam-1995-a1-binary-closure-function s)
     (putnam-1995-a1-true-function '(a b)))
    (fn-equal
     (putnam-1995-a1-subset-function t-set s)
     (putnam-1995-a1-true-function '(a)))
    (fn-equal
     (putnam-1995-a1-subset-function u-set s)
     (putnam-1995-a1-true-function '(a)))
    (fn-equal
     (putnam-1995-a1-union-function s t-set u-set)
     (putnam-1995-a1-true-function '(a)))
    (fn-equal
     (putnam-1995-a1-disjoint-function t-set u-set)
     (putnam-1995-a1-true-function '(a)))
    (fn-equal
     (putnam-1995-a1-triple-closure-function t-set)
     (putnam-1995-a1-true-function '(a b c)))
    (fn-equal
     (putnam-1995-a1-triple-closure-function u-set)
     (putnam-1995-a1-true-function '(a b c))))
   (or
    (fn-equal
     (putnam-1995-a1-binary-closure-function t-set)
     (putnam-1995-a1-true-function '(a b)))
    (fn-equal
     (putnam-1995-a1-binary-closure-function u-set)
     (putnam-1995-a1-true-function '(a b))))))

(value-triple :itpeval-statement-checked)
:q
