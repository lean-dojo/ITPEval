:: Statement-only formalization of PutnamBench corpus artifact putnam_1991_a6:
:: the numbers of positive-integer compositions satisfying a strict
:: two-step inequality and of complete nonincreasing compositions from a
:: Fibonacci-type sequence are equal. This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      XCMPLX_0, FUNCT_4, STRUCT_0, XBOOLE_0, FUNCT_1, SUPINF_2, NUMBERS,
      VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1, CARD_3, BINOP_1, TARSKI,
      PARTFUN1, ZFMISC_1, INT_1, NEWTON, FINSET_1, REALSET1, VALUED_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      REAL_1, INT_1, NAT_1, NAT_D, NEWTON, VALUED_0, FINSEQ_1, FINSEQ_2,
      RVSUM_1, FUNCT_7, FINSET_1;
 constructors REAL_1, NAT_D, NEWTON, RVSUM_1, FUNCT_7, BINOP_2, FINSEQ_4,
      FINSET_1;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, CARD_1,
      FUNCT_7, MEMBERED, RELSET_1, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0,
      NAT_1, INT_1, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
      NEWTON, FRAENKEL, FINSET_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2;
 equalities XCMPLX_0;
 expansions TARSKI;

begin

::$P-
theorem
  for A,g,B being Function of NAT,NAT st
    (for n being Nat st 1 <= n holds
      A.n = card {a where a is FinSequence of NAT :
        0 < len a &
        (for i being Nat st i in Seg len a holds 0 < a.i) &
        Sum a = n &
        (for i being Nat st i in Seg (len a -' 2) holds
          a.i > a.(i + 1) + a.(i + 2)) &
        (1 < len a implies a.(len a -' 1) > a.(len a))}) &
    g.0 = 1 &
    g.1 = 2 &
    (for j being Nat st 2 <= j holds
      g.j = g.(j -' 1) + g.(j -' 2) + 1) &
    (for n being Nat st 1 <= n holds
      B.n = card {b where b is FinSequence of NAT :
        0 < len b &
        (for i being Nat st i in Seg len b holds 0 < b.i) &
        Sum b = n &
        (for i being Nat st i in Seg (len b -' 1) holds
          b.i >= b.(i + 1)) &
        (for i being Nat st i in Seg len b holds
          ex j being Nat st b.i = g.j) &
        (ex k being Nat st
          b.1 = g.k &
          for j being Nat st j <= k holds
            ex i being Nat st i in Seg len b & b.i = g.j)})
  holds
    for n being Nat st 1 <= n holds A.n = B.n
proof
end;
::$P+
