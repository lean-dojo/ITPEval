:: Statement-only formalization of PutnamBench artifact putnam_1972_b2:
:: the maximum time for a twice differentiable real trajectory with
:: nonincreasing second derivative and prescribed displacement and endpoint
:: velocities is 2*s/v. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0,
    SEQ_2, VALUED_1, FUNCT_2, FUNCOP_1, FUNCT_7, NAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XXREAL_0, XXREAL_2, XCMPLX_0, REAL_1, COMPLEX1,
    RELSET_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1,
    PARTFUN2, RCOMP_1, FCONT_1, FDIFF_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0;
  expansions TARSKI;
  theorems TARSKI, NAT_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN2, RFUNCT_2,
    RCOMP_1, FCONT_1, FDIFF_1, ZFMISC_1, FUNCT_1, XREAL_0, XBOOLE_0,
    XBOOLE_1, XCMPLX_1, FUNCOP_1, XREAL_1, XXREAL_0, VALUED_1,
    XXREAL_2, XXREAL_1, FUNCT_2, VALUED_0, ORDINAL1, ABSVALUE;
  schemes SEQ_1;

begin

::$P-
theorem
  for s,v being Real st 0 < s & 0 < v holds
    (ex x,d1,d2 being Function of REAL,REAL st
      (for w being Real holds
        (x is_differentiable_in w & d1.w = diff(x,w)) or
        (not x is_differentiable_in w & d1.w = 0)) &
      (for w being Real holds
        (d1 is_differentiable_in w & d2.w = diff(d1,w)) or
        (not d1 is_differentiable_in w & d2.w = 0)) &
      (for w being Real st 0 <= w & w <= 2*s/v holds
        x is_differentiable_in w & d1 is_differentiable_in w) &
      (for a,b being Real st 0 <= a & a <= b & b <= 2*s/v holds
        d2.b <= d2.a) &
      d1.0 = 0 & d1.(2*s/v) = v & x.(2*s/v) - x.0 = s) &
    (for t being Real st t > 2*s/v holds
      not ex x,d1,d2 being Function of REAL,REAL st
        (for w being Real holds
          (x is_differentiable_in w & d1.w = diff(x,w)) or
          (not x is_differentiable_in w & d1.w = 0)) &
        (for w being Real holds
          (d1 is_differentiable_in w & d2.w = diff(d1,w)) or
          (not d1 is_differentiable_in w & d2.w = 0)) &
        (for w being Real st 0 <= w & w <= t holds
          x is_differentiable_in w & d1 is_differentiable_in w) &
        (for a,b being Real st 0 <= a & a <= b & b <= t holds
          d2.b <= d2.a) &
        d1.0 = 0 & d1.t = v & x.t - x.0 = s)
proof
end;
::$P+
