:: Statement-only formalization of PutnamBench corpus artifact putnam_2022_b4
:: (putnambench__mizar__putnam_2022_b4): classification of lengths of cyclic
:: sequences of distinct real numbers whose consecutive triples are
:: three-term arithmetic progressions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, FUNCT_2, NUMBERS, NAT_1, REAL_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, INT_1, NEWTON, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ENUMSET1, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, REAL_1, INT_1, NAT_1, NAT_D, NEWTON;
  constructors ENUMSET1, RELSET_1, FUNCT_2, REAL_1, NAT_1, NAT_D,
    INT_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st 4 <= n holds
    ((ex x being Function of NAT,REAL st
      (for i,j being Nat st
        i < n & j < n & i <> j
      holds x.i <> x.j) &
      (for i being Nat st i < n holds
        ex o0,o1,o2 being Real st
          o0 < o1 & o1 < o2 &
          {o0,o1,o2} =
            {x.i,x.((i + 1) mod n),x.((i + 2) mod n)} &
          o1 - o0 = o2 - o1))
    iff 9 <= n & 3 divides n)
proof
end;
::$P+
