:: Statement-only formalization of PutnamBench corpus artifact putnam_2018_b1
:: (putnambench__mizar__putnam_2018_b1): characterization of the integer
:: vectors whose removal from a 3 by 101 lattice rectangle permits a
:: partition into equal-size parts with equal vector sums. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1,
    RELAT_1, FUNCT_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1,
    NAT_1, CARD_1, ORDINAL1, FINSET_1, FINSEQ_1, FINSEQ_2, CARD_3,
    VALUED_0, VALUED_1, RVSUM_1, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, RELAT_1,
    FUNCT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, FINSET_1;
  constructors RELSET_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1,
    NAT_1, FINSEQ_1, FINSEQ_2, FINSEQOP, RVSUM_1, FINSET_1, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, FINSET_1,
    MEMBERED;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for P being finite Subset of [:INT,INT:],
      v being Element of [:INT,INT:] st
    P = {[a,b] where a,b is Integer :
      0 <= a & a <= 2 & 0 <= b & b <= 100}
  holds
    (v in P &
      ex Q,R being finite Subset of [:INT,INT:],
         qseq,rseq being FinSequence of [:INT,INT:],
         qx,qy,rx,ry being FinSequence of INT st
        Q \/ R = P \ {v} &
        Q misses R &
        card Q = card R &
        qseq is one-to-one & rng qseq = Q &
        rseq is one-to-one & rng rseq = R &
        len qx = len qseq & len qy = len qseq &
        len rx = len rseq & len ry = len rseq &
        (for i being Nat st i in dom qseq holds
          ex a,b being Integer st
            qseq.i = [a,b] & qx.i = a & qy.i = b) &
        (for i being Nat st i in dom rseq holds
          ex a,b being Integer st
            rseq.i = [a,b] & rx.i = a & ry.i = b) &
        Sum qx = Sum rx &
        Sum qy = Sum ry)
    iff
    ex b,k being Integer st
      0 <= b & b <= 100 &
      b = 2*k &
      v = [1,b]
proof
end;
::$P+
