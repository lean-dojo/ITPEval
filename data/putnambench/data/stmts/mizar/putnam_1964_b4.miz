:: Statement-only formalization of PutnamBench artifact putnam_1964_b4:
:: n distinct great circles in general position divide the unit sphere into
:: n^2-n+2 regions characterized by their nonzero dot-product signs. This
:: file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2,
      FUNCT_1, FUNCT_2, METRIC_1, NAT_1, NUMBERS, PRE_TOPC, RELAT_1,
      RLTOPSP1, RLVECT_1, RVSUM_1, SQUARE_1, STRUCT_0, SUBSET_1, TARSKI,
      TOPMETR, VALUED_0, VALUED_1, XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0,
      ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, COMPLEX1, XXREAL_0, NAT_1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2, SQUARE_1, STRUCT_0,
      PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1, EUCLID, RVSUM_1, TOPMETR;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, TOPMETR;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLTOPSP1;
 equalities STRUCT_0, FINSEQ_1, FINSEQ_2, RVSUM_1, SQUARE_1, EUCLID,
      VALUED_1;
 expansions TARSKI, XBOOLE_0, FUNCT_1, RVSUM_1;

begin

::$P-
theorem
  for n being non zero Nat,
      C being Function of Seg n, bool the carrier of TOP-REAL 3,
      v being Function of Seg n, the carrier of TOP-REAL 3,
      IsRegion being Subset of bool the carrier of TOP-REAL 3 st
    (for i being Element of Seg n holds
      C.i = {x where x is Point of TOP-REAL 3 : |.x.| = 1} /\
        {x where x is Point of TOP-REAL 3 : |(v.i,x)| = 0}) &
    (for i being Element of Seg n holds |.(v.i).| <> 0) &
    C is one-to-one &
    (for x,y being Point of TOP-REAL 3 st
      |.x.| = 1 & |.y.| = 1
     holds
      card {i where i is Element of Seg n : x in C.i & y in C.i} = 0 or
      card {i where i is Element of Seg n : x in C.i & y in C.i} = 1 or
      card {i where i is Element of Seg n : x in C.i & y in C.i} = 2) &
    (for R being Subset of TOP-REAL 3 holds
      R in IsRegion iff
        R <> {} &
        ex sign being Function of Seg n,REAL st
          (for i being Element of Seg n holds
            sign.i = -1 or sign.i = 1) &
          R = {x where x is Point of TOP-REAL 3 : |.x.| = 1} /\
            {x where x is Point of TOP-REAL 3 :
              for i being Element of Seg n holds
                (sign.i = -1 & |(v.i,x)| < 0) or
                (sign.i = 1 & 0 < |(v.i,x)|)})
  holds
    card {R where R is Subset of TOP-REAL 3 : R in IsRegion}
      = n*n - n + 2
proof
end;
::$P+
