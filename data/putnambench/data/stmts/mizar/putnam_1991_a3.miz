:: Statement-only formalization of PutnamBench corpus artifact putnam_1991_a3:
:: the real polynomials whose ordered roots have derivative zeros at every
:: consecutive midpoint are exactly the quadratics with two distinct real
:: roots. This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3,
      FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1,
      SUPINF_2, NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1,
      CARD_3, BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4,
      FINSEQ_2, VECTSP_2, ZFMISC_1, FUNCT_2, COMPLEX1, VALUED_1, FINSET_1,
      FDIFF_1, RCOMP_1, REALSET1, POLYDIFF;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, FINSET_1, NUMBERS, XCMPLX_0, XXREAL_0,
      XREAL_0, REAL_1, COMPLEX1, NAT_1, VALUED_0, VALUED_1, FINSEQ_1,
      FINSEQ_2, FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
      VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5,
      FDIFF_1, POLYDIFF;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
      VECTSP_2, ALGSTR_1, FUNCT_1, RELSET_1, FUNCT_2, CARD_1, FINSET_1,
      REAL_1, COMPLEX1, NAT_1, POLYDIFF;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, VECTSP_2, ALGSTR_1,
      FINSET_1, POLYDIFF;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0,
      POLYDIFF;
 expansions TARSKI, XBOOLE_0, ALGSEQ_1, POLYNOM5;
 theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3, POLYNOM4,
      POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0, POLYDIFF;

begin

::$P-
theorem
  for p being Polynomial of F_Real,
      n being Nat st
    2 <= n &
    len p = n + 1
  holds
    ((ex r being Function of NAT,F_Real,
         d being Polynomial of F_Real st
        d = poly_diff(p) &
        (for i being Nat st 1 <= i & i < n holds
          r.i < r.(i + 1)) &
        (for i being Nat st 1 <= i & i <= n holds
          eval(p,r.i) = 0.F_Real) &
        (for i being Nat st 1 <= i & i < n holds
          ex x being Element of F_Real st
            x = (r.i + r.(i + 1)) / 2 &
            eval(d,x) = 0.F_Real))
    iff
      len p = 3 &
      ex r1,r2 being Element of F_Real st
        r1 <> r2 &
        eval(p,r1) = 0.F_Real &
        eval(p,r2) = 0.F_Real)
proof
end;
::$P+
