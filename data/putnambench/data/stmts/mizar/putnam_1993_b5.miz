:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_b5:
:: no four points in the real Euclidean plane have all six pairwise distances
:: equal to odd integers. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, METRIC_1, NAT_1, NUMBERS,
      PRE_TOPC, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1, SQUARE_1, STRUCT_0,
      SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1, XBOOLE_0, XCMPLX_0,
      XREAL_0, XXREAL_0, ZFMISC_1, INT_1, ABIAN, REAL_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, COMPLEX1, XXREAL_0, NAT_1, CARD_1, RELAT_1,
      FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2, SQUARE_1,
      STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1, EUCLID, RVSUM_1,
      TOPMETR, TOPREAL6, INT_1, ABIAN, REAL_1;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, TOPMETR, TOPREAL6, INT_1, ABIAN;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1, INT_1, ABIAN;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  not ex A,B,C,D being Point of TOP-REAL 2,
      ab,ac,ad,bc,bd,cd being Integer st
    dist(A,B) = (ab qua Real) & ab is odd &
    dist(A,C) = (ac qua Real) & ac is odd &
    dist(A,D) = (ad qua Real) & ad is odd &
    dist(B,C) = (bc qua Real) & bc is odd &
    dist(B,D) = (bd qua Real) & bd is odd &
    dist(C,D) = (cd qua Real) & cd is odd
proof
end;
::$P+
