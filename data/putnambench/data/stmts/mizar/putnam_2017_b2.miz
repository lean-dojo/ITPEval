:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_b2
:: (putnambench__mizar__putnam_2017_b2): the least positive starting integer
:: whose sum of 2017 consecutive positive integers has no representation by
:: any other number greater than one of consecutive positive integers is 16.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, FINSEQ_1,
    RVSUM_1, FINSEQ_2, NAT_1;
  constructors REAL_1, NAT_1, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  0 < 16 &
  (ex base being FinSequence of INT st
    len base = 2017 &
    (for i being Nat st i in Seg 2017 holds
      base.i = 16 + (i -' 1)) &
    (for b being Integer, k being Nat,
         terms being FinSequence of INT st
      0 < b & 1 < k &
      len terms = k &
      (for i being Nat st i in Seg k holds
        terms.i = b + (i -' 1)) &
      Sum base = Sum terms
    holds k = 2017)) &
  (for a being Integer st
    0 < a &
    (ex base being FinSequence of INT st
      len base = 2017 &
      (for i being Nat st i in Seg 2017 holds
        base.i = a + (i -' 1)) &
      (for b being Integer, k being Nat,
           terms being FinSequence of INT st
        0 < b & 1 < k &
        len terms = k &
        (for i being Nat st i in Seg k holds
          terms.i = b + (i -' 1)) &
        Sum base = Sum terms
      holds k = 2017))
  holds 16 <= a)
proof
end;
::$P+
