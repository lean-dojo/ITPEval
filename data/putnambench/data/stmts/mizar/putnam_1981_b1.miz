:: Statement-only formalization of PutnamBench artifact putnam_1981_b1:
:: the normalized double sum of 5*h^4 - 18*h^2*k^2 + 5*k^4 over
:: 1 <= h,k <= n converges to -1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN,
    ORDINAL1, SERIES_1, SIN_COS, RVSUM_1, FINSEQ_1, FINSEQ_2,
    ORDINAL4, BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, ZFMISC_1, CARD_3,
    SETWISEO, SETWOP_2, FINSOP_1, FUNCT_7;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_1,
    PARTFUN1, BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP,
    SETWOP_2, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    ABIAN, XXREAL_2, POWER, RVSUM_1, SERIES_1, SIN_COS;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, BINOP_1,
    SETWISEO, BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1,
    SETWOP_2, XXREAL_1, FINSEQ_2, SEQ_2, SEQM_3, SEQ_4, PREPOWER,
    ABIAN, COMSEQ_2, POWER, RVSUM_1, SERIES_1, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN, FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1,
    SIN_COS, BINOP_2, FUNCOP_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s being Real_Sequence st
    (for n being Nat holds
      ex outer being FinSequence of REAL st
        len outer = n &
        (for h being Nat st h in Seg n holds
          ex inner being FinSequence of REAL st
            len inner = n &
            (for k being Nat st k in Seg n holds
              inner.k =
                5 * ((h qua Real) |^ 4) -
                18 * ((h qua Real) |^ 2) * ((k qua Real) |^ 2) +
                5 * ((k qua Real) |^ 4)) &
            outer.h = Sum inner) &
        s.n = (1 / ((n qua Real) |^ 5)) * Sum outer)
  holds s is convergent & lim s = -1
proof
end;
::$P+
