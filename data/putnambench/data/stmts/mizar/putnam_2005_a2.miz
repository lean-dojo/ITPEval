:: Statement-only formalization of PutnamBench corpus artifact putnam_2005_a2:
:: the number of unit-step rook tours through every point of an n by 3 integer
:: grid, from (1,1) to (n,1), is 0 for n=1 and 2^(n-2) otherwise. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, FINSET_1, NEWTON, ARYTM_1, ARYTM_3, COMPLEX1,
    CARD_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSET_1, NEWTON, COMPLEX1;
  constructors REAL_1, NAT_1, NAT_D, NEWTON, FINSET_1, CARD_1,
    RELSET_1, NUMBERS, COMPLEX1, ZFMISC_1, FUNCT_2;
  registrations XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, NEWTON, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for n being Nat, tours being set st
    0 < n &
    tours =
      {p where p is Function of NAT,[:INT,INT:] :
        p.0 = [0,0] &
        (for i being Nat st 3*n < i holds p.i = [0,0]) &
        (for a,b being Integer st
          1 <= a & a <= (n qua Integer) & 1 <= b & b <= 3
        holds
          ex i being Nat st
            1 <= i & i <= 3*n & p.i = [a,b] &
            for j being Nat st
              1 <= j & j <= 3*n & p.j = [a,b]
            holds j = i) &
        (for i being Nat st 1 <= i & i < 3*n holds
          ex a,b,c,d being Integer st
            p.i = [a,b] & p.(i+1) = [c,d] &
            ((a = c & |.d-b.| = 1) or
             (b = d & |.c-a.| = 1))) &
        p.1 = [1,1] &
        p.(3*n) = [(n qua Integer),1]}
  holds
    (n = 1 & card tours = 0) or
    (n <> 1 & card tours = (2 qua Nat) |^ (n -' 2))
proof
end;
::$P+
