:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_b6:
:: a nonempty set of positive integers whose positive difference set has
:: unbounded successive gaps has counting function of density zero. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL1, ORDINAL2, SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, INT_1,
    COMPLEX1, XXREAL_0, NAT_1, NAT_D, SEQ_2, SEQM_3, SEQ_4, BINOP_2,
    COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,B being Subset of NAT,
      N being Function of REAL,NAT,
      b being Function of NAT,NAT st
    A <> {} &
    (for a being Nat st a in A holds 0 < a) &
    (for x being Real holds
      N.x = card {a where a is Element of NAT :
        a in A & (a qua Real) <= x}) &
    B = {d where d is Element of NAT :
      0 < d &
      ex a,a9 being Element of NAT st
        a in A & a9 in A & d = a -' a9} &
    rng b = B &
    (for i being Nat holds b.i < b.(i + 1))
  holds
    ((for r being Nat holds
        ex i being Nat st r <= b.(i + 1) -' b.i)
      implies
        for epsilon being Real st 0 < epsilon holds
          ex C being Real st
            for x being Real st C <= x holds
              |.(N.x qua Real) / x.| < epsilon)
proof
end;
::$P+
