:: Statement-only formalization of PutnamBench corpus artifact putnam_2006_b5
:: (putnambench__mizar__putnam_2006_b5): the maximum over continuous real
:: functions on [0,1] of the integral of x^2*f(x) minus the integral of
:: x*(f(x))^2 is 1/16. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, NAT_1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, NEWTON, COMPLEX1,
      RCOMP_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
      INTEGRA5, SEQ_1, SEQ_2, SEQ_4, FCONT_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, XXREAL_0, XXREAL_1, XXREAL_3, NAT_1, NEWTON, COMPLEX1,
      RCOMP_1, VALUED_0, VALUED_1, SUPINF_2, MEASURE1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, SEQ_1,
      SEQ_4, PARTFUN2, FCONT_1;
 constructors RELSET_1, FUNCT_2, NAT_1, REAL_1, NEWTON, COMPLEX1,
      RCOMP_1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
      EXTREAL1, PARTFUN2, RFUNCT_2, FCONT_1, SEQ_2, SEQ_4;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XREAL_0, NAT_1, VALUED_0, VALUED_1,
      XXREAL_3, NEWTON, RCOMP_1, MEASURE1, MEASUR12, FCONT_1, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1, FCONT_1;

begin

::$P-
theorem
  ex I being Subset of REAL st
    I = {x where x is Real : 0 <= x & x <= 1} &
    (ex f,g,h being Function of REAL,REAL st
      (for x being Real st x in I holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for y being Real st
              y in I & x-delta < y & y < x+delta
            holds f.x-epsilon < f.y & f.y < f.x+epsilon) &
      (for x being Real holds g.x = (x |^ 2) * f.x) &
      (for x being Real holds h.x = x * (f.x |^ 2)) &
      Integral(L-Meas,g|I) - Integral(L-Meas,h|I)
        = (1 qua Real) / 16) &
    (for f,g,h being Function of REAL,REAL st
      (for x being Real st x in I holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for y being Real st
              y in I & x-delta < y & y < x+delta
            holds f.x-epsilon < f.y & f.y < f.x+epsilon) &
      (for x being Real holds g.x = (x |^ 2) * f.x) &
      (for x being Real holds h.x = x * (f.x |^ 2))
    holds
      Integral(L-Meas,g|I) - Integral(L-Meas,h|I)
        <= (1 qua Real) / 16)
proof
end;
::$P+
