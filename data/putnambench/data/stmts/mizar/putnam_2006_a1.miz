:: Statement-only formalization of PutnamBench corpus artifact putnam_2006_a1:
:: the three-dimensional Lebesgue volume of the region satisfying
:: (x^2+y^2+z^2+8)^2 <= 36(x^2+y^2) is 6*PI^2. This file contains no proof.

environ

 vocabularies MEASUR14, MEASUR13, FINSEQ_1, FINSEQ_2, NUMBERS, XXREAL_0,
      SUBSET_1, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, REAL_1, FUNCT_1,
      XBOOLE_0, TARSKI, ZFMISC_1, PROB_1, SUPINF_2, VALUED_0, PARTFUN1,
      MEASURE1, MEASURE5, MEASURE8, NAT_1, FUNCT_2, FUNCOP_1, CARD_3,
      FINSUB_1, SETFAM_1, PROB_2, XCMPLX_0, STRUCT_0, PRE_TOPC,
      RLVECT_1, RLTOPSP1, EUCLID, MEMBERED, SIN_COS, SQUARE_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, CARD_1,
      FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0,
      VALUED_0, EXTREAL1, NAT_1, FINSEQ_1, FINSEQ_2, STRUCT_0, PRE_TOPC,
      RLVECT_1, RLTOPSP1, EUCLID, SQUARE_1, SUPINF_2, PROB_1, PROB_2,
      MEASURE1,
      MEASURE3, MEASURE4, MEASURE5, MEASURE8, MEASUR12, MEASUR13,
      MEASUR14, SIN_COS;
 constructors EXTREAL1, SUPINF_1, DOMAIN_1, FINSEQOP, MEASURE3, PROB_3,
      MEASUR12, MEASUR13, MEASUR14, MEASURE8, EUCLID, RLTOPSP1, SIN_COS,
      RELSET_1, FUNCT_2, REAL_1, SQUARE_1;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, FINSEQ_1, FINSEQ_2, FUNCT_1,
      FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9, MEMBERED, SRINGS_4,
      SETFAM_1, MEASUR13, MEASUR14, GLIBPRE1, EUCLID, STRUCT_0,
      RLVECT_1, RLTOPSP1, XXREAL_3, SIN_COS, SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI;
 equalities FINSEQ_1, BINOP_1, SUBSET_1, MEASUR13, FINSEQ_2, XCMPLX_0,
      STRUCT_0, RLVECT_1, EUCLID, SQUARE_1;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for R being Subset of TOP-REAL 3 st
    R = {p where p is Element of REAL 3 :
      ((p.1)^2 + (p.2)^2 + (p.3)^2 + 8)^2 <=
        36 * ((p.1)^2 + (p.2)^2)}
  holds
    (C_Meas (XL-Meas 3)).R = ((6 * PI^2) qua ExtReal)
proof
end;
::$P+
