:: Statement-only formalization of PutnamBench artifact putnam_2002_a2:
:: among any five points on the unit sphere in real three-space, at least
:: four lie in a closed hemisphere. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, FUNCT_2, METRIC_1, NAT_1, NUMBERS,
      PRE_TOPC, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1, SQUARE_1, STRUCT_0,
      SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1, XBOOLE_0, XCMPLX_0,
      XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, COMPLEX1, XXREAL_0, NAT_1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, FUNCT_2, VALUED_0, FINSET_1, FINSEQ_1, FINSEQ_2, SQUARE_1,
      STRUCT_0, ALGSTR_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1, EUCLID,
      RVSUM_1, TOPMETR;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, STRUCT_0,
      RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, FINSET_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1, FINSET_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLTOPSP1;
 equalities STRUCT_0, FINSEQ_1, FINSEQ_2, RVSUM_1, SQUARE_1, EUCLID,
      VALUED_1;
 expansions TARSKI, XBOOLE_0, FUNCT_1, RVSUM_1;

begin

::$P-
theorem
  for S being finite Subset of TOP-REAL 3 st
    S c= {P where P is Point of TOP-REAL 3 : |.P.| = 1} &
    card S = 5
  holds
    ex V being Point of TOP-REAL 3 st
      |.V.| <> 0 &
      card (S /\ {P where P is Point of TOP-REAL 3 :
        0 <= |(P,V)|}) >= 4
proof
end;
::$P+
