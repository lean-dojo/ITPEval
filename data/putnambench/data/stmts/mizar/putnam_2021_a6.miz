:: Statement-only formalization of PutnamBench corpus artifact putnam_2021_a6
:: (putnambench__mizar__putnam_2021_a6): an integer polynomial with only
:: zero-one coefficients that factors into two nonconstant integer
:: polynomials has composite value at 2. This file contains no proof.

environ
  vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1,
    NAT_1, INT_1, INT_2, INT_3, POLYNOM1, VECTSP_1, SUBSET_1,
    POLYNOM2, XCMPLX_0, POLYNOM3, FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1,
    ALGSTR_0, ALGSEQ_1, FUNCT_1, FUNCT_2, SUPINF_2, NUMBERS, VALUED_0,
    VALUED_1, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1, CARD_3, BINOP_1,
    TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4, FINSEQ_2, VECTSP_2,
    ZFMISC_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, REAL_1, INT_1, INT_2, NAT_1, NAT_D, VALUED_0, FINSEQ_1,
    FINSEQ_2, FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
    VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, INT_3;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_D, INT_1, INT_2,
    ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
    VECTSP_2, ALGSTR_1, INT_3;
  registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
    CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
    RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, SUBSET_1,
    NAT_1, INT_1, INT_2, INT_3, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2,
    VECTSP_2, ALGSTR_1;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1, INT_2;
  equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
    ALGSTR_0;
  expansions TARSKI, ALGSEQ_1, POLYNOM5;
  theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3, POLYNOM4,
    POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0, INT_1, INT_2, INT_3;

begin

::$P-
theorem
  for P being Polynomial of INT.Ring st
    (for n being Nat holds
      P.n = 0.INT.Ring or P.n = 1.INT.Ring) &
    (ex Q,R being Polynomial of INT.Ring st
      len Q > 1 & len R > 1 & P = Q *' R)
  holds
    ex two being Element of INT.Ring, value being Integer st
      two = 2 &
      value = eval(P,two) &
      value <> 0 & value <> 1 & not value is prime
proof
end;
::$P+
