:: Statement-only formalization of PutnamBench corpus artifact putnam_1989_b2:
:: every nonempty cancellative semigroup whose positive powers of each element
:: form a finite set is a group; the answer is true. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, FINSET_1, STRUCT_0, ALGSTR_0, GROUP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, NAT_1, FINSET_1, STRUCT_0, ALGSTR_0,
    GROUP_1;
  constructors RELSET_1, FUNCT_2, NAT_1, FINSET_1, GROUP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    ORDINAL1, NAT_1, FINSET_1, STRUCT_0, GROUP_1;
  requirements SUBSET, BOOLE, NUMERALS;

begin

::$P-
theorem
  ((for S being non empty multMagma st
      (for x,y,z being Element of S holds
        (x * y) * z = x * (y * z)) &
      (for x,y,z being Element of S holds
        (x * y = x * z implies y = z) &
        (y * x = z * x implies y = z)) &
      for a being Element of S holds
        ex P being finite Subset of S st
          a in P &
          for x being Element of S st x in P holds a * x in P
    holds S is Group-like)
    iff (for t being set holds t = t))
proof
end;
::$P+
