:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_a2:
:: the differentiable real functions whose derivative equals every
:: positive-integer forward difference quotient are exactly the affine
:: functions. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0,
    SEQ_2, VALUED_1, FUNCT_2, COMPLEX1, NAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, NAT_1,
    RELSET_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1,
    PARTFUN2, RCOMP_1, FDIFF_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FDIFF_1, VALUED_1, XXREAL_2, COMPLEX1,
    RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0;
  expansions TARSKI;

begin

::$P-
theorem
  for f being Function of REAL,REAL holds
    ((f is_differentiable_on [#]REAL &
      (for x being Real, n being Nat st 0 < n holds
        diff(f,x) =
          (f.(x + (n qua Real)) - f.x) / (n qua Real)))
    iff
      ex c,d being Real st
        for x being Real holds f.x = c*x + d)
proof
end;
::$P+
