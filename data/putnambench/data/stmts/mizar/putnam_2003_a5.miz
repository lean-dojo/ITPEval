:: Statement-only formalization of PutnamBench corpus artifact putnam_2003_a5:
:: a one-to-one correspondence between Dyck n-paths with no even-length
:: return and Dyck (n-1)-paths. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, FINSEQ_1, FINSEQ_2, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, VALUED_0, VALUED_1, RVSUM_1, ABIAN, ARYTM_1,
    ARYTM_3, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, ABIAN;
  constructors REAL_1, NAT_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, ABIAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, ABIAN, MEMBERED,
    FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    {p where p is FinSequence of INT :
      len p = 2*n &
      (for k being Nat st k in Seg (2*n) holds
        p.k = -1 or p.k = 1) &
      Sum p = 0 &
      (for j being Nat st j in Seg (2*n) holds
        ex s being FinSequence of INT st
          len s = j &
          (for k being Nat st k in Seg j holds s.k = p.k) &
          Sum s >= 0) &
      not ex i,j being Nat st
        i in Seg (2*n) & j in Seg (2*n) & i < j &
        p.i = 1 &
        (for k being Nat st i < k & k <= j holds p.k = -1) &
        (j -' i) is even &
        ex s being FinSequence of INT st
          len s = j &
          (for k being Nat st k in Seg j holds s.k = p.k) &
          Sum s = 0},
    {q where q is FinSequence of INT :
      len q = 2*(n -' 1) &
      (for k being Nat st k in Seg (2*(n -' 1)) holds
        q.k = -1 or q.k = 1) &
      Sum q = 0 &
      (for j being Nat st j in Seg (2*(n -' 1)) holds
        ex s being FinSequence of INT st
          len s = j &
          (for k being Nat st k in Seg j holds s.k = q.k) &
          Sum s >= 0)}
    are_equipotent
proof
end;
::$P+
