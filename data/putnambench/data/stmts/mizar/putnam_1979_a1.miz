:: Statement-only formalization of PutnamBench corpus artifact putnam_1979_a1:
:: one 2 and 659 copies of 3 form a positive-integer multiset of sum 1979
:: whose product is greatest among all such multisets. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, REALSET1, VALUED_0,
    VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, FINSEQ_1,
    RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex solution being FinSequence of NAT st
    len solution = 660 &
    (for i being Nat st i in Seg 659 holds solution.i = 3) &
    solution.660 = 2 &
    len solution > 0 &
    (for i being Nat st i in dom solution holds solution.i > 0) &
    Sum solution = 1979 &
    (for a being FinSequence of NAT st
      len a > 0 &
      (for i being Nat st i in dom a holds a.i > 0) &
      Sum a = 1979
     holds Product solution >= Product a)
proof
end;
::$P+
