:: Statement-only formalization of PutnamBench corpus artifact putnam_1989_b4:
:: a countably infinite set has an uncountable family of nonempty subsets
:: whose pairwise intersections are finite. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, FINSET_1,
    ORDINAL1, CARD_1, CARD_3, NUMBERS, NAGATA_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, FINSET_1,
    ORDINAL1, CARD_1, CARD_3, NUMBERS;
  constructors SETFAM_1, FINSET_1, CARD_1, CARD_3;
  registrations XBOOLE_0, SUBSET_1, FINSET_1, ORDINAL1, CARD_1, CARD_3;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  ((ex C being Subset-Family of NAT st
      C is uncountable &
      (for R being Subset of NAT st R in C holds R <> {}) &
      (for A,B being Subset of NAT st
        A in C & B in C & A <> B
      holds A /\ B is finite))
    iff (for t being set holds t = t))
proof
end;
::$P+
