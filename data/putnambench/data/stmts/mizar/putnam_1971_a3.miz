:: Statement-only formalization of PutnamBench artifact putnam_1971_a3:
:: three distinct lattice points on a circle of positive radius have the
:: product of their pairwise distances at least twice the radius.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for xA,yA,xB,yB,xC,yC,R being Real st
    (ex iA,jA,iB,jB,iC,jC being Integer st
      xA = (iA qua Real) & yA = (jA qua Real) &
      xB = (iB qua Real) & yB = (jB qua Real) &
      xC = (iC qua Real) & yC = (jC qua Real)) &
    (xA <> xB or yA <> yB) &
    (xA <> xC or yA <> yC) &
    (xB <> xC or yB <> yC) &
    R > 0 &
    (ex xO,yO being Real st
      sqrt((xA-xO)^2 + (yA-yO)^2) = R &
      sqrt((xB-xO)^2 + (yB-yO)^2) = R &
      sqrt((xC-xO)^2 + (yC-yO)^2) = R)
  holds
    sqrt((xA-xB)^2 + (yA-yB)^2) *
      sqrt((xA-xC)^2 + (yA-yC)^2) *
      sqrt((xB-xC)^2 + (yB-yC)^2) >= 2 * R
proof
end;
::$P+
