:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_a6
:: (putnambench__mizar__putnam_2025_a6): for the integer sequence starting
:: at zero with b(n+1) = 2*b(n)^2 + b(n) + 1, the specified difference at
:: power-of-two indices has exact 2-adic divisibility. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, INT_2, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, NAT_1, INT_1, INT_2, NAT_D, NEWTON;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, INT_2, NAT_D,
    NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, INT_2, VALUED_0, VALUED_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for b being Function of NAT,INT, k being Nat st
    b.0 = 0 &
    (for n being Nat holds
      b.(n + 1) = 2 * ((b.n) |^ 2) + b.n + 1) &
    1 <= k
  holds
    ((2 qua Integer) |^ (2 * k + 2)) divides
      (b.(2 |^ (k + 1)) - 2 * b.(2 |^ k)) &
    not ((2 qua Integer) |^ (2 * k + 3)) divides
      (b.(2 |^ (k + 1)) - 2 * b.(2 |^ k))
proof
end;
::$P+
