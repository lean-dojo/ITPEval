:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_a1
:: (putnambench__mizar__putnam_2009_a1): every real-valued function on the
:: plane whose values sum to zero at the vertices of every nondegenerate
:: square is identically zero. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, ZFMISC_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NEWTON, NAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NEWTON, NAT_1, ZFMISC_1, XTUPLE_0, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of [:REAL,REAL:],REAL st
    (for x,y,u,v being Real st
      (u <> (0 qua Real) or v <> (0 qua Real)) holds
      ex a,b,c,d being Real st
        a = f.([x,y]) &
        b = f.([x+u,y+v]) &
        c = f.([x+u-v,y+v+u]) &
        d = f.([x-v,y+u]) &
        a + b + c + d = (0 qua Real))
  holds
    for x,y being Real holds f.([x,y]) = (0 qua Real)
proof
end;
::$P+
