:: Statement-only formalization of PutnamBench corpus artifact putnam_2001_b6
:: (putnambench__mizar__putnam_2001_b6): every positive strictly increasing
:: real sequence with a_n/n tending to zero has infinitely many positive
:: indices satisfying all the required strict midpoint inequalities. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, ORDINAL1,
    ORDINAL2, SEQ_4, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    COMSEQ_2, SEQM_3, SEQ_4, FINSET_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2, COMSEQ_2,
    FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, SEQ_4, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Real_Sequence st
    (for n being Nat st 1 <= n holds
      0 < a.n & a.n < a.(n + 1)) &
    (ex s being Real_Sequence st
      (for n being Nat holds
        s.n = a.(n + 1) / ((n + 1) qua Real)) &
      s is convergent & lim s = 0)
  holds
    {n where n is Element of NAT :
      0 < n &
      (for i being Nat st 1 <= i & i <= n - 1 holds
        a.(n - i) + a.(n + i) < 2 * a.n)} is infinite
proof
end;
::$P+
