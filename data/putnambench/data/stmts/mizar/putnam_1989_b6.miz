:: Statement-only formalization of PutnamBench corpus artifact putnam_1989_b6:
:: the expected right-endpoint Riemann sum over the uniformly distributed
:: ordered unit simplex is integration against a bounded degree-n polynomial.
:: This file contains no proof.

environ

 vocabularies MEASUR14, MEASUR13, FINSEQ_1, FINSEQ_2, FINSEQOP, RVSUM_1,
      NUMBERS, XXREAL_0, XXREAL_1, SUBSET_1, CARD_1, ARYTM_3, ARYTM_1,
      RELAT_1, REAL_1, FUNCT_1, FUNCT_2, XBOOLE_0, TARSKI, ZFMISC_1,
      PROB_1, SUPINF_2, VALUED_0, VALUED_1, PARTFUN1, MEASURE1,
      MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5, NAT_1, FUNCOP_1, CARD_3,
      FINSUB_1, SETFAM_1, PROB_2, XCMPLX_0, COMPLEX1, STRUCT_0,
      RLVECT_1, EUCLID, MEMBERED, ALGSTR_0, GROUP_1, VECTSP_1, VECTSP_2,
      ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM5, FUNCT_4,
      AFINSQ_1, BINOP_1, LATTICES, ORDINAL4;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, CARD_1,
      FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_1, XXREAL_3,
      XREAL_0, COMPLEX1, VALUED_0, VALUED_1, EXTREAL1, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSEQOP, RVSUM_1, STRUCT_0, ALGSTR_0, RLVECT_1,
      EUCLID, SUPINF_2, PROB_1, PROB_2, MEASURE1, MEASURE3, MEASURE4,
      MEASURE5, MEASUR12, MEASUR13, MEASUR14, MESFUNC1, MESFUNC5,
      MESFUNC6, INTEGRA5, VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3,
      POLYNOM4, POLYNOM5, FUNCT_7;
 constructors EXTREAL1, SUPINF_1, DOMAIN_1, FINSEQOP, RVSUM_1, MEASURE3,
      PROB_3, MEASUR12, MEASUR13, MEASUR14, MESFUNC1, MESFUNC5,
      MESFUNC6, INTEGRA5, EUCLID, ALGSEQ_1, POLYNOM4, POLYNOM5,
      FUNCT_7, FINSEQ_4, VECTSP_2, ALGSTR_1, BINOP_2, COMPLEX1;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, VALUED_1, RELSET_1, MEASURE1, FINSEQ_1,
      FINSEQ_2, FUNCT_1, FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9,
      MEMBERED, SRINGS_4, SETFAM_1, MEASUR13, MEASUR14, GLIBPRE1,
      EUCLID, STRUCT_0, RLVECT_1, XXREAL_3, VECTSP_1, VECTSP_2,
      ALGSTR_1, POLYNOM3, POLYNOM5, PRE_POLY;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities FINSEQ_1, FINSEQ_2, BINOP_1, SUBSET_1, MEASUR13, XCMPLX_0,
      STRUCT_0, ALGSTR_0, RLVECT_1, EUCLID, VECTSP_1, POLYNOM3,
      POLYNOM5;
 expansions TARSKI, XBOOLE_0, RELAT_1, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  for n being non zero Nat,
      X being Element of XL-Field n,
      I being Element of L-Field st
    X = {x where x is Element of REAL n :
      (for i being Nat st i in Seg n holds 0 < x.i & x.i < 1) &
      (for i being Nat st 1 <= i & i < n holds x.i < x.(i+1))} &
    I = {t where t is Real : 0 <= t & t <= 1}
  holds
    ex p being Polynomial of F_Real st
      len p = n + 1 &
      (for t being Element of F_Real st 0 <= t & t <= 1 holds
        0 <= eval(p,t) & eval(p,t) <= 1) &
      for f being Function of REAL,REAL st
        f.1 = 0 &
        (for t being Real st t in I holds
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st 0 < delta &
              for u being Real st
                u in I & |.(u-t).| < delta
              holds |.(f.u-f.t).| < epsilon)
      holds
        ex sumf being Function of REAL n,REAL,
           integrand being Function of REAL,REAL st
          (for x being Element of REAL n holds
            ex extended,terms being FinSequence of REAL st
              len extended = n + 2 &
              extended.1 = 0 &
              (for i being Nat st i in Seg n holds
                extended.(i+1) = x.i) &
              extended.(n+2) = 1 &
              len terms = n + 1 &
              (for k being Nat st k in Seg(n+1) holds
                terms.k =
                  (extended.(k+1) - extended.k) *
                    f.(extended.(k+1))) &
              sumf.x = Sum terms) &
          (for t being Element of F_Real holds
            integrand.t = f.t * eval(p,t)) &
          Integral(XL-Meas n,sumf|X) / (XL-Meas n).X =
            Integral(L-Meas,integrand|I)
proof
end;
::$P+
