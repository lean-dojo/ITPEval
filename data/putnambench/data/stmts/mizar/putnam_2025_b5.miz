:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_b5
:: (putnambench__mizar__putnam_2025_b5): a lower bound for the number of
:: descents among least positive modular inverses modulo a prime greater
:: than 3. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, NAT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, FINSET_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    FINSET_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2,
    RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, NAT_1, NAT_D, FINSEQ_1;
  constructors REAL_1, NAT_1, NAT_D, INT_1, INT_2, RELSET_1, FUNCT_2,
    FINSET_1, CARD_1, FINSEQ_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1,
    INT_2, ORDINAL1, CARD_1, FINSET_1, FINSEQ_1, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, FUNCT_2;

begin

::$P-
theorem
  for p being Nat,
      I being Function of Seg (p -' 1),NAT st
    p is prime &
    3 < p &
    (for k being Nat st k in Seg (p -' 1) holds
      ex a being Nat st
        a = I.k &
        a in Seg (p -' 1) &
        (k * a) mod p = 1)
  holds
    p div 4 c= card {k where k is Nat :
      k in Seg (p -' 2) &
      ex a,b being Nat st
        a = I.(k + 1) & b = I.k & a < b}
proof
end;
::$P+
