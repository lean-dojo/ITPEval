:: Statement-only formalization of PutnamBench artifact putnam_1974_b4:
:: every separately continuous real-valued function on the real plane is the
:: pointwise limit of a sequence of continuous real-valued functions on the
:: real plane. This file contains no proof.

environ
  vocabularies NUMBERS, REAL_1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0,
    SEQ_2, VALUED_1, FUNCT_2, FUNCOP_1, FUNCT_7, NAT_1, ZFMISC_1,
    BINOP_1, COMPLEX1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, ORDINAL1,
    RELAT_1, FUNCT_1, FUNCT_2, BINOP_1, NUMBERS, XREAL_0, XXREAL_0,
    XXREAL_2, XCMPLX_0, REAL_1, RELSET_1, VALUED_0, VALUED_1,
    SQUARE_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2, RCOMP_1,
    FCONT_1, FDIFF_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, SQUARE_1, RELSET_1, BINOP_2, COMSEQ_2, ZFMISC_1,
    XTUPLE_0;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0, SQUARE_1;
  expansions TARSKI;

begin

::$P-
theorem
  for f being Function of [:REAL,REAL:],REAL st
    (for y,x being Real,
         e being Real st 0 < e holds
      ex d being Real st 0 < d &
        for u being Real st |.u-x.| < d holds
          |.f.([u,y]) - f.([x,y]).| < e) &
    (for x,y being Real,
         e being Real st 0 < e holds
      ex d being Real st 0 < d &
        for v being Real st |.v-y.| < d holds
          |.f.([x,v]) - f.([x,y]).| < e)
  holds
    ex g being Function of NAT,Funcs([:REAL,REAL:],REAL) st
      (for n being Nat,
           gn being Function of [:REAL,REAL:],REAL st gn = g.n holds
        for
           x,y being Real,
           e being Real st 0 < e holds
        ex d being Real st 0 < d &
          for u,v being Real st
            |.u-x.| < d & |.v-y.| < d
          holds
            |.gn.([u,v]) - gn.([x,y]).| < e) &
      (for x,y being Real,
           e being Real st 0 < e holds
        ex N being Nat st
          for n being Nat,
              gn being Function of [:REAL,REAL:],REAL st
            N <= n & gn = g.n
          holds
            |.gn.([x,y]) - f.([x,y]).| < e)
proof
end;
::$P+
