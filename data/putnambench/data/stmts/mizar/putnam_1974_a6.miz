:: Statement-only formalization of PutnamBench artifact putnam_1974_a6:
:: the minimum degree of a monic integer polynomial whose value at every
:: integer is divisible by 10^6 is 25. This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      INT_1, INT_3, POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0,
      POLYNOM3, FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1,
      FUNCT_1, SUPINF_2, NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1,
      RLVECT_1, CARD_3, BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES,
      ORDINAL4, FINSEQ_2, VECTSP_2, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      INT_1, NAT_1, NAT_D, VALUED_0, FINSEQ_1, FINSEQ_2, FUNCT_7,
      STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2,
      ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, INT_3;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
      VECTSP_2, ALGSTR_1, INT_3, NAT_D;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      INT_1, INT_3, VALUED_0, FINSEQ_1, FINSEQ_2, VECTSP_2, ALGSTR_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;
 theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3, POLYNOM4,
      POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0, INT_1, INT_3;

begin

::$P-
theorem
  (ex f being Polynomial of INT.Ring st
    f.(len f -' 1) = 1.INT.Ring &
    len f = 26 &
    for x being Element of INT.Ring holds
      ex y being Integer st eval(f,x) = 1000000 * y) &
  (for f being Polynomial of INT.Ring st
    f.(len f -' 1) = 1.INT.Ring &
    (for x being Element of INT.Ring holds
      ex y being Integer st eval(f,x) = 1000000 * y)
  holds 26 <= len f)
proof
end;
::$P+
