:: Statement-only formalization of PutnamBench corpus artifact putnam_1991_b1:
:: the natural sequence that repeatedly adds the remainder after subtracting
:: the largest square not exceeding its current term is eventually constant
:: exactly for positive square initial values. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, XXREAL_0, NAT_1, NEWTON, NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, INT_1,
    XXREAL_0, NAT_1, NEWTON, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,S,a being Function of NAT,NAT, A being Nat st
    A > 0 &
    (for n being Nat holds
      (m.n |^ 2) <= n &
      (for r being Nat st (r |^ 2) <= n holds r <= m.n)) &
    (for n being Nat holds S.n = n -' (m.n |^ 2)) &
    a.0 = A &
    (for k being Nat holds a.(k + 1) = a.k + S.(a.k))
  holds
    ((ex K,c being Nat st
        for k being Nat st K <= k holds a.k = c)
      iff ex x being Nat st A = x |^ 2)
proof
end;
::$P+
