:: Statement-only formalization of PutnamBench corpus artifact putnam_2005_b4:
:: for positive integers m and n, the number of integer n-tuples whose sum
:: of absolute coordinate values is at most m is symmetric in m and n.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    RVSUM_1, FINSEQ_1, FINSEQ_2, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, VALUED_1, FINSEQOP, FINSEQ_2,
    RVSUM_1, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,n being Integer,
      f being Function of [:INT,INT:],NAT st
    0 < m & 0 < n &
    (for mp,np being Nat st 0 < mp & 0 < np holds
      f.[(mp qua Integer),(np qua Integer)] =
        card {p where p is FinSequence of INT :
          len p = np &
          ex absoluteValues being FinSequence of REAL st
            len absoluteValues = np &
            (for i being Nat st i in Seg np holds
              absoluteValues.i = |.p.i.|) &
            Sum absoluteValues <= mp})
  holds
    f.[m,n] = f.[n,m]
proof
end;
::$P+
