:: Statement-only formalization of PutnamBench artifact putnam_1971_a1:
:: among nine lattice points in three-dimensional Euclidean space, the open
:: segment between two distinct points contains a lattice point.
:: This file contains no proof.

environ
  vocabularies NUMBERS, SUBSET_1, REAL_1, RELAT_1, TARSKI, CARD_1,
    ARYTM_1, ARYTM_3, XXREAL_0, XXREAL_2, XBOOLE_0, RLTOPSP1,
    PRE_TOPC, EUCLID, METRIC_1, STRUCT_0, SQUARE_1, FINSET_1, ZFMISC_1,
    MCART_1, RECDEF_2, INT_1, XCMPLX_0, COMPLEX1;
  notations TARSKI, XBOOLE_0, SUBSET_1, XCMPLX_0, NUMBERS, XREAL_0,
    XXREAL_0, REAL_1, ORDINAL1, CARD_1, FINSET_1, ZFMISC_1, XTUPLE_0,
    METRIC_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, TOPREAL6,
    SQUARE_1, XXREAL_2, MCART_1, INT_1, COMPLEX1;
  constructors REAL_1, RLTOPSP1, EUCLID, TOPREAL6, SQUARE_1, XXREAL_2,
    FINSET_1, RELSET_1, ZFMISC_1, XTUPLE_0, MCART_1, INT_1, COMPLEX1;
  registrations XBOOLE_0, SUBSET_1, RELSET_1, XXREAL_0, XREAL_0,
    STRUCT_0, EUCLID, ORDINAL1, FINSET_1, NUMBERS, MEMBERED, INT_1,
    ZFMISC_1, XTUPLE_0, MCART_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for S being finite Subset of [:INT,INT,INT:] st
    card S = 9
  holds
    ex P,Q being Element of [:INT,INT,INT:],
       x,y,z being Integer,
       t being Real st
      P in S & Q in S & P <> Q &
      0 < t & t < 1 &
      (x qua Real) =
        t * (P`1_3 qua Real) + (1 - t) * (Q`1_3 qua Real) &
      (y qua Real) =
        t * (P`2_3 qua Real) + (1 - t) * (Q`2_3 qua Real) &
      (z qua Real) =
        t * (P`3_3 qua Real) + (1 - t) * (Q`3_3 qua Real)
proof
end;
::$P+
