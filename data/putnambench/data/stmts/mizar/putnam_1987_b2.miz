:: Statement-only formalization of PutnamBench artifact putnam_1987_b2:
:: a finite sum of ratios of binomial coefficients equals the stated
:: rational expression whenever r+s <= t. This file contains no proof.
::
:: Mizar finite sequences are one-indexed, so entry j represents the
:: published summand with index i = j-1. All divisions occur in REAL;
:: natural subtraction is used only where r+s <= t guarantees the intended
:: nonnegative differences.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, ORDINAL1, NEWTON, INT_1, ARYTM_1, ARYTM_3, CARD_3,
    VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for r,s,t being Nat st r + s <= t holds
    ex terms being FinSequence of REAL st
      len terms = s + 1 &
      (for j being Nat st j in Seg (s + 1) holds
        terms.j =
          ((s choose (j -' 1)) qua Real) /
          ((t choose (r + (j -' 1))) qua Real)) &
      Sum terms =
        ((t + 1) qua Real) /
        (((t + 1 -' s) qua Real) *
          ((t -' s choose r) qua Real))
proof
end;
::$P+
