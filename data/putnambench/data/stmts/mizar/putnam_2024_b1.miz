:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_b1
:: (putnambench__mizar__putnam_2024_b1): the positive grid sizes and offsets
:: admitting a nonattacking selection whose integer entries are exactly 1
:: through n are precisely (2*l+1,l+1) for natural l. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2,
    FINSET_1;
  constructors RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_4, NAT_1, NAT_D,
    INT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, VALUED_0, VALUED_1,
    FINSET_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for n,k being Nat holds
    (0 < n &
     0 < k &
     ex f being Function of Seg n,NAT st
       rng f c= Seg n &
       f is one-to-one &
       {z where z is Integer :
         ex i,j being Nat st
           i in Seg n &
           j = f.i &
           z = (i qua Integer) + (j qua Integer) - (k qua Integer)}
       =
       {z where z is Integer :
         1 <= z & z <= (n qua Integer)})
    iff
    ex l being Nat st
      n = 2*l + 1 & k = l + 1
proof
end;
::$P+
