:: Statement-only formalization of PutnamBench corpus artifact putnam_2000_a5:
:: three distinct lattice points on a circle of positive radius include two
:: whose Euclidean distance is at least the real cube root of the radius.
:: This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, FUNCT_2, INT_1, METRIC_1, NAT_1,
      NUMBERS, POWER, PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1,
      SQUARE_1, STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1,
      XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, XXREAL_0, INT_1, NAT_1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2,
      FINSET_1, SQUARE_1, STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1,
      EUCLID, RVSUM_1, TOPMETR, TOPREAL6, POWER;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, INT_1,
      RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2, FINSET_1, FINSEQOP, MONOID_0,
      METRIC_1, RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, TOPREAL6, POWER;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, INT_1,
      NAT_1, CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, FINSET_1, STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID,
      TOPMETR, BINOP_2, MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  for r being Real holds
  for z being Point of TOP-REAL 2 holds
  for S being finite Subset of TOP-REAL 2 st
    r > 0 &
    card S = 3 &
    (for p being Point of TOP-REAL 2 st p in S holds
      p.1 in INT & p.2 in INT) &
    (for p being Point of TOP-REAL 2 st p in S holds
      dist(p,z) = r)
  holds
    ex p,q being Point of TOP-REAL 2 st
      p in S & q in S & p <> q &
      dist(p,q) >= r to_power ((1 qua Real) / 3)
proof
end;
::$P+
