:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_b6:
:: every positive integer is the last term of a length-2010 integer sequence
:: generated from earlier terms by adding a nonnegative power of two or by
:: taking the remainder of two earlier positive terms. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, NAT_1, INT_1, NEWTON, NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, NAT_1,
    INT_1, NEWTON, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Integer st n > 0 holds
    ex a being Function of NAT,INT st
      a.0 = 0 &
      a.2009 = n &
      for i being Nat st 1 <= i & i <= 2009 holds
        (ex j,k being Nat st
          j < i & a.i = a.j + ((2 qua Integer) |^ k)) or
        (ex b,c being Nat st
          b < i & c < i &
          a.b > 0 & a.c > 0 &
          a.i = (a.b) mod (a.c))
proof
end;
::$P+
