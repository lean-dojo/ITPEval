:: Statement-only formalization of PutnamBench artifact putnam_1965_b5:
:: if 4E <= V^2, there is a simple undirected graph on V vertices with
:: exactly E edges and no triangle. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FINSET_1,
      CARD_1, NUMBERS, NAT_1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
      ARYTM_3, NEWTON;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
      RELSET_1, FINSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      NAT_1, NAT_D, CARD_1, NEWTON;
  constructors RELAT_1, RELSET_1, FINSET_1, XTUPLE_0, XXREAL_0, NAT_1,
      NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FINSET_1, ORDINAL1,
      CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, MEMBERED,
      NEWTON;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for E,V being Nat, X being finite set st
    V = card X & 4 * E <= V |^ 2
  holds ex G being finite Relation of X st
    (for x being Element of X holds not [x,x] in G) &
    (for x,y being Element of X holds
      ([x,y] in G iff [y,x] in G)) &
    card G = 2 * E &
    not ex a,b,c being Element of X st
      [a,b] in G & [b,c] in G & [c,a] in G
proof
end;
::$P+
