:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_a5
:: (putnambench__mizar__putnam_2024_a5): for random endpoints on the circle
:: of radius 9, the disk-center parameter in [0,8] minimizing the probability
:: that the joining line meets the unit circle is exactly r = 0. This file
:: contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, CARD_3, CLASSES1,
      COMPLEX1, CONVEX1, EUCLID, EUCLID_9, FINSEQ_1, FINSEQ_2, FINSEQ_4,
      FINSET_1, FUNCOP_1, FUNCSDOM, FUNCT_1, FUNCT_2, INT_1, LMOD_7, MATRIX_1,
      MATRIX_3, MATRIX13, MATRLIN, MATRLIN2, MESFUNC1, METRIC_1, MONOID_0,
      NAT_1, NUMBERS, ORDINAL2, ORDINAL4, PARTFUN1, PCOMPS_1, PRE_TOPC,
      PROB_1, PRVECT_1, QC_LANG1, RCOMP_1, REAL_1, RELAT_1, RFINSEQ,
      RLAFFIN1, RLSUB_1, RLTOPSP1, RLVECT_1, RLVECT_2, RLVECT_3, RLVECT_5,
      RUSUB_4, SEMI_AF1, SETFAM_1, SIN_COS, SQUARE_1, STRUCT_0, SUBSET_1,
      SUPINF_2, TARSKI, TBSP_1, TOPMETR, TOPS_1, TOPS_2, VALUED_0, VALUED_1,
      VECTSP_1, XBOOLE_0, XCMPLX_0, XXREAL_0, XXREAL_1, ZFMISC_1, FINSUB_1,
      MEASUR13, MEASUR14, MEASURE1, MEASURE5, MEASURE8, MEMBERED, PROB_2;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, CARD_1, XREAL_0, REAL_1, INT_1, FINSET_1, DOMAIN_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FUNCOP_1,
      STRUCT_0, FINSEQ_2, FINSEQOP, RVSUM_1, RLVECT_1, RLVECT_2, RUSUB_4,
      CONVEX1, RLAFFIN1, COMPLEX1, VALUED_0, METRIC_1, PRE_TOPC, PCOMPS_1,
      TBSP_1, ALGSTR_0, FUNCSDOM, TOPS_2, RLTOPSP1, EUCLID, VFUNCT_1,
      FVSUM_1, RLSUB_1, RLVECT_3, RLVECT_5, CARD_3, RCOMP_1, EUCLID_9,
      VECTSP_1, MATRIX_0, MATRIX_1, NAT_D, MATRIX_3, MATRIX_6, VECTSP_6,
      VECTSP_7, MATRIX13, MATRLIN, RLSUB_2, RFINSEQ, TOPMETR, RLAFFIN2,
      SETFAM_1, PRVECT_1, TOPREAL6, TOPREAL9, MATRTOP1, SIN_COS, SQUARE_1,
      EXTREAL1, FINSUB_1, MEASUR12, MEASUR13, MEASUR14, MEASURE1, MEASURE3,
      MEASURE4, MEASURE5, MEASURE8, NAT_1, PROB_1, PROB_2, SUPINF_2,
      XXREAL_3;
 constructors BINOP_2, CONVEX1, EUCLID_9, FUNCSDOM, FVSUM_1, MATRIX_6,
      MATRIX13, MATRTOP1, MONOID_0, NAT_D, RANKNULL, RCOMP_1, REAL_1,
      REALSET1, RFINSEQ, RLAFFIN1, RLAFFIN2, RLSUB_2, RLVECT_3, RLVECT_5,
      RUSUB_5, SIN_COS, TBSP_1, TOPMETR, TOPREAL6, TOPREAL9, TOPS_2,
      VECTSP_7, VFUNCT_1, WELLORD2, MATRIX_1, SQUARE_1, DOMAIN_1, EXTREAL1,
      FINSEQOP, MEASUR12, MEASUR13, MEASUR14, MEASURE3, MEASURE8, METRIC_1,
      PROB_3, RLTOPSP1, SUPINF_1, XTUPLE_0;
 registrations CARD_1, EUCLID, EUCLID_7, EUCLID_9, FINSEQ_1, FINSEQ_2,
      FINSET_1, FUNCT_1, JORDAN2B, MATRIX13, MATRTOP1, MONOID_0, NAT_1,
      NUMBERS, PRE_TOPC, PRVECT_1, RELSET_1, RLAFFIN1, RLTOPSP1, RLVECT_5,
      RVSUM_1, SIN_COS, STRUCT_0, SUBSET_1, TBSP_1, TOPMETR, TOPREAL1,
      TOPS_1, VALUED_0, VECTSP_1, VECTSP_9, XBOOLE_0, XREAL_0, XXREAL_0,
      ORDINAL1, INT_1, SQUARE_1, CARD_3, CONVEX1, FUNCOP_1, FUNCT_2,
      GLIBPRE1, MEASUR13, MEASUR14, MEASURE1, MEASURE9, MEMBERED, RELAT_1,
      RLVECT_1, SETFAM_1, SRINGS_4, XXREAL_3, XTUPLE_0;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions RLTOPSP1, TARSKI, TBSP_1, XBOOLE_0;
 equalities FINSEQ_1, MATRIX13, MATRTOP1, STRUCT_0, SUBSET_1, BINOP_1,
      EUCLID, FINSEQ_2, MEASUR13, RLVECT_1, XCMPLX_0;
 expansions FINSEQ_1, STRUCT_0, TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for IsIntersecting being Subset of
        [:REAL,the carrier of TOP-REAL 2,the carrier of TOP-REAL 2:],
      ProbIntersect being Function of REAL,ExtREAL st
    (for r being Real, P,Q being Point of TOP-REAL 2 holds
      ([r,P,Q] in IsIntersecting iff
        ex u being Real st
          ((1-u)*P.1 + u*Q.1 - r)^2 +
            ((1-u)*P.2 + u*Q.2)^2 = 1)) &
    (for r being Real holds
      ProbIntersect.r =
        (C_Meas (XL-Meas 2)).
          {p where p is Point of TOP-REAL 2 :
            0 <= p.1 & p.1 <= 1 & 0 <= p.2 & p.2 <= 1 &
            ex P,Q being Point of TOP-REAL 2 st
              P.1 = 9*cos(2*PI*p.1) &
              P.2 = 9*sin(2*PI*p.1) &
              Q.1 = 9*cos(2*PI*p.2) &
              Q.2 = 9*sin(2*PI*p.2) &
              [r,P,Q] in IsIntersecting})
  holds
    for r being Real holds
      (0 <= r & r <= 8 &
        (for x being Real st 0 <= x & x <= 8 holds
          ProbIntersect.r <= ProbIntersect.x)
      iff r = 0)
proof
end;
::$P+
