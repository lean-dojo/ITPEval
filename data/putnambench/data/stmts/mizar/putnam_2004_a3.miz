:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_a3:
:: every term of the real sequence with first three terms one and consecutive
:: two-by-two determinants equal to n factorial is an integer. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for u being Function of NAT,REAL st
    u.0 = 1 &
    u.1 = 1 &
    u.2 = 1 &
    (for n being Nat holds
      u.n * u.(n + 3) - u.(n + 1) * u.(n + 2) = ((n !) qua Real))
  holds
    for n being Nat holds
      ex m being Integer st u.n = (m qua Real)
proof
end;
::$P+
