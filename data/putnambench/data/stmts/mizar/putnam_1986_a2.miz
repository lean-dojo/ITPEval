:: Statement-only formalization of PutnamBench corpus artifact putnam_1986_a2:
:: the units digit of the floor of 10^20000 divided by 10^100 + 3 is 3.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ((((10 qua Nat) |^ 20000) div (((10 qua Nat) |^ 100) + 3)) mod 10) = 3
proof
end;
::$P+
