:: Statement-only formalization of PutnamBench corpus artifact putnam_2002_a3:
:: the number of nonempty subsets of {1,...,n} with integer arithmetic mean
:: has the same parity as n. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3,
    INT_1, INT_2, CARD_3, MEMBERED;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, RVSUM_1,
    MEMBERED, NAT_1, NAT_D, FINSET_1;
  constructors REAL_1, NAT_D, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP, FINSET_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1,
    CARD_1, MEMBERED, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,Tn being Nat st
    2 <= n &
    Tn = card {S where S is Subset of Seg n :
      S <> {} &
      ex k being Nat st Sum Sgm S = card S * k}
  holds Tn mod 2 = n mod 2
proof
end;
::$P+
