:: Statement-only formalization of PutnamBench corpus artifact putnam_2018_a6
:: (putnambench__mizar__putnam_2018_a6): four points in general position in
:: the real Euclidean plane whose six squared pairwise distances are rational
:: have a rational ratio of the areas of triangles ABC and ABD.
:: This file contains no proof.

environ

 vocabularies MEASUR14, MEASUR13, FINSEQ_1, FINSEQ_2, NUMBERS, XXREAL_0,
      SUBSET_1, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, REAL_1, FUNCT_1,
      XBOOLE_0, TARSKI, ZFMISC_1, PROB_1, SUPINF_2, VALUED_0, PARTFUN1,
      MEASURE1, MEASURE5, MEASURE8, NAT_1, FUNCT_2, FUNCOP_1, CARD_3,
      FINSUB_1, SETFAM_1, PROB_2, XCMPLX_0, STRUCT_0, PRE_TOPC, RLVECT_1,
      RLTOPSP1, EUCLID, CONVEX1, MEMBERED, METRIC_1, SQUARE_1, RLAFFIN1,
      PCOMPS_1, TBSP_1, TOPMETR, TOPS_1, TOPS_2, RAT_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, ENUMSET1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, CARD_1,
      FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0,
      VALUED_0, EXTREAL1, NAT_1, FINSEQ_1, FINSEQ_2, STRUCT_0, METRIC_1,
      PRE_TOPC, PCOMPS_1, TBSP_1, TOPS_2, TOPMETR, RLVECT_1, RLTOPSP1,
      EUCLID, SUPINF_2, PROB_1, PROB_2, MEASURE1, MEASURE3, MEASURE4,
      MEASURE5, MEASURE8, MEASUR12, MEASUR13, MEASUR14, CONVEX1,
      TOPREAL6, SQUARE_1, RLAFFIN1, RAT_1;
 constructors ENUMSET1, EXTREAL1, SUPINF_1, DOMAIN_1, FINSEQOP, MEASURE3,
      PROB_3,
      MEASUR12, MEASUR13, MEASUR14, MEASURE8, METRIC_1, EUCLID, RLTOPSP1,
      CONVEX1, TOPREAL6, SQUARE_1, RLAFFIN1, PCOMPS_1, TBSP_1, TOPMETR,
      TOPS_1, TOPS_2, RAT_1;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, FINSEQ_1, FINSEQ_2, FUNCT_1,
      FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9, MEMBERED, SRINGS_4,
      SETFAM_1, MEASUR13, MEASUR14, GLIBPRE1, EUCLID, STRUCT_0, RLVECT_1,
      RLTOPSP1, CONVEX1, XXREAL_3, SQUARE_1, RLAFFIN1, PRE_TOPC, TBSP_1,
      TOPMETR, TOPS_1, RAT_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions RLTOPSP1, TARSKI, TBSP_1, XBOOLE_0;
 equalities FINSEQ_1, BINOP_1, SUBSET_1, MEASUR13, FINSEQ_2, XCMPLX_0,
      STRUCT_0, RLVECT_1, EUCLID;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for A,B,C,D being Point of TOP-REAL 2 st
    not (ex L being line of TOP-REAL 2 st A in L & B in L & C in L) &
    not (ex L being line of TOP-REAL 2 st A in L & B in L & D in L) &
    not (ex L being line of TOP-REAL 2 st A in L & C in L & D in L) &
    not (ex L being line of TOP-REAL 2 st B in L & C in L & D in L) &
    A <> B & A <> C & A <> D & B <> C & B <> D & C <> D &
    (dist(A,B))^2 in RAT &
    (dist(A,C))^2 in RAT &
    (dist(A,D))^2 in RAT &
    (dist(B,C))^2 in RAT &
    (dist(B,D))^2 in RAT &
    (dist(C,D))^2 in RAT
  holds
    ex T,U being Subset of TOP-REAL 2, q being Rational st
      T = {A,B,C} &
      U = {A,B,D} &
      (C_Meas (XL-Meas 2)).(conv T) /
        (C_Meas (XL-Meas 2)).(conv U) = (q qua ExtReal)
proof
end;
::$P+
