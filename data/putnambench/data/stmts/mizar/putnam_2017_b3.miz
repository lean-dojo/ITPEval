:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_b3:
:: a real power series with all coefficients zero or one and value 3/2 at
:: 2/3 has an irrational value at 1/2. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1, SEQ_2,
    ORDINAL2, SEQ_4, SERIES_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PREPOWER, SERIES_1, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, BINOP_2,
    COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, SEQ_4,
    RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for c,s23,s12 being Real_Sequence st
    (for n being Nat holds c.n = 0 or c.n = 1) &
    (for n being Nat holds
      s23.n = c.n * (((2 qua Real) / 3) |^ n)) &
    (for n being Nat holds
      s12.n = c.n * (((1 qua Real) / 2) |^ n))
  holds
    (Partial_Sums(s23) is convergent &
      lim Partial_Sums(s23) = (3 qua Real) / 2)
    implies
      Partial_Sums(s12) is convergent &
      not (lim Partial_Sums(s12) in RAT)
proof
end;
::$P+
