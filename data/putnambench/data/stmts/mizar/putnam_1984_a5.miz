:: Statement-only formalization of PutnamBench corpus artifact putnam_1984_a5:
:: the triple integral of x*y^9*z^8*(1-x-y-z)^4 over the nonnegative
:: simplex x+y+z <= 1 equals 1!*9!*8!*4!/25!. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, REALSET1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    NEWTON, PREPOWER, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
    INTEGRA5, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON, PREPOWER,
    NAT_D, VALUED_0, VALUED_1, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NAT_D, NEWTON, PREPOWER, SIN_COS, MESFUNC1, MESFUNC5,
    MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for value being Real st
    ex I being Subset of REAL,
       outer being Function of REAL,REAL st
      I = {x where x is Real : 0 <= x & x <= 1} &
      (for z being Real st z in I holds
        ex J being Subset of REAL,
           middle being Function of REAL,REAL st
          J = {y where y is Real : 0 <= y & y <= 1-z} &
          (for y being Real st y in J holds
            ex K being Subset of REAL,
               inner being Function of REAL,REAL st
              K = {x where x is Real : 0 <= x & x <= 1-y-z} &
              (for x being Real st x in K holds
                inner.x =
                  x * (y |^ 9) * (z |^ 8) *
                    ((1-x-y-z) |^ 4)) &
              middle.y = Integral(L-Meas,inner|K)) &
          outer.z = Integral(L-Meas,middle|J)) &
      value = Integral(L-Meas,outer|I)
  holds
    value =
      (((1!) qua Real) * ((9!) qua Real) *
        ((8!) qua Real) * ((4!) qua Real)) /
      ((25!) qua Real)
proof
end;
::$P+
