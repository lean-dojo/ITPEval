:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_a1:
:: a multiplicatively closed set of reals partitioned into two disjoint
:: triple-product-closed subsets has at least one multiplicatively closed part.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S,T,U being Subset of REAL st
    (for a,b being Real st a in S & b in S
      holds a * b in S) &
    T c= S &
    U c= S &
    T \/ U = S &
    T /\ U = {} &
    (for a,b,c being Real st a in T & b in T & c in T
      holds a * b * c in T) &
    (for a,b,c being Real st a in U & b in U & c in U
      holds a * b * c in U)
  holds
    (for a,b being Real st a in T & b in T
      holds a * b in T) or
    (for a,b being Real st a in U & b in U
      holds a * b in U)
proof
end;
::$P+
