:: Statement-only formalization of PutnamBench corpus artifact putnam_2007_a3:
:: the probability that no prefix sum of a random ordering of the integers
:: from 1 through 3k+1 is divisible by 3 has the stated factorial form for
:: every positive integer k. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, NUMBERS,
    NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1,
    FINSET_1, NEWTON, REALSET1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, RVSUM_1, REAL_1, INT_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2,
    MATRIX_0, MATRIX_1, FINSET_1, NEWTON, RVSUM_1, REAL_1;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    NEWTON, RVSUM_1, FINSEQOP, FINSET_1, REAL_1, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2,
    NEWTON, VALUED_0, VALUED_1, RVSUM_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1, MATRIX_0;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for k being Nat,
      perms,goodperms being finite set st
    0 < k &
    perms = Permutations(3 * k + 1) &
    goodperms =
      {p where p is Permutation of Seg (3 * k + 1) :
        for j being Nat st j in Seg (3 * k + 1) holds
          ex partial being FinSequence of NAT st
            len partial = j &
            (for i being Nat st i in Seg j holds partial.i = p.i) &
            not ex q being Nat st Sum partial = 3 * q}
  holds
    (card goodperms qua Real) =
      (card perms qua Real) *
        (((k !) qua Real) * (((k + 1) !) qua Real) /
          (((3 * k + 1) qua Real) * (((2 * k) !) qua Real)))
proof
end;
::$P+
