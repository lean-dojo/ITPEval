:: Statement-only formalization of PutnamBench corpus artifact putnam_2006_b2:
:: every finite set of n real numbers, with n positive, has a nonempty subset
:: whose sum is within 1/(n+1) of an integer. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_0,
    VALUED_1, CARD_1, CARD_3, RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1,
    FUNCT_2, TARSKI, XREAL_0, XXREAL_0, ORDINAL1, ORDINAL4, BINOP_1,
    BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1, FINSEQOP, ZFMISC_1,
    XCMPLX_0, SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1, INT_1, PARTFUN1,
    COMPLEX1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, RELAT_1,
    FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1, FUNCOP_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, INT_1, FINSOP_1,
    FINSEQOP, SETWOP_2, RVSUM_1, COMPLEX1;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, BINOP_2, VALUED_1,
    FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1, XXREAL_1,
    REAL_1, FINSEQ_2, RVSUM_1, INT_1, COMPLEX1;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1,
    RVSUM_1, RELSET_1, MEMBERED, INT_1, COMPLEX1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      X being one-to-one FinSequence of REAL st
    0 < n &
    len X = n
  holds
    ex S being one-to-one FinSequence of REAL st
      0 < len S &
      rng S c= rng X &
      ex m being Integer st
        |.((m qua Real) + Sum S).| <=
          1 / ((n + 1) qua Real)
proof
end;
::$P+
