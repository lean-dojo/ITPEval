:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_b2
:: (putnambench__mizar__putnam_2025_b2): for a continuous, strictly increasing,
:: nonnegative real function on [0,1], the centroid ratio weighted by the
:: function is strictly less than the ratio weighted by its square. This file
:: contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
      XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1, VALUED_0,
      VALUED_1, ORDINAL1, ORDINAL2, SEQ_1, SEQ_2, SEQ_4, FDIFF_1,
      FDIFF_12, RCOMP_1, FCONT_1, SUPINF_2, MEASURE1, MEASURE5,
      MESFUNC1, MESFUNC5, MEASUR12, INTEGRA1, INTEGRA5, INTEGRA7;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, INT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_2, XXREAL_3,
      NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
      SEQ_4, PARTFUN2, RCOMP_1, FCONT_1, FDIFF_1, SUPINF_2, MEASURE1,
      MEASURE5, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA1,
      INTEGRA5, INTEGRA7, EXTREAL1, FDIFF_12;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      INT_1, XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, COMSEQ_2,
      PARTFUN2, RCOMP_1, RFUNCT_2, FCONT_1, FDIFF_1, FDIFF_12,
      MEASURE5, MEASURE6, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12,
      INTEGRA2, INTEGRA5, INTEGRA7, EXTREAL1, BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, SEQ_4,
      RCOMP_1, FCONT_1, FDIFF_1, XXREAL_3, MEASURE1, MEASURE5,
      MEASUR12, INTEGRA1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities INTEGRA5;
 expansions TARSKI, XBOOLE_0, RELAT_1, FCONT_1;

begin

::$P-
theorem
  for I being non empty Interval,
      f,xf,f2,xf2 being Function of REAL,REAL st
    I = ['0,1'] &
    f|I is continuous &
    (for x,y being Real st x in I & y in I & x < y holds f.x < f.y) &
    (for x being Real st x in I holds 0 <= f.x) &
    (for x being Real holds
      xf.x = x * f.x &
      f2.x = f.x * f.x &
      xf2.x = x * (f.x * f.x))
  holds
    integral(xf,0,1) / integral(f,0,1) <
      integral(xf2,0,1) / integral(f2,0,1)
proof
end;
::$P+
