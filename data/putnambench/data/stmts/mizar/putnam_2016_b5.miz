:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_b5
:: (putnambench__mizar__putnam_2016_b5): classification of functions from
:: (1,+infinity) to itself preserving the specified square-to-cube comparison
:: intervals as positive real power functions. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, CARD_1,
    XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0, SEQ_2,
    VALUED_1, FUNCT_2, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    COMPLEX1, POWER;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, PARTFUN2,
    RFUNCT_2, VALUED_1, XXREAL_2, COMPLEX1, RELSET_1, BINOP_2,
    COMSEQ_2, POWER;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of REAL,REAL holds
    (((for x being Real st 1 < x holds 1 < f.x) &
      (for x,y being Real st
        1 < x & 1 < y & x*x <= y & y <= x*x*x
      holds
        f.x*f.x <= f.y & f.y <= f.x*f.x*f.x))
    iff
      ex c being Real st
        0 < c &
        for x being Real st 1 < x holds
          f.x = x to_power c)
proof
end;
::$P+
