:: Statement-only formalization of PutnamBench artifact putnam_1966_b2:
:: among any ten consecutive positive integers, one is relatively prime to
:: every other integer in that block. This file contains no proof.

environ
  vocabularies NUMBERS, INT_1, INT_2, ORDINAL1, SUBSET_1, CARD_1,
    ARYTM_1, ARYTM_3, XCMPLX_0, XXREAL_0, COMPLEX1;
  notations ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, INT_1, INT_2;
  constructors XXREAL_0, REAL_1, INT_1, INT_2;
  registrations XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, ARITHM;

begin

::$P-
theorem
  for n being Integer st 0 < n holds
    ex k being Integer st
      n <= k & k <= n + 9 &
      for m being Integer st
        n <= m & m <= n + 9 & k <> m
      holds m,k are_coprime
proof
end;
::$P+
