:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_b4
:: (putnambench__mizar__putnam_2023_b4): the least nonnegative time at which
:: an admissible piecewise twice differentiable real function reaches 2023
:: is 29. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1,
    ORDINAL1, RCOMP_1, FDIFF_1, FCONT_1, SEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, NAT_1, VALUED_0, VALUED_1,
    SEQ_1, RCOMP_1, FCONT_1, FDIFF_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, SEQ_1, RCOMP_1, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1,
    BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, RCOMP_1, FCONT_1, FDIFF_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities XCMPLX_0, VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for attainable being Subset of REAL st
    (for T being Real holds
      T in attainable iff
        0 <= T &
        ex n being Nat,
           ts being Real_Sequence,
           I being Subset of REAL,
           f,d1,d2 being Function of REAL,REAL st
          (for x being Real holds
            x in I iff
              x > ts.0 &
              for i being Nat st 1 <= i & i <= n holds x <> ts.i) &
          (for k being Nat st k < n holds
            ts.(k+1) >= ts.k + 1) &
          (for x,epsilon being Real st
            ts.0 <= x & 0 < epsilon holds
              ex delta being Real st
                0 < delta &
                for y being Real st
                  ts.0 <= y & |.y-x.| < delta
                holds |.f.y-f.x.| < epsilon) &
          (for x being Real st x in I holds
            f is_differentiable_in x &
            d1.x = diff(f,x) &
            d1 is_differentiable_in x &
            d2.x = diff(d1,x)) &
          (for x being Real st not x in I holds
            d1.x = 0 & d2.x = 0) &
          f.(ts.0) = (1 qua Real) / 2 &
          (for k being Nat st k <= n holds
            for epsilon being Real st 0 < epsilon holds
              ex delta being Real st
                0 < delta &
                for x being Real st
                  ts.k < x & x < ts.k + delta
                holds |.d1.x.| < epsilon) &
          (for k being Nat st k < n holds
            for x being Real st ts.k < x & x < ts.(k+1) holds
              d2.x = (k+1 qua Real)) &
          (for x being Real st ts.n < x holds
            d2.x = (n+1 qua Real)) &
          f.(ts.0 + T) = 2023)
  holds
    29 in attainable &
    for T being Real st T in attainable holds 29 <= T
proof
end;
::$P+
