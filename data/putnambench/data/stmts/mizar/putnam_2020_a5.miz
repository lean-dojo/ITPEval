:: Statement-only formalization of PutnamBench corpus artifact putnam_2020_a5
:: (putnambench__mizar__putnam_2020_a5): the largest integer having exactly
:: 2020 representations as a sum of distinct positive-index Fibonacci numbers
:: is the 4040th Fibonacci number minus one. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, INT_1,
    CARD_1, CARD_3, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1,
    PRE_FF, ARYTM_1, ARYTM_3, MEMBERED, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, RVSUM_1,
    MEMBERED, NAT_1, NAT_D, FINSET_1, PRE_FF;
  constructors REAL_1, NAT_D, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP, FINSET_1, CARD_1, PRE_FF;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1,
    CARD_1, MEMBERED, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of INT,NAT st
    (for n being Integer holds
      a.n = card {S where S is finite Subset of NAT :
        (for k being Nat st k in S holds 0 < k) &
        ex terms being FinSequence of NAT st
          len terms = len Sgm S &
          (for i being Nat st i in dom terms holds
            terms.i = Fib ((Sgm S).i)) &
          Sum terms = n})
  holds
    a.((Fib 4040 qua Integer) - 1) = 2020 &
    (for n being Integer st a.n = 2020 holds
      n <= (Fib 4040 qua Integer) - 1)
proof
end;
::$P+
