:: Statement-only formalization of PutnamBench corpus artifact putnam_1979_b2:
:: for positive a<b, the punctured limit at zero of the reciprocal-t power
:: of the integral of (b*x+a*(1-x))^t on [0,1] has the stated exponential
:: and logarithmic value. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    ORDINAL1, NEWTON, PREPOWER, POWER, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MEASUR12, INTEGRA5, SIN_COS, TAYLOR_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3,
    NEWTON, PREPOWER, POWER, VALUED_0, VALUED_1, SIN_COS, SUPINF_2,
    MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, TAYLOR_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NEWTON, PREPOWER, POWER, SIN_COS,
    MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1,
    BINOP_2, TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, POWER, XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for a,b being Real,
      I being Subset of REAL,
      F being Function of REAL,REAL st
    0 < a & a < b &
    (for x being Real holds
      (x in I iff 0 <= x & x <= 1)) &
    (for t being Real holds
      ex g being Function of REAL,REAL st
        (for x being Real st x in I holds
          g.x = exp_R.(t * ln.(b*x + a*(1-x)))) &
        F.t = exp_R.((1/t) * ln.(Integral(L-Meas,g|I))))
  holds
    for e being Real st 0 < e holds
      ex d being Real st 0 < d &
        for t being Real st 0 < |.t.| & |.t.| < d holds
          |.F.t -
            exp_R.((b/(b-a)) * ln.b) /
              (exp_R.1 * exp_R.((a/(b-a)) * ln.a)).| < e
proof
end;
::$P+
