:: Statement-only formalization of PutnamBench corpus artifact putnam_2021_b3
:: (putnambench__mizar__putnam_2021_b3): every twice continuously
:: differentiable real function on the plane has, for each pair of positive
:: radii d > r, a radius-r disk centered at distance d from the origin on
:: which the integral of y*h_x - x*h_y is zero. This file contains no proof.

environ

 vocabularies MEASUR12, NUMBERS, XXREAL_0, SUBSET_1, CARD_1, ARYTM_3,
      ARYTM_1, RELAT_1, REAL_1, FUNCT_1, XBOOLE_0, TARSKI, ZFMISC_1,
      PROB_1, SUPINF_2, VALUED_0, PARTFUN1, MEASURE1, MESFUNC5, MESFUNC1,
      MEASUR10, MEASUR11, COMPLEX1, MESFUN12, RFUNCT_3, ORDINAL2, INTEGRA1,
      INTEGRA5, MEASURE6, NAT_1, FUNCT_2, CARD_3, ORDINAL1, SUPINF_1, SEQ_2,
      MEASURE3, MEASURE5, XXREAL_1, SEQ_1, MEASURE8, XREAL_0, FUNCT_7,
      XXREAL_2, MEMBERED, SEQ_4, STRUCT_0, PRE_TOPC, NORMSP_1, NFCONT_2,
      SQUARE_1, FCONT_1, REALSET1, DUALSP02, RCOMP_1, CFCONT_1, RAT_1,
      METRIC_1, FCONT_2, FDIFF_1, SIN_COS, EUCLID, TOPREAL1, JORDAN2C,
      CONNSP_1, RLTOPSP1, FINSEQ_1, FINSEQ_2, RVSUM_1, LIMFUNC1, TAYLOR_1,
      PDIFF_1, PDIFF_9, AFINSQ_1, ORDINAL4, SEQFUNC, SERIES_1, NFCONT_1,
      BINOP_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
      SETFAM_1, RELSET_1, PARTFUN1, MCART_1, FUNCT_2, BINOP_1, DOMAIN_1,
      CARD_3, NUMBERS, MEMBERED, XXREAL_3, XCMPLX_0, XXREAL_0, SQUARE_1,
      XREAL_0, VALUED_0, RAT_1, NAT_1, VALUED_1, XXREAL_1, XXREAL_2,
      EXTREAL1, COMPLEX1, MESFUNC1, FCONT_1, FCONT_2, SUPINF_1, SUPINF_2,
      PROB_1, RCOMP_1, FINSUB_1, MEASURE1, MEASURE3, MEASURE5, MEASUR12,
      MESFUNC2, MESFUNC5, MESFUNC6, INTEGRA5, MEASURE8, MEASUR10, MEASUR11,
      MESFUN12, SEQ_1, SEQ_2, SEQ_4, STRUCT_0, ALGSTR_0, PRE_TOPC, NORMSP_0,
      NORMSP_1, NFCONT_1, LOPBAN_1, LOPBAN_5, PRVECT_3, NFCONT_2, DUALSP02,
      FDIFF_1, SIN_COS, FINSEQ_1, FINSEQ_2, FINSEQ_7, EUCLID, JORDAN2C,
      NDIFF_1, LIMFUNC1, TAYLOR_1, PDIFF_1, PDIFF_7, PDIFF_9, NFCONT_4,
      MESFUN9C;
 constructors EXTREAL1, SUPINF_1, MESFUNC2, MEASUR11, MESFUN12, MESFUNC6,
      DOMAIN_1, FCONT_1, FCONT_2, MEASUR12, INTEGRA1, COMSEQ_2, PROB_3,
      EUCLID, NEWTON, MEASURE3, INTEGRA5, SEQ_2, SEQ_4, BINOP_2, SQUARE_1,
      NFCONT_1, PRVECT_3, NFCONT_2, DUALSP02, LOPBAN_5, NDIFF_8, LPSPACE1,
      VFUNCT_1, FDIFF_1, SIN_COS, JORDAN2C, NDIFF_1, LOPBAN_1, LIMFUNC1,
      TAYLOR_1, FINSEQ_7, FINSEQ_4, PDIFF_1, MONOID_0, INTEGR15, RELSET_1,
      PDIFF_7, PDIFF_9, NFCONT_4, MESFUNC5, MESFUN9C;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, XXREAL_3, MEMBERED, XXREAL_2,
      SQUARE_1, XXREAL_1, INTEGRA1, FINSUB_1, FCONT_1, TOPGEN_4, STRUCT_0,
      NORMSP_0, NORMSP_1, PRVECT_3, RAT_1, MEASURE3, COMPLEX1, MEASURE5,
      FOMODEL0, FDIFF_1, SIN_COS, EUCLID, TOPREAL1, NDIFF_1, LOPBAN_1,
      FUNCT_2, FINSEQ_1, RCOMP_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, FDIFF_1, TAYLOR_1;
 equalities RCOMP_1, MEASUR10, BINOP_1, MESFUNC6, INTEGRA5, ALGSTR_0,
      NORMSP_0, PRVECT_3, SQUARE_1, DUALSP02, LOPBAN_5, EUCLID, PDIFF_1,
      SIN_COS, PDIFF_9, SUBSET_1;
 expansions TARSKI, XBOOLE_0, MESFUNC1, MEASURE1, FCONT_1, MESFUNC6,
      INTEGRA5, NORMSP_1, NFCONT_1, NFCONT_2, FDIFF_1, TAYLOR_1, PDIFF_1,
      PDIFF_9;

begin

::$P-
theorem
  for h being Function of REAL 2,REAL,
      rho being Function of [:REAL,REAL:],REAL st
    (for i,j being Nat st i in Seg 2 & j in Seg 2 holds
      h is_partial_differentiable_on [#](REAL 2),i &
      (h`partial|([#](REAL 2),i))
        is_partial_differentiable_on [#](REAL 2),j &
      (for u being Element of REAL 2 holds
        (h`partial|([#](REAL 2),i)) is_continuous_in u) &
      ex d2 being PartFunc of REAL 2,REAL st
        d2 = ((h`partial|([#](REAL 2),i))
          `partial|([#](REAL 2),j)) &
        for u being Element of REAL 2 holds d2 is_continuous_in u) &
    (for u being Element of REAL 2 holds
      rho.([u.1,u.2]) =
        u.2 * partdiff(h,u,1) -
        u.1 * partdiff(h,u,2))
  holds
    for d,r being Real st 0 < d & 0 < r & d > r holds
      ex a,b being Real, D being Subset of [:REAL,REAL:] st
        sqrt(a^2 + b^2) = d &
        (for z being object holds
          z in D iff
            ex x,y being Real st
              z = [x,y] & (x-a)^2 + (y-b)^2 < r^2) &
        Integral(Prod_Measure(L-Meas,L-Meas),rho|D) = 0
proof
end;
::$P+
