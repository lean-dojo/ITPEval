:: Statement-only formalization of PutnamBench corpus artifact putnam_1987_a1:
:: four explicitly defined curves in the real plane have equal pairwise
:: intersections. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    BINOP_1, NUMBERS, XREAL_0, XCMPLX_0, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, ZFMISC_1, MCART_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XREAL_0, XCMPLX_0,
    REAL_1, XXREAL_0, MCART_1, BINOP_1;
  constructors ZFMISC_1, FUNCT_1, RELSET_1, FUNCT_2, XREAL_0, REAL_1,
    XXREAL_0, XTUPLE_0, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, MEMBERED,
    XTUPLE_0, MCART_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,B,C,D being Subset of [:REAL,REAL:] st
    A = {[x,y] where x,y is Real :
      x*x + y*y <> ((1 qua Real) - 1) &
      x*x - y*y = x / (x*x + y*y)} &
    B = {[x,y] where x,y is Real :
      x*x + y*y <> ((1 qua Real) - 1) &
      2*x*y + y / (x*x + y*y) = 3} &
    C = {[x,y] where x,y is Real :
      x*x*x - 3*x*y*y + 3*y = 1} &
    D = {[x,y] where x,y is Real :
      3*x*x*y - 3*x - y*y*y = ((1 qua Real) - 1)}
  holds A /\ B = C /\ D
proof
end;
::$P+
