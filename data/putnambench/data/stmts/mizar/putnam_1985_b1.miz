:: Statement-only formalization of PutnamBench corpus artifact putnam_1985_b1:
:: the five distinct integers -2, -1, 0, 1, 2 minimize the number of nonzero
:: coefficients of their monic real polynomial among all five distinct
:: integer roots. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, INT_1, NAT_1,
    CARD_1, ORDINAL1, XXREAL_0, ARYTM_1, ARYTM_3, STRUCT_0, ALGSTR_0, RLVECT_1,
    VECTSP_1, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM5,
    FINSET_1, FINSEQ_1, AFINSQ_1, FUNCT_4, GROUP_1, BINOP_1, PARTFUN1,
    LATTICES, ORDINAL4, FINSEQ_2, VECTSP_2, VALUED_0, MESFUNC1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, REAL_1, COMPLEX1, INT_1, NAT_1, VALUED_0, FINSEQ_1,
    FINSEQ_2, FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
    VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, CARD_1, REAL_1,
    COMPLEX1, INT_1, NAT_1, ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2,
    FINSEQ_4, VECTSP_2, ALGSTR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, XREAL_0, XXREAL_0, NUMBERS, MEMBERED,
    VALUED_0, XCMPLX_0, REAL_1, COMPLEX1, INT_1, NAT_1, STRUCT_0, RLVECT_1,
    VECTSP_1, ALGSEQ_1, POLYNOM3, FUNCT_7, PRE_POLY, POLYNOM5,
    FINSEQ_1, FINSEQ_2, VECTSP_2, ALGSTR_1;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
  equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
    ALGSTR_0;
  expansions TARSKI, ALGSEQ_1, POLYNOM5;
  theorems TARSKI, FUNCT_1, CARD_1, NAT_1, INT_1, POLYNOM3, POLYNOM4,
    POLYNOM5;

begin

::$P-
theorem
  ex negtwo,negone,z,o,two being Element of F_Real,
     p being Polynomial of F_Real st
    negtwo = -2 & negone = -1 & z = 0 & o = 1 & two = 2 &
    p =
      <%two,o%> *'
      <%o,o%> *'
      <%z,o%> *'
      <%negone,o%> *'
      <%negtwo,o%> &
    negtwo <> negone & negtwo <> z & negtwo <> o & negtwo <> two &
    negone <> z & negone <> o & negone <> two &
    z <> o & z <> two & o <> two &
    for a,b,c,d,e being Integer st
      a <> b & a <> c & a <> d & a <> e &
      b <> c & b <> d & b <> e &
      c <> d & c <> e & d <> e
    holds
      ex aa,bb,cc,dd,ee being Element of F_Real,
         q being Polynomial of F_Real st
        aa = a & bb = b & cc = c & dd = d & ee = e &
        q =
          <%-aa,o%> *'
          <%-bb,o%> *'
          <%-cc,o%> *'
          <%-dd,o%> *'
          <%-ee,o%> &
        card {k where k is Nat : p.k <> z} c=
          card {k where k is Nat : q.k <> z}
proof
end;
::$P+
