:: Statement-only formalization of PutnamBench corpus artifact putnam_1979_a3:
:: a nonzero real sequence satisfying the stated recurrence has integer values
:: at infinitely many indices exactly when its first two terms are the same
:: integer. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NAT_D;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Function of NAT,REAL st
    (for n being Nat holds
      x.n <> 0 &
      (3 <= n implies
        x.n =
          (x.(n -' 2) * x.(n -' 1)) /
          (2 * x.(n -' 2) - x.(n -' 1))))
  holds
    ((for m being Nat holds
        ex n being Nat st
          n > m &
          ex a being Integer st x.n = (a qua Real))
    iff
      ex k being Integer st
        x.1 = (k qua Real) & x.2 = (k qua Real))
proof
end;
::$P+
