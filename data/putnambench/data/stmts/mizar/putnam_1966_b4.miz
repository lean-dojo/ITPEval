:: Statement-only formalization of PutnamBench artifact putnam_1966_b4:
:: any m*n+1 positive natural numbers contain either an m+1 element
:: divisibility antichain or an n+1 element divisibility chain.
:: This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, FINSET_1, CARD_1, RELAT_1, TARSKI, XBOOLE_0,
      SUBSET_1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1,
      XREAL_0, CARD_1, FINSET_1, XXREAL_0, NAT_D;
 constructors REAL_1, NAT_D, NAT_1, CARD_1, FINSET_1, XXREAL_0;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NAT_1, FINSET_1, CARD_1,
      XCMPLX_0, XREAL_0;
 requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,n being Nat
  for S being finite Subset of NAT st
    card S = m*n+1 &
    (for i being Nat st i in S holds 0 < i)
  holds
    ex T being finite Subset of NAT st
      T c= S &
      ((card T = m+1 &
        (for i,j being Nat st i in T & j in T & i <> j
          holds not j divides i))
      or
       (card T = n+1 &
        (for i,j being Nat st i in T & j in T & j < i
          holds j divides i)))
proof
end;
::$P+
