:: Statement-only formalization of PutnamBench corpus artifact putnam_2002_b5:
:: some natural number is a three-digit palindrome in at least 2002 distinct
:: integer bases. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, RELAT_1, ARYTM_3, CARD_1, XXREAL_0,
    SUBSET_1, ARYTM_1, ZFMISC_1, XBOOLE_0, FINSET_1, ORDINAL1,
    TARSKI, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    NAT_1, XREAL_0, CARD_1, FINSET_1, XXREAL_0, NEWTON, NAT_D;
  constructors REAL_1, NAT_D, NAT_1, CARD_1, FINSET_1, XXREAL_0,
    NEWTON;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NAT_1, FINSET_1, CARD_1,
    XCMPLX_0, XREAL_0;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex n being Nat, bases being finite Subset of NAT st
    card bases >= 2002 &
    for b being Nat st b in bases holds
      b >= 1 &
      ex a,d being Nat st
        0 < a & a < b & d < b &
        n = a * b * b + d * b + a
proof
end;
::$P+
