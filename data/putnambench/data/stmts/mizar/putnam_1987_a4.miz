:: Statement-only formalization of PutnamBench corpus artifact putnam_1987_a4:
:: a real-coefficient polynomial in three variables satisfying a homogeneous
:: identity and three prescribed values determines a distance between complex
:: coordinates of any specified zero. This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, CARD_1, RELAT_1, ARYTM_1, ARYTM_3,
      XXREAL_0, REAL_1, FINSEQ_1, FUNCT_1, CARD_3, ORDINAL4, TARSKI,
      PARTFUN1, XBOOLE_0, HAHNBAN1, XCMPLX_0, COMPLFLD, SUPINF_2,
      COMPLEX1, GROUP_1, POWER, STRUCT_0, NAT_1, RLVECT_1, ALGSTR_0,
      VECTSP_1, BINOP_1, LATTICES, POLYNOM1, ALGSEQ_1, POLYNOM3,
      POLYNOM2, VECTSP_2, MESFUNC1, AFINSQ_1, FUNCT_4, CQC_LANG,
      CFCONT_1, FUNCOP_1, VALUED_1, FUNCT_2, SEQ_4, XXREAL_2,
      COMSEQ_1, VALUED_0, SEQ_2, ORDINAL2, SEQ_1, COMPTRIG, RFINSEQ,
      POLYNOM5, FUNCT_7, ASYMPT_1, ZFMISC_1, MCART_1, SQUARE_1,
      MULTOP_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_2, XREAL_0, COMPLEX1, REAL_1, POWER, BINOP_1, NAT_1,
      RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCOP_1, FINSEQ_1,
      POLYNOM1, RVSUM_1, STRUCT_0, ALGSTR_0, RLVECT_1, FUNCSDOM,
      VECTSP_2, VECTSP_1, RFINSEQ, CFCONT_1, VALUED_0, VALUED_1,
      SEQ_1, SEQ_2, SEQ_4, XXREAL_0, COMSEQ_1, COMSEQ_2, NAT_D,
      COMPLFLD, HAHNBAN1, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5,
      FUNCT_7, RECDEF_1, GROUP_1, ZFMISC_1, XTUPLE_0, MCART_1,
      SQUARE_1, MULTOP_1;
 constructors FINSEQ_4, ENUMSET1, REAL_1, SEQ_4, FINSOP_1, COMSEQ_2,
      RVSUM_1, CFCONT_1, RFINSEQ, NAT_D, FUNCSDOM, VECTSP_2,
      ALGSTR_1, MATRIX_1, HAHNBAN1, POLYNOM1, POLYNOM4, RECDEF_1,
      BINOP_2, POWER, SEQ_2, RELSET_1, FUNCT_7, FVSUM_1, ALGSEQ_1,
      POLYNOM5, ORDINAL1, SEQ_1, GROUP_1, ZFMISC_1, XTUPLE_0,
      MCART_1, SQUARE_1, MULTOP_1;
 registrations FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, NAT_1, INT_1, MEMBERED, FINSEQ_1, STRUCT_0,
      GROUP_1, VECTSP_1, COMPLFLD, ALGSTR_1, POLYNOM3, POLYNOM4,
      VALUED_0, VALUED_1, POLYNOM5, CARD_1, SEQ_2, CFUNCT_1, SEQ_1,
      RVSUM_1, ZFMISC_1, XTUPLE_0, MCART_1, SQUARE_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, ALGSEQ_1, XBOOLE_0, ALGSTR_0, XXREAL_2, COMSEQ_2;
 equalities XBOOLE_0, RVSUM_1, POLYNOM3, HAHNBAN1, STRUCT_0, ALGSTR_0,
      XCMPLX_0;
 expansions TARSKI, ALGSEQ_1, COMSEQ_2;
 theorems XREAL_0, TARSKI, ENUMSET1, NAT_1, POWER, INT_1, ABSVALUE,
      FUNCT_1, FUNCT_2, FUNCT_7, FINSEQ_1, FINSEQ_2, FINSEQ_3,
      FINSEQ_4, FINSEQ_5, FUNCOP_1, TBSP_1, RFINSEQ, PRE_FF, CFCONT_1,
      TOPREAL3, INTEGRA5, RLVECT_1, VECTSP_1, RVSUM_1, SEQ_2, SEQM_3,
      SEQ_4, COMSEQ_2, COMSEQ_3, CFUNCT_1, FVSUM_1, GROUP_1, ALGSEQ_1,
      COMPLEX1, COMPLFLD, HAHNBAN1, POLYNOM1, POLYNOM2, POLYNOM3,
      POLYNOM4, XBOOLE_0, XCMPLX_1, VECTSP_2, XREAL_1, XXREAL_0,
      FINSOP_1, NORMSP_1, PARTFUN1, ORDINAL1, VALUED_1, CARD_1, NAT_D,
      VALUED_0, XCMPLX_0, SEQ_1, ZFMISC_1, MCART_1, SQUARE_1;
 schemes NAT_1, FUNCT_2, FINSEQ_2, FINSEQ_1, FINSEQ_4, SEQ_1,
      CFCONT_1, DOMAIN_1, FUNCT_7;

begin

::$P-
theorem
  for f being Function of [:REAL,REAL:],REAL,
      polyEval being Function of [:COMPLEX,COMPLEX,COMPLEX:],COMPLEX,
      A,B,C being Element of F_Complex,
      p being Polynomial of Polynom-Ring (Polynom-Ring F_Complex) st
    (for i,j,k being Nat holds
      ex Q being Polynomial of Polynom-Ring F_Complex st
        Q = p.i &
        ex R being Polynomial of F_Complex st
          R = Q.j & Im (R.k) = 0) &
    (for a,b,c being Element of F_Complex holds
      ex yc being Element of (Polynom-Ring F_Complex),
         z1 being Element of (Polynom-Ring F_Complex),
         zc being Element of Polynom-Ring (Polynom-Ring F_Complex) st
        z1 = <%c%> & zc = <%z1%> & yc = <%b%> &
        ex Q being Polynomial of Polynom-Ring F_Complex st
          Q = eval(p,zc) &
          ex R being Polynomial of F_Complex st
            R = eval(Q,yc) & polyEval.(a,b,c) = eval(R,a)) &
    (for x,y,z,u being Real holds
      polyEval.((u*x qua Complex),(u*y qua Complex),(u*z qua Complex)) =
        (u^2 * f.([y-x,z-x]) qua Complex)) &
    polyEval.((1 qua Complex),(0 qua Complex),(0 qua Complex)) =
      (4 qua Complex) &
    polyEval.((0 qua Complex),(1 qua Complex),(0 qua Complex)) =
      (5 qua Complex) &
    polyEval.((0 qua Complex),(0 qua Complex),(1 qua Complex)) =
      (6 qua Complex) &
    polyEval.(A,B,C) = (0 qua Complex) &
    |.B-A.| = 10
  holds |.C-A.| = (5/3) * sqrt 30
proof
end;
::$P+
