:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_b4
:: (putnambench__mizar__putnam_2013_b4): the variance of the product of two
:: continuous real functions on [0,1] is bounded by their variances and
:: maximum absolute values. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, COMPLEX1,
      SQUARE_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
      INTEGRA5, SEQ_1, SEQ_2, SEQ_4, RCOMP_1, FCONT_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0, VALUED_1,
      COMPLEX1, SQUARE_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, SEQ_1, SEQ_4,
      PARTFUN2, FCONT_1;
 constructors RELSET_1, FUNCT_2, REAL_1, COMPLEX1, SQUARE_1,
      MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1,
      PARTFUN2, RFUNCT_2, FCONT_1, SEQ_2, SEQ_4;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, SQUARE_1, XXREAL_3, MEASURE1, MEASUR12, RCOMP_1,
      FCONT_1, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities SQUARE_1;
 expansions TARSKI, XBOOLE_0, RELAT_1, FCONT_1;

begin

::$P-
theorem
  for I being Subset of REAL,
      f,g,fg,df,dg,dfg being Function of REAL,REAL,
      vf,vg,vfg being Function of REAL,REAL,
      muf,mug,mufg,Mf,Mg being Real st
    I = {x where x is Real : 0 <= x & x <= 1} &
    (for x being Real st x in I holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in I & |.y-x.| < delta holds
            |.f.y-f.x.| < epsilon) &
    (for x being Real st x in I holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in I & |.y-x.| < delta holds
            |.g.y-g.x.| < epsilon) &
    (for x being Real holds fg.x = f.x * g.x) &
    muf = Integral(L-Meas,f|I) &
    mug = Integral(L-Meas,g|I) &
    mufg = Integral(L-Meas,fg|I) &
    (for x being Real holds
      df.x = f.x - muf &
      dg.x = g.x - mug &
      dfg.x = fg.x - mufg) &
    (for x being Real holds
      vf.x = (df.x)^2 &
      vg.x = (dg.x)^2 &
      vfg.x = (dfg.x)^2) &
    (ex x being Real st x in I & |.f.x.| = Mf) &
    (for x being Real st x in I holds |.f.x.| <= Mf) &
    (ex x being Real st x in I & |.g.x.| = Mg) &
    (for x being Real st x in I holds |.g.x.| <= Mg)
  holds
    Integral(L-Meas,vfg|I) <=
      2 * Integral(L-Meas,vf|I) * (Mg)^2 +
      2 * Integral(L-Meas,vg|I) * (Mf)^2
proof
end;
::$P+
