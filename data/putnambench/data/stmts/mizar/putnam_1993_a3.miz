:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_a3:
:: the number of maps from the subsets of {1,...,n} to {1,...,m} that send
:: intersections to minima is the sum of j^n for j from 1 through m. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, REAL_1, INT_1, ORDINAL1, FINSET_1, NEWTON,
    ARYTM_1, ARYTM_3, RVSUM_1, VALUED_0, VALUED_1, REALSET1, CARD_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1,
    FINSEQ_2, FINSET_1, NEWTON;
  constructors REAL_1, NAT_1, NAT_D, NEWTON, FINSET_1, CARD_1,
    RELSET_1, NUMBERS, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1,
    NEWTON, RVSUM_1, VALUED_0, VALUED_1, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for n,m being Nat st 1 <= n & 1 <= m holds
    for admissible being set,
        powers being FinSequence of NAT st
      admissible =
        {f where f is Function of bool Seg n, Seg m :
          for A,B being Subset of Seg n holds
            f.(A /\ B) = min(f.A,f.B)} &
      len powers = m &
      (for j being Nat st j in Seg m holds powers.j = j |^ n)
    holds card admissible = Sum powers
proof
end;
::$P+
