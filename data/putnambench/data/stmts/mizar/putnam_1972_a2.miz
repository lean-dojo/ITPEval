:: Statement-only formalization of PutnamBench artifact putnam_1972_a2:
:: every binary operation satisfying the two involutive laws is commutative,
:: but such an operation need not be associative. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  (for S being set, op being Function of [:S,S:],S st
    (for x,y being Element of S holds
      op.(x,op.(x,y)) = y & op.(op.(y,x),x) = y)
  holds
    for x,y being Element of S holds op.(x,y) = op.(y,x)) &
  (ex S being set, op being Function of [:S,S:],S st
    (for x,y being Element of S holds
      op.(x,op.(x,y)) = y & op.(op.(y,x),x) = y) &
    not for x,y,z being Element of S holds
      op.(x,op.(y,z)) = op.(op.(x,y),z))
proof
end;
::$P+
