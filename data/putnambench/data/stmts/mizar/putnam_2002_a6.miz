:: Statement-only formalization of PutnamBench corpus artifact putnam_2002_a6:
:: the reciprocal series defined by a base-b digit-length recurrence converges
:: for bases b at least 2 exactly when b = 2. This file contains no proof.

environ
  vocabularies NUMBERS, SUBSET_1, FUNCT_1, NAT_1, TARSKI, RELAT_1,
    AFINSQ_1, ARYTM_1, ARYTM_3, FINSEQ_1, XXREAL_0, CARD_1, XBOOLE_0,
    ZFMISC_1, ORDINAL4, CARD_3, FINSOP_1, BINOP_2, INT_1, SERIES_1,
    VALUED_1, PREPOWER, NEWTON, POWER, NUMERAL1, RAT_1, REAL_1, SEQ_1,
    SEQ_2, ORDINAL2, SQUARE_1, XXREAL_2, SEQ_4, COMPLEX1, VALUED_0,
    ABIAN, ORDINAL1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    RELAT_1, FUNCT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, AFINSQ_1,
    VALUED_1, RELSET_1, FUNCT_2, BINOP_1, NAT_1, BINOP_2, RECDEF_1,
    SERIES_1, NEWTON, PREPOWER, AFINSQ_2, NAT_D, INT_1, RAT_1, REAL_1,
    COMPLEX1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SQUARE_1, SEQ_4, ABIAN,
    XXREAL_2, POWER, NUMERAL1;
  constructors PREPOWER, SERIES_1, PARTFUN3, BINOM, SETWISEO, REAL_1,
    NAT_D, RECDEF_1, BINOP_2, RELSET_1, AFINSQ_2, BINOP_1, NEWTON,
    SQUARE_1, NAT_1, SEQ_2, SEQM_3, SEQ_4, XXREAL_2, ABIAN, COMSEQ_2,
    POWER, NUMERAL1, ZFMISC_1;
  registrations XBOOLE_0, RELAT_1, ORDINAL1, XXREAL_0, XREAL_0, NAT_1,
    CARD_1, NUMBERS, INT_1, BINOP_2, MEMBERED, NEWTON, AFINSQ_1,
    VALUED_1, FUNCT_2, POWER, FINSET_1, AFINSQ_2, RELSET_1, VALUED_0,
    FUNCT_1, SQUARE_1, RAT_1, PREPOWER, SEQ_4, ABIAN, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of [:NAT,NAT:],REAL st
    (for b being Nat holds
      f.(b,1) = 1 &
      f.(b,2) = 2 &
      (for n being Nat st 3 <= n holds
        f.(b,n) = (n qua Real) * f.(b,len digits(n,b))))
  holds
    for b being Nat st 2 <= b holds
      ((ex s being Real_Sequence st
        (for n being Nat holds
          s.n = 1 / f.(b,n + 1)) &
        Partial_Sums(s) is convergent)
      iff b = 2)
proof
end;
::$P+
