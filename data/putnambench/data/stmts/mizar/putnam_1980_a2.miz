:: Statement-only formalization of PutnamBench corpus artifact putnam_1980_a2:
:: the number of ordered positive natural quadruples whose four triple least
:: common multiples equal 3^r * 7^s. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, NUMBERS, NAT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, NEWTON,
    ARYTM_1, ARYTM_3, INT_1, INT_2, RELAT_1, FUNCT_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, ORDINAL1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, INT_1, INT_2,
    FINSET_1, CARD_1, NEWTON;
  constructors XTUPLE_0, NAT_1, NAT_D, INT_2, NEWTON, FINSET_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1, NEWTON, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for r,s being Nat st 0 < r & 0 < s holds
    card { [[[a,b],c],d] where a,b,c,d is Element of NAT :
      0 < a & 0 < b & 0 < c & 0 < d &
      (a lcm b) lcm c = (3 |^ r) * (7 |^ s) &
      (a lcm b) lcm d = (3 |^ r) * (7 |^ s) &
      (a lcm c) lcm d = (3 |^ r) * (7 |^ s) &
      (b lcm c) lcm d = (3 |^ r) * (7 |^ s) }
    =
      (1 + 4 * r + 6 * (r |^ 2)) *
      (1 + 4 * s + 6 * (s |^ 2))
proof
end;
::$P+
