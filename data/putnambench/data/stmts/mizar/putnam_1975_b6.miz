:: Statement-only formalization of PutnamBench corpus artifact putnam_1975_b6:
:: two strict inequalities comparing harmonic partial sums with real powers
:: of consecutive natural numbers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4, BINOP_1, BINOP_2,
    FUNCOP_1, FINSEQOP, ZFMISC_1, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, FUNCT_7, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, PARTFUN1, BINOP_2,
    SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4,
    VALUED_0, VALUED_1, NAT_1, FINSOP_1, FINSEQOP, SETWOP_2,
    RVSUM_1, POWER;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, BINOP_1, SETWISEO, NAT_1, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, XXREAL_1,
    FINSEQ_2, RVSUM_1, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, FUNCOP_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s being Function of NAT,REAL st
    (for n being Nat holds
      ex terms being FinSequence of REAL st
        len terms = n &
        (for k being Nat st k in Seg n holds
          terms.k = 1 / (k qua Real)) &
        s.n = Sum terms)
  holds
    (for n being Nat st 1 < n holds
      (n qua Real) *
          (((n + 1) qua Real) to_power (1 / (n qua Real)))
        < (n qua Real) + s.n) &
    (for n being Nat st 2 < n holds
      ((n qua Real) - 1) *
          ((n qua Real) to_power
            (-1 / ((n qua Real) - 1)))
        < (n qua Real) - s.n)
proof
end;
::$P+
