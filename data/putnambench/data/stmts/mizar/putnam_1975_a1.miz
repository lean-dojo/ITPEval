:: Statement-only formalization of PutnamBench artifact putnam_1975_a1:
:: the equivalence between sums of two triangular numbers and integers whose
:: quadruple plus one is a sum of two squares. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, SQUARE_1,
    REAL_1, VALUED_0, INT_1, INT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, INT_2, NAT_D,
    RELAT_1, XXREAL_0;
  constructors REAL_1, SQUARE_1, NAT_1, NAT_D, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  ((for n,a,b being Integer st
      (n qua Real) =
        (((a qua Real)^2 + (a qua Real)) / 2) +
        (((b qua Real)^2 + (b qua Real)) / 2)
    holds
      4*n + 1 = (a+b+1)^2 + (a-b)^2) &
   (for n being Integer st
      ex x,y being Integer st 4*n + 1 = x^2 + y^2
    holds
      ex a,b being Integer st
        (n qua Real) =
          (((a qua Real)^2 + (a qua Real)) / 2) +
          (((b qua Real)^2 + (b qua Real)) / 2)))
proof
end;
::$P+
