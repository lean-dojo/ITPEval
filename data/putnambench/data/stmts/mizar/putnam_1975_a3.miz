:: Statement-only formalization of PutnamBench corpus artifact putnam_1975_a3:
:: the explicit points where x^a + y^b + z^c attains its maximum and minimum
:: on the nonnegative real surface x^b + y^b + z^b = 1. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b,c being Real st 0 < a & a < b & b < c holds
    ex maxx,maxy,maxz,minx,miny,minz being Real st
      maxx = (a/b) to_power (1/(b-a)) &
      maxy =
        (1 - (((a/b) to_power (1/(b-a))) to_power b))
          to_power (1/b) &
      maxz = 0 &
      minx = 0 &
      miny =
        (1 - (((b/c) to_power (1/(c-b))) to_power b))
          to_power (1/b) &
      minz = (b/c) to_power (1/(c-b)) &
      maxx >= 0 & maxy >= 0 & maxz >= 0 &
      maxx to_power b + maxy to_power b + maxz to_power b = 1 &
      (for x,y,z being Real st
        x >= 0 & y >= 0 & z >= 0 &
        x to_power b + y to_power b + z to_power b = 1
      holds
        x to_power a + y to_power b + z to_power c <=
          maxx to_power a + maxy to_power b + maxz to_power c) &
      minx >= 0 & miny >= 0 & minz >= 0 &
      minx to_power b + miny to_power b + minz to_power b = 1 &
      (for x,y,z being Real st
        x >= 0 & y >= 0 & z >= 0 &
        x to_power b + y to_power b + z to_power b = 1
      holds
        x to_power a + y to_power b + z to_power c >=
          minx to_power a + miny to_power b + minz to_power c)
proof
end;
::$P+
