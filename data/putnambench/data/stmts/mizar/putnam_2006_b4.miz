:: Statement-only formalization of PutnamBench corpus artifact putnam_2006_b4:
:: the maximum number of Boolean-cube vertices contained in a k-dimensional
:: real linear subspace of R^n is 2^k. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, CARD_3, EUCLID,
      FINSEQ_1, FINSEQ_2, FINSEQ_4, FINSET_1, FUNCT_1, FUNCT_2,
      NAT_1, NEWTON, NUMBERS, ORDINAL1, ORDINAL4, PARTFUN1, PRE_TOPC,
      RELAT_1, RLSUB_1, RLTOPSP1, RLVECT_1, RLVECT_5, STRUCT_0,
      SUBSET_1, TARSKI, VALUED_0, VALUED_1, XBOOLE_0, XCMPLX_0,
      XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, CARD_1, FINSET_1, RELAT_1, FUNCT_1,
      PARTFUN1, FUNCT_2, FINSEQ_1, STRUCT_0, FINSEQ_2, RLVECT_1,
      PRE_TOPC, ALGSTR_0, RLTOPSP1, EUCLID, RLSUB_1, RLVECT_5,
      NAT_1, NEWTON;
 constructors ZFMISC_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, RLVECT_1, RLTOPSP1, EUCLID, RLSUB_1, RLVECT_5,
      FINSET_1, NAT_1, NEWTON, RLAFFIN3;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, RLTOPSP1, EUCLID, RLVECT_5, FINSET_1,
      NEWTON, RLAFFIN3;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLTOPSP1;
 equalities STRUCT_0, FINSEQ_1, FINSEQ_2;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for n,k being Nat,
      Z being finite Subset of TOP-REAL n st
    n > 0 &
    k <= n &
    Z = {p where p is Element of REAL n :
      for i being Nat st i in Seg n holds p/.i = 0 or p/.i = 1}
  holds
    (for V being Subspace of TOP-REAL n st dim V = k holds
      card ([#]V /\ Z) <= 2 |^ k) &
    ex V being Subspace of TOP-REAL n st
      dim V = k &
      card ([#]V /\ Z) = 2 |^ k
proof
end;
::$P+
