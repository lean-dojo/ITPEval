:: Statement-only formalization of PutnamBench corpus artifact putnam_1988_a5:
:: existence and uniqueness on the positive reals of a positive-valued
:: function satisfying f(f(x)) = 6*x - f(x). This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, PARTFUN1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, NAT_1, INT_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, XCMPLX_0, REAL_1,
    NAT_1, INT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, MEMBERED, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex f being Function of REAL,REAL st
    (for x being Real st x > 0 holds
      f/.(f/.x) = 6 * x - f/.x & f/.x > 0) &
    (for g being Function of REAL,REAL st
      (for x being Real st x > 0 holds
        g/.(g/.x) = 6 * x - g/.x & g/.x > 0)
      holds
        for x being Real st x > 0 holds f/.x = g/.x)
proof
end;
::$P+
