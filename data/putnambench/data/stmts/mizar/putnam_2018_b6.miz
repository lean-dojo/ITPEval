:: Statement-only formalization of PutnamBench corpus artifact putnam_2018_b6:
:: the number of length-2018 sequences with entries in {1,2,3,4,5,6,10}
:: and sum 3860 is bounded by the stated exponential expression.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, INT_1, FINSEQ_1, FINSEQ_2, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, FINSET_1, VALUED_0, VALUED_1, ARYTM_1,
    ARYTM_3, CARD_3, REAL_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, FINSET_1;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    FINSET_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED,
    FINSET_1, FRAENKEL, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being finite set st
    S = {s where s is FinSequence of INT :
      len s = 2018 &
      (for i being Nat st i in dom s holds
        s.i = 1 or s.i = 2 or s.i = 3 or s.i = 4 or
        s.i = 5 or s.i = 6 or s.i = 10) &
      Sum s = 3860}
  holds
    (card S qua Real) <=
      ((2 qua Real) |^ 3860) *
      (((2018 qua Real) / 2048) |^ 2018)
proof
end;
::$P+
