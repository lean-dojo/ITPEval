:: Statement-only formalization of PutnamBench artifact putnam_1996_a3:
:: the assertion that every assignment of six-course choices to twenty
:: students has five students agreeing on two chosen or two unchosen courses
:: is false. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, REAL_1, INT_1, ORDINAL1, FINSET_1, ARYTM_1,
    ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XXREAL_0, INT_1, NAT_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSEQ_1, FINSET_1;
  constructors REAL_1, NAT_1, FINSEQ_1, FINSET_1, CARD_1, RELSET_1,
    NUMBERS;
  registrations XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSEQ_1, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  not (for choices being Function of Seg 20, bool Seg 6 holds
    ex students being Subset of Seg 20,
       courses being Subset of Seg 6 st
      card students = 5 &
      card courses = 2 &
      ((for s being Element of Seg 20 st s in students holds
          for c being Element of Seg 6 st c in courses holds
            c in choices.s) or
       (for s being Element of Seg 20 st s in students holds
          for c being Element of Seg 6 st c in courses holds
            not c in choices.s)))
proof
end;
::$P+
