:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_b4:
:: an integer-coefficient polynomial injective on the residues modulo p^2
:: remains injective on the residues modulo p^3 for prime p.
:: This file contains no proof.

environ
  vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1,
    NAT_1, INT_1, INT_2, INT_3, NEWTON, POLYNOM1, VECTSP_1, SUBSET_1,
    POLYNOM2, XCMPLX_0, POLYNOM3, FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1,
    ALGSTR_0, ALGSEQ_1, FUNCT_1, FUNCT_2, SUPINF_2, NUMBERS, VALUED_0,
    VALUED_1, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1, CARD_3, BINOP_1,
    TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4, FINSEQ_2, VECTSP_2,
    ZFMISC_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, REAL_1, INT_1, INT_2, NAT_1, NAT_D, NEWTON, VALUED_0,
    FINSEQ_1, FINSEQ_2, FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1,
    GROUP_1, VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4,
    POLYNOM5, INT_3;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, NAT_D, INT_1, INT_2,
    NEWTON, NUMBERS, ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2,
    FINSEQ_4, VECTSP_2, ALGSTR_1, INT_3;
  registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
    CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
    RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, SUBSET_1,
    NAT_1, INT_1, INT_3, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2,
    VECTSP_2, ALGSTR_1, NEWTON;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
  equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
    ALGSTR_0;
  expansions TARSKI, ALGSEQ_1, POLYNOM5;
  theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3, POLYNOM4,
    POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0, INT_1, INT_2, INT_3,
    NEWTON;

begin

::$P-
theorem
  for p being Nat,
      h being Polynomial of INT.Ring st
    p is prime &
    (for i,j being Nat st i < p |^ 2 & j < p |^ 2 holds
      for x,y,m being Element of INT.Ring st
        x = i & y = j & m = p |^ 2 &
        m divides (eval(h,x) - eval(h,y))
      holds i = j)
  holds
    for i,j being Nat st i < p |^ 3 & j < p |^ 3 holds
      for x,y,m being Element of INT.Ring st
        x = i & y = j & m = p |^ 3 &
        m divides (eval(h,x) - eval(h,y))
      holds i = j
proof
end;
::$P+
