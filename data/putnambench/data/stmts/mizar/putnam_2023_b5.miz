:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_b5:
:: positive integers admitting, for every coprime integer multiplier, a
:: permutation of {1,...,n} whose square realizes multiplication modulo n
:: are exactly 1 and the integers congruent to 2 modulo 4. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, NUMBERS, NAT_1,
    INT_1, INT_2, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1,
    ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, MATRIX_0,
    MATRIX_1;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    INT_1, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2,
    VALUED_0, VALUED_1, MEMBERED;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1, INT_2;

begin

::$P-
theorem
  for n being Nat holds
    (0 < n &
      (for m being Integer st m,n are_coprime holds
        ex p being Permutation of Seg n st
          for k being Nat st k in Seg n holds
            ex j,l being Nat st
              j in Seg n & l in Seg n &
              p.k = j & p.j = l &
              l, m * k are_congruent_mod n))
    iff
    (n = 1 or n mod 4 = 2)
proof
end;
::$P+
