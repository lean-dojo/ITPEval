:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_b1
:: (putnambench__mizar__putnam_2017_b1): two distinct affine lines in the
:: real plane intersect exactly when every nonzero real dilation about every
:: point off both lines sends some point of the first line to a point of the
:: second line. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, EUCLID, FINSEQ_1,
      FINSEQ_2, NUMBERS, PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1,
      RVSUM_1, STRUCT_0, SUBSET_1, TARSKI, XBOOLE_0, XCMPLX_0, XREAL_0,
      ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, REAL_1, STRUCT_0, PRE_TOPC, FINSEQ_1, FINSEQ_2,
      RVSUM_1, RLVECT_1, RLTOPSP1, EUCLID;
 constructors ZFMISC_1, REAL_1, BINOP_2, FINSEQOP, MONOID_0, RLTOPSP1,
      EUCLID, RELSET_1;
 registrations RELSET_1, NUMBERS, XREAL_0, BINOP_2, MEMBERED, MONOID_0,
      EUCLID, VALUED_0, VALUED_1, ORDINAL1;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
 equalities RVSUM_1, EUCLID, VALUED_1;
 expansions XBOOLE_0, RVSUM_1;

begin

::$P-
theorem
  for L1,L2 being line of TOP-REAL 2 st
    L1 is non trivial & L2 is non trivial & L1 <> L2
  holds
    (L1 meets L2 iff
      for lambda being Real st lambda <> 0 holds
        for P being Point of TOP-REAL 2 st not P in L1 & not P in L2 holds
          ex A1,A2 being Point of TOP-REAL 2 st
            A1 in L1 & A2 in L2 &
            A2 - P = lambda * (A1 - P))
proof
end;
::$P+
