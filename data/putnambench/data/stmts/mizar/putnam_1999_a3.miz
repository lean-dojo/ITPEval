:: Statement-only formalization of PutnamBench corpus artifact putnam_1999_a3:
:: coefficients of the power series for 1/(1-2*x-x^2) have the property that
:: each sum of squares of adjacent coefficients is another coefficient. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1,
    SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, ABIAN, ORDINAL1, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PREPOWER, ABIAN, XXREAL_2, VALUED_0, VALUED_1,
    SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN,
    COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, SEQ_4,
    ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Real_Sequence st
    ex epsilon being Real st
      0 < epsilon &
      for x being Real st |.x.| < epsilon holds
        ex s being Real_Sequence st
          (for n being Nat holds s.n = a.n * (x |^ n)) &
          Partial_Sums(s) is convergent &
          lim Partial_Sums(s) = 1 / (1 - 2*x - (x |^ 2))
  holds
    for n being Nat ex m being Nat st
      (a.n |^ 2) + (a.(n+1) |^ 2) = a.m
proof
end;
::$P+
