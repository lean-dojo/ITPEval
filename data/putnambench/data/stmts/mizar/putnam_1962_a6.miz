:: Statement-only formalization of PutnamBench artifact putnam_1962_a6:
:: a rational set closed under addition and multiplication and selecting
:: exactly one of each nonzero opposite pair is the positive rationals.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being Subset of RAT st
    (for a,b being Rational st a in S & b in S
      holds a + b in S) &
    (for a,b being Rational st a in S & b in S
      holds a * b in S) &
    (for r being Rational holds
      (r in S or -r in S or r = 0) &
      not (r in S & -r in S) &
      not (r in S & r = 0) &
      not (-r in S & r = 0))
  holds S = {r where r is Rational : r > 0}
proof
end;
::$P+
