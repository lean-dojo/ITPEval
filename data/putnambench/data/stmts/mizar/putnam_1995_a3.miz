:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_a3:
:: three nine-digit integer strings linked by single-digit replacements whose
:: decimal values are divisible by 7 have corresponding digits of the first
:: and third strings congruent modulo 7. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, INT_1, INT_2, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, CARD_1, ARYTM_1, ARYTM_3, FINSEQ_1, FINSEQ_2, NEWTON,
    REALSET1, VALUED_0, VALUED_1, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NEWTON, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for relation being Relation of Funcs(Seg 9,INT) holds
  for v being Function of Funcs(Seg 9,INT),INT st
    (for dig being Function of Seg 9,INT holds
      ex terms being FinSequence of INT st
        len terms = 9 &
        (for i being Nat st i in Seg 9 holds
          terms.i = dig.i * ((10 qua Integer) |^ (i -' 1))) &
        v.dig = Sum terms) &
    (for d,e being Function of Seg 9,INT holds
      ([d,e] in relation iff
        (for i being Nat st i in Seg 9 holds
          0 <= d.i & d.i < 10 & 0 <= e.i & e.i < 10) &
        (for i being Nat st i in Seg 9 holds
          ex replaced being Function of Seg 9,INT st
            (for j being Nat st j in Seg 9 holds
              (j = i implies replaced.j = e.j) &
              (j <> i implies replaced.j = d.j)) &
            (7 qua Integer) divides v.replaced)))
  holds
    for d,e,f being Function of Seg 9,INT st
      [d,e] in relation & [e,f] in relation
    holds
      for i being Nat st i in Seg 9 holds
        (7 qua Integer) divides (d.i - f.i)
proof
end;
::$P+
