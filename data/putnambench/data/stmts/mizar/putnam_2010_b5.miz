:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_b5
:: (putnambench__mizar__putnam_2010_b5): there is no strictly increasing
:: differentiable function f from the reals to the reals whose derivative
:: satisfies f'(x) = f(f(x)) for every real x. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FUNCOP_1, FUNCT_7, NAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XXREAL_0, XXREAL_2, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, FDIFF_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0;
  expansions TARSKI;
  theorems TARSKI, NAT_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN2, RFUNCT_2,
    RCOMP_1, FCONT_1, FDIFF_1, ZFMISC_1, FUNCT_1, XREAL_0, XBOOLE_0,
    XBOOLE_1, XCMPLX_1, FUNCOP_1, XREAL_1, XXREAL_0, VALUED_1,
    XXREAL_2, XXREAL_1, FUNCT_2, VALUED_0, ORDINAL1;
  schemes SEQ_1;

begin

::$P-
theorem
  not ex f being Function of REAL,REAL st
    (for x,y being Real st x < y holds f.x < f.y) &
    (for x being Real holds
      f is_differentiable_in x & diff(f,x) = f.(f.x))
proof
end;
::$P+
