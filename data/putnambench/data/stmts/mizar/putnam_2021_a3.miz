:: Statement-only formalization of PutnamBench corpus artifact putnam_2021_a3
:: (putnambench__mizar__putnam_2021_a3): positive integers whose centered
:: sphere in real three-space has an inscribed regular tetrahedron with
:: integer-coordinate vertices are exactly 3 times a positive square.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1,
    NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, FINSEQ_1, ZFMISC_1, NEWTON, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1,
    FUNCT_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, NAT_1, FINSEQ_1, NEWTON;
  constructors RELSET_1, CARD_1, REAL_1, INT_1, XXREAL_0, NAT_1,
    FINSEQ_1, ZFMISC_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    CARD_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1,
    FINSEQ_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for N being Nat holds
    (0 < N &
      ex xa,ya,za,xb,yb,zb,xc,yc,zc,xd,yd,zd,d being Integer st
        0 < d &
        xa*xa + ya*ya + za*za = (N qua Integer) &
        xb*xb + yb*yb + zb*zb = (N qua Integer) &
        xc*xc + yc*yc + zc*zc = (N qua Integer) &
        xd*xd + yd*yd + zd*zd = (N qua Integer) &
        (xa-xb)*(xa-xb) + (ya-yb)*(ya-yb) + (za-zb)*(za-zb) = d &
        (xa-xc)*(xa-xc) + (ya-yc)*(ya-yc) + (za-zc)*(za-zc) = d &
        (xa-xd)*(xa-xd) + (ya-yd)*(ya-yd) + (za-zd)*(za-zd) = d &
        (xb-xc)*(xb-xc) + (yb-yc)*(yb-yc) + (zb-zc)*(zb-zc) = d &
        (xb-xd)*(xb-xd) + (yb-yd)*(yb-yd) + (zb-zd)*(zb-zd) = d &
        (xc-xd)*(xc-xd) + (yc-yd)*(yc-yd) + (zc-zd)*(zc-zd) = d)
    iff
      ex m being Nat st
        0 < m & N = 3 * (m*m)
proof
end;
::$P+
