:: Statement-only formalization of PutnamBench corpus artifact putnam_1997_b1:
:: the finite sum of the lesser distances of m/(6n) and m/(3n) to the
:: nearest integer equals n for every positive integer n. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, REAL_1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, RELAT_1, FUNCT_1,
    RELSET_1, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D, VALUED_0,
    VALUED_1;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    XXREAL_0;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, RELSET_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n > 0 holds
    ex terms being FinSequence of REAL st
      len terms = 6 * n -' 1 &
      (for m being Nat st m in Seg (6 * n -' 1) holds
        terms.m =
          min(
            min(
              (m qua Real) / (6 * (n qua Real)) -
                [\ (m qua Real) / (6 * (n qua Real)) /],
              [/ (m qua Real) / (6 * (n qua Real)) \] -
                (m qua Real) / (6 * (n qua Real))),
            min(
              (m qua Real) / (3 * (n qua Real)) -
                [\ (m qua Real) / (3 * (n qua Real)) /],
              [/ (m qua Real) / (3 * (n qua Real)) \] -
                (m qua Real) / (3 * (n qua Real))))) &
      Sum terms = (n qua Real)
proof
end;
::$P+
