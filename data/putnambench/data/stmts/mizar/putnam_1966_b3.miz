:: Statement-only formalization of PutnamBench artifact putnam_1966_b3:
:: convergence of the reciprocal series of a positive real sequence implies
:: convergence of the series n^2*p_n/(sum from i=1 to n of p_i)^2.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1, SEQ_2,
    ORDINAL1, ORDINAL2, SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, BINOP_2,
    COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p being Real_Sequence st
    (for n being Nat holds 0 < p.n) &
    (ex r being Real_Sequence st
      (for n being Nat holds r.n = 1 / p.(n + 1)) &
      Partial_Sums(r) is convergent)
  holds
    ex a,b being Real_Sequence st
      (for n being Nat holds a.n = p.(n + 1)) &
      (for n being Nat holds
        b.n = p.(n + 1) * (((n + 1) qua Real) |^ 2) /
          (Partial_Sums(a).n |^ 2)) &
      Partial_Sums(b) is convergent
proof
end;
::$P+
