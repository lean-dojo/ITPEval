:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_b2
:: (putnambench__mizar__putnam_2015_b2): repeatedly remove the three smallest
:: remaining positive integers and their sum; some generated sum ends in 2015.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, NAT_1, INT_1, CARD_1, XXREAL_0, XCMPLX_0,
    ARYTM_1, ARYTM_3, VALUED_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, NAT_D, CARD_1, VALUED_0;
  constructors ZFMISC_1, RELSET_1, FUNCT_2, XCMPLX_0, XXREAL_0, NAT_1,
    NAT_D, INT_1, CARD_1, VALUED_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, CARD_1,
    VALUED_0, MEMBERED;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM, REAL;

begin

::$P-
theorem
  for sets being Function of NAT,bool NAT,
      min1,min2,min3 being Function of bool NAT,NAT,
      sums being Function of NAT,NAT st
    sets.0 = {n where n is Element of NAT : 0 < n} &
    (for S being Subset of NAT st
      (ex x,y,z being Nat st
        x in S & y in S & z in S &
        x <> y & x <> z & y <> z)
    holds
      min1.S in S &
      (for x being Nat st x in S holds min1.S <= x) &
      min2.S in S \ {min1.S} &
      (for x being Nat st x in S \ {min1.S} holds min2.S <= x) &
      min3.S in S \ {min1.S,min2.S} &
      (for x being Nat st x in S \ {min1.S,min2.S} holds min3.S <= x)) &
    (for n being Nat holds
      sums.n = min1.(sets.n) + min2.(sets.n) + min3.(sets.n)) &
    (for n being Nat holds
      sets.(n+1) =
        sets.n \ ({min1.(sets.n),min2.(sets.n)} \/
          {min3.(sets.n),sums.n}))
  holds
    ex n being Nat st sums.n mod 10000 = 2015
proof
end;
::$P+
