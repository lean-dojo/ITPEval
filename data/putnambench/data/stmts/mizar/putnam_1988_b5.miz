:: Statement-only formalization of PutnamBench corpus artifact putnam_1988_b5:
:: for every positive n, the specified skew-symmetric real matrix of order
:: 2*n+1 has rank 2*n. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, CARD_3, CLASSES1,
      COMPLEX1, FINSEQ_1, FINSEQ_2, FINSEQ_4, FINSET_1, FUNCOP_1,
      FUNCT_1, FUNCT_2, MATRIX_1, MATRIX_3, MATRIX13, NAT_1, NUMBERS,
      ORDINAL2, ORDINAL4, PARTFUN1, PRVECT_1, QC_LANG1, REAL_1, RELAT_1,
      RLVECT_1, RLVECT_2, RLVECT_3, RLVECT_5, SETFAM_1, STRUCT_0,
      SUBSET_1, SUPINF_2, TARSKI, VALUED_0, VALUED_1, VECTSP_1,
      XBOOLE_0, XCMPLX_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, CARD_1, XREAL_0, REAL_1, FINSET_1, DOMAIN_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FUNCOP_1,
      STRUCT_0, FINSEQ_2, FINSEQOP, RVSUM_1, RLVECT_1, RLVECT_2,
      VALUED_0, ALGSTR_0, FVSUM_1, RLSUB_1, RLVECT_3, RLVECT_5,
      CARD_3, VECTSP_1, MATRIX_0, MATRIX_1, NAT_D, MATRIX_3, MATRIX_6,
      VECTSP_6, VECTSP_7, MATRIX13, PRVECT_1;
 constructors BINOP_2, FVSUM_1, MATRIX_6, MATRIX13, NAT_D, RANKNULL,
      REAL_1, REALSET1, RLVECT_3, RLVECT_5, VECTSP_7, WELLORD2,
      MATRIX_1;
 registrations CARD_1, FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, MATRIX13,
      NAT_1, NUMBERS, PRVECT_1, RELSET_1, RLVECT_5, RVSUM_1, STRUCT_0,
      SUBSET_1, VALUED_0, VECTSP_1, VECTSP_9, XBOOLE_0, XREAL_0,
      XXREAL_0, ORDINAL1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities FINSEQ_1, MATRIX13, STRUCT_0, SUBSET_1;
 expansions FINSEQ_1, STRUCT_0, TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for n being Nat st 0 < n
  for M being Matrix of 2*n+1,F_Real st
    (for i,j being Nat st [i,j] in Indices M holds
      M*(i,j) = -(M*(j,i))) &
    (for i,j being Nat st [i,j] in Indices M holds
      (j < i & i <= j+n implies M*(i,j) = 1) &
      (j+n < i implies M*(i,j) = -1))
  holds
    the_rank_of M = 2*n
proof
end;
::$P+
