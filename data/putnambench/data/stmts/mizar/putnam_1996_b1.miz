:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_b1:
:: the number of minimal selfish subsets of {1,...,n} is the nth Fibonacci
:: number. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, NEWTON, PRE_FF, ARYTM_1,
    ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSET_1, CARD_1, NEWTON,
    PRE_FF;
  constructors RELSET_1, PARTFUN1, NAT_1, NAT_D, NEWTON, FINSET_1,
    CARD_1, PRE_FF;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NEWTON, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI;

begin

::$P-
theorem
  for n being Nat st 1 <= n holds
    card {S where S is Subset of Seg n :
      card S in S &
      (for T being Subset of S st T c< S holds not card T in T)}
    = Fib n
proof
end;
::$P+
