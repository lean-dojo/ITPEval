:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_b1:
:: for positive integers h and k, every positive real epsilon admits positive
:: integers m and n whose weighted square-root difference has absolute value
:: strictly between epsilon and twice epsilon. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for h,k being Integer st h > 0 & k > 0 holds
    for e being Real st e > 0 holds
      ex m,n being Integer st
        m > 0 & n > 0 &
        e <
          |.(h qua Real) * sqrt(m qua Real) -
            (k qua Real) * sqrt(n qua Real).| &
        |.(h qua Real) * sqrt(m qua Real) -
          (k qua Real) * sqrt(n qua Real).| < 2 * e
proof
end;
::$P+
