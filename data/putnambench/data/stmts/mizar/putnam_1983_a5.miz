:: Statement-only formalization of PutnamBench corpus artifact putnam_1983_a5:
:: there exists a positive real number alpha such that floor(alpha^n) - n
:: is even for every positive natural number n. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, COMPLEX1, ORDINAL1, NEWTON,
    REALSET1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, SIN_COS, POWER, TAYLOR_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, COMPLEX1, INT_1,
    NEWTON, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
    RVSUM_1, FINSEQ_2, NAT_1, NAT_D, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SIN_COS, POWER, TAYLOR_1;
  constructors REAL_1, COMPLEX1, NAT_D, NEWTON, RELSET_1, PARTFUN1,
    FUNCT_2, NUMBERS, RVSUM_1, FINSEQOP, SEQ_2, COMSEQ_2, SIN_COS,
    POWER, TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON,
    VALUED_0, VALUED_1, CARD_1, COMPLEX1, SEQ_1, SIN_COS, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex alpha being Real st
    alpha > 0 &
    for n being Nat st n > 0 holds
      ex k being Integer st
        [\ alpha |^ n /] - (n qua Integer) = 2 * k
proof
end;
::$P+
