:: Statement-only formalization of PutnamBench corpus artifact putnam_1984_b5:
:: the alternating sum of m-th powers weighted by binary digit parity equals
:: (-1)^m times 2^(m(m-1)/2) times m!. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D, POWER;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m being Nat, d being Function of NAT,NAT st
    0 < m &
    (for n being Nat st n < 2 holds d.n = n) &
    (for n being Nat st 2 <= n holds
      d.n = (n mod 2) + d.(n div 2))
  holds
    ex terms being FinSequence of REAL st
      len terms = 2 |^ m &
      (for k being Nat st k < 2 |^ m holds
        terms.(k + 1) =
          (((-1) qua Real) |^ d.k) * ((k qua Real) |^ m)) &
      Sum terms =
        (((-1) qua Real) |^ m) *
        ((2 qua Real) to_power
          (((m qua Real) * ((m qua Real) - 1)) / 2)) *
        ((m !) qua Real)
proof
end;
::$P+
