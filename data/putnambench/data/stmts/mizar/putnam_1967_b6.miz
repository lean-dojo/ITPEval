:: Statement-only formalization of PutnamBench artifact putnam_1967_b6:
:: a real function whose horizontal and vertical sections are differentiable
:: everywhere and which is bounded by one on the closed unit disk has an
:: interior point where the sum of the squares of its partial derivatives is
:: at most sixteen. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0,
    SEQ_2, VALUED_1, FUNCT_2, FUNCOP_1, FUNCT_7, NAT_1, ZFMISC_1,
    BINOP_1, COMPLEX1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, ORDINAL1,
    RELAT_1, FUNCT_1, FUNCT_2, BINOP_1, NUMBERS, XREAL_0, XXREAL_0,
    XXREAL_2, XCMPLX_0, REAL_1, RELSET_1, VALUED_0, VALUED_1,
    SQUARE_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2, RCOMP_1,
    FCONT_1, FDIFF_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, SQUARE_1, RELSET_1, BINOP_2, COMSEQ_2, ZFMISC_1,
    XTUPLE_0;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0, SQUARE_1;
  expansions TARSKI;
  theorems TARSKI, NAT_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN2, RFUNCT_2,
    RCOMP_1, FCONT_1, FDIFF_1, ZFMISC_1, FUNCT_1, XREAL_0, XBOOLE_0,
    XBOOLE_1, XCMPLX_1, FUNCOP_1, XREAL_1, XXREAL_0, VALUED_1,
    XXREAL_2, XXREAL_1, FUNCT_2, VALUED_0, ORDINAL1, COMPLEX1;
  schemes SEQ_1;

begin

::$P-
theorem
  for f being Function of [:REAL,REAL:],REAL st
    (for y being Real holds
      ex fx being Function of REAL,REAL st
        (for t being Real holds fx.t = f.([t,y])) &
        fx is_differentiable_on [#]REAL) &
    (for x being Real holds
      ex fy being Function of REAL,REAL st
        (for t being Real holds fy.t = f.([x,t])) &
        fy is_differentiable_on [#]REAL) &
    (for x,y being Real st x^2 + y^2 <= 1 holds
      -1 <= f.([x,y]) & f.([x,y]) <= 1)
  holds
    ex x0,y0 being Real,
       fx,fy being Function of REAL,REAL st
      x0^2 + y0^2 < 1 &
      (for x being Real holds fx.x = f.([x,y0])) &
      (for y being Real holds fy.y = f.([x0,y])) &
      (diff(fx,x0))^2 + (diff(fy,y0))^2 <= 16
proof
end;
::$P+
