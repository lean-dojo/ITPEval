:: Statement-only formalization of PutnamBench corpus artifact putnam_2001_b5
:: (putnambench__mizar__putnam_2001_b5): a continuous real function satisfying
:: g(g(x)) = a*g(x) + b*x, with a and b in (0,1/2), is a scalar multiple
:: of the identity function. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, VALUED_1, XXREAL_2, COMPLEX1,
    RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b being Real, g being Function of REAL,REAL st
    0 < a & a < 1/2 &
    0 < b & b < 1/2 &
    g is continuous &
    (for x being Real holds
      g.(g.x) = a * g.x + b * x)
  holds
    ex c being Real st
      for x being Real holds
        g.x = c * x
proof
end;
::$P+
