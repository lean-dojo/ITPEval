:: Statement-only formalization of PutnamBench corpus artifact putnam_1983_a6:
:: the exponentially scaled integral of exp(x^3+y^3) over the triangle with
:: vertices (0,0), (a,0), and (0,a) tends to 2/9 as a tends to positive
:: infinity. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    NEWTON, PREPOWER, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
    INTEGRA5, SIN_COS, LIMFUNC1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON, PREPOWER,
    VALUED_0, VALUED_1, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, LIMFUNC1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NEWTON, PREPOWER, SIN_COS, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1, LIMFUNC1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for F being Function of REAL,REAL st
    (for a being Real holds
      ex I being Subset of REAL,
         g being Function of REAL,REAL st
        I = {x where x is Real : 0 <= x & x <= a} &
        (for x being Real st x in I holds
          ex J being Subset of REAL,
             h being Function of REAL,REAL st
            J = {y where y is Real : 0 <= y & y <= a - x} &
            (for y being Real st y in J holds
              h.y = exp_R.((x |^ 3) + (y |^ 3))) &
            g.x = Integral(L-Meas,h|J)) &
        F.a = ((a |^ 4) / exp_R.(a |^ 3)) * Integral(L-Meas,g|I))
  holds
    F is convergent_in+infty &
    lim_in+infty F = (2 qua Real) / 9
proof
end;
::$P+
