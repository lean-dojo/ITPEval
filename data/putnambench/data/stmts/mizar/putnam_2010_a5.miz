:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_a5:
:: an abstract group embedded injectively in real three-space, whose pairwise
:: cross products are either the embedded group product or zero, has all
:: pairwise cross products equal to zero. This file contains no proof.

environ

 vocabularies NUMBERS, REAL_1, SUBSET_1, PRE_TOPC, EUCLID, FINSEQ_1, STRUCT_0,
      FINSEQ_2, MCART_1, FUNCT_1, SUPINF_2, CARD_1, ARYTM_3, RELAT_1, ARYTM_1,
      RVSUM_1, BINOP_2, CARD_3, EUCLID_5, INCSP_1, XBOOLE_0, FUNCT_2,
      ALGSTR_0, GROUP_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      STRUCT_0, ALGSTR_0, GROUP_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
      BINOP_1, BINOP_2, FINSEQ_1, FINSEQ_2, FINSEQ_4, FINSEQOP, PRE_TOPC,
      RVSUM_1, RLVECT_1, EUCLID, REAL_1, INCSP_1, ANPROJ_2, EUCLID_5;
 constructors RELSET_1, FUNCT_2, GROUP_1, REAL_1, BINOP_2, FINSEQOP, FINSEQ_4,
      MONOID_0, EUCLID, BINOP_1, INCSP_1, ANPROJ_2, EUCLID_5;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      STRUCT_0, GROUP_1, NUMBERS, XREAL_0, MEMBERED, MONOID_0, EUCLID,
      VALUED_0, FINSEQ_2, RVSUM_1, FINSEQ_1;
 requirements REAL, SUBSET, NUMERALS, ARITHM, BOOLE;
 definitions ANPROJ_2;
 equalities ALGSTR_0;

begin

::$P-
theorem
  for G being Group,
      i being Function of G, TOP-REAL 3 st
    i is one-to-one &
    (for a,b being Element of G holds
      i.a <X> i.b = i.(a * b) or
      i.a <X> i.b = 0.TOP-REAL 3)
  holds
    for a,b being Element of G holds
      i.a <X> i.b = 0.TOP-REAL 3
proof
end;
::$P+
