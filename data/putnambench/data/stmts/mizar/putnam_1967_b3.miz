:: Statement-only formalization of PutnamBench artifact putnam_1967_b3:
:: for continuous real-valued functions of period one, the integrals of
:: f(x)g(nx) over the unit interval converge to the product of their
:: integrals. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, COMPLEX1,
      SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
      SEQ_1, SEQ_2, SEQ_4, NAT_1, ORDINAL2;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0, VALUED_1,
      COMPLEX1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
      SEQ_4;
 constructors RELSET_1, FUNCT_2, REAL_1, COMPLEX1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, SEQ_2, SEQ_4,
      SEQM_3, COMSEQ_2, BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, XXREAL_3, MEASURE1, MEASUR12, SEQ_4, NAT_1,
      MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for f,g being Function of REAL,REAL st
    (for x being Real holds
      for e being Real st 0 < e holds
        ex d being Real st 0 < d &
          for y being Real st |.y-x.| < d holds
            |.f.y-f.x.| < e) &
    (for x being Real holds
      for e being Real st 0 < e holds
        ex d being Real st 0 < d &
          for y being Real st |.y-x.| < d holds
            |.g.y-g.x.| < e) &
    (for x being Real holds f.(x+1) = f.x) &
    (for x being Real holds g.(x+1) = g.x)
  holds
    ex I being Subset of REAL, s being Real_Sequence st
      (for x being Real holds
        (x in I iff 0 <= x & x <= 1)) &
      (for n being Nat holds
        ex h being Function of REAL,REAL st
          (for x being Real holds
            h.x = f.x * g.((n qua Real) * x)) &
          s.n = Integral(L-Meas,h|I)) &
      s is convergent &
      lim s =
        Integral(L-Meas,f|I) * Integral(L-Meas,g|I)
proof
end;
::$P+
