:: Statement-only formalization of PutnamBench corpus artifact putnam_2020_b5
:: (putnambench__mizar__putnam_2020_b5): four complex numbers of unit modulus,
:: each different from one, make a specified expression nonzero. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, COMPLEX1,
    INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for z1,z2,z3,z4 being Complex st
    |.z1.| = 1 &
    |.z2.| = 1 &
    |.z3.| = 1 &
    |.z4.| = 1 &
    z1 <> 1 &
    z2 <> 1 &
    z3 <> 1 &
    z4 <> 1
  holds
    3 - z1 - z2 - z3 - z4 + z1 * z2 * z3 * z4 <> 0
proof
end;
::$P+
