:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_b1:
:: 3987 is the smallest positive integer n such that every integer m with
:: 0 < m < 1993 admits an integer k strictly between the specified rational
:: bounds after division by n. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  0 < (3987 qua Nat) &
  (for m being Integer st 0 < m & m < 1993 holds
    ex k being Integer st
      (m qua Real) / (1993 qua Real) <
        (k qua Real) / (3987 qua Real) &
      (k qua Real) / (3987 qua Real) <
        ((m + 1) qua Real) / (1994 qua Real)) &
  (for n being Nat st
    0 < n &
    (for m being Integer st 0 < m & m < 1993 holds
      ex k being Integer st
        (m qua Real) / (1993 qua Real) <
          (k qua Real) / (n qua Real) &
        (k qua Real) / (n qua Real) <
          ((m + 1) qua Real) / (1994 qua Real))
  holds (3987 qua Nat) <= n)
proof
end;
::$P+
