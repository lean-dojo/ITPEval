:: Statement-only formalization of PutnamBench artifact putnam_1972_a3:
:: the real functions on [0,1] that preserve existence of Cesaro limits
:: for all [0,1]-valued sequences are exactly the affine functions there.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL1, ORDINAL2, SEQ_4, SERIES_1, RCOMP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    COMSEQ_2, SEQM_3, SEQ_4, SERIES_1, RCOMP_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2, COMSEQ_2,
    SERIES_1, RCOMP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of REAL,REAL holds
    ((for x being Real_Sequence st
        (for n being Nat holds 0 <= x.n & x.n <= 1)
      holds
        (ex a being Real_Sequence st
          (for n being Nat holds
            a.n = Partial_Sums(x).(n-'1) / (n qua Real)) &
          a is convergent)
        implies
        ex y,b being Real_Sequence st
          (for n being Nat holds y.n = f.(x.n)) &
          (for n being Nat holds
            b.n = Partial_Sums(y).(n-'1) / (n qua Real)) &
          b is convergent)
    iff
      ex A,B being Real st
        for r being Real st r in [.0,1.] holds
          f.r = A*r+B)
proof
end;
::$P+
