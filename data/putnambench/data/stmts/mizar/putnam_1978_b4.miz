:: Statement-only formalization of PutnamBench artifact putnam_1978_b4:
:: four integers can be arbitrarily large while their sum of squares equals
:: the sum of their four triple products. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, SQUARE_1,
    REAL_1, VALUED_0, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, RELAT_1,
    XXREAL_0;
  constructors REAL_1, SQUARE_1, NAT_1, INT_1, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for N being Real holds
    ex a,b,c,d being Integer st
      (a qua Real) > N &
      (b qua Real) > N &
      (c qua Real) > N &
      (d qua Real) > N &
      a^2 + b^2 + c^2 + d^2 =
        a*b*c + a*b*d + a*c*d + b*c*d
proof
end;
::$P+
