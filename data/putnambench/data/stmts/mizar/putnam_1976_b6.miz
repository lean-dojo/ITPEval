:: Statement-only formalization of PutnamBench corpus artifact putnam_1976_b6:
:: every natural number whose sum of positive divisors is twice the number
:: plus one is the square of an odd integer. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3, MEMBERED,
    ABIAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, MEMBERED, NAT_1, NAT_D, ABIAN;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    ABIAN;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    VALUED_0, VALUED_1, CARD_1, MEMBERED, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for N being Nat st
    Sum Sgm { d where d is Element of Seg N : d divides N } = 2 * N + 1
  holds
    ex m being Integer st
      m is odd &
      m * m = N
proof
end;
::$P+
