:: Statement-only formalization of PutnamBench artifact putnam_1972_b5:
:: a skew quadrilateral in real Euclidean three-space with two pairs of equal
:: opposite angles has equal corresponding opposite sides. This file contains no proof.

environ

 vocabularies REAL_1, NAT_1, SUBSET_1, NUMBERS, CARD_1, RELAT_1, ARYTM_3,
      EUCLID, FINSEQ_2, COMPLEX1, ARYTM_1, SQUARE_1, RVSUM_1, FINSEQ_1,
      XXREAL_0, PRE_TOPC, STRUCT_0, SIN_COS, SIN_COS6, XBOOLE_0, RLTOPSP1,
      METRIC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, COMPLEX1, REAL_1, STRUCT_0, PRE_TOPC, METRIC_1, FINSEQ_1,
      FINSEQ_2, RVSUM_1, SQUARE_1, RLVECT_1, RLTOPSP1, EUCLID, TOPREAL6,
      XXREAL_0, SIN_COS, SIN_COS6;
 constructors REAL_1, SQUARE_1, BINOP_2, COMPLEX1, FINSEQOP, MONOID_0,
      RLTOPSP1, EUCLID, TOPREAL6, RELSET_1, BINOP_1, SIN_COS, SIN_COS6;
 registrations RELSET_1, NUMBERS, XREAL_0, BINOP_2, MEMBERED, MONOID_0,
      EUCLID, VALUED_0, VALUED_1, SQUARE_1, SIN_COS, SIN_COS6, ORDINAL1;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
 equalities SQUARE_1, RVSUM_1, EUCLID, VALUED_1;
 expansions XBOOLE_0, RVSUM_1;

begin

::$P-
theorem
  for A,B,C,D being Point of TOP-REAL 3 st
    not (ex u,v being Point of TOP-REAL 3 st
      for x,y being Point of TOP-REAL 3 st
        (x = A or x = B or x = C or x = D) &
        (y = A or y = B or y = C or y = D)
      holds ex c,d being Real st x-y = c*u + d*v) &
    arccos (|(A-B,C-B)| / (|.A-B.| * |.C-B.|)) =
      arccos (|(C-D,A-D)| / (|.C-D.| * |.A-D.|)) &
    arccos (|(B-C,D-C)| / (|.B-C.| * |.D-C.|)) =
      arccos (|(D-A,B-A)| / (|.D-A.| * |.B-A.|))
  holds
    dist(A,B) = dist(C,D) & dist(B,C) = dist(D,A)
proof
end;
::$P+
