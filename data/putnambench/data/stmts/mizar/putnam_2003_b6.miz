:: Statement-only formalization of PutnamBench corpus artifact putnam_2003_b6
:: (putnambench__mizar__putnam_2003_b6): the iterated integral over the unit
:: square of |f(x)+f(y)| for a continuous real function is at least the
:: integral over the unit interval of |f(x)|. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, COMPLEX1,
      SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
      SEQ_1, SEQ_2, SEQ_4, RCOMP_1, FCONT_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0, VALUED_1,
      COMPLEX1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1, SEQ_1, SEQ_4, PARTFUN2,
      FCONT_1;
 constructors RELSET_1, FUNCT_2, REAL_1, COMPLEX1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, PARTFUN2,
      RFUNCT_2, FCONT_1, SEQ_2, SEQ_4;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, XXREAL_3, MEASURE1, MEASUR12, RCOMP_1, FCONT_1,
      MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1, FCONT_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    (for x being Real holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st |.y-x.| < delta holds
            |.f.y-f.x.| < epsilon)
  holds
    ex I being Element of L-Field,
       absf,outer being Function of REAL,REAL st
      I = {x where x is Real : 0 <= x & x <= 1} &
      (for x being Real holds absf.x = |.f.x.|) &
      (for x being Real st x in I holds
        ex inner being Function of REAL,REAL st
          (for y being Real holds
            inner.y = |.f.x + f.y.|) &
          outer.x = Integral(L-Meas,inner|I)) &
      Integral(L-Meas,absf|I) <= Integral(L-Meas,outer|I)
proof
end;
::$P+
