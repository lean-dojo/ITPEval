:: Statement-only formalization of PutnamBench artifact putnam_1965_b6:
:: four distinct real-plane points such that every circle through the first
:: pair meets every circle through the second pair are collinear or cocyclic.
:: This file contains no proof.

environ

 vocabularies REAL_1, NAT_1, SUBSET_1, NUMBERS, RELAT_1, ARYTM_3, EUCLID,
      FINSEQ_2, COMPLEX1, ARYTM_1, SQUARE_1, RVSUM_1, FINSEQ_1, XXREAL_0,
      PRE_TOPC, STRUCT_0, XBOOLE_0, RLTOPSP1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, COMPLEX1, REAL_1, STRUCT_0, PRE_TOPC, FINSEQ_1, FINSEQ_2,
      RVSUM_1, SQUARE_1, RLVECT_1, RLTOPSP1, EUCLID, XXREAL_0;
 constructors REAL_1, SQUARE_1, BINOP_2, COMPLEX1, FINSEQOP, MONOID_0,
      RLTOPSP1, EUCLID, RELSET_1, BINOP_1;
 registrations RELSET_1, NUMBERS, XREAL_0, BINOP_2, MEMBERED, MONOID_0,
      EUCLID, VALUED_0, VALUED_1, SQUARE_1, ORDINAL1;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
 equalities SQUARE_1, RVSUM_1, EUCLID, VALUED_1;
 expansions XBOOLE_0, RVSUM_1;

begin

::$P-
theorem
  for A,B,C,D being Point of TOP-REAL 2 st
    A <> B & A <> C & A <> D & B <> C & B <> D & C <> D &
    (for P,Q being Point of TOP-REAL 2 st
      A <> P & C <> Q &
      |.A-P.| = |.B-P.| &
      |.C-Q.| = |.D-Q.|
    holds ex I being Point of TOP-REAL 2 st
      |.I-P.| = |.A-P.| & |.I-Q.| = |.C-Q.|)
  holds
    (ex L being line of TOP-REAL 2 st
      A in L & B in L & C in L & D in L) or
    (ex P being Point of TOP-REAL 2 st
      |.A-P.| = |.B-P.| &
      |.A-P.| = |.C-P.| &
      |.A-P.| = |.D-P.|)
proof
end;
::$P+
