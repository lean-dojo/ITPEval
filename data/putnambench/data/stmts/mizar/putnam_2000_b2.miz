:: Statement-only formalization of PutnamBench corpus artifact putnam_2000_b2:
:: for all natural numbers 1 <= m <= n, n divides the product of gcd(m,n)
:: and the binomial coefficient n choose m. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, SQUARE_1, SIN_COS,
    REAL_1, VALUED_0, INT_1, INT_2, NEWTON, REALSET1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, INT_2, NAT_D,
    RELAT_1, SIN_COS, XXREAL_0, NEWTON;
  constructors REAL_1, SQUARE_1, NAT_1, NAT_D, SIN_COS, RELSET_1,
    NEWTON;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    SIN_COS, VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1, NEWTON;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for m,n being Nat st 1 <= m & m <= n holds
    n divides (m gcd n) * (n choose m)
proof
end;
::$P+
