:: Statement-only formalization of PutnamBench artifact putnam_1969_a5:
:: equality of two real initial values is equivalent to the existence of
:: globally differentiable trajectories driven to zero at a positive time by
:: one continuous control in a coupled linear ODE system. This file contains
:: no proof.

environ

  vocabularies NUMBERS, REAL_1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0,
    SEQ_2, VALUED_1, FUNCT_2, COMPLEX1, FCONT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, FDIFF_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x0,y0,t being Real st 0 < t holds
    (x0 = y0 iff
      ex x,y,u being Function of REAL,REAL st
        x is_differentiable_on [#]REAL &
        y is_differentiable_on [#]REAL &
        u is continuous &
        (for p being Real holds
          diff(x,p) = -2 * y.p + u.p) &
        (for p being Real holds
          diff(y,p) = -2 * x.p + u.p) &
        x.0 = x0 &
        y.0 = y0 &
        x.t = 0 &
        y.t = 0)
proof
end;
::$P+
