:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_b1
:: (putnambench__mizar__putnam_2025_b1): a two-coloring of the real plane
:: closed under circumcenters of monochromatic noncollinear triples is
:: constant. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, METRIC_1, NAT_1, NUMBERS,
      PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1, SQUARE_1,
      STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1, XBOOLE_0,
      XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2,
      SQUARE_1, STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1,
      EUCLID, RVSUM_1, TOPMETR, TOPREAL6;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1,
      RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, TOPREAL6;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  for color being Function of the carrier of TOP-REAL 2, Seg 2 st
    (for A,B,C,O being Point of TOP-REAL 2 st
      (B.1 - A.1) * (C.2 - A.2) <>
        (B.2 - A.2) * (C.1 - A.1) &
      color.A = color.B & color.B = color.C &
      dist(O,A) = dist(O,B) & dist(O,B) = dist(O,C)
    holds color.O = color.A)
  holds
    ex c being Element of Seg 2 st
      for P being Point of TOP-REAL 2 holds color.P = c
proof
end;
::$P+
