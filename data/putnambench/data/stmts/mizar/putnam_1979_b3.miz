:: Statement-only formalization of PutnamBench corpus artifact putnam_1979_b3:
:: over an odd-order finite field, exactly (n-1)/2 constant shifts of an
:: irreducible monic quadratic remain irreducible. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      NUMBERS, NAT_1, CARD_1, ORDINAL1, STRUCT_0, ALGSTR_0, VECTSP_1,
      RLVECT_1, GROUP_1, BINOP_1, ARYTM_1, ARYTM_3, XCMPLX_0, XXREAL_0,
      ABIAN, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM5, RING_2, RING_4,
      FINSET_1, FINSEQ_1, AFINSQ_1, INT_1, INT_2, MEMBERED, FIELD_9,
      RATFUNC1, CAT_1, YELLOW_8;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
      FINSEQ_1, XCMPLX_0, XXREAL_0, NAT_1, NAT_D, INT_1, INT_2, MEMBERED,
      ABIAN,
      RELAT_1, FUNCT_1, FUNCT_2, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1,
      VECTSP_1, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, RING_2, RING_3,
      RING_4, RATFUNC1, FIELD_9;
 constructors RELSET_1, NAT_D, ABIAN, STRUCT_0, ALGSEQ_1, POLYNOM4,
      POLYNOM5, RING_2, RING_3, RING_4, AFINSQ_1, POLYNOM1, FIELD_4,
      RATFUNC1, FIELD_9;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1,
      XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, MEMBERED, STRUCT_0, ALGSTR_0,
      ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, FINSET_1, FRAENKEL, ABIAN,
      ALGSEQ_1, POLYNOM1, POLYNOM3, POLYNOM4, POLYNOM5, RATFUNC1, RING_2,
      RING_3, RING_4, FIELD_3, FIELD_4, FIELD_9;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, ALGSEQ_1;
 equalities STRUCT_0, ALGSTR_0, POLYNOM3;
 expansions TARSKI, ALGSEQ_1;

begin

::$P-
theorem
  for F being finite Field,
      n being Nat,
      b,c being Element of F,
      p being Element of the carrier of Polynom-Ring F st
    n = card the carrier of F &
    n is odd &
    p.0 = c &
    p.1 = b &
    p is monic &
    len p = 3 &
    p is irreducible
  holds
    card {d where d is Element of F :
      ex q being Element of the carrier of Polynom-Ring F st
        q = p + <%d%> & q is irreducible} = (n -' 1) div 2
proof
end;
::$P+
