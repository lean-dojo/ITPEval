:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_b5
:: (putnambench__mizar__putnam_2009_b5): every differentiable real function
:: satisfying the specified nonlinear differential equation on (1,+infinity)
:: tends to positive infinity. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, LIMFUNC1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, LIMFUNC1, FDIFF_1, COMPLEX1, NEWTON;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, LIMFUNC1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2, NEWTON;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    f is_differentiable_on right_open_halfline(1) &
    (for x being Real st 1 < x holds
      diff(f,x) =
        (x*x - f.x*f.x) / ((x*x) * (f.x*f.x + 1)))
  holds f is divergent_in+infty_to+infty
proof
end;
::$P+
