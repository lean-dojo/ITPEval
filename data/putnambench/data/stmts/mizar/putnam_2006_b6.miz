:: Statement-only formalization of PutnamBench corpus artifact putnam_2006_b6:
:: for k > 1, the normalized power of a positive-starting real sequence
:: defined by reciprocal k-th-root increments converges to ((k+1)/k)^k.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER,
    POWER, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2, SEQ_4;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, POWER,
    BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, POWER,
    SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for k being Nat, a,s being Real_Sequence st
    k > 1 &
    a.0 > 0 &
    (for n being Nat holds
      a.(n+1) =
        a.n + 1 / (a.n to_power ((1 qua Real) / (k qua Real)))) &
    (for n being Nat holds
      s.n = (a.n |^ (k+1)) / ((n qua Real) |^ k))
  holds
    s is convergent &
    lim s =
      (((k qua Real) + 1) / (k qua Real)) |^ k
proof
end;
::$P+
