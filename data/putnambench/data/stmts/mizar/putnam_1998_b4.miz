:: Statement-only formalization of PutnamBench corpus artifact putnam_1998_b4:
:: for positive natural numbers m and n, the alternating floor-quotient sum
:: vanishes exactly when their 2-adic valuations differ. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,n being Nat st 0 < m & 0 < n holds
    (ex terms being FinSequence of INT st
      len terms = m * n &
      (for i being Nat st i < m * n holds
        terms.(i + 1) =
          ((-1) qua Integer) |^ (i div m + i div n)) &
      Sum terms = 0)
    iff
    (for a,b being Nat st
      (2 |^ a) divides m &
      not (2 |^ (a + 1)) divides m &
      (2 |^ b) divides n &
      not (2 |^ (b + 1)) divides n
    holds a <> b)
proof
end;
::$P+
