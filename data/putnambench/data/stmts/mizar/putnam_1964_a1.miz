:: Statement-only formalization of PutnamBench artifact putnam_1964_a1:
:: for six distinct points in the real plane, the longest pairwise distance
:: divided by the shortest is at least sqrt 3. This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, REAL_1, RELAT_1, TARSKI, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, XXREAL_2, XBOOLE_0, RLTOPSP1, PRE_TOPC, EUCLID,
      METRIC_1, STRUCT_0, SQUARE_1, FINSET_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, XCMPLX_0, NUMBERS, XREAL_0, XXREAL_0,
      REAL_1, ORDINAL1, CARD_1, FINSET_1, METRIC_1, STRUCT_0, PRE_TOPC,
      RLVECT_1, RLTOPSP1, EUCLID, TOPREAL6, SQUARE_1, XXREAL_2;
 constructors REAL_1, RLTOPSP1, EUCLID, TOPREAL6, SQUARE_1, XXREAL_2,
      FINSET_1, RELSET_1;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XXREAL_0, XXREAL_2, XREAL_0,
      STRUCT_0, EUCLID, ORDINAL1, FINSET_1, NUMBERS, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for A being finite Subset of TOP-REAL 2,
      dists being non empty finite Subset of REAL st
    card A = 6 &
    dists = {d where d is Real :
      ex a,b being Point of TOP-REAL 2 st
        a in A & b in A & a <> b & d = dist(a,b)}
  holds max dists / min dists >= sqrt 3
proof
end;
::$P+
