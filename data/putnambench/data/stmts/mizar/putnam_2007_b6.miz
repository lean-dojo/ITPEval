:: Statement-only formalization of PutnamBench corpus artifact putnam_2007_b6:
:: the number of unordered factorial-coin collections summing to n factorial
:: satisfies uniform real exponential-power bounds. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, NAT_1, INT_1, VALUED_0, VALUED_1,
    ORDINAL1, NEWTON, REALSET1, PREPOWER, POWER, FINSEQ_1, FINSEQ_2,
    CARD_3, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, SQUARE_1, XXREAL_0, INT_1, NAT_1, NAT_D, NEWTON, PREPOWER,
    POWER, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1, SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    SQUARE_1, XXREAL_0, INT_1, NAT_1, NAT_D, NEWTON, PREPOWER, POWER,
    FINSEQ_1, FINSEQ_2, RVSUM_1, FINSEQOP, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, FINSEQ_1, FINSEQ_2, RVSUM_1, SIN_COS, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT st
    (for n being Nat holds
      f.n = card {coins where coins is FinSequence of NAT :
        Sum coins = (n!) &
        (for i being Nat st i in dom coins holds
          ex k being Nat st
            1 <= k & k <= n & coins.i = (k!)) &
        (for i,j being Nat st
          i in dom coins & j in dom coins & i < j holds
            coins.i <= coins.j)})
  holds
    ex C being Real st
      for n being Nat st 2 <= n holds
        ((n qua Real) to_power
            (((n qua Real)^2) / 2 - C * (n qua Real))) *
              exp_R.(-(((n qua Real)^2) / 4)) <= (f.n qua Real) &
        (f.n qua Real) <=
          ((n qua Real) to_power
            (((n qua Real)^2) / 2 + C * (n qua Real))) *
              exp_R.(-(((n qua Real)^2) / 4))
proof
end;
::$P+
