:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_a5
:: (putnambench__mizar__putnam_2023_a5): the complex roots of a finite
:: polynomial sum weighted by counts of ones in base-3 expansions are three
:: explicitly specified values. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, FUNCT_2, TARSKI, XREAL_0,
    ORDINAL4, BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, SQUARE_1, FUNCOP_1,
    REAL_1, FINSEQOP, ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0,
    SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1,
    COMPLEX1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1,
    SQUARE_1, RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2,
    BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1,
    NAT_D, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, INT_1, NEWTON;
  constructors PARTFUN1, BINOP_1, SETWISEO, SQUARE_1, NAT_1, NAT_D,
    BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2,
    RELSET_1, XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1, INT_1, COMPLEX1,
    NEWTON;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, SQUARE_1, NAT_1,
    BINOP_2, FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1,
    FINSEQ_4, CARD_1, INT_1, RVSUM_1, RELSET_1, MEMBERED, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for numones being Function of NAT,NAT st
    numones.0 = 0 &
    (for n being Nat st 0 < n holds
      ((n mod 3 = 1 & numones.n = 1 + numones.(n div 3)) or
       (n mod 3 <> 1 & numones.n = numones.(n div 3))))
  holds
    for z being Complex holds
      ((ex terms being FinSequence of COMPLEX st
          len terms = 3 |^ 1010 &
          (for k being Nat st k < 3 |^ 1010 holds
            terms.(k + 1) =
              (((-2) qua Complex) |^ numones.k) *
                ((z + (k qua Complex)) |^ 2023)) &
          Sum terms = 0)
      iff
        z = -((((3 |^ 1010) -' 1) qua Complex) / 2) or
        z = -((((3 |^ 1010) -' 1) qua Complex) / 2) +
          (sqrt (((9 |^ 1010) -' 1) qua Real) qua Complex) * <i> / 4 or
        z = -((((3 |^ 1010) -' 1) qua Complex) / 2) -
          (sqrt (((9 |^ 1010) -' 1) qua Real) qua Complex) * <i> / 4)
proof
end;
::$P+
