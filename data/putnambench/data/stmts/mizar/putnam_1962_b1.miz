:: Statement-only formalization of PutnamBench artifact putnam_1962_b1:
:: the binomial convolution identity for real falling factorials. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p being Function of NAT,Funcs(REAL,REAL) holds
  for x,y being Element of REAL holds
  for n being Nat st
    (for z being Element of REAL holds (p.0).z = 1) &
    (for m being Nat st 0 < m holds
      for z being Element of REAL
      ex factors being FinSequence of REAL st
        len factors = m &
        (for j being Nat st j in Seg m holds
          factors.j = z - (j -' 1)) &
        (p.m).z = Product factors)
  holds
    ex terms being FinSequence of REAL st
      len terms = n + 1 &
      (for j being Nat,
           pk,qk being Function of REAL,REAL
        st j in Seg (n + 1) &
           pk = p.(j -' 1) &
           qk = p.(n -' (j -' 1))
        holds
        terms.j =
          pk.x *
          (n choose (j -' 1)) *
          qk.y) &
      (p.n).(x + y) = Sum terms
proof
end;
::$P+
