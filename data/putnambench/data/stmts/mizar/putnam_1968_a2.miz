:: Statement-only formalization of PutnamBench artifact putnam_1968_a2:
:: rational simultaneous approximations to two integer linear forms with
:: nonzero determinant. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b,c,d,e,f being Integer, eps being Real st
    a*d <> b*c & eps > 0
  holds
    ex r,s being Rational st
      0 < |.r*a + s*b - e.| &
      |.r*a + s*b - e.| < eps &
      0 < |.r*c + s*d - f.| &
      |.r*c + s*d - f.| < eps
proof
end;
::$P+
