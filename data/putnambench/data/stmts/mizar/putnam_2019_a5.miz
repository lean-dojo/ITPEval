:: Statement-only formalization of PutnamBench corpus artifact putnam_2019_a5:
:: for an odd prime p, the greatest n such that (X-1)^n divides the
:: polynomial over the integers modulo p with coefficient
:: k^((p-1)/2) modulo p in degree k is (p-1)/2. This file contains no proof.

environ
  vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1,
    NAT_1, INT_1, INT_2, INT_3, ABIAN, NEWTON, POLYNOM1, VECTSP_1,
    SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3, FUNCT_4, STRUCT_0,
    XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1, FUNCT_2,
    SUPINF_2, NUMBERS, VALUED_0, VALUED_1, MESFUNC1, FINSEQ_1,
    AFINSQ_1, RLVECT_1, CARD_3, BINOP_1, TARSKI, POLYNOM5,
    PARTFUN1, LATTICES, ORDINAL4, FINSEQ_2, VECTSP_2, ZFMISC_1,
    ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, REAL_1, INT_1, INT_2, NAT_1, NAT_D, ABIAN,
    NEWTON, VALUED_0, FINSEQ_1, FINSEQ_2, FUNCT_7, STRUCT_0,
    ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2,
    ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, INT_3;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_D, ABIAN, NEWTON,
    ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
    VECTSP_2, ALGSTR_1, INT_3;
  registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0,
    VECTSP_1, CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0,
    RLVECT_1, MEMBERED, RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS,
    FUNCT_2, XBOOLE_0, SUBSET_1, NAT_1, INT_1, INT_2, INT_3,
    ABIAN, NEWTON, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2,
    VECTSP_2, ALGSTR_1;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
  equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
    ALGSTR_0;
  expansions TARSKI, ALGSEQ_1, POLYNOM5;
  theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3,
    POLYNOM4, POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0,
    INT_1, INT_2, INT_3, NEWTON;

begin

::$P-
theorem
  for p being Prime,
      q being Polynomial of INT.Ring(p) st
    p is odd &
    q.0 = 0.INT.Ring(p) &
    (for k being Nat st 1 <= k & k <= p -' 1 holds
      q.k = (k |^ ((p -' 1) div 2)) mod p) &
    (for k being Nat st k > p -' 1 holds
      q.k = 0.INT.Ring(p))
  holds
    (ex r being Polynomial of INT.Ring(p) st
      q = (<%-1.INT.Ring(p),1.INT.Ring(p)%>
        `^ ((p -' 1) div 2)) *' r) &
    (for n being Nat st
      ex r being Polynomial of INT.Ring(p) st
        q = (<%-1.INT.Ring(p),1.INT.Ring(p)%> `^ n) *' r
     holds n <= (p -' 1) div 2)
proof
end;
::$P+
