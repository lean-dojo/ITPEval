:: Statement-only formalization of PutnamBench corpus artifact putnam_2022_b5:
:: the parameters for which zero is a most probable value of every integer
:: linear combination of independent random variables taking -1, 0, and 1.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, INT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1,
    ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1, RVSUM_1, REAL_1,
    BINOP_1, BINOP_2, SETWISEO, SETWOP_2, FINSOP_1, FINSEQOP;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NAT_1,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, BINOP_1, BINOP_2,
    SETWISEO, FINSEQ_1, FINSEQ_2, FINSEQ_4, FINSET_1, FINSOP_1,
    FINSEQOP, SETWOP_2, RVSUM_1, VALUED_0, VALUED_1;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, NAT_1, RVSUM_1,
    FINSEQOP, FINSET_1, REAL_1, BINOP_1, BINOP_2, SETWISEO,
    FINSOP_1, SETWOP_2, XXREAL_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1,
    VALUED_0, VALUED_1, RVSUM_1, BINOP_2, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1, RVSUM_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for p being Real holds
    (0 <= p & p <= 1/2 &
      for n being Nat st 0 < n holds
        for a being FinSequence of INT, b being Integer st len a = n holds
          ex outcomes being one-to-one FinSequence of INT*,
             mass0,massb being FinSequence of REAL st
            rng outcomes =
              {x where x is FinSequence of INT :
                len x = n &
                (for i being Nat st i in Seg n holds
                  x.i = 1 or x.i = -1 or x.i = 0)} &
            len mass0 = len outcomes &
            len massb = len outcomes &
            (for k being Nat st k in dom outcomes holds
              ex x,dotterms being FinSequence of INT,
                 factors being FinSequence of REAL st
                x = outcomes.k &
                len dotterms = n &
                len factors = n &
                (for i being Nat st i in Seg n holds
                  dotterms.i = a.i * x.i &
                  (((x.i = 1 or x.i = -1) & factors.i = p) or
                   (x.i = 0 & factors.i = 1 - 2*p))) &
                ((Sum dotterms = 0 & mass0.k = Product factors) or
                 (Sum dotterms <> 0 & mass0.k = 0)) &
                ((Sum dotterms = b & massb.k = Product factors) or
                 (Sum dotterms <> b & massb.k = 0))) &
            Sum mass0 >= Sum massb)
    iff
      0 <= p & p <= 1/4
proof
end;
::$P+
