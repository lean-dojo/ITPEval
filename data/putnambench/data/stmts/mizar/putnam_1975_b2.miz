:: Statement-only formalization of PutnamBench artifact putnam_1975_b2:
:: a countable family of open slabs in three-dimensional Euclidean space
:: whose positive thicknesses have convergent sum does not cover the space.
:: This file contains no proof.

environ
  vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
    FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, METRIC_1, NAT_1, NEWTON,
    NUMBERS, ORDINAL1, ORDINAL2, PREPOWER, PRE_TOPC, REAL_1, RELAT_1,
    RLTOPSP1, RLVECT_1, RVSUM_1, SEQ_1, SEQ_2, SEQ_4, SERIES_1,
    SQUARE_1, STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1,
    XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1, CARD_1,
    RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, VALUED_1,
    FINSEQ_1, FINSEQ_2, SQUARE_1, STRUCT_0, PRE_TOPC, METRIC_1,
    RLVECT_1, RLTOPSP1, EUCLID, RVSUM_1, TOPMETR, SEQ_1, SEQ_2,
    COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, SERIES_1;
  constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
    FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, RLVECT_1,
    RLTOPSP1, EUCLID, TOPMETR, FUNCT_1, CARD_1, XXREAL_0, NEWTON, NAT_1,
    SEQ_2, SEQM_3, SEQ_4, PREPOWER, COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
    CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
    STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
    MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1, XXREAL_0,
    XCMPLX_0, INT_1, NEWTON, PREPOWER, SEQ_4;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RLTOPSP1;
  equalities STRUCT_0, FINSEQ_1, FINSEQ_2, RVSUM_1, SQUARE_1, EUCLID,
    VALUED_1;
  expansions TARSKI, XBOOLE_0, FUNCT_1, RVSUM_1;

begin

::$P-
theorem
  for normals being sequence of REAL 3,
      offsets,thicknesses being Real_Sequence st
    (for i being Nat holds
      |.(normals.i).| = 1 &
      0 < thicknesses.i) &
    Partial_Sums(thicknesses) is convergent
  holds
    ex x being Element of REAL 3 st
      for i being Nat holds
        not (offsets.i < |(normals.i,x)| &
          |(normals.i,x)| < offsets.i + thicknesses.i)
proof
end;
::$P+
