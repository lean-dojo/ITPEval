:: Statement-only formalization of PutnamBench corpus artifact putnam_2012_b6:
:: the cubic permutation of residue classes modulo an odd prime p congruent
:: to 2 modulo 3 is even exactly when p is congruent to 3 modulo 4. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, NUMBERS,
    NAT_1, INT_1, INT_2, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1,
    FINSET_1, NEWTON, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    ABIAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NAT_1, NAT_D,
    RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, MATRIX_0,
    MATRIX_1, FINSET_1, NEWTON;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    NEWTON, FINSET_1, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2,
    NEWTON, VALUED_0, VALUED_1, MEMBERED, FRAENKEL, ABIAN;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1, MATRIX_0;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for p being Nat,
      P being Permutation of Seg p st
    p is prime &
    p mod 2 = 1 &
    p mod 3 = 2 &
    (for i being Nat st i in Seg p holds
      P.i = (((i -' 1) |^ 3) mod p) + 1)
  holds
    (P is even iff p mod 4 = 3)
proof
end;
::$P+
