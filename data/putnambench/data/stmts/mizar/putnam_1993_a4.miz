:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_a4:
:: equal subset sums exist for 19 positive integers bounded by 93 and 93
:: positive integers bounded by 19. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    RVSUM_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, FINSEQ_1,
    RVSUM_1, FINSEQ_2, NAT_1;
  constructors REAL_1, NAT_1, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x,y being FinSequence of INT st
    len x = 19 &
    len y = 93 &
    (for i being Nat st i in Seg 19 holds 0 < x.i & x.i <= 93) &
    (for j being Nat st j in Seg 93 holds 0 < y.j & y.j <= 19)
  holds
    ex I being Subset of Seg 19,
       J being Subset of Seg 93,
       xs,ys being FinSequence of INT st
      I <> {} &
      xs = x * Sgm I &
      ys = y * Sgm J &
      Sum xs = Sum ys
proof
end;
::$P+
