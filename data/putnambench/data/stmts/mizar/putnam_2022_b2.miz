:: Statement-only formalization of PutnamBench corpus artifact putnam_2022_b2
:: (putnambench__mizar__putnam_2022_b2): the positive cardinalities of finite
:: subsets of real three-space that equal their set of pairwise cross products
:: are exactly 1 and 7. This file contains no proof.

environ
  vocabularies NUMBERS, REAL_1, SUBSET_1, PRE_TOPC, EUCLID, FINSEQ_1,
    STRUCT_0, FINSEQ_2, MCART_1, FUNCT_1, SUPINF_2, CARD_1, ARYTM_3,
    RELAT_1, ARYTM_1, RVSUM_1, BINOP_2, CARD_3, EUCLID_5, INCSP_1,
    XBOOLE_0, FUNCT_2, ALGSTR_0, FINSET_1, NAT_1, TARSKI;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, STRUCT_0, ALGSTR_0, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, CARD_1, FINSET_1, BINOP_1, BINOP_2, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, FINSEQOP, PRE_TOPC, RVSUM_1, RLVECT_1, EUCLID,
    REAL_1, INCSP_1, ANPROJ_2, EUCLID_5;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, CARD_1, FINSET_1,
    BINOP_2, FINSEQOP, FINSEQ_4, MONOID_0, EUCLID, BINOP_1, INCSP_1,
    ANPROJ_2, EUCLID_5;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    STRUCT_0, NUMBERS, XREAL_0, XXREAL_0, NAT_1, ORDINAL1, CARD_1,
    FINSET_1, MEMBERED, MONOID_0, EUCLID, VALUED_0, FINSEQ_2, RVSUM_1,
    FINSEQ_1;
  requirements REAL, SUBSET, NUMERALS, ARITHM, BOOLE;
  definitions ANPROJ_2;
  equalities ALGSTR_0;

begin

::$P-
theorem
  for n being Nat holds
    ((0 < n &
      ex S being finite Subset of TOP-REAL 3 st
        card S = n &
        (for u being Point of TOP-REAL 3 holds
          (u in S iff
            ex v,w being Point of TOP-REAL 3 st
              v in S & w in S & u = v <X> w)))
      iff (n = 1 or n = 7))
proof
end;
::$P+
