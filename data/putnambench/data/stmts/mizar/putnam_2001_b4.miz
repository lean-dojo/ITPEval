:: Statement-only formalization of PutnamBench corpus artifact putnam_2001_b4
:: (putnambench__mizar__putnam_2001_b4): the intersection of all positive
:: iterated images of the rational map x |-> x - 1/x, starting outside
:: {-1,0,1}, is empty. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1, INT_2, NAT_1,
    VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4,
    BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, INT_2, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1,
    NAT_D, PARTFUN1, BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP,
    SETWOP_2, RVSUM_1, RAT_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, INT_2, XXREAL_0, NAT_1, NAT_D,
    BINOP_1, SETWISEO, BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4,
    FINSOP_1, SETWOP_2, XXREAL_1, FINSEQ_2, RVSUM_1, ZFMISC_1,
    RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, INT_2,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of RAT,RAT st
    (for x being Rational st x <> -1 & x <> 0 & x <> 1 holds
      f.x = x - 1/x) &
    (for x being Rational st x <> -1 & x <> 0 & x <> 1 holds
      f.x <> -1 & f.x <> 0 & f.x <> 1)
  holds
    not ex y being Rational st
      for n being Nat st 1 <= n holds
        ex orbit being FinSequence of RAT st
          len orbit = n + 1 &
          (for k being Nat st 1 <= k & k <= n + 1 holds
            orbit.k <> -1 & orbit.k <> 0 & orbit.k <> 1) &
          orbit.(n + 1) = y &
          (for k being Nat st 1 <= k & k <= n holds
            orbit.(k + 1) = f.(orbit.k))
proof
end;
::$P+
