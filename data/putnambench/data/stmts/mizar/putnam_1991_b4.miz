:: Statement-only formalization of PutnamBench corpus artifact putnam_1991_b4:
:: for every odd prime p, the binomial sum from j = 0 through p is congruent
:: to 2^p + 1 modulo p^2. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3,
    VALUED_0, VALUED_1, NEWTON, ABIAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NEWTON, NAT_1, NAT_D,
    ABIAN, WSIERP_1;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2, ABIAN, WSIERP_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED, NEWTON,
    ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p being Nat st p is prime & p is odd holds
    ex terms being FinSequence of NAT st
      len terms = p + 1 &
      (for j being Nat st j <= p holds
        terms.(j + 1) = (p choose j) * ((p + j) choose j)) &
      (Sum terms) mod (p |^ 2) = ((2 |^ p) + 1) mod (p |^ 2)
proof
end;
::$P+
