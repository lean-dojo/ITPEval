:: Statement-only formalization of PutnamBench artifact putnam_1973_a2:
:: an eight-periodic signed harmonic series converges exactly when its sign
:: block contains four plus signs and four minus signs. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, INT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, ORDINAL1,
    ORDINAL2, SEQ_4, SERIES_1, FINSEQ_1, FINSEQ_2, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, VALUED_0, VALUED_1,
    FINSEQ_1, FINSEQ_2, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
    SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, FINSEQ_1, FINSEQ_2, SEQ_2, SEQM_3,
    SEQ_4, BINOP_2, COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being FinSequence of REAL,
      pluses being Nat,
      S being Real_Sequence st
    len L = 8 &
    (for i being Nat st i < 8 holds
      L.(i + 1) = 1 or L.(i + 1) = -1) &
    pluses =
      card {i where i is Element of NAT :
        i < 8 & L.(i + 1) = 1} &
    (ex a being Real_Sequence st
      (for n being Nat holds
        a.n =
          L.(((n + 1) mod 8) + 1) / ((n + 1) qua Real)) &
      S.0 = 0 &
      (for n being Nat st 0 < n holds
        S.n = Partial_Sums(a).(n -' 1)))
  holds
    (pluses = 4 iff S is convergent)
proof
end;
::$P+
