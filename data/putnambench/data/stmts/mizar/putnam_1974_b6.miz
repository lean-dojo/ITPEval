:: Statement-only formalization of PutnamBench artifact putnam_1974_b6:
:: the numbers of subsets of a 1000-element set whose cardinalities are
:: congruent to 0, 1, and 2 modulo 3. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, NUMBERS, NAT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, NEWTON,
    ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    FINSET_1, CARD_1, NEWTON;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NEWTON, VALUED_0,
    VALUED_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  ex q being Nat st
    3 * q = ((2 qua Nat) |^ 1000) -' 1 &
    card {A where A is Subset of Seg 1000 :
      ex j being Nat st card A = 3 * j} = q &
    card {A where A is Subset of Seg 1000 :
      ex j being Nat st card A = 3 * j + 1} = q &
    card {A where A is Subset of Seg 1000 :
      ex j being Nat st card A = 3 * j + 2} = q + 1
proof
end;
::$P+
