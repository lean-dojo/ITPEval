:: Statement-only formalization of PutnamBench artifact putnam_1981_a1:
:: if E(n) is the greatest exponent k for which 5^k divides the product
:: 1^1 * 2^2 * ... * n^n, then E(n)/n^2 tends to 1/8.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1,
    SEQ_2, ORDINAL2, SEQ_4, FINSEQ_1, FINSEQ_2, ORDINAL4, BINOP_1,
    BINOP_2, FUNCOP_1, FINSEQOP, ZFMISC_1, CARD_3, SETWISEO,
    SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1, INT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, INT_2, COMPLEX1, XXREAL_0, NEWTON, NAT_1, NAT_D,
    PARTFUN1, BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP,
    SETWOP_2, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    RVSUM_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    COMPLEX1, INT_1, INT_2, XXREAL_0, NEWTON, NAT_1, NAT_D, BINOP_1,
    SETWISEO, BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1,
    SETWOP_2, XXREAL_1, FINSEQ_2, SEQ_2, SEQM_3, SEQ_4, PREPOWER,
    COMSEQ_2, RVSUM_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON, PREPOWER,
    SEQ_4, FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for E being Function of NAT,NAT st
    (for n being Nat st 1 <= n holds
      (ex factors being FinSequence of NAT st
        len factors = n &
        (for i being Nat st i in Seg n holds factors.i = i |^ i) &
        ex q being Nat st Product factors = (5 |^ E.n) * q) &
      (for k being Nat st
        (ex factors being FinSequence of NAT st
          len factors = n &
          (for i being Nat st i in Seg n holds factors.i = i |^ i) &
          ex q being Nat st Product factors = (5 |^ k) * q)
        holds k <= E.n))
  holds
    ex s being Real_Sequence st
      (for n being Nat holds
        s.n = (E.n qua Real) / ((n qua Real) |^ 2)) &
      s is convergent & lim s = (1 qua Real) / 8
proof
end;
::$P+
