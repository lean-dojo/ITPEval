:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_a3
:: (putnambench__mizar__putnam_2017_a3): positive continuous real functions
:: on a nondegenerate closed interval, with equal integrals but not identical,
:: yield a strictly increasing quotient-power integral sequence diverging to
:: positive infinity. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL2, SEQ_4, RCOMP_1,
    FCONT_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
    INTEGRA5, LIMFUNC1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON, NAT_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, VALUED_0,
    VALUED_1, RCOMP_1, FCONT_1, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, LIMFUNC1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NEWTON, SEQ_2, SEQM_3, SEQ_4, PREPOWER, RCOMP_1,
    FCONT_1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, LIMFUNC1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    SEQ_1, SEQ_2, SEQ_4, RCOMP_1, FCONT_1, XXREAL_3, MEASURE1,
    MEASUR12;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for a,b being Real,
      f,g being Function of REAL,REAL,
      I being Real_Sequence,
      C,J being Subset of REAL st
    a < b &
    C = {x where x is Real : a <= x & x <= b} &
    J = {x where x is Real : a < x & x < b} &
    f|C is continuous &
    g|C is continuous &
    (for x being Real st x in C holds 0 < f.x & 0 < g.x) &
    Integral(L-Meas,f|J) = Integral(L-Meas,g|J) &
    (ex x being Real st x in C & f.x <> g.x) &
    (for n being Nat st 0 < n holds
      ex h being Function of REAL,REAL st
        (for x being Real holds
          h.x = (f.x |^ (n + 1)) / (g.x |^ n)) &
        I.n = Integral(L-Meas,h|J))
  holds
    (for n being Nat st 0 < n holds I.n < I.(n + 1)) &
    I is divergent_to+infty
proof
end;
::$P+
