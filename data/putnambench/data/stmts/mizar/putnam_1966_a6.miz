:: Statement-only formalization of PutnamBench artifact putnam_1966_a6:
:: finite nested-radical recurrences whose first entries converge to 3.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, BINOP_1, BINOP_2, NUMBERS, XCMPLX_0, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, NAT_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2, SEQ_4,
    FUNCT_7;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, BINOP_1, BINOP_2;
  constructors NUMBERS, XCMPLX_0, XREAL_0, FUNCT_1, SUBSET_1, RELSET_1,
    FUNCT_2, CARD_1, REAL_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1,
    SEQ_2, SEQM_3, SEQ_4, COMSEQ_2, ZFMISC_1, BINOP_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, REAL_1, SQUARE_1, ORDINAL1, NAT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of [:NAT,NAT:],REAL st
    (for n being Nat st 1 <= n holds
      a.(n,n) = n &
      (for m being Nat st 1 <= m & m < n holds
        ex x being Real st
          x = a.(n,m + 1) &
          a.(n,m) = (m qua Real) * sqrt(1 + x)))
  holds
    ex s being Real_Sequence st
      (for n being Nat holds s.n = a.(n,1)) &
      s is convergent & lim s = 3
proof
end;
::$P+
