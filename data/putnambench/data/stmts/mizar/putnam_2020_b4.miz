:: Statement-only formalization of PutnamBench corpus artifact putnam_2020_b4
:: (putnambench__mizar__putnam_2020_b4): the average of
:: 1/(1 + sum 3^(interior height)) over length-4040 integer unit-step walks
:: returning to zero is 1/4040. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, INT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1,
    ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1, RVSUM_1, REAL_1,
    COMPLEX1, POWER;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NAT_1,
    NAT_D, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
    FINSEQ_2, FINSET_1, RVSUM_1, COMPLEX1, POWER;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, NAT_1, NAT_D, RVSUM_1,
    FINSEQOP, FINSET_1, REAL_1, COMPLEX1, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1,
    VALUED_0, VALUED_1, RVSUM_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for walks being one-to-one FinSequence of INT*,
      values being FinSequence of REAL st
    rng walks =
      {v where v is FinSequence of INT :
        len v = 4041 &
        v.1 = 0 &
        v.4041 = 0 &
        (for j being Nat st j in Seg 4040 holds
          |.v.(j + 1) - v.j.| = 1)} &
    len values = len walks &
    (for k being Nat st k in dom walks holds
      ex v being FinSequence of INT,
         powers being FinSequence of REAL st
        v = walks.k &
        len powers = 4039 &
        (for j being Nat st j in Seg 4039 holds
          powers.j =
            (3 qua Real) to_power (v.(j + 1) qua Real)) &
        values.k = 1 / (1 + Sum powers))
  holds
    Sum values / (len walks qua Real) = (1 qua Real) / 4040
proof
end;
::$P+
