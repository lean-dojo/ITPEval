:: Statement-only formalization of PutnamBench artifact putnam_1968_b5:
:: the number of 2 by 2 matrices over the field with p elements having
:: trace one and determinant zero is p^2 + p. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, NEWTON, INT_1, INT_2, INT_3, RING_3,
    STRUCT_0, ALGSTR_0, VECTSP_1, RLVECT_1, GROUP_1, BINOP_1, FUNCT_1, FUNCT_2,
    RELAT_1, XCMPLX_0, XREAL_0, XXREAL_0,
    FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, CARD_1, TARSKI, XBOOLE_0,
    SUBSET_1, ZFMISC_1, ARYTM_1, ARYTM_3, ORDINAL1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, NEWTON, INT_1,
    INT_2, RELAT_1, FUNCT_1, FUNCT_2, BINOP_1, FINSEQ_1, FINSEQ_2, STRUCT_0,
    ALGSTR_0, RLVECT_1, GROUP_1,
    VECTSP_1, INT_3, MATRIX_0, MATRIX_1, RING_3;
  constructors RELSET_1, BINOP_1, NAT_D, NEWTON, INT_3, RING_3, MATRIX_1;
  registrations XBOOLE_0, SUBSET_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NEWTON, STRUCT_0, ALGSTR_0, RLVECT_1,
    GROUP_1, VECTSP_1,
    INT_3, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities STRUCT_0, ALGSTR_0, FINSEQ_1, MATRIX_0;
  expansions TARSKI;

begin

::$P-
theorem
  for p being Prime holds
    card {M where M is Matrix of 2,INT.Ring(p) :
      (the addF of INT.Ring(p)).(M*(1,1),M*(2,2))
        = the OneF of INT.Ring(p) &
      (the multF of INT.Ring(p)).(M*(1,1),M*(2,2))
        = (the multF of INT.Ring(p)).(M*(1,2),M*(2,1))}
    = p * p + p
proof
end;
::$P+
