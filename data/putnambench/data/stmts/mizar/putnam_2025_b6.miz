:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_b6
:: (putnambench__mizar__putnam_2025_b6): the greatest real exponent admitting
:: a positive natural-valued function with the prescribed recursive growth
:: inequality is 1/4. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, ORDINAL1, PREPOWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, PREPOWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, PREPOWER, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, XCMPLX_0, XREAL_0,
    ORDINAL1, NAT_1, PREPOWER;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ((ex g being Function of NAT,NAT st
      (for n being Nat st 0 < n holds 0 < g.n) &
      (for n being Nat st 0 < n holds
        ((g.(g.n) qua Real) #R ((1 qua Real) / 4)) <=
          (g.(n + 1) qua Real) - (g.n qua Real))) &
   (for r being Real st
      (ex g being Function of NAT,NAT st
        (for n being Nat st 0 < n holds 0 < g.n) &
        (for n being Nat st 0 < n holds
          ((g.(g.n) qua Real) #R r) <=
            (g.(n + 1) qua Real) - (g.n qua Real)))
    holds
      r <= (1 qua Real) / 4))
proof
end;
::$P+
