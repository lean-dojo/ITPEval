:: Statement-only formalization of PutnamBench artifact putnam_1972_a6:
:: an integrable real function on [0,1] with vanishing moments below degree n
:: and normalized nth moment has large absolute value on a set of positive
:: Lebesgue measure. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, NAT_1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, NEWTON, COMPLEX1,
      RCOMP_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
      INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, XXREAL_0, XXREAL_1, XXREAL_3, NAT_1, NEWTON, COMPLEX1,
      RCOMP_1, VALUED_0, VALUED_1, SUPINF_2, MEASURE1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 constructors RELSET_1, FUNCT_2, NAT_1, REAL_1, NEWTON, COMPLEX1,
      RCOMP_1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
      EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XREAL_0, NAT_1, VALUED_0, VALUED_1,
      XXREAL_3, NEWTON, RCOMP_1, MEASURE1, MEASUR12, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for n being Nat,
      I being Element of L-Field,
      f being Function of REAL,REAL st
    I = {x where x is Real : 0 <= x & x <= 1} &
    f|I is_integrable_on L-Meas &
    (for i being Nat st i < n holds
      ex g being Function of REAL,REAL st
        (for x being Real holds g.x = (x |^ i) * f.x) &
        Integral(L-Meas,g|I) = 0) &
    (ex h being Function of REAL,REAL st
      (for x being Real holds h.x = (x |^ n) * f.x) &
      Integral(L-Meas,h|I) = 1)
  holds
    ex S being Element of L-Field st
      0 < L-Meas.S &
      for x being Real st x in S holds
        x in I &
        |.f.x.| >= ((2 qua Real) |^ n) * ((n + 1) qua Real)
proof
end;
::$P+
