:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_a1:
:: the greatest number of equal-sum boxes into which the integers from 1
:: through a positive integer n can be placed. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3, INT_1,
    INT_2, CARD_3, MEMBERED;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, RVSUM_1,
    MEMBERED, NAT_1, NAT_D, FINSET_1;
  constructors REAL_1, NAT_D, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP, FINSET_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0,
    VALUED_1, CARD_1, MEMBERED, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n > 0 holds
    (ex boxes being Function of Seg n, Seg ((n + 1) div 2) st
      for i,j being Element of Seg ((n + 1) div 2) holds
        Sum Sgm {x where x is Element of Seg n : boxes.x = i} =
        Sum Sgm {x where x is Element of Seg n : boxes.x = j}) &
    for k being Nat st
      (ex boxes being Function of Seg n, Seg k st
        for i,j being Element of Seg k holds
          Sum Sgm {x where x is Element of Seg n : boxes.x = i} =
          Sum Sgm {x where x is Element of Seg n : boxes.x = j})
    holds k <= (n + 1) div 2
proof
end;
::$P+
