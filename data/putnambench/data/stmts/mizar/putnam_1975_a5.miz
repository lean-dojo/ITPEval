:: Statement-only formalization of PutnamBench artifact putnam_1975_a5:
:: positive linearly independent solutions of y'' = f*y on a closed real
:: interval yield a positive square-root product solving the stated nonlinear
:: differential equation. This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, COMPLEX1, NEWTON,
    ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1, XXREAL_1,
    ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1, XBOOLE_0,
    SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, ORDINAL2, CARD_3,
    ABIAN, TAYLOR_2, NAT_1, FUNCT_2, FCONT_1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RFUNCT_2, RCOMP_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NUMBERS,
    COMPLEX1, REAL_1, NAT_1, FUNCT_2, VALUED_1, SEQ_1, COMSEQ_2, SEQ_2,
    SERIES_1, FCONT_1, FDIFF_1, SEQFUNC, NEWTON, SIN_COS, TAYLOR_1,
    ABIAN, SQUARE_1;
  constructors ARYTM_0, REAL_1, NAT_1, SEQ_2, RCOMP_1, RFUNCT_2,
    LIMFUNC1, FCONT_1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN, TAYLOR_1,
    SEQFUNC, SERIES_1, VALUED_1, RELSET_1, COMSEQ_2, SQUARE_1;
  registrations RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, NEWTON, SIN_COS, INT_1,
    ORDINAL1, FCONT_1, SQUARE_1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities XCMPLX_0, VALUED_1, SUBSET_1, SQUARE_1;
  expansions TAYLOR_1;
  theorems XBOOLE_1, ABSVALUE, PARTFUN1, XCMPLX_1, RELAT_1, RCOMP_1,
    SEQ_1, SEQ_2, SIN_COS, SERIES_1, FUNCT_1, RFUNCT_2, NAT_1, NEWTON,
    POWER, FDIFF_1, FDIFF_2, TAYLOR_1, SIN_COS2, XREAL_1, RFUNCT_1,
    ABIAN, COMPLEX1, XXREAL_0, VALUED_1, FUNCT_2, XREAL_0, ORDINAL1,
    FCONT_1, SQUARE_1;
  schemes NAT_1;

begin

::$P-
theorem
  for I being Subset of REAL,
      f,y1,y2 being Function of REAL,REAL st
    (I is empty or
      ex a,b being Real st
        a <= b &
        for x being Real holds
          (x in I iff a <= x & x <= b)) &
    f is continuous &
    y1 is_differentiable_on 2, [#]REAL &
    (diff(y1,[#]REAL).2) is continuous &
    y2 is_differentiable_on 2, [#]REAL &
    (diff(y2,[#]REAL).2) is continuous &
    (for x being Real holds
      (diff(y1,[#]REAL).2).x = f.x * y1.x) &
    (for x being Real holds
      (diff(y2,[#]REAL).2).x = f.x * y2.x) &
    (for c1,c2 being Real st
      (for x being Real holds c1 * y1.x + c2 * y2.x = 0)
    holds c1 = 0 & c2 = 0) &
    (for x being Real st x in I holds
      y1.x > 0 & y2.x > 0)
  holds
    ex c being Real,
       z being Function of REAL,REAL,
       U being open Subset of REAL st
      c > 0 &
      I c= U &
      (for x being Real st x in U holds
        y1.x > 0 & y2.x > 0) &
      (for x being Real holds
        z.x = c * sqrt(y1.x * y2.x)) &
      z is_differentiable_on 2,U &
      (for x being Real st x in I holds
        (diff(z,U).2).x + 1/((z.x) |^ 3) = f.x * z.x)
proof
end;
::$P+
