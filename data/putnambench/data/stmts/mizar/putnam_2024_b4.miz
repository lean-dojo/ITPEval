:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_b4
:: (putnambench__mizar__putnam_2024_b4): the normalized expected position
:: after n independent uniform comparison steps converges to
:: (1-exp(-2))/2. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, PROB_1, PROB_2, MEASURE1, MEASURE4,
      MEASURE8, PARTFUN1, SUBSET_1, TARSKI, RELAT_1, FUNCT_1, ARYTM_3,
      XXREAL_0, XXREAL_1, FUNCT_2, VALUED_0, MESFUNC1, MESFUNC5,
      MESFUNC7, SUPINF_2, FINSEQ_1, NAT_1, CARD_3, CARD_1, ZFMISC_1,
      FINSET_1, PROB_4, RANDOM_1, RANDOM_2, RANDOM_3, FUNCOP_1,
      FINANCE1, REAL_1, SETFAM_1, SEQ_1, SEQ_2, SEQ_4, PREPOWER,
      ORDINAL2, ABIAN, SQUARE_1, POWER, MEASUR12, SIN_COS, COMPLEX1,
      RVSUM_1, INTEGRA5, XCMPLX_0, ARYTM_1, VALUED_1, SERIES_1,
      NEWTON, INT_1, BINOP_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, FINSET_1,
      CARD_1, NUMBERS, XXREAL_3, XCMPLX_0, XXREAL_0, XXREAL_1, NAT_1,
      XREAL_0, VALUED_0, FINSEQ_1, SUPINF_2, PROB_1, PROB_2, MEASURE1,
      MEASURE4, MEASURE6, MEASURE8, MESFUNC1, PROB_4, MESFUNC6, MESFUNC5,
      MESFUNC7, RANDOM_1, RANDOM_2, RANDOM_3, FINANCE1, REAL_1, SQUARE_1,
      POWER, RVSUM_1, MEASUR12, SIN_COS, COMPLEX1, VALUED_1, MESFUN6C,
      SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, SERIES_1,
      NEWTON, INT_1, BINOP_1;
 constructors REAL_1, MESFUNC6, MEASURE6, MEASURE8, PROB_3, PROB_4,
      MESFUNC1, MESFUNC5, MESFUNC7, RELSET_1, COMSEQ_2, RANDOM_1,
      RANDOM_2, RANDOM_3, FINANCE1, RVSUM_1, MEASUR12, SIN_COS,
      SQUARE_1, POWER, SETFAM_1, MESFUN6C, COMPLEX1, SEQ_2, SEQM_3,
      SEQ_4, PREPOWER, ABIAN, BINOP_1, BINOP_2, SERIES_1, NEWTON, INT_1;
 registrations XBOOLE_0, SUBSET_1, NAT_1, XREAL_0, XXREAL_0, ORDINAL1,
      MEASURE1, MEASURE4, FUNCOP_1, FINANCE1, VALUED_0, FINSEQ_1,
      FUNCT_2, RELAT_1, FINSET_1, NUMBERS, PROB_1, PARTFUN1, RELSET_1,
      CARD_1, MEMBERED, SQUARE_1, XXREAL_3, RANDOM_2, RANDOM_3,
      MEASUR12, MESFUN6C, XCMPLX_0, SEQ_4, ABIAN, PREPOWER, SIN_COS,
      NEWTON, INT_1;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
 definitions TARSKI, XBOOLE_0, FINSET_1;
 equalities PROB_1, RANDOM_2, PROB_4, RELAT_1, FINSEQ_1;
 expansions TARSKI, XBOOLE_0, RELAT_1, FINSEQ_1;

begin

::$P-
theorem
  for Omega being non empty set,
      Sigma being SigmaField of Omega,
      P being Probability of Sigma,
      m,a being Function of [:NAT,NAT:],Funcs(Omega,REAL)
  st
    (for n,k being Nat holds
      ex mn,an being Function of Omega,REAL st
        mn = m.(n,k) & an = a.(n,k) &
        rng mn c= INT & rng an c= INT) &
    (for n,k being Nat st 0 < n holds
      ex mn being Function of Omega,REAL,
         mn0 being Real-Valued-Random-Variable of Sigma st
        mn = m.(n,k) &
        (C_Meas (P2M(P))).
          {omega where omega is Element of Omega :
            mn.omega <> mn0.omega}
          = 0 &
        (C_Meas (P2M(P))).
          {omega where omega is Element of Omega :
            not ex j being Nat st
              j in Seg n & mn.omega = (j qua Real)}
          = 0 &
        (for j being Nat st j in Seg n holds
          (C_Meas (P2M(P))).
            {omega where omega is Element of Omega :
              mn.omega = (j qua Real)}
            = 1 / (n qua Real))) &
    (for r being Nat,
         I being one-to-one FinSequence of [:NAT,NAT:],
         B being FinSequence of Borel_Sets,
         D being FinSequence of bool Omega,
         q being FinSequence of ExtREAL
      st 0 < r &
         len I = r & len B = r & len D = r & len q = r &
         (for j being Nat st j in Seg r holds
           D.j = (m.(I.j))"(B.j) &
           q.j = (C_Meas (P2M(P))).(D.j))
      holds
        (C_Meas (P2M(P))).(meet rng D) = Product q) &
    (for n being Nat st 0 < n holds
      for omega being Element of Omega holds
        (a.(n,0)).omega = 1) &
    (for n,k being Nat st 0 < n holds
      ex mn,ak,ak1 being Function of Omega,REAL st
        mn = m.(n,k) & ak = a.(n,k) & ak1 = a.(n,k+1) &
        (for omega being Element of Omega holds
          (mn.omega > ak.omega implies
            ak1.omega = ak.omega + 1) &
          (mn.omega = ak.omega implies
            ak1.omega = ak.omega) &
          (mn.omega < ak.omega implies
            ak1.omega = ak.omega - 1)))
  holds
    ex E being Real_Sequence st
      E.0 = 0 &
      (for n being Nat st 0 < n holds
        ex ann being Function of Omega,REAL st
          ex ann0 being Real-Valued-Random-Variable of Sigma st
            ann = a.(n,n) &
            (C_Meas (P2M(P))).
              {omega where omega is Element of Omega :
                ann.omega <> ann0.omega}
              = 0 &
            E.n = Integral(P2M(P),ann0) / (n qua Real)) &
      E is convergent &
      lim E = (1 - exp_R.(-2)) / 2
proof
end;
::$P+
