:: Statement-only formalization of PutnamBench corpus artifact putnam_2014_b1
:: (putnambench__mizar__putnam_2014_b1): positive integers with a unique
:: base-10 over-expansion are exactly those with no zero decimal digit. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, FINSEQ_1, FINSEQ_2, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, VALUED_0, VALUED_1, ARYTM_1, ARYTM_3, CARD_3, NEWTON,
    INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, RELAT_1, FUNCT_1, FINSEQ_1, RVSUM_1,
    FINSEQ_2, NAT_1, INT_1, NAT_D, NEWTON;
  constructors REAL_1, INT_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, NEWTON;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    VALUED_0, VALUED_1, CARD_1, NEWTON, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being Subset of NAT st
    (for N being Nat holds
      (N in S iff
        N > 0 &
        ex d being FinSequence of NAT st
          0 < len d &
          d.(len d) <> 0 &
          (for i being Nat st i in Seg len d holds d.i <= 10) &
          (ex terms being FinSequence of NAT st
            len terms = len d &
            (for i being Nat st i in Seg len d holds
              terms.i = d.i * ((10 qua Nat) |^ (i -' 1))) &
            Sum terms = N) &
          (for e being FinSequence of NAT st
            0 < len e &
            e.(len e) <> 0 &
            (for i being Nat st i in Seg len e holds e.i <= 10) &
            (ex terms being FinSequence of NAT st
              len terms = len e &
              (for i being Nat st i in Seg len e holds
                terms.i = e.i * ((10 qua Nat) |^ (i -' 1))) &
              Sum terms = N)
          holds e = d)))
  holds
    S = {n where n is Element of NAT :
      n > 0 &
      (for k being Nat st
        n div ((10 qua Nat) |^ k) <> 0
      holds
        (n div ((10 qua Nat) |^ k)) mod 10 <> 0)}
proof
end;
::$P+
