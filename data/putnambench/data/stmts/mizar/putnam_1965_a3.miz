:: Statement-only formalization of PutnamBench artifact putnam_1965_a3:
:: equivalence between convergence of complex exponential Cesaro averages
:: at ordinary and square cutoffs. This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, XCMPLX_0, COMPLEX1, NEWTON,
    ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1, XXREAL_1,
    ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1, XBOOLE_0,
    SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, COMSEQ_1, ORDINAL2,
    CARD_3, ABIAN, TAYLOR_2, NAT_1, FUNCT_2, SQUARE_1;
  notations TARSKI, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1, RFUNCT_2,
    RCOMP_1, ORDINAL1, NUMBERS, XCMPLX_0, COMPLEX1, XREAL_0, REAL_1,
    XXREAL_0, NAT_1, FUNCT_2, VALUED_1, SEQ_1, COMSEQ_1, COMSEQ_2, SEQ_2,
    SERIES_1, FDIFF_1, SEQFUNC, NEWTON, SIN_COS, TAYLOR_1, ABIAN,
    SQUARE_1;
  constructors ARYTM_0, REAL_1, NAT_1, BINOP_2, SEQ_2, RCOMP_1, RFUNCT_2,
    LIMFUNC1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN, TAYLOR_1, SEQFUNC,
    SERIES_1, VALUED_1, RELSET_1, COMSEQ_2, SQUARE_1;
  registrations RELSET_1, NUMBERS, XCMPLX_0, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, NEWTON, SIN_COS, INT_1,
    ORDINAL1, SQUARE_1, COMSEQ_2, COMSEQ_3;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities XCMPLX_0, VALUED_1, SUBSET_1, SQUARE_1;
  expansions TAYLOR_1;
  theorems XBOOLE_1, ABSVALUE, PARTFUN1, XCMPLX_1, RELAT_1, RCOMP_1,
    SEQ_1, SEQ_2, SIN_COS, SERIES_1, FUNCT_1, RFUNCT_2, NAT_1, NEWTON,
    POWER, FDIFF_1, FDIFF_2, TAYLOR_1, SIN_COS2, XREAL_1, RFUNCT_1,
    ABIAN, COMPLEX1, XXREAL_0, VALUED_1, FUNCT_2, XREAL_0, ORDINAL1;

begin

::$P-
theorem
  for a being Real_Sequence holds
  for alpha being Element of COMPLEX holds
  for z being Complex_Sequence st
    z.0 = 0 &
    (for k being Nat st 0 < k holds
      z.k = (cos.(a.k) qua Complex) +
        (sin.(a.k) qua Complex)*<i>)
  holds
    ((for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            |.Partial_Sums(z).n / (n qua Complex) - alpha.|
              < epsilon)
    iff
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            |.Partial_Sums(z).(n^2) /
              ((n^2) qua Complex) - alpha.|
              < epsilon))
proof
end;
::$P+
