:: Statement-only formalization of PutnamBench corpus artifact putnam_1977_b3:
:: not every positive irrational real triple summing to one becomes balanced
:: after finitely many coordinatewise balancing acts. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, SEQ_1, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, COMPLEX1, XXREAL_0,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  not (for x,y,z being Real st
    not x in RAT &
    not y in RAT &
    not z in RAT &
    0 < x & 0 < y & 0 < z &
    x + y + z = 1
  holds
    ex n being Nat, a,b,c being Real_Sequence st
      a.0 = x & b.0 = y & c.0 = z &
      (for k being Nat st k < n holds
        ((a.k > 1 / 2 & a.(k + 1) = 2 * a.k - 1) or
         (a.k <= 1 / 2 & a.(k + 1) = 2 * a.k)) &
        ((b.k > 1 / 2 & b.(k + 1) = 2 * b.k - 1) or
         (b.k <= 1 / 2 & b.(k + 1) = 2 * b.k)) &
        ((c.k > 1 / 2 & c.(k + 1) = 2 * c.k - 1) or
         (c.k <= 1 / 2 & c.(k + 1) = 2 * c.k))) &
      a.n < 1 / 2 &
      b.n < 1 / 2 &
      c.n < 1 / 2)
proof
end;
::$P+
