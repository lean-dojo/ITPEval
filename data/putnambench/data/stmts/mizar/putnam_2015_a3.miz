:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_a3
:: (putnambench__mizar__putnam_2015_a3): the complex double product of
:: 1 + exp(2*PI*i*a*b/2015) for 1 <= a,b <= 2015 equals 2^13725.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, TARSKI, XREAL_0, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1, FINSEQOP,
    ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, ORDINAL2, COMPLEX1, NEWTON,
    SIN_COS, ABIAN, INT_1;
  notations TARSKI, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1, NUMBERS,
    VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1,
    RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
    FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, NAT_D,
    FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, NEWTON, SIN_COS, ABIAN,
    INT_1;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, NAT_D, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1,
    XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1, COMPLEX1, NEWTON, SIN_COS,
    ABIAN;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, FUNCT_2, FUNCOP_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2, FINSEQ_1, FINSEQ_2,
    VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1, RVSUM_1, RELSET_1,
    MEMBERED, NEWTON, SIN_COS, ABIAN, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex rows being FinSequence of COMPLEX st
    len rows = 2015 &
    (for a being Nat st a in Seg 2015 holds
      ex factors being FinSequence of COMPLEX st
        len factors = 2015 &
        (for b being Nat st b in Seg 2015 holds
          factors.b =
            1 + exp(((2 * PI * (a qua Real) * (b qua Real)) / 2015) *
              <i>)) &
        rows.a = Product factors) &
    Product rows = (2 qua Complex) |^ 13725
proof
end;
::$P+
