:: Statement-only formalization of PutnamBench corpus artifact putnam_2006_a3:
:: an integer sequence with the specified initial values and recurrence has
:: 2005 consecutive terms divisible by 2006. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, INT_2, NAT_1, ORDINAL1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, NAT_1, INT_1, INT_2, NAT_D;
  constructors PARTFUN1, RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, INT_2,
    NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Function of INT,INT st
    (for k being Integer st 1 <= k & k <= 2006 holds x/.k = k) &
    (for k being Integer st 2006 <= k holds
      x/.(k + 1) = x/.k + x/.(k - 2005))
  holds
    ex i being Nat st
      0 < i &
      for j being Nat st j < 2005 holds
        (2006 qua Integer) divides x/.(i + j)
proof
end;
::$P+
