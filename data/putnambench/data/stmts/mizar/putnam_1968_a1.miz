:: Statement-only formalization of PutnamBench artifact putnam_1968_a1:
:: the difference 22/7 - PI equals the integral from zero to one of
:: x^4(1-x)^4/(1+x^2). This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, SQUARE_1,
      SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
      SIN_COS, NEWTON;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0, VALUED_1,
      SQUARE_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1, SIN_COS, NEWTON;
 constructors RELSET_1, FUNCT_2, REAL_1, SQUARE_1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, SIN_COS, NEWTON;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0, VALUED_1,
      SQUARE_1, XXREAL_3, MEASURE1, MEASUR12, SIN_COS, NEWTON;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities SQUARE_1;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for I being Subset of REAL, f being Function of REAL,REAL st
    I = {x where x is Real : 0 <= x & x <= 1} &
    (for x being Real holds
      f.x = (x |^ 4) * ((1-x) |^ 4) / (1+x^2))
  holds
    (22 qua Real) / 7 - PI = Integral(L-Meas,f|I)
proof
end;
::$P+
