:: Statement-only formalization of PutnamBench corpus artifact putnam_1990_b1:
:: the globally continuously differentiable real functions whose squared value
:: equals 1990 plus the oriented integral of the sum of the squares of the
:: function and its derivative are exactly the two stated exponential functions.
:: This file contains no proof.

environ

  vocabularies NUMBERS, XBOOLE_0, PARTFUN1, SUBSET_1, FUNCT_1, RELAT_1,
    XXREAL_2, COMPLEX1, ARYTM_1, XXREAL_0, SEQ_4, ARYTM_3, REAL_1,
    FDIFF_1, RCOMP_1, TARSKI, VALUED_1, CARD_1, INTEGRA5, INTEGRA1,
    XXREAL_1, SQUARE_1, ORDINAL2, FUNCOP_1, FCONT_1, REALSET1, SIN_COS,
    SEQ_1, SEQ_2, NAT_1, FUNCT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, XXREAL_2, COMPLEX1, FUNCT_1, RELAT_1, FUNCOP_1,
    RELSET_1, FUNCT_2, RCOMP_1, VALUED_1, SEQ_1, PARTFUN1, RFUNCT_1,
    SEQ_2, SEQ_4, SQUARE_1, FCONT_1, FDIFF_1, SIN_COS, INTEGRA5;
  constructors REAL_1, FDIFF_1, PARTFUN2, RFUNCT_1, INTEGRA2,
    COMSEQ_2, FCONT_1, INTEGRA5, SIN_COS, SQUARE_1, SEQ_4, RELSET_1,
    SEQ_2, COMPLEX1;
  registrations XREAL_0, RELSET_1, INTEGRA1, RCOMP_1, VALUED_0,
    MEMBERED, XXREAL_0, XBOOLE_0, NUMBERS, VALUED_1, FUNCT_2,
    XXREAL_2, SEQ_2, SQUARE_1, RELAT_1, NAT_1, FCONT_1, SIN_COS,
    ORDINAL1, XCMPLX_0;
  requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
  definitions TARSKI, FDIFF_1;
  equalities XCMPLX_0, INTEGRA5, VALUED_1, SQUARE_1, SIN_COS,
    RCOMP_1;
  expansions FCONT_1, TARSKI, FDIFF_1, FUNCT_2;

begin

::$P-
theorem
  for f being Function of REAL,REAL holds
    (f is_differentiable_on [#]REAL &
      ex d,h being Function of REAL,REAL st
        d is continuous &
        (for t being Real holds
          d.t = diff(f,t) &
          h.t = f.t * f.t + d.t * d.t) &
        (for x being Real holds
          f.x * f.x = integral(h,0,x) + 1990))
    iff
      (for x being Real holds
        f.x = sqrt 1990 * exp_R.x) or
      (for x being Real holds
        f.x = -(sqrt 1990 * exp_R.x))
proof
end;
::$P+
