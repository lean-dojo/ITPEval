:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_a1:
:: exactly 10053 integer points in the 2011-by-2011 coordinate square cannot
:: be endpoints of growing axis-aligned spirals. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSEQ_1, FINSEQ_2, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, VALUED_1, FINSEQOP, FINSEQ_2,
    ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  card {[x,y] where x,y is Integer :
    0 <= x & x <= 2011 & 0 <= y & y <= 2011 &
    not ex n being Nat, X,Y,D being FinSequence of INT st
      2 <= n &
      len X = n + 1 & len Y = n + 1 & len D = n &
      X.1 = 0 & Y.1 = 0 &
      X.(n + 1) = x & Y.(n + 1) = y &
      (for i being Nat st i in Seg n holds
        0 < D.i &
        (i mod 4 = 1 implies
          X.(i + 1) = X.i + D.i & Y.(i + 1) = Y.i) &
        (i mod 4 = 2 implies
          X.(i + 1) = X.i & Y.(i + 1) = Y.i + D.i) &
        (i mod 4 = 3 implies
          X.(i + 1) = X.i - D.i & Y.(i + 1) = Y.i) &
        (i mod 4 = 0 implies
          X.(i + 1) = X.i & Y.(i + 1) = Y.i - D.i)) &
      (for i,j being Nat st
        i in Seg n & j in Seg n & i < j holds D.i < D.j)}
    = 10053
proof
end;
::$P+
