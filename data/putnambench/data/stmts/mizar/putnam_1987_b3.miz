:: Statement-only formalization of PutnamBench corpus artifact putnam_1987_b3:
:: the unit circle over a field of characteristic not two equals one exceptional
:: point together with its standard rational parametrization.
:: This file contains no proof.

environ
  vocabularies NUMBERS, CARD_1, FUNCT_1, RELAT_1, XBOOLE_0, ARYTM_3,
    MCART_1, SUBSET_1, ARYTM_1, XXREAL_0, INT_2, NAT_1, ZFMISC_1,
    SUPINF_2, MESFUNC1, INT_1, VECTSP_1, STRUCT_0, RLVECT_1, ALGSTR_0,
    LATTICES, GROUP_1, BINOP_1, FUNCSDOM, VECTSP_2, TARSKI;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, FUNCT_1,
    ORDINAL1, MCART_1, FUNCT_2, BINOP_1, DOMAIN_1, NUMBERS, XREAL_0,
    XCMPLX_0, XXREAL_0, NAT_1, INT_1, INT_2, STRUCT_0, ALGSTR_0,
    RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2;
  constructors NAT_D, PEPIN, EUCLID, REALSET1, RELSET_1, BINOP_2,
    DOMAIN_1, BINOP_1, VECTSP_1, VECTSP_2;
  registrations STRUCT_0, XREAL_0, ORDINAL1, INT_1, RELAT_1, VECTSP_1,
    INT_3, SUBSET_1, XTUPLE_0, MCART_1, XBOOLE_0, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities ALGSTR_0;

begin

::$P-
theorem
  for K being Field st 1.K + 1.K <> 0.K holds
    {[x,y] where x,y is Element of K : x*x + y*y = 1.K} =
      {[1.K,0.K]} \/
      {[(r*r - 1.K)/(r*r + 1.K),
        ((1.K + 1.K)*r)/(r*r + 1.K)]
        where r is Element of K : r*r <> -1.K}
proof
end;
::$P+
