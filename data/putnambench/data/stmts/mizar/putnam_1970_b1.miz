:: Statement-only formalization of PutnamBench artifact putnam_1970_b1:
:: the limit of a normalized finite product of real fractional powers equals
:: exp(2 ln 5 - 4 + 2 arctan 2). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, COMPLEX1, ORDINAL1, ORDINAL2,
    NEWTON, PREPOWER, SEQ_4, ARYTM_1, ARYTM_3, REAL_1, VALUED_0,
    VALUED_1, SEQ_1, SEQ_2, SIN_COS, SIN_COS9, RVSUM_1, POWER,
    TAYLOR_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, COMPLEX1, NAT_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, CARD_1,
    NEWTON, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
    SEQ_4, PREPOWER, SIN_COS, SIN_COS9, RVSUM_1, POWER, TAYLOR_1;
  constructors REAL_1, NUMBERS, RELSET_1, PARTFUN1, FUNCT_2, FINSEQOP,
    NAT_1, NEWTON, XXREAL_0, COMPLEX1, SEQ_2, SEQM_3, SEQ_4,
    PREPOWER, COMSEQ_2, SIN_COS, SIN_COS9, RVSUM_1, POWER, TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NEWTON, VALUED_0, VALUED_1,
    MEMBERED, RVSUM_1, PREPOWER, SEQ_4, SEQ_1, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex s being Real_Sequence st
    (for n being Nat holds
      ex factors,partials being FinSequence of REAL st
        len factors = 2*n &
        len partials = 2*n+1 &
        partials.1 = 1 &
        (for i being Nat st i in Seg (2*n) holds
          factors.i =
            exp_R.((1 / (n qua Real)) *
              ln.(((n qua Real) |^ 2) + ((i qua Real) |^ 2))) &
          partials.(i+1) = partials.i * factors.i) &
        s.n = (1 / ((n qua Real) |^ 4)) * partials.(2*n+1)) &
    s is convergent &
    lim s = exp_R.(2 * ln.5 - 4 + 2 * arctan.2)
proof
end;
::$P+
