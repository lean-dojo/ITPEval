:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_b5
:: (putnambench__mizar__putnam_2011_b5): a uniform linear bound on the
:: whole-line integral of squared finite sums of Cauchy kernels implies a
:: positive cubic lower bound for the associated double sums. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1,
    ORDINAL1, NEWTON, PREPOWER, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MEASUR12, INTEGRA5, FINSEQ_1, FINSEQ_2, RVSUM_1,
    BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, SETWISEO, SETWOP_2,
    FINSOP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON, PREPOWER,
    VALUED_0, VALUED_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
    MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, NAT_1, NAT_D, BINOP_1, BINOP_2, FUNCOP_1, SETWISEO,
    FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NAT_D, NEWTON, PREPOWER, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1, FINSEQ_2, FINSEQ_4, BINOP_1,
    BINOP_2, SETWISEO, FINSOP_1, FINSEQOP, SETWOP_2, FUNCOP_1,
    RVSUM_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    XXREAL_3, MEASURE1, MEASUR12, FINSEQ_1, FINSEQ_2, FINSEQ_4,
    RVSUM_1, BINOP_2, FUNCOP_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for a being Function of NAT,REAL st
    ex A being Real st
      for n being Nat holds
        ex f being Function of REAL,REAL st
          (for x being Real holds
            ex terms being FinSequence of REAL st
              len terms = n &
              (for i being Nat st i in Seg n holds
                terms.i =
                  1 / (1 + ((x - a.(i -' 1)) |^ 2))) &
              f.x = (addreal $$ terms) * (addreal $$ terms)) &
          Integral(L-Meas,f|REAL) <= A * (n qua Real)
  holds
    ex B being Real st
      0 < B &
      for n being Nat holds
        ex outer being FinSequence of REAL st
          len outer = n &
          (for i being Nat st i in Seg n holds
            ex inner being FinSequence of REAL st
              len inner = n &
              (for j being Nat st j in Seg n holds
                inner.j =
                  1 + ((a.(i -' 1) - a.(j -' 1)) |^ 2)) &
              outer.i = addreal $$ inner) &
          B * ((n qua Real) |^ 3) <= addreal $$ outer
proof
end;
::$P+
