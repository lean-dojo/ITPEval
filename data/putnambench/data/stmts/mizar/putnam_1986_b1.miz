:: Statement-only formalization of PutnamBench corpus artifact putnam_1986_b1:
:: positive real base and height satisfying the given unit-circle and equal-area
:: equations have height 2/5. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NEWTON;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for b,h being Real st
    0 < b & 0 < h &
    (b |^ 2) + (h |^ 2) = (2 qua Real) |^ 2 &
    b * h = (1 / 2) * b * (1 - h / 2)
  holds h = 2 / 5
proof
end;
::$P+
