:: Statement-only formalization of PutnamBench artifact putnam_1965_a4:
:: a finite nonempty bipartite dance relation contains a crossed pair when
:: every girl has a partner but no boy partners every girl. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
      RELSET_1, FINSET_1;
  constructors RELAT_1, RELSET_1, FINSET_1, XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FINSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for G,B being non empty finite set, dances being Relation of G,B st
    (not ex b being Element of B st
      for g being Element of G holds [g,b] in dances) &
    (for g being Element of G holds
      ex b being Element of B st [g,b] in dances)
  holds ex g,h being Element of G st
    ex b,c being Element of B st
      [g,b] in dances & [h,c] in dances &
      not [h,b] in dances & not [g,c] in dances
proof
end;
::$P+
