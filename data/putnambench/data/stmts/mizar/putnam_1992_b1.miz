:: Statement-only formalization of PutnamBench corpus artifact putnam_1992_b1:
:: among sets of n distinct real numbers, the least number of distinct
:: averages of two different elements is 2*n - 3. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, NAT_1, CARD_1, FINSET_1, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, REAL_1, XXREAL_0, NAT_1, FINSET_1;
  constructors CARD_1, REAL_1, XXREAL_0, NAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, ORDINAL1, CARD_1, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n >= 2 holds
    (ex S,A being finite Subset of REAL st
      card S = n &
      (for x being Element of REAL holds
        (x in A iff
          ex a,b being Element of REAL st
            a in S & b in S & a <> b & x = (a + b) / 2)) &
      card A + 3 = n + n) &
    (for S being finite Subset of REAL st card S = n holds
      ex A being finite Subset of REAL st
        (for x being Element of REAL holds
          (x in A iff
            ex a,b being Element of REAL st
              a in S & b in S & a <> b & x = (a + b) / 2)) &
        card A + 3 >= n + n)
proof
end;
::$P+
