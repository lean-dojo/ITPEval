:: Statement-only formalization of PutnamBench corpus artifact putnam_2019_b5:
:: the degree-1008 real polynomial interpolating the odd-indexed Fibonacci
:: numbers uniquely determines the positive index pair (2019,1010).
:: This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      INT_1, POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3,
      FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1,
      FUNCT_2, SUPINF_2, NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1,
      RLVECT_1, CARD_3, BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES,
      ORDINAL4, FINSEQ_2, VECTSP_2, ZFMISC_1, ORDINAL1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      REAL_1, INT_1, NAT_1, NAT_D, VALUED_0, FINSEQ_1, FINSEQ_2, FUNCT_7,
      STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2,
      ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
      VECTSP_2, ALGSTR_1, FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
      INT_1, NAT_1, NAT_D;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      INT_1, VALUED_0, FINSEQ_1, FINSEQ_2, VECTSP_2, ALGSTR_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  for F being Function of NAT,INT,
      P being Polynomial of F_Real st
    (for n being Nat st 1 <= n holds
      F.(n + 2) = F.(n + 1) + F.n) &
    F.1 = 1 & F.2 = 1 &
    len P = 1009 &
    (for n being Nat st n <= 1008 holds
      ex x being Element of F_Real st
        x = 2 * n + 1 &
        eval(P,x) = (F.(2 * n + 1) qua Real))
  holds
    ex x being Element of F_Real st
      x = 2019 &
      for j,k being Nat holds
        (eval(P,x) = ((F.j - F.k) qua Real) &
          1 <= j & 1 <= k
        iff
          j = 2019 & k = 1010)
proof
end;
::$P+
