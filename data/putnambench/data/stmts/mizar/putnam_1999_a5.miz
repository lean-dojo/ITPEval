:: Statement-only formalization of PutnamBench corpus artifact putnam_1999_a5:
:: a uniform real constant bounds the value at zero of every real polynomial
:: of degree 1999 by the integral of its absolute value over [-1,1]. This file
:: contains no proof.

environ

 vocabularies NUMBERS, REAL_1, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3,
      XCMPLX_0, COMPLEX1, RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1,
      SUBSET_1, XBOOLE_0, TARSKI, CARD_1, NAT_1, ORDINAL1,
      VALUED_0, VALUED_1, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1,
      VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3,
      POLYNOM5, FINSEQ_1, INTEGRA5, XXREAL_1, SUPINF_2, MEASURE1,
      MESFUNC1, MESFUNC5, MEASUR12;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, REAL_1, COMPLEX1, NAT_1, VALUED_0,
      VALUED_1, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1, VECTSP_1,
      VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, XXREAL_1,
      XXREAL_3, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1;
 constructors REAL_1, RELSET_1, PARTFUN1, FUNCT_2, ALGSEQ_1,
      POLYNOM4, POLYNOM5, VECTSP_2, ALGSTR_1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, COMPLEX1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1,
      NAT_1, MEMBERED, VALUED_0, VALUED_1, STRUCT_0, RLVECT_1,
      GROUP_1, VECTSP_1, VECTSP_2, ALGSTR_1, POLYNOM3, POLYNOM5,
      XXREAL_3, MEASURE1, MEASUR12;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
      ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  ex C being Real st
    for p being Polynomial of F_Real st len p = 2000 holds
      ex I being Subset of REAL st
        I = {x where x is Real : -1 <= x & x <= 1} &
        ex f being Function of REAL,REAL st
          (for x being Element of F_Real holds
            f.x = |.eval(p,x).|) &
          |.eval(p,0.F_Real).| <= C * Integral(L-Meas,f|I)
proof
end;
::$P+
