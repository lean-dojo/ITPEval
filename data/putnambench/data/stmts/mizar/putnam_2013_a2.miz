:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_a2:
:: the least possible final term of an increasing integer sequence whose
:: product with a positive nonsquare is a square defines an injective function.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RELAT_1,
    FUNCT_1, FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, SETWISEO,
    SETWOP_2, FINSOP_1, RVSUM_1, ZFMISC_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, PARTFUN1, FUNCT_2, BINOP_1, BINOP_2, FUNCOP_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, SETWISEO,
    FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1;
  constructors RELSET_1, PARTFUN1, BINOP_1, BINOP_2, FUNCOP_1,
    SETWISEO, NAT_1, NAT_D, FINSEQ_2, FINSEQ_4, VALUED_1, FINSEQOP,
    FINSOP_1, SETWOP_2, RVSUM_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_0,
    VALUED_1, RVSUM_1, MEMBERED;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for f being Function of INT,INT st
    (for n being Integer st
      0 < n & not ex s being Integer st s*s = n
    holds
      (ex a being FinSequence of INT st
        0 < len a &
        n < a.1 &
        (for i being Nat st i in Seg (len a -' 1) holds
          a.i < a.(i+1)) &
        (ex s being Integer st s*s = n * Product a) &
        f.n = a.(len a)) &
      (for a being FinSequence of INT st
        0 < len a &
        n < a.1 &
        (for i being Nat st i in Seg (len a -' 1) holds
          a.i < a.(i+1)) &
        (ex s being Integer st s*s = n * Product a)
      holds f.n <= a.(len a)))
  holds
    for n1,n2 being Integer st
      0 < n1 & not ex s1 being Integer st s1*s1 = n1 &
      0 < n2 & not ex s2 being Integer st s2*s2 = n2 &
      f.n1 = f.n2
    holds n1 = n2
proof
end;
::$P+
