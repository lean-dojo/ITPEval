:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_a5:
:: the parity of the count of positive reduced residues below q/4
:: characterizes prime powers with prime base congruent to 5 or 7 modulo 8.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, RELAT_1, XBOOLE_0, SUBSET_1, TARSKI,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, INT_1, INT_2,
    ARYTM_1, ARYTM_3, NEWTON, ABIAN, ZFMISC_1, FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    FINSET_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2,
    NEWTON, NAT_1, NAT_D, ABIAN;
  constructors REAL_1, NAT_1, NAT_D, INT_1, INT_2, NEWTON, ABIAN,
    FINSET_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, INT_2, ORDINAL1, CARD_1, NEWTON, ABIAN,
    FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for q,Nq being Nat st
    q is odd &
    0 < q &
    Nq = card {a where a is Element of NAT :
      0 < a & 4 * a < q & a,q are_coprime}
  holds
    (Nq is odd iff
      ex p,k being Nat st
        q = p |^ k &
        0 < k &
        p is prime &
        (p mod 8 = 5 or p mod 8 = 7))
proof
end;
::$P+
