:: Statement-only formalization of PutnamBench corpus artifact putnam_2003_b2:
:: repeated adjacent averaging of the rational sequence 1, 1/2, ..., 1/n
:: produces a final value strictly less than 2/n. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1, INT_2, NAT_1,
    VALUED_0, VALUED_1, ORDINAL1, BINOP_1, BINOP_2, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, INT_2, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1,
    NAT_D, PARTFUN1, BINOP_2, BINOP_1, VALUED_0, VALUED_1, RAT_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, INT_2, XXREAL_0, NAT_1, NAT_D,
    BINOP_1, BINOP_2, VALUED_1, ZFMISC_1, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, INT_2,
    BINOP_2, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat, seq being Function of [:NAT,NAT:],RAT st
    0 < n &
    (for j being Nat st 1 <= j & j <= n holds
      seq.(0,j) = (1 qua Rational) / (j qua Rational)) &
    (for k,j being Nat st
      1 <= k & k <= n -' 1 &
      1 <= j & j <= n -' k
    holds
      seq.(k,j) =
        (seq.(k -' 1,j) + seq.(k -' 1,j + 1)) / 2)
  holds
    seq.(n -' 1,1) < (2 qua Rational) / (n qua Rational)
proof
end;
::$P+
