:: Statement-only formalization of PutnamBench artifact putnam_1966_a4:
:: the recurrence enumerating positive nonsquares and its formula using the
:: nearest integer to the square root. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, COMPLEX1, SQUARE_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of NAT,INT st
    a.1 = 2 &
    (for n being Nat st 1 <= n holds
      ((ex m being Integer st m^2 = a.n + 1) &
          a.(n + 1) = a.n + 2) or
      ((not ex m being Integer st m^2 = a.n + 1) &
          a.(n + 1) = a.n + 1))
  holds
    for n being Nat st 1 <= n holds
      a.n = n + [\ sqrt n + 1/2 /]
proof
end;
::$P+
