:: Statement-only formalization of PutnamBench corpus artifact putnam_1985_a1:
:: the ordered triples of subsets of the integers from 1 through 10 whose
:: union is the full set and whose triple intersection is empty have
:: cardinality 2^10 * 3^10 * 5^0 * 7^0. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FINSEQ_1, NUMBERS, NAT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, FINSET_1, NEWTON, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, ORDINAL1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, FINSEQ_1, FINSET_1, CARD_1, NEWTON;
  constructors XTUPLE_0, NAT_1, NAT_D, NEWTON, FINSET_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FINSEQ_1,
    FINSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, NEWTON, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  card {[[A1,A2],A3] where A1,A2,A3 is Subset of Seg 10 :
    A1 \/ A2 \/ A3 = Seg 10 & A1 /\ A2 /\ A3 = {}}
  = (2 |^ 10) * (3 |^ 10) * (5 |^ 0) * (7 |^ 0)
proof
end;
::$P+
