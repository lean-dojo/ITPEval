:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_a6
:: (putnambench__mizar__putnam_2023_a6): Bob has a legal strategy fixing the
:: parity of the turn-matching choices for every positive game size.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1, ABIAN, INT_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_4, NAT_1, NAT_D,
    FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, VALUED_0, VALUED_1, FINSET_1,
    MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  {n where n is Nat :
    0 < n &
    ex s being Function of NAT*,NAT, p being Nat st
      p < 2 &
      (for h being FinSequence of NAT st
        h is one-to-one &
        rng h c= Seg n &
        len h < n &
        (len h) mod 2 = 1
      holds
        s.h in Seg n \ rng h) &
      (for g being FinSequence of NAT st
        len g = n &
        g is one-to-one &
        rng g c= Seg n &
        (for i being Nat st
          i < len g & i mod 2 = 1
        holds
          g.(i + 1) = s.(g|i))
      holds
        ex q being Nat st
          q = card {k where k is Nat :
            k in dom g & g.k = k} &
          q mod 2 = p)}
  =
  {n where n is Nat : 0 < n}
proof
end;
::$P+
