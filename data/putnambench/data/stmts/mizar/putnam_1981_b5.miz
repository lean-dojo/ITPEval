:: Statement-only formalization of PutnamBench artifact putnam_1981_b5:
:: the exponential of the infinite series whose terms use the number of ones
:: in each positive integer's base-two expansion is rational. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2, SEQ_4,
    SERIES_1, SIN_COS, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, VALUED_0, VALUED_1,
    NEWTON, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    SERIES_1, SIN_COS, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, NEWTON, SEQ_2, SEQM_3, SEQ_4,
    PREPOWER, BINOP_2, COMSEQ_2, SERIES_1, SIN_COS, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON, PREPOWER,
    SEQ_4, FRAENKEL, SIN_COS, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for B being Function of NAT,NAT,
      s being Real_Sequence st
    (for n being Nat holds
      B.n = card {k where k is Element of NAT :
        (n div (2 |^ k)) mod 2 = 1}) &
    (for n being Nat holds
      s.n = (B.(n + 1) qua Real) /
        (((n + 1) qua Real) * ((n + 2) qua Real)))
  holds
    Partial_Sums(s) is convergent &
    ex q being Rational st
      exp_R.(lim Partial_Sums(s)) = q
proof
end;
::$P+
