:: Statement-only formalization of PutnamBench artifact putnam_1963_b5:
:: convergence of a real series with controlled terms on each integer
:: interval [n,2n] implies that n*a_n tends to zero. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, ORDINAL2,
    SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, XXREAL_0, NAT_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2, COMSEQ_2,
    SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of INT,REAL st
    (for n being Integer st 1 <= n holds
      for k being Integer st n <= k & k <= 2 * n holds
        0 <= a.k & a.k <= 100 * a.n) &
    (ex s being Real_Sequence st
      (for n being Nat holds s.n = a.n) &
      Partial_Sums(s) is convergent)
  holds
    ex t being Real_Sequence st
      (for n being Nat holds t.n = (n qua Real) * a.n) &
      t is convergent & lim t = 0
proof
end;
::$P+
