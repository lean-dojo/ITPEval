:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_a6:
:: positivity of the double sum of a specified integer-valued kernel over
:: every nonempty finite set of integer lattice points. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1,
    ZFMISC_1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, FINSET_1, BINOP_1,
    BINOP_2, FUNCOP_1, FINSEQOP, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, FINSET_1;
  constructors FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, REAL_1,
    COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, VALUED_1, FINSEQOP, FINSEQ_2,
    FINSEQ_4, RVSUM_1, ZFMISC_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, RVSUM_1, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for w being Function of [:INT,INT:],INT,
      A being Function of bool [:INT,INT:],INT st
    w.[-2,-2] = -1 & w.[2,-2] = -1 &
    w.[-2,2] = -1 & w.[2,2] = -1 &
    w.[-1,-2] = -2 & w.[1,-2] = -2 &
    w.[-2,-1] = -2 & w.[2,-1] = -2 &
    w.[-2,1] = -2 & w.[2,1] = -2 &
    w.[-1,2] = -2 & w.[1,2] = -2 &
    w.[0,-2] = 2 & w.[-2,0] = 2 &
    w.[2,0] = 2 & w.[0,2] = 2 &
    w.[-1,-1] = 4 & w.[1,-1] = 4 &
    w.[-1,1] = 4 & w.[1,1] = 4 &
    w.[0,-1] = -4 & w.[-1,0] = -4 &
    w.[1,0] = -4 & w.[0,1] = -4 &
    w.[0,0] = 12 &
    (for a,b being Integer st |.a.| > 2 or |.b.| > 2 holds
      w.[a,b] = 0) &
    (for S being finite Subset of [:INT,INT:],
         p being FinSequence of [:INT,INT:] st
      p is one-to-one & rng p = S
    holds
      ex outer being FinSequence of REAL st
        len outer = len p &
        (for i being Nat st i in dom p holds
          ex inner being FinSequence of REAL st
            len inner = len p &
            (for j being Nat st j in dom p holds
              ex ai,bi,aj,bj being Integer st
                p/.i = [ai,bi] & p/.j = [aj,bj] &
                inner.j = w.[ai-aj,bi-bj]) &
            outer.i = Sum inner) &
        A.S = Sum outer)
  holds
    for S being finite Subset of [:INT,INT:] st S <> {} holds
      A.S > 0
proof
end;
::$P+
