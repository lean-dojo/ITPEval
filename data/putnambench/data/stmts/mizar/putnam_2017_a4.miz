:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_a4
:: (putnambench__mizar__putnam_2017_a4): a 2N-student quiz whose scores
:: cover every integer from 0 through 10 and average exactly 7.4 can be
:: partitioned into two N-student groups, each averaging 7.4.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1, RVSUM_1,
    REAL_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, RELAT_1, FUNCT_1, FINSEQ_1,
    RVSUM_1, FINSEQ_2, NAT_1;
  constructors REAL_1, NAT_1, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for N being Nat,
      score being FinSequence of REAL st
    len score = 2 * N &
    (for i being Nat st i in Seg (2 * N) holds
      ex k being Nat st k <= 10 & score.i = k) &
    (for k being Nat st k <= 10 holds
      ex i being Nat st i in Seg (2 * N) & score.i = k) &
    Sum score / ((2 * N) qua Real) = (37 qua Real) / 5
  holds
    ex S being Subset of Seg (2 * N),
       selected,remaining being FinSequence of REAL st
      card S = N &
      selected = score * Sgm S &
      remaining = score * Sgm ((Seg (2 * N)) \ S) &
      Sum selected / (N qua Real) = (37 qua Real) / 5 &
      Sum remaining / (N qua Real) = (37 qua Real) / 5
proof
end;
::$P+
