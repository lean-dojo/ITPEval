:: Statement-only formalization of PutnamBench artifact putnam_1964_b2:
:: a maximal pairwise-intersecting family of subsets of a nonempty finite set
:: contains exactly half of all subsets. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, FINSET_1,
    CARD_1, NUMBERS, NAT_1, XREAL_0, ARYTM_1, ARYTM_3, NEWTON;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, FINSET_1,
    ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, NAT_1, NAT_D, CARD_1, NEWTON;
  constructors SETFAM_1, NAT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, FINSET_1, ORDINAL1, CARD_1, NAT_1,
    NEWTON;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for S being non empty finite set,
      P being finite Subset-Family of S st
    (for T,U being Subset of S st T in P & U in P holds T meets U) &
    not (ex T being Subset of S st
      not T in P &
      (for U being Subset of S st U in P holds T meets U))
  holds card P = 2 |^ (card S -' 1)
proof
end;
::$P+
