:: Statement-only formalization of PutnamBench corpus artifact putnam_1980_a6:
:: the greatest universal lower bound of the integral of |f'(x)-f(x)| over
:: continuously differentiable real functions on [0,1] with endpoint values
:: zero and one is 1/exp(1). This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    XXREAL_1, XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, VALUED_0, VALUED_1,
    ORDINAL1, SEQ_1, SEQ_2, SEQ_4, RCOMP_1, FCONT_1, FDIFF_1,
    SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
    SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, XXREAL_0, XXREAL_1, XXREAL_2, XXREAL_3, VALUED_0,
    VALUED_1, COMPLEX1, RCOMP_1, FCONT_1, FDIFF_1, SUPINF_2,
    MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, SIN_COS;
  constructors RELSET_1, FUNCT_2, REAL_1, COMPLEX1, RCOMP_1, FCONT_1,
    FDIFF_1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, SEQ_2, SEQ_4, COMSEQ_2, BINOP_2, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, XCMPLX_0, XXREAL_0,
    XXREAL_3, VALUED_0, VALUED_1, MEMBERED, RCOMP_1, FCONT_1,
    FDIFF_1, MEASURE1, MEASUR12, SEQ_4;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities XCMPLX_0, VALUED_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  ((for I being Subset of REAL,
        f,D,g being Function of REAL,REAL st
      (for x being Real holds
        (x in I iff 0 <= x & x <= 1)) &
      f.0 = 0 & f.1 = 1 &
      (for x being Real st x in I holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for y being Real st
              y in I & |.y-x.| < delta
            holds
              |.D.y-D.x.| < epsilon) &
      (for x being Real st x in I holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for y being Real st
              y in I & |.y-x.| < delta
            holds
              |.(f.y-f.x)-D.x*(y-x).| <= epsilon*|.y-x.|) &
      (for x being Real st x in I holds
        g.x = |.D.x-f.x.|)
    holds
      1 / exp_R.1 <= Integral(L-Meas,g|I)) &
   (for u being Real st
      (for I being Subset of REAL,
          f,D,g being Function of REAL,REAL st
        (for x being Real holds
          (x in I iff 0 <= x & x <= 1)) &
        f.0 = 0 & f.1 = 1 &
        (for x being Real st x in I holds
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st 0 < delta &
              for y being Real st
                y in I & |.y-x.| < delta
              holds
                |.D.y-D.x.| < epsilon) &
        (for x being Real st x in I holds
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st 0 < delta &
              for y being Real st
                y in I & |.y-x.| < delta
              holds
                |.(f.y-f.x)-D.x*(y-x).| <= epsilon*|.y-x.|) &
        (for x being Real st x in I holds
          g.x = |.D.x-f.x.|)
      holds
        u <= Integral(L-Meas,g|I))
    holds
      u <= 1 / exp_R.1))
proof
end;
::$P+
