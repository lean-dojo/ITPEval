:: Statement-only formalization of PutnamBench corpus artifact putnam_1982_a6:
:: the proposed preservation of a convergent real series under positive-
:: integer bijections when displacement times term magnitude tends to zero is
:: false. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL1, ORDINAL2, SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    COMSEQ_2, SEQM_3, SEQ_4, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2, COMSEQ_2,
    SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  not (for b being Function of NAT,NAT,
           x being Real_Sequence st
    (for n being Nat st 1 <= n holds 1 <= b.n) &
    (for m,n being Nat st
      1 <= m & 1 <= n & b.m = b.n holds m = n) &
    (for y being Nat st 1 <= y holds
      ex n being Nat st 1 <= n & b.n = y) &
    (for m,n being Nat st 1 <= m & m < n holds
      |.x.n.| < |.x.m.|) &
    (ex d being Real_Sequence st
      (for n being Nat holds
        d.n = |.(b.(n+1) qua Real) - ((n+1) qua Real).| * |.x.(n+1).|) &
      d is convergent & lim d = 0) &
    (ex s being Real_Sequence st
      (for n being Nat holds s.n = x.(n+1)) &
      Partial_Sums(s) is convergent &
      lim Partial_Sums(s) = 1)
  holds
    ex r being Real_Sequence st
      (for n being Nat holds r.n = x.(b.(n+1))) &
      Partial_Sums(r) is convergent &
      lim Partial_Sums(r) = 1)
proof
end;
::$P+
