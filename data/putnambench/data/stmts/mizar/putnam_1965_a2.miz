:: Statement-only formalization of PutnamBench artifact putnam_1965_a2:
:: the finite sum identity for squared normalized binomial coefficients over
:: every positive natural number. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3, CARD_3,
    COMPLEX1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, COMPLEX1, SQUARE_1, INT_1,
    NEWTON, RELAT_1, FUNCT_1, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, COMPLEX1, SQUARE_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    NEWTON, VALUED_0, VALUED_1, CARD_1, COMPLEX1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    ex terms being FinSequence of REAL st
      len terms = ((n -' 1) div 2) + 1 &
      (for r being Nat st r <= (n -' 1) div 2 holds
        terms.(r + 1) =
          ((((n qua Real) - 2 * (r qua Real)) * (n choose r)) /
            (n qua Real))^2) &
      Sum terms =
        ((1 qua Real) * ((2 * n -' 2) choose (n -' 1))) / (n qua Real)
proof
end;
::$P+
