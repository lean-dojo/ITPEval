:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_a4
:: (putnambench__mizar__putnam_2015_a4): the greatest uniform lower bound on
:: [0,1) of the real series summing 1/2^n over positive integers n for which
:: floor(n*x) is even is 4/7. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN,
    ORDINAL1, SERIES_1, RVSUM_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_1, FINSEQ_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN,
    XXREAL_2, POWER, RVSUM_1, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4,
    PREPOWER, ABIAN, BINOP_2, COMSEQ_2, POWER, RVSUM_1, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN, FINSEQ_1, RVSUM_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    (for x being Real holds
      ex s being Real_Sequence st
        (for n being Nat holds
          ([\ ((n + 1) qua Real) * x /] is even implies
            s.n = 1 / ((2 qua Real) |^ (n + 1))) &
          (not [\ ((n + 1) qua Real) * x /] is even implies
            s.n = 0)) &
        s is summable &
        f.x = lim Partial_Sums(s))
  holds
    (for x being Real st 0 <= x & x < 1 holds
      f.x >= (4 qua Real) / 7) &
    (for L being Real st
      (for x being Real st 0 <= x & x < 1 holds f.x >= L)
    holds L <= (4 qua Real) / 7)
proof
end;
::$P+
