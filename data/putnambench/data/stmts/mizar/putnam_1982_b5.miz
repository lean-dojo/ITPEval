:: Statement-only formalization of PutnamBench corpus artifact putnam_1982_b5:
:: convergence of the iterated logarithm-base sequence for x greater than
:: exp(exp(1)), and continuity of its real limit function. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL2, SEQ_4, PREPOWER, POWER, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, POWER, SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2, COMSEQ_2,
    PREPOWER, POWER, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, SEQ_4, PREPOWER,
    SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being Function of REAL,Funcs(NAT,REAL),
      g being Function of REAL,REAL st
    (for x being Real,
         s being Real_Sequence st
      exp_R.(exp_R.1) < x & s = S.x
    holds
      s.0 = exp_R.1 &
      for n being Nat holds
        s.(n+1) = log(s.n,x))
  holds
    (for x being Real,
         s being Real_Sequence st
      exp_R.(exp_R.1) < x & s = S.x
    holds s is convergent) &
    ((for x being Real,
          s being Real_Sequence st
        exp_R.(exp_R.1) < x & s = S.x
      holds s is convergent & lim s = g.x)
      implies
        for x being Real st exp_R.(exp_R.1) < x holds
          for e being Real st 0 < e holds
            ex d being Real st 0 < d &
              for y being Real st
                exp_R.(exp_R.1) < y & |.y-x.| < d
              holds |.g.y-g.x.| < e)
proof
end;
::$P+
