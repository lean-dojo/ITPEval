:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_b4
:: (putnambench__mizar__putnam_2009_b4): the real vector space of bivariate
:: polynomials of total degree at most 2009 whose average on every circle
:: centered at the origin is zero has dimension 2020050. This file contains
:: no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ARYTM_1, ARYTM_3, REAL_1, XREAL_0, XXREAL_0,
      XXREAL_1, COMPLEX1, NAT_1, FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1,
      RVSUM_1, NEWTON, PREPOWER, SIN_COS, STRUCT_0, ALGSTR_0, RLVECT_1,
      PRE_TOPC, RLTOPSP1, RLSUB_1, RLVECT_5, EUCLID, TARSKI, ZFMISC_1,
      PROB_1, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
      ORDINAL1, CARD_3, SUPINF_2;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, NAT_1, NEWTON,
      PREPOWER, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
      SIN_COS, STRUCT_0, ALGSTR_0, RLVECT_1, PRE_TOPC, RLTOPSP1,
      EUCLID, RLSUB_1, RLVECT_5, SUPINF_2, PROB_1, MEASURE1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      NAT_1, NEWTON, PREPOWER, SIN_COS, FINSEQ_1, FINSEQ_2, RVSUM_1,
      STRUCT_0, RLVECT_1, RLTOPSP1, EUCLID, RLSUB_1, RLVECT_5,
      MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1,
      BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
      FINSEQ_1, FINSEQ_2, RVSUM_1, STRUCT_0, PRE_TOPC, RLTOPSP1,
      EUCLID, RLVECT_5, XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0, RLTOPSP1;
 equalities STRUCT_0, FINSEQ_1, FINSEQ_2;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for ix,iy being Function of Seg 2021055,NAT st
    (for k being Nat st k in Seg 2021055 holds
      ix.k + iy.k <= 2009) &
    (for a,b being Nat st a+b <= 2009 holds
      ex k being Nat st
        k in Seg 2021055 & ix.k = a & iy.k = b) &
    (for k,l being Nat st
      k in Seg 2021055 & l in Seg 2021055 &
      ix.k = ix.l & iy.k = iy.l holds k = l)
  holds
    for V being Subspace of TOP-REAL 2021055 st
      [#]V =
        {p where p is Element of REAL 2021055 :
          for r being Real st 0 < r holds
            ex f being Function of REAL,REAL,
               I being Element of L-Field st
              I = [.0,2*PI.] &
              (for t being Real holds
                ex terms being FinSequence of REAL st
                  len terms = 2021055 &
                  (for k being Nat st k in Seg 2021055 holds
                    terms.k =
                      (p/.k) *
                      ((r*cos(t)) |^ ix.k) *
                      ((r*sin(t)) |^ iy.k)) &
                  f.t = Sum terms) &
              Integral(L-Meas,f|I) = 0}
    holds dim V = 2020050
proof
end;
::$P+
