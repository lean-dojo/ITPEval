      TOPS_2, TREAL_1, TSEP_1, URYSOHN1, VECTSP_1, VECTSP_4, VECTSP_7,
      VECTSP_9, VFUNCT_1, XBOOLE_0, XBOOLE_1, XCMPLX_0, XCMPLX_1,
      XREAL_0, XREAL_1, XXREAL_0, XXREAL_1, ZFMISC_1, INT_1, NAT_D, TOPREAL3,
      SQUARE_1;
 schemes FINSEQ_1, FUNCT_2, TREES_2;

begin

::$P-
theorem
  (ex S being Subset of TOP-REAL 2 st
    S is convex &
    (ex p being Point of TOP-REAL 2 st
      p in S & 0 < p.1 & 0 < p.2 & p.1 * p.2 = 1) &
    (ex p being Point of TOP-REAL 2 st
      p in S & p.1 < 0 & p.2 < 0 & p.1 * p.2 = 1) &
    (ex p being Point of TOP-REAL 2 st
      p in S & p.1 < 0 & 0 < p.2 & p.1 * p.2 = -1) &
    (ex p being Point of TOP-REAL 2 st
      p in S & 0 < p.1 & p.2 < 0 & p.1 * p.2 = -1) &
    (C_Meas (XL-Meas 2)).S = (4 qua ExtReal)) &
  (for S being Subset of TOP-REAL 2 st
    S is convex &
    (ex p being Point of TOP-REAL 2 st
      p in S & 0 < p.1 & 0 < p.2 & p.1 * p.2 = 1) &
    (ex p being Point of TOP-REAL 2 st
      p in S & p.1 < 0 & p.2 < 0 & p.1 * p.2 = 1) &
    (ex p being Point of TOP-REAL 2 st
      p in S & p.1 < 0 & 0 < p.2 & p.1 * p.2 = -1) &
    (ex p being Point of TOP-REAL 2 st
      p in S & 0 < p.1 & p.2 < 0 & p.1 * p.2 = -1)
  holds (4 qua ExtReal) <= (C_Meas (XL-Meas 2)).S)
proof
end;
::$P+
