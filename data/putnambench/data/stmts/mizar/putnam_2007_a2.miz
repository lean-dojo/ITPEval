      FUNCT_1, FUNCT_2, FVSUM_1, GOBOARD6, JORDAN2B, JORDAN6, LAPLACE,
      MATRIX_6, MATRIX13, MATRLIN, MATRLIN2, MATRTOP1, MATRTOP2, METRIC_1,
      METRIZTS, NAT_1, PARTFUN1, PCOMPS_1, PRALG_3, PRE_TOPC, RELAT_1,
