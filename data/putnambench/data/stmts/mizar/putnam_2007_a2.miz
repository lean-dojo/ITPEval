      VALUED_0, VECTSP_1, VECTSP_9, XBOOLE_0, XREAL_0, XXREAL_0, ORDINAL1,
      INT_1, SQUARE_1, CARD_3, CONVEX1, FUNCOP_1, FUNCT_2, GLIBPRE1,
      MEASUR13, MEASUR14, MEASURE1, MEASURE9, MEMBERED, RELAT_1, RLVECT_1,
      SETFAM_1, SRINGS_4, XXREAL_3;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
