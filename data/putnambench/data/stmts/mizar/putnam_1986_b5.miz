:: Statement-only formalization of PutnamBench corpus artifact putnam_1986_b5:
:: the assertion that every real polynomial triple preserving
:: x^2+y^2+z^2+xyz is a coordinate permutation with zero or two sign changes
:: is false. This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1,
      NAT_1, POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0,
      POLYNOM3, FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0,
      ALGSEQ_1, FUNCT_1, SUPINF_2, NUMBERS, VALUED_0, MESFUNC1,
      FINSEQ_1, AFINSQ_1, RLVECT_1, CARD_3, BINOP_1, TARSKI,
      POLYNOM5, PARTFUN1, LATTICES, ORDINAL4, FINSEQ_2, VECTSP_2,
      ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, NAT_1, VALUED_0, FINSEQ_1, FINSEQ_2,
      FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
      VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2,
      FINSEQ_4, VECTSP_2, ALGSTR_1;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0,
      VECTSP_1, CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0,
      RLVECT_1, MEMBERED, RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS,
      FUNCT_2, XBOOLE_0, NAT_1, VALUED_0, FINSEQ_1, FINSEQ_2,
      VECTSP_2, ALGSTR_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
      ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;
 theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3, POLYNOM4,
      POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0;

begin

::$P-
theorem
  not (for p,q,r being
      Polynomial of Polynom-Ring (Polynom-Ring F_Real) st
    (for x,y,z being Element of F_Real holds
      ex cz being Element of Polynom-Ring F_Real,
         ccz being Element of Polynom-Ring (Polynom-Ring F_Real),
         py,qy,ry being Polynomial of Polynom-Ring F_Real,
         cy being Element of Polynom-Ring F_Real,
         px,qx,rx being Polynomial of F_Real st
        cz = <%z%> &
        ccz = <%cz%> &
        py = eval(p,ccz) &
        qy = eval(q,ccz) &
        ry = eval(r,ccz) &
        cy = <%y%> &
        px = eval(py,cy) &
        qx = eval(qy,cy) &
        rx = eval(ry,cy) &
        eval(px,x) * eval(px,x) +
          eval(qx,x) * eval(qx,x) +
          eval(rx,x) * eval(rx,x) +
          eval(px,x) * eval(qx,x) * eval(rx,x) =
        x*x + y*y + z*z + x*y*z)
    holds
      ex vx,nvx being Element of Polynom-Ring F_Real,
         vy,vz,nvy,nvz being
           Element of Polynom-Ring (Polynom-Ring F_Real),
         X,Y,Z,NX,NY,NZ being
           Polynomial of Polynom-Ring (Polynom-Ring F_Real) st
        vx = <%0.F_Real,1.F_Real%> &
        nvx = <%0.F_Real,-1.F_Real%> &
        vy =
          <%0.(Polynom-Ring F_Real),1.(Polynom-Ring F_Real)%> &
        nvy =
          <%0.(Polynom-Ring F_Real),-1.(Polynom-Ring F_Real)%> &
        vz = <%vx%> &
        nvz = <%nvx%> &
        X =
          <%0.(Polynom-Ring (Polynom-Ring F_Real)),
            1.(Polynom-Ring (Polynom-Ring F_Real))%> &
        NX =
          <%0.(Polynom-Ring (Polynom-Ring F_Real)),
            -1.(Polynom-Ring (Polynom-Ring F_Real))%> &
        Y = <%vy%> &
        NY = <%nvy%> &
        Z = <%vz%> &
        NZ = <%nvz%> &
        ({p,q} \/ {r} = {X,Y} \/ {Z} or
         {p,q} \/ {r} = {X,NY} \/ {NZ} or
         {p,q} \/ {r} = {NX,Y} \/ {NZ} or
         {p,q} \/ {r} = {NX,NY} \/ {Z}))
proof
end;
::$P+
