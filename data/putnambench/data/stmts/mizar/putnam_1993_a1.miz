:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_a1:
:: the horizontal level c = 4/9 is positive, lies below 4*sqrt(2)/9, and has
:: equal positive-part area integrals for y = 2*x - 3*x^3. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    SQUARE_1, NEWTON, PREPOWER, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MEASUR12, INTEGRA5;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, NAT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, SQUARE_1,
    NEWTON, PREPOWER, VALUED_0, VALUED_1, SUPINF_2, MEASURE1,
    MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, SQUARE_1, NEWTON, PREPOWER, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    SQUARE_1, XXREAL_3, MEASURE1, MEASUR12;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities SQUARE_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  ex c being Real,
     I,J being Subset of REAL,
     f,g being Function of REAL,REAL st
    c = (4 qua Real) / 9 &
    0 < c &
    c < (4 * sqrt 2) / 9 &
    I = {x where x is Real : 0 < x & x < (sqrt 2) / 3} &
    J = {x where x is Real : 0 < x & x < (sqrt 6) / 3} &
    (for x being Real holds
      f.x = max(c - (2*x - 3*(x |^ 3)),0)) &
    (for x being Real holds
      g.x = max((2*x - 3*(x |^ 3)) - c,0)) &
    Integral(L-Meas,f|I) = Integral(L-Meas,g|J)
proof
end;
::$P+
