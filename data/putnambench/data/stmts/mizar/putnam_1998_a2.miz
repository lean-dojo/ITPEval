:: Statement-only formalization of PutnamBench corpus artifact putnam_1998_a2:
:: for a first-quadrant unit-circle arc, the sum of the areas below and to
:: the left of the arc depends only on its angular length. This file contains
:: no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, CARD_3, COMPLEX1,
      EUCLID, FINSEQ_1, FINSEQ_2, FUNCOP_1, FUNCT_1, FUNCT_2, MEASUR13,
      MEASUR14, MEASURE1, MEASURE5, MEASURE8, MEMBERED, METRIC_1, NAT_1,
      NUMBERS, PARTFUN1, PRE_TOPC, PROB_1, PROB_2, REAL_1, RELAT_1,
      RLTOPSP1, RLVECT_1, SETFAM_1, SIN_COS, SIN_COS9, STRUCT_0, SUBSET_1,
      SUPINF_2, TARSKI, VALUED_0, XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0,
      ZFMISC_1, FINSUB_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, CARD_1,
      FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0,
      VALUED_0, EXTREAL1, NAT_1, FINSEQ_1, FINSEQ_2, STRUCT_0,
      METRIC_1, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, SUPINF_2, PROB_1,
      PROB_2, MEASURE1, MEASURE3, MEASURE4, MEASURE5, MEASURE8, MEASUR12,
      MEASUR13, MEASUR14, SIN_COS, SIN_COS9;
 constructors EXTREAL1, SUPINF_1, DOMAIN_1, FINSEQOP, FUNCT_2, RELSET_1,
      MEASURE3, PROB_3, MEASUR12, MEASUR13, MEASUR14, MEASURE8, METRIC_1,
      EUCLID, RLTOPSP1, TOPREAL6, SIN_COS, SIN_COS9;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, FINSEQ_1, FINSEQ_2, FUNCT_1,
      FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9, MEMBERED, SRINGS_4,
      SETFAM_1, MEASUR13, MEASUR14, GLIBPRE1, EUCLID, STRUCT_0, RLVECT_1,
      RLTOPSP1, XXREAL_3, SIN_COS;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI;
 equalities FINSEQ_1, BINOP_1, SUBSET_1, MEASUR13, FINSEQ_2, XCMPLX_0,
      STRUCT_0, RLVECT_1, EUCLID;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for A,B being Function of [:REAL 2,REAL 2:],REAL st
    (for P,Q being Element of REAL 2 holds
      (A.[P,Q] qua ExtReal) =
        (C_Meas (XL-Meas 2)).
          {S where S is Element of REAL 2 :
            ex R being Element of REAL 2 st
              0 < R.1 & 0 < R.2 & |.R.| = 1 &
              P.1 > R.1 & R.1 > Q.1 &
              R.1 = S.1 & R.2 > S.2 & S.2 > 0}) &
    (for P,Q being Element of REAL 2 holds
      (B.[P,Q] qua ExtReal) =
        (C_Meas (XL-Meas 2)).
          {S where S is Element of REAL 2 :
            ex R being Element of REAL 2 st
              0 < R.1 & 0 < R.2 & |.R.| = 1 &
              P.1 > R.1 & R.1 > Q.1 &
              R.2 = S.2 & R.1 > S.1 & S.1 > 0})
  holds
    ex f being Function of REAL,REAL st
      for P,Q being Element of REAL 2 st
        0 < P.1 & 0 < P.2 & |.P.| = 1 &
        0 < Q.1 & 0 < Q.2 & |.Q.| = 1 &
        P.1 > Q.1
      holds
        A.[P,Q] + B.[P,Q] =
          f.(arctan.(Q.2 / Q.1) - arctan.(P.2 / P.1))
proof
end;
::$P+
