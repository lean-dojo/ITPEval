:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_a1:
:: a binary free-throw success-rate sequence crossing from below to above
:: four fifths attains exactly four fifths in between. This file contains no
:: proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, TARSKI, XREAL_0, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, REAL_1, FINSEQOP, ZFMISC_1,
    VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, FUNCT_2, ORDINAL1;
  notations TARSKI, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1, NUMBERS,
    VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1,
    RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, NAT_D, FINSOP_1,
    FINSEQOP, SETWOP_2, RVSUM_1;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, NAT_D, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1,
    XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, FUNCT_2, NUMBERS,
    XCMPLX_0, XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, VALUED_0,
    VALUED_1, RELAT_1, FINSEQ_4, CARD_1, INT_1, RVSUM_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for attempts being Function of NAT,NAT,
      S being Function of NAT,REAL st
    (for n being Nat holds attempts.n = 0 or attempts.n = 1) &
    (for n being Nat st 1 <= n holds
      ex terms being FinSequence of REAL st
        len terms = n &
        (for k being Nat st k in Seg n holds
          terms.k = attempts.(k -' 1)) &
        S.n = Sum terms / (n qua Real))
  holds
    for a,b being Nat st
      1 <= a & a < b &
      S.a < (4 qua Real) / 5 & S.b > (4 qua Real) / 5
    holds
      ex c being Nat st
        a < c & c < b & S.c = (4 qua Real) / 5
proof
end;
::$P+
