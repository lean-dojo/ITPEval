:: Statement-only formalization of PutnamBench corpus artifact putnam_1991_b2
:: (putnambench__mizar__putnam_1991_b2): nonconstant differentiable real
:: functions satisfying the complex-addition identities have unit squared
:: modulus everywhere when the derivative of the first at zero vanishes.
:: This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, FDIFF_1, COMPLEX1, SQUARE_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2, SQUARE_1;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    FCONT_1, ORDINAL1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities XCMPLX_0, SQUARE_1;

begin

::$P-
theorem
  for f,g being Function of REAL,REAL st
    (not ex c being Real st
      for x being Real holds f.x = c) &
    (not ex c being Real st
      for x being Real holds g.x = c) &
    f is_differentiable_on [#]REAL &
    g is_differentiable_on [#]REAL &
    (for x,y being Real holds
      f.(x+y) = f.x * f.y - g.x * g.y) &
    (for x,y being Real holds
      g.(x+y) = f.x * g.y + g.x * f.y)
  holds
    diff(f,0) = 0 implies
      for x being Real holds
        (f.x)^2 + (g.x)^2 = 1
proof
end;
::$P+
