:: Statement-only formalization of PutnamBench artifact putnam_1973_a1:
:: two area inequalities for a triangle and points on its three sides,
:: expressed in real-plane coordinates. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for xA,yA,xB,yB,xC,yC,xX,yX,xY,yY,xZ,yZ being Real st
    (xB-xA)*(yC-yA) - (yB-yA)*(xC-xA) <> 0 &
    (ex t being Real st
      0 <= t & t <= 1 &
      xX = (1-t)*xB + t*xC &
      yX = (1-t)*yB + t*yC) &
    (ex t being Real st
      0 <= t & t <= 1 &
      xY = (1-t)*xC + t*xA &
      yY = (1-t)*yC + t*yA) &
    (ex t being Real st
      0 <= t & t <= 1 &
      xZ = (1-t)*xA + t*xB &
      yZ = (1-t)*yA + t*yB)
  holds
    ((sqrt((xX-xB)^2 + (yX-yB)^2) <=
        sqrt((xC-xX)^2 + (yC-yX)^2) &
      sqrt((xY-xC)^2 + (yY-yC)^2) <=
        sqrt((xA-xY)^2 + (yA-yY)^2) &
      sqrt((xZ-xA)^2 + (yZ-yA)^2) <=
        sqrt((xB-xZ)^2 + (yB-yZ)^2))
      implies
        |.(xY-xX)*(yZ-yX) - (yY-yX)*(xZ-xX).| >=
          (1/4) * |.(xB-xA)*(yC-yA) - (yB-yA)*(xC-xA).|) &
    (|.(xZ-xA)*(yY-yA) - (yZ-yA)*(xY-xA).| <=
        |.(xY-xX)*(yZ-yX) - (yY-yX)*(xZ-xX).| or
      |.(xX-xB)*(yZ-yB) - (yX-yB)*(xZ-xB).| <=
        |.(xY-xX)*(yZ-yX) - (yY-yX)*(xZ-xX).| or
      |.(xY-xC)*(yX-yC) - (yY-yC)*(xX-xC).| <=
        |.(xY-xX)*(yZ-yX) - (yY-yX)*(xZ-xX).|)
proof
end;
::$P+
