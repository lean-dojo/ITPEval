:: Statement-only formalization of PutnamBench corpus artifact putnam_2005_b3
:: (putnambench__mizar__putnam_2005_b3): classification of positive
:: differentiable functions on the positive reals satisfying the specified
:: reciprocal-argument derivative equation. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FDIFF_1, COMPLEX1, POWER;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FDIFF_1, VALUED_1, XXREAL_2, COMPLEX1,
    RELSET_1, BINOP_2, COMSEQ_2, POWER;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    (for x being Real st 0 < x holds 0 < f.x) &
    (for x being Real st 0 < x holds f is_differentiable_in x)
  holds
    ((ex a being Real st
        0 < a &
        for x being Real st 0 < x holds
          diff(f,a/x) = x/f.x)
      iff
      ex c,d being Real st
        0 < c & 0 < d &
        (d = 1 implies c = 1) &
        for x being Real st 0 < x holds
          f.x = c * (x to_power d))
proof
end;
::$P+
