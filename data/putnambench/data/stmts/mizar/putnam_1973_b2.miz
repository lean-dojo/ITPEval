:: Statement-only formalization of PutnamBench corpus artifact putnam_1973_b2:
:: a unit complex number with rational real and imaginary parts has rational
:: modulus after subtracting one from every even integer power. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_1, NEWTON, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, XXREAL_0, NEWTON, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, COMPLEX1,
    INT_1, XXREAL_0, NEWTON, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for z being Complex st
    (ex q1,q2 being Rational st Re z = q1 & Im z = q2) &
    |.z.| = 1
  holds
    for n being Integer ex k being Nat, q being Rational st
      (0 <= n & n = k &
        |.z |^ (2*k) - 1.| = q) or
      (n < 0 & -n = k &
        |.(1/z) |^ (2*k) - 1.| = q)
proof
end;
::$P+
