:: Statement-only formalization of PutnamBench artifact putnam_1973_a3:
:: the attained minimum of k + n/k over positive integers k has the same
:: integer part as the square root of 4n+1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0,
    VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, NAT_1, INT_1, COMPLEX1, SQUARE_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, REAL_1, NAT_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, VALUED_0, VALUED_1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for b being Function of INT,REAL st
    (for n being Integer holds
      (for k being Integer st k > 0 holds
        b/.n <=
          (k qua Real) + (n qua Real) / (k qua Real)) &
      (ex k being Integer st
        k > 0 &
        b/.n =
          (k qua Real) + (n qua Real) / (k qua Real)))
  holds
    for n being Integer st n > 0 holds
      [\ b/.n /] = [\ sqrt(4 * (n qua Real) + 1) /]
proof
end;
::$P+
