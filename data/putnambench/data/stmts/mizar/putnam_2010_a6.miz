:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_a6
:: (putnambench__mizar__putnam_2010_a6): a strictly decreasing continuous
:: real function on the nonnegative reals tending to zero has a divergent
:: improper integral of (f(x)-f(x+1))/f(x). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
    LIMFUNC1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0,
    VALUED_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1, LIMFUNC1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, LIMFUNC1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, XXREAL_3,
    MEASURE1, MEASUR12;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    (for x,y being Real st 0 <= x & x < y holds f.x > f.y) &
    (for x being Real st 0 <= x holds
      for e being Real st 0 < e holds
        ex d being Real st 0 < d &
          for y being Real st 0 <= y & |.y-x.| < d holds
            |.f.y-f.x.| < e) &
    (for e being Real st 0 < e holds
      ex B being Real st 0 <= B &
        for x being Real st B <= x holds |.f.x.| < e)
  holds
    not ex h,F being Function of REAL,REAL st
      (for x being Real holds
        h.x = (f.x - f.(x+1)) / f.x) &
      (for t being Real st 0 <= t holds
        ex I being Subset of REAL st
          I = {x where x is Real : 0 <= x & x <= t} &
          F.t = Integral(L-Meas,h|I)) &
      F is convergent_in+infty
proof
end;
::$P+
