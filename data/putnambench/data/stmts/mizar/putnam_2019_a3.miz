:: Statement-only formalization of PutnamBench corpus artifact putnam_2019_a3
:: (putnambench__mizar__putnam_2019_a3): the greatest universal lower bound
:: for the average modulus of the roots of a degree-2019 polynomial whose
:: real coefficients increase strictly from at least 1 to at most 2019 is
:: 2019^(-1/2019). This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, TARSKI, XREAL_0, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1, FINSEQOP,
    ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, COMPLEX1, NEWTON, POWER;
  notations TARSKI, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1, NUMBERS,
    VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1,
    RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
    FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, NAT_D,
    FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, NEWTON, POWER;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, NAT_D, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1,
    XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1, COMPLEX1, NEWTON, POWER;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, FUNCT_2, FUNCOP_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2, FINSEQ_1, FINSEQ_2,
    VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1, RVSUM_1, RELSET_1,
    MEMBERED, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ((for b being FinSequence of REAL,
        z being FinSequence of COMPLEX st
      len b = 2020 &
      1 <= b.1 &
      b.2020 <= 2019 &
      (for i being Nat st i in Seg 2019 holds b.i < b.(i + 1)) &
      len z = 2019 &
      (for w being Complex holds
        ex terms,factors being FinSequence of COMPLEX st
          len terms = 2020 &
          (for i being Nat st i in Seg 2020 holds
            terms.i = (b.i qua Complex) * (w |^ (i -' 1))) &
          len factors = 2019 &
          (for i being Nat st i in Seg 2019 holds
            factors.i = w - z.i) &
          Sum terms = (b.2020 qua Complex) * Product factors)
    holds
      ex moduli being FinSequence of REAL st
        len moduli = 2019 &
        (for i being Nat st i in Seg 2019 holds moduli.i = |.z.i.|) &
        ((2019 qua Real) to_power (-((1 qua Real) / 2019))) <=
          Sum moduli / 2019) &
   (for M being Real st
      (for b being FinSequence of REAL,
          z being FinSequence of COMPLEX st
        len b = 2020 &
        1 <= b.1 &
        b.2020 <= 2019 &
        (for i being Nat st i in Seg 2019 holds b.i < b.(i + 1)) &
        len z = 2019 &
        (for w being Complex holds
          ex terms,factors being FinSequence of COMPLEX st
            len terms = 2020 &
            (for i being Nat st i in Seg 2020 holds
              terms.i = (b.i qua Complex) * (w |^ (i -' 1))) &
            len factors = 2019 &
            (for i being Nat st i in Seg 2019 holds
              factors.i = w - z.i) &
            Sum terms = (b.2020 qua Complex) * Product factors)
      holds
        ex moduli being FinSequence of REAL st
          len moduli = 2019 &
          (for i being Nat st i in Seg 2019 holds moduli.i = |.z.i.|) &
          M <= Sum moduli / 2019)
    holds
      M <= (2019 qua Real) to_power (-((1 qua Real) / 2019))))
proof
end;
::$P+
