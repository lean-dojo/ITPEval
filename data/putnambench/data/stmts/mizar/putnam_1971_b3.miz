:: Statement-only formalization of PutnamBench artifact putnam_1971_b3:
:: the Lebesgue measure of the times after a positive delay when one floor
:: count is twice the delayed floor count is one. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      TARSKI, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1,
      PROB_1, MEASURE1, MEASURE4, MEASURE8, MEASUR12, SUPINF_2,
      VALUED_0, PARTFUN1, CARD_1, ORDINAL1, XCMPLX_0;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, REAL_1, INT_1, XXREAL_3, VALUED_0,
      SUPINF_2, PROB_1, MEASURE1, MEASURE4, MEASURE8, MEASUR12;
 constructors RELSET_1, FUNCT_2, REAL_1, INT_1, SUPINF_1, MEASURE4,
      MEASURE8, MEASUR12;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1,
      INT_1, MEMBERED, VALUED_0, MEASURE1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities XCMPLX_0;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for T being Real st 0 < T holds
    (C_Meas L-Meas).{t where t is Real :
      T <= t &
      ex u being Real st u = t - T & [\ t /] = 2 * [\ u /]} = 1
proof
end;
::$P+
