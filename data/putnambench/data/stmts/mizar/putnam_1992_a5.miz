:: Statement-only formalization of PutnamBench corpus artifact putnam_1992_a5:
:: the binary digit-parity sequence has no three consecutive identical blocks
:: of positive length. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D, POWER;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for num1s,a being Function of NAT,NAT st
    num1s.0 = 0 &
    (for n being Nat st 0 < n holds
      num1s.n = (n mod 2) + num1s.(n div 2)) &
    (for n being Nat holds a.n = num1s.n mod 2)
  holds
    not ex k,m being Nat st
      0 < k & 0 < m &
      for j being Nat st j <= m -' 1 holds
        a.(k + j) = a.(k + m + j) &
        a.(k + m + j) = a.(k + 2 * m + j)
proof
end;
::$P+
