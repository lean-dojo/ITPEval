:: Statement-only formalization of PutnamBench corpus artifact putnam_2014_b3:
:: a positive-dimensional rational matrix with at least m+n distinct primes
:: among its absolute entry values has rank at least two. This file contains
:: no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, CARD_3, CLASSES1,
      COMPLEX1, FINSEQ_1, FINSEQ_2, FINSEQ_4, FINSET_1, FUNCOP_1, GAUSSINT,
      FUNCT_1, FUNCT_2, FUNCT_7, GROUP_1, INT_2, MATRIX_1, MATRIX_3,
      MATRIX13, NAT_1,
      NUMBERS, ORDINAL2, ORDINAL4, PARTFUN1, PRVECT_1, QC_LANG1, RAT_1,
      REAL_1, RELAT_1, RLVECT_1, RLVECT_2, RLVECT_3, RLVECT_5, SETFAM_1,
      STRUCT_0, SUBSET_1, SUPINF_2, TARSKI, VALUED_0, VALUED_1, VECTSP_1,
      XBOOLE_0, XCMPLX_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, CARD_1, XREAL_0, REAL_1, COMPLEX1, FINSET_1,
      DOMAIN_1, FUNCT_7,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FUNCOP_1,
      STRUCT_0, FINSEQ_2, FINSEQOP, RVSUM_1, RLVECT_1, RLVECT_2,
      VALUED_0, ALGSTR_0, GROUP_1, FVSUM_1, RLSUB_1, RLVECT_3, RLVECT_5,
      CARD_3, VECTSP_1, MATRIX_0, MATRIX_1, NAT_D, INT_2, RAT_1,
      MATRIX_3, MATRIX_6, VECTSP_6, VECTSP_7, MATRIX13, PRVECT_1, GAUSSINT;
 constructors BINOP_2, FVSUM_1, MATRIX_6, MATRIX13, NAT_D, RANKNULL,
      REAL_1, REALSET1, RLVECT_3, RLVECT_5, VECTSP_7, WELLORD2,
      MATRIX_1, INT_2, RAT_1, GAUSSINT, FUNCT_7, GROUP_1;
 registrations CARD_1, FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, MATRIX13,
      NAT_1, NUMBERS, PRVECT_1, RELSET_1, RLVECT_5, RVSUM_1, STRUCT_0, INT_2,
      SUBSET_1, VALUED_0, VECTSP_1, VECTSP_9, XBOOLE_0, XREAL_0,
      XXREAL_0, ORDINAL1, RAT_1, GAUSSINT, FRAENKEL;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities FINSEQ_1, MATRIX13, STRUCT_0, SUBSET_1;
 expansions FINSEQ_1, STRUCT_0, TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for m,n being Nat st 0 < m & 0 < n
  for A being Matrix of m,n,the carrier of F_Rat st
    (m+n) c= card {p where p is Nat : p > 1 &
      (for d being Nat st d divides p holds d = 1 or d = p) &
      ex i,j being Nat, q being Rational st
        [i,j] in Indices A & q = A*(i,j) &
        |.q.| = (p qua Real)}
  holds
    the_rank_of A >= 2
proof
end;
::$P+
