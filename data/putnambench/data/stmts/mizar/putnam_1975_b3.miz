:: Statement-only formalization of PutnamBench corpus artifact putnam_1975_b3:
:: the supremum characterization for the ratio of a positive tuple's k-th
:: elementary symmetric sum to the k-th power of its first symmetric sum.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4,
    VALUED_0, VALUED_1, CARD_1, CARD_3, RELAT_1, SUBSET_1, XBOOLE_0,
    FUNCT_1, FUNCT_2, TARSKI, XREAL_0, XXREAL_0, ORDINAL1, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1, FINSEQOP,
    ZFMISC_1, XCMPLX_0, SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1,
    NEWTON, INT_1, PARTFUN1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, RELAT_1,
    FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1, FUNCOP_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4, VALUED_1, NAT_1, NAT_D,
    INT_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, NEWTON;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, BINOP_2, VALUED_1,
    FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1, XXREAL_1,
    REAL_1, FINSEQ_2, FINSEQ_3, RVSUM_1, NEWTON, NAT_D;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, FINSEQ_3, VALUED_0, VALUED_1, RELAT_1,
    FINSEQ_4, CARD_1, RVSUM_1, RELSET_1, MEMBERED, FRAENKEL, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for k being Nat st k > 0 holds
    (for a being FinSequence of REAL st
      len a >= k &
      (for i being Nat st i in Seg len a holds a.i > 0)
    holds
      ex ksets,onesets being FinSequence of bool (Seg len a),
         kterms,oneterms being FinSequence of REAL st
        ksets is one-to-one &
        rng ksets =
          {S where S is Subset of Seg len a : card S = k} &
        onesets is one-to-one &
        rng onesets =
          {S where S is Subset of Seg len a : card S = 1} &
        len kterms = len ksets &
        (for j being Nat st j in Seg len kterms holds
          ex S being Subset of Seg len a st
            S = ksets.j &
            ex selected being FinSequence of REAL st
              selected = a * Sgm S &
              kterms.j = Product selected) &
        len oneterms = len onesets &
        (for j being Nat st j in Seg len oneterms holds
          ex S being Subset of Seg len a st
            S = onesets.j &
            ex selected being FinSequence of REAL st
              selected = a * Sgm S &
              oneterms.j = Product selected) &
        Sum kterms / ((Sum oneterms) |^ k)
          <= 1 / ((Product Sgm (Seg k)) qua Real)) &
    (for M being Real st
      M < 1 / ((Product Sgm (Seg k)) qua Real)
    holds
      ex a being FinSequence of REAL,
         ksets,onesets being FinSequence of bool (Seg len a),
         kterms,oneterms being FinSequence of REAL st
        len a >= k &
        (for i being Nat st i in Seg len a holds a.i > 0) &
        ksets is one-to-one &
        rng ksets =
          {S where S is Subset of Seg len a : card S = k} &
        onesets is one-to-one &
        rng onesets =
          {S where S is Subset of Seg len a : card S = 1} &
        len kterms = len ksets &
        (for j being Nat st j in Seg len kterms holds
          ex S being Subset of Seg len a st
            S = ksets.j &
            ex selected being FinSequence of REAL st
              selected = a * Sgm S &
              kterms.j = Product selected) &
        len oneterms = len onesets &
        (for j being Nat st j in Seg len oneterms holds
          ex S being Subset of Seg len a st
            S = onesets.j &
            ex selected being FinSequence of REAL st
              selected = a * Sgm S &
              oneterms.j = Product selected) &
        Sum kterms / ((Sum oneterms) |^ k) > M)
proof
end;
::$P+
