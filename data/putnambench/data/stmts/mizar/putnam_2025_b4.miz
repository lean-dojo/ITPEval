:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_b4
:: (putnambench__mizar__putnam_2025_b4): an upper bound for the sum of
:: entries of a nonnegative-integer matrix with zero and unit-step
:: constraints, in terms of its number of nonzero entries.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, NUMBERS, NAT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, XXREAL_2, COMPLEX1, SQUARE_1,
    ORDINAL1, ORDINAL2, FINSET_1, NEWTON, PREPOWER, SEQ_4, ABIAN,
    ARYTM_1, ARYTM_3, VALUED_0, VALUED_1, SEQ_1, SEQ_2, SERIES_1,
    SIN_COS, INT_1, FVSUM_1, RVSUM_1, BINOP_1, BINOP_2, SETWISEO,
    SETWOP_2, FUNCOP_1, FINSEQOP, FINSOP_1, POWER;
  notations TARSKI, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1, NUMBERS,
    VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, XXREAL_2,
    REAL_1, COMPLEX1, SQUARE_1, RELAT_1, FUNCT_1, PARTFUN1, BINOP_2,
    SETWISEO, FUNCT_2, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4,
    VALUED_1, NAT_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, INT_1,
    NAT_D, RELSET_1, MATRIX_0, MATRIX_1, FINSET_1, NEWTON, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, SERIES_1,
    SIN_COS, POWER;
  constructors REAL_1, NUMBERS, RELSET_1, PARTFUN1, FUNCT_2, BINOP_1,
    BINOP_2, SETWISEO, SETWOP_2, FINSOP_1, FINSEQOP, FINSEQ_4, MATRIX_1,
    NAT_1, NAT_D, NEWTON, INT_1, XXREAL_0, COMPLEX1, SQUARE_1, SEQ_2,
    SEQM_3, SEQ_4, PREPOWER, ABIAN, COMSEQ_2, SERIES_1, SIN_COS,
    RVSUM_1, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, NEWTON, VALUED_0, VALUED_1, MEMBERED, FRAENKEL, BINOP_2,
    RVSUM_1, SQUARE_1, PREPOWER, SEQ_4, ABIAN, SEQ_1, SIN_COS;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for m,S,N being Nat, A being Matrix of m+2,NAT st
    (for i,j being Nat st
      i in Seg (m+2) & j in Seg (m+2) & i+j <= m+2
      holds A*(i,j) = 0) &
    (for i,j being Nat st i in Seg (m+1) & j in Seg (m+2) holds
      A*(i+1,j) = A*(i,j) or A*(i+1,j) = A*(i,j) + 1) &
    (for i,j being Nat st i in Seg (m+2) & j in Seg (m+1) holds
      A*(i,j+1) = A*(i,j) or A*(i,j+1) = A*(i,j) + 1) &
    (ex terms being FinSequence of NAT st
      len terms = (m+2)*(m+2) &
      (for i,j being Nat st i in Seg (m+2) & j in Seg (m+2) holds
        terms.((i-'1)*(m+2)+j) = A*(i,j)) &
      S = addnat $$ terms) &
    N = card {[i,j] where i,j is Nat :
      i in Seg (m+2) & j in Seg (m+2) & A*(i,j) <> 0}
  holds 3*S <= (m+4)*N
proof
end;
::$P+
