:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_b4:
:: the real fixed point of the continued fraction above one has eighth root
:: (3 + sqrt 5)/2. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, ORDINAL1, ORDINAL2, SEQ_4, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2,
    COMSEQ_2, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for contfrac being Real st
    contfrac = 2207 - 1 / contfrac &
    1 < contfrac
  holds
    contfrac to_power ((1 qua Real) / 8) = (3 + sqrt 5) / 2
proof
end;
::$P+
