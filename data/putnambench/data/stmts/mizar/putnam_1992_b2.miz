:: Statement-only formalization of PutnamBench corpus artifact putnam_1992_b2:
:: the coefficient of x^k in (1+x+x^2+x^3)^n equals a finite sum of
:: products of binomial coefficients. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, NUMBERS, NAT_1, INT_1, INT_3, NEWTON, FINSEQ_1, FINSEQ_2,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1, STRUCT_0, ALGSTR_0, RLVECT_1,
    VECTSP_1, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM5,
    FUNCT_4, SUPINF_2, MESFUNC1, AFINSQ_1, BINOP_1, PARTFUN1,
    LATTICES, ORDINAL4, VECTSP_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, INT_1, INT_3, NAT_1, NAT_D, NEWTON, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1, STRUCT_0, ALGSTR_0,
    ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2, ALGSEQ_1,
    POLYNOM3, POLYNOM4, POLYNOM5;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, NAT_D, INT_1, INT_3, NEWTON,
    NUMBERS, RVSUM_1, FINSEQOP, ALGSEQ_1, POLYNOM4, POLYNOM5,
    BINOP_2, FINSEQ_4, VECTSP_2, ALGSTR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, INT_3, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1, STRUCT_0, ALGSTR_0, RLVECT_1, VECTSP_1, VECTSP_2,
    ALGSEQ_1, POLYNOM3, POLYNOM5, PRE_POLY, MEMBERED;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
  equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
    ALGSTR_0;
  expansions TARSKI, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  for Q being Function of [:NAT,NAT:],NAT st
    (for n,k being Nat holds
      (Q.([n,k]) qua Integer) =
        ((<%1.INT.Ring,1.INT.Ring%> +
          (<%0.INT.Ring,1.INT.Ring%>`^2) +
          (<%0.INT.Ring,1.INT.Ring%>`^3))`^n).k)
  holds
    for n,k being Nat holds
      ex terms being FinSequence of NAT st
        len terms = k + 1 &
        (for j being Nat st j <= k & 2 * j <= k holds
          terms.(j + 1) =
            (n choose j) * (n choose (k -' 2 * j))) &
        (for j being Nat st j <= k & k < 2 * j holds
          terms.(j + 1) = 0) &
        Q.([n,k]) = Sum terms
proof
end;
::$P+
