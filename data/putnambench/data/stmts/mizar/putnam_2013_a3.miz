:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_a3
:: (putnambench__mizar__putnam_2013_a3): a vanishing finite weighted
:: reciprocal sum yields a zero of the associated real polynomial in (0,1).
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4, BINOP_1,
    BINOP_2, FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, NEWTON, PREPOWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, NAT_D,
    PARTFUN1, BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP,
    SETWOP_2, RVSUM_1, NEWTON, PREPOWER;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NAT_1, NAT_D, BINOP_1,
    SETWISEO, BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1,
    SETWOP_2, XXREAL_1, FINSEQ_2, RVSUM_1, ZFMISC_1, NEWTON,
    PREPOWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1, NEWTON,
    PREPOWER;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      a being FinSequence of REAL,
      x being Real st
    len a = n + 1 &
    0 < x & x < 1 &
    (ex weightedTerms being FinSequence of REAL st
      len weightedTerms = n + 1 &
      (for k being Nat st k in Seg (n + 1) holds
        weightedTerms.k = a.k / (1 - x |^ k)) &
      Sum weightedTerms = 0)
  holds
    ex y being Real,
       polynomialTerms being FinSequence of REAL st
      0 < y & y < 1 &
      len polynomialTerms = n + 1 &
      (for k being Nat st k in Seg (n + 1) holds
        polynomialTerms.k = a.k * (y |^ (k -' 1))) &
      Sum polynomialTerms = 0
proof
end;
::$P+
