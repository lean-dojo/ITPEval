:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_a3
:: (putnambench__mizar__putnam_2023_a3): PI/2 is the smallest positive real
:: zero time attainable by globally differentiable real functions satisfying
:: the stated initial conditions and mutual derivative bounds. This file
:: contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, VALUED_0, VALUED_1, ORDINAL1, RCOMP_1,
    FDIFF_1, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, VALUED_0, VALUED_1, RCOMP_1, FDIFF_1,
    SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    RCOMP_1, RFUNCT_2, FDIFF_1, SIN_COS, VALUED_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, RCOMP_1, FDIFF_1,
    SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities XCMPLX_0, VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  0 < PI / 2 &
  (ex f,g being Function of REAL,REAL st
    f is_differentiable_on [#]REAL &
    g is_differentiable_on [#]REAL &
    f.0 > 0 &
    g.0 = 0 &
    (for x being Real holds
      |.diff(f,x).| <= |.g.x.| &
      |.diff(g,x).| <= |.f.x.|) &
    f.(PI / 2) = 0) &
  (for r being Real st 0 < r & r < PI / 2 holds
    not ex f,g being Function of REAL,REAL st
      f is_differentiable_on [#]REAL &
      g is_differentiable_on [#]REAL &
      f.0 > 0 &
      g.0 = 0 &
      (for x being Real holds
        |.diff(f,x).| <= |.g.x.| &
        |.diff(g,x).| <= |.f.x.|) &
      f.r = 0)
proof
end;
::$P+
