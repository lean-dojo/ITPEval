:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_a5:
:: real polynomial values at 1 through n form the counterclockwise vertices
:: of a regular n-gon, forcing one polynomial to have degree at least n-1.
:: This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3,
      FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1,
      SUPINF_2, NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1,
      CARD_3, BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4,
      FINSEQ_2, VECTSP_2, ZFMISC_1, FUNCT_2, COMPLEX1, VALUED_1,
      RVSUM_1, PREPOWER, NEWTON, INT_1, SIN_COS, ABIAN, ORDINAL2,
      BINOP_2, FUNCOP_1, FINSEQOP, XXREAL_1, SETWISEO, SETWOP_2,
      FINSOP_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      REAL_1, COMPLEX1, INT_1, NAT_1, NAT_D, NEWTON, PREPOWER, VALUED_0,
      VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1, FUNCT_7, STRUCT_0, ALGSTR_0,
      ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2, ALGSEQ_1,
      POLYNOM3, POLYNOM4, POLYNOM5, SIN_COS, ABIAN, ZFMISC_1, BINOP_2,
      SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_4, FINSOP_1, FINSEQOP,
      SETWOP_2;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
      VECTSP_2, ALGSTR_1, FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
      COMPLEX1, INT_1, NAT_1, NAT_D, NEWTON, PREPOWER, RVSUM_1, FINSEQOP,
      SIN_COS, ABIAN, PARTFUN1, BINOP_1, SETWISEO, VALUED_1, SETWOP_2,
      FINSOP_1, XXREAL_1;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      INT_1, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, VECTSP_2, ALGSTR_1,
      RVSUM_1, NEWTON, SIN_COS, ABIAN, FUNCOP_1, BINOP_2, FINSEQ_4;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  for n being Nat,
      f,g being Polynomial of F_Real st
    n >= 3 &
    (ex center,z being Complex st
      z <> 0 &
      for k being Nat st 1 <= k & k <= n holds
        ex x being Element of F_Real st
          x = k &
          ex angle being Complex st
            angle = (((2 * PI) / n) * (x qua Real)) * <i> &
            (eval(f,x) qua Complex) +
                <i> * (eval(g,x) qua Complex) =
              center + z * exp(angle))
  holds
    len f >= n or len g >= n
proof
end;
::$P+
