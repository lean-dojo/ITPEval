:: Statement-only formalization of PutnamBench corpus artifact putnam_2018_a3
:: (putnambench__mizar__putnam_2018_a3): the greatest possible value of
:: the sum of cos(3*x_i) for ten real numbers whose cosines sum to zero
:: is 480/49. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, FUNCT_2, TARSKI, XREAL_0,
    ORDINAL4, BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1,
    FINSEQOP, ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0,
    SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1,
    SIN_COS, COMPLEX1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1,
    RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
    FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, FINSOP_1,
    FINSEQOP, SETWOP_2, RVSUM_1, INT_1, SIN_COS;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, BINOP_2, VALUED_1,
    FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1, XXREAL_1,
    REAL_1, FINSEQ_2, RVSUM_1, INT_1, SIN_COS, COMPLEX1;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1,
    INT_1, RVSUM_1, SIN_COS, RELSET_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  (ex x,cosines,tripleCosines being FinSequence of REAL st
    len x = 10 &
    len cosines = 10 &
    len tripleCosines = 10 &
    (for i being Nat st i in Seg 10 holds
      cosines.i = cos(x.i) &
      tripleCosines.i = cos(3 * x.i)) &
    Sum cosines = 0 &
    Sum tripleCosines = (480 qua Real) / 49) &
  (for x,cosines,tripleCosines being FinSequence of REAL st
    len x = 10 &
    len cosines = 10 &
    len tripleCosines = 10 &
    (for i being Nat st i in Seg 10 holds
      cosines.i = cos(x.i) &
      tripleCosines.i = cos(3 * x.i)) &
    Sum cosines = 0
  holds
    Sum tripleCosines <= (480 qua Real) / 49)
proof
end;
::$P+
