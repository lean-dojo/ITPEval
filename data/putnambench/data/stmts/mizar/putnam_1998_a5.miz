:: Statement-only formalization of PutnamBench corpus artifact putnam_1998_a5:
:: a finite open-disc cover in the real Euclidean plane has a pairwise
:: disjoint subcollection whose threefold dilations cover the same set.
:: This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, FUNCT_2, METRIC_1, NAT_1,
      NUMBERS, PARTFUN1, PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1,
      RVSUM_1, SQUARE_1, STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0,
      VALUED_1, XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, VALUED_0, FINSEQ_1,
      FINSEQ_2, FINSET_1, SQUARE_1, STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, RVSUM_1, TOPMETR, TOPREAL9;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, TOPMETR, TOPREAL9, FINSET_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1, FINSET_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  for k being Nat,
      c being FinSequence of TOP-REAL 2,
      r being FinSequence of REAL,
      E being Subset of TOP-REAL 2 st
    len c = k &
    len r = k &
    (for i being Nat st i in Seg k holds 0 < r.i) &
    (for p being Point of TOP-REAL 2 st p in E holds
      ex i being Nat st i in Seg k & p in Ball(c/.i,r.i))
  holds
    ex I being Subset of Seg k st
      (for i,j being Nat st i in I & j in I & i <> j holds
        Ball(c/.i,r.i) misses Ball(c/.j,r.j)) &
      (for p being Point of TOP-REAL 2 st p in E holds
        ex i being Nat st i in I & p in Ball(c/.i,3*r.i))
proof
end;
::$P+
