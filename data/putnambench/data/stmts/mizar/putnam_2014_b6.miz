:: Statement-only formalization of PutnamBench corpus artifact putnam_2014_b6
:: (putnambench__mizar__putnam_2014_b6): a Lipschitz real function on the unit
:: interval whose rational-point values have integer affine representations
:: is affine on each member of a finite interval cover. This file contains no
:: proof.

environ

  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0,
    XXREAL_1, XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1,
    VALUED_0, VALUED_1, ORDINAL1, ORDINAL2, SEQ_1, SEQ_2, SEQ_4,
    FDIFF_1, FDIFF_12, RCOMP_1, FCONT_1, SUPINF_2, MEASURE1,
    MEASURE5, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA1, INTEGRA5,
    INTEGRA7, RAT_1, FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, INT_1, COMPLEX1, XXREAL_0,
    XXREAL_1, XXREAL_2, XXREAL_3, NAT_1, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PARTFUN2, RCOMP_1,
    FCONT_1, FDIFF_1, SUPINF_2, MEASURE1, MEASURE5, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA1, INTEGRA5, INTEGRA7,
    EXTREAL1, FDIFF_12, RAT_1, FINSET_1;
  constructors ZFMISC_1, FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    COMPLEX1, INT_1, XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4,
    COMSEQ_2, PARTFUN2, RCOMP_1, RFUNCT_2, FCONT_1, FDIFF_1,
    FDIFF_12, MEASURE5, MEASURE6, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA2, INTEGRA5, INTEGRA7, EXTREAL1, BINOP_2,
    RAT_1, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, SEQ_4,
    RCOMP_1, FCONT_1, FDIFF_1, XXREAL_3, MEASURE1, MEASURE5,
    MEASUR12, INTEGRA1, RAT_1, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities INTEGRA5;
  expansions TARSKI, XBOOLE_0, RELAT_1, INTEGRA7;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    (ex K being Real st
      K > 0 &
      for x,y being Real st
        0 <= x & x <= 1 & 0 <= y & y <= 1
      holds |.f.x - f.y.| <= K * |.x - y.|) &
    (for r being Rational st 0 <= r & r <= 1 holds
      ex a,b being Integer st
        f.r = (a qua Real) + (b qua Real) * r)
  holds
    ex intervals being finite Subset of bool REAL st
      (for J being Subset of REAL st J in intervals holds
        J is closed_interval &
        ex m,c being Real st
          for x being Real st x in J holds
            f.x = c + m*x) &
      union intervals = ['0,1']
proof
end;
::$P+
