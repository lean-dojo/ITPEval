:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_b3
:: (putnambench__mizar__putnam_2010_b3): every distribution of 2010*n balls
:: among 2010 labeled boxes can be made uniform by moves taking exactly i
:: balls from box i precisely when the positive integer n is at least 1005.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3, CARD_3, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, RVSUM_1, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0,
    VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n > 0 holds
    ((for B being FinSequence of NAT st
          len B = 2010 & Sum B = 2010 * n
      holds
        ex P being Function of NAT,Funcs(Seg 2010,NAT),
           T being Nat st
          P.0 = B &
          (for t being Nat st t < T holds
            ex i,j being Nat,
               Pt,Pt1 being Function of Seg 2010,NAT st
              Pt = P.t & Pt1 = P.(t + 1) &
              i in Seg 2010 & j in Seg 2010 &
              i <> j &
              Pt.i >= i &
              Pt1.i = Pt.i -' i &
              Pt1.j = Pt.j + i &
              (for k being Nat st
                  k in Seg 2010 & k <> i & k <> j
                holds
                Pt1.k = Pt.k)) &
          ex PT being Function of Seg 2010,NAT st
            PT = P.T &
            for i being Nat st i in Seg 2010 holds PT.i = n)
      iff 1005 <= n)
proof
end;
::$P+
