:: Statement-only formalization of PutnamBench artifact putnam_1971_b1:
:: an idempotent binary operation satisfying the cyclic law
:: (x*y)*z = (y*z)*x is associative and commutative.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for S being set, op being Function of [:S,S:],S st
    (for x being Element of S holds op.(x,x) = x) &
    (for x,y,z being Element of S holds
      op.(op.(x,y),z) = op.(op.(y,z),x))
  holds
    (for x,y,z being Element of S holds
      op.(op.(x,y),z) = op.(x,op.(y,z))) &
    (for x,y being Element of S holds
      op.(x,y) = op.(y,x))
proof
end;
::$P+
