:: Statement-only formalization of PutnamBench artifact putnam_1998_a4:
:: the base-10 values of recursively concatenated digit sequences are
:: divisible by 11 exactly at positive indices congruent to 1 modulo 6.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, FUNCT_2, TARSKI, XREAL_0,
    ORDINAL4, BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, FINSEQOP,
    ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO,
    SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1, INT_2;
  notations TARSKI, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1, NUMBERS,
    VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, RELAT_1, FUNCT_1,
    PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1, FUNCOP_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, FINSOP_1, FINSEQOP, SETWOP_2,
    RVSUM_1, INT_1, INT_2, NAT_D;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, BINOP_2, VALUED_1,
    FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1, XXREAL_1,
    FINSEQ_2, RVSUM_1, FUNCT_2, NAT_D;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, FUNCT_2, FUNCOP_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2, FINSEQ_1, FINSEQ_2,
    VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1, INT_1, RVSUM_1,
    RELSET_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A being Function of NAT,NAT* st
    A.1 = <*0*> &
    A.2 = <*1*> &
    (for n being Nat st 0 < n holds
      len (A.(n + 2)) = len (A.(n + 1)) + len (A.n) &
      (for k being Nat st k in Seg len (A.(n + 1)) holds
        (A.(n + 2)).k = (A.(n + 1)).k) &
      (for k being Nat st k in Seg len (A.n) holds
        (A.(n + 2)).(len (A.(n + 1)) + k) = (A.n).k))
  holds
    {n where n is Element of NAT :
      1 <= n &
      ex values being FinSequence of NAT st
        len values = len (A.n) + 1 &
        values.1 = 0 &
        (for k being Nat st k in Seg len (A.n) holds
          ex d being Nat st
            d = (A.n).k &
            values.(k + 1) = 10 * values.k + d) &
        11 divides values.(len (A.n) + 1)}
    =
    {n where n is Element of NAT : n mod 6 = 1}
proof
end;
::$P+
