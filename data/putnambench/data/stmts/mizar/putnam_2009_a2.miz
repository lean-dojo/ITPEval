:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_a2:
:: the local explicit solution for the first component of a coupled system of
:: three real differential equations with unit initial values. This file
:: contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, VALUED_0, VALUED_1, ORDINAL1,
    RCOMP_1, FDIFF_1, SIN_COS, PREPOWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, VALUED_0, VALUED_1,
    RCOMP_1, FDIFF_1, SIN_COS, PREPOWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    RCOMP_1, RFUNCT_2, FDIFF_1, SIN_COS, PREPOWER, VALUED_1,
    BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, RCOMP_1, FDIFF_1,
    SIN_COS, PREPOWER;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities XCMPLX_0, VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for f,g,h being Function of REAL,REAL,
      a,b being Real st
    a < 0 & 0 < b &
    f is_differentiable_on ].a,b.[ &
    g is_differentiable_on ].a,b.[ &
    h is_differentiable_on ].a,b.[ &
    (for x being Real st x in ].a,b.[ holds
      diff(f,x) =
        2 * f.x * f.x * g.x * h.x + 1 / (g.x * h.x)) &
    f.0 = 1 &
    (for x being Real st x in ].a,b.[ holds
      diff(g,x) =
        f.x * g.x * g.x * h.x + 4 / (f.x * h.x)) &
    g.0 = 1 &
    (for x being Real st x in ].a,b.[ holds
      diff(h,x) =
        3 * f.x * g.x * h.x * h.x + 1 / (f.x * g.x)) &
    h.0 = 1
  holds
    ex c,d being Real st
      c < 0 & 0 < d &
      for x being Real st x in ].c,d.[ holds
        f.x =
          ((2 qua Real) #R (-((1 qua Real) / 12))) *
          ((sin.(6*x + PI/4) /
              (cos.(6*x + PI/4) * cos.(6*x + PI/4)))
            #R ((1 qua Real) / 6))
proof
end;
::$P+
