:: Statement-only formalization of PutnamBench artifact putnam_1981_a3:
:: the exponentially scaled double integral of (exp(x)-exp(y))/(x-y) over
:: [0,t] has no finite real limit as t tends to positive infinity. This file
:: contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
      ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
      SIN_COS;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0,
      VALUED_1, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      NAT_1, SIN_COS, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12,
      INTEGRA5, EXTREAL1, BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, XXREAL_3,
      MEASURE1, MEASUR12, SIN_COS;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for F being Function of REAL,REAL st
    (for t being Real holds
      ex I being Subset of REAL,
         g being Function of REAL,REAL st
        I = {x where x is Real : 0 <= x & x < t} &
        (for y being Real holds
          ex h being Function of REAL,REAL st
            (for x being Real st x in I holds
              h.x = (exp_R.x - exp_R.y) / (x - y)) &
            g.y = Integral(L-Meas,h|I)) &
        F.t = exp_R.(-t) * Integral(L-Meas,g|I))
  holds
    not ex L being Real st
      for e being Real st 0 < e holds
        ex B being Real st
          for t being Real st B <= t holds
            |.F.t-L.| < e
proof
end;
::$P+
