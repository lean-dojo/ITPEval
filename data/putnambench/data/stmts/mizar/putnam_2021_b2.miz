:: Statement-only formalization of PutnamBench corpus artifact putnam_2021_b2
:: (putnambench__mizar__putnam_2021_b2): the maximum weighted infinite sum
:: of prefix geometric means over nonnegative real sequences of sum one is
:: 2/3. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN,
    ORDINAL1, SERIES_1, RVSUM_1, FINSEQ_1, FINSEQ_2, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
    PREPOWER, ABIAN, XXREAL_2, POWER, RVSUM_1, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, NAT_D, FINSEQ_2,
    SEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, BINOP_2, COMSEQ_2,
    POWER, RVSUM_1, FINSEQOP, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN, FINSEQ_1, FINSEQ_2, RVSUM_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  (for S being Real, a,terms being Real_Sequence st
    (for k being Nat holds a.k >= 0) &
    Partial_Sums(a) is convergent &
    lim Partial_Sums(a) = 1 &
    (for n being Nat holds
      ex factors being FinSequence of REAL st
        len factors = n + 1 &
        (for k being Nat st k in Seg(n + 1) holds
          factors.k = a.(k -' 1)) &
        terms.n =
          ((n + 1) qua Real) / ((2 qua Real) |^ (n + 1)) *
          (Product factors) to_power
            ((1 qua Real) / ((n + 1) qua Real))) &
    Partial_Sums(terms) is convergent &
    lim Partial_Sums(terms) = S
  holds
    S <= (2 qua Real) / 3) &
  (ex a,terms being Real_Sequence st
    (for k being Nat holds a.k >= 0) &
    Partial_Sums(a) is convergent &
    lim Partial_Sums(a) = 1 &
    (for n being Nat holds
      ex factors being FinSequence of REAL st
        len factors = n + 1 &
        (for k being Nat st k in Seg(n + 1) holds
          factors.k = a.(k -' 1)) &
        terms.n =
          ((n + 1) qua Real) / ((2 qua Real) |^ (n + 1)) *
          (Product factors) to_power
            ((1 qua Real) / ((n + 1) qua Real))) &
    Partial_Sums(terms) is convergent &
    lim Partial_Sums(terms) = (2 qua Real) / 3)
proof
end;
::$P+
