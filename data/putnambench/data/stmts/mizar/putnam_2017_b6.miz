:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_b6
:: (putnambench__mizar__putnam_2017_b6): the number of ordered 64-tuples of
:: distinct integers from 1 through 2017 whose specified weighted sum is
:: divisible by 2017. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, RELAT_1, FUNCT_1, FINSEQ_1, FINSEQ_2,
      CARD_1, XBOOLE_0, SUBSET_1, TARSKI, XCMPLX_0, XREAL_0, XXREAL_0,
      ORDINAL1, INT_1, INT_2, NEWTON, FINSET_1, ARYTM_1, ARYTM_3, CARD_3,
      VALUED_0, VALUED_1, RVSUM_1, ZFMISC_1, REALSET1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, INT_1, INT_2, NAT_1, NAT_D, NEWTON, VALUED_0,
      FINSEQ_1, FINSEQ_2, RVSUM_1, FINSET_1;
 constructors REAL_1, NAT_D, INT_2, NEWTON, RVSUM_1, FINSEQOP, FINSEQ_4,
      FINSET_1, CARD_1;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, CARD_1,
      XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1, INT_1, INT_2, VALUED_0,
      VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, RELSET_1,
      MEMBERED, FRAENKEL, FINSET_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2;
 expansions TARSKI;

begin

::$P-
theorem
  card {x where x is FinSequence of NAT :
    len x = 64 &
    (for i being Nat st i in Seg 64 holds 1 <= x.i & x.i <= 2017) &
    (for i,j being Nat st
      i in Seg 64 & j in Seg 64 & x.i = x.j holds i = j) &
    ex terms being FinSequence of NAT st
      len terms = 64 &
      (for i being Nat st i in Seg 64 holds
        (i <= 2 implies terms.i = x.i) &
        (2 < i implies terms.i = (i -' 1) * x.i)) &
      ex q being Nat st Sum terms = 2017 * q}
  = ((2016 !) div (1953 !)) -' ((63 !) * 2016)
proof
end;
::$P+
