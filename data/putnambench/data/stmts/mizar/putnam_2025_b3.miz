:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_b3
:: (putnambench__mizar__putnam_2025_b3): every nonempty set of positive
:: integers closed under positive divisors of 2025^n - 15^n contains all
:: positive integers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, NUMBERS, NAT_1, INT_1,
    INT_2, RELAT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1,
    NEWTON, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NEWTON, NAT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D, INT_1, INT_2, NEWTON, NUMBERS;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, NAT_1, INT_1, NEWTON, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being Subset of NAT st
    S <> {} &
    (for n being Nat st n in S holds 0 < n) &
    (for n, d being Nat st
      n in S &
      0 < d &
      d divides (((2025 qua Nat) |^ n) -' ((15 qua Nat) |^ n))
    holds d in S)
  holds for n being Nat holds (n in S iff 0 < n)
proof
end;
::$P+
