:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_a1:
:: a real-valued function on pairs with zero cyclic sum is the difference of
:: values of a unary real function. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
      FUNCT_1, FUNCT_2, BINOP_1, BINOP_2, NUMBERS, XREAL_0, COMPLEX1,
      CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1,
      NAT_1, VALUED_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      RELSET_1, FUNCT_2, BINOP_1, BINOP_2, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0;
 constructors FUNCT_1, RELSET_1, FUNCT_2, BINOP_1, BINOP_2, XCMPLX_0,
      REAL_1, SQUARE_1, COMPLEX1, INT_1, XXREAL_0, ZFMISC_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
      XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of [:REAL,REAL:],REAL st
    (for x,y,z being Real holds
      addreal.(addreal.(f.(x,y),f.(y,z)),f.(z,x)) = 0)
  holds
    ex g being Function of REAL,REAL st
      for x,y being Real holds f.(x,y) = diffreal.(g.x,g.y)
proof
end;
::$P+
