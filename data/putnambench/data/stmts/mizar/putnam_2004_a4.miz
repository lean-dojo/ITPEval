:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_a4:
:: every coordinate product in positive dimension is identically a finite
:: rational linear combination of nth powers of linear forms whose
:: coefficients belong to {-1,0,1}. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4, BINOP_1,
    BINOP_2, FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, RAT_1, NEWTON, PREPOWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, PARTFUN1,
    BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP, SETWOP_2,
    RVSUM_1, RAT_1, NEWTON, PREPOWER;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NAT_1, BINOP_1, SETWISEO,
    BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2,
    XXREAL_1, FINSEQ_2, RVSUM_1, ZFMISC_1, RAT_1, NEWTON, PREPOWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1, RAT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    ex N being Nat,
       c being FinSequence of RAT,
       a being Function of [:Seg N,Seg n:],REAL st
      len c = N &
      (for i,j being Nat st i in Seg N & j in Seg n holds
        a.[i,j] = -1 or a.[i,j] = 0 or a.[i,j] = 1) &
      (for x being FinSequence of REAL st len x = n holds
        ex linearForms,summands being FinSequence of REAL st
          len linearForms = N &
          len summands = N &
          (for i being Nat st i in Seg N holds
            ex row being FinSequence of REAL st
              len row = n &
              (for j being Nat st j in Seg n holds
                row.j = a.[i,j] * x.j) &
              linearForms.i = Sum row) &
          (for i being Nat st i in Seg N holds
            summands.i =
              (c.i qua Real) * (linearForms.i |^ n)) &
          Product x = Sum summands)
proof
end;
::$P+
