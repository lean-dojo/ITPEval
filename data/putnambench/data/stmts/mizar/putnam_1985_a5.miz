:: Statement-only formalization of PutnamBench corpus artifact putnam_1985_a5:
:: the values from 1 through 10 for which the integral of the product
:: cos(x) cos(2x) ... cos(mx) over [0,2*PI] is nonzero. This file contains
:: no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
      ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
      FINSEQ_1, FINSEQ_2, FINSEQ_4, CARD_3, ORDINAL4, BINOP_1, BINOP_2,
      FUNCOP_1, FINSEQOP, ZFMISC_1, XCMPLX_0, SETWISEO, SETWOP_2,
      FINSOP_1, RVSUM_1, INT_1, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1,
      MESFUNC5, MEASUR12, INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
      NUMBERS, VALUED_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
      FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, INT_1,
      FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, SIN_COS, XXREAL_1,
      XXREAL_3, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1;
 constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, BINOP_2, VALUED_1,
      FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1, XXREAL_1,
      REAL_1, FINSEQ_2, RVSUM_1, SIN_COS, FUNCT_2, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
      FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2,
      FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1,
      RVSUM_1, SIN_COS, RELSET_1, MEMBERED, XXREAL_3, MEASURE1,
      MEASUR12;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for m being Nat st 1 <= m & m <= 10 holds
    ex f being Function of REAL,REAL st
      (for x being Real holds
        ex factors being FinSequence of REAL st
          len factors = m &
          (for k being Nat st k in Seg m holds
            factors.k = cos.((k qua Real) * x)) &
          f.x = Product factors) &
      (Integral(L-Meas,f|[.0,2*PI.]) <> 0 iff
        m = 3 or m = 4 or m = 7 or m = 8)
proof
end;
::$P+
