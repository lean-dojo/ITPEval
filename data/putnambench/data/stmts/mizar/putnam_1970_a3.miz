:: Statement-only formalization of PutnamBench artifact putnam_1970_a3:
:: the longest nonzero repeated trailing decimal digit run among perfect
:: squares has length three and is first attained by 1444.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, REALSET1, INT_1, NAT_1, VALUED_0, VALUED_1,
    NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, VALUED_0, NAT_1, NEWTON,
    NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NAT_1, NEWTON, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for L being Function of NAT,NAT st
    (for n being Nat holds
      (n = 0 implies L.n = 0) &
      (0 < n implies
        (for k being Nat st k < L.n holds
          (n div ((10 qua Nat) |^ k)) mod 10 = n mod 10) &
        (n div ((10 qua Nat) |^ L.n) = 0 or
          (n div ((10 qua Nat) |^ L.n)) mod 10 <> n mod 10)))
  holds
    (ex n being Nat st
      (n |^ 2) mod 10 <> 0 & L.(n |^ 2) = 3) &
    (for n being Nat st (n |^ 2) mod 10 <> 0 holds
      L.(n |^ 2) <= 3) &
    (ex m being Nat st m |^ 2 = 1444) &
    L.1444 = 3 &
    1444 mod 10 <> 0 &
    (for n being Nat st
      (n |^ 2) mod 10 <> 0 & L.(n |^ 2) = 3
    holds
      1444 <= n |^ 2)
proof
end;
::$P+
