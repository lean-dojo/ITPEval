:: Statement-only formalization of PutnamBench corpus artifact putnam_1978_a6:
:: a nonempty finite set of n points in the real plane determines fewer than
:: 2*n^(3/2) unordered pairs of points at distance one. This file contains no
:: proof.

environ

 vocabularies NUMBERS, SUBSET_1, REAL_1, RELAT_1, TARSKI, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, XBOOLE_0, RLTOPSP1, PRE_TOPC, EUCLID, METRIC_1,
      STRUCT_0, FINSET_1, ZFMISC_1, SETFAM_1, POWER;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, SETFAM_1, XCMPLX_0,
      NUMBERS, XREAL_0, XXREAL_0, REAL_1, ORDINAL1, CARD_1, FINSET_1,
      METRIC_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, TOPREAL6,
      POWER;
 constructors SETFAM_1, REAL_1, RLTOPSP1, EUCLID, TOPREAL6, FINSET_1,
      RELSET_1, POWER;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XXREAL_0, XREAL_0, STRUCT_0,
      EUCLID, ORDINAL1, FINSET_1, NUMBERS, MEMBERED, FRAENKEL;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for S being non empty finite Subset of TOP-REAL 2,
      unitPairs being finite Subset-Family of S st
    unitPairs = {U where U is Subset of S :
      ex p,q being Point of TOP-REAL 2 st
        p in S & q in S & U = {p,q} & dist(p,q) = 1}
  holds
    (card unitPairs qua Real)
      < 2 * ((card S qua Real) to_power ((3 qua Real) / 2))
proof
end;
::$P+
