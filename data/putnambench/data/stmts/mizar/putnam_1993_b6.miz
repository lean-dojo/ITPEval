:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_b6:
:: the three positive entries at indices below 3 in a natural-number state can
:: be transformed until one is zero by the prescribed doubling-and-subtraction
:: rule. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, CARD_1, FINSEQ_1, ZFMISC_1, XTUPLE_0,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, ARYTM_1, ARYTM_3, MULTOP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, RELAT_1,
    FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS, NAT_1, FINSEQ_1, XCMPLX_0,
    XREAL_0, XXREAL_0, REAL_1, NAT_D, MULTOP_1;
  constructors ZFMISC_1, XTUPLE_0, RELSET_1, FUNCT_2, NAT_1, FINSEQ_1,
    XREAL_0, REAL_1, NAT_D, MULTOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    FINSEQ_1, ZFMISC_1, XTUPLE_0;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being Function of NAT,NAT,
      f being Function of
        [:NAT,NAT,Funcs(NAT,NAT):],Funcs(NAT,NAT) st
    (for i being Nat st i < 3 holds 0 < S.i) &
    (for i,j,k being Nat,
         Sprime,T being Function of NAT,NAT st
       i < 3 & j < 3 & k < 3 &
       i <> j & i <> k & j <> k &
       T = f.(i,j,Sprime)
     holds
       (Sprime.i <= Sprime.j implies
         T.i = 2 * Sprime.i &
         T.j = Sprime.j -' Sprime.i &
         T.k = Sprime.k) &
       (not Sprime.i <= Sprime.j implies T = Sprime))
  holds
    ex N being Nat,
       Ss being Function of NAT,Funcs(NAT,NAT) st
      Ss.0 = S &
      (ex i being Nat,
          SN being Function of NAT,NAT st
        i < 3 & SN = Ss.N & SN.i = 0) &
      (for n being Nat st n < N holds
        ex i,j being Nat,
           Sn,Sn1 being Function of NAT,NAT st
          i < 3 & j < 3 & i <> j &
          Sn = Ss.n & Sn1 = Ss.(n + 1) &
          f.(i,j,Sn) = Sn1)
proof
end;
::$P+
