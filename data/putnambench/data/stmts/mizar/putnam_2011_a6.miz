:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_a6
:: (putnambench__mizar__putnam_2011_a6): exponential-rate convergence to the
:: uniform distribution for a generating die on a finite abelian group.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      FUNCT_2, BINOP_1, BINOP_2, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
      CARD_1, CARD_3, XXREAL_0, ARYTM_1, ARYTM_3, NAT_1, ORDINAL1,
      FINSET_1, FINSEQ_1, FINSEQ_2, STRUCT_0, ALGSTR_0, GROUP_1,
      GROUP_2, GROUP_3, GROUP_4, VALUED_0, VALUED_1, NEWTON, PREPOWER,
      SEQ_1, SEQ_2, SEQ_4, RVSUM_1, SETWISEO, FINSOP_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
      FUNCT_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, XXREAL_0, NAT_1, FINSET_1, FINSEQ_1, FINSEQ_2, STRUCT_0,
      ALGSTR_0, GROUP_1, GROUP_2, GROUP_3, GROUP_4, VALUED_0, VALUED_1,
      NEWTON, PREPOWER, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
      RVSUM_1, BINOP_1, BINOP_2, SETWISEO, FINSOP_1;
 constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, CARD_1, FINSET_1,
      FINSEQ_1, FINSEQ_2, STRUCT_0, GROUP_1, GROUP_2, GROUP_3, GROUP_4,
      REAL_1, NAT_1, NEWTON, PREPOWER, SEQ_1, SEQ_2, SEQM_3, SEQ_4,
      COMSEQ_2, RVSUM_1, BINOP_1, BINOP_2, SETWISEO, FINSOP_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
      FINSET_1, FINSEQ_1, FINSEQ_2, STRUCT_0, GROUP_1, GROUP_2, GROUP_3,
      VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_4, RVSUM_1, BINOP_2;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, FUNCT_1, FINSEQ_1, STRUCT_0;
 equalities ALGSTR_0, ORDINAL1;
 expansions TARSKI, STRUCT_0;

begin

::$P-
theorem
  for G being finite Group,
      A being Subset of G,
      n,k being Nat,
      p being Function of [:NAT,the carrier of G:],REAL st
    (for a,b being Element of G holds a * b = b * a) &
    n = card G &
    card A = k &
    k < n &
    1_G in A &
    (for x being Element of G holds
      ex w being FinSequence of the carrier of G st
        rng w c= A & Product w = x) &
    (for m being Nat, x being Element of G holds
      ex q being Nat st
        q = card {w where w is FinSequence of the carrier of G :
          len w = m & rng w c= A & Product w = x} &
        p.(m,x) = (q qua Real) / ((k qua Real) |^ m))
  holds
    ex b,C being Real,
       elements being FinSequence of the carrier of G,
       s being Real_Sequence st
      0 < b & b < 1 & 0 < C &
      rng elements = the carrier of G &
      (for i,j being Nat st
        i in dom elements & j in dom elements & elements.i = elements.j
        holds i = j) &
      (for m being Nat holds
        ex terms being FinSequence of REAL st
          len terms = len elements &
          (for i being Nat st i in dom elements holds
            ex x being Element of G st
              x = elements.i &
              terms.i = (p.(m,x) - 1 / (n qua Real)) |^ 2) &
          s.m = (1 / (b |^ (2*m))) * Sum terms) &
      for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m being Nat st N <= m holds
            C - epsilon < s.m & s.m < C + epsilon
proof
end;
::$P+
