:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_b3
:: (putnambench__mizar__putnam_2011_b3): if a real function g has a nonzero
:: value at zero and is continuous there, and both the pointwise product f*g
:: and quotient f/g are differentiable at zero, then f is differentiable there.
:: This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, RFUNCT_1, FCONT_1, FDIFF_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_1, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1,
    XXREAL_2, COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    FCONT_1, ORDINAL1, RFUNCT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f,g being Function of REAL,REAL st
    g.0 <> 0 &
    g is_continuous_in 0 &
    f(#)g is_differentiable_in 0 &
    f/g is_differentiable_in 0
  holds
    f is_differentiable_in 0
proof
end;
::$P+
