:: Statement-only formalization of PutnamBench artifact putnam_1964_a3:
:: an injective sequence dense in (0,1), with left and right gaps determined
:: by earlier terms, has the stated cubic-gap series sum. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL1, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, XXREAL_0, NAT_1, SEQ_2, COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  theorems SERIES_1;

begin

::$P-
theorem
  for x,a,b being Real_Sequence st
    (for n being Nat holds 0 < x.n & x.n < 1) &
    x is one-to-one &
    (for y being Real st 0 < y & y < 1 holds
      for epsilon being Real st 0 < epsilon holds
        ex n being Nat st |.x.n-y.| < epsilon) &
    (for n being Nat holds
      ex l being Real st
        a.n = x.n-l &
        (l = 0 or
          (l < x.n & ex i being Nat st i < n & l = x.i)) &
        (for p being Real st
          (p = 0 or
            (p < x.n & ex i being Nat st i < n & p = x.i))
        holds p <= l)) &
    (for n being Nat holds
      ex u being Real st
        b.n = u-x.n &
        (u = 1 or
          (x.n < u & ex i being Nat st i < n & u = x.i)) &
        (for p being Real st
          (p = 1 or
            (x.n < p & ex i being Nat st i < n & p = x.i))
        holds u <= p))
  holds
    ex s being Real_Sequence st
      (for n being Nat holds s.n = a.n * b.n * (a.n + b.n)) &
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            |.Partial_Sums(s).n - 1 / 3.| < epsilon)
proof
end;
::$P+
