:: Statement-only formalization of PutnamBench artifact putnam_1987_a5:
:: nonexistence of a continuously partially differentiable curl-free real
:: vector field on punctured three-space with the prescribed planar values.
:: This file contains no proof.

environ

  vocabularies FUNCT_1, FUNCT_2, ARYTM_3, ARYTM_1, FINSEQ_1, FINSEQ_2,
    RELAT_1, COMPLEX1, SQUARE_1, RCOMP_1, XBOOLE_0, ZFMISC_1, PARTFUN1,
    XXREAL_1, ORDINAL4, FCONT_1, FDIFF_1, PDIFF_1, AFINSQ_1, NUMBERS,
    REAL_1, SUBSET_1, CARD_1, TARSKI, XXREAL_0, CARD_3, NAT_1, VALUED_1,
    SEQFUNC, PDIFF_9, XCMPLX_0, SIN_COS, SERIES_1, NFCONT_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, ORDINAL1,
    RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    REAL_1, SQUARE_1, BINOP_1, FINSEQ_1, VALUED_1, FINSEQ_2, RCOMP_1,
    FDIFF_1, SEQFUNC, SIN_COS, FINSEQ_7, EUCLID, TAYLOR_1, PDIFF_1,
    PDIFF_7, PDIFF_9, NFCONT_1, NFCONT_4, MESFUN9C;
  constructors REAL_1, SQUARE_1, BINOP_1, FINSEQ_7, FINSEQ_4, SIN_COS,
    FDIFF_1, PDIFF_1, MONOID_0, INTEGR15, RELSET_1, NFCONT_1, PDIFF_7,
    TAYLOR_1, SEQFUNC, PDIFF_9, NFCONT_4, MESFUNC5, MESFUN9C;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS,
    XXREAL_0, XREAL_0, NAT_1, MEMBERED, VALUED_0, FINSEQ_1, EUCLID,
    VALUED_1, SQUARE_1, RCOMP_1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TARSKI;
  equalities EUCLID, BINOP_1, PDIFF_1, SIN_COS, PDIFF_9, SUBSET_1;
  expansions TARSKI, PDIFF_1, PDIFF_9, TAYLOR_1;

begin

::$P-
theorem
  for D being Subset of REAL 3 st
    D = [#](REAL 3) \ {<*0,0,0*>}
  holds
    not ex M,N,P being Function of REAL 3,REAL st
      (for i being Nat st i in Seg 3 holds
        M is_partial_differentiable_on D,i &
        N is_partial_differentiable_on D,i &
        P is_partial_differentiable_on D,i &
        for u being Element of REAL 3 st u <> <*0,0,0*> holds
          (M`partial|(D,i)) is_continuous_in u &
          (N`partial|(D,i)) is_continuous_in u &
          (P`partial|(D,i)) is_continuous_in u) &
      (for u being Element of REAL 3 st u <> <*0,0,0*> holds
        partdiff(P,u,2) - partdiff(N,u,3) = 0 &
        partdiff(M,u,3) - partdiff(P,u,1) = 0 &
        partdiff(N,u,1) - partdiff(M,u,2) = 0) &
      (for x,y being Real holds
        M.<*x,y,0*> = -y/(x^2 + 4*y^2) &
        N.<*x,y,0*> = x/(x^2 + 4*y^2) &
        P.<*x,y,0*> = 0)
proof
end;
::$P+
