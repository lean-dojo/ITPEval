:: Statement-only formalization of PutnamBench artifact putnam_1977_a2:
:: the nonzero real solutions of a+b+c=d and
:: 1/a+1/b+1/c=1/d are exactly the three pair-cancellation cases.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b,c,d being Real st
    a <> 0 & b <> 0 & c <> 0 & d <> 0
  holds
    (a + b + c = d &
      1 / a + 1 / b + 1 / c = 1 / d)
    iff
      (d = a & b = -c) or
      (d = b & a = -c) or
      (d = c & a = -b)
proof
end;
::$P+
