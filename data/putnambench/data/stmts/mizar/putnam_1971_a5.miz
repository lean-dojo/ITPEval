:: Statement-only formalization of PutnamBench artifact putnam_1971_a5:
:: the positive integer score values with exactly 35 unattainable
:: nonnegative totals, including 58, are 11 and 8.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, INT_1, RELAT_1, ARYTM_3, CARD_1,
    XXREAL_0, SUBSET_1, ARYTM_1, INT_2, COMPLEX1, ZFMISC_1, XBOOLE_0,
    FINSET_1, ORDINAL1, TARSKI;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    FINSET_1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, INT_1, NAT_1,
    INT_2;
  constructors XXREAL_0, NAT_1, INT_2, REAL_1, FINSET_1, CARD_1;
  registrations XXREAL_0, XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, ARITHM;

begin

::$P-
theorem
  for a,b being Integer st
    0 < a & 0 < b & a > b
  holds
    ((card {s where s is Element of NAT :
        not ex m,n being Nat st
          (m qua Integer) * a + (n qua Integer) * b =
            (s qua Integer)} = 35 &
      not ex m,n being Nat st
        (m qua Integer) * a + (n qua Integer) * b = 58)
    iff a = 11 & b = 8)
proof
end;
::$P+
