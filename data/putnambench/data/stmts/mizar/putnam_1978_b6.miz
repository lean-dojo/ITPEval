:: Statement-only formalization of PutnamBench corpus artifact putnam_1978_b6:
:: the square of a weighted triangular finite sum of real numbers in [0,1]
:: is bounded by twice m times the corresponding unweighted sum. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    RVSUM_1, FINSEQ_1, FINSEQ_2, ORDINAL4, BINOP_1, BINOP_2, FUNCOP_1,
    FINSEQOP, ZFMISC_1, CARD_3, SETWISEO, SETWOP_2, FINSOP_1, FUNCT_7;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, PARTFUN1,
    BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4,
    VALUED_0, VALUED_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NAT_1, BINOP_1, SETWISEO,
    BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2,
    XXREAL_1, FINSEQ_2, RVSUM_1, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of [:NAT,NAT:],REAL,
      m,n being Nat st
    (for i,j being Nat holds
      0 <= a.(i,j) & a.(i,j) <= 1) &
    0 < m & 0 < n
  holds
    ex weighted,unweighted being FinSequence of REAL st
      len weighted = n &
      len unweighted = n &
      (for i being Nat st i in Seg n holds
        ex weightedRow,unweightedRow being FinSequence of REAL st
          len weightedRow = m * i &
          len unweightedRow = m * i &
          (for j being Nat st j in Seg (m * i) holds
            weightedRow.j = a.(i,j) / (i qua Real) &
            unweightedRow.j = a.(i,j)) &
          weighted.i = Sum weightedRow &
          unweighted.i = Sum unweightedRow) &
      (Sum weighted)^2 <=
        2 * (m qua Real) * Sum unweighted
proof
end;
::$P+
