:: Statement-only formalization of PutnamBench artifact putnam_1973_a6:
:: seven distinct real affine lines cannot have at least six points incident
:: with exactly three lines and at least four points incident with exactly two
:: lines. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1,
    NAT_1, FINSEQ_1, FINSET_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1,
    EUCLID, MCART_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    XXREAL_0, NAT_1, FINSEQ_1, FINSET_1, STRUCT_0, PRE_TOPC, RLVECT_1,
    RLTOPSP1, EUCLID, MCART_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, FINSEQ_1, FINSET_1,
    RLVECT_1, RLTOPSP1, EUCLID;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XREAL_0, CARD_1, NAT_1, FINSEQ_1,
    FINSET_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID,
    MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities STRUCT_0;
  expansions TARSKI, XBOOLE_0, FUNCT_1;

begin

::$P-
theorem
  not ex slopes,intercepts being Function of Seg 7,REAL st
    (for i,j being Element of Seg 7 st i <> j holds
      slopes.i <> slopes.j or intercepts.i <> intercepts.j) &
    6 c= card {p where p is Point of TOP-REAL 2 :
      card {i where i is Element of Seg 7 :
        p`2 = slopes.i * p`1 + intercepts.i} = 3} &
    4 c= card {p where p is Point of TOP-REAL 2 :
      card {i where i is Element of Seg 7 :
        p`2 = slopes.i * p`1 + intercepts.i} = 2}
proof
end;
::$P+
