:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_a5
:: (putnambench__mizar__putnam_2011_a5): a twice continuously differentiable
:: real function on the plane with diagonal zeros, a positive decaying
:: weight, and gradient parallel to the weighted coordinate direction has
:: the stated inverse-linear finite-point bound. This file contains no proof.

environ

  vocabularies FUNCT_1, FUNCT_2, ARYTM_3, ARYTM_1, FINSEQ_1, FINSEQ_2,
    RELAT_1, COMPLEX1, SQUARE_1, RCOMP_1, XBOOLE_0, ZFMISC_1, PARTFUN1,
    XXREAL_1, ORDINAL4, FCONT_1, FDIFF_1, PDIFF_1, AFINSQ_1, NUMBERS,
    REAL_1, SUBSET_1, CARD_1, TARSKI, XXREAL_0, CARD_3, NAT_1, VALUED_1,
    SEQFUNC, PDIFF_9, XCMPLX_0, SIN_COS, SERIES_1, NFCONT_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, ORDINAL1,
    RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    REAL_1, COMPLEX1, SQUARE_1, BINOP_1, FINSEQ_1, VALUED_1, FINSEQ_2,
    RCOMP_1, FDIFF_1, SEQFUNC, SIN_COS, FINSEQ_7, EUCLID,
    TAYLOR_1, PDIFF_1, PDIFF_7, PDIFF_9, NFCONT_1, NFCONT_4, MESFUN9C;
  constructors REAL_1, SQUARE_1, BINOP_1, FINSEQ_7, FINSEQ_4, SIN_COS,
    FDIFF_1, PDIFF_1, MONOID_0, INTEGR15, RELSET_1, NFCONT_1, PDIFF_7,
    TAYLOR_1, SEQFUNC, PDIFF_9, NFCONT_4, MESFUNC5, MESFUN9C, COMPLEX1;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS,
    XXREAL_0, XREAL_0, NAT_1, MEMBERED, VALUED_0, FINSEQ_1, EUCLID,
    VALUED_1, SQUARE_1, RCOMP_1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TARSKI;
  equalities EUCLID, BINOP_1, PDIFF_1, SIN_COS, PDIFF_9, SUBSET_1;
  expansions TARSKI, PDIFF_1, PDIFF_9, TAYLOR_1;

begin

::$P-
theorem
  for F being Function of REAL 2,REAL,
      g being Function of REAL,REAL st
    (for i,j being Nat st i in Seg 2 & j in Seg 2 holds
      F is_partial_differentiable_on [#](REAL 2),i &
      (F`partial|([#](REAL 2),i))
        is_partial_differentiable_on [#](REAL 2),j &
      ex d2 being PartFunc of REAL 2,REAL st
        d2 = ((F`partial|([#](REAL 2),i))
          `partial|([#](REAL 2),j)) &
        for y being Element of REAL 2 holds d2 is_continuous_in y) &
    (ex dg,d2g being Function of REAL,REAL st
      (for t being Real holds
        g is_differentiable_in t & dg.t = diff(g,t) &
        dg is_differentiable_in t & d2g.t = diff(dg,t)) &
      (for t,r being Real st 0 < r holds
        ex s being Real st 0 < s &
          for x being Real st |.x-t.| < s holds
            |.d2g.x-d2g.t.| < r)) &
    (for uv being Element of REAL 2 st uv.1 = uv.2 holds F.uv = 0) &
    (for x being Real holds 0 < g.x & x^2 * g.x <= 1) &
    (for uv being Element of REAL 2 holds
      ex c being Real st
        partdiff(F,uv,1) = c * g.(uv.1) &
        partdiff(F,uv,2) = c * (-g.(uv.2)))
  holds
    ex C being Real st
      for n being Nat st 2 <= n holds
        for x being FinSequence of REAL st len x = n + 1 holds
          ex i,j being Nat st
            i in Seg (n + 1) & j in Seg (n + 1) & i <> j &
            |.F.<*x.i,x.j*>.| <= C / (n qua Real)
proof
end;
::$P+
