:: Statement-only formalization of PutnamBench corpus artifact putnam_1982_b4:
:: two claims about nonempty finite sets of distinct integers whose product
:: divides every integer-shifted product. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, INT_2, INT_6, ARYTM_1, ARYTM_3, CARD_3,
    VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    INT_2, INT_6;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED, INT_6;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ((for n being FinSequence of INT st
      len n > 0 &
      n is one-to-one &
      (for k being Integer holds
        ex shifted being FinSequence of INT st
          len shifted = len n &
          (for i being Nat st i in dom n holds
            shifted.i = n.i + k) &
          Product n divides Product shifted)
    holds
      ex i being Nat st
        i in dom n & (n.i = 1 or n.i = -1)) &
   (for n being FinSequence of INT st
      len n > 0 &
      n is one-to-one &
      (for k being Integer holds
        ex shifted being FinSequence of INT st
          len shifted = len n &
          (for i being Nat st i in dom n holds
            shifted.i = n.i + k) &
          Product n divides Product shifted) &
      (for i being Nat st i in dom n holds 0 < n.i)
    holds
      rng n = Seg len n))
proof
end;
::$P+
