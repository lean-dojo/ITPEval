:: Statement-only formalization of PutnamBench corpus artifact putnam_1989_a2:
:: the iterated integral over [0,a] by [0,b] of the exponential of the
:: maximum of b^2*x^2 and a^2*y^2, for positive real a and b, has the
:: stated closed-form value. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    NEWTON, PREPOWER, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
    INTEGRA5, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON, PREPOWER,
    VALUED_0, VALUED_1, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NEWTON, PREPOWER, SIN_COS, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for a,b being Real st 0 < a & 0 < b holds
    ex I,J being Subset of REAL,
       outer being Function of REAL,REAL st
      I = {x where x is Real : 0 <= x & x <= a} &
      J = {y where y is Real : 0 <= y & y <= b} &
      (for x being Real st x in I holds
        ex inner being Function of REAL,REAL st
          (for y being Real st y in J holds
            inner.y =
              exp_R.(max((b*x) |^ 2,(a*y) |^ 2))) &
          outer.x = Integral(L-Meas,inner|J)) &
      Integral(L-Meas,outer|I) =
        (exp_R.((a*b) |^ 2) - 1) / (a*b)
proof
end;
::$P+
