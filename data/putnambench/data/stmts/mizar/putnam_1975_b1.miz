:: Statement-only formalization of PutnamBench corpus artifact putnam_1975_b1:
:: the integer lattice generated by (3,8), (4,-1), and (5,4) has generators
:: (1,b) and (0,7) for some integer b, with 7 positive. This file contains
:: no proof.

environ
  vocabularies NUMBERS, NAT_1, INT_1, RELAT_1, ARYTM_3, CARD_1,
    XXREAL_0, SUBSET_1, ARYTM_1, INT_2, COMPLEX1, ZFMISC_1, XBOOLE_0,
    FINSET_1, ORDINAL1, TARSKI;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    FINSET_1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, INT_1, NAT_1,
    INT_2;
  constructors XXREAL_0, NAT_1, INT_2, REAL_1, FINSET_1, CARD_1;
  registrations XXREAL_0, XREAL_0, NAT_1, INT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, ARITHM;

begin

::$P-
theorem
  for H being Subset of [:INT,INT:] st
    H = {[x,y] where x,y is Integer :
      ex u,v,w being Integer st
        x = u*3 + v*4 + w*5 &
        y = u*8 - v + w*4}
  holds
    ex b being Integer st
      H = {[x,y] where x,y is Integer :
        ex u,v being Integer st
          x = u & y = u*b + v*7} &
      7 > 0
proof
end;
::$P+
