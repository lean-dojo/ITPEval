:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_b1:
:: the recursively defined real sequence x_0 = 1,
:: x_(n+1) = ln(exp(x_n) - x_n), has a convergent infinite series with sum
:: exp(1) - 1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN,
    ORDINAL1, SERIES_1, SIN_COS, RVSUM_1, FINSEQ_1, TAYLOR_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_1, FINSEQ_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN,
    XXREAL_2, POWER, RVSUM_1, SERIES_1, SIN_COS, TAYLOR_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4,
    PREPOWER, ABIAN, BINOP_2, COMSEQ_2, POWER, RVSUM_1, SERIES_1,
    SIN_COS, TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN, FINSEQ_1, RVSUM_1, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Real_Sequence st
    x.0 = 1 &
    (for n being Nat holds
      x.(n + 1) = ln.(exp_R.(x.n) - x.n))
  holds
    Partial_Sums(x) is convergent &
    lim Partial_Sums(x) = exp_R.1 - 1
proof
end;
::$P+
