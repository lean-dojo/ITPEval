:: Statement-only formalization of PutnamBench artifact putnam_1970_a2:
:: a real quadratic form with negative discriminant, perturbed by the stated
:: cubic terms, has no nonzero zero in some sufficiently small disk. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, XXREAL_0, XREAL_0, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A,B,C,D,E,F,G being Real st
    B*B - 4*A*C < 0
  holds
    ex delta being Real st
      0 < delta &
      not ex x,y being Real st
        0 < x*x + y*y &
        x*x + y*y < delta*delta &
        A*x*x + B*x*y + C*y*y + D*x*x*x + E*x*x*y +
          F*x*y*y + G*y*y*y = 0
proof
end;
::$P+
