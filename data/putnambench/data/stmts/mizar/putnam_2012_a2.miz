:: Statement-only formalization of PutnamBench corpus artifact putnam_2012_a2:
:: a commutative associative binary operation for which every map z |-> x*z
:: is surjective is right-cancellative. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for S being non empty set, op being BinOp of S,
      a,b,c being Element of S st
    (for x,y being Element of S holds op.(x,y) = op.(y,x)) &
    (for x,y,z being Element of S holds
      op.(op.(x,y),z) = op.(x,op.(y,z))) &
    (for x,y being Element of S holds
      ex z being Element of S st op.(x,z) = y) &
    op.(a,c) = op.(b,c)
  holds a = b
proof
end;
::$P+
