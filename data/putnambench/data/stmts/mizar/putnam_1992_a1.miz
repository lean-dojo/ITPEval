:: Statement-only formalization of PutnamBench corpus artifact putnam_1992_a1:
:: the function n |-> 1 - n is characterized among integer-valued functions
:: by two nested functional equations and the value at zero. This file contains no proof.

environ

  vocabularies XBOOLE_0, SUBSET_1, FUNCT_1, XCMPLX_0, NUMBERS,
    XREAL_0, INT_1, ZFMISC_1, ARYTM_1, RELAT_1, ARYTM_3, CARD_1,
    NAT_1, VALUED_0, REAL_1, XXREAL_0;
  notations XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, XCMPLX_0, XXREAL_0, NAT_1, INT_1, NUMBERS, VALUED_0;
  constructors XCMPLX_0, XXREAL_0, INT_1, RELSET_1, VALUED_0, NUMBERS;
  registrations ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, RELSET_1, VALUED_0;
  requirements BOOLE, SUBSET, ARITHM, NUMERALS;
  definitions INT_1;
  expansions INT_1;

begin

::$P-
theorem
  for f being Function of INT, INT holds
    ((for n being Integer holds f.n = 1 - n) iff
      (for n being Integer holds f.(f.n) = n) &
      (for n being Integer holds f.(f.(n + 2) + 2) = n) &
      f.0 = 1)
proof
end;
::$P+
