:: Statement-only formalization of PutnamBench artifact putnam_1965_b4:
:: the binomial-sum quotient satisfies a rational recurrence, converges exactly
:: for nonnegative real inputs, and tends there to the square root. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, COMPLEX1, SQUARE_1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, COMPLEX1, SQUARE_1, INT_1,
    NEWTON, RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2,
    NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2, COMPLEX1, SQUARE_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1, MEMBERED, COMPLEX1,
    SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f,u,v being Function of NAT,Funcs(REAL,REAL) holds
  for n being Nat st
    (for m being Nat st 0 < m holds
      for x being Real holds
        ex terms being FinSequence of REAL st
          len terms = (m div 2) + 1 &
          (for j being Nat st j in Seg ((m div 2) + 1) holds
            terms.j =
              (m choose (2 * (j -' 1))) *
              (x |^ (j -' 1))) &
          (u.m).x = Sum terms) &
    (for m being Nat st 0 < m holds
      for x being Real holds
        ex terms being FinSequence of REAL st
          len terms = ((m -' 1) div 2) + 1 &
          (for j being Nat st
            j in Seg (((m -' 1) div 2) + 1) holds
            terms.j =
              (m choose (2 * (j -' 1) + 1)) *
              (x |^ (j -' 1))) &
          (v.m).x = Sum terms) &
    (for m being Nat st 0 < m holds
      for x being Real,
          fm,um,vm being Function of REAL,REAL st
        fm = f.m & um = u.m & vm = v.m
      holds fm.x = um.x / vm.x) &
    0 < n
  holds
    (for x being Real,
         fn,fn1,vn,vn1 being Function of REAL,REAL st
      fn = f.n & fn1 = f.(n + 1) &
      vn = v.n & vn1 = v.(n + 1) &
      vn.x <> 0 &
      vn1.x <> 0 &
      fn.x + 1 <> 0
    holds
      fn1.x = (fn.x + x) / (fn.x + 1)) &
    (for x being Real holds
      ((ex l being Real,
           s being Function of NAT,REAL st
          (for m being Nat holds s.m = (f.m).x) &
          for e being Real st 0 < e holds
            ex N being Nat st
              for m being Nat st N <= m holds
                |.s.m - l.| < e)
       iff 0 <= x)) &
    (for x being Real st 0 <= x holds
      ex s being Function of NAT,REAL st
        (for m being Nat holds s.m = (f.m).x) &
        for e being Real st 0 < e holds
          ex N being Nat st
            for m being Nat st N <= m holds
              |.s.m - sqrt x.| < e)
proof
end;
::$P+
