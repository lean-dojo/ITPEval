:: Statement-only formalization of PutnamBench corpus artifact putnam_1983_a4:
:: for m = 6*k - 1 with positive k, the alternating sum of binomial
:: coefficients indexed by 3*j - 1 from j = 1 through 2*k - 1 is nonzero.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3, CARD_3,
    VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for k, m being Nat, S being Integer st
    0 < k &
    m = 6 * k -' 1 &
    (ex terms being FinSequence of INT st
      len terms = 2 * k -' 1 &
      (for j being Nat st j in Seg len terms holds
        terms.j =
          (((-1) qua Integer) |^ (j + 1)) *
            ((m choose (3 * j -' 1)) qua Integer)) &
      S = Sum terms)
  holds S <> 0
proof
end;
::$P+
