:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_a2:
:: integer-coefficient polynomiality of the positive terms in a rational
:: function recurrence initialized by 1 and x. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      NUMBERS, NAT_1, CARD_1, ORDINAL1, STRUCT_0, ALGSTR_0, VECTSP_1,
      RLVECT_1, GROUP_1, BINOP_1, ARYTM_1, ARYTM_3, XCMPLX_0, XXREAL_0,
      ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM4, POLYNOM5,
      INT_1, INT_2, MEMBERED, RAT_1, EC_PF_1, GAUSSINT, AFINSQ_1, FINSEQ_1,
      VALUED_0, VALUED_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
      XCMPLX_0, XXREAL_0, NAT_1, INT_1, INT_2, RAT_1, EC_PF_1, GAUSSINT,
      MEMBERED,
      FINSEQ_1,
      RELAT_1, FUNCT_1, FUNCT_2, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1,
      VECTSP_1, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, VALUED_0,
      VALUED_1;
 constructors RELSET_1, NAT_D, STRUCT_0, ALGSEQ_1, POLYNOM3, POLYNOM4,
      POLYNOM5, POLYNOM1, EC_PF_1, GAUSSINT;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1,
      XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, MEMBERED, STRUCT_0,
      ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, ALGSEQ_1, PRE_POLY,
      POLYNOM1, POLYNOM3, POLYNOM4, POLYNOM5, RAT_1, EC_PF_1, GAUSSINT,
      RELAT_1,
      VALUED_0, VALUED_1, FINSEQ_1;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, ALGSEQ_1;
 equalities STRUCT_0, ALGSTR_0, POLYNOM3;
 expansions TARSKI, ALGSEQ_1;

begin

::$P-
theorem
  for A,B being sequence of Polynom-Ring F_Rat st
    (for n being Nat holds B.n <> 0_.F_Rat) &
    A.0 = B.0 &
    (ex x,a1,b1 being Polynomial of F_Rat st
      len x = 2 &
      x.0 = 0 &
      x.1 = 1 &
      a1 = A.1 &
      b1 = B.1 &
      a1 = x *' b1) &
    (for n being Nat holds
      ex an,an1,an2,bn,bn1,bn2 being Polynomial of F_Rat st
        an = A.n &
        an1 = A.(n + 1) &
        an2 = A.(n + 2) &
        bn = B.n &
        bn1 = B.(n + 1) &
        bn2 = B.(n + 2) &
        ((an = 0_.F_Rat & an2 = 0_.F_Rat) or
        (an <> 0_.F_Rat &
          (an2 *' an) *' (bn1 *' bn1) =
            ((an1 *' an1) - (bn1 *' bn1)) *' (bn2 *' bn))))
  holds
    for n being Nat st 0 < n holds
      ex p,b being Polynomial of F_Rat st
        b = B.n &
        rng p c= INT &
        A.n = p *' b
proof
end;
::$P+
