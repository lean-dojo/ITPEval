:: Statement-only formalization of PutnamBench corpus artifact putnam_2014_a1:
:: every nonzero Taylor coefficient of (1 - x + x^2)exp(x) at zero is
:: rational with reduced numerator equal to one or prime. This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, COMPLEX1, NEWTON,
    ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1, XXREAL_1,
    ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1, XBOOLE_0,
    SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, ORDINAL2, CARD_3,
    ABIAN, TAYLOR_2, NAT_1, FUNCT_2, FCONT_1, INT_1, INT_2, RAT_1;
  notations TARSKI, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1, RFUNCT_2,
    RCOMP_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NUMBERS, COMPLEX1,
    REAL_1, INT_1, INT_2, NAT_1, NAT_D, FUNCT_2, VALUED_1, SEQ_1,
    COMSEQ_2, SEQ_2, SERIES_1, FCONT_1, FDIFF_1, SEQFUNC, NEWTON,
    SIN_COS, TAYLOR_1, ABIAN, RAT_1;
  constructors ARYTM_0, REAL_1, NAT_1, NAT_D, INT_2, SEQ_2, RCOMP_1,
    RFUNCT_2, LIMFUNC1, FCONT_1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN,
    TAYLOR_1, SEQFUNC, SERIES_1, VALUED_1, RELSET_1, COMSEQ_2, RAT_1;
  registrations RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, NEWTON, SIN_COS, INT_1,
    INT_2, ORDINAL1, FCONT_1, RAT_1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities XCMPLX_0, VALUED_1, SUBSET_1;
  expansions TAYLOR_1;
  theorems XBOOLE_1, ABSVALUE, PARTFUN1, XCMPLX_1, RELAT_1, RCOMP_1,
    SEQ_1, SEQ_2, SIN_COS, SERIES_1, FUNCT_1, RFUNCT_2, NAT_1, NEWTON,
    POWER, FDIFF_1, FDIFF_2, TAYLOR_1, SIN_COS2, XREAL_1, RFUNCT_1,
    ABIAN, COMPLEX1, XXREAL_0, VALUED_1, FUNCT_2, XREAL_0, ORDINAL1,
    NAT_D, FCONT_1, INT_2, RAT_1;
  schemes NAT_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL,
      c being Function of NAT,REAL st
    (for x being Real holds
      f.x = (1 - x + x*x) * exp_R.x) &
    (for k being Nat holds
      f is_differentiable_on k,[#]REAL) &
    (for k being Nat holds
      c.k = (diff(f,[#]REAL).k).0 / ((k !) qua Real))
  holds
    for k being Nat st c.k <> 0 holds
      ex q being Rational st
        c.k = q &
        (numerator(q) = 1 or |.numerator(q).| is prime)
proof
end;
::$P+
