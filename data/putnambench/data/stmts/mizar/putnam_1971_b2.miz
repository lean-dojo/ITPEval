:: Statement-only formalization of PutnamBench artifact putnam_1971_b2:
:: the real functions satisfying F(x) + F((x-1)/x) = 1+x away from 0 and 1
:: are uniquely determined by an explicit rational formula. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    BINOP_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0, VALUED_0, VALUED_1, NEWTON;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0, VALUED_1, NEWTON, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex F being Function of REAL,REAL st
    (for x being Real holds
      F.x = ((x |^ 3) - (x |^ 2) - 1) / (2*x*(x-1))) &
    (for x,y being Real st
      x <> 0 & x <> 1 & y = (x-1)/x
    holds F.x + F.y = 1+x) &
    (for f being Function of REAL,REAL st
      (for x,y being Real st
        x <> 0 & x <> 1 & y = (x-1)/x
      holds f.x + f.y = 1+x)
    holds
      for x being Real st x <> 0 & x <> 1 holds
        f.x = F.x)
proof
end;
::$P+
