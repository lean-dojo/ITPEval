:: Statement-only formalization of PutnamBench corpus artifact putnam_2003_b5:
:: for three distinct pairwise equidistant points on the unit circle, every
:: point inside the circle determines three triangle side lengths whose area
:: depends only on its distance from the center. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, METRIC_1, NAT_1, NUMBERS,
      PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1, SQUARE_1,
      STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1, XBOOLE_0,
      XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, COMPLEX1, XXREAL_0, NAT_1, CARD_1, RELAT_1,
      FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2, SQUARE_1,
      STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1, EUCLID, RVSUM_1,
      TOPMETR, TOPREAL6;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, TOPMETR, TOPREAL6;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  for A,B,C being Point of TOP-REAL 2 st
    |.A.| = 1 &
    |.B.| = 1 &
    |.C.| = 1 &
    dist(A,B) = dist(A,C) &
    dist(A,B) = dist(B,C) &
    dist(A,B) <> 0
  holds
    ex f being Function of REAL,REAL st
      for P being Point of TOP-REAL 2 st
        |.P.| < 1
      holds
        ex X,Y,Z being Point of TOP-REAL 2 st
          dist(X,Y) = dist(P,A) &
          dist(Y,Z) = dist(P,B) &
          dist(X,Z) = dist(P,C) &
          |.(Y.1-X.1)*(Z.2-X.2) -
             (Y.2-X.2)*(Z.1-X.1).| / 2 =
            f.(|.P.|)
proof
end;
::$P+
