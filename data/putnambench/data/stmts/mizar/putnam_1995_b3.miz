:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_b3:
:: the sum of determinants of all n by n decimal digit matrices with a
:: nonzero leading digit has the stated piecewise value. This file contains
:: no proof.

environ

 vocabularies NUMBERS, SUBSET_1, NAT_1, XBOOLE_0, MATRIX11, FINSEQ_1,
      ARYTM_3, VECTSP_1, MATRIX_1, RELAT_1, FINSEQ_3, ARYTM_1, TREES_1,
      CARD_1, XXREAL_0, FUNCT_1, INCSP_1, TARSKI, ALGSTR_0, ZFMISC_1,
      STRUCT_0, REALSET1, SETWOP_2, FUNCT_2, FINSUB_1, GROUP_1, SETWISEO,
      INT_1, INT_3, FINSET_1, ABIAN, FINSEQ_2, BINOP_1, QC_LANG1, AFINSQ_1,
      MATRIX_3, SUPINF_2, CARD_3, FINSOP_1, RVSUM_1, FVSUM_1, MESFUNC1,
      MATRIX_6, LAPLACE, FUNCT_7, XCMPLX_0, REAL_1, PREPOWER, NEWTON, POWER;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, FINSET_1, RELAT_1, RELSET_1,
      FUNCT_1, PARTFUN1, FUNCT_2, FINSEQ_1, BINOP_1, STRUCT_0, ALGSTR_0,
      GROUP_1, VECTSP_1, SETWISEO, SETWOP_2, FINSEQ_2, MATRIX_0, FINSUB_1,
      MATRIX_1, NAT_1, FVSUM_1, FINSOP_1, MATRIX_3, CARD_1, FINSEQ_7,
      NEWTON, PREPOWER, POWER, MATRIX_7, FINSEQ_3, MATRIX11, MATRIX_6,
      NAT_D, LAPLACE, RVSUM_1, INT_1, INT_3;
 constructors SETWISEO, FINSOP_1, SETWOP_2, ALGSTR_1, FVSUM_1, BINOP_1,
      FINSEQ_4, FINSEQ_7, WELLORD2, NEWTON, MATRIX_6, MATRIX_7, MATRIX11,
      NAT_D, BINOP_2, RELSET_1, XXREAL_0, NAT_1, VECTSP_2, REALSET1,
      LAPLACE, REAL_1, PREPOWER, POWER, RVSUM_1, INT_3;
 registrations FUNCT_1, FINSUB_1, FINSET_1, STRUCT_0, FVSUM_1, MATRIX_1,
      VECTSP_1, FUNCT_2, PARTFUN1, XBOOLE_0, ORDINAL1, XXREAL_0, NAT_1,
      INT_1, INT_3, RELAT_1, CARD_1, MATRIX11, XCMPLX_0, XREAL_0, RELSET_1,
      FINSEQ_2, FINSEQ_1, MATRIX_0, MATRIX_6, VECTSP_2, PREPOWER, NEWTON,
      RVSUM_1, FRAENKEL;
 requirements ARITHM, NUMERALS, REAL, BOOLE, SUBSET;
 definitions TARSKI;
 equalities FINSEQ_2, FINSEQ_1, MATRIX_0, MATRIX_3, FVSUM_1, MATRIX11,
      RELAT_1, ALGSTR_0, LAPLACE;
 expansions FINSEQ_1, TARSKI;
 theorems FINSEQ_1, FINSEQ_2, TARSKI, FUNCT_2, NAT_1, FUNCT_1, SETWISEO,
      VECTSP_1, ZFMISC_1, FVSUM_1, SETWOP_2, MATRIX_0, MATRIX_1, FINSUB_1,
      FINSEQ_3, RELAT_1, FINSOP_1, XBOOLE_0, XBOOLE_1, MATRIX_3, XREAL_1,
      MATRIX_7, ORDINAL1, CARD_1, CARD_2, MATRIX_9, FINSEQ_4, SGRAPH1,
      CARD_FIN, HURWITZ, NEWTON, COMPUT_1, MATRIX11, GROUP_1, MATRIX_4,
      MATRIX_6, MATRIXR1, NAT_D, SUBSET_1, XXREAL_0, MATRIXR2, XREAL_0,
      LAPLACE, RVSUM_1, INT_1, INT_3;
 schemes FUNCT_2, NAT_1, FINSEQ_1, FUNCT_1, SETWISEO, MATRIX_0;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    ex matrices being one-to-one FinSequence of n-Matrices_over INT.Ring,
       determinants being FinSequence of INT.Ring st
      rng matrices =
        {M where M is Matrix of n,INT.Ring :
          M*(1,1) <> 0.INT.Ring &
          (for i,j being Nat st [i,j] in Indices M holds
            ex d being Nat st d <= 9 & M*(i,j) = (d qua Integer))} &
      len determinants = len matrices &
      (for k being Nat st k in dom matrices holds
        for M being Matrix of n,INT.Ring st M = matrices.k holds
          determinants.k = Det M) &
      (n = 1 implies Sum determinants = 45) &
      (n = 2 implies
        Sum determinants = 10 * ((45 qua Integer) |^ 2)) &
      (n <> 1 & n <> 2 implies Sum determinants = 0)
proof
end;
::$P+
