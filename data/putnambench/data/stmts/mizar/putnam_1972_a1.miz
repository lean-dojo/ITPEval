:: Statement-only formalization of PutnamBench artifact putnam_1972_a1:
:: no four consecutive binomial coefficients for positive indices within a
:: row form an arithmetic progression. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, ARYTM_1, ARYTM_3;
  notations XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, INT_1, NEWTON, NAT_1;
  constructors REAL_1, NAT_1, NEWTON;
  registrations XBOOLE_0, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, INT_1, NEWTON, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    not ex r being Nat st
      0 < r & r + 3 <= n &
      (n choose r) + (n choose (r + 2)) =
        (n choose (r + 1)) + (n choose (r + 1)) &
      (n choose (r + 1)) + (n choose (r + 3)) =
        (n choose (r + 2)) + (n choose (r + 2))
proof
end;
::$P+
