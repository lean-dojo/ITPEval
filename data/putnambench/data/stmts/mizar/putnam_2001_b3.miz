:: Statement-only formalization of PutnamBench corpus artifact putnam_2001_b3:
:: the infinite series whose nth positive-index term uses the nearest integer
:: to sqrt(n) in the exponents of 2 converges to 3. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, INT_1, VALUED_0, VALUED_1, ORDINAL1,
    ORDINAL2, NEWTON, PREPOWER, SEQ_1, SEQ_2, SEQ_4, SERIES_1,
    SQUARE_1, ABIAN, CARDFIN2, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, SQUARE_1, XXREAL_0, INT_1, NAT_1, NEWTON, VALUED_0,
    VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    SERIES_1, ABIAN, CARDFIN2, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    SQUARE_1, INT_1, NAT_1, NEWTON, SEQ_2, SEQM_3, SEQ_4, PREPOWER,
    COMSEQ_2, SERIES_1, BINOP_2, ABIAN, CARDFIN2, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, SQUARE_1, ABIAN, CARDFIN2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex s being Real_Sequence st
    (for n being Nat holds
      s.n =
        (((2 qua Real) to_power
            (round (sqrt((n + 1) qua Real)))) +
         ((2 qua Real) to_power
            (-round (sqrt((n + 1) qua Real))))) /
          ((2 qua Real) |^ (n + 1))) &
    Partial_Sums(s) is convergent &
    lim Partial_Sums(s) = 3
proof
end;
::$P+
