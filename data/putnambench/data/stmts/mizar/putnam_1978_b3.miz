:: Statement-only formalization of PutnamBench artifact putnam_1978_b3:
:: the largest real roots of a recursively defined sequence of real
:: polynomials increase strictly and converge to zero. This file contains no
:: proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3,
      FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1,
      SUPINF_2, NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1,
      CARD_3, BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4,
      FINSEQ_2, VECTSP_2, ZFMISC_1, FUNCT_2, COMPLEX1, VALUED_1, SEQ_1,
      SEQ_2, ORDINAL2, SEQ_4;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      REAL_1, COMPLEX1, NAT_1, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2,
      FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1,
      VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, SEQ_1, SEQ_2,
      COMSEQ_2, SEQM_3, SEQ_4;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
      VECTSP_2, ALGSTR_1, FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
      COMPLEX1, NAT_1, SEQ_2, SEQM_3, SEQ_4, COMSEQ_2;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, VECTSP_2, ALGSTR_1, SEQ_4;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;
 theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, POLYNOM3, POLYNOM4,
      POLYNOM5, CARD_1, NAT_1, XREAL_0, XXREAL_0;

begin

::$P-
theorem
  for P being sequence of Polynom-Ring F_Real,
      a being Real_Sequence st
    P.1 = <%1.F_Real,1.F_Real%> &
    (ex two being Element of F_Real st
      two = 2 & P.2 = <%1.F_Real,two%>) &
    (for n being Nat st 1 <= n holds
      ex c being Element of F_Real,
         pprev,pcur,pnext being Polynomial of F_Real st
        c = n + 1 &
        pprev = P.(2 * n - 1) &
        pcur = P.(2 * n) &
        pnext = P.(2 * n + 1) &
        pnext = pcur + <%c%> *' <%0.F_Real,1.F_Real%> *' pprev) &
    (for n being Nat st 1 <= n holds
      ex c being Element of F_Real,
         pprev,pcur,pnext being Polynomial of F_Real st
        c = n + 1 &
        pprev = P.(2 * n) &
        pcur = P.(2 * n + 1) &
        pnext = P.(2 * n + 2) &
        pnext = pcur + <%c%> *' <%0.F_Real,1.F_Real%> *' pprev) &
    (for n being Nat st 1 <= n holds
      ex p being Polynomial of F_Real,
         r being Element of F_Real st
        p = P.n &
        r = a.n &
        eval(p,r) = 0.F_Real &
        for x being Element of F_Real st eval(p,x) = 0.F_Real
          holds x <= r)
  holds
    (for i,j being Nat st 1 <= i & i < j holds a.i < a.j) &
    a is convergent & lim a = 0
proof
end;
::$P+
