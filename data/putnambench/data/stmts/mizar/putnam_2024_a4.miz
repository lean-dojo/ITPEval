:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_a4
:: (putnambench__mizar__putnam_2024_a4): classification of primes for which
:: powers of an integer can be permuted so consecutive terms have a fixed
:: nonzero difference modulo the prime. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, NUMBERS, NAT_1, INT_1, INT_2, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, NEWTON, SQUARE_1, COMPLEX1, ABIAN,
    ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, NEWTON, SQUARE_1,
    ABIAN;
  constructors RELSET_1, PARTFUN1, NAT_1, NAT_D, INT_1, INT_2, NEWTON,
    SQUARE_1, ABIAN;
  registrations XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, NEWTON, ABIAN, WSIERP_1,
    ABSVALUE, VALUED_0, VALUED_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;

begin

::$P-
theorem
  for p being Nat holds
    ((p is prime & 5 < p &
      ex a,r being Integer,
         e being Function of NAT,NAT,
         D being Subset of NAT st
        1 <= r & r <= (p qua Integer) - 1 &
        D = {k where k is Element of NAT : k <= p -' 5} &
        (e | D) is one-to-one &
        rng (e | D) = D &
        (for n being Nat st 1 <= n & n <= p -' 5 holds
          ex i,j being Nat st
            i = e.n & j = e.(n -' 1) &
            (p qua Integer) divides
              ((a |^ i) - (a |^ j) - r)))
    iff p = 7)
proof
end;
::$P+
