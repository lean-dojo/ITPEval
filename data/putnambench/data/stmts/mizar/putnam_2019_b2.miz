:: Statement-only formalization of PutnamBench corpus artifact putnam_2019_b2:
:: the trigonometric finite-sum sequence normalized by n^3 converges to
:: 8/PI^3. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1, VALUED_0, VALUED_1,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2, SEQ_4,
    FINSEQ_1, FINSEQ_2, BINOP_1, BINOP_2, ZFMISC_1, CARD_3,
    SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, COMPLEX1, XXREAL_0, NEWTON, NAT_1, NAT_D,
    BINOP_2, SETWISEO, BINOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4,
    VALUED_0, VALUED_1, FINSOP_1, SETWOP_2, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PREPOWER, RVSUM_1, SIN_COS;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, NAT_D, BINOP_1,
    SETWISEO, BINOP_2, VALUED_1, FINSEQ_4, FINSOP_1, SETWOP_2,
    XXREAL_1, FINSEQ_2, SEQ_2, SEQM_3, SEQ_4, PREPOWER, COMSEQ_2,
    RVSUM_1, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, FINSEQ_1, FINSEQ_2, RVSUM_1, BINOP_2, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,s being Real_Sequence st
    (for n being Nat holds
      ex terms being FinSequence of REAL st
        len terms = n -' 1 &
        (for k being Nat st k in dom terms holds
          terms.k =
            sin(((2 * (k qua Real) - 1) * PI) /
                  (2 * (n qua Real))) /
            ((cos(((k qua Real) - 1) * PI /
                   (2 * (n qua Real)))) |^ 2 *
             (cos((k qua Real) * PI /
                   (2 * (n qua Real)))) |^ 2)) &
        a.n = Sum terms) &
    (for n being Nat holds
      s.n = a.n / ((n qua Real) |^ 3))
  holds
    s is convergent &
    lim s = (8 qua Real) / (PI |^ 3)
proof
end;
::$P+
