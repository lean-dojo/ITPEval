:: Statement-only formalization of PutnamBench corpus artifact putnam_2002_b6:
:: the determinant of the three-variable Frobenius-power matrix is
:: coefficientwise congruent modulo a prime to a finite product of integer
:: linear forms. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, INT_1, INT_2, INT_3, NEWTON, REAL_1, SUBSET_1,
      XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2, CARD_1,
      CARD_3, ORDINAL4, TARSKI, ZFMISC_1, ARYTM_1, ARYTM_3, XXREAL_0,
      XCMPLX_0, STRUCT_0, ALGSTR_0, GROUP_1, VECTSP_1, BINOP_1,
      LATTICES, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM5,
      FUNCT_4, FUNCT_7, PARTFUN1, VALUED_0, MESFUNC1, AFINSQ_1,
      RLVECT_1, SUPINF_2, MATRIX_1, MATRIX_3, MATRIX11, LAPLACE,
      FINSOP_1, SETWISEO, MONOID_0, GROUP_4, BINOM;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, INT_1, INT_2, NAT_1, NAT_D,
      NEWTON,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      BINOP_1, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
      GROUP_4, BINOM, VECTSP_1, VECTSP_2, ALGSEQ_1, FUNCT_7, POLYNOM3,
      POLYNOM4,
      POLYNOM5, INT_3, MATRIX_0, MATRIX_1, MATRIX_3, LAPLACE;
 constructors RELSET_1, FUNCT_2, REAL_1, FINSEQ_4, BINOP_2, ALGSTR_1,
      VECTSP_2,
      ALGSEQ_1, FUNCT_7, POLYNOM4, POLYNOM5, INT_3, NAT_D, NEWTON,
      MATRIX_1, MATRIX_3, MATRIX11, LAPLACE, GROUP_4, BINOM;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, RELSET_1,
      ORDINAL1, CARD_1, XXREAL_0, XREAL_0, XCMPLX_0, NAT_1, INT_1, INT_3,
      FINSEQ_1, FINSEQ_2, STRUCT_0, ALGSTR_1, RLVECT_1, GROUP_1,
      VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM5, FUNCT_7,
      PRE_POLY, MEMBERED, MATRIX_0, MATRIX_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, STRUCT_0, ALGSTR_0, VECTSP_1, POLYNOM3,
      POLYNOM5, MATRIX_0, MATRIX_3, LAPLACE;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;
 theorems TARSKI, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2, NAT_1, INT_1,
      INT_2, INT_3, NEWTON, POLYNOM3, POLYNOM4, POLYNOM5, MATRIX_0,
      MATRIX_1, MATRIX_3, MATRIX11, LAPLACE, GROUP_4;

begin

::$P-
theorem
  for p being Nat,
      vx being Element of Polynom-Ring INT.Ring,
      cx,vy being Element of Polynom-Ring (Polynom-Ring INT.Ring),
      X,Y,Z being
        Element of
          Polynom-Ring (Polynom-Ring (Polynom-Ring INT.Ring)),
      M being Matrix of 3,
        Polynom-Ring (Polynom-Ring (Polynom-Ring INT.Ring)) st
    p is prime &
    vx = <%0.INT.Ring,1.INT.Ring%> &
    cx = <%vx%> &
    vy = <%0.(Polynom-Ring INT.Ring),1.(Polynom-Ring INT.Ring)%> &
    X = <%cx%> &
    Y = <%vy%> &
    Z =
      <%0.(Polynom-Ring (Polynom-Ring INT.Ring)),
        1.(Polynom-Ring (Polynom-Ring INT.Ring))%> &
    M*(1,1) = X & M*(1,2) = Y & M*(1,3) = Z &
    M*(2,1) = X |^ p & M*(2,2) = Y |^ p & M*(2,3) = Z |^ p &
    M*(3,1) = X |^ (p * p) &
    M*(3,2) = Y |^ (p * p) &
    M*(3,3) = Z |^ (p * p)
  holds
    ex factors being FinSequence of
        the carrier of
          Polynom-Ring (Polynom-Ring (Polynom-Ring INT.Ring)) st
      (for n being Nat st n in dom factors holds
        ex a,b,c being Element of INT.Ring,
           a0,b0,c0 being Element of Polynom-Ring INT.Ring,
           a1,b1,c1 being
             Element of Polynom-Ring (Polynom-Ring INT.Ring),
           A,B,C being
             Element of
               Polynom-Ring (Polynom-Ring (Polynom-Ring INT.Ring)) st
          a0 = <%a%> & b0 = <%b%> & c0 = <%c%> &
          a1 = <%a0%> & b1 = <%b0%> & c1 = <%c0%> &
          A = <%a1%> & B = <%b1%> & C = <%c1%> &
          factors/.n = A * X + B * Y + C * Z) &
      ex D,E being
          Polynomial of Polynom-Ring (Polynom-Ring INT.Ring) st
        D = Det M & E = Product factors &
        for i,j,k being Nat holds
          ex Di,Ei being Polynomial of Polynom-Ring INT.Ring st
            Di = D.i & Ei = E.i &
            ex Dij,Eij being Polynomial of INT.Ring st
              Dij = Di.j & Eij = Ei.j &
              ex d,e being Integer st
                d = Dij.k & e = Eij.k &
                (p qua Integer) divides (d - e)
proof
end;
::$P+
