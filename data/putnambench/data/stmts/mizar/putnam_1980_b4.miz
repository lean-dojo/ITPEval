:: Statement-only formalization of PutnamBench corpus artifact putnam_1980_b4:
:: a family of 1066 subsets, each containing more than half of a finite set
:: with at least 10 elements, has a 10-element hitting set. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FINSET_1,
    CARD_1, NUMBERS, NAT_1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, FUNCT_1, FUNCT_2, FINSEQ_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
    RELSET_1, FINSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, NAT_D, CARD_1, FUNCT_1, FUNCT_2, FINSEQ_1;
  constructors RELAT_1, RELSET_1, FINSET_1, XTUPLE_0, XXREAL_0, NAT_1,
    NAT_D, CARD_1, FUNCT_2, FINSEQ_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, MEMBERED,
    FUNCT_1, FUNCT_2, FINSEQ_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for X being finite set,
      A being Function of Seg 1066, bool X st
    (ex n being Nat st
      n = card X &
      10 <= n &
      for i being Element of Seg 1066 holds
        ex m being Nat st
          m = card (A.i) & 2 * m > n)
  holds
    ex Y being Subset of X st
      card Y = 10 &
      for i being Element of Seg 1066 holds
        ex y being Element of X st y in Y & y in A.i
proof
end;
::$P+
