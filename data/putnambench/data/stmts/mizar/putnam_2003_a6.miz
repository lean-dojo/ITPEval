:: Statement-only formalization of PutnamBench corpus artifact putnam_2003_a6:
:: the nonnegative integers can be partitioned into two sets having equal
:: numbers of ordered distinct-element representations of every sum.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, NUMBERS, NAT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1,
    ARYTM_1, ARYTM_3, RELAT_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, ORDINAL1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, FINSET_1,
    CARD_1;
  constructors XTUPLE_0, NAT_1, NAT_D, FINSET_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, ORDINAL1, CARD_1, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  ex A,B being Subset of NAT st
    A \/ B = NAT &
    A /\ B = {} &
    for n being Nat holds
      card {[s1,s2] where s1,s2 is Element of NAT :
        s1 in A & s2 in A & s1 <> s2 & s1 + s2 = n}
      =
      card {[s1,s2] where s1,s2 is Element of NAT :
        s1 in B & s2 in B & s1 <> s2 & s1 + s2 = n}
proof
end;
::$P+
