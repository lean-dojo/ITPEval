:: Statement-only formalization of PutnamBench artifact putnam_1965_b1:
:: the limit of the integrals of a cosine square over growing-dimensional
:: unit cubes is one half. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, NAT_1,
      FINSEQ_1, RVSUM_1, SIN_COS, SQUARE_1, SUPINF_2, MEASURE1,
      MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5, SEQ_1, SEQ_2, SEQ_4,
      ZFMISC_1, BINOP_1, FUNCOP_1, FINSEQ_2, FINSEQOP;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
      FUNCT_1, PARTFUN1, FUNCT_2, BINOP_1, FUNCOP_1, ORDINAL1, CARD_1,
      NUMBERS,
      XCMPLX_0, XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0,
      VALUED_1, NAT_1, FINSEQ_1, FINSEQ_2, FINSEQOP, RVSUM_1,
      SIN_COS, SQUARE_1,
      SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12,
      INTEGRA5, EXTREAL1, SEQ_1, SEQ_2, COMSEQ_2, SEQ_4;
 constructors RELSET_1, FUNCT_2, FUNCOP_1, REAL_1, NAT_1, FINSEQ_1,
      FINSEQ_2, FINSEQOP, RVSUM_1, SIN_COS, SQUARE_1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12,
      INTEGRA5, EXTREAL1, SEQ_2, SEQ_4, COMSEQ_2, BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, NAT_1, FINSEQ_1, FINSEQ_2, FUNCOP_1, SIN_COS,
      SQUARE_1, XXREAL_3,
      MEASURE1, MEASUR12, SEQ_4, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities SQUARE_1;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  ex I being Element of L-Field,
     sums being Function of REAL*,REAL,
     values being Function of [:NAT,REAL*:],REAL,
     integrals being Real_Sequence st
    (for x being Real holds
      (x in I iff 0 <= x & x <= 1)) &
    (for p being FinSequence of REAL holds
      ex a being FinSequence of REAL st
        len a = len p + 1 &
        a.1 = 0 &
        (for k being Nat st 1 <= k & k <= len p holds
          a.(k+1) = a.k + p.k) &
        sums.p = a.(len p + 1)) &
    (for m being Nat, p being FinSequence of REAL st
      0 < m & len p = m
    holds
      values.(m,p) =
        (cos.(PI / (2 * (m qua Real)) * sums.p))^2) &
    (for m being Nat, p being FinSequence of REAL st
      0 < m & len p < m
    holds
      ex h being Function of REAL,REAL st
        (for x being Real holds
          ex q being FinSequence of REAL st
            len q = len p + 1 &
            (for k being Nat st k in dom p holds q.k = p.k) &
            q.(len p + 1) = x &
            h.x = values.(m,q)) &
        values.(m,p) = Integral(L-Meas,h|I)) &
    (for n being Nat holds
      integrals.n = values.(n+1,<*>REAL)) &
    (for e being Real st 0 < e holds
      ex N being Nat st
        for n being Nat st N <= n holds
          1 / 2 - e < integrals.n & integrals.n < 1 / 2 + e)
proof
end;
::$P+
