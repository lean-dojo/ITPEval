:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_a1
:: (putnambench__mizar__putnam_2016_a1): 8 is the smallest positive derivative
:: order for which every integer-coefficient polynomial has value divisible by
:: 2016 at every integer after that many formal differentiations. This file
:: contains no proof.

environ

 vocabularies ARYTM_3, VECTSP_1, ALGSTR_0, TARSKI, NAT_1, MESFUNC1, VECTSP_2,
      STRUCT_0, SUBSET_1, SUPINF_2, GROUP_1, POLYNOM1, POLYNOM3, FUNCSDOM,
      HURWITZ, FINSEQ_1, ALGSEQ_1, FUNCT_1, RELAT_1, CARD_1, XBOOLE_0, NUMBERS,
      MSSUBFAM, CARD_3, RLVECT_1, AFINSQ_1, PARTFUN1, XXREAL_0, XCMPLX_0,
      ORDINAL4, RATFUNC1, NEWTON, ARYTM_1, FIELD_1, FUNCOP_1, ALGSTR_1,
      BINOP_1, LATTICES, RFINSEQ, FINSEQ_3, FINSEQ_5, POLYDIFF, POLYNOM5,
      POLYNOM2, FUNCT_2, RINGDER1, TOPGEN_1, REAL_1, INT_1, INT_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1, RELSET_1,
      PARTFUN1, FUNCT_2, FUNCOP_1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, NAT_D,
      FINSEQ_1, NEWTON, RFINSEQ, FINSEQ_5, FINSEQ_7, WSIERP_1, STRUCT_0,
      ALGSTR_0, GROUP_1, VECTSP_1, ALGSTR_1, VECTSP_2, GROUP_4, POLYNOM1,
      ALGSEQ_1, BINOM, POLYNOM3, POLYNOM4, RLVECT_1, POLYNOM5, HURWITZ,
      VECTSP11, RATFUNC1, RING_4, POLYDIFF, FIELD_1, RINGDER1, INT_1, INT_3,
      BASEL_2;
 constructors RELSET_1, NAT_D, FINSEQOP, NEWTON, RFINSEQ, FINSEQ_5, FINSEQ_7,
      GROUP_4, FVSUM_1, ALGSEQ_1, GCD_1, BINOM, POLYNOM3, POLYNOM4, VECTSP11,
      POLYNOM5, RATFUNC1, POLYDIFF, FIELD_1, WSIERP_1, RINGDER1, BASEL_2,
      INT_3;
 registrations XBOOLE_0, XXREAL_0, XREAL_0, CARD_1, ORDINAL1, RELSET_1, MOD_4,
      FUNCT_1, NAT_1, INT_1, POLYDIFF, FINSEQ_1, STRUCT_0, RLVECT_1, VECTSP_1,
      ALGSTR_1, RING_3, RING_4, RING_5, POLYNOM3, POLYNOM4, POLYNOM5,
      RATFUNC1, FUNCOP_1, RELAT_1, FDIFF_1, FUNCT_2, RINGDER1, ALGSEQ_1,
      INT_3, NUMBERS;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, GROUP_1, FINSEQ_1, FUNCT_1, FUNCT_2, POLYDIFF, ALGSTR_0,
      VECTSP_1, BASEL_2;
 equalities FINSEQ_1, XCMPLX_0, POLYNOM3, RING_4, POLYDIFF, HURWITZ, RLVECT_1,
      STRUCT_0, SUBSET_1, ALGSTR_0, VECTSP_1, RATFUNC1, POLYNOM5, FUNCSDOM,
      VALUED_1, BASEL_2;
 expansions STRUCT_0, VECTSP_1, TARSKI, FUNCT_2, FINSEQ_1, FUNCT_1, RING_4,
      RATFUNC1, POLYDIFF, RLVECT_1;
 theorems FUNCT_1, FUNCT_2, POLYNOM3, POLYNOM5, RINGDER1, VECTSP11, INT_1;

begin

::$P-
theorem
  (0 < (8 qua Nat) &
    (for f being Element of the carrier of Polynom-Ring INT.Ring,
         k being Element of INT.Ring holds
      ex q being Element of INT.Ring st
        eval(((((Der1(INT.Ring))|^8).f) qua Polynomial of INT.Ring),k)
          = 2016 * q)) &
  (for j being Nat st
    0 < j &
    (for f being Element of the carrier of Polynom-Ring INT.Ring,
         k being Element of INT.Ring holds
      ex q being Element of INT.Ring st
        eval(((((Der1(INT.Ring))|^j).f) qua Polynomial of INT.Ring),k)
          = 2016 * q)
   holds (8 qua Nat) <= j)
proof
end;
::$P+
