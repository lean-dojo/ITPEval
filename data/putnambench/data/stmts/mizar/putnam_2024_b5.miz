:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_b5
:: (putnambench__mizar__putnam_2024_b5): the count of pairs of positive
:: nondecreasing integer sequences with a common bounded upper endpoint is a
:: rational polynomial in the bound with nonnegative coefficients. This file
:: contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
      FUNCT_2, NUMBERS, NAT_1, CARD_1, ORDINAL1, STRUCT_0, ALGSTR_0,
      VECTSP_1, RLVECT_1, GROUP_1, BINOP_1, ARYTM_1, ARYTM_3, XCMPLX_0,
      XREAL_0, XXREAL_0, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3,
      POLYNOM4, POLYNOM5, INT_1, INT_2, MEMBERED, RAT_1, EC_PF_1,
      GAUSSINT, AFINSQ_1, FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1,
      FINSET_1, CARD_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, ORDINAL1,
      CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1,
      INT_2, RAT_1, EC_PF_1, GAUSSINT, MEMBERED, FINSEQ_1, FINSEQ_2,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, STRUCT_0, ALGSTR_0,
      RLVECT_1, GROUP_1, VECTSP_1, ALGSEQ_1, POLYNOM3, POLYNOM4,
      POLYNOM5, VALUED_0, VALUED_1, FINSET_1;
 constructors XTUPLE_0, RELSET_1, PARTFUN1, FUNCT_2, NAT_D, FINSEQ_1,
      FINSEQ_2, FINSEQ_4, FINSET_1, STRUCT_0, ALGSEQ_1, POLYNOM3,
      POLYNOM4, POLYNOM5, POLYNOM1, EC_PF_1, GAUSSINT;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      ORDINAL1, CARD_1, XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2,
      MEMBERED, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
      VECTSP_1, ALGSEQ_1, PRE_POLY, POLYNOM1, POLYNOM3, POLYNOM4,
      POLYNOM5, RAT_1, EC_PF_1, GAUSSINT, VALUED_0, VALUED_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, ALGSEQ_1;
 equalities STRUCT_0, ALGSTR_0, POLYNOM3, FINSEQ_1;
 expansions TARSKI, XBOOLE_0, ALGSEQ_1, FINSEQ_1;

begin

::$P-
theorem
  for k,m being Nat, f being Function of NAT,NAT st
    0 < k & 0 < m &
    (for n being Nat holds
      f.n =
        card {[[x,y],z] where x,y is FinSequence of NAT, z is Nat :
          len x = k &
          len y = m &
          (for i,j being Nat st
            i in Seg k & j in Seg k & i <= j holds x.i <= x.j) &
          1 <= x.1 &
          x.k <= z &
          (for i,j being Nat st
            i in Seg m & j in Seg m & i <= j holds y.i <= y.j) &
          1 <= y.1 &
          y.m <= z &
          z <= n})
  holds
    ex p being Polynomial of F_Rat st
      (for n being Nat st 0 < n holds
        ex q being Element of F_Rat st
          q = n & eval(p,q) = f.n) &
      (for i being Nat holds
        ex r being Rational st r = p.i & 0 <= r)
proof
end;
::$P+
