:: Statement-only formalization of PutnamBench corpus artifact putnam_1985_b6:
:: a finite group of positive-size real square matrices whose traces sum to
:: zero has matrix sum equal to the zero matrix. This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, NAT_1, XBOOLE_0, MATRIX11, FINSEQ_1,
      ARYTM_3, VECTSP_1, MATRIX_1, RELAT_1, FINSEQ_3, ARYTM_1, TREES_1,
      CARD_1, XXREAL_0, FUNCT_1, INCSP_1, TARSKI, ALGSTR_0, ZFMISC_1,
      STRUCT_0, REALSET1, SETWOP_2, FUNCT_2, FINSUB_1, GROUP_1, SETWISEO,
      INT_1, FINSET_1, ABIAN, FINSEQ_2, BINOP_1, QC_LANG1, AFINSQ_1,
      ABSVALUE, MATRIX_3, SUPINF_2, CARD_3, FINSOP_1, RVSUM_1, FVSUM_1,
      MESFUNC1, MATRIX_6, LAPLACE, FUNCT_7, COMPLEX1, XREAL_0, REAL_1,
      PREPOWER, NEWTON, POWER, MATRIX_8;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, COMPLEX1, FINSET_1, RELAT_1,
      RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FINSEQ_1, BINOP_1, STRUCT_0,
      ALGSTR_0, GROUP_1, VECTSP_1, SETWISEO, SETWOP_2, FINSEQ_2, MATRIX_0,
      FINSUB_1, MATRIX_1, NAT_1, FVSUM_1, FINSOP_1, MATRIX_3, CARD_1,
      FINSEQ_7, NEWTON, PREPOWER, POWER, MATRIX_7, FINSEQ_3, MATRIX11,
      MATRIX_6, NAT_D, LAPLACE, RVSUM_1, MATRIX_8;
 constructors SETWISEO, FINSOP_1, SETWOP_2, ALGSTR_1, FVSUM_1, BINOP_1,
      FINSEQ_4, FINSEQ_7, WELLORD2, NEWTON, MATRIX_6, MATRIX_7, MATRIX11,
      NAT_D, BINOP_2, RELSET_1, XXREAL_0, NAT_1, VECTSP_2, REALSET1,
      LAPLACE, COMPLEX1, REAL_1, PREPOWER, POWER, RVSUM_1, MATRIX_8;
 registrations FUNCT_1, FINSUB_1, FINSET_1, STRUCT_0, FVSUM_1, MATRIX_1,
      VECTSP_1, FUNCT_2, PARTFUN1, XBOOLE_0, ORDINAL1, XXREAL_0, NAT_1,
      INT_1, RELAT_1, CARD_1, MATRIX11, XCMPLX_0, XREAL_0, RELSET_1,
      FINSEQ_2, FINSEQ_1, MATRIX_0, MATRIX_6, VECTSP_2, PREPOWER, NEWTON,
      RVSUM_1;
 requirements ARITHM, NUMERALS, REAL, BOOLE, SUBSET;
 definitions TARSKI;
 equalities FINSEQ_2, FINSEQ_1, MATRIX_0, MATRIX_3, FVSUM_1, MATRIX11,
      RELAT_1, ALGSTR_0, LAPLACE;
 expansions FINSEQ_1, TARSKI;
 theorems FINSEQ_1, FINSEQ_2, TARSKI, FUNCT_2, NAT_1, FUNCT_1, SETWISEO,
      VECTSP_1, ZFMISC_1, FVSUM_1, SETWOP_2, MATRIX_0, MATRIX_1, FINSUB_1,
      FINSEQ_3, RELAT_1, FINSOP_1, XBOOLE_0, XBOOLE_1, MATRIX_3, XREAL_1,
      MATRIX_7, ORDINAL1, CARD_1, CARD_2, MATRIX_9, FINSEQ_4, SGRAPH1,
      CARD_FIN, HURWITZ, NEWTON, COMPUT_1, MATRIX11, GROUP_1, MATRIX_4,
      MATRIX_6, MATRIXR1, NAT_D, SUBSET_1, XXREAL_0, MATRIXR2, XREAL_0,
      LAPLACE, COMPLEX1, RVSUM_1, MATRIX_8;
 schemes FUNCT_2, NAT_1, FINSEQ_1, FUNCT_1, SETWISEO, MATRIX_0;

begin

::$P-
theorem
  for n being Nat,
      G being one-to-one FinSequence of n-Matrices_over F_Real st
    n > 0 &
    (ex e being Nat st e in dom G & G.e = 1.(F_Real,n)) &
    (for i,j being Nat st i in dom G & j in dom G holds
      for A,B being Matrix of n,F_Real st A = G.i & B = G.j holds
        ex k being Nat st k in dom G & G.k = A*B) &
    (for i being Nat st i in dom G holds
      for A being Matrix of n,F_Real st A = G.i holds
        ex j being Nat, B being Matrix of n,F_Real st
          j in dom G & B = G.j & A*B = 1.(F_Real,n)) &
    (ex traces being FinSequence of the carrier of F_Real st
      len traces = len G &
      (for i being Nat st i in dom G holds
        for A being Matrix of n,F_Real st A = G.i holds
          traces.i = Sum diagonal_of_Matrix A) &
      Sum traces = 0.F_Real)
  holds
    ex H being FinSequence of n-G_Matrix_over F_Real st
      H = G & Sum H = 0.(n-G_Matrix_over F_Real)
proof
end;
::$P+
