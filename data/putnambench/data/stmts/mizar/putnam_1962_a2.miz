:: Statement-only formalization of PutnamBench artifact putnam_1962_a2.
:: This classifies the nonnegative real functions on intervals starting at
:: zero whose integral average equals the geometric mean of their endpoint
:: values, with zero fallback for non-integrable intervals and the published
:: rational-square solution family. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1,
      SQUARE_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12,
      INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0, VALUED_1,
      SQUARE_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1;
 constructors RELSET_1, FUNCT_2, REAL_1, SQUARE_1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0, VALUED_1,
      SQUARE_1, XXREAL_3, MEASURE1, MEASUR12;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities SQUARE_1;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  (for f being Function of REAL,REAL holds
    (((for x being Real holds 0 <= f.x) &
       (for x being Real st 0 < x holds
         ((f|[.0,x.] is_integrable_on L-Meas &
           Integral(L-Meas,f|[.0,x.]) = x * sqrt(f.0 * f.x)) or
          (not (f|[.0,x.] is_integrable_on L-Meas) &
           0 = x * sqrt(f.0 * f.x)))))
     implies
      ex g being Function of REAL,REAL st
        (ex a,c being Real st
          0 <= a &
          for x being Real holds g.x = a / (1 - c*x)^2) &
        for x being Real st 0 <= x holds f.x = g.x) &
    (for e being Real st
      0 < e &
      (for x being Real holds 0 <= f.x) &
      (for x being Real st 0 < x & x < e holds
        ((f|[.0,x.] is_integrable_on L-Meas &
          Integral(L-Meas,f|[.0,x.]) = x * sqrt(f.0 * f.x)) or
         (not (f|[.0,x.] is_integrable_on L-Meas) &
          0 = x * sqrt(f.0 * f.x))))
      holds ex g being Function of REAL,REAL st
        (ex a,c being Real st
          0 <= a &
          for x being Real holds g.x = a / (1 - c*x)^2) &
        for x being Real st 0 <= x & x < e holds f.x = g.x)) &
  for f being Function of REAL,REAL st
    (ex a,c being Real st
      0 <= a &
      for x being Real holds f.x = a / (1 - c*x)^2)
    holds
      ((for x being Real holds 0 <= f.x) &
       (for x being Real st 0 < x holds
         ((f|[.0,x.] is_integrable_on L-Meas &
           Integral(L-Meas,f|[.0,x.]) = x * sqrt(f.0 * f.x)) or
          (not (f|[.0,x.] is_integrable_on L-Meas) &
           0 = x * sqrt(f.0 * f.x))))) or
      ex e being Real st
        0 < e &
        (for x being Real holds 0 <= f.x) &
        for x being Real st 0 < x & x < e holds
          ((f|[.0,x.] is_integrable_on L-Meas &
            Integral(L-Meas,f|[.0,x.]) = x * sqrt(f.0 * f.x)) or
           (not (f|[.0,x.] is_integrable_on L-Meas) &
            0 = x * sqrt(f.0 * f.x)))
proof
end;
::$P+
