:: Statement-only formalization of PutnamBench corpus artifact putnam_1990_a2:
:: sqrt(2) is the limit of a real sequence whose terms are differences of
:: cube roots of nonnegative integers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, ORDINAL1, ORDINAL2, SEQ_4, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2,
    COMSEQ_2, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex s being Real_Sequence st
    (for i being Nat holds
      ex n,m being Nat st
        s.i =
          (n qua Real) to_power ((1 qua Real) / 3) -
          (m qua Real) to_power ((1 qua Real) / 3)) &
    s is convergent &
    lim s = sqrt 2
proof
end;
::$P+
