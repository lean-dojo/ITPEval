:: Statement-only formalization of PutnamBench corpus artifact putnam_2017_a1
:: (putnambench__mizar__putnam_2017_a1): the positive integers outside the
:: least set containing 2 and closed under positive square roots and the
:: operation n |-> (n+5)^2 are exactly 1 and the positive multiples of 5.
:: This file contains no proof.

environ
  vocabularies TARSKI, NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1,
    SUBSET_1, XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1,
    SQUARE_1, SIN_COS, REAL_1, VALUED_0, INT_1, INT_2, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, INT_2, NAT_D,
    RELAT_1, SIN_COS, XXREAL_0, CARD_1, FINSET_1;
  constructors REAL_1, SQUARE_1, NAT_1, NAT_D, SIN_COS, RELSET_1,
    CARD_1, FINSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    SIN_COS, VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1, FINSET_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for S being Subset of INT st
    (for n being Integer st n in S holds 0 < n) &
    2 in S &
    (for n being Integer st 0 < n & n^2 in S holds n in S) &
    (for n being Integer st n in S holds (n + 5)^2 in S) &
    (for T being Subset of INT st
      (for n being Integer st n in T holds 0 < n) &
      2 in T &
      (for n being Integer st 0 < n & n^2 in T holds n in T) &
      (for n being Integer st n in T holds (n + 5)^2 in T)
    holds S c= T)
  holds
    {n where n is Integer : 0 < n & not n in S} =
    {n where n is Integer : 0 < n & (n = 1 or 5 divides n)}
proof
end;
::$P+
