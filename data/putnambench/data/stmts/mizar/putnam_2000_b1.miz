:: Statement-only formalization of PutnamBench corpus artifact putnam_2000_b1:
:: among N integer triples each having an odd coordinate, some integer linear
:: combination is odd on at least four sevenths of the indices. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, TARSKI, XREAL_0, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, SQUARE_1, FUNCOP_1, REAL_1,
    FINSEQOP, ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO,
    SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1, INT_2,
    FINSET_1;
  notations TARSKI, SUBSET_1, ZFMISC_1, XTUPLE_0, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1,
    SQUARE_1, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO,
    FUNCT_2, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1,
    NAT_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, INT_1, INT_2,
    FINSET_1;
  constructors PARTFUN1, BINOP_1, SETWISEO, SQUARE_1, NAT_1, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1,
    XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1, INT_1, INT_2, FINSET_1,
    XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, SQUARE_1, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, RELSET_1,
    FINSEQ_4, CARD_1, INT_1, INT_2, RVSUM_1, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for N being Nat,
      a,b,c being Function of Seg N,INT st
    N >= 1 &
    (for j being Element of Seg N holds
      not 2 divides a.j or not 2 divides b.j or not 2 divides c.j)
  holds
    ex r,s,t being Integer, S being finite set st
      S = {j where j is Element of Seg N :
        not 2 divides r * a.j + s * b.j + t * c.j} &
      7 * card S >= 4 * N
proof
end;
::$P+
