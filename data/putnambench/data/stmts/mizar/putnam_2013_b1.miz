:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_b1:
:: the integer sequence defined by binary-index recurrences has sum
:: c(n)*c(n+2) from n=1 through 2013 equal to -1. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, FUNCT_2,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NEWTON;
  constructors REAL_1, NAT_1, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    FUNCT_2, NEWTON;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for c being Function of NAT,INT st
    c.1 = 1 &
    (for n being Nat st n > 0 holds
      c.(2 * n) = c.n) &
    (for n being Nat st n > 0 holds
      c.(2 * n + 1) = ((-1 qua Integer) |^ n) * c.n)
  holds
    ex terms being FinSequence of INT st
      len terms = 2013 &
      (for n being Nat st n in Seg 2013 holds
        terms.n = c.n * c.(n + 2)) &
      Sum terms = -1
proof
end;
::$P+
