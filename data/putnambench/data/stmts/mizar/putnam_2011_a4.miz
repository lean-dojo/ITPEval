:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_a4:
:: a positive integer n admits an n by n integer matrix whose row self-dot-
:: products are even and whose distinct-row dot products are odd exactly when
:: n is odd. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, RVSUM_1, ABIAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
    FINSEQ_2, MATRIX_0, MATRIX_1, FINSET_1, RVSUM_1, ABIAN;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    RVSUM_1, FINSEQOP, FINSET_1, ABIAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    FINSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, VALUED_0, VALUED_1, RVSUM_1, MEMBERED,
    FRAENKEL, ABIAN;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1, MATRIX_0;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    ((ex A being Matrix of n,INT st
        (for r being Nat st r in Seg n holds
          ex products being FinSequence of INT st
            len products = n &
            (for j being Nat st j in Seg n holds
              products.j = (A*(r,j)) * (A*(r,j))) &
            (ex k being Integer st Sum products = 2*k)) &
        (for r1,r2 being Nat st r1 in Seg n & r2 in Seg n & r1 <> r2 holds
          ex products being FinSequence of INT st
            len products = n &
            (for j being Nat st j in Seg n holds
              products.j = (A*(r1,j)) * (A*(r2,j))) &
            (ex k being Integer st Sum products = 2*k+1)))
      iff n is odd)
proof
end;
::$P+
