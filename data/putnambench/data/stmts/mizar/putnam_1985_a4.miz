:: Statement-only formalization of PutnamBench corpus artifact putnam_1985_a4:
:: the last two digits occurring infinitely often in the natural sequence
:: a(1) = 3, a(i+1) = 3^a(i) are exactly 87. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, XXREAL_0, NAT_1, NEWTON, NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, INT_1,
    XXREAL_0, NAT_1, NEWTON, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of NAT,NAT st
    a.1 = 3 &
    (for i being Nat st 1 <= i holds
      a.(i + 1) = (3 qua Nat) |^ a.i)
  holds
    for k being Nat holds
      ((k < 100 &
        (for N being Nat holds
          ex i being Nat st N <= i & a.i mod 100 = k))
      iff k = 87)
proof
end;
::$P+
