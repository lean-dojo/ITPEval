:: Statement-only formalization of PutnamBench corpus artifact putnam_1979_a5:
:: distinct real roots of the given cubic have floor-multiple sequences with
:: infinitely many common positive integer values. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NEWTON;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1,
    XXREAL_0, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex alpha,beta being Real st
    alpha <> beta &
    (alpha |^ 3) - 10 * (alpha |^ 2) + 29 * alpha - 25 = 0 &
    (beta |^ 3) - 10 * (beta |^ 2) + 29 * beta - 25 = 0 &
    (for n being Nat holds
      ex m being Integer st
        (m qua Real) > (n qua Real) &
        ex c,d being Nat st
          [\ (c qua Real) * alpha /] = m &
          [\ (d qua Real) * beta /] = m)
proof
end;
::$P+
