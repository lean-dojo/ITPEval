:: Statement-only formalization of PutnamBench artifact putnam_1974_b2:
:: a continuously differentiable real function whose derivative squared plus
:: its cube tends to zero at positive infinity has both function and derivative
:: tending to zero there. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1, LIMFUNC1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, LIMFUNC1, FDIFF_1, COMPLEX1, NEWTON;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, LIMFUNC1, FDIFF_1, VALUED_1,
    XXREAL_2, COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2, NEWTON;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    FCONT_1, ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for y being Function of REAL,REAL st
    y is_differentiable_on [#]REAL &
    (ex d,h being Function of REAL,REAL st
      (for x being Real holds d.x = diff(y,x)) &
      d is continuous &
      (for x being Real holds h.x = d.x * d.x + y.x * y.x * y.x) &
      h is convergent_in+infty &
      lim_in+infty h = 0)
  holds
    y is convergent_in+infty &
    lim_in+infty y = 0 &
    ex d being Function of REAL,REAL st
      (for x being Real holds d.x = diff(y,x)) &
      d is convergent_in+infty &
      lim_in+infty d = 0
proof
end;
::$P+
