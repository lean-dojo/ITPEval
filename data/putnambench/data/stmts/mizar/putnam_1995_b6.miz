:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_b6:
:: no three positive real parameters give pairwise disjoint Beatty floor sets
:: whose union is all positive natural numbers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1,
    XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  not ex alpha,beta,gamma being Real st
    alpha > 0 &
    beta > 0 &
    gamma > 0 &
    {x where x is Element of NAT :
      ex n being Nat st n >= 1 & x = [\ n * alpha /]}
      misses
    {x where x is Element of NAT :
      ex n being Nat st n >= 1 & x = [\ n * beta /]} &
    {x where x is Element of NAT :
      ex n being Nat st n >= 1 & x = [\ n * beta /]}
      misses
    {x where x is Element of NAT :
      ex n being Nat st n >= 1 & x = [\ n * gamma /]} &
    {x where x is Element of NAT :
      ex n being Nat st n >= 1 & x = [\ n * alpha /]}
      misses
    {x where x is Element of NAT :
      ex n being Nat st n >= 1 & x = [\ n * gamma /]} &
    {x where x is Element of NAT : x >= 1} =
      {x where x is Element of NAT :
        ex n being Nat st n >= 1 & x = [\ n * alpha /]} \/
      {x where x is Element of NAT :
        ex n being Nat st n >= 1 & x = [\ n * beta /]} \/
      {x where x is Element of NAT :
        ex n being Nat st n >= 1 & x = [\ n * gamma /]}
proof
end;
::$P+
