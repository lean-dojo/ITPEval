:: Statement-only formalization of PutnamBench corpus artifact putnam_1999_a6:
:: every term of the specified recursively defined real sequence is an integer
:: multiple of its positive natural-number index. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NAT_D, NEWTON;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of NAT,REAL st
    a.1 = 1 &
    a.2 = 2 &
    a.3 = 24 &
    (for n being Nat st 4 <= n holds
      a.n =
        (6 * ((a.(n -' 1)) |^ 2) * a.(n -' 3) -
          8 * a.(n -' 1) * ((a.(n -' 2)) |^ 2)) /
        (a.(n -' 2) * a.(n -' 3)))
  holds
    for n being Nat st 1 <= n holds
      ex k being Integer st
        a.n = (k qua Real) * (n qua Real)
proof
end;
::$P+
