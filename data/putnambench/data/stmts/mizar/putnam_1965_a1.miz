:: Statement-only formalization of PutnamBench artifact putnam_1965_a1.
:: A noncollinear real-plane triangle with ordered angles and two specified
:: external-angle-bisector intersections has angle CAB equal to PI/15. This
:: file contains no proof.

environ

 vocabularies REAL_1, NAT_1, SUBSET_1, NUMBERS, CARD_1, RELAT_1, ARYTM_3,
      EUCLID, FINSEQ_2, COMPLEX1, ARYTM_1, SQUARE_1, RVSUM_1, FINSEQ_1,
      XXREAL_0, PRE_TOPC, STRUCT_0, SIN_COS, SIN_COS6, XBOOLE_0, RLTOPSP1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, COMPLEX1, REAL_1, STRUCT_0, PRE_TOPC, FINSEQ_1, FINSEQ_2,
      RVSUM_1, SQUARE_1, RLVECT_1, RLTOPSP1, EUCLID, XXREAL_0, SIN_COS,
      SIN_COS6;
 constructors REAL_1, SQUARE_1, BINOP_2, COMPLEX1, FINSEQOP, MONOID_0,
      RLTOPSP1, EUCLID, RELSET_1, BINOP_1, SIN_COS, SIN_COS6;
 registrations RELSET_1, NUMBERS, XREAL_0, BINOP_2, MEMBERED, MONOID_0,
      EUCLID, VALUED_0, VALUED_1, SQUARE_1, SIN_COS, SIN_COS6, ORDINAL1;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
 equalities SQUARE_1, RVSUM_1, EUCLID, VALUED_1;
 expansions XBOOLE_0, RVSUM_1;

begin

::$P-
theorem
  for A,B,C,X,Y being Point of TOP-REAL 2 st
    not (ex L being line of TOP-REAL 2 st A in L & B in L & C in L) &
    arccos (|(C-A,B-A)| / (|.C-A.| * |.B-A.|)) <
      arccos (|(B-C,A-C)| / (|.B-C.| * |.A-C.|)) &
    arccos (|(B-C,A-C)| / (|.B-C.| * |.A-C.|)) < PI / 2 &
    PI / 2 < arccos (|(A-B,C-B)| / (|.A-B.| * |.C-B.|)) &
    (ex L being line of TOP-REAL 2 st X in L & B in L & C in L) &
    arccos (|(X-A,B-A)| / (|.X-A.| * |.B-A.|)) =
      (PI - arccos (|(C-A,B-A)| / (|.C-A.| * |.B-A.|))) / 2 &
    |.A-X.| = |.A-B.| &
    (ex L being line of TOP-REAL 2 st Y in L & C in L & A in L) &
    arccos (|(Y-B,C-B)| / (|.Y-B.| * |.C-B.|)) =
      (PI - arccos (|(A-B,C-B)| / (|.A-B.| * |.C-B.|))) / 2 &
    |.B-Y.| = |.A-B.|
  holds arccos (|(C-A,B-A)| / (|.C-A.| * |.B-A.|)) = PI / 15
proof
end;
::$P+
