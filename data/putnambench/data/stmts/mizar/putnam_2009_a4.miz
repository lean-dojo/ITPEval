:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_a4:
:: the universal claim that the stated closure properties force a set of
:: rational numbers to contain every rational is false. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  not (for S being Subset of RAT st
    0 in S &
    (for x being Rational st x in S holds
      x + 1 in S & x - 1 in S) &
    (for x being Rational st x in S & x <> 0 & x <> 1 holds
      (1 qua Rational) / (x * (x - 1)) in S)
  holds for r being Rational holds r in S)
proof
end;
::$P+
