:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_b2:
:: the count of positive integers that are squares or lie a square distance
:: from a nearest square has asymptotic parameters (3/4,4/3), or no positive
:: asymptotic parameters exist. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4,
    POWER, ORDINAL1, ZFMISC_1, FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, FINSET_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON,
    NAT_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, XXREAL_2,
    POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, FINSET_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, SEQ_2,
    SEQM_3, SEQ_4, PREPOWER, BINOP_2, COMSEQ_2, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for S being Function of NAT,NAT st
    (for N being Nat holds
      S.N = card {i where i is Element of NAT :
        1 <= i & i <= N &
        ((ex x being Integer st i = x^2) or
         (ex w being Integer st
           (ex x being Integer st |.i - w^2.| = x^2) &
           (for v being Integer holds
             |.i - w^2.| <= |.i - v^2.|)))})
  holds
    ((for alpha,beta being Real holds
        (alpha = (3 qua Real) / 4 & beta = (4 qua Real) / 3 iff
          0 < alpha & 0 < beta &
          ex s being Real_Sequence st
            (for N being Nat holds
              s.N = (S.N qua Real) /
                ((N qua Real) to_power alpha)) &
            s is convergent & lim s = beta))
     or
     not ex alpha,beta being Real st
       0 < alpha & 0 < beta &
       ex s being Real_Sequence st
         (for N being Nat holds
           s.N = (S.N qua Real) /
             ((N qua Real) to_power alpha)) &
         s is convergent & lim s = beta)
proof
end;
::$P+
