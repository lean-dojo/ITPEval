:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_a6:
:: for some n at least 1995, three consecutive row sums occur among 3 by n
:: column-permutation matrices at least four times as often as equal row sums.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, RVSUM_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
    FINSEQ_2, MATRIX_0, MATRIX_1, FINSET_1, RVSUM_1;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    RVSUM_1, FINSEQOP, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    FINSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, VALUED_0, VALUED_1, RVSUM_1, MEMBERED,
    FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1, MATRIX_0;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  ex n being Nat, favorable,equal being finite set st
    n >= 1995 &
    favorable = {M where M is Matrix of 3,n,INT :
      (for j being Element of Seg n holds
        (for i being Element of Seg 3 holds
          M*(i,j) = 1 or M*(i,j) = 2 or M*(i,j) = 3) &
        (for i,k being Element of Seg 3 st i <> k holds
          M*(i,j) <> M*(k,j))) &
      (ex sums being Function of Seg 3,INT st
        (for i being Element of Seg 3 holds
          ex row being FinSequence of INT st
            len row = n &
            (for j being Nat st j in Seg n holds
              row.j = M*(i,j)) &
            sums.i = Sum row) &
        (ex a being Integer,
            i1,i2,i3 being Element of Seg 3 st
          i1 <> i2 & i1 <> i3 & i2 <> i3 &
          sums.i1 = a & sums.i2 = a + 1 & sums.i3 = a + 2))} &
    equal = {M where M is Matrix of 3,n,INT :
      (for j being Element of Seg n holds
        (for i being Element of Seg 3 holds
          M*(i,j) = 1 or M*(i,j) = 2 or M*(i,j) = 3) &
        (for i,k being Element of Seg 3 st i <> k holds
          M*(i,j) <> M*(k,j))) &
      (ex sums being Function of Seg 3,INT st
        (for i being Element of Seg 3 holds
          ex row being FinSequence of INT st
            len row = n &
            (for j being Nat st j in Seg n holds
              row.j = M*(i,j)) &
            sums.i = Sum row) &
        (ex a being Integer st
          for i being Element of Seg 3 holds sums.i = a))} &
    card favorable >= 4 * card equal
proof
end;
::$P+
