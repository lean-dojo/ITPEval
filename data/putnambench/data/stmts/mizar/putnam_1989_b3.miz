:: Statement-only formalization of PutnamBench corpus artifact putnam_1989_b3:
:: the moments of a differentiable real function satisfying a dilation
:: differential equation and exponential decay have an explicit finite-product
:: formula, and their factorial normalization converges with the stated
:: zero-limit consequence. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
      XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1, VALUED_0,
      VALUED_1, ORDINAL1, ORDINAL2, NEWTON, PREPOWER, POWER, SQUARE_1,
      SIN_COS, FINSEQ_1, FINSEQ_2, RVSUM_1, SEQ_1, SEQ_2, SEQ_4, FDIFF_1,
      FDIFF_12, RCOMP_1, LIMFUNC1, SUPINF_2, MEASURE1, MEASURE5, MESFUNC1,
      MESFUNC5, MEASUR12, INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, INT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_2, XXREAL_3,
      NAT_1, NEWTON, PREPOWER, POWER, SQUARE_1, SIN_COS, FINSEQ_1,
      FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
      SEQ_4, PARTFUN2, RCOMP_1, FDIFF_1, SUPINF_2, MEASURE1, MEASURE5,
      MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, LIMFUNC1,
      FDIFF_12;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      INT_1, XXREAL_0, NAT_1, NEWTON, PREPOWER, POWER, SQUARE_1,
      SIN_COS, FINSEQ_2, FINSEQ_4, FINSEQOP, RVSUM_1, SEQ_2, SEQM_3,
      SEQ_4, COMSEQ_2,
      PARTFUN2, RCOMP_1, RFUNCT_2, FDIFF_1, LIMFUNC1, FDIFF_12, MEASURE5,
      MEASURE6, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1,
      BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
      PREPOWER, POWER, SQUARE_1, SIN_COS, FINSEQ_1, FINSEQ_2, RVSUM_1,
      SEQ_4, RCOMP_1, FDIFF_1, XXREAL_3, MEASURE1, MEASURE5, MEASUR12;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for A being non empty Interval,
      f being Function of REAL,REAL,
      mu being Real_Sequence st
    A = right_closed_halfline 0 &
    f is_differentiable_on_interval A &
    (for x being Real st 0 < x holds
      diff(f,x) = -3 * f.x + 6 * f.(2*x)) &
    (for x being Real st x in A holds
      |.f.x.| <= exp_R.(-sqrt x)) &
    (for n being Nat holds
      ex g being Function of REAL,REAL st
        (for x being Real st x in A holds
          g.x = (x |^ n) * f.x) &
        mu.n = Integral(L-Meas,g|A))
  holds
    ex factorials being Real_Sequence st
      factorials.0 = 1 &
      (for n being Nat holds
        factorials.(n+1) =
          factorials.n * ((n+1) qua Real)) &
      (for n being Nat holds
        ex denominators being Real_Sequence st
          denominators.0 = 1 &
          (for m being Nat st m < n holds
            denominators.(m+1) =
              denominators.m *
                (1 - 2 to_power (-((m+1) qua Real)))) &
          mu.n =
            mu.0 * factorials.n /
              (((3 qua Real) |^ n) * denominators.n)) &
      ex s being Real_Sequence st
        (for n being Nat holds
          s.n =
            mu.n * ((3 qua Real) |^ n) / factorials.n) &
        s is convergent &
        (lim s = 0 implies mu.0 = 0)
proof
end;
::$P+
