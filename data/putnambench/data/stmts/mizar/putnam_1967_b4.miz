:: Statement-only formalization of PutnamBench artifact putnam_1967_b4:
:: toggling lockers numbered 1 through n at each divisor-indexed operation
:: leaves exactly the perfect-square lockers open. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, BINOP_1, BINOP_2, NUMBERS, NAT_1, INT_1, NEWTON, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, ARYTM_1, ARYTM_3, ORDINAL1,
    VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, NAT_1, NAT_D, INT_1, NEWTON, BINOP_1, BINOP_2;
  constructors RELSET_1, FUNCT_2, BINOP_1, BINOP_2, NAT_1, NAT_D,
    INT_1, NEWTON, REAL_1, XXREAL_0, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, NEWTON, VALUED_0, VALUED_1, MEMBERED;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM, REAL;

begin

::$P-
theorem
  for n being Nat
  for lockers being Function of [:NAT,NAT:],INT st
    1 <= n &
    (for i being Nat st 1 <= i & i <= n holds
      lockers.(0,i) = 0) &
    (for k,i being Nat st
      1 <= k & k <= n & 1 <= i & i <= n
      holds
        ((k divides i implies
            ((lockers.(k-'1,i) = 0 & lockers.(k,i) = 1) or
             (lockers.(k-'1,i) = 1 & lockers.(k,i) = 0))) &
         (not k divides i implies
            lockers.(k,i) = lockers.(k-'1,i))))
  holds
    for i being Nat st 1 <= i & i <= n holds
      (lockers.(n,i) = 1 iff
        ex j being Nat st j |^ 2 = i)
proof
end;
::$P+
