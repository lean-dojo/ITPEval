:: Statement-only formalization of PutnamBench corpus artifact putnam_1992_a2:
:: the integral involving the 1992nd Taylor coefficient of (1+x)^alpha
:: and the harmonic-type sum from 1 through 1992 equals 1992.
:: This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1, REALSET1, CARD_3,
    VALUED_0, VALUED_1, ORDINAL1,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL2, SEQ_4, RCOMP_1,
    FDIFF_1, TAYLOR_1, FINSEQ_1, FINSEQ_2, RVSUM_1, SUPINF_2,
    MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NAT_1, INT_1,
    NAT_D, NEWTON, FINSEQ_1, RVSUM_1, FINSEQ_2, VALUED_0, VALUED_1, RCOMP_1,
    FDIFF_1, PREPOWER, TAYLOR_1, SIN_COS, SUPINF_2, MEASURE1,
    MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NAT_D, NEWTON, NUMBERS, FINSEQOP, RVSUM_1, PREPOWER, RCOMP_1,
    FDIFF_1, TAYLOR_1,
    SIN_COS, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON, PREPOWER,
    FINSEQ_1, FINSEQ_2, RVSUM_1, RCOMP_1, XXREAL_3, MEASURE1,
    MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0, TAYLOR_1;
  equalities VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, RELAT_1, TAYLOR_1;

begin

::$P-
theorem
  for C being Function of REAL,REAL st
    (ex n being Nat st
      n = 1992 &
      for a being Real holds
        ex f being Function of REAL,REAL st
          (for x being Real st x in ].-1,1 .[ holds
            f.x = (1+x) #R a) &
          f is_differentiable_on n, ].-1,1 .[ &
          C.a = (diff(f,].-1,1 .[).n).0 / ((n !) qua Real))
  holds
    ex I being Subset of REAL,
       g being Function of REAL,REAL st
      I = {y where y is Real : 0 < y & y < 1} &
      (for y being Real st y in I holds
        ex terms being FinSequence of REAL st
          len terms = 1992 &
          (for k being Nat st 1 <= k & k <= 1992 holds
            terms.k = 1 / (y + (k qua Real))) &
          g.y = C.(-y-1) * Sum terms) &
      Integral(L-Meas,g|I) = 1992
proof
end;
::$P+
