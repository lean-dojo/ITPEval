:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_a2:
:: the midpoint locus from circles of radii 1 and 3 whose centers are 10
:: units apart is the closed annulus of radii 1 and 2 centered at the
:: midpoint of the centers. This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, REAL_1, RELAT_1, TARSKI, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, XBOOLE_0, RLTOPSP1, PRE_TOPC, EUCLID, METRIC_1,
      STRUCT_0;
 notations TARSKI, XBOOLE_0, SUBSET_1, XCMPLX_0, NUMBERS, XREAL_0, XXREAL_0,
      REAL_1, ORDINAL1, METRIC_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1,
      EUCLID, TOPREAL6;
 constructors REAL_1, RLTOPSP1, EUCLID, TOPREAL6;
 registrations XBOOLE_0, SUBSET_1, XXREAL_0, XREAL_0, STRUCT_0, EUCLID,
      ORDINAL1;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
 equalities EUCLID;

begin

::$P-
theorem
  for O1,O2 being Point of TOP-REAL 2,
      C1,C2 being Subset of TOP-REAL 2 st
    C1 = {P where P is Point of TOP-REAL 2 : dist(P,O1) = 1} &
    C2 = {P where P is Point of TOP-REAL 2 : dist(P,O2) = 3} &
    dist(O1,O2) = 10
  holds
    {M where M is Point of TOP-REAL 2 :
      ex X,Y being Point of TOP-REAL 2 st
        X in C1 & Y in C2 & M = 1/2 * (X + Y)}
    =
    {M where M is Point of TOP-REAL 2 :
      1 <= dist(M,1/2 * (O1 + O2)) &
      dist(M,1/2 * (O1 + O2)) <= 2}
proof
end;
::$P+
