:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_a2:
:: the improper integral of the difference of the two nested square-root
:: expressions converges for positive real a and b exactly when a = b. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
    LIMFUNC1, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, SQUARE_1, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0,
    VALUED_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1, LIMFUNC1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    SQUARE_1,
    NAT_1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, LIMFUNC1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, SQUARE_1, XXREAL_3,
    MEASURE1, MEASUR12;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for a,b being Real st 0 < a & 0 < b holds
    ((ex f,F being Function of REAL,REAL st
        (for x being Real holds
          f.x =
            sqrt (sqrt (x + a) - sqrt x) -
              sqrt (sqrt x - sqrt (x - b))) &
        (for t being Real holds
          ex I being Subset of REAL st
            I = {x where x is Real : b <= x & x <= t} &
            F.t = Integral(L-Meas,f|I)) &
        F is convergent_in+infty)
      iff a = b)
proof
end;
::$P+
