:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_b6:
:: for positive n and k, the number of permutations of 1 through n moving
:: every entry by at most k is odd exactly when n is congruent to 0 or 1
:: modulo 2*k+1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, NUMBERS, NAT_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3,
    INT_1, INT_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NAT_1, NAT_D, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    FINSET_1, CARD_1;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, VALUED_0,
    VALUED_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for n,k being Nat, limited being finite set st
    0 < n & 0 < k &
    limited = {p where p is FinSequence of NAT :
      p is Permutation of Seg n &
      (for i being Nat st i in Seg n holds
        p/.i -' i <= k & i -' p/.i <= k)}
  holds
    (card limited mod 2 = 1 iff
      n mod (2 * k + 1) = 0 or n mod (2 * k + 1) = 1)
proof
end;
::$P+
