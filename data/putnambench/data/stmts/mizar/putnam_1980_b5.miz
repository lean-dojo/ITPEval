:: Statement-only formalization of PutnamBench corpus artifact putnam_1980_b5:
:: closure under pointwise multiplication of nonnegative strictly increasing,
:: convex, continuous real functions on [0,1] satisfying a finite-difference
:: inequality is characterized by 0 <= t <= 1. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    PARTFUN1, FUNCT_2, NUMBERS, XREAL_0, REAL_1, NAT_1, CARD_1, ARYTM_1,
    ARYTM_3, XXREAL_0, XXREAL_1, RCOMP_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    VALUED_0, VALUED_1, STRUCT_0, METRIC_1, PRE_TOPC, TOPS_1, TOPS_2,
    TMAP_1, TOPMETR, RLVECT_1, RLTOPSP1, EUCLID, CONVEX1, COMPLEX1,
    SQUARE_1, SIN_COS, SIN_COS6;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, NAT_1, XXREAL_0, RCOMP_1, FINSEQ_1, FINSEQ_2, FINSEQOP,
    RVSUM_1, STRUCT_0, METRIC_1, PRE_TOPC, TOPS_2, TMAP_1, TOPMETR,
    TOPREAL6, RLVECT_1, RLTOPSP1, EUCLID, CONVEX1, COMPLEX1, SQUARE_1,
    SIN_COS, SIN_COS6;
  constructors REAL_1, RCOMP_1, FINSEQOP, RVSUM_1, BINOP_2, MONOID_0,
    METRIC_1, TOPMETR, TOPS_2, TMAP_1, RLTOPSP1, EUCLID, TOPREAL6,
    CONVEX1, COMPLEX1, SQUARE_1, SIN_COS, SIN_COS6, RELSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    ORDINAL1, NUMBERS, XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, VALUED_0,
    VALUED_1, STRUCT_0, PRE_TOPC, TOPMETR, TMAP_1, RLTOPSP1, EUCLID,
    CONVEX1, COMPLEX1, SQUARE_1, SIN_COS, SIN_COS6, BINOP_2, MEMBERED,
    MONOID_0;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI;
  equalities FINSEQ_1, RVSUM_1, STRUCT_0, RLVECT_1, EUCLID, SQUARE_1,
    VALUED_1;
  expansions TARSKI, XBOOLE_0, FINSEQ_1, FUNCT_1, RELAT_1, RVSUM_1;

begin

::$P-
theorem
  for t being Real st 0 <= t holds
    for S being set st
      S = {f where f is Function of REAL,REAL :
        (for x being Real st x in [.0,1.] holds 0 <= f.x) &
        (for x,y being Real st
          x in [.0,1.] & y in [.0,1.] & x < y
        holds f.x < f.y) &
        (for u,v,s being Real st
          u in [.0,1.] & v in [.0,1.] & s in [.0,1.]
        holds
          f.(s*u + (1-s)*v) <= s*f.u + (1-s)*f.v) &
        (for x being Real st x in [.0,1.] holds
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st 0 < delta &
              for y being Real st
                y in [.0,1.] & |.y-x.| < delta
              holds |.f.y-f.x.| < epsilon) &
        f.1 - 2*f.(2/3) + f.(1/3) >=
          t*(f.(2/3) - 2*f.(1/3) + f.0)}
    holds
      ((for f,g being Function of REAL,REAL st f in S & g in S
        holds f(#)g in S)
      iff t <= 1)
proof
end;
::$P+
