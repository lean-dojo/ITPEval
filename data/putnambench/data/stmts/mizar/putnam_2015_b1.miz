:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_b1
:: (putnambench__mizar__putnam_2015_b1): a three-times differentiable real
:: function with at least five distinct real zeros has at least two distinct
:: zeros of f + 6f' + 12f'' + 8f'''. This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, COMPLEX1, NEWTON,
    ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1, XXREAL_1,
    ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1, XBOOLE_0,
    SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, ORDINAL2, CARD_3,
    ABIAN, TAYLOR_2, NAT_1, FUNCT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RFUNCT_2, RCOMP_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NUMBERS,
    COMPLEX1, REAL_1, NAT_1, FUNCT_2, VALUED_1, SEQ_1, COMSEQ_2, SEQ_2,
    SERIES_1, FDIFF_1, SEQFUNC, NEWTON, SIN_COS, TAYLOR_1, ABIAN;
  constructors ARYTM_0, REAL_1, NAT_1, SEQ_2, RCOMP_1, RFUNCT_2,
    LIMFUNC1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN, TAYLOR_1, SEQFUNC,
    SERIES_1, VALUED_1, RELSET_1, COMSEQ_2;
  registrations RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, NEWTON, SIN_COS, INT_1,
    ORDINAL1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities XCMPLX_0, VALUED_1, SUBSET_1;
  expansions TAYLOR_1;
  theorems XBOOLE_1, ABSVALUE, PARTFUN1, XCMPLX_1, RELAT_1, RCOMP_1,
    SEQ_1, SEQ_2, SIN_COS, SERIES_1, FUNCT_1, RFUNCT_2, NAT_1, NEWTON,
    POWER, FDIFF_1, FDIFF_2, TAYLOR_1, SIN_COS2, XREAL_1, RFUNCT_1,
    ABIAN, COMPLEX1, XXREAL_0, VALUED_1, FUNCT_2, XREAL_0, ORDINAL1;
  schemes NAT_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    f is_differentiable_on 3, [#]REAL &
    (ex x1,x2,x3,x4,x5 being Real st
      x1 <> x2 & x1 <> x3 & x1 <> x4 & x1 <> x5 &
      x2 <> x3 & x2 <> x4 & x2 <> x5 &
      x3 <> x4 & x3 <> x5 & x4 <> x5 &
      f.x1 = 0 & f.x2 = 0 & f.x3 = 0 & f.x4 = 0 & f.x5 = 0)
  holds
    ex y1,y2 being Real st
      y1 <> y2 &
      f.y1 + 6 * (diff(f,[#]REAL).1).y1 +
        12 * (diff(f,[#]REAL).2).y1 +
        8 * (diff(f,[#]REAL).3).y1 = 0 &
      f.y2 + 6 * (diff(f,[#]REAL).1).y2 +
        12 * (diff(f,[#]REAL).2).y2 +
        8 * (diff(f,[#]REAL).3).y2 = 0
proof
end;
::$P+
