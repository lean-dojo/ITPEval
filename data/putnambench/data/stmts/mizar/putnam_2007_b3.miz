:: Statement-only formalization of PutnamBench corpus artifact putnam_2007_b3:
:: the 2007th term of the real sequence starting at one and recursively adding
:: three times its current term to the floor of sqrt(5) times that term has
:: the specified closed form. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, NAT_1, INT_1, VALUED_0, VALUED_1,
    ORDINAL1, ORDINAL2, NEWTON, PREPOWER, SEQ_1, SEQ_2, SEQ_4,
    SERIES_1, ABIAN, CARDFIN2, POWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, SQUARE_1, XXREAL_0, INT_1, NAT_1, NEWTON, VALUED_0,
    VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    SERIES_1, ABIAN, CARDFIN2, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    SQUARE_1, INT_1, NAT_1, NEWTON, SEQ_2, SEQM_3, SEQ_4, PREPOWER,
    COMSEQ_2, SERIES_1, BINOP_2, ABIAN, CARDFIN2, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON, PREPOWER,
    SEQ_4, SQUARE_1, ABIAN, CARDFIN2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Real_Sequence st
    x.0 = 1 &
    (for n being Nat holds
      x.(n + 1) =
        3 * x.n + ([\ x.n * sqrt 5 /] qua Real))
  holds
    x.2007 =
      (((2 qua Real) |^ 2006) / sqrt 5) *
        ((((1 + sqrt 5) / 2) |^ 4017) +
          (((1 + sqrt 5) / 2) to_power (-(4017 qua Real))))
proof
end;
::$P+
