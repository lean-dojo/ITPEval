:: Statement-only formalization of PutnamBench corpus artifact putnam_2014_b2
:: (putnambench__mizar__putnam_2014_b2): the greatest weighted integral
:: of f(x)/x on [1,3] among integrable real functions bounded between -1
:: and 1 with integral zero is ln(4/3). This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, SUPINF_2,
      MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5, SIN_COS,
      TAYLOR_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0,
      VALUED_1, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, TAYLOR_1;
 constructors RELSET_1, FUNCT_2, REAL_1, SIN_COS, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, TAYLOR_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, XXREAL_3, MEASURE1, MEASUR12, SIN_COS, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, TAYLOR_1;
 expansions TARSKI, XBOOLE_0, RELAT_1, TAYLOR_1;

begin

::$P-
theorem
  ex I being Subset of REAL st
    I = {x where x is Real : 1 <= x & x <= 3} &
    (ex f,g being Function of REAL,REAL st
      (for x being Real st x in I holds
        -1 <= f.x & f.x <= 1) &
      (for x being Real holds g.x = f.x / x) &
      f|I is_integrable_on L-Meas &
      g|I is_integrable_on L-Meas &
      Integral(L-Meas,f|I) = 0 &
      Integral(L-Meas,g|I) = ln.((4 qua Real) / 3)) &
    (for f,g being Function of REAL,REAL st
      (for x being Real st x in I holds
        -1 <= f.x & f.x <= 1) &
      (for x being Real holds g.x = f.x / x) &
      f|I is_integrable_on L-Meas &
      g|I is_integrable_on L-Meas &
      Integral(L-Meas,f|I) = 0
    holds
      Integral(L-Meas,g|I) <= ln.((4 qua Real) / 3))
proof
end;
::$P+
