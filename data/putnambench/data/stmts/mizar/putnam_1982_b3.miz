:: Statement-only formalization of PutnamBench corpus artifact putnam_1982_b3:
:: the probability that two independent uniform choices from 1 through n
:: have a perfect-square sum, multiplied by sqrt(n), converges to
:: (4/3)*(sqrt(2)-1). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, NAT_1, FINSET_1, FINSEQ_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2, SEQ_4,
    NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, FINSET_1, FINSEQ_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
    NEWTON;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, XXREAL_0, NAT_1, FINSET_1, FINSEQ_1, SEQ_2, SEQM_3,
    SEQ_4, BINOP_2, COMSEQ_2, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, FINSET_1, FINSEQ_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1,
    SEQ_4, FRAENKEL, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;

begin

::$P-
theorem
  for p being Real_Sequence st
    (for n being Nat holds
      ex pairs being finite set st
        pairs = {[c,d] where c,d is Element of Seg n :
          ex m being Nat st m |^ 2 = c + d} &
        p.n = (card pairs qua Real) / ((n qua Real) |^ 2))
  holds
    ex s being Real_Sequence st
      (for n being Nat holds
        s.n = p.n * sqrt(n qua Real)) &
      s is convergent &
      lim s = ((4 qua Real) / 3) * (sqrt 2 - 1)
proof
end;
::$P+
