:: Statement-only formalization of PutnamBench corpus artifact putnam_2018_a4
:: (putnambench__mizar__putnam_2018_a4): a floor-increment word relation in
:: an arbitrary group forces its two generating elements to commute. This
:: file contains no proof.

environ

 vocabularies NUMBERS, STRUCT_0, GROUP_1, SUBSET_1, GROUP_2, FINSET_1,
      INT_2, CARD_1, GRAPH_1, RELAT_1, TARSKI, ALGSTR_0, ZFMISC_1,
      PBOOLE, REALSET1, NEWTON, INT_1, ARYTM_3, GROUP_4, ARYTM_1,
      NAT_1, FINSEQ_1, FINSEQ_2, FUNCT_1, XXREAL_0, CQC_SIM1, XBOOLE_0,
      SETFAM_1, GROUP_8, RVSUM_1, XCMPLX_0, XREAL_0, REAL_1, ORDINAL1,
      VALUED_0, VALUED_1, BINOP_1, BINOP_2, SETWISEO, SETWOP_2,
      PARTFUN1;
 notations XBOOLE_0, CARD_1, TARSKI, ZFMISC_1, SUBSET_1, ORDINAL1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, XXREAL_0, RELAT_1, REALSET1,
      FUNCT_1, PARTFUN1, FUNCT_2, PBOOLE, INT_1, NAT_1, NAT_D, FINSET_1,
      GROUP_2, GROUP_4, GR_CY_1, FINSEQ_1, FINSEQ_2, DOMAIN_1, STRUCT_0,
      ALGSTR_0, GROUP_1, INT_2, BINOP_1, BINOP_2, SETWISEO, SETWOP_2,
      FINSEQOP, RVSUM_1, NEWTON;
 constructors WELLORD2, BINOP_1, REAL_1, NAT_D, BINOP_2, REALSET2,
      GROUP_4, GR_CY_1, RELSET_1, PARTFUN1, FINSEQ_2, RVSUM_1, FINSEQOP,
      NUMBERS, SETWISEO, SETWOP_2, FINSOP_1, FINSEQ_4, NEWTON;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, XXREAL_0, XREAL_0,
      XCMPLX_0, NUMBERS, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, STRUCT_0,
      GROUP_1, GROUP_2, GR_CY_1, ORDINAL1, FINSET_1, RVSUM_1, VALUED_0,
      VALUED_1, CARD_1, BINOP_2, PARTFUN1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, FUNCT_1, WELLORD2, FINSEQ_1, STRUCT_0;
 equalities REALSET1, ALGSTR_0, ORDINAL1;
 expansions TARSKI, STRUCT_0;
 theorems GROUP_2, GR_CY_1, GR_CY_2, NAT_1, TARSKI, XBOOLE_0, GROUP_1,
      CARD_1, GROUP_6, ALTCAT_1, FUNCT_2, GROUP_4, INT_2, XCMPLX_1,
      INT_1, FINSEQ_1, FUNCT_1, NEWTON, ORDINAL1, NAT_D, XXREAL_0,
      RELAT_1, PARTFUN1;
 schemes SUBSET_1, NAT_1, FINSEQ_1, FUNCT_2;

begin

::$P-
theorem
  for m,n being Nat,
      a being FinSequence of INT,
      G being Group,
      g,h being Element of G st
    0 < m & 0 < n &
    m gcd n = 1 &
    len a = n &
    (for k being Nat st k in Seg n holds
      a/.k =
        [\ ((m * k) qua Real) / (n qua Real) /] -
        [\ ((m * (k -' 1)) qua Real) / (n qua Real) /]) &
    (ex partial being FinSequence of the carrier of G st
      len partial = n + 1 &
      partial/.1 = 1_G &
      (for k being Nat st k in Seg n holds
        partial/.(k + 1) = partial/.k * g * (h |^ (a/.k))) &
      partial/.(n + 1) = 1_G)
  holds g * h = h * g
proof
end;
::$P+
