:: Statement-only formalization of PutnamBench artifact putnam_1970_b5:
:: continuity of a real function is equivalent to continuity of every
:: natural-level clamp composed with it. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, INT_1,
    NAT_1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL2, SEQ_4, PARTFUN1, FCONT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    INT_1, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PARTFUN1, PARTFUN2, FCONT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, INT_1, NAT_1,
    SEQ_2, SEQM_3, SEQ_4, PARTFUN1, PARTFUN2, FCONT_1, VALUED_1,
    BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, NAT_1, INT_1, MEMBERED,
    VALUED_0, VALUED_1, ORDINAL1, SEQ_4, FCONT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for ramp being Function of INT,Funcs(REAL,REAL),
      F being Function of REAL,REAL st
    (for n being Integer, x being Real holds
      (0 <= n implies
        (x <= -(n qua Real) implies
          (ramp.n).x = -(n qua Real)) &
        (-(n qua Real) < x & x <= (n qua Real) implies
          (ramp.n).x = x) &
        ((n qua Real) < x implies
          (ramp.n).x = (n qua Real))) &
      (n < 0 implies
        (x <= -(n qua Real) implies
          (ramp.n).x = -(n qua Real)) &
        (-(n qua Real) < x implies
          (ramp.n).x = (n qua Real))))
  holds
    (F is continuous iff
      for n being Nat,
          r being Function of REAL,REAL st r = ramp.n
      holds F * r is continuous)
proof
end;
::$P+
