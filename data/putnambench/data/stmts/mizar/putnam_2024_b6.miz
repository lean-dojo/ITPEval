:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_b6
:: (putnambench__mizar__putnam_2024_b6): the critical real exponent separating
:: zero and positive-infinity left limits of an exponential power series is
:: -1/2. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1,
    NEWTON, PREPOWER, POWER, SIN_COS, SEQ_1, SEQ_2, ORDINAL2, SEQ_4,
    SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XTUPLE_0, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NEWTON, NAT_1, VALUED_0,
    VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    POWER, SIN_COS, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, COMSEQ_2, POWER,
    SIN_COS, SERIES_1, ZFMISC_1, XTUPLE_0, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, POWER,
    SEQ_4, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for F being Function of [:REAL,REAL:],REAL,
      c being Real st
    (for a,x being Real st 0 <= x & x < 1 holds
      ex s being Real_Sequence st
        (for n being Nat holds
          s.n =
            ((n + 1) qua Real) to_power a *
            exp_R.(2 * ((n + 1) qua Real)) *
            (x |^ ((n + 1) |^ 2))) &
        Partial_Sums(s) is convergent &
        lim Partial_Sums(s) = F.([a,x]))
  holds
    (((for a being Real st a < c holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for x being Real st x < 1 & |.x - 1.| < delta holds
              |.F.([a,x]) * exp_R.(-1 / (1 - x)).| < epsilon) &
      (for a being Real st c < a holds
        for B being Real holds
          ex delta being Real st 0 < delta &
            for x being Real st x < 1 & |.x - 1.| < delta holds
              B < F.([a,x]) * exp_R.(-1 / (1 - x))))
    iff c = -(1 qua Real) / 2)
proof
end;
::$P+
