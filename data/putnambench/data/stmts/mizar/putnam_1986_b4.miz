:: Statement-only formalization of PutnamBench corpus artifact putnam_1986_b4:
:: the attained minimum distance from a real number to values
:: sqrt(m^2 + 2*n^2), for integers m,n, tends to zero at positive infinity.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for G being Function of REAL,REAL st
    (for r being Real holds
      ex m,n being Integer st
        G.r =
          |.r - sqrt(((m qua Real)^2) + 2 * ((n qua Real)^2)).|) &
    (for r being Real, m,n being Integer holds
      ex x,d being Real st
        x = G.r &
        d = |.r - sqrt(((m qua Real)^2) + 2 * ((n qua Real)^2)).| &
        x <= d)
  holds
    ((for e being Real st 0 < e holds
        ex B being Real st
          for r being Real st B <= r holds
            ex x being Real st x = G.r & |.x.| < e)
      iff 0 = 0)
proof
end;
::$P+
