:: Statement-only formalization of PutnamBench artifact putnam_1973_b1:
:: an indexed family of 2*n+1 integers is constant if, after any one index is
:: removed, the remaining integers split into equal-sum n-element parts.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    RVSUM_1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, FINSEQ_1,
    RVSUM_1, FINSEQ_2, NAT_1, FINSET_1;
  constructors REAL_1, NAT_1, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, FINSET_1,
    MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      a being FinSequence of INT st
    len a = 2*n + 1 &
    (for S being Subset of Seg (2*n + 1) st card S = 2*n holds
      ex T being Subset of S,
         left,right being FinSequence of INT st
        card T = n &
        len left = n &
        (for k being Nat st k in Seg n holds
          left.k = a.((Sgm T).k)) &
        len right = n &
        (for k being Nat st k in Seg n holds
          right.k = a.((Sgm (S \ T)).k)) &
        Sum left = Sum right)
  holds
    for i,j being Nat st
      i in Seg (2*n + 1) & j in Seg (2*n + 1)
    holds a.i = a.j
proof
end;
::$P+
