:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_b1:
:: every positive rational number is a quotient of finite products of
:: factorials of prime natural numbers. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3, REALSET1,
    VALUED_0, VALUED_1, NEWTON, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D, NEWTON, RAT_1;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    INT_2, NEWTON, RAT_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1, NEWTON, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for q being Rational st q > 0 holds
    ex pnum, pden being FinSequence of NAT,
       fnum, fden being FinSequence of RAT st
      len fnum = len pnum &
      len fden = len pden &
      (for i being Nat st i in dom pnum holds
        pnum.i is prime &
        fnum.i = ((pnum.i)!) qua Rational) &
      (for i being Nat st i in dom pden holds
        pden.i is prime &
        fden.i = ((pden.i)!) qua Rational) &
      q = (Product fnum) / (Product fden)
proof
end;
::$P+
