:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_b4:
:: no real 2 by 2 matrix has matrix sine equal to the matrix with rows
:: (1,1996) and (0,1). This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, FINSEQ_1, FINSEQ_2,
      FUNCT_1, FUNCT_2, MATRIX_1, NAT_1, NUMBERS, ORDINAL1, ORDINAL2,
      PARTFUN1, INT_1, SQUARE_1,
      RELAT_1, REAL_1, COMPLEX1, PREPOWER, SEQ_1, SEQ_2, SERIES_1,
      STRUCT_0, SUBSET_1, TARSKI,
      VALUED_0, VALUED_1, VECTSP_1, XBOOLE_0, XCMPLX_0, XREAL_0,
      XXREAL_0, XXREAL_2, NEWTON, POWER, ABIAN, RVSUM_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1,
      FUNCT_2, FINSEQ_1, STRUCT_0, FINSEQ_2, VALUED_0, VALUED_1,
      ALGSTR_0, VECTSP_1, MATRIX_0, MATRIX_1, NAT_1, NEWTON, PREPOWER,
      SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, ABIAN, XXREAL_2, POWER,
      RVSUM_1, SERIES_1;
 constructors RELSET_1, FUNCT_2, CARD_1, MATRIX_1, REAL_1, SQUARE_1,
      COMPLEX1, INT_1, XXREAL_0, NAT_1, NEWTON, PREPOWER, SEQ_2,
      SEQM_3, SEQ_4, ABIAN, BINOP_2, COMSEQ_2, POWER, RVSUM_1,
      SERIES_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      FINSEQ_1, FINSEQ_2, MATRIX_1, NAT_1, NUMBERS, ORDINAL1, VALUED_0,
      VALUED_1, VECTSP_1, XCMPLX_0, XREAL_0, XXREAL_0, MEMBERED,
      INT_1, SQUARE_1, NEWTON, PREPOWER, SEQ_4, ABIAN, RVSUM_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 equalities FINSEQ_1, MATRIX_0;

begin

::$P-
theorem
  not ex A being Matrix of 2,F_Real st
    ex
      p11,p12,p21,p22,fac,s11,s12,s21,s22 being Real_Sequence st
    p11.0 = 1 & p12.0 = 0 & p21.0 = 0 & p22.0 = 1 &
    (for n being Nat holds
      p11.(n+1) = A*(1,1) * p11.n + A*(1,2) * p21.n &
      p12.(n+1) = A*(1,1) * p12.n + A*(1,2) * p22.n &
      p21.(n+1) = A*(2,1) * p11.n + A*(2,2) * p21.n &
      p22.(n+1) = A*(2,1) * p12.n + A*(2,2) * p22.n) &
    fac.0 = 1 &
    (for n being Nat holds
      fac.(n+1) = ((n+1) qua Real) * fac.n) &
    (for n,k being Nat st k = 2*n+1 holds
      s11.n = (((-1) qua Real) |^ n) /
          fac.k * p11.k &
      s12.n = (((-1) qua Real) |^ n) /
          fac.k * p12.k &
      s21.n = (((-1) qua Real) |^ n) /
          fac.k * p21.k &
      s22.n = (((-1) qua Real) |^ n) /
          fac.k * p22.k) &
    Partial_Sums(s11) is convergent &
    Partial_Sums(s12) is convergent &
    Partial_Sums(s21) is convergent &
    Partial_Sums(s22) is convergent &
    lim Partial_Sums(s11) = 1 &
    lim Partial_Sums(s12) = 1996 &
    lim Partial_Sums(s21) = 0 &
    lim Partial_Sums(s22) = 1
proof
end;
::$P+
