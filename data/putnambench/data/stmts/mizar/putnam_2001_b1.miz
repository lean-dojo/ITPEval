:: Statement-only formalization of PutnamBench corpus artifact putnam_2001_b1:
:: on an even square grid numbered consecutively by rows, any two-coloring
:: balanced in every row and column has equal sums on the two colors.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, FINSET_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, RVSUM_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
    FINSEQ_2, MATRIX_0, MATRIX_1, FINSET_1, RVSUM_1;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    RVSUM_1, FINSEQOP, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    FINSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, VALUED_0, VALUED_1, RVSUM_1, MEMBERED,
    FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1, MATRIX_0;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for n being Nat,
      nums,colors being Matrix of n,INT st
    0 < n &
    n mod 2 = 0 &
    (for i,j being Nat st i in Seg n & j in Seg n holds
      nums*(i,j) = (((i -' 1) * n + j) qua Integer)) &
    (for i,j being Nat st i in Seg n & j in Seg n holds
      colors*(i,j) = 0 or colors*(i,j) = 1) &
    (for i being Nat st i in Seg n holds
      ex row being FinSequence of INT st
        len row = n &
        (for j being Nat st j in Seg n holds
          (colors*(i,j) = 0 & row.j = 1) or
          (colors*(i,j) = 1 & row.j = 0)) &
        Sum row = ((n div 2) qua Integer)) &
    (for j being Nat st j in Seg n holds
      ex col being FinSequence of INT st
        len col = n &
        (for i being Nat st i in Seg n holds
          (colors*(i,j) = 0 & col.i = 1) or
          (colors*(i,j) = 1 & col.i = 0)) &
        Sum col = ((n div 2) qua Integer))
  holds
    ex redSums,blackSums being FinSequence of INT st
      len redSums = n &
      len blackSums = n &
      (for i being Nat st i in Seg n holds
        ex redRow,blackRow being FinSequence of INT st
          len redRow = n &
          len blackRow = n &
          (for j being Nat st j in Seg n holds
            (colors*(i,j) = 0 &
              redRow.j = nums*(i,j) & blackRow.j = 0) or
            (colors*(i,j) = 1 &
              redRow.j = 0 & blackRow.j = nums*(i,j))) &
          redSums.i = Sum redRow &
          blackSums.i = Sum blackRow) &
      Sum redSums = Sum blackSums
proof
end;
::$P+
