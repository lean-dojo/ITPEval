:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_a2
:: (putnambench__mizar__putnam_2023_a2): a monic real polynomial of degree
:: 2*n with prescribed reciprocal values has exactly the two additional
:: solutions plus or minus 1/(n!). This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, CARD_1, RELAT_1, ARYTM_1, ARYTM_3,
      XXREAL_0, REAL_1, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4,
      FINSEQOP, FUNCT_1, CARD_3, ORDINAL4, TARSKI, ZFMISC_1,
      PARTFUN1, XBOOLE_0, HAHNBAN1, XCMPLX_0, COMPLFLD, SUPINF_2,
      COMPLEX1, GROUP_1, POWER, STRUCT_0, NAT_1, RLVECT_1, ALGSTR_0,
      VECTSP_1, BINOP_1, LATTICES, POLYNOM1, ALGSEQ_1, POLYNOM3,
      POLYNOM2, VECTSP_2, MESFUNC1, AFINSQ_1, FUNCT_4, CQC_LANG,
      CFCONT_1, FUNCOP_1, VALUED_1, FUNCT_2, SETWISEO, SETWOP_2,
      FINSOP_1, SEQ_4, XXREAL_2,
      COMSEQ_1, VALUED_0, SEQ_2, ORDINAL2, SEQ_1, COMPTRIG, RFINSEQ,
      POLYNOM5, FUNCT_7, ASYMPT_1, FDIFF_1, CFDIFF_1, NEWTON, ABIAN,
      INT_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, NUMBERS,
      XCMPLX_0,
      XXREAL_2, XREAL_0, COMPLEX1, REAL_1, POWER, BINOP_1, NAT_1,
      INT_1, RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCOP_1, SETWISEO,
      SETWOP_2, FINSOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4,
      FINSEQOP,
      POLYNOM1, RVSUM_1, STRUCT_0, ALGSTR_0, RLVECT_1, FUNCSDOM,
      VECTSP_2, VECTSP_1, RFINSEQ, CFCONT_1, VALUED_0, VALUED_1,
      SEQ_1, SEQ_2, SEQ_4, XXREAL_0, COMSEQ_1, COMSEQ_2, NAT_D,
      COMPLFLD, HAHNBAN1, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5,
      FUNCT_7, RECDEF_1, GROUP_1, CFDIFF_1, NEWTON, ABIAN;
 constructors FINSEQ_4, ENUMSET1, REAL_1, SEQ_4, FINSOP_1, SETWISEO,
      SETWOP_2, FINSEQOP, FINSEQ_2, FINSEQ_3, COMSEQ_2, RVSUM_1,
      CFCONT_1, RFINSEQ, NAT_D, FUNCSDOM, VECTSP_2, ALGSTR_1,
      MATRIX_1, HAHNBAN1, POLYNOM1, POLYNOM4, RECDEF_1, BINOP_2,
      POWER, SEQ_2, RELSET_1, FUNCT_7, FVSUM_1, ALGSEQ_1, POLYNOM5,
      ORDINAL1, SEQ_1, GROUP_1, CFDIFF_1, NEWTON, ABIAN;
 registrations FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, NAT_1, INT_1, MEMBERED, FINSEQ_1, FINSEQ_2,
      FINSEQ_3, FINSEQ_4, STRUCT_0,
      GROUP_1, VECTSP_1, COMPLFLD, ALGSTR_1, POLYNOM3, POLYNOM4,
      VALUED_0, VALUED_1, POLYNOM5, CARD_1, SEQ_2, CFUNCT_1, SEQ_1,
      RVSUM_1, CFDIFF_1, NEWTON, ABIAN, FRAENKEL;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, ALGSEQ_1, XBOOLE_0, ALGSTR_0, XXREAL_2, COMSEQ_2;
 equalities XBOOLE_0, RVSUM_1, POLYNOM3, HAHNBAN1, STRUCT_0, ALGSTR_0,
      XCMPLX_0, COMPLEX1;
 expansions TARSKI, ALGSEQ_1, COMSEQ_2;

begin

::$P-
theorem
  for n being Nat,
      p being Polynomial of F_Real st
    0 < n &
    n is even &
    len p = 2 * n + 1 &
    p.(2 * n) = 1.F_Real &
    (for m being Nat st 1 <= m & m <= n holds
      ex u,v being Element of F_Real st
        u = 1 / (m qua Real) &
        v = 1 / (-(m qua Real)) &
        eval(p,u) = ((m qua Real) |^ 2) &
        eval(p,v) = ((m qua Real) |^ 2))
  holds
    for x being Element of F_Real holds
      (x <> 0.F_Real &
       (ex y being Element of F_Real st
         y = 1 / x & eval(p,y) = x |^ 2) &
       not ex m being Nat st
         1 <= m & m <= n &
         (x = (m qua Real) or x = -(m qua Real)))
      iff
      x = 1 / ((Product Sgm (Seg n)) qua Real) or
      x = -(1 / ((Product Sgm (Seg n)) qua Real))
proof
end;
::$P+
