:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_a1
:: (putnambench__mizar__putnam_2025_a1): positive natural-number sequences
:: related by a rational recurrence have only finitely many indices where
:: the corresponding odd terms fail to be coprime. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, INT_2, NAT_1, ORDINAL1,
    FINSET_1, RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, FINSET_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, INT_2, COMPLEX1, XXREAL_0, NAT_1, NAT_D,
    RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, FINSET_1, REAL_1,
    COMPLEX1, INT_1, INT_2, XXREAL_0, NAT_1, NAT_D, ZFMISC_1, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, FINSET_1, XXREAL_0, MEMBERED, XCMPLX_0,
    XREAL_0, ORDINAL1, NAT_1, INT_1, INT_2, RAT_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for m,n being Function of NAT,NAT st
    (for k being Nat holds 0 < m.k) &
    (for k being Nat holds 0 < n.k) &
    m.0 <> n.0 &
    (for k being Nat st 0 < k holds m.k,n.k are_coprime) &
    (for k being Nat holds
      (m.(k+1) qua Rational) / (n.(k+1) qua Rational) =
        ((2 * m.k + 1) qua Rational) / ((2 * n.k + 1) qua Rational))
  holds
    {k where k is Element of NAT :
      not (2 * m.k + 1),(2 * n.k + 1) are_coprime} is finite
proof
end;
::$P+
