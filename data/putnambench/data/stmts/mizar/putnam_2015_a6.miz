:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_a6: positive-dimensional real square matrices A, B, and M with AM = MB and equal characteristic polynomials satisfy det(A-MX) = det(B-XM) for every real square matrix X. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, VECTSP_1, SUBSET_1, MATRIX_1, FINSEQ_2,
      ZFMISC_1, RELAT_1, TARSKI, CARD_1, ARYTM_3, FUNCT_1, FREEALG,
      FINSET_1, FINSEQ_1, MESFUNC1, GROUP_1, SUPINF_2, LAPLACE,
      XBOOLE_0, ARYTM_1, XXREAL_0, POLYNOM1, POLYNOM2, MATRIX_3,
      CARD_3, AFINSQ_1, ORDINAL4, POLYNOM3, STRUCT_0, PARTFUN1,
      RANKNULL, RLSUB_1, RLVECT_5, PRVECT_1, RLVECT_3, ALGSTR_0,
      VECTSP10, MATRLIN, MATRLIN2, POLYNOM5, NEWTON, MONOID_0,
      BINOP_1, RLVECT_1, LATTICES, RLSUB_2, FINSEQ_4, MCART_1,
      RLVECT_2, VALUED_1, FUNCT_2, VECTSP11, MSSUBFAM, UNIALG_1,
      NUMBER09, RING_1, FUNCSDOM, REALSET1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      CARD_1, XCMPLX_0, ALGSTR_0, XXREAL_0, FINSET_1, RELAT_1,
      FUNCT_1, PARTFUN1, FUNCT_2, NAT_1, FINSEQ_1, BINOP_1,
      STRUCT_0, RLVECT_1, GROUP_1, VECTSP_1, FINSEQ_2, MATRIX_0,
      MATRIX_1, NAT_D, GROUP_4, MATRIX_3, DOMAIN_1, MEASURE6,
      PRVECT_1, VECTSP_4, VECTSP_5, VECTSP_6, VECTSP_7, VECTSP_9,
      FINSEQOP, MATRIX_4, MATRIX13, MATRLIN, LAPLACE, MOD_2, RANKNULL,
      POLYNOM3, MONOID_0, ALGSEQ_1, POLYNOM4, POLYNOM5, MATRLIN2,
      RING_1;
 constructors FINSOP_1, GROUP_4, VECTSP_7, VECTSP_9, MATRIX_4, MATRIX13,
      REALSET1, LAPLACE, VECTSP_5, RANKNULL, MONOID_0, POLYNOM4,
      POLYNOM5, MATRLIN2, BINOP_2, RELSET_1, MATRIX_1, ALGSEQ_1,
      RING_1;
 registrations XBOOLE_0, FUNCT_1, FINSET_1, STRUCT_0, VECTSP_1,
      FUNCT_2, ORDINAL1, XXREAL_0, NAT_1, FINSEQ_1, FINSEQ_2,
      SEQM_3, MATRIX13, XREAL_0, VECTSP_9, RANKNULL, POLYNOM3,
      POLYNOM5, MONOID_0, CARD_1, RELSET_1, MOD_2, GRCAT_1,
      PRVECT_1, MATRLIN2, RING_1;
 requirements ARITHM, NUMERALS, REAL, BOOLE, SUBSET;
 definitions TARSKI, XBOOLE_0, RING_1;
 equalities STRUCT_0, RLVECT_1, FINSEQ_1, VECTSP_4, FVSUM_1,
      LAPLACE, MATRIX13, RANKNULL, VECTSP_6, MATRLIN2;
 expansions STRUCT_0, TARSKI, XBOOLE_0, VECTSP_4, RING_1;
 theorems ZFMISC_1, RLVECT_1, MATRIX_0, MATRIX_3, VECTSP_1, NAT_1,
      FINSEQ_1, FINSEQ_3, FINSEQ_2, CARD_1, CARD_2, FINSEQOP,
      FINSOP_1, FUNCT_1, FUNCT_2, FVSUM_1, GROUP_1, LAPLACE,
      MATRIX13, MATRIXR2, MATRLIN, ORDINAL1, PARTFUN1, RELAT_1,
      STIRL2_1, STRUCT_0, TARSKI, VECTSP_4, VECTSP_5, VECTSP_6,
      VECTSP_7, VECTSP_9, VECTSP10, XBOOLE_0, XBOOLE_1, XREAL_1,
      XXREAL_0, MOD_2, RANKNULL, MONOID_0, GROUP_4, SYSREL,
      SUBSET_1, FINSEQ_5, ALGSEQ_1, POLYNOM4, POLYNOM5, HILBASIS,
      MATRIXJ1, MATRLIN2, VALUED_0, NAT_D, RLVECT_2, MATRIX_1,
      FINSEQ_4, RING_1;
 schemes NAT_1, FUNCT_2;

begin

::$P-
theorem
  for n being Nat,
      A,B,M being Matrix of n,F_Real st
    0 < n &
    A * M = M * B &
    (ex CA,CB being Matrix of n,Polynom-Ring F_Real st
     ex pA,pB being Polynomial of F_Real st
      (for i,j being Nat st [i,j] in Indices CA holds
        (i = j implies CA*(i,j) = <% -(A*(i,j)), 1.F_Real %>) &
        (i <> j implies CA*(i,j) = <% -(A*(i,j)) %>)) &
      (for i,j being Nat st [i,j] in Indices CB holds
        (i = j implies CB*(i,j) = <% -(B*(i,j)), 1.F_Real %>) &
        (i <> j implies CB*(i,j) = <% -(B*(i,j)) %>)) &
      pA = Det CA &
      pB = Det CB &
      pA = pB)
  holds
    for X being Matrix of n,F_Real holds
      Det (A + -(M * X)) = Det (B + -(X * M))
proof
end;
::$P+
