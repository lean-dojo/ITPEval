:: Statement-only formalization of PutnamBench artifact putnam_1977_a1:
:: four distinct points on the real quartic y = 2*x^4 + 7*x^3 + 3*x - 5
:: that are collinear have average x-coordinate -7/8. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NEWTON;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x1,x2,x3,x4 being Real st
    x1 <> x2 & x1 <> x3 & x1 <> x4 &
    x2 <> x3 & x2 <> x4 & x3 <> x4 &
    (ex m,b being Real st
      2 * (x1 |^ 4) + 7 * (x1 |^ 3) + 3 * x1 - 5 = m * x1 + b &
      2 * (x2 |^ 4) + 7 * (x2 |^ 3) + 3 * x2 - 5 = m * x2 + b &
      2 * (x3 |^ 4) + 7 * (x3 |^ 3) + 3 * x3 - 5 = m * x3 + b &
      2 * (x4 |^ 4) + 7 * (x4 |^ 3) + 3 * x4 - 5 = m * x4 + b)
  holds (x1 + x2 + x3 + x4) / 4 = (-7) / 8
proof
end;
::$P+
