:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_b5:
:: the number of length-n strings of two signs whose every contiguous
:: substring has sign sum between -2 and 2. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FINSEQ_1,
    FINSEQ_2, NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, NEWTON, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, RVSUM_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, FINSEQ_1, FINSEQ_2, NEWTON, RVSUM_1;
  constructors REAL_1, NAT_1, NAT_D, NEWTON, RELSET_1, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, NEWTON,
    MEMBERED, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for n being Nat holds
    card {s where s is FinSequence of INT :
      len s = n &
      (for i being Nat st i in Seg n holds
        s.i = -1 or s.i = 1) &
      (for a,b being Nat st
        a in Seg n & b in Seg n & a <= b
      holds
        ex terms being FinSequence of INT st
          len terms = b -' a + 1 &
          (for k being Nat st k in Seg (b -' a + 1) holds
            terms.k = s.(a + k -' 1)) &
          -2 <= Sum terms & Sum terms <= 2)}
    = 2 |^ ((n + 2) div 2) + 2 |^ ((n + 1) div 2) - 2
proof
end;
::$P+
