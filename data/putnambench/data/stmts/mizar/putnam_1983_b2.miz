:: Statement-only formalization of PutnamBench corpus artifact putnam_1983_b2:
:: the number of representations of each positive integer as a sum of powers
:: of two, with each power used at most three times, is the floor of a real
:: polynomial at that integer. This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3, FUNCT_4,
      STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1, SUPINF_2,
      NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1, CARD_3,
      BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4, FINSEQ_2,
      VECTSP_2, ZFMISC_1, INT_1, NEWTON, FINSET_1, REALSET1, VALUED_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
      REAL_1, INT_1, NAT_1, NAT_D, NEWTON, VALUED_0, FINSEQ_1, FINSEQ_2,
      RVSUM_1, FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1,
      VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5,
      FINSET_1;
 constructors REAL_1, NAT_D, NEWTON, RVSUM_1, FINSEQOP, ALGSEQ_1,
      POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4, VECTSP_2, ALGSTR_1,
      FINSET_1;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      INT_1, VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON,
      VECTSP_2, ALGSTR_1, FRAENKEL, FINSET_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  for f being Function of NAT,NAT st
    (for n being Nat holds
      f.n = card {digits where digits is FinSequence of NAT :
        len digits = n &
        (for i being Nat st i in Seg n holds digits.i <= 3) &
        ex terms being FinSequence of NAT st
          len terms = n &
          (for i being Nat st i in Seg n holds
            terms.i = digits.i * (2 |^ (i -' 1))) &
          Sum terms = n})
  holds
    ex p being Polynomial of F_Real,
       g being Function of REAL,REAL st
      (for x being Element of F_Real holds g.x = eval(p,x)) &
      for n being Nat st 0 < n holds
        [\ g.(n qua Real) /] = f.n
proof
end;
::$P+
