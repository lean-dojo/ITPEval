:: Statement-only formalization of PutnamBench artifact putnam_1968_a3:
:: every finite set has an ordering of all its subsets, beginning with the
:: empty set, in which adjacent subsets differ by one element.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1, ZFMISC_1, FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FINSET_1, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1,
    NEWTON, RELAT_1, FUNCT_1, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    NEWTON, VALUED_0, VALUED_1, CARD_1, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A being finite set holds
    ex p being FinSequence of bool A st
      p.1 = {} &
      (for B being Subset of A holds
        ex i being Nat st
          i in dom p & p.i = B &
          (for j being Nat st j in dom p & p.j = B holds j = i)) &
      (for i being Nat st i in dom p & i + 1 in dom p holds
        ex a being object st
          a in A &
          ((not a in p.i & p.(i + 1) = p.i \/ {a}) or
           (not a in p.(i + 1) & p.i = p.(i + 1) \/ {a})))
proof
end;
::$P+
