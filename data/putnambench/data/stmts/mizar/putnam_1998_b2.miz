:: Statement-only formalization of PutnamBench corpus artifact putnam_1998_b2:
:: for 0 < b < a, the infimum perimeter of the specified triangle is
:: sqrt(2*a^2 + 2*b^2). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b being Real st 0 < b & b < a holds
    (for c,x being Real st
      sqrt((a-c)^2 + (b-0)^2) + sqrt((c-x)^2 + (0-x)^2) >
        sqrt((a-x)^2 + (b-x)^2) &
      sqrt((a-c)^2 + (b-0)^2) + sqrt((a-x)^2 + (b-x)^2) >
        sqrt((c-x)^2 + (0-x)^2) &
      sqrt((c-x)^2 + (0-x)^2) + sqrt((a-x)^2 + (b-x)^2) >
        sqrt((a-c)^2 + (b-0)^2)
    holds
      sqrt(2*a^2 + 2*b^2) <=
        sqrt((a-c)^2 + (b-0)^2) +
        sqrt((c-x)^2 + (0-x)^2) +
        sqrt((a-x)^2 + (b-x)^2)) &
    (for epsilon being Real st 0 < epsilon holds
      ex c,x being Real st
        sqrt((a-c)^2 + (b-0)^2) + sqrt((c-x)^2 + (0-x)^2) >
          sqrt((a-x)^2 + (b-x)^2) &
        sqrt((a-c)^2 + (b-0)^2) + sqrt((a-x)^2 + (b-x)^2) >
          sqrt((c-x)^2 + (0-x)^2) &
        sqrt((c-x)^2 + (0-x)^2) + sqrt((a-x)^2 + (b-x)^2) >
          sqrt((a-c)^2 + (b-0)^2) &
        sqrt((a-c)^2 + (b-0)^2) +
          sqrt((c-x)^2 + (0-x)^2) +
          sqrt((a-x)^2 + (b-x)^2) <
            sqrt(2*a^2 + 2*b^2) + epsilon)
proof
end;
::$P+
