:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_b5
:: (putnambench__mizar__putnam_2008_b5): the continuously differentiable real
:: functions mapping each rational to a rational with the same reduced
:: denominator are exactly the integer translates of x and -x.
:: This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1, INT_1, NAT_1,
    RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, FDIFF_1, COMPLEX1, NAT_1, INT_1, RAT_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2, INT_1, RAT_1;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    FCONT_1, ORDINAL1, XCMPLX_0, INT_1, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of REAL,REAL holds
    ((ex d being Function of REAL,REAL st
        f is_differentiable_on [#]REAL &
        d is continuous &
        for x being Real holds d.x = diff(f,x)) &
      (for q being Rational holds
        ex p being Rational st
          p = f.q &
          denominator(p) = denominator(q)))
    iff
      ex n being Integer st
        (for x being Real holds
          f.x = x + (n qua Real)) or
        (for x being Real holds
          f.x = -x + (n qua Real))
proof
end;
::$P+
