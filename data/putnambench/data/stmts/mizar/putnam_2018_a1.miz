:: Statement-only formalization of PutnamBench corpus artifact putnam_2018_a1:
:: the positive integer solutions of 1/a + 1/b = 3/2018 are exactly six
:: specified ordered pairs. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, NAT_1, CARD_1, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, REAL_1, XXREAL_0, NAT_1;
  constructors CARD_1, REAL_1, XXREAL_0, NAT_1;
  registrations XBOOLE_0, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b being Element of REAL holds
    (a in NAT & b in NAT & a <> 0 & b <> 0 &
      1 / a + 1 / b = 3 / 2018
    iff
      (a = 673 & b = 1358114) or
      (a = 674 & b = 340033) or
      (a = 1009 & b = 2018) or
      (a = 2018 & b = 1009) or
      (a = 340033 & b = 674) or
      (a = 1358114 & b = 673))
proof
end;
::$P+
