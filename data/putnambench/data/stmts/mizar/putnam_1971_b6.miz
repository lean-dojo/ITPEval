:: Statement-only formalization of PutnamBench artifact putnam_1971_b6:
:: the greatest-odd-divisor sum over the positive integers through x differs
:: from 2x/3 by less than one. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, ABIAN, COMPLEX1, REAL_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, FUNCT_2,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D, ABIAN, REAL_1, COMPLEX1;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    FUNCT_2, ABIAN, COMPLEX1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for delta being Function of NAT,NAT st
    (for n being Nat st 0 < n holds
      delta.n divides n &
      delta.n is odd &
      (for t being Nat st t divides n & t is odd holds t <= delta.n))
  holds
    for x being Nat, terms being FinSequence of REAL st
      0 < x &
      len terms = x &
      (for i being Nat st i in Seg x holds
        terms.i = (delta.i qua Real) / (i qua Real))
    holds
      |.Sum terms - 2 * (x qua Real) / 3.| < 1
proof
end;
::$P+
