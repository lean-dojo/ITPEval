:: Statement-only formalization of PutnamBench artifact putnam_1973_a4:
:: the real function x |-> 2^x - 1 - x^2 has exactly three zeros on the
:: real line. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4,
    POWER, ABIAN, ORDINAL1, SERIES_1, RVSUM_1, FINSEQ_1, SUPINF_2,
    MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON,
    NAT_1, FINSEQ_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
    PREPOWER, ABIAN, XXREAL_2, POWER, RVSUM_1, SERIES_1, VALUED_0,
    VALUED_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6,
    MEASUR12, INTEGRA5, EXTREAL1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER,
    ABIAN, BINOP_2, COMSEQ_2, POWER, RVSUM_1, SERIES_1, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN, FINSEQ_1, RVSUM_1, XXREAL_3, MEASURE1,
    MEASUR12;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  card {x where x is Real :
    2 to_power x - 1 - x*x = 0} = 3
proof
end;
::$P+
