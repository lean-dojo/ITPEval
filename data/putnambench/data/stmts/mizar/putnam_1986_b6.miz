:: Statement-only formalization of PutnamBench corpus artifact putnam_1986_b6:
:: over an arbitrary field, four square matrices satisfying two symmetry
:: conditions and a block identity satisfy the transposed identity.
:: This file contains no proof.

environ

 vocabularies ORDINAL1, XCMPLX_0, XBOOLE_0, NAT_1, VECTSP_1, SUBSET_1,
      MATRIX_1, REWRITE1, RELAT_1, MESFUNC1, ALGSTR_0, ARYTM_1,
      FINSEQ_1, TREES_1, ARYTM_3, SUPINF_2, XXREAL_0, CARD_1,
      QC_LANG1, ZFMISC_1, RELAT_2, BINOP_1, FUNCOP_1, GROUP_1,
      MATRIX_6, FUNCSDOM, MATRIX_0;
 notations XCMPLX_0, XBOOLE_0, TARSKI, ZFMISC_1, ORDINAL1, NUMBERS,
      FINSEQ_1, RLVECT_1, GROUP_1, VECTSP_1, MATRIX_0, STRUCT_0,
      MATRIX_1, MATRIX_3, MATRIX_4, XXREAL_0;
 constructors ORDINAL1, XCMPLX_0, NAT_1, XBOOLE_0, XXREAL_0, FVSUM_1,
      MATRIX_3, MATRIX_4, MATRIX_1;
 registrations XCMPLX_0, XBOOLE_0, RELSET_1, XREAL_0, STRUCT_0,
      FINSEQ_1, VECTSP_1, NAT_1, ORDINAL1, MATRIX_0, MATRIX_1,
      MATRIX_4;
 equalities MATRIX_4;
 requirements NUMERALS, BOOLE, SUBSET;

begin

::$P-
theorem
  for n being Nat, K being Field,
      A,B,C,D being Matrix of n,K st
    n > 0 &
    A * (B@) = (A * (B@))@ &
    C * (D@) = (C * (D@))@ &
    A * (D@) - B * (C@) = 1.(K,n)
  holds
    (A@) * D - (C@) * B = 1.(K,n)
proof
end;
::$P+
