:: Statement-only formalization of PutnamBench corpus artifact putnam_1984_b3:
:: every finite set with at least two elements admits a right-cancellative
:: binary operation that is nonassociative on every triple. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FINSET_1, CARD_1, NUMBERS, NAT_1, XCMPLX_0, XXREAL_0,
    ARYTM_1, ARYTM_3, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XXREAL_0, NAT_1, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, FINSET_1, CARD_1,
    XXREAL_0, NAT_1, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    FINSET_1, ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, NAT_1;
  requirements SUBSET, BOOLE, NUMERALS, ARITHM;

begin

::$P-
theorem
  for F being finite set st card F >= 2 holds
    ex op being Function of [:F,F:],F st
      for x,y,z being Element of F holds
        (op.(x,z) = op.(y,z) implies x = y) &
        op.(x,op.(y,z)) <> op.(op.(x,y),z)
proof
end;
::$P+
