:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_b1:
:: a rational root of an integer polynomial makes each successive truncated
:: coefficient-power sum an integer. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0,
    VALUED_1, FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4, BINOP_1,
    BINOP_2, FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, RAT_1, NEWTON, PREPOWER;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, NAT_D, PARTFUN1,
    BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP, SETWOP_2,
    RVSUM_1, RAT_1, NEWTON, PREPOWER;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NAT_1, NAT_D, BINOP_1, SETWISEO,
    BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2,
    XXREAL_1, FINSEQ_2, RVSUM_1, ZFMISC_1, RAT_1, NEWTON, PREPOWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1, RAT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      c being FinSequence of INT,
      x being Real st
    (ex a,b being Integer st
      b <> 0 &
      (b qua Real) * x = (a qua Real)) &
    len c = n + 1 &
    c.(n + 1) <> 0 &
    (ex rootTerms being FinSequence of REAL st
      len rootTerms = n + 1 &
      (for k being Nat st k in Seg (n + 1) holds
        rootTerms.k =
          (c.k qua Real) * (x |^ (k -' 1))) &
      Sum rootTerms = 0)
  holds
    for k being Nat st k in Seg n holds
      ex terms being FinSequence of REAL st
        len terms = k &
        (for j being Nat st j in Seg k holds
          terms.j =
            (c.(n + 2 -' j) qua Real) *
            (x |^ (k + 1 -' j))) &
        Sum terms in INT
proof
end;
::$P+
