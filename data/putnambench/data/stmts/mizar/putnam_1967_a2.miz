:: Statement-only formalization of PutnamBench artifact putnam_1967_a2:
:: the numbers of symmetric nonnegative-integer matrices with every column
:: sum equal to one satisfy a recurrence and have the stated exponential
:: generating function. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1, NUMBERS, NAT_1,
    CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, XXREAL_2, COMPLEX1, SQUARE_1,
    ORDINAL1, ORDINAL2, FINSET_1, NEWTON, PREPOWER, SEQ_4, ABIAN,
    ARYTM_1, ARYTM_3, VALUED_0, VALUED_1, SEQ_1, SEQ_2, SERIES_1,
    SIN_COS, INT_1, FVSUM_1, RVSUM_1, BINOP_1, BINOP_2, SETWISEO,
    SETWOP_2, POWER;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, XXREAL_2, REAL_1, COMPLEX1, SQUARE_1,
    NAT_1, NAT_D, INT_1, RELAT_1,
    BINOP_1, BINOP_2, SETWISEO, SETWOP_2,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2,
    FINSEQOP, MATRIX_0, MATRIX_1, FINSET_1, CARD_1, NEWTON, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, SERIES_1,
    SIN_COS, RVSUM_1, POWER;
  constructors REAL_1, NUMBERS, RELSET_1, PARTFUN1, FUNCT_2, BINOP_1,
    BINOP_2, SETWISEO, SETWOP_2, FINSOP_1, FINSEQOP, FINSEQ_4, MATRIX_1,
    NAT_1, NAT_D, NEWTON, INT_1, XXREAL_0, COMPLEX1, SQUARE_1, SEQ_2,
    SEQM_3, SEQ_4, PREPOWER, ABIAN, COMSEQ_2, SERIES_1, SIN_COS,
    RVSUM_1, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, NEWTON, VALUED_0, VALUED_1, MEMBERED, FRAENKEL, BINOP_2,
    RVSUM_1, SQUARE_1, PREPOWER, SEQ_4, ABIAN, SEQ_1, SIN_COS;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for S being Function of NAT,INT st
    S.0 = 1 &
    (for n being Nat st 1 <= n holds
      S.n = card {A where A is Matrix of n,NAT :
        (for i,j being Nat st i in Seg n & j in Seg n holds
          A*(i,j) = A*(j,i)) &
        (for j being Nat st j in Seg n holds
          ex c being FinSequence of NAT st
            c = Col(A,j) & addnat $$ c = 1)})
  holds
    (for n being Nat st 1 <= n holds
      S.(n+1) = S.n + n * S.(n-'1)) &
    (for x being Element of REAL holds
      ex s being Real_Sequence st
        (for n being Nat holds
          ex f being FinSequence of NAT st
            len f = n &
            (for i being Nat st i in Seg n holds f.i = i) &
            s.n = S.n * (x |^ n) / (multnat $$ f)) &
        Partial_Sums(s) is convergent &
        lim Partial_Sums(s) = exp_R.(x + (x |^ 2) / 2))
proof
end;
::$P+
