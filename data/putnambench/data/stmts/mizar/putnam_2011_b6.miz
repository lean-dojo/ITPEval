:: Statement-only formalization of PutnamBench corpus artifact putnam_2011_b6:
:: for every odd prime p, at least (p+1) div 2 natural numbers n below p
:: make the sum from k = 0 to p-1 of k! times n^k not divisible by p.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3,
    VALUED_0, VALUED_1, NEWTON, ABIAN, ZFMISC_1, FINSET_1, REALSET1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    FINSET_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2,
    RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NEWTON,
    NAT_1, NAT_D, ABIAN, WSIERP_1;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2, ABIAN, WSIERP_1, FINSET_1, CARD_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED, NEWTON,
    ABIAN, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p being Nat st p is prime & p is odd holds
    (p + 1) div 2 c= card {n where n is Element of NAT :
      n < p &
      ex terms being FinSequence of NAT st
        len terms = p &
        (for k being Nat st k < p holds
          terms.(k + 1) = (k !) * (n |^ k)) &
        not (p divides Sum terms)}
proof
end;
::$P+
