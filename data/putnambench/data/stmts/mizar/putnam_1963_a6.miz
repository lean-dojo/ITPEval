:: Statement-only formalization of PutnamBench artifact putnam_1963_a6:
:: three distinct chords of an ellipse share the midpoint of one chord, and
:: the induced intersections on its line have that same midpoint. This file
:: contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, REAL_1, RELAT_1, TARSKI, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, XBOOLE_0, RLTOPSP1, PRE_TOPC, EUCLID, METRIC_1,
      STRUCT_0, FUNCT_1, FUNCT_2, ZFMISC_1, SQUARE_1, ORDINAL1, BINOP_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, XCMPLX_0, NUMBERS, XREAL_0, XXREAL_0,
      REAL_1, ORDINAL1, METRIC_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1,
      EUCLID, TOPREAL6, FUNCT_1, FUNCT_2, BINOP_1, ZFMISC_1, SQUARE_1;
 constructors REAL_1, RLTOPSP1, EUCLID, TOPREAL6, FUNCT_2, BINOP_1, SQUARE_1,
      RELSET_1;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XXREAL_0, XREAL_0, STRUCT_0,
      EUCLID, FUNCT_2, ORDINAL1;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
 equalities BINOP_1, EUCLID;

begin

::$P-
theorem
  for F1,F2,U,V,A,B,C,D,P,Q being Point of TOP-REAL 2
  for r being Real
  for E being Subset of TOP-REAL 2
  for M being Point of TOP-REAL 2 st
    E = {H where H is Point of TOP-REAL 2 :
      dist(F1,H) + dist(F2,H) = r} &
    M = 1/2 * (U + V) &
    r > dist(F1,F2) &
    U in E & V in E & U <> V &
    A in E & B in E & A <> B &
    C in E & D in E & C <> D &
    A <> C & B <> D &
    LSeg(A,B) <> LSeg(U,V) &
    LSeg(C,D) <> LSeg(U,V) &
    LSeg(A,B) <> LSeg(C,D) &
    M in LSeg(A,B) & M in LSeg(C,D) &
    (ex L being line of TOP-REAL 2 st P in L & A in L & C in L) &
    (ex L being line of TOP-REAL 2 st P in L & U in L & V in L) &
    (ex L being line of TOP-REAL 2 st Q in L & B in L & D in L) &
    (ex L being line of TOP-REAL 2 st Q in L & U in L & V in L)
  holds M = 1/2 * (P + Q)
proof
end;
::$P+
