:: Statement-only formalization of PutnamBench corpus artifact putnam_2003_a3:
:: the minimum over real x of the absolute value of the sum of sine, cosine,
:: tangent, and their reciprocals is 2 * sqrt(2) - 1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1, SIN_COS,
    SIN_COS4;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0, SIN_COS, SIN_COS4;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0, SIN_COS, SIN_COS4;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  (for x being Real holds
    |.sin(x) + cos(x) + tan(x) + 1 / tan(x) +
      1 / cos(x) + 1 / sin(x).| >= 2 * sqrt 2 - 1) &
  (ex x being Real st
    |.sin(x) + cos(x) + tan(x) + 1 / tan(x) +
      1 / cos(x) + 1 / sin(x).| = 2 * sqrt 2 - 1)
proof
end;
::$P+
