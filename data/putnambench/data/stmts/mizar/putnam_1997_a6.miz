:: Statement-only formalization of PutnamBench corpus artifact putnam_1997_a6:
:: the recursively defined real sequence at the largest parameter making its
:: (n+1)-st term zero has binomial-coefficient values. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NAT_D, NEWTON;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      maxc being Real,
      X being Function of REAL,Funcs(NAT,REAL) st
    0 < n &
    (for c being Real,
         s being Function of NAT,REAL st s = X.c holds
      s.0 = 0 &
      s.1 = 1 &
      for k being Nat holds
        s.(k + 2) =
          (c * s.(k + 1) - ((n -' k) qua Real) * s.k) /
          ((k + 1) qua Real)) &
    (ex s being Function of NAT,REAL st
      s = X.maxc & s.(n + 1) = 0) &
    (for c being Real,
         s being Function of NAT,REAL st
      s = X.c & s.(n + 1) = 0
    holds c <= maxc)
  holds
    for s being Function of NAT,REAL st s = X.maxc holds
      for k being Nat st 1 <= k & k <= n holds
        s.k = (((n -' 1) choose (k -' 1)) qua Real)
proof
end;
::$P+
