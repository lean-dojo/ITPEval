:: Statement-only formalization of PutnamBench corpus artifact putnam_2022_b1
:: (putnambench__mizar__putnam_2022_b1): an integer polynomial with zero
:: constant coefficient and odd linear coefficient has an exponential power
:: series whose every real coefficient is nonzero. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL2, ORDINAL4, BINOP_1,
    BINOP_2, FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, NEWTON, PREPOWER, SEQ_1, SEQ_2, SEQ_4,
    SERIES_1, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, NAT_1, NAT_D, PARTFUN1,
    BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP, SETWOP_2,
    RVSUM_1, NEWTON, PREPOWER, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
    SEQ_4, SERIES_1, SIN_COS;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    COMPLEX1, INT_1, NAT_1, NAT_D, BINOP_1, SETWISEO, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, XXREAL_1,
    FINSEQ_2, RVSUM_1, ZFMISC_1, NEWTON, PREPOWER, SEQ_2, SEQM_3,
    SEQ_4, COMSEQ_2, SERIES_1, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1, NEWTON, PREPOWER, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p being Function of NAT,INT,
      b being Real_Sequence st
    p.0 = 0 &
    (ex q being Integer st p.1 = 2 * q + 1) &
    (ex d being Nat st
      (for n being Nat st d < n holds p.n = 0) &
      for x being Real holds
        ex polynomialTerms being FinSequence of REAL,
           powerTerms being Real_Sequence st
          len polynomialTerms = d + 1 &
          (for i being Nat st i in Seg (d + 1) holds
            polynomialTerms.i =
              (p.(i -' 1) qua Real) * (x |^ (i -' 1))) &
          (for n being Nat holds
            powerTerms.n = b.n * (x |^ n)) &
          Partial_Sums(powerTerms) is convergent &
          lim Partial_Sums(powerTerms) = exp_R.(Sum polynomialTerms))
  holds
    for k being Nat holds b.k <> 0
proof
end;
::$P+
