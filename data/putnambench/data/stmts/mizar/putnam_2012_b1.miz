:: Statement-only formalization of PutnamBench corpus artifact putnam_2012_b1:
:: a class of functions from the nonnegative reals to themselves that contains
:: exp(x)-1 and ln(x+1) and is closed under addition, composition, and
:: nonnegative subtraction is closed under multiplication. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    SQUARE_1, NEWTON, PREPOWER, POWER, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MEASUR12, INTEGRA5, SIN_COS, TAYLOR_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, NAT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, SQUARE_1,
    NEWTON, PREPOWER, POWER, VALUED_0, VALUED_1, SIN_COS, SUPINF_2,
    MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, TAYLOR_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, SQUARE_1, NEWTON, PREPOWER, POWER, SIN_COS, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, BINOP_2,
    TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    POWER, SQUARE_1, XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities SQUARE_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for D being non empty Subset of REAL, S being set st
    D = {x where x is Real : 0 <= x} &
    S c= Funcs(D,D) &
    (ex f1 being Function of D,D st
      f1 in S &
      for x being Element of D holds
        f1.x = exp_R.(x qua Real) - 1) &
    (ex f2 being Function of D,D st
      f2 in S &
      for x being Element of D holds
        f2.x = ln.((x qua Real) + 1)) &
    (for f,g being Function of D,D st f in S & g in S holds
      ex h being Function of D,D st
        h in S &
        for x being Element of D holds h.x = f.x + g.x) &
    (for f,g being Function of D,D st f in S & g in S holds
      ex h being Function of D,D st
        h in S &
        for x being Element of D holds h.x = f.(g.x)) &
    (for f,g being Function of D,D st
      f in S & g in S &
      (for x being Element of D holds f.x >= g.x)
    holds
      ex h being Function of D,D st
        h in S &
        for x being Element of D holds h.x = f.x - g.x)
  holds
    for f,g being Function of D,D st f in S & g in S holds
      ex h being Function of D,D st
        h in S &
        for x being Element of D holds h.x = f.x * g.x
proof
end;
::$P+
