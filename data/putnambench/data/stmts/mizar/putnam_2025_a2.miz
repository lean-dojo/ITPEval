:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_a2
:: (putnambench__mizar__putnam_2025_a2): the greatest coefficient in the
:: quadratic lower bound for sine on [0,PI] is 1/PI, and the least coefficient
:: in the corresponding upper bound is 4/PI^2. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_1, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, COMPLEX1,
    XXREAL_0, SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, COMPLEX1, XXREAL_0,
    SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b being Real holds
    (a = 1 / PI & b = 4 / (PI * PI) iff
      ((for x being Real st 0 <= x & x <= PI holds
          a * x * (PI - x) <= sin(x)) &
       (for a1 being Real st
          (for x being Real st 0 <= x & x <= PI holds
            a1 * x * (PI - x) <= sin(x))
        holds a1 <= a) &
       (for x being Real st 0 <= x & x <= PI holds
          sin(x) <= b * x * (PI - x)) &
       (for b1 being Real st
          (for x being Real st 0 <= x & x <= PI holds
            sin(x) <= b1 * x * (PI - x))
        holds b <= b1)))
proof
end;
::$P+
