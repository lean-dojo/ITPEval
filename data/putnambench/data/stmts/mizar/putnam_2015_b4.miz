:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_b4
:: (putnambench__mizar__putnam_2015_b4): the sum of 2^a/(3^b 5^c) over
:: positive integer triples that are side lengths of a triangle is 17/21.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL2, SEQ_4, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, FINSEQOP, ZFMISC_1, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, FUNCOP_1, BINOP_1, BINOP_2, RVSUM_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, NEWTON, NAT_1, NAT_D,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
    SEQ_4, PREPOWER, VALUED_0, VALUED_1, BINOP_1, BINOP_2,
    SETWISEO, FUNCOP_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NEWTON, NAT_1, NAT_D, SEQ_2, SEQM_3, SEQ_4,
    PREPOWER, BINOP_1, BINOP_2, COMSEQ_2, FINSEQ_2, FINSEQ_4,
    VALUED_1, FINSEQOP, FINSOP_1, SETWOP_2, RVSUM_1, SETWISEO;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex partial being Real_Sequence st
    (for n being Nat holds
      ex outer being FinSequence of REAL st
        len outer = n &
        (for a being Nat st a in Seg n holds
          ex middle being FinSequence of REAL st
            len middle = n &
            (for b being Nat st b in Seg n holds
              ex inner being FinSequence of REAL st
                len inner = n &
                (for c being Nat st c in Seg n holds
                  (a < b + c & b < c + a & c < a + b &
                    inner.c = ((2 qua Real) |^ a) /
                      (((3 qua Real) |^ b) * ((5 qua Real) |^ c))) or
                  ((a >= b + c or b >= c + a or c >= a + b) &
                    inner.c = 0)) &
                middle.b = Sum inner) &
            outer.a = Sum middle) &
        partial.n = Sum outer) &
    partial is convergent &
    lim partial = (17 qua Real) / 21
proof
end;
::$P+
