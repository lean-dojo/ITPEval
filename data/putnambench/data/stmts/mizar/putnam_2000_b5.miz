:: Statement-only formalization of PutnamBench corpus artifact putnam_2000_b5:
:: finite sets of positive integers evolving by exclusive-or membership have
:: arbitrarily late terms equal to the initial set union its index translate.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, NAT_1, INT_1, FINSET_1, ARYTM_3, XXREAL_0,
    XCMPLX_0, ARYTM_1, CARD_1, VALUED_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, FINSET_1, CARD_1, VALUED_0;
  constructors ZFMISC_1, RELSET_1, FUNCT_2, XCMPLX_0, XXREAL_0, NAT_1,
    INT_1, FINSET_1, NUMBERS, CARD_1, VALUED_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, FINSET_1,
    CARD_1, VALUED_0, MEMBERED;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM, REAL;

begin

::$P-
theorem
  for S being Function of NAT,bool INT st
    (for n being Nat holds S.n is finite) &
    (for n being Nat, s being Integer st s in S.n holds
      s > (0 qua Integer)) &
    (for n being Nat, a being Integer holds
      (a in S.(n + 1) iff
        ((a - 1 in S.n & not a in S.n) or
         (a in S.n & not a - 1 in S.n))))
  holds
    for n being Nat ex N being Nat st
      n <= N &
      S.N = S.(0 qua Nat) \/ {M where M is Integer :
        M - (N qua Integer) in S.(0 qua Nat)}
proof
end;
::$P+
