:: Statement-only formalization of PutnamBench artifact putnam_1964_b5:
:: the reciprocal series of the successive least common multiples of a
:: strictly increasing sequence of positive natural numbers converges. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, INT_1, INT_2, VALUED_0, VALUED_1, SEQ_1, SEQ_2,
    ORDINAL1, ORDINAL2, SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_2, COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, INT_2, XXREAL_0, NAT_1, SEQ_2, SEQM_3, SEQ_4, BINOP_2,
    COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b being Function of NAT,NAT st
    (for m,n being Nat st m < n holds a.m < a.n) &
    (for n being Nat holds 0 < a.n) &
    b.0 = a.0 &
    (for n being Nat holds b.(n+1) = b.n lcm a.(n+1))
  holds
    ex s being Real_Sequence st
      (for n being Nat holds s.n = 1 / (b.n qua Real)) &
      Partial_Sums(s) is convergent
proof
end;
::$P+
