:: Statement-only formalization of PutnamBench corpus artifact putnam_2022_b6
:: (putnambench__mizar__putnam_2022_b6): classification of continuous
:: positive-real-valued functions on the positive reals satisfying the given
:: functional equation. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, VALUED_1, XXREAL_2, COMPLEX1,
    RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL,
      P being Subset of REAL st
    P = {x where x is Real : 0 < x}
  holds
    ((f|P is continuous &
      (for x being Real st 0 < x holds 0 < f.x) &
      (for x,y being Real st 0 < x & 0 < y holds
        f.(x * f.y) + f.(y * f.x) = 1 + f.(x + y)))
    iff
      ex c being Real st
        0 <= c &
        for x being Real st 0 < x holds
          f.x = 1 / (1 + c*x))
proof
end;
::$P+
