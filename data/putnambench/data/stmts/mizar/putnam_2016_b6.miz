:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_b6
:: (putnambench__mizar__putnam_2016_b6): the nested alternating real series
:: with inner terms 1/((k+1)*2^n+1) converges to 1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON, PREPOWER,
    SEQ_1, SEQ_2, ORDINAL2, SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PREPOWER, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, COMSEQ_2,
    SERIES_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex inners being Function of NAT,Funcs(NAT,REAL),
     outer being Real_Sequence st
    (for k being Nat,
         inner being Real_Sequence st inner = inners.k holds
      (for n being Nat holds
        inner.n =
          (1 qua Real) /
            (((k + 1) qua Real) * ((2 qua Real) |^ n) + 1)) &
      Partial_Sums(inner) is convergent &
      outer.k =
        (((-1) qua Real) |^ k) / ((k + 1) qua Real) *
          lim Partial_Sums(inner)) &
    Partial_Sums(outer) is convergent &
    lim Partial_Sums(outer) = 1
proof
end;
::$P+
