:: Statement-only formalization of PutnamBench corpus artifact putnam_1995_b1:
:: for any two partitions of a nine-element set, two distinct elements have
:: equal containing-block sizes in both partitions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, NUMBERS, ORDINAL1, CARD_1,
    FINSEQ_1, EQREL_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    FINSEQ_1, EQREL_1;
  constructors FINSEQ_1, EQREL_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, FINSEQ_1, EQREL_1;
  requirements BOOLE, SUBSET, NUMERALS;

begin

::$P-
theorem
  for P,Q being a_partition of Seg 9 holds
    ex x,y being Element of Seg 9,
       PX,PY being Element of P,
       QX,QY being Element of Q st
      x <> y &
      x in PX & y in PY & card PX = card PY &
      x in QX & y in QY & card QX = card QY
proof
end;
::$P+
