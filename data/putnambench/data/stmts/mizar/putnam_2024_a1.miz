:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_a1
:: (putnambench__mizar__putnam_2024_a1): classification of the positive
:: integer exponents for which 2*a^n + 3*b^n = 4*c^n has positive integer
:: solutions. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, RELAT_1, XBOOLE_0, SUBSET_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, NEWTON, ARYTM_1, ARYTM_3;
  notations XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, NEWTON;
  constructors REAL_1, NAT_1, NEWTON, NUMBERS;
  registrations XBOOLE_0, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, NEWTON, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
    ((0 < n &
      ex a,b,c being Nat st
        0 < a & 0 < b & 0 < c &
        2 * (a |^ n) + 3 * (b |^ n) = 4 * (c |^ n))
      iff n = 1)
proof
end;
::$P+
