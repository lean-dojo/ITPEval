:: Statement-only formalization of PutnamBench artifact putnam_1994_b4:
:: the greatest common divisor of the entries of the nth power of the integer
:: matrix with rows (3,2) and (4,3), minus the identity, tends to infinity.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, INT_2, NAT_1, ORDINAL1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_2, XXREAL_0, NAT_1, NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, INT_1,
    INT_2, XXREAL_0, NAT_1, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x,y,z,w being Function of NAT,INT,
      d being Function of NAT,NAT st
    x.0 = 1 & y.0 = 0 & z.0 = 0 & w.0 = 1 &
    (for n being Nat holds
      x.(n + 1) = 3 * x.n + 4 * y.n &
      y.(n + 1) = 2 * x.n + 3 * y.n &
      z.(n + 1) = 3 * z.n + 4 * w.n &
      w.(n + 1) = 2 * z.n + 3 * w.n) &
    (for n being Nat st 1 <= n holds
      d.n = (((x.n - 1) gcd y.n) gcd z.n) gcd (w.n - 1))
  holds
    for k being Nat holds
      ex N being Nat st
        for n being Nat st N <= n holds k <= d.n
proof
end;
::$P+
