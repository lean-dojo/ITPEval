:: Statement-only formalization of PutnamBench artifact putnam_1983_b4:
:: every positive-starting integer sequence whose next term adds the floor of
:: the square root of its current term contains a square. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, COMPLEX1, SQUARE_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of NAT,INT st
    a.0 > 0 &
    (for n being Nat holds
      a.(n + 1) = a.n + [\ sqrt(a.n qua Real) /])
  holds
    ex i being Nat, s being Integer st a.i = s^2
proof
end;
::$P+
