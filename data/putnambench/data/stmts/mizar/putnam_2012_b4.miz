:: Statement-only formalization of PutnamBench corpus artifact putnam_2012_b4:
:: the recursively defined sequence a(0) = 1, a(n+1) = a(n) + exp(-a(n))
:: has a finite limit after subtracting ln(n). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, INT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, POWER, SEQ_1, SEQ_2, ORDINAL2, SEQ_4, SIN_COS,
    TAYLOR_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, INT_1, NAT_D, NEWTON, PREPOWER,
    POWER, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
    SEQ_4, SIN_COS, TAYLOR_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, INT_1, NAT_D, NEWTON, PREPOWER, POWER, SEQ_2,
    SEQM_3, SEQ_4, BINOP_2, COMSEQ_2, SIN_COS, TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, POWER, SEQ_4, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TAYLOR_1;

begin

::$P-
theorem
  for a being Real_Sequence st
    a.0 = 1 &
    (for n being Nat holds
      a.(n + 1) = a.n + exp_R.(-a.n))
  holds
    ex b being Real_Sequence st
      (for n being Nat holds
        b.n = a.n - ln.(n qua Real)) &
      b is convergent
proof
end;
::$P+
