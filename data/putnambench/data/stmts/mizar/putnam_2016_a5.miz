:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_a5
:: (putnambench__mizar__putnam_2016_a5): every element of a finite group
:: generated by g and h, but by neither alone, is a bounded nonempty product
:: of the four signed generator-pair products. This file contains no proof.

environ

 vocabularies NUMBERS, STRUCT_0, GROUP_1, SUBSET_1, GROUP_2, FINSET_1,
      INT_2, CARD_1, GRAPH_1, RELAT_1, TARSKI, ALGSTR_0, ZFMISC_1,
      PBOOLE, REALSET1, NEWTON, INT_1, ARYTM_3, GROUP_4, ARYTM_1,
      NAT_1, FINSEQ_1, FUNCT_1, XXREAL_0, CQC_SIM1, XBOOLE_0, SETFAM_1,
      GROUP_8, SETWISEO, FINSOP_1, BINOP_1, ABIAN;
 notations XBOOLE_0, CARD_1, TARSKI, ENUMSET1, ZFMISC_1, SUBSET_1,
      ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, RELAT_1, REALSET1, FUNCT_1,
      FUNCT_2, PBOOLE, INT_1, NAT_1, NAT_D, FINSET_1, SETWISEO, FINSOP_1,
      BINOP_1, GROUP_2, GROUP_4, GR_CY_1, FINSEQ_1, DOMAIN_1, STRUCT_0,
      ALGSTR_0, GROUP_1, INT_2, ABIAN;
 constructors WELLORD2, BINOP_1, REAL_1, NAT_D, BINOP_2, REALSET2,
      SETWISEO, FINSOP_1, GROUP_4, GR_CY_1, RELSET_1, ENUMSET1, ABIAN;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XXREAL_0, XREAL_0, NAT_1,
      INT_1, FINSEQ_1, STRUCT_0, GROUP_1, GROUP_2, GR_CY_1, ORDINAL1,
      FINSET_1, ABIAN;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, FUNCT_1, WELLORD2, STRUCT_0;
 equalities REALSET1, ALGSTR_0, ORDINAL1;
 expansions TARSKI, STRUCT_0, ABIAN;
 theorems GROUP_2, GR_CY_1, GR_CY_2, NAT_1, TARSKI, XBOOLE_0, GROUP_1,
      CARD_1, GROUP_6, ALTCAT_1, FUNCT_2, GROUP_4, INT_2, XCMPLX_1,
      INT_1, FINSEQ_1, FUNCT_1, NEWTON, ORDINAL1, NAT_D, XXREAL_0,
      RELAT_1, PARTFUN1, ENUMSET1, ABIAN;
 schemes SUBSET_1, NAT_1, FINSEQ_1, FUNCT_2;

begin

::$P-
theorem
  for G being finite Group,
      g,h being Element of G st
    the carrier of gr {g,h} = the carrier of G &
    the carrier of gr {g} <> the carrier of G &
    the carrier of gr {h} <> the carrier of G &
    ord g is odd
  holds
    for x being Element of G holds
      ex factors being FinSequence of the carrier of G st
        1 <= len factors &
        len factors <= card G &
        rng factors c= {g * h, g" * h, g * h", g" * h"} &
        (the multF of G) "**" factors = x
proof
end;
::$P+
