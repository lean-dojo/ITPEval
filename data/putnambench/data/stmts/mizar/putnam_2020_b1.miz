:: Statement-only formalization of PutnamBench corpus artifact putnam_2020_b1
:: (putnambench__mizar__putnam_2020_b1): the signed cubic sum determined by
:: binary digit sums is congruent to 1990 modulo 2020. This file contains no
:: proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for d being Function of NAT,NAT, S being Integer st
    d.0 = 0 &
    (for n being Nat st 0 < n holds
      d.n = (n mod 2) + d.(n div 2)) &
    (ex terms being FinSequence of INT st
      len terms = 2020 &
      (for k being Nat st k in Seg 2020 holds
        terms.k =
          (((-1) qua Integer) |^ d.k) *
          ((k qua Integer) |^ 3)) &
      S = Sum terms)
  holds S mod 2020 = 1990
proof
end;
::$P+
