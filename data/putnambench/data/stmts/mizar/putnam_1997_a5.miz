:: Statement-only formalization of PutnamBench corpus artifact putnam_1997_a5:
:: the number of ordered 10-tuples of positive integers whose reciprocals
:: sum to 1 is odd. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, TARSKI, XREAL_0, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1, FINSEQOP,
    ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO,
    SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1, ABIAN;
  notations TARSKI, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1, NUMBERS,
    VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, INT_1,
    RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
    FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, FINSOP_1,
    FINSEQOP, SETWOP_2, RVSUM_1, NAT_D, ABIAN;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, NAT_D, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1, XXREAL_1,
    REAL_1, FINSEQ_2, RVSUM_1, ABIAN;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1,
    RVSUM_1, RELSET_1, MEMBERED, INT_1, ABIAN, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex N being Nat st
    N = card {a where a is FinSequence of NAT :
      len a = 10 &
      (for i being Nat st i in Seg 10 holds 0 < a.i) &
      ex reciprocals being FinSequence of REAL st
        len reciprocals = 10 &
        (for i being Nat st i in Seg 10 holds
          reciprocals.i = 1 / (a.i qua Real)) &
        Sum reciprocals = 1} &
    N mod 2 = 1
proof
end;
::$P+
