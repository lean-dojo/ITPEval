:: Statement-only formalization of PutnamBench corpus artifact putnam_2020_b6
:: (putnambench__mizar__putnam_2020_b6): nonnegativity of the finite real sum
:: of (-1) raised to floor(k*(sqrt 2 - 1)) for 1 <= k <= n. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, ORDINAL1, POWER, RVSUM_1, FINSEQ_1, FINSEQ_2, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_1, FINSEQ_1,
    FINSEQ_2, PREPOWER, POWER, RVSUM_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, PREPOWER, ABIAN,
    BINOP_2, POWER, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, FINSEQ_1, FINSEQ_2, RVSUM_1, CARD_3;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    ex terms being FinSequence of REAL st
      len terms = n &
      (for k being Nat st k in Seg n holds
        terms.k =
          ((-1 qua Real) to_power
            [\ (k qua Real) * (sqrt 2 - 1) /])) &
      Sum terms >= 0
proof
end;
::$P+
