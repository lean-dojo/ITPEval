:: Statement-only formalization of PutnamBench corpus artifact putnam_2009_b3
:: (putnambench__mizar__putnam_2009_b3): positive integers for which the
:: second difference of the number of average-closed subsets of {1,...,n}
:: equals one are exactly the integers 2^k - 1 for k >= 1. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, NEWTON, ARYTM_1, ARYTM_3,
    REAL_1, COMPLEX1, INT_1, INT_2, VALUED_0, VALUED_1, BINOP_1,
    BINOP_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, COMPLEX1, INT_1, INT_2,
    NAT_1, NAT_D, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2,
    FINSEQ_1, FINSET_1, CARD_1, NEWTON, BINOP_1, BINOP_2;
  constructors RELSET_1, PARTFUN1, FUNCT_2, REAL_1, COMPLEX1, XXREAL_0,
    NAT_1, NAT_D, FINSET_1, CARD_1, NEWTON, INT_1, INT_2, BINOP_1,
    BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, NEWTON, MEMBERED,
    VALUED_0, VALUED_1, BINOP_2, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for A being Function of NAT,NAT st
    (for n being Nat holds
      A.n = card {S where S is Subset of Seg n :
        for a,b being Nat st
          a in S & b in S & 2 divides (a + b)
        holds (a + b) div 2 in S})
  holds
    for n being Nat holds
      (0 < n &
        addnat.(A.(n + 2),A.n) =
          addnat.(multnat.(2,A.(n + 1)),1)
      iff ex k being Nat st
        1 <= k & n = ((2 qua Nat) |^ k) -' 1)
proof
end;
::$P+
