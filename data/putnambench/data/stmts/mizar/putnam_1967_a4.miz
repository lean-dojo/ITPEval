:: Statement-only formalization of PutnamBench artifact putnam_1967_a4:
:: for lambda greater than one half, no real-valued function on [0,1]
:: satisfies the nonlinear integral equation
::   u(x) = 1 + lambda * integral_x^1 u(y)u(y-x) dy.
::
:: The integrand is required to be Lebesgue integrable on each interval
:: [x,1], which is the Mizar-native way to make every displayed integral
:: meaningful. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, SUPINF_2,
      MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0, VALUED_1,
      SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12,
      INTEGRA5, EXTREAL1;
 constructors RELSET_1, FUNCT_2, REAL_1, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, XXREAL_3, MEASURE1, MEASUR12, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for lambda being Real st 1 / 2 < lambda holds
    not ex u being Function of REAL,REAL st
      for x being Real st 0 <= x & x <= 1 holds
        ex I being Element of L-Field,
           h being Function of REAL,REAL st
          I = {y where y is Real : x <= y & y <= 1} &
          (for y being Real holds h.y = u.y * u.(y-x)) &
          h|I is_integrable_on L-Meas &
          u.x = 1 + lambda * Integral(L-Meas,h|I)
proof
end;
::$P+
