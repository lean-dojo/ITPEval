:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_a5:
:: the expected number of side-connected monochromatic regions in a uniformly
:: two-colored nonempty rectangular checkerboard exceeds one eighth of its
:: number of squares. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, CARD_3, ZFMISC_1, MCART_1, FINSET_1, RVSUM_1,
    NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, XXREAL_0, NAT_1, NAT_D, PARTFUN1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, RVSUM_1, MCART_1,
    FINSET_1, NEWTON;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    INT_1, XXREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1,
    ZFMISC_1, MCART_1, FINSET_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    FINSEQ_4, RVSUM_1, FINSET_1, FRAENKEL, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for m,n being Nat,
      connected being Function of
        bool [:Seg m,Seg n:], bool [:[:Seg m,Seg n:],[:Seg m,Seg n:]:],
      colorings being one-to-one FinSequence of bool [:Seg m,Seg n:],
      regionCounts being FinSequence of NAT st
    0 < m & 0 < n &
    rng colorings = bool [:Seg m,Seg n:] &
    len regionCounts = len colorings &
    (for C being Subset of [:Seg m,Seg n:],
         p,q being Element of [:Seg m,Seg n:] holds
      ([p,q] in connected.C iff
        ex S being FinSequence of [:Seg m,Seg n:] st
          0 < len S &
          S.1 = p & S.(len S) = q &
          ((for i being Nat st i in dom S holds S.i in C) or
           (for i being Nat st i in dom S holds not S.i in C)) &
          (for i being Nat st i in Seg (len S -' 1) holds
            ex a,b,c,d being Nat st
              S.i = [a,b] & S.(i+1) = [c,d] &
              ((a = c & (b + 1 = d or d + 1 = b)) or
               (b = d & (a + 1 = c or c + 1 = a)))))) &
    (for i being Nat st i in dom regionCounts holds
      regionCounts.i =
        card {R where R is Subset of [:Seg m,Seg n:] :
          ex p being Element of [:Seg m,Seg n:] st
            p in R &
            (for q being Element of [:Seg m,Seg n:] holds
              (q in R iff [p,q] in connected.(colorings.i)))})
  holds
    8 * Sum regionCounts > (2 |^ (m*n)) * (m*n)
proof
end;
::$P+
