:: Statement-only formalization of PutnamBench artifact putnam_1974_b5:
:: every natural-indexed partial sum of the exponential series at that
:: natural number is greater than half its exponential. This file contains
:: no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1,
    ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, PARTFUN1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D, SIN_COS;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, PARTFUN1, FUNCT_2,
    NUMBERS, RVSUM_1, FINSEQOP, SIN_COS;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1, RELSET_1,
    ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1,
    FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1,
    SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
    ex terms being FinSequence of REAL st
      len terms = n + 1 &
      (for i being Nat st i <= n holds
        terms.(i + 1) =
          ((n qua Real) |^ i) / (i !)) &
      Sum terms > exp_R.(n qua Real) / (2 qua Real)
proof
end;
::$P+
