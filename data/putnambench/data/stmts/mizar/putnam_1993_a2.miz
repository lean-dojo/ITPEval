:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_a2:
:: every nonzero real sequence satisfying x_n^2 - x_(n-1)*x_(n+1) = 1 for
:: n >= 1 satisfies a constant-coefficient recurrence. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, NAT_D, NEWTON;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x being Function of NAT,REAL st
    (for n being Nat holds x.n <> 0) &
    (for n being Nat st 1 <= n holds
      (x.n) |^ 2 - x.(n -' 1) * x.(n + 1) = 1)
  holds
    ex a being Real st
      for n being Nat st 1 <= n holds
        x.(n + 1) = a * x.n - x.(n -' 1)
proof
end;
::$P+
