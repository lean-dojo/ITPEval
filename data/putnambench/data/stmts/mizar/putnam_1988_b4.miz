:: Statement-only formalization of PutnamBench corpus artifact putnam_1988_b4:
:: a convergent series of positive real terms remains positive and convergent
:: after raising its nth term to the power n/(n+1). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1,
    SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN, ORDINAL1,
    SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PREPOWER, ABIAN, XXREAL_2, POWER, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN,
    BINOP_2, COMSEQ_2, POWER, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, SEQ_4,
    ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Real_Sequence st
    (for n being Nat st n >= 1 holds a.n > 0) &
    Partial_Sums(a) is convergent
  holds
    ex b being Real_Sequence st
      (for n being Nat holds
        b.n = (a.n) to_power
          ((n qua Real) / ((n + 1) qua Real))) &
      (for n being Nat st n >= 1 holds b.n > 0) &
      Partial_Sums(b) is convergent
proof
end;
::$P+
