:: Statement-only formalization of PutnamBench corpus artifact putnam_2012_b5
:: (putnambench__mizar__putnam_2012_b5): bounded real functions valued at
:: least one admit an affine supremum representation of their weighted
:: real-power products. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, VALUED_0, VALUED_1, ORDINAL1,
    PREPOWER, POWER, SEQ_4;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_2, PREPOWER, POWER, SEQ_4,
    VALUED_0, VALUED_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, XXREAL_2, PREPOWER, POWER, SEQ_4, VALUED_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, XXREAL_2, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, PREPOWER, SEQ_4,
    FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for g1,g2 being Function of REAL,REAL st
    (for u being Real holds g1.u >= 1 & g2.u >= 1) &
    (ex B1,B2 being Real st
      for u being Real holds g1.u <= B1 & g2.u <= B2)
  holds
    ex h1,h2 being Function of REAL,REAL st
      for x being Real holds
        ex L,R being Subset of REAL st
          L =
          {y where y is Real :
            ex s being Real st
              y = (g1.s to_power x) * g2.s} &
          R =
          {y where y is Real :
            ex t being Real st
              y = x * h1.t + h2.t} &
          L is non empty bounded_above &
          R is non empty bounded_above &
          upper_bound L = upper_bound R
proof
end;
::$P+
