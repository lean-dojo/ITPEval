:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_a5:
:: every real coefficient family that is area definite for all configurations
:: of m points in the Euclidean plane is area definite in Euclidean 3-space.
:: This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, CARD_3, CLASSES1,
      COMPLEX1, CONVEX1, EUCLID, EUCLID_9, FINSEQ_1, FINSEQ_2, FINSEQ_4,
      FINSET_1, FUNCOP_1, FUNCSDOM, FUNCT_1, FUNCT_2, INT_1, LMOD_7, MATRIX_1,
      MATRIX_3, MATRIX13, MATRLIN, MATRLIN2, MCART_1, MESFUNC1, METRIC_1,
      MONOID_0, NAT_1, NUMBERS, ORDINAL2, ORDINAL4, PARTFUN1, PCOMPS_1,
      PRE_TOPC, PROB_1, PRVECT_1, QC_LANG1, RCOMP_1, REAL_1, RELAT_1,
      RFINSEQ, RLAFFIN1, RLSUB_1, RLTOPSP1, RLVECT_1, RLVECT_2, RLVECT_3,
      RLVECT_5, RUSUB_4, SEMI_AF1, SETFAM_1, SQUARE_1, STRUCT_0, SUBSET_1,
      SUPINF_2, TARSKI, TBSP_1, TOPMETR, TOPS_1, TOPS_2, VALUED_0,
      VALUED_1, VECTSP_1, XBOOLE_0, XCMPLX_0, XTUPLE_0, XXREAL_0,
      XXREAL_1, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, CARD_1, XREAL_0, REAL_1, INT_1, FINSET_1, DOMAIN_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FUNCOP_1,
      STRUCT_0, FINSEQ_2, FINSEQOP, RVSUM_1, RLVECT_1, RLVECT_2, RUSUB_4,
      CONVEX1, RLAFFIN1, COMPLEX1, VALUED_0, METRIC_1, PRE_TOPC, PCOMPS_1,
      TBSP_1, ALGSTR_0, FUNCSDOM, TOPS_2, RLTOPSP1, EUCLID, VFUNCT_1,
      FVSUM_1, RLSUB_1, RLVECT_3, RLVECT_5, CARD_3, RCOMP_1, EUCLID_9,
      VECTSP_1, MATRIX_0, MATRIX_1, NAT_D, MATRIX_3, MATRIX_6, VECTSP_6,
      VECTSP_7, MATRIX13, MATRLIN, RLSUB_2, RFINSEQ, TOPMETR, RLAFFIN2,
      SETFAM_1, PRVECT_1, TOPREAL6, TOPREAL9, MATRTOP1, SQUARE_1,
      XTUPLE_0, MCART_1;
 constructors BINOP_2, CONVEX1, EUCLID_9, FUNCSDOM, FVSUM_1, MATRIX_6,
      MATRIX13, MATRTOP1, MONOID_0, NAT_D, RANKNULL, RCOMP_1, REAL_1,
      REALSET1, RFINSEQ, RLAFFIN1, RLAFFIN2, RLSUB_2, RLVECT_3, RLVECT_5,
      RUSUB_5, TBSP_1, TOPMETR, TOPREAL6, TOPREAL9, TOPS_2, VECTSP_7, VFUNCT_1,
      WELLORD2, MATRIX_1, SQUARE_1, XTUPLE_0, MCART_1;
 registrations CARD_1, EUCLID, EUCLID_7, EUCLID_9, FINSEQ_1, FINSEQ_2,
      FINSET_1, FUNCT_1, JORDAN2B, MATRIX13, MATRTOP1, MONOID_0, NAT_1,
      NUMBERS, PRE_TOPC, PRVECT_1, RELSET_1, RLAFFIN1, RLTOPSP1, RLVECT_5,
      RVSUM_1, STRUCT_0, SUBSET_1, TBSP_1, TOPMETR, TOPREAL1, TOPS_1,
      VALUED_0, VECTSP_1, VECTSP_9, XBOOLE_0, XREAL_0, XXREAL_0, ORDINAL1,
      INT_1, SQUARE_1, ZFMISC_1, XTUPLE_0, MCART_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions RLTOPSP1, TARSKI, TBSP_1, XBOOLE_0;
 equalities FINSEQ_1, MATRIX13, MATRTOP1, STRUCT_0, SUBSET_1;
 expansions FINSEQ_1, STRUCT_0, TARSKI, XBOOLE_0;
 theorems BORSUK_5, CARD_1, CARD_2, CARD_3, COMPLEX1, CONVEX1, EUCLID,
      EUCLID_7, EUCLID_9, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4, FUNCOP_1,
      FUNCT_1, FUNCT_2, FVSUM_1, GOBOARD6, JORDAN2B, JORDAN6, LAPLACE,
      MATRIX_6, MATRIX13, MATRLIN, MATRLIN2, MATRTOP1, MATRTOP2, METRIC_1,
      METRIZTS, NAT_1, PARTFUN1, PCOMPS_1, PRALG_3, PRE_TOPC, RELAT_1,
      RFINSEQ, RLAFFIN1, RLAFFIN2, RLSUB_1, RLSUB_2, RLTOPSP1, RLVECT_1,
      RLVECT_2, RLVECT_3, RLVECT_5, RUSUB_4, RVSUM_1, SETFAM_1, SPPOL_1,
      STIRL2_1, TARSKI, TBSP_1, TOPGRP_1, TOPMETR, TOPREAL9, TOPS_1,
      TOPS_2, TREAL_1, TSEP_1, URYSOHN1, VECTSP_1, VECTSP_4, VECTSP_7,
      VECTSP_9, VFUNCT_1, XBOOLE_0, XBOOLE_1, XCMPLX_0, XCMPLX_1,
      XREAL_0, XREAL_1, XXREAL_0, XXREAL_1, ZFMISC_1, INT_1, NAT_D, TOPREAL3,
      SQUARE_1;
 schemes FINSEQ_1, FUNCT_2, TREES_2;

begin

::$P-
theorem
  for m being Nat,
      a being Function of [:Seg m,Seg m,Seg m:],REAL,
      area2 being Function of
        [:the carrier of TOP-REAL 2,the carrier of TOP-REAL 2,
          the carrier of TOP-REAL 2:],REAL,
      area3 being Function of
        [:the carrier of TOP-REAL 3,the carrier of TOP-REAL 3,
          the carrier of TOP-REAL 3:],REAL st
    3 <= m &
    (for P,Q,R being Point of TOP-REAL 2 holds
      area2.([P,Q,R]) =
        sqrt(((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2) *
          ((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2 - dist(P,Q)) *
          ((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2 - dist(Q,R)) *
          ((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2 - dist(R,P)))) &
    (for P,Q,R being Point of TOP-REAL 3 holds
      area3.([P,Q,R]) =
        sqrt(((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2) *
          ((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2 - dist(P,Q)) *
          ((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2 - dist(Q,R)) *
          ((dist(P,Q) + dist(Q,R) + dist(R,P)) / 2 - dist(R,P))))
  holds
    ((for A2 being Function of
        Seg m,the carrier of TOP-REAL 2 holds
      ex outer2 being FinSequence of REAL st
        len outer2 = m &
        (for i being Nat st i in Seg m holds
          ex middle2 being FinSequence of REAL st
            len middle2 = m &
            (for j being Nat st j in Seg m holds
              ex inner2 being FinSequence of REAL st
                len inner2 = m &
                (for k being Nat st
                  k in Seg m & i < j & j < k
                holds
                  inner2.k =
                    a.([i,j,k]) * area2.([A2.i,A2.j,A2.k])) &
                (for k being Nat st
                  k in Seg m & not (i < j & j < k)
                holds inner2.k = 0) &
                middle2.j = Sum inner2) &
            outer2.i = Sum middle2) &
        0 <= Sum outer2)
    implies
    (for A3 being Function of
        Seg m,the carrier of TOP-REAL 3 holds
      ex outer3 being FinSequence of REAL st
        len outer3 = m &
        (for i being Nat st i in Seg m holds
          ex middle3 being FinSequence of REAL st
            len middle3 = m &
            (for j being Nat st j in Seg m holds
              ex inner3 being FinSequence of REAL st
                len inner3 = m &
                (for k being Nat st
                  k in Seg m & i < j & j < k
                holds
                  inner3.k =
                    a.([i,j,k]) * area3.([A3.i,A3.j,A3.k])) &
                (for k being Nat st
                  k in Seg m & not (i < j & j < k)
                holds inner3.k = 0) &
                middle3.j = Sum inner3) &
            outer3.i = Sum middle3) &
        0 <= Sum outer3))
proof
end;
::$P+
