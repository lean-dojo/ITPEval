:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_b1:
:: the maximum number of rational points on a circle in the real plane whose
:: center is not a rational point is two. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, FUNCT_2, METRIC_1, NAT_1,
      NUMBERS, PRE_TOPC, RAT_1, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1,
      RVSUM_1, SQUARE_1, STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0,
      VALUED_1, XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2,
      FINSET_1, SQUARE_1, STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, RVSUM_1, TOPMETR, TOPREAL6, RAT_1;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, TOPMETR, TOPREAL6, FINSET_1, RAT_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1, FINSET_1, RAT_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  (for C,P,Q,R being Point of TOP-REAL 2, r being Real st
    not (C.1 in RAT & C.2 in RAT) &
    dist(P,C) = r & P.1 in RAT & P.2 in RAT &
    dist(Q,C) = r & Q.1 in RAT & Q.2 in RAT &
    dist(R,C) = r & R.1 in RAT & R.2 in RAT
  holds P = Q or P = R or Q = R) &
  (ex C,P,Q being Point of TOP-REAL 2, r being Real st
    not (C.1 in RAT & C.2 in RAT) &
    P <> Q &
    dist(P,C) = r & P.1 in RAT & P.2 in RAT &
    dist(Q,C) = r & Q.1 in RAT & Q.2 in RAT)
proof
end;
::$P+
