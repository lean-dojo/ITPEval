:: Statement-only formalization of PutnamBench corpus artifact putnam_2022_b3
:: (putnambench__mizar__putnam_2022_b3): every red-blue coloring, recolored
:: by distances between same-colored positive real points, becomes red on all
:: positive reals after finitely many iterations. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      FUNCT_2, FUNCT_7, NAT_1, INT_1, XREAL_0, XXREAL_0, ARYTM_1,
      ARYTM_3, REAL_1, ORDINAL1, CARD_1, XCMPLX_0, VALUED_0, NEWTON;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NAT_1,
      NAT_D, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FUNCT_7, NEWTON;
 constructors ZFMISC_1, REAL_1, INT_1, NAT_1, NAT_D, FUNCT_7,
      RELSET_1, FUNCT_2, NEWTON;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
      NAT_1, INT_1, CARD_1, MEMBERED, VALUED_0, NEWTON, FUNCT_7;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for recolor being Function of bool REAL,bool REAL st
    (for isred being Subset of REAL, d being Real holds
      (d in recolor.isred iff
        ex p,q being Real st
          0 < p & 0 < q & p < q &
          (p in isred iff q in isred) &
          q - p = d))
  holds
    for isred being Subset of REAL holds
      ex k being Nat st
        for p being Real st 0 < p holds
          p in iter(recolor,k).isred
proof
end;
::$P+
