:: Statement-only formalization of PutnamBench artifact putnam_1965_a5:
:: the number of orderings of 1 through n in which every nonfirst entry
:: differs by 1 from an earlier entry is 2^(n-1). This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, NUMBERS, NAT_1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1, NEWTON, ARYTM_1,
    ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, MATRIX_0, MATRIX_1,
    FINSET_1, CARD_1, NEWTON;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NEWTON, VALUED_0,
    VALUED_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for n being Nat st 0 < n holds
    card {p where p is FinSequence of NAT :
      p is Permutation of Seg n &
      (for m being Nat st m in Seg n & 1 < m holds
        ex k being Nat st k in Seg n & k < m &
          (p/.m = p/.k + 1 or p/.k = p/.m + 1))}
      = 2 |^ (n -' 1)
proof
end;
::$P+
