:: Statement-only formalization of PutnamBench corpus artifact putnam_2013_b2
:: (putnambench__mizar__putnam_2013_b2): the maximum value at zero among
:: nonnegative finite real cosine polynomials whose coefficients at multiples
:: of three vanish is 3, and this maximum is attained. This file contains no
:: proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, FUNCT_2, TARSKI, XREAL_0,
    ORDINAL4, BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, FUNCOP_1, REAL_1,
    FINSEQOP, ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0,
    SETWISEO, SETWOP_2, FINSOP_1, RVSUM_1, ORDINAL1, INT_1, SIN_COS,
    COMPLEX1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1,
    RELAT_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO, FUNCT_2, BINOP_1,
    FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1, NAT_1, NAT_D,
    FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, INT_1, SIN_COS;
  constructors PARTFUN1, BINOP_1, SETWISEO, NAT_1, NAT_D, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1,
    XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1, INT_1, SIN_COS, COMPLEX1;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, FINSEQ_4, CARD_1,
    INT_1, RVSUM_1, SIN_COS, RELSET_1, MEMBERED, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  (for f being Function of REAL,REAL st
    (ex N being Nat, a being FinSequence of REAL st
      0 < N &
      len a = N &
      (for n being Nat st n in Seg N & 3 divides n holds
        a.n = 0) &
      (for x being Real holds
        ex terms being FinSequence of REAL st
          len terms = N &
          (for n being Nat st n in Seg N holds
            terms.n =
              a.n * cos.(2 * PI * (n qua Real) * x)) &
          f.x = 1 + Sum terms &
          0 <= f.x))
  holds
    f.0 <= 3) &
  (ex f being Function of REAL,REAL st
    (ex N being Nat, a being FinSequence of REAL st
      0 < N &
      len a = N &
      (for n being Nat st n in Seg N & 3 divides n holds
        a.n = 0) &
      (for x being Real holds
        ex terms being FinSequence of REAL st
          len terms = N &
          (for n being Nat st n in Seg N holds
            terms.n =
              a.n * cos.(2 * PI * (n qua Real) * x)) &
          f.x = 1 + Sum terms &
          0 <= f.x)) &
    f.0 = 3)
proof
end;
::$P+
