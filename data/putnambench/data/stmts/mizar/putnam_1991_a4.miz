:: Statement-only formalization of PutnamBench corpus artifact putnam_1991_a4:
:: there exists an infinite sequence of closed discs in the real plane whose
:: centers have no finite-plane limit point, whose total area is finite, and
:: such that every line meets at least one disc. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      FUNCT_2, NUMBERS, XREAL_0, REAL_1, NAT_1, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, ORDINAL1, ORDINAL2, VALUED_0, VALUED_1,
      STRUCT_0, METRIC_1, PRE_TOPC, TOPMETR, RLVECT_1, RLTOPSP1,
      EUCLID, RLAFFIN1, SEQ_1, SEQ_2, SEQ_4, SERIES_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      RELSET_1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, XXREAL_0, NAT_1, CARD_1, VALUED_0, VALUED_1,
      STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1, EUCLID,
      TOPMETR, TOPREAL6, RLAFFIN1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
      SERIES_1;
 constructors ZFMISC_1, REAL_1, RELSET_1, FUNCT_2, CARD_1, METRIC_1,
      RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, TOPREAL6, RLAFFIN1, SEQ_2, SEQM_3,
      SEQ_4, COMSEQ_2, SERIES_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, ORDINAL1, NUMBERS, XREAL_0, NAT_1, CARD_1, VALUED_0,
      VALUED_1, STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID,
      TOPMETR, SEQ_4;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLTOPSP1;
 equalities STRUCT_0, EUCLID, VALUED_1;
 expansions TARSKI, XBOOLE_0, FUNCT_1;

begin

::$P-
theorem
  ex c being sequence of REAL 2,
     r,s being Real_Sequence st
    (for i being Nat holds 0 <= r.i & s.i = r.i * r.i) &
    Partial_Sums(s) is convergent &
    not (ex p being Point of TOP-REAL 2 st
      for epsilon being Real st 0 < epsilon holds
        ex f being Function of NAT,NAT st
          (for m,n being Nat st m < n holds f.m < f.n) &
          (for n being Nat holds
            ex q being Point of TOP-REAL 2 st
              q = c.(f.n) & dist(q,p) < epsilon)) &
    (for L being line of TOP-REAL 2 st L is non trivial holds
      ex i being Nat, p,q being Point of TOP-REAL 2 st
        q = c.i & p in L & dist(p,q) <= r.i)
proof
end;
::$P+
