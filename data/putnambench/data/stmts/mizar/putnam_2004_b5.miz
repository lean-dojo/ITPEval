:: Statement-only formalization of PutnamBench corpus artifact putnam_2004_b5:
:: the infinite product of ((1+x^(n+1))/(1+x^n))^(x^n) for 0 < x < 1
:: has left-hand limit 2/exp(1) as x approaches 1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, POWER,
    SEQ_1, SEQ_2, ORDINAL2, SEQ_4, SERIES_1, SERIES_3, SIN_COS;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NEWTON, NAT_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, PREPOWER, POWER, SERIES_1, SERIES_3, SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, POWER,
    BINOP_2, COMSEQ_2, SERIES_1, SERIES_3, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, POWER,
    SEQ_4, SERIES_3, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for xprod being Function of REAL,REAL st
    (for x being Real st 0 < x & x < 1 holds
      ex terms being Real_Sequence st
        (for n being Nat holds
          terms.n =
            ((1 + x |^ (n+1)) / (1 + x |^ n))
              to_power (x |^ n)) &
        (Partial_Product terms) is convergent &
        xprod.x = lim (Partial_Product terms))
  holds
    for epsilon being Real st 0 < epsilon holds
      ex delta being Real st 0 < delta &
        for x being Real st 1-delta < x & x < 1 holds
          |.xprod.x - 2 / exp_R.1.| < epsilon
proof
end;
::$P+
