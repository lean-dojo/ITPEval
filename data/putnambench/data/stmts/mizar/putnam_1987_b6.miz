:: Statement-only formalization of PutnamBench corpus artifact putnam_1987_b6:
:: parity of the elements shared by a sign-choice subset of a finite field
:: and its doubling image. This file contains no proof.

environ
  vocabularies NUMBERS, CARD_1, FUNCT_1, RELAT_1, XBOOLE_0, ARYTM_3,
    MCART_1, SUBSET_1, ARYTM_1, XXREAL_0, INT_2, NAT_1, ZFMISC_1,
    SUPINF_2, MESFUNC1, INT_1, VECTSP_1, STRUCT_0, RLVECT_1, ALGSTR_0,
    LATTICES, GROUP_1, BINOP_1, FUNCSDOM, VECTSP_2, TARSKI, ABIAN,
    FINSET_1, MEMBERED, FIELD_9, RING_2, RING_4;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, FUNCT_1,
    ORDINAL1, MCART_1, FUNCT_2, BINOP_1, DOMAIN_1, NUMBERS, XREAL_0,
    XCMPLX_0, XXREAL_0, NAT_1, NAT_D, INT_1, INT_2, STRUCT_0, ALGSTR_0,
    RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2, ABIAN, MEMBERED, CARD_1,
    FIELD_9;
  constructors NAT_D, PEPIN, EUCLID, REALSET1, RELSET_1, BINOP_2,
    DOMAIN_1, BINOP_1, VECTSP_1, VECTSP_2, ABIAN, FIELD_4, FIELD_9;
  registrations STRUCT_0, XREAL_0, ORDINAL1, INT_1, RELAT_1, VECTSP_1,
    INT_3, SUBSET_1, XTUPLE_0, MCART_1, XBOOLE_0, FRAENKEL, CARD_1,
    FINSET_1, ABIAN, MEMBERED, FIELD_3, FIELD_4, FIELD_9;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities ALGSTR_0;

begin

::$P-
theorem
  for p being Nat, F being finite Field, S being Subset of F st
    p is prime &
    p is odd &
    card the carrier of F = p * p &
    2 * card S = p * p -' 1 &
    (for x being Element of F st x in S holds x <> 0.F) &
    (for a being Element of F st a <> 0.F holds
      (a in S & not -a in S) or (not a in S & -a in S))
  holds
    card (S /\ {x where x is Element of F :
      ex a being Element of F st a in S & x = a + a}) is even
proof
end;
::$P+
