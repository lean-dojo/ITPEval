:: Statement-only formalization of PutnamBench corpus artifact putnam_2019_b6
:: (putnambench__mizar__putnam_2019_b6): every positive-dimensional integer
:: lattice admits an independent perfect dominating set. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, INT_1, INT_2, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, CARD_1, ARYTM_1, ARYTM_3, FINSEQ_1, FINSEQ_2, NEWTON,
    REALSET1, VALUED_0, VALUED_1, CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NEWTON, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
    ((1 <= n &
      ex S being Subset of Funcs(Seg n,INT) st
        (for p being Function of Seg n,INT st p in S holds
          for q being Function of Seg n,INT st
            (ex i being Element of Seg n st
              (p.i - q.i = 1 or p.i - q.i = -1) &
              (for j being Element of Seg n st j <> i holds
                p.j = q.j))
          holds not q in S) &
        (for p being Function of Seg n,INT st not p in S holds
          ex q being Function of Seg n,INT st
            q in S &
            (ex i being Element of Seg n st
              (p.i - q.i = 1 or p.i - q.i = -1) &
              (for j being Element of Seg n st j <> i holds
                p.j = q.j)) &
            (for r being Function of Seg n,INT st
              r in S &
              (ex i being Element of Seg n st
                (p.i - r.i = 1 or p.i - r.i = -1) &
                (for j being Element of Seg n st j <> i holds
                  p.j = r.j))
            holds r = q))
    ) iff 1 <= n)
proof
end;
::$P+
