:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_a5:
:: for a prime natural p greater than 3, the sum of the binomial coefficients
:: p choose i from 1 through floor(2p/3) is divisible by p^2. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, NEWTON, REALSET1, INT_1, INT_2, ARYTM_1, ARYTM_3,
    CARD_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NEWTON, RELAT_1,
    FUNCT_1, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D, WSIERP_1;
  constructors REAL_1, NAT_D, INT_2, NEWTON, RELSET_1, NUMBERS,
    RVSUM_1, FINSEQOP, WSIERP_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, INT_2, FINSEQ_1,
    FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p, k being Nat, terms being FinSequence of NAT st
    p is prime &
    p > 3 &
    k = (2 * p) div 3 &
    len terms = k &
    (for i being Nat st i in Seg k holds
      terms.i = p choose i)
  holds
    (p |^ 2) divides Sum terms
proof
end;
::$P+
