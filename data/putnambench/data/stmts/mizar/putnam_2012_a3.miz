:: Statement-only formalization of PutnamBench corpus artifact putnam_2012_a3
:: (putnambench__mizar__putnam_2012_a3): the unique continuous real function
:: on [-1,1] satisfying the given functional equation, normalization, and
:: finite left-limit condition is sqrt(1-x^2). This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SQUARE_1, SUBSET_1, SEQ_1,
    PARTFUN1, ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1, LIMFUNC1, LIMFUNC2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, COMPLEX1, SQUARE_1, LIMFUNC1, LIMFUNC2;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_1, RFUNCT_2, FCONT_1, VALUED_1, XXREAL_2,
    COMPLEX1, SQUARE_1, RELSET_1, BINOP_2, COMSEQ_2, LIMFUNC1,
    LIMFUNC2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  ex s being Function of REAL,REAL st
    (for x being Real holds s.x = sqrt(1-x^2)) &
    s|[.-1,1.] is continuous &
    (for x being Real st -1 <= x & x <= 1 holds
      s.x = ((2-x^2)/2) * s.(x^2/(2-x^2))) &
    s.0 = 1 &
    (ex q being Function of REAL,REAL st
      (for x being Real holds q.x = s.x / sqrt(1-x)) &
      q is_left_convergent_in 1) &
    for f being Function of REAL,REAL st
      f|[.-1,1.] is continuous &
      (for x being Real st -1 <= x & x <= 1 holds
        f.x = ((2-x^2)/2) * f.(x^2/(2-x^2))) &
      f.0 = 1 &
      (ex q being Function of REAL,REAL st
        (for x being Real holds q.x = f.x / sqrt(1-x)) &
        q is_left_convergent_in 1)
    holds
      for x being Real st -1 <= x & x <= 1 holds f.x = s.x
proof
end;
::$P+
