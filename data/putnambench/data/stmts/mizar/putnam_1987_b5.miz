:: Statement-only formalization of PutnamBench artifact putnam_1987_b5:
:: surjectivity of the real-part map defined by a 2n by n complex matrix
:: whose nonzero left-kernel vectors are not entirely real.
:: This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, NAT_1, XBOOLE_0, FINSEQ_1, ARYTM_3,
      VECTSP_1, MATRIX_1, RELAT_1, FINSEQ_3, ARYTM_1, TREES_1, CARD_1,
      XXREAL_0, FUNCT_1, INCSP_1, TARSKI, ALGSTR_0, ZFMISC_1, STRUCT_0,
      SETWOP_2, FUNCT_2, FINSUB_1, GROUP_1, SETWISEO, INT_1, FINSET_1,
      ABIAN, FINSEQ_2, BINOP_1, QC_LANG1, AFINSQ_1, MATRIX_3, SUPINF_2,
      CARD_3, FINSOP_1, RVSUM_1, FVSUM_1, MESFUNC1, MATRIX_6, FUNCT_7,
      COMPLEX1, XREAL_0, REAL_1, COMPLFLD, XCMPLX_0, MATRIX_0;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, COMPLEX1, FINSET_1, RELAT_1,
      RELSET_1, FUNCT_1, PARTFUN1, FUNCT_2, FINSEQ_1, BINOP_1, STRUCT_0,
      ALGSTR_0, GROUP_1, VECTSP_1, SETWISEO, SETWOP_2, FINSEQ_2, MATRIX_0,
      FINSUB_1, MATRIX_1, NAT_1, FVSUM_1, FINSOP_1, MATRIX_3, CARD_1,
      FINSEQ_7, FINSEQ_3, MATRIX_6, COMPLFLD;
 constructors SETWISEO, FINSOP_1, SETWOP_2, ALGSTR_1, FVSUM_1, BINOP_1,
      FINSEQ_4, FINSEQ_7, WELLORD2, MATRIX_6, NAT_1, BINOP_2, RELSET_1,
      XXREAL_0, VECTSP_2, COMPLEX1, REAL_1, COMPLFLD, MATRIX_3;
 registrations FUNCT_1, FINSUB_1, FINSET_1, STRUCT_0, FVSUM_1, MATRIX_1,
      VECTSP_1, FUNCT_2, PARTFUN1, XBOOLE_0, ORDINAL1, XXREAL_0, NAT_1,
      INT_1, RELAT_1, CARD_1, XCMPLX_0, XREAL_0, RELSET_1, FINSEQ_2,
      FINSEQ_1, MATRIX_0, MATRIX_6, VECTSP_2, COMPLFLD, MEMBERED, NUMBERS;
 requirements ARITHM, NUMERALS, REAL, BOOLE, SUBSET;
 definitions TARSKI;
 equalities FINSEQ_2, FINSEQ_1, MATRIX_0, MATRIX_3, FVSUM_1, RELAT_1,
      ALGSTR_0, COMPLEX1;
 expansions FINSEQ_1, TARSKI;

begin

::$P-
theorem
  for n being Nat,
      M being Matrix of 2*n,n,F_Complex st
    n > 0 &
    (for z being Matrix of 1,2*n,F_Complex st
      z * M = 0.(F_Complex,1,n) &
      not (for i being Nat st i in Seg (2*n) holds
        z*(1,i) = 0.F_Complex)
    holds
      ex i being Nat, c being Complex st
        i in Seg (2*n) & c = z*(1,i) & Im c <> 0)
  holds
    for r being Matrix of 2*n,1,F_Real holds
      ex w being Matrix of n,1,F_Complex st
        for i being Nat st i in Seg (2*n) holds
          ex c being Complex st
            c = (M*w)*(i,1) & Re c = r*(i,1)
proof
end;
::$P+
