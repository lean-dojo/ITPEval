:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_a3
:: (putnambench__mizar__putnam_2016_a3): a real function satisfying the
:: stated arctangent functional equation has integral 3*PI/8 on [0,1].
:: This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, SUPINF_2,
      MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5, SIN_COS,
      SIN_COS9;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, XXREAL_0, XXREAL_1, XXREAL_3, VALUED_0,
      VALUED_1, SIN_COS, SIN_COS9, SUPINF_2, MEASURE1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 constructors RELSET_1, FUNCT_2, REAL_1, SIN_COS, SIN_COS9,
      MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XREAL_0, VALUED_0,
      VALUED_1, XXREAL_3, MEASURE1, MEASUR12, SIN_COS, MEMBERED;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for I being Subset of REAL,
      f being Function of REAL,REAL st
    I = {x where x is Real : 0 <= x & x <= 1} &
    (for x being Real st x <> 0 holds
      f.x + f.(1 - 1 / x) = arctan.x)
  holds
    Integral(L-Meas,f|I) = 3 * PI / 8
proof
end;
::$P+
