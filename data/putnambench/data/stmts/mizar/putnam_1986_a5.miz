:: Statement-only formalization of PutnamBench artifact putnam_1986_a5:
:: a vector field on a positive-dimensional real coordinate space whose
:: skew differences of first partial derivatives are constant admits a
:: scalar potential correction with linear components. This file contains
:: no proof.

environ
  vocabularies FUNCT_1, FUNCT_2, ARYTM_3, ARYTM_1, FINSEQ_1, FINSEQ_2, RELAT_1,
    COMPLEX1, SQUARE_1, RCOMP_1, XBOOLE_0, ZFMISC_1, PARTFUN1, XXREAL_1,
    ORDINAL4, FCONT_1, FDIFF_1, PDIFF_1, AFINSQ_1, NUMBERS, REAL_1, SUBSET_1,
    CARD_1, TARSKI, XXREAL_0, CARD_3, NAT_1, VALUED_1, SEQFUNC, PDIFF_9,
    XCMPLX_0, SIN_COS, SERIES_1, NFCONT_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, ORDINAL1,
    RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    REAL_1, SQUARE_1, BINOP_1, FINSEQ_1, VALUED_1, FINSEQ_2, RCOMP_1, FDIFF_1,
    SEQFUNC, SIN_COS, FINSEQ_7, EUCLID, TAYLOR_1, PDIFF_1, PDIFF_7,
    PDIFF_9, NFCONT_1, NFCONT_4, MESFUN9C;
  constructors REAL_1, SQUARE_1, BINOP_1, FINSEQ_7, FINSEQ_4, SIN_COS, FDIFF_1,
    PDIFF_1, MONOID_0, INTEGR15, RELSET_1, NFCONT_1, PDIFF_7, TAYLOR_1,
    SEQFUNC, PDIFF_9, NFCONT_4, MESFUNC5, MESFUN9C;
  registrations XBOOLE_0, FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS,
    XXREAL_0, XREAL_0, NAT_1, MEMBERED, VALUED_0, FINSEQ_1, EUCLID,
    VALUED_1, SQUARE_1, RCOMP_1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TARSKI;
  equalities EUCLID, BINOP_1, PDIFF_1, SIN_COS, PDIFF_9, SUBSET_1;
  expansions TARSKI, PDIFF_1, PDIFF_9, TAYLOR_1;

begin

::$P-
theorem
  for n being non zero Element of NAT,
      f being Function of Seg n,Funcs(REAL n,REAL),
      C being Function of [:Seg n,Seg n:],REAL st
    (for i being Nat st i in Seg n holds
      ex fi being Function of REAL n,REAL st
        fi = f.i &
        for j,k being Nat st j in Seg n & k in Seg n holds
          fi is_partial_differentiable_on [#](REAL n),j &
          (fi`partial|([#](REAL n),j))
            is_partial_differentiable_on [#](REAL n),k &
          ex d2 being PartFunc of REAL n,REAL st
            d2 = ((fi`partial|([#](REAL n),j))
              `partial|([#](REAL n),k)) &
            for y being Element of REAL n holds
              d2 is_continuous_in y) &
    (for i,j being Nat st i in Seg n & j in Seg n holds
      ex fi,fj being Function of REAL n,REAL st
        fi = f.i & fj = f.j &
        for x being Element of REAL n holds
          partdiff(fi,x,j) - partdiff(fj,x,i) = C.(i,j))
  holds
    ex g being Function of REAL n,REAL st
      for i being Nat st i in Seg n holds
        ex fi,h being Function of REAL n,REAL st
          fi = f.i &
          (for x being Element of REAL n holds
            h.x = fi.x + partdiff(g,x,i)) &
          (for x,y being Element of REAL n holds
            h.(x+y) = h.x + h.y) &
          (for a being Real, x being Element of REAL n holds
            h.(a*x) = a*h.x)
proof
end;
::$P+
