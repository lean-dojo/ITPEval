:: Statement-only formalization of PutnamBench corpus artifact putnam_1993_a5:
:: the sum of three definite integrals of a squared rational function over
:: specified real intervals is rational. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
      ARYTM_1, ARYTM_3, REAL_1, INT_1, RAT_1, NAT_1, VALUED_0, VALUED_1,
      NEWTON, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5,
      ORDINAL1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, INT_1, RAT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3,
      NEWTON, NAT_1, VALUED_0, VALUED_1, SUPINF_2, MEASURE1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      INT_1, RAT_1, XXREAL_0, NEWTON, NAT_1, MESFUNC1, MESFUNC5,
      MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, RAT_1,
      NEWTON, XXREAL_3, MEASURE1, MEASUR12;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for I,J,K being Subset of REAL,
      f being Function of REAL,REAL st
    I = {x where x is Real : -100 < x & x < -10} &
    J = {x where x is Real :
      (1 qua Real) / 101 < x & x < (1 qua Real) / 11} &
    K = {x where x is Real :
      (101 qua Real) / 100 < x & x < (11 qua Real) / 10} &
    (for x being Real holds
      f.x = (((x |^ 2) - x) / ((x |^ 3) - 3*x + 1)) |^ 2)
  holds
    Integral(L-Meas,f|I) + Integral(L-Meas,f|J) +
      Integral(L-Meas,f|K) in RAT
proof
end;
::$P+
