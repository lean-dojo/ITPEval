:: Statement-only formalization of PutnamBench artifact putnam_1969_b4:
:: every continuous real-plane curve on the unit interval with total variation
:: one is covered by a closed rectangle of area one quarter. This file
:: contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      PARTFUN1, FUNCT_2, NUMBERS, XREAL_0, REAL_1, NAT_1, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, XXREAL_1, RCOMP_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
      VALUED_0, VALUED_1, STRUCT_0, METRIC_1, PRE_TOPC, TOPS_1, TOPS_2,
      TMAP_1, TOPMETR,
      RLVECT_1, RLTOPSP1, EUCLID, CONVEX1, COMPLEX1, SQUARE_1, SIN_COS,
      SIN_COS6;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, NAT_1, XXREAL_0, RCOMP_1, FINSEQ_1, FINSEQ_2, FINSEQOP,
      RVSUM_1, STRUCT_0, METRIC_1, PRE_TOPC, TOPS_2, TMAP_1, TOPMETR,
      TOPREAL6, RLVECT_1, RLTOPSP1,
      EUCLID, CONVEX1, COMPLEX1, SQUARE_1, SIN_COS, SIN_COS6;
 constructors REAL_1, RCOMP_1, FINSEQOP, RVSUM_1, BINOP_2, MONOID_0, METRIC_1,
      TOPMETR, TOPS_2, TMAP_1, RLTOPSP1, EUCLID, TOPREAL6, CONVEX1,
      COMPLEX1, SQUARE_1, SIN_COS, SIN_COS6, RELSET_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      ORDINAL1, NUMBERS, XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, VALUED_0,
      VALUED_1, STRUCT_0, PRE_TOPC, TOPMETR, TMAP_1, RLTOPSP1, EUCLID, CONVEX1,
      COMPLEX1, SQUARE_1, SIN_COS, SIN_COS6, BINOP_2, MEMBERED, MONOID_0;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI;
 equalities FINSEQ_1, RVSUM_1, STRUCT_0, RLVECT_1, EUCLID, SQUARE_1,
      VALUED_1;
 expansions TARSKI, XBOOLE_0, FINSEQ_1, FUNCT_1, RELAT_1, RVSUM_1;

begin

::$P-
theorem
  for f,g being Function of REAL,REAL st
    (for t being Real st t in [.0,1.] holds
      (for e being Real st 0 < e holds
        ex delta being Real st 0 < delta &
          for s being Real st s in [.0,1.] & |.s-t.| < delta holds
            |.f.s-f.t.| < e) &
      (for e being Real st 0 < e holds
        ex delta being Real st 0 < delta &
          for s being Real st s in [.0,1.] & |.s-t.| < delta holds
            |.g.s-g.t.| < e)) &
    (for n being Nat, p,d being FinSequence of REAL st
      1 <= n &
      len p = n+1 &
      p.1 = 0 & p.(n+1) = 1 &
      (for i being Nat st 1 <= i & i <= n holds
        p.i < p.(i+1)) &
      len d = n &
      (for i being Nat st 1 <= i & i <= n holds
        d.i = sqrt ((f.(p.(i+1)) - f.(p.i))^2 +
                    (g.(p.(i+1)) - g.(p.i))^2))
      holds
        ex q being FinSequence of REAL st
          len q = n+1 & q.1 = 0 &
          (for i being Nat st 1 <= i & i <= n holds
            q.(i+1) = q.i + d.i) &
          q.(n+1) <= 1) &
    (for e being Real st 0 < e holds
      ex n being Nat, p,d,q being FinSequence of REAL st
        1 <= n &
        len p = n+1 &
        p.1 = 0 & p.(n+1) = 1 &
        (for i being Nat st 1 <= i & i <= n holds
          p.i < p.(i+1)) &
        len d = n &
        (for i being Nat st 1 <= i & i <= n holds
          d.i = sqrt ((f.(p.(i+1)) - f.(p.i))^2 +
                      (g.(p.(i+1)) - g.(p.i))^2)) &
        len q = n+1 & q.1 = 0 &
        (for i being Nat st 1 <= i & i <= n holds
          q.(i+1) = q.i + d.i) &
        1-e < q.(n+1))
  holds
    ex a,b,c,d being Point of TOP-REAL 2,
       V being Subset of TOP-REAL 2 st
      V = {a,b} \/ {c,d} &
      (for t being Real st t in [.0,1.] holds
        |[f.t,g.t]| in conv(V)) &
      |.a-b.| * |.b-c.| = 1/4 &
      arccos (|(a-b,c-b)| / (|.a-b.| * |.c-b.|)) = PI/2 &
      arccos (|(b-c,d-c)| / (|.b-c.| * |.d-c.|)) = PI/2 &
      arccos (|(c-d,a-d)| / (|.c-d.| * |.a-d.|)) = PI/2 &
      arccos (|(d-a,b-a)| / (|.d-a.| * |.b-a.|)) = PI/2
proof
end;
::$P+
