:: Statement-only formalization of PutnamBench corpus artifact putnam_1997_b5:
:: consecutive heights of base-two tetration are congruent modulo every
:: natural number n at least 2. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, NUMBERS, NAT_1, INT_1, INT_2, NEWTON, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3, VALUED_0, VALUED_1,
    BINOP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, INT_1, INT_2, NAT_1, NAT_D, NEWTON, BINOP_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, NAT_D, INT_1, INT_2,
    NEWTON, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, INT_2, NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat,
      tetration being BinOp of NAT st
    2 <= n &
    (for a being Nat holds tetration.(a,0) = 1) &
    (for a,m being Nat holds
      ex x being Nat st
        x = tetration.(a,m) &
        tetration.(a,m + 1) = (a qua Nat) |^ x)
  holds
    ex x,y being Nat st
      x = tetration.(2,n) &
      y = tetration.(2,n -' 1) &
      x mod n = y mod n
proof
end;
::$P+
