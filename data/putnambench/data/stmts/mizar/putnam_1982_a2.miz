:: Statement-only formalization of PutnamBench corpus artifact putnam_1982_a2:
:: convergence of the series defined from finite real power sums evaluated at
:: logarithms of 2 to varying natural bases. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1,
    FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4, BINOP_1, BINOP_2,
    FUNCOP_1, FINSEQOP, ZFMISC_1, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, FUNCT_7, POWER, PREPOWER, SEQ_1, SEQ_2,
    ORDINAL2, XXREAL_2, SEQ_4, ABIAN, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, SQUARE_1, XXREAL_0, PARTFUN1, BINOP_2,
    SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4,
    VALUED_0, VALUED_1, NAT_1, FINSOP_1, FINSEQOP, SETWOP_2,
    RVSUM_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER,
    ABIAN, XXREAL_2, POWER, SERIES_1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, XXREAL_0, BINOP_1, SETWISEO, NAT_1,
    BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2,
    XXREAL_1, FINSEQ_2, RVSUM_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER,
    ABIAN, COMSEQ_2, POWER, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, FUNCOP_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for B being Function of NAT,Funcs(REAL,REAL),
      f,s being Real_Sequence st
    (for n being Nat, x being Real holds
      ex terms being FinSequence of REAL st
        len terms = n &
        (for k being Nat st k in Seg n holds
          terms.k = (k qua Real) to_power x) &
        (B.n).x = Sum terms) &
    (for n being Nat,
         Bn being Function of REAL,REAL st Bn = B.n holds
      f.n =
        Bn.(log((n qua Real),(2 qua Real))) /
          (((n qua Real) * log((2 qua Real),(n qua Real)))^2)) &
    (for n being Nat holds s.n = f.(n + 2))
  holds Partial_Sums(s) is convergent
proof
end;
::$P+
