:: Statement-only formalization of PutnamBench corpus artifact putnam_1983_a1:
:: the positive natural numbers dividing 10^40 or 20^30 form a set of
:: cardinality 2301. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, RELAT_1, ARYTM_3, CARD_1, XXREAL_0,
    SUBSET_1, ARYTM_1, INT_2, ZFMISC_1, XBOOLE_0, FINSET_1, ORDINAL1,
    TARSKI, NEWTON;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    FINSET_1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_2,
    NEWTON, NAT_D;
  constructors XXREAL_0, NAT_1, NAT_D, INT_2, NEWTON, REAL_1, FINSET_1,
    CARD_1;
  registrations XXREAL_0, XREAL_0, NAT_1, ORDINAL1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, ARITHM;

begin

::$P-
theorem
  card {n where n is Element of NAT :
    0 < n & (n divides (10 |^ 40) or n divides (20 |^ 30))} = 2301
proof
end;
::$P+
