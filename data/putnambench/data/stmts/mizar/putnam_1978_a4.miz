:: Statement-only formalization of PutnamBench artifact putnam_1978_a4:
:: a binary operation satisfying (ab)(cd) = ad has the stated idempotence
:: and left-translation consequences, and admits a finite nontrivial example.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FINSET_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSET_1, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, FINSET_1, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    FINSET_1;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  (for S being set, op being Function of [:S,S:],S st
    (for a,b,c,d being Element of S holds
      op.(op.(a,b),op.(c,d)) = op.(a,d))
  holds
    for a,b,c being Element of S st op.(a,b) = c holds
      op.(c,c) = c &
      (for d being Element of S holds op.(a,d) = op.(c,d))) &
  (ex S being finite set, op being Function of [:S,S:],S st
    (for a,b,c,d being Element of S holds
      op.(op.(a,b),op.(c,d)) = op.(a,d)) &
    (for a being Element of S holds op.(a,a) = a) &
    (ex a,b being Element of S st op.(a,b) = a & a <> b) &
    (ex a,b being Element of S st op.(a,b) <> a))
proof
end;
::$P+
