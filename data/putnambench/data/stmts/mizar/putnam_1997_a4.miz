:: Statement-only formalization of PutnamBench corpus artifact putnam_1997_a4:
:: a group self-map whose products on identity triples agree can be left
:: translated into a homomorphism. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, SUBSET_1,
    STRUCT_0, ALGSTR_0, GROUP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, STRUCT_0, ALGSTR_0, GROUP_1;
  constructors RELSET_1, FUNCT_2, GROUP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    STRUCT_0, GROUP_1;
  requirements SUBSET, BOOLE;
  equalities STRUCT_0, ALGSTR_0;

begin

::$P-
theorem
  for G being Group,
      phi being Function of the carrier of G, the carrier of G
  st (for g1,g2,g3,h1,h2,h3 being Element of G st
        g1 * g2 * g3 = 1_G & h1 * h2 * h3 = 1_G
      holds phi.g1 * phi.g2 * phi.g3 = phi.h1 * phi.h2 * phi.h3)
  holds ex a being Element of G st
    for x,y being Element of G holds
      a * phi.(x * y) = (a * phi.x) * (a * phi.y)
proof
end;
::$P+
