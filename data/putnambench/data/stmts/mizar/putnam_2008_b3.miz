:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_b3:
:: the largest radius of a circle in a two-dimensional affine plane contained
:: in the side-length-one four-dimensional hypercube is sqrt(2)/2. This file
:: contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FINSET_1, FUNCT_1, FUNCT_2, METRIC_1, NAT_1,
      NUMBERS, REAL_1, PRE_TOPC, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1,
      SQUARE_1,
      STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1, XBOOLE_0,
      XCMPLX_0, XREAL_0, XXREAL_0, ZFMISC_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1, CARD_1, RELAT_1,
      FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSET_1, FINSEQ_1, FINSEQ_2,
      SQUARE_1, STRUCT_0, ALGSTR_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1,
      EUCLID, RVSUM_1, TOPMETR;
 constructors ZFMISC_1, REAL_1, SQUARE_1, BINOP_2, COMPLEX1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1, STRUCT_0,
      RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, FINSET_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, NAT_1,
      CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR, BINOP_2,
      MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1, FINSET_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLTOPSP1;
 equalities STRUCT_0, FINSEQ_1, FINSEQ_2, RVSUM_1, SQUARE_1, EUCLID,
      VALUED_1;
 expansions TARSKI, XBOOLE_0, FUNCT_1, RVSUM_1;

begin

::$P-
theorem
  (ex C,P,Q being Point of TOP-REAL 4 st
    (not ex a,b being Real st
      (a <> 0 or b <> 0) &
      a * P + b * Q = P - P) &
    (for s,t being Real st
      |.(s * P + t * Q).| = sqrt 2 / 2
     holds
      ex X being Point of TOP-REAL 4 st
        X = C + s * P + t * Q &
        for i being Nat st i in Seg 4 holds
          |.X.i.| <= 1/2)) &
  (for r being Real st sqrt 2 / 2 < r holds
    not ex C,P,Q being Point of TOP-REAL 4 st
      (not ex a,b being Real st
        (a <> 0 or b <> 0) &
        a * P + b * Q = P - P) &
      (for s,t being Real st
        |.(s * P + t * Q).| = r
       holds
        ex X being Point of TOP-REAL 4 st
          X = C + s * P + t * Q &
          for i being Nat st i in Seg 4 holds
            |.X.i.| <= 1/2))
proof
end;
::$P+
