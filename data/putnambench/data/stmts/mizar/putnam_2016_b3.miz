:: Statement-only formalization of PutnamBench corpus artifact putnam_2016_b3
:: (putnambench__mizar__putnam_2016_b3): every finite set of points in the
:: real plane whose vertex-triangles have area at most 1 is covered by a
:: triangle of area exactly 4. This file contains no proof.

environ

 vocabularies MEASUR14, MEASUR13, FINSEQ_1, FINSEQ_2, NUMBERS, XXREAL_0,
      SUBSET_1, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, REAL_1, FUNCT_1,
      XBOOLE_0, TARSKI, ZFMISC_1, PROB_1, SUPINF_2, VALUED_0, PARTFUN1,
      MEASURE1, MEASURE5, MEASURE8, NAT_1, FUNCT_2, FUNCOP_1, CARD_3,
      FINSUB_1, FINSET_1, SETFAM_1, PROB_2, XCMPLX_0, STRUCT_0, PRE_TOPC,
      RLVECT_1, RLTOPSP1, EUCLID, CONVEX1, RLAFFIN1, MEMBERED;
 notations TARSKI, XBOOLE_0, ZFMISC_1, ENUMSET1, SUBSET_1, SETFAM_1,
      RELAT_1, FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1,
      CARD_1, FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3,
      XREAL_0, VALUED_0, EXTREAL1, NAT_1, FINSET_1, FINSEQ_1, FINSEQ_2,
      STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, SUPINF_2, PROB_1,
      PROB_2, MEASURE1, MEASURE3, MEASURE4, MEASURE5, MEASURE8, MEASUR12,
      MEASUR13, MEASUR14, CONVEX1, RLAFFIN1;
 constructors ENUMSET1, EXTREAL1, SUPINF_1, DOMAIN_1, FINSET_1, FINSEQOP,
      MEASURE3, PROB_3, MEASUR12, MEASUR13, MEASUR14, MEASURE8, EUCLID,
      RLTOPSP1, CONVEX1, RLAFFIN1;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, FINSET_1, FINSEQ_1, FINSEQ_2,
      FUNCT_1, FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9, MEMBERED, SRINGS_4,
      SETFAM_1, MEASUR13, MEASUR14, GLIBPRE1, EUCLID, STRUCT_0, RLVECT_1,
      RLTOPSP1, CONVEX1, RLAFFIN1, XXREAL_3;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions RLTOPSP1, TARSKI, XBOOLE_0;
 equalities FINSEQ_1, BINOP_1, SUBSET_1, MEASUR13, FINSEQ_2, XCMPLX_0,
      STRUCT_0, RLVECT_1, EUCLID;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for S being finite Subset of TOP-REAL 2 st
    (for A,B,C being Point of TOP-REAL 2 st
      A in S & B in S & C in S
    for T being Subset of TOP-REAL 2 st T = {A,B,C}
    holds (C_Meas (XL-Meas 2)).(conv T) <= (1 qua ExtReal))
  holds
    ex A1,B1,C1 being Point of TOP-REAL 2 st
    ex T being Subset of TOP-REAL 2 st
      T = {A1,B1,C1} &
      (C_Meas (XL-Meas 2)).(conv T) = (4 qua ExtReal) &
      S c= conv T
proof
end;
::$P+
