:: Statement-only formalization of PutnamBench artifact putnam_1965_b2:
:: equality of the sums of squared win and loss counts in a finite
:: round-robin tournament. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, VALUED_0, FINSEQ_2, CARD_1,
    RELAT_1, SUBSET_1, XBOOLE_0, FUNCT_1, TARSKI, XREAL_0, ORDINAL4,
    BINOP_1, BINOP_2, ARYTM_1, ARYTM_3, SQUARE_1, FUNCOP_1, REAL_1,
    FINSEQOP, ZFMISC_1, VALUED_1, XXREAL_0, CARD_3, XCMPLX_0, SETWISEO,
    SETWOP_2, FINSOP_1, RVSUM_1, FUNCT_7, ORDINAL1, INT_1, FINSET_1;
  notations TARSKI, SUBSET_1, ZFMISC_1, XTUPLE_0, ORDINAL1, CARD_1,
    NUMBERS, VALUED_0, XBOOLE_0, XCMPLX_0, XXREAL_0, XREAL_0, REAL_1,
    SQUARE_1, RELAT_1, RELSET_1, FUNCT_1, PARTFUN1, BINOP_2, SETWISEO,
    FUNCT_2, BINOP_1, FUNCOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_4, VALUED_1,
    NAT_1, FINSOP_1, FINSEQOP, SETWOP_2, RVSUM_1, INT_1, FINSET_1;
  constructors PARTFUN1, BINOP_1, SETWISEO, SQUARE_1, NAT_1, BINOP_2,
    VALUED_1, FINSEQOP, FINSEQ_4, FINSOP_1, SETWOP_2, RELSET_1,
    XXREAL_1, REAL_1, FINSEQ_2, RVSUM_1, INT_1, FINSET_1, XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    FUNCOP_1, NUMBERS, XCMPLX_0, XREAL_0, SQUARE_1, NAT_1, BINOP_2,
    FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1, RELAT_1, RELSET_1,
    FINSEQ_4, CARD_1, INT_1, RVSUM_1, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
  for won being Relation of Seg n holds
  for w,l being FinSequence of INT st
    n > 1 &
    len w = n & len l = n &
    (for i being Element of Seg n holds not [i,i] in won) &
    (for i,j being Element of Seg n st i <> j holds
      ([i,j] in won iff not [j,i] in won)) &
    (for r being Element of Seg n holds
      w.r = card { j where j is Element of Seg n : [r,j] in won }) &
    (for r being Element of Seg n holds
      l.r = (n qua Integer) - 1 - w.r)
  holds Sum sqr w = Sum sqr l
proof
end;
::$P+
