:: Statement-only formalization of PutnamBench artifact putnam_1963_a2:
:: a strictly increasing sequence of positive natural numbers that fixes 2
:: and is multiplicative on coprime positive inputs is the identity on the
:: positive natural numbers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1, INT_1, INT_2, BINOP_1, BINOP_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    INT_1, INT_2, BINOP_1, BINOP_2;
  constructors XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, RELSET_1, FUNCT_2,
    INT_1, INT_2, BINOP_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, FUNCT_1, RELSET_1, FUNCT_2, MEMBERED, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT st
    (for n being Nat holds
      ex k being Nat st f.n = k & 0 < k) &
    (for i,j being Nat st 0 < i & i < j holds
      ex a,b being Nat st f.i = a & f.j = b & a < b) &
    f.2 = 2 &
    (for m,n being Nat st
      0 < m & 0 < n & m,n are_coprime
    holds f.(m * n) = multnat.(f.m,f.n))
  holds for n being Nat st 0 < n holds f.n = n
proof
end;
::$P+
