:: Statement-only formalization of PutnamBench corpus artifact putnam_1985_a3:
:: for the doubly indexed real recurrence starting at d/2^m, the diagonal
:: sequence converges to exp(d)-1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, BINOP_1, BINOP_2, NUMBERS, XCMPLX_0, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2, SEQ_4, POWER, SIN_COS;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, BINOP_1, BINOP_2, NEWTON,
    PREPOWER, POWER, SIN_COS;
  constructors NUMBERS, XCMPLX_0, XREAL_0, FUNCT_1, SUBSET_1, RELSET_1,
    FUNCT_2, CARD_1, REAL_1, COMPLEX1, XXREAL_0, NAT_1, SEQ_2, SEQM_3,
    SEQ_4, COMSEQ_2, ZFMISC_1, BINOP_1, BINOP_2, NEWTON, PREPOWER,
    POWER, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, REAL_1, ORDINAL1, NAT_1, SEQ_4, NEWTON,
    PREPOWER, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for d being Real,
      a being Function of [:NAT,NAT:],REAL,
      s being Real_Sequence st
    (for m being Nat holds
      a.(m,0) = d / ((2 qua Real) |^ m)) &
    (for m,j being Nat holds
      ex x being Real st
        x = a.(m,j) &
        a.(m,j + 1) = x * x + 2 * x) &
    (for n being Nat holds s.n = a.(n,n))
  holds
    s is convergent & lim s = exp_R.d - 1
proof
end;
::$P+
