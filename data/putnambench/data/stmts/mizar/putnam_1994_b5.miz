:: Statement-only formalization of PutnamBench corpus artifact putnam_1994_b5:
:: for every positive natural n, some real alpha makes both the k-fold
:: iteration of x |-> floor(alpha*x) at n^2 and floor(alpha^k*n^2) equal
:: n^2-k for all 1 <= k <= n. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      FUNCT_7, NAT_1, INT_1, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3,
      REAL_1, ORDINAL1, CARD_1, XCMPLX_0, VALUED_0, NEWTON;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
      XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NAT_1, NAT_D,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FUNCT_7, NEWTON;
 constructors REAL_1, INT_1, NAT_1, NAT_D, FUNCT_7, RELSET_1, FUNCT_2,
      NEWTON;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
      NAT_1, INT_1, CARD_1, MEMBERED, VALUED_0, NEWTON, FUNCT_7;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n > 0 holds
    ex a being Real st
    ex fa being Function of INT,INT st
    ex N being Nat st
      N = n |^ 2 &
      (for x being Integer holds fa.x = [\ a*x /]) &
      for k being Nat st 1 <= k & k <= n holds
        iter(fa,k).N = N -' k &
        [\ (a |^ k) * N /] = N -' k
proof
end;
::$P+
