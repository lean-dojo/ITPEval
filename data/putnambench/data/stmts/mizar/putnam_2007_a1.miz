:: Statement-only formalization of PutnamBench corpus artifact putnam_2007_a1:
:: the quadratic curves y = a*x^2+a*x+1/24 and x = a*y^2+a*y+1/24
:: are tangent exactly for four specified real values of a. This file
:: contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, SQUARE_1, ZFMISC_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, ORDINAL1, RELAT_1,
    FUNCT_1, FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1,
    RELSET_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1,
    PARTFUN2, RCOMP_1, FDIFF_1, COMPLEX1, SQUARE_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FDIFF_1, VALUED_1, XXREAL_2, COMPLEX1,
    SQUARE_1, RELSET_1, BINOP_2, COMSEQ_2, ZFMISC_1;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    ORDINAL1, SQUARE_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0;
  expansions TARSKI;

begin

::$P-
theorem
  for a being Real holds
    ((ex f being Function of REAL,REAL st
        (for t being Real holds
          f.t = a*t^2 + a*t + 1/24) &
        ex x,y being Real st
          f.x = y &
          f.y = x &
          diff(f,x) * diff(f,y) = 1)
    iff
      a in ({(2 qua Real)/3,(3 qua Real)/2} \/
        {(13 + sqrt 601)/12,(13 - sqrt 601)/12}))
proof
end;
::$P+
