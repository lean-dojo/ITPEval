:: Statement-only formalization of PutnamBench artifact putnam_1977_a3:
:: two symmetric averaging identities determine a real-valued function by
:: an explicit combination of two given real functions. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
    NAT_1, INT_1, VALUED_0, VALUED_1;
  constructors RELSET_1, FUNCT_2, REAL_1, NAT_1, INT_1, VALUED_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f,g,h being Function of REAL,REAL st
    (for x being Real holds
      f.x = (h.(x + 1) + h.(x - 1)) / 2) &
    (for x being Real holds
      g.x = (h.(x + 4) + h.(x - 4)) / 2)
  holds
    for x being Real holds
      h.x = g.x - f.(x - 3) + f.(x - 1) + f.(x + 1) - f.(x + 3)
proof
end;
::$P+
