:: Statement-only formalization of PutnamBench corpus artifact putnam_1982_a4:
:: the unique global continuously differentiable real solution of the coupled
:: system y' = -z^3, z' = y^3 with initial values (1,0) has a common positive
:: period. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1,
    CARD_1, RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, FDIFF_1, COMPLEX1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2,
    FCONT_1, ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f,g being Function of REAL,REAL st
    (ex df,dg being Function of REAL,REAL st
      f is_differentiable_on [#]REAL &
      g is_differentiable_on [#]REAL &
      (for x being Real holds df.x = diff(f,x)) &
      (for x being Real holds dg.x = diff(g,x)) &
      df is continuous &
      dg is continuous &
      f.0 = 1 &
      g.0 = 0 &
      (for x being Real holds
        df.x = -(g.x * g.x * g.x) &
        dg.x = f.x * f.x * f.x)) &
    (for f1,g1 being Function of REAL,REAL st
      (ex df1,dg1 being Function of REAL,REAL st
        f1 is_differentiable_on [#]REAL &
        g1 is_differentiable_on [#]REAL &
        (for x being Real holds df1.x = diff(f1,x)) &
        (for x being Real holds dg1.x = diff(g1,x)) &
        df1 is continuous &
        dg1 is continuous &
        f1.0 = 1 &
        g1.0 = 0 &
        (for x being Real holds
          df1.x = -(g1.x * g1.x * g1.x) &
          dg1.x = f1.x * f1.x * f1.x))
    holds f1 = f & g1 = g)
  holds
    ex L being Real st
      0 < L &
      for x being Real holds
        f.(x+L) = f.x &
        g.(x+L) = g.x
proof
end;
::$P+
