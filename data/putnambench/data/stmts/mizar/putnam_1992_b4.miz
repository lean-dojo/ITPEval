:: Statement-only formalization of PutnamBench corpus artifact putnam_1992_b4:
:: the smallest possible numerator degree after differentiating the specified
:: rational function 1992 times is 3984.  Derivatives are taken on the
:: natural domain excluding the poles -1, 0, and 1; equality with f/g is
:: required wherever both rational functions are defined. This file
:: contains no proof.

environ

  vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1,
    NAT_1, POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0,
    POLYNOM3, FUNCT_4, STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0,
    ALGSEQ_1, FUNCT_1, SUPINF_2, NUMBERS, VALUED_0, MESFUNC1,
    FINSEQ_1, AFINSQ_1, RLVECT_1, CARD_3, BINOP_1, TARSKI,
    POLYNOM5, PARTFUN1, LATTICES, ORDINAL4, FINSEQ_2, VECTSP_2,
    ZFMISC_1, FUNCT_2, COMPLEX1, VALUED_1, FINSET_1, FDIFF_1,
    RCOMP_1, REALSET1, POLYDIFF, NEWTON, TAYLOR_1, XXREAL_1,
    SEQ_1, SERIES_1, SIN_COS, SEQ_2, ORDINAL2, ABIAN, TAYLOR_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSET_1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, REAL_1, COMPLEX1, NAT_1,
    VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, FUNCT_7, STRUCT_0,
    ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2,
    ALGSEQ_1, POLYNOM3, POLYNOM4, POLYNOM5, FDIFF_1, POLYDIFF,
    RFUNCT_2, RCOMP_1, SEQ_1, COMSEQ_2, SEQ_2, SERIES_1, SEQFUNC,
    NEWTON, SIN_COS, TAYLOR_1, ABIAN;
  constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2,
    FINSEQ_4, VECTSP_2, ALGSTR_1, FUNCT_1, RELSET_1, FUNCT_2,
    CARD_1, FINSET_1, REAL_1, COMPLEX1, NAT_1, POLYDIFF, ARYTM_0,
    SEQ_2, RCOMP_1, RFUNCT_2, LIMFUNC1, FDIFF_1, COMSEQ_3,
    SIN_COS, ABIAN, TAYLOR_1, SEQFUNC, SERIES_1, VALUED_1,
    COMSEQ_2;
  registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0,
    VECTSP_1, CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0,
    RLVECT_1, MEMBERED, RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS,
    FUNCT_2, XBOOLE_0, NAT_1, VALUED_0, VALUED_1, FINSEQ_1,
    FINSEQ_2, VECTSP_2, ALGSTR_1, FINSET_1, POLYDIFF, RCOMP_1,
    NEWTON, SIN_COS, INT_1;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1,
    TAYLOR_1;
  equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
    ALGSTR_0, POLYDIFF, VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, ALGSEQ_1, POLYNOM5, TAYLOR_1;

begin

::$P-
theorem
  (ex p,f,g being Polynomial of F_Real,
      h being Function of REAL,REAL,
      D being Subset of REAL st
    p <> 0_.F_Real &
    len p <= 1992 &
    (for d being Polynomial of F_Real st
      (ex a being Polynomial of F_Real st p = d *' a) &
      (ex b being Polynomial of F_Real st
        ((<%0.F_Real,1.F_Real%>`^3) -
          <%0.F_Real,1.F_Real%>) = d *' b)
    holds len d <= 1) &
    g <> 0_.F_Real &
    D = {x where x is Real : x <> -1 & x <> 0 & x <> 1} &
    (for x being Element of F_Real holds
      h.x = eval(p,x) / (x |^ 3 - x)) &
    h is_differentiable_on 1992,D &
    (for x being Element of F_Real st
      x in D & eval(g,x) <> 0 holds
      (diff(h,D).1992).x = eval(f,x) / eval(g,x)) &
    len f = 3985) &
  (for p,f being Polynomial of F_Real st
    p <> 0_.F_Real &
    len p <= 1992 &
    (for d being Polynomial of F_Real st
      (ex a being Polynomial of F_Real st p = d *' a) &
      (ex b being Polynomial of F_Real st
        ((<%0.F_Real,1.F_Real%>`^3) -
          <%0.F_Real,1.F_Real%>) = d *' b)
    holds len d <= 1) &
    (ex g being Polynomial of F_Real,
        h being Function of REAL,REAL,
        D being Subset of REAL st
      g <> 0_.F_Real &
      D = {x where x is Real : x <> -1 & x <> 0 & x <> 1} &
      (for x being Element of F_Real holds
        h.x = eval(p,x) / (x |^ 3 - x)) &
      h is_differentiable_on 1992,D &
      (for x being Element of F_Real st
        x in D & eval(g,x) <> 0 holds
        (diff(h,D).1992).x = eval(f,x) / eval(g,x)))
  holds 3985 <= len f)
proof
end;
::$P+
