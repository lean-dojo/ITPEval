:: Statement-only formalization of PutnamBench corpus artifact putnam_1994_a6:
:: ten integer permutations with a transitive orbit from zero have at most
:: 512 ordered subset-compositions stabilizing any nonempty finite integer set.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, FINSET_1, CARD_1, NUMBERS, NAT_1, INT_1,
    XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSET_1, CARD_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, INT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSET_1,
    CARD_1, XTUPLE_0, NAT_1, NAT_D, INT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FINSEQ_1, FINSET_1, CARD_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, INT_1, MEMBERED, ZFMISC_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for f being Function of Seg 10,Funcs(INT,INT),
      mijcomp being Function of
        [:[:NAT,Funcs(NAT,Seg 10):],NAT:],Funcs(INT,INT) st
    (for k being Element of Seg 10 holds
      f.k is one-to-one & rng (f.k) = INT) &
    (for n being Integer holds
      ex m being Nat, i being Function of NAT,Seg 10 st
        1 <= m & (mijcomp.[[m,i],0]).0 = n) &
    (for m being Nat, i being Function of NAT,Seg 10,
        j being Nat st 1 <= m & j < m holds
      (j = m -' 1 implies mijcomp.[[m,i],j] = f.(i.j)) &
      (j <> m -' 1 implies
        mijcomp.[[m,i],j] = (f.(i.j)) * mijcomp.[[m,i],j+1]))
  holds
    for A being finite Subset of INT st A <> {} holds
      ex S being finite set st
        S = {g where g is Function of INT,INT :
          (ex g1,g2,g3,g4,g5,g6,g7,g8,g9,g10
              being Function of INT,INT st
            (g1 = id INT or g1 = f.1) &
            (g2 = id INT or g2 = f.2) &
            (g3 = id INT or g3 = f.3) &
            (g4 = id INT or g4 = f.4) &
            (g5 = id INT or g5 = f.5) &
            (g6 = id INT or g6 = f.6) &
            (g7 = id INT or g7 = f.7) &
            (g8 = id INT or g8 = f.8) &
            (g9 = id INT or g9 = f.9) &
            (g10 = id INT or g10 = f.10) &
            g = g1 * g2 * g3 * g4 * g5 * g6 * g7 * g8 * g9 * g10) &
          g.:A = A} &
        card S <= 512
proof
end;
::$P+
