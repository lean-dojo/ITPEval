:: Statement-only formalization of PutnamBench corpus artifact putnam_2021_b4
:: (putnambench__mizar__putnam_2021_b4): the residue modulo a Fibonacci
:: number of the product of k^k over the preceding positive integers is
:: itself a Fibonacci number. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1, MEMBERED;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for F being Function of NAT,NAT st
    F.0 = 0 &
    F.1 = 1 &
    (for n being Nat holds
      F.(n + 2) = F.(n + 1) + F.n)
  holds
    for m being Nat st m > 2 holds
      ex p,q being Nat, terms being FinSequence of NAT st
        len terms = F.m -' 1 &
        (for k being Nat st k in Seg (F.m -' 1) holds
          terms.k = k |^ k) &
        Product terms = q &
        q mod F.m = F.p
proof
end;
::$P+
