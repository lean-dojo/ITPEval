:: Statement-only formalization of PutnamBench corpus artifact putnam_1994_b2:
:: a real quartic admits a straight line with exactly four distinct real
:: intersection abscissas exactly when c < 243/8. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, NAT_1, INT_1, NEWTON;
  constructors RELSET_1, FUNCT_2, CARD_1, REAL_1, NAT_1, INT_1, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for c being Real holds
    ((ex m,b being Real st
      card {x where x is Real :
        m * x + b =
          x |^ 4 + 9 * (x |^ 3) + c * (x |^ 2) + 9 * x + 4} = 4)
      iff c < 243 / 8)
proof
end;
::$P+
