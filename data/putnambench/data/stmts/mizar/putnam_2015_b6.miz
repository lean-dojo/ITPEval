:: Statement-only formalization of PutnamBench corpus artifact putnam_2015_b6:
:: the alternating reciprocal sum weighted by the number of odd divisors of k
:: below sqrt(2*k) converges to PI^2/16. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, INT_2, NAT_1, FINSET_1,
    VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL2,
    XXREAL_2, SEQ_4, POWER, ABIAN, ORDINAL1, SERIES_1, SIN_COS,
    RVSUM_1, FINSEQ_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, FINSET_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, INT_1, INT_2, COMPLEX1, SQUARE_1, XXREAL_0,
    NEWTON, NAT_1, NAT_D, FINSEQ_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
    SEQ_4, PREPOWER, ABIAN, XXREAL_2, POWER, RVSUM_1, SERIES_1,
    SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, FINSET_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, INT_2, XXREAL_0, NEWTON, NAT_1,
    NAT_D, SEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, BINOP_2,
    COMSEQ_2, POWER, RVSUM_1, SERIES_1, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, FINSET_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1,
    INT_2, NEWTON, PREPOWER, SEQ_4, ABIAN, FINSEQ_1, RVSUM_1,
    SIN_COS, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;

begin

::$P-
theorem
  for A being Function of NAT,NAT, s being Real_Sequence st
    (for k being Nat st 0 < k holds
      A.k = card {j where j is Element of NAT :
        j is odd & j divides k &
        (j qua Real) < sqrt(2 * (k qua Real))}) &
    (for n being Nat holds
      s.n = (((-1) qua Real) |^ n) *
        ((A.(n + 1) qua Real) / ((n + 1) qua Real)))
  holds
    Partial_Sums(s) is convergent &
    lim Partial_Sums(s) = PI^2 / 16
proof
end;
::$P+
