:: Statement-only formalization of PutnamBench corpus artifact putnam_2025_a5
:: (putnambench__mizar__putnam_2025_a5): the sign sequences maximizing the
:: number of permutations with prescribed adjacent ascent and descent signs
:: are exactly the two alternating sign sequences. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, NUMBERS, NAT_1,
    INT_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1,
    NEWTON, ARYTM_1, ARYTM_3, CARD_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D,
    RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2,
    MATRIX_0, MATRIX_1, FINSET_1, NEWTON;
  constructors RELSET_1, PARTFUN1, FINSEQ_4, MATRIX_1, NAT_1, NAT_D,
    NEWTON, FINSET_1, INT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, MATRIX_1, FINSET_1,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, NEWTON, VALUED_0, VALUED_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  definitions TARSKI;
  equalities FINSEQ_1;
  expansions TARSKI, FINSEQ_1;

begin

::$P-
theorem
  for n being Nat, s being Function of Seg n,INT st
    1 <= n &
    (for i being Nat st i in Seg n holds s.i = -1 or s.i = 1)
  holds
    ((for t being Function of Seg n,INT st
        (for i being Nat st i in Seg n holds t.i = -1 or t.i = 1)
      holds
        card {p where p is Permutation of Seg (n + 1) :
          for i being Nat st i in Seg n holds
            ex x,y,z being Integer st
              x = p.(i + 1) & y = p.i & z = t.i &
              0 < z * (x - y)}
        c=
        card {p where p is Permutation of Seg (n + 1) :
          for i being Nat st i in Seg n holds
            ex x,y,z being Integer st
              x = p.(i + 1) & y = p.i & z = s.i &
              0 < z * (x - y)})
    iff
      ((for i being Nat st i in Seg n holds
          s.i = ((-1 qua Integer) |^ i)) or
       (for i being Nat st i in Seg n holds
          s.i = ((-1 qua Integer) |^ (i -' 1)))))
proof
end;
::$P+
