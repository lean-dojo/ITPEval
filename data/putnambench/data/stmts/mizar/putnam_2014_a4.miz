:: Statement-only formalization of PutnamBench corpus artifact putnam_2014_a4:
:: among probability distributions on the nonnegative integers with first
:: three moments 1, 2, and 5, the smallest possible mass at zero is 1/3.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1, ORDINAL2,
    NEWTON, PREPOWER, SEQ_1, SEQ_2, SEQ_4, SERIES_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    COMPLEX1, XXREAL_0, NAT_1, NEWTON, PREPOWER, VALUED_0, VALUED_1,
    SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, SERIES_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    XXREAL_0, NAT_1, NEWTON, PREPOWER, SEQ_2, SEQM_3, SEQ_4,
    BINOP_2, COMSEQ_2, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER, SEQ_4;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  (for p,m1,m2,m3 being Real_Sequence st
    (for n being Nat holds 0 <= p.n & p.n <= 1) &
    (for n being Nat holds
      m1.n = (n qua Real) * p.n &
      m2.n = ((n qua Real) |^ 2) * p.n &
      m3.n = ((n qua Real) |^ 3) * p.n) &
    Partial_Sums(p) is convergent &
    lim Partial_Sums(p) = 1 &
    Partial_Sums(m1) is convergent &
    lim Partial_Sums(m1) = 1 &
    Partial_Sums(m2) is convergent &
    lim Partial_Sums(m2) = 2 &
    Partial_Sums(m3) is convergent &
    lim Partial_Sums(m3) = 5
  holds
    (1 qua Real) / 3 <= p.0) &
  ex p,m1,m2,m3 being Real_Sequence st
    (for n being Nat holds 0 <= p.n & p.n <= 1) &
    (for n being Nat holds
      m1.n = (n qua Real) * p.n &
      m2.n = ((n qua Real) |^ 2) * p.n &
      m3.n = ((n qua Real) |^ 3) * p.n) &
    Partial_Sums(p) is convergent &
    lim Partial_Sums(p) = 1 &
    Partial_Sums(m1) is convergent &
    lim Partial_Sums(m1) = 1 &
    Partial_Sums(m2) is convergent &
    lim Partial_Sums(m2) = 2 &
    Partial_Sums(m3) is convergent &
    lim Partial_Sums(m3) = 5 &
    p.0 = (1 qua Real) / 3
proof
end;
::$P+
