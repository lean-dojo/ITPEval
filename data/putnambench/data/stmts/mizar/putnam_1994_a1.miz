:: Statement-only formalization of PutnamBench corpus artifact putnam_1994_a1:
:: a positive real sequence dominated by the sum of its two binary descendants
:: has partial sums from index 1 diverging to positive infinity. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
    PREPOWER, SEQ_1, SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN,
    ORDINAL1, SERIES_1, LIMFUNC1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, XXREAL_2,
    POWER, SERIES_1, LIMFUNC1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, NEWTON, NAT_1, SEQ_2, SEQM_3, SEQ_4,
    PREPOWER, ABIAN, BINOP_2, COMSEQ_2, POWER, SERIES_1, LIMFUNC1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    PREPOWER, SEQ_4, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Real_Sequence st
    (for n being Nat st n >= 1 holds
      0 < a.n &
      a.n <= a.(2 * n) + a.(2 * n + 1))
  holds Partial_Sums(a^\1) is divergent_to+infty
proof
end;
::$P+
