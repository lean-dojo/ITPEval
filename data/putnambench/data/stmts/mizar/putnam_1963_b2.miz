:: Statement-only formalization of PutnamBench artifact putnam_1963_b2:
:: the set of positive real numbers is contained in the closure of the
:: integer-power products 2^m * 3^n. This file contains no proof.

environ

  vocabularies NUMBERS, TARSKI, XBOOLE_0, ZFMISC_1, CARD_1, ARYTM_3,
    TOPMETR, BORSUK_2, PRE_TOPC, XXREAL_0, XXREAL_1, SUBSET_1, RELAT_1,
    STRUCT_0, TREAL_1, VALUED_1, FUNCT_1, BORSUK_1, ORDINAL2, GRAPH_1,
    ARYTM_1, RELAT_2, XREAL_0, CONNSP_1, REAL_1, LIMFUNC1, METRIC_1,
    COMPLEX1, RAT_1, POWER, IRRAT_1, INT_1, XCMPLX_0, RCOMP_1, PCOMPS_1,
    XXREAL_2, SEQ_4, SETFAM_1, BORSUK_5, MEASURE5;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, ENUMSET1, FUNCT_1, FUNCT_2, XXREAL_2,
    MEASURE6, STRUCT_0, INT_1, COMPLEX1, PRE_TOPC, TOPS_2, COMPTS_1,
    RCOMP_1, SEQ_4, TREAL_1, CONNSP_1, BORSUK_2, TOPMETR, LIMFUNC1,
    IRRAT_1, RAT_1, MEASURE5, METRIC_1, PCOMPS_1, XXREAL_0, POWER;
  constructors COMPLEX1, PROB_1, LIMFUNC1, POWER, CONNSP_1, TOPS_2,
    COMPTS_1, TREAL_1, MEASURE6, BORSUK_2, INTEGRA1, SEQ_4, BINOP_2,
    PCOMPS_1;
  registrations XBOOLE_0, SUBSET_1, RELSET_1, FINSET_1, XXREAL_0,
    XREAL_0, INT_1, RAT_1, MEMBERED, STRUCT_0, PRE_TOPC, TOPS_1, METRIC_1,
    TOPMETR, BORSUK_2, TOPREAL6, FCONT_3, RCOMP_1, MEASURE5, ORDINAL1;
  requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;
  definitions XBOOLE_0, TARSKI, BORSUK_2;
  equalities SUBSET_1, STRUCT_0, LIMFUNC1, PROB_1;
  expansions TARSKI, BORSUK_2, TOPS_2;
  theorems BORSUK_1, PRE_TOPC, COMPTS_1, TARSKI, TOPMETR, RCOMP_1,
    CONNSP_1, ZFMISC_1, XREAL_0, TREAL_1, XBOOLE_0, XBOOLE_1, SEQ_4,
    INTEGRA1, FUNCT_2, TOPS_1, BORSUK_4, BORSUK_2, ENUMSET1, RAT_1,
    METRIC_1, ABSVALUE, XCMPLX_1, CARD_2, INT_1, YELLOW_8, IRRAT_1,
    NUMBERS, XREAL_1, SUBSET_1, GOBOARD6, XXREAL_0, XXREAL_1, XXREAL_2,
    MEASURE5;

begin

::$P-
theorem
  for S being Subset of R^1 st
    S = {x where x is Real :
      ex m,n being Integer st
        x = (2 to_power m) * (3 to_power n)}
  holds
    for x being Real st 0 < x holds x in Cl S
proof
end;
::$P+
