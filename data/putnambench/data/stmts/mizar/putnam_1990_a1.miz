:: Statement-only formalization of PutnamBench corpus artifact putnam_1990_a1:
:: the integer sequence with the stated third-order recurrence equals the sum
:: of the factorial and powers-of-two sequences. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, REAL_1, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1,
    ARYTM_3, CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, REAL_1, INT_1, NEWTON, RELAT_1,
    FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1,
    NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, NEWTON, VALUED_0, VALUED_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for T being Function of NAT,INT st
    T.0 = 2 &
    T.1 = 3 &
    T.2 = 6 &
    (for n being Nat holds
      T.(n + 3) =
        ((n + 7) qua Integer) * T.(n + 2) -
        4 * ((n + 3) qua Integer) * T.(n + 1) +
        ((4 * n + 4) qua Integer) * T.n)
  holds
    for n being Nat holds
      T.n = ((n!) qua Integer) + ((2 qua Integer) |^ n)
proof
end;
::$P+
