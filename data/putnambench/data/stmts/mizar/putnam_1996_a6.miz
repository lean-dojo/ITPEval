:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_a6:
:: the complete classification of continuous real functions satisfying
:: f(x) = f(x^2+c) for a positive real parameter c. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, COMPLEX1, SUBSET_1, SEQ_1, PARTFUN1,
    ARYTM_3, XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1,
    VALUED_0, SEQ_2, VALUED_1, FUNCT_2, FCONT_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XXREAL_0, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, COMPLEX1, NEWTON;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, VALUED_1, XXREAL_2, COMPLEX1,
    RELSET_1, BINOP_2, COMSEQ_2, NEWTON;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for c being Real, f being Function of REAL,REAL st c > 0 holds
    ((f is continuous &
      for x being Real holds f.x = f.(x*x + c))
    iff
      ((c <= 1/4 &
        ex d being Real st
          for x being Real holds f.x = d) or
       (c > 1/4 &
        f|[.0,c.] is continuous &
        f.0 = f.c &
        (for x being Real st x > 0 holds f.x = f.(x*x + c)) &
        for x being Real st x < 0 holds f.x = f.(-x))))
proof
end;
::$P+
