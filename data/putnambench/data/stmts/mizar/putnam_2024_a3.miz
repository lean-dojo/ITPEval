:: Statement-only formalization of PutnamBench corpus artifact putnam_2024_a3
:: (putnambench__mizar__putnam_2024_a3): existence of two positions whose
:: order is shared by between one-third and two-thirds of the increasing
:: bijective 3 by 2024 tableaux. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, BINOP_1, BINOP_2, NUMBERS, NAT_1, CARD_1, XCMPLX_0,
    XREAL_0, XXREAL_0, ORDINAL1, FINSEQ_1, FINSET_1, ARYTM_1,
    ARYTM_3, CARD_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, BINOP_1, BINOP_2, FINSEQ_1, FINSET_1;
  constructors SUBSET_1, RELSET_1, PARTFUN1, XREAL_0, NAT_1, FINSEQ_1,
    FINSET_1, CARD_1, ZFMISC_1, FUNCT_2, BINOP_1, BINOP_2;
  registrations XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSEQ_1, FINSET_1, ORDINAL1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, MEMBERED, FRAENKEL;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for S being finite set st
    S =
      {t where t is Function of [:NAT,NAT:],NAT :
        (t | [:Seg 3,Seg 2024:]) is one-to-one &
        rng (t | [:Seg 3,Seg 2024:]) = Seg 6072 &
        (for j being Nat st j in Seg 2024 holds
          ex x1,x2,x3 being Nat st
            x1 = t.(1,j) & x2 = t.(2,j) & x3 = t.(3,j) &
            x1 < x2 & x2 < x3) &
        (for i,j being Nat st i in Seg 3 & j in Seg 2023 holds
          ex x,y being Nat st
            x = t.(i,j) & y = t.(i,j+1) & x < y) &
        (for i,j being Nat st
          not (i in Seg 3 & j in Seg 2024) holds t.(i,j) = 0)}
  holds
    ex a,b,c,d being Nat, A being finite set st
      a in Seg 3 & b in Seg 2024 &
      c in Seg 3 & d in Seg 2024 &
      A =
        {t where t is Function of [:NAT,NAT:],NAT :
          t in S &
          (ex x,y being Nat st
            x = t.(a,b) & y = t.(c,d) & x < y)} &
      card S <= 3 * card A &
      3 * card A <= 2 * card S
proof
end;
::$P+
