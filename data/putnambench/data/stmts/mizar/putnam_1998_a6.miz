:: Statement-only formalization of PutnamBench corpus artifact putnam_1998_a6:
:: three distinct lattice points satisfying the stated perimeter-area
:: inequality form three vertices of a square. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, SQUARE_1, XXREAL_0;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for xA,yA,xB,yB,xC,yC being Real st
    (ex iA,jA,iB,jB,iC,jC being Integer st
      xA = (iA qua Real) & yA = (jA qua Real) &
      xB = (iB qua Real) & yB = (jB qua Real) &
      xC = (iC qua Real) & yC = (jC qua Real)) &
    (xA <> xB or yA <> yB) &
    (xA <> xC or yA <> yC) &
    (xB <> xC or yB <> yC) &
    (sqrt((xA-xB)^2 + (yA-yB)^2) +
       sqrt((xB-xC)^2 + (yB-yC)^2))^2 <
      8 * (|.(xB-xA)*(yC-yA) - (yB-yA)*(xC-xA).| / 2) + 1
  holds
    (sqrt((xA-xB)^2 + (yA-yB)^2) =
       sqrt((xC-xB)^2 + (yC-yB)^2) &
       (xA-xB)*(xC-xB) + (yA-yB)*(yC-yB) = 0) or
    (sqrt((xB-xC)^2 + (yB-yC)^2) =
       sqrt((xA-xC)^2 + (yA-yC)^2) &
       (xB-xC)*(xA-xC) + (yB-yC)*(yA-yC) = 0) or
    (sqrt((xC-xA)^2 + (yC-yA)^2) =
       sqrt((xB-xA)^2 + (yB-yA)^2) &
       (xC-xA)*(xB-xA) + (yC-yA)*(yB-yA) = 0)
proof
end;
::$P+
