:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_b2:
:: the functions obtained by repeatedly integrating the real logarithm from
:: zero to x have factorial-normalized values at one whose quotient by ln(n)
:: converges to -1. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1, REALSET1, CARD_3,
    VALUED_0, VALUED_1, ORDINAL1, NEWTON, PREPOWER, SEQ_1, SEQ_2,
    ORDINAL2, SEQ_4, RCOMP_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
    MEASUR12, INTEGRA5, SIN_COS, TAYLOR_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NAT_1, INT_1,
    NAT_D, NEWTON, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2,
    SEQM_3, SEQ_4, SIN_COS, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
    MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, TAYLOR_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, NAT_D, NEWTON, NUMBERS, SEQ_2, SEQM_3, SEQ_4, COMSEQ_2,
    SIN_COS, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, BINOP_2, TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    SEQ_4, XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0, TAYLOR_1;
  equalities VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, RELAT_1, TAYLOR_1;

begin

::$P-
theorem
  for F being Function of NAT,Funcs(REAL,REAL),
      s being Real_Sequence st
    (for F0 being Function of REAL,REAL st F0 = F.0 holds
      for x being Real holds F0.x = ln.x) &
    (for n being Nat,
         Fn,Fn1 being Function of REAL,REAL st
       Fn = F.n & Fn1 = F.(n+1)
     holds
       for x being Real st 0 < x holds
         ex I being Subset of REAL st
           I = {t where t is Real : 0 < t & t < x} &
           Fn1.x = Integral(L-Meas,Fn|I)) &
    (for n being Nat holds
      ex Fn being Function of REAL,REAL st
        Fn = F.n &
        s.n = ((n !) qua Real) * Fn.1 / ln.(n qua Real))
  holds s is convergent & lim s = -1
proof
end;
::$P+
