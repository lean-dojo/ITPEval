:: Statement-only formalization of PutnamBench corpus artifact putnam_1996_b3:
:: the maximum cyclic adjacent-product sum over permutations of 1 through n
:: has the stated cubic value for every n at least 2. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, REALSET1,
    VALUED_0, VALUED_1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D, NEWTON;
  constructors REAL_1, NAT_D, RELSET_1, FUNCT_2, NUMBERS, RVSUM_1,
    FINSEQOP, NEWTON;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1,
    NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n >= 2 holds
    (ex x being Function of NAT,NAT,
        terms being FinSequence of NAT st
      x.:Segm n = Seg n &
      len terms = n &
      (for i being Nat st i in Seg n holds
        terms.i = x.(i -' 1) * x.(i mod n)) &
      Sum terms =
        (2 * (n |^ 3) + 3 * (n |^ 2) + 18 -' 11 * n) div 6) &
    (for x being Function of NAT,NAT,
         terms being FinSequence of NAT st
      x.:Segm n = Seg n &
      len terms = n &
      (for i being Nat st i in Seg n holds
        terms.i = x.(i -' 1) * x.(i mod n))
    holds
      Sum terms <=
        (2 * (n |^ 3) + 3 * (n |^ 2) + 18 -' 11 * n) div 6)
proof
end;
::$P+
