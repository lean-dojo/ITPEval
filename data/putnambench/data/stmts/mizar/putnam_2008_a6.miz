:: Statement-only formalization of PutnamBench corpus artifact putnam_2008_a6:
:: a universal positive constant gives every nontrivial finite group a
:: logarithmic-length sequence whose ordered subsequence products cover the
:: group. This file contains no proof.

environ

 vocabularies NUMBERS, STRUCT_0, GROUP_1, SUBSET_1, GROUP_2, FINSET_1,
      CARD_1, RELAT_1, TARSKI, ALGSTR_0, ZFMISC_1, ARYTM_3, GROUP_4,
      ARYTM_1, NAT_1, FINSEQ_1, FUNCT_1, XXREAL_0, XBOOLE_0, FINSEQ_6,
      XCMPLX_0, REAL_1, PREPOWER, POWER, VALUED_0, ORDINAL1, FINSOP_1,
      BINOP_1, SETWISEO;
 notations XBOOLE_0, CARD_1, TARSKI, ZFMISC_1, SUBSET_1, ORDINAL1,
      NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, RELAT_1, FUNCT_1, FUNCT_2,
      NAT_1, FINSET_1, FINSEQ_1, FINSEQ_6, BINOP_1, SETWISEO, FINSOP_1,
      STRUCT_0, ALGSTR_0, GROUP_1, GROUP_2, GROUP_4, REAL_1, PREPOWER,
      POWER;
 constructors REAL_1, NAT_1, FINSEQ_1, FINSEQ_6, BINOP_1, SETWISEO,
      FINSOP_1, GROUP_4, RELSET_1, PREPOWER, POWER, BINOP_2;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XXREAL_0, XREAL_0, NAT_1,
      FINSEQ_1, FINSEQ_6, STRUCT_0, GROUP_1, GROUP_2, ORDINAL1, FINSET_1,
      NUMBERS, XCMPLX_0, MEMBERED, VALUED_0, PREPOWER;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, FUNCT_1, FINSEQ_1, STRUCT_0;
 equalities ALGSTR_0, ORDINAL1;
 expansions TARSKI, STRUCT_0;

begin

::$P-
theorem
  ex c being Real st
    0 < c &
    for G being finite Group st 1 < card G holds
      ex s being FinSequence of the carrier of G st
        (len s qua Real) <=
          c * log(number_e,(card G qua Real)) &
        for g being Element of G holds
          ex q being FinSubsequence,
             t being FinSequence of the carrier of G st
            q c= s & t = Seq q & (the multF of G) "**" t = g
proof
end;
::$P+
