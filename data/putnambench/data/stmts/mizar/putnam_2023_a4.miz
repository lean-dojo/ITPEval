:: Statement-only formalization of PutnamBench corpus artifact putnam_2023_a4
:: (putnambench__mizar__putnam_2023_a4): the integer span of the twelve
:: normalized regular-icosahedron vertex vectors is dense in real
:: three-dimensional Euclidean space. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      EUCLID_5, FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, INT_1, METRIC_1,
      NAT_1, NUMBERS, PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1,
      RVSUM_1, SQUARE_1, STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0,
      VALUED_1, XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, COMPLEX1, XXREAL_0, INT_1, NAT_1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2,
      SQUARE_1, STRUCT_0, ALGSTR_0, PRE_TOPC, METRIC_1, RLVECT_1,
      RLTOPSP1, EUCLID, RVSUM_1, TOPMETR, TOPREAL6, EUCLID_5;
 constructors REAL_1, SQUARE_1, BINOP_2, COMPLEX1, INT_1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1,
      STRUCT_0, RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, TOPREAL6,
      EUCLID_5;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, INT_1,
      NAT_1, CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID, TOPMETR,
      BINOP_2, MEMBERED, MONOID_0, VALUED_0, VALUED_1, SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities STRUCT_0, RLVECT_1, EUCLID;
 expansions TARSKI, XBOOLE_0, FUNCT_1;

begin

::$P-
theorem
  for v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12
      being Point of TOP-REAL 3 st
    ex phi,s being Real,
       g being Function of TOP-REAL 3,TOP-REAL 3 st
      phi = (1 + sqrt 5) / 2 &
      s = sqrt (1 + phi^2) &
      g is one-to-one &
      rng g = the carrier of TOP-REAL 3 &
      (for x,y being Point of TOP-REAL 3 holds
        g.(x+y) = g.x + g.y) &
      (for r being Real, x being Point of TOP-REAL 3 holds
        g.(r*x) = r*g.x) &
    (for x,y being Point of TOP-REAL 3 holds
      dist(g.x,g.y) = dist(x,y)) &
    g.v1 = (1/s) * |[1,phi,0]| &
    g.v2 = (1/s) * |[-1,phi,0]| &
    g.v3 = (1/s) * |[1,-phi,0]| &
    g.v4 = (1/s) * |[-1,-phi,0]| &
    g.v5 = (1/s) * |[phi,0,1]| &
    g.v6 = (1/s) * |[phi,0,-1]| &
    g.v7 = (1/s) * |[-phi,0,1]| &
    g.v8 = (1/s) * |[-phi,0,-1]| &
    g.v9 = (1/s) * |[0,1,phi]| &
    g.v10 = (1/s) * |[0,-1,phi]| &
    g.v11 = (1/s) * |[0,1,-phi]| &
    g.v12 = (1/s) * |[0,-1,-phi]|
  holds
    for w being Point of TOP-REAL 3 holds
      for epsilon being Real st epsilon > 0 holds
        ex a1,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12 being Integer st
          ex u being Point of TOP-REAL 3 st
            u = (a1 qua Real)*v1 + (a2 qua Real)*v2 +
                (a3 qua Real)*v3 + (a4 qua Real)*v4 +
                (a5 qua Real)*v5 + (a6 qua Real)*v6 +
                (a7 qua Real)*v7 + (a8 qua Real)*v8 +
                (a9 qua Real)*v9 + (a10 qua Real)*v10 +
                (a11 qua Real)*v11 + (a12 qua Real)*v12 &
            dist(u,w) < epsilon
proof
end;
::$P+
