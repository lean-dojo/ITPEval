:: Statement-only formalization of PutnamBench corpus artifact putnam_2005_a5
:: (putnambench__mizar__putnam_2005_a5): the integral from zero to one of
:: ln(x+1)/(x^2+1) equals PI times ln(2) divided by eight. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, ORDINAL1,
    SQUARE_1, NEWTON, PREPOWER, POWER, SUPINF_2, MEASURE1, MESFUNC1,
    MESFUNC5, MEASUR12, INTEGRA5, SIN_COS, TAYLOR_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, NAT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, SQUARE_1,
    NEWTON, PREPOWER, POWER, VALUED_0, VALUED_1, SIN_COS, SUPINF_2,
    MEASURE1, MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5,
    EXTREAL1, TAYLOR_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    NAT_1, SQUARE_1, NEWTON, PREPOWER, POWER, SIN_COS, MESFUNC1,
    MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1, BINOP_2,
    TAYLOR_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON, PREPOWER,
    POWER, SQUARE_1, XXREAL_3, MEASURE1, MEASUR12, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities SQUARE_1;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for I being Subset of REAL,
      f being Function of REAL,REAL st
    I = {x where x is Real : 0 <= x & x <= 1} &
    (for x being Real holds
      f.x = ln.(x + 1) / (x^2 + 1))
  holds
    Integral(L-Meas,f|I) = PI * ln.2 / 8
proof
end;
::$P+
