:: Statement-only formalization of PutnamBench corpus artifact putnam_1994_b6:
:: for n_a = 101*a - 100*2^a, equality modulo 10100 of two sums with
:: indices from 0 through 99 forces equality of the unordered index pairs.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    REAL_1, INT_1, NAT_1, ORDINAL1, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
    REAL_1, NAT_1, INT_1, NEWTON, NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, NAT_1,
    INT_1, NEWTON, NAT_D;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, INT_1, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Function of NAT,INT st
    (for a being Nat holds
      n.a = 101 * (a qua Integer) -
        100 * ((2 qua Integer) |^ a))
  holds
    for a,b,c,d being Nat st
      a <= 99 & b <= 99 & c <= 99 & d <= 99 &
      (n.a + n.b) mod 10100 = (n.c + n.d) mod 10100
    holds {a,b} = {c,d}
proof
end;
::$P+
