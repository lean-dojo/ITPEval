:: Statement-only formalization of PutnamBench artifact putnam_1968_b6:
:: no sequence of compact sets of rational numbers contains every compact
:: set of rational numbers as a subset. This file contains no proof.

environ

  vocabularies NUMBERS, TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1,
    FUNCT_1, FUNCT_2, NAT_1, STRUCT_0, PRE_TOPC, TOPS_2, COMPTS_1,
    RCOMP_1, TOPMETR, REAL_1, XREAL_0, RAT_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XREAL_0, REAL_1, STRUCT_0, PRE_TOPC,
    TOPS_2, COMPTS_1, RCOMP_1, TOPMETR, RAT_1;
  constructors ZFMISC_1, FUNCT_2, TOPS_2, COMPTS_1, RCOMP_1, TOPMETR,
    REAL_1, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, NAT_1,
    XREAL_0, STRUCT_0, PRE_TOPC, TOPS_2, COMPTS_1, RCOMP_1, TOPMETR,
    RAT_1, ORDINAL1;
  requirements NUMERALS, SUBSET, BOOLE;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  not ex K being Function of NAT,bool the carrier of R^1 st
    (for n being Nat holds
      ex Kn being compact Subset of R^1 st
        Kn = K.n &
        (for x being Real st x in Kn holds x in RAT)) &
    (for S being compact Subset of R^1 st
      (for x being Real st x in S holds x in RAT)
    holds ex n being Nat st S c= K.n)
proof
end;
::$P+
