:: Statement-only formalization of PutnamBench corpus artifact putnam_1980_a5:
:: a nonconstant real polynomial has only finitely many real endpoints at
:: which its integrals against both sine and cosine vanish. This file contains
:: no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, FINSET_1, ORDINAL1, VALUED_0, VALUED_1, XCMPLX_0,
      XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1, SIN_COS,
      INTEGRA5, INTEGRA1, RCOMP_1, TARSKI, NAT_1, POLYNOM1,
      VECTSP_1, POLYNOM2, POLYNOM3, FUNCT_4, STRUCT_0, GROUP_1,
      ALGSTR_0, ALGSEQ_1, SUPINF_2, MESFUNC1, FINSEQ_1, AFINSQ_1,
      RLVECT_1, CARD_3, BINOP_1, POLYNOM5, LATTICES, ORDINAL4,
      FINSEQ_2, VECTSP_2, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSET_1, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, NAT_1, VALUED_0, VALUED_1, FINSEQ_1,
      FINSEQ_2, FUNCT_7, STRUCT_0, ALGSTR_0, ALGSTR_1, RLVECT_1,
      GROUP_1, VECTSP_1, VECTSP_2, ALGSEQ_1, POLYNOM3, POLYNOM4,
      POLYNOM5, SIN_COS, INTEGRA5;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2,
      FINSEQ_4, VECTSP_2, ALGSTR_1, RELSET_1, FINSET_1, REAL_1, SIN_COS,
      INTEGRA5;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0,
      VECTSP_1, CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0,
      RLVECT_1, MEMBERED, RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS,
      FUNCT_2, XBOOLE_0, NAT_1, VALUED_0, FINSEQ_1, FINSEQ_2,
      VECTSP_2, ALGSTR_1, FINSET_1, RCOMP_1, SIN_COS;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0,
      ALGSTR_0, SIN_COS, RCOMP_1;
 expansions TARSKI, XBOOLE_0, RELAT_1, ALGSEQ_1, POLYNOM5;

begin

::$P-
theorem
  for p being Polynomial of F_Real,
      fsin,fcos being Function of REAL,REAL,
      solutions being Subset of REAL st
    len p > 1 &
    (for t being Element of F_Real holds
      fsin.t = eval(p,t) * sin.t) &
    (for t being Element of F_Real holds
      fcos.t = eval(p,t) * cos.t) &
    solutions = {x where x is Real :
      integral(fsin,0,x) = 0 & integral(fcos,0,x) = 0}
  holds solutions is finite
proof
end;
::$P+
