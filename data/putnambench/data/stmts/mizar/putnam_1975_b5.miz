:: Statement-only formalization of PutnamBench corpus artifact putnam_1975_b5:
:: the recursively differentiated functions f_0(x) = exp(x) and
:: f_(n+1)(x) = x*f_n'(x) have the stated factorial-weighted infinite sum.
:: This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, COMPLEX1, NEWTON,
    ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1, XXREAL_1,
    ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1, XBOOLE_0,
    SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, ORDINAL2, CARD_3,
    ABIAN, TAYLOR_2, NAT_1, FUNCT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
    RFUNCT_2, RCOMP_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NUMBERS,
    COMPLEX1, REAL_1, NAT_1, FUNCT_2, VALUED_1, SEQ_1, COMSEQ_2,
    SEQ_2, SERIES_1, FDIFF_1, SEQFUNC, NEWTON, SIN_COS, TAYLOR_1,
    ABIAN;
  constructors ARYTM_0, REAL_1, NAT_1, SEQ_2, RCOMP_1, RFUNCT_2,
    LIMFUNC1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN, TAYLOR_1, SEQFUNC,
    SERIES_1, VALUED_1, RELSET_1, COMSEQ_2, FUNCT_2;
  registrations RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, NEWTON, SIN_COS, INT_1,
    ORDINAL1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities XCMPLX_0, VALUED_1, SUBSET_1;
  expansions TAYLOR_1;
  theorems XBOOLE_1, ABSVALUE, PARTFUN1, XCMPLX_1, RELAT_1, RCOMP_1,
    SEQ_1, SEQ_2, SIN_COS, SERIES_1, FUNCT_1, RFUNCT_2, NAT_1,
    NEWTON, POWER, FDIFF_1, FDIFF_2, TAYLOR_1, SIN_COS2, XREAL_1,
    RFUNCT_1, ABIAN, COMPLEX1, XXREAL_0, VALUED_1, FUNCT_2, XREAL_0,
    ORDINAL1;
  schemes NAT_1;

begin

::$P-
theorem
  for f being Function of NAT,Funcs(REAL,REAL) st
    (for f0 being Function of REAL,REAL st f0 = f.0 holds
      for x being Real holds f0.x = exp_R.x) &
    (for n being Nat,
         fn,fn1 being Function of REAL,REAL st
      fn = f.n & fn1 = f.(n + 1)
    holds
      for x being Real holds
        (fn is_differentiable_in x &
          fn1.x = x * diff(fn,x)) or
        (not fn is_differentiable_in x &
          fn1.x = 0))
  holds
    ex s being Real_Sequence st
      (for n being Nat,
           fn being Function of REAL,REAL st fn = f.n
        holds s.n = fn.1 / (n !)) &
      Partial_Sums(s) is convergent &
      lim Partial_Sums(s) = exp_R.(exp_R.1)
proof
end;
::$P+
