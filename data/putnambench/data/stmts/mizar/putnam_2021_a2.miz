:: Statement-only formalization of PutnamBench corpus artifact putnam_2021_a2
:: (putnambench__mizar__putnam_2021_a2): a function defined at each positive
:: real x by a right-hand real-power limit has g(x)/x tending to exp(1) as
:: x tends to positive infinity. This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, BINOP_1, BINOP_2, NUMBERS, XCMPLX_0, XREAL_0, COMPLEX1,
    CARD_1, XXREAL_0, ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0,
    VALUED_1, NEWTON, PREPOWER, SEQ_1, SEQ_2, ORDINAL1, ORDINAL2,
    SEQ_4, POWER, SIN_COS;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, COMPLEX1, XXREAL_0, NAT_1, VALUED_0, VALUED_1, SEQ_1,
    SEQ_2, COMSEQ_2, SEQM_3, SEQ_4, BINOP_1, BINOP_2, NEWTON,
    PREPOWER, POWER, SIN_COS;
  constructors NUMBERS, XCMPLX_0, XREAL_0, FUNCT_1, SUBSET_1, RELSET_1,
    FUNCT_2, CARD_1, REAL_1, COMPLEX1, XXREAL_0, NAT_1, SEQ_2, SEQM_3,
    SEQ_4, COMSEQ_2, ZFMISC_1, BINOP_1, BINOP_2, NEWTON, PREPOWER,
    POWER, SIN_COS;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, REAL_1, ORDINAL1, NAT_1, SEQ_4, NEWTON,
    PREPOWER, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for g being Function of REAL,REAL st
    (for x being Real st 0 < x holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st
          0 < delta &
          for r being Real st 0 < r & r < delta holds
            |.((((x + 1) to_power (r + 1)) -
                (x to_power (r + 1))) to_power (1 / r)) - g.x.| <
              epsilon)
  holds
    for epsilon being Real st 0 < epsilon holds
      ex A being Real st
        for x being Real st A < x holds
          |.(g.x / x) - exp_R.1.| < epsilon
proof
end;
::$P+
