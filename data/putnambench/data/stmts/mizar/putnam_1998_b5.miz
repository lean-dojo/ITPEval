:: Statement-only formalization of PutnamBench corpus artifact putnam_1998_b5:
:: the thousandth digit after the decimal point of the square root of the
:: 1998-digit integer consisting entirely of ones is 1. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    COMPLEX1,
    ORDINAL1, INT_1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    NEWTON, SQUARE_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, FINSEQ_1, RVSUM_1,
    FINSEQ_2, NAT_1, NAT_D;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
    INT_1, XXREAL_0, NEWTON, NAT_D, NUMBERS, RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON,
    FINSEQ_1, FINSEQ_2, RVSUM_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for N being Nat, terms being FinSequence of NAT st
    len terms = 1998 &
    (for i being Nat st i in Seg 1998 holds
      terms.i = 10 |^ (i -' 1)) &
    N = Sum terms
  holds
    [\ (10 |^ 1000) * sqrt N /] mod 10 = 1
proof
end;
::$P+
