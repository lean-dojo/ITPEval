:: Statement-only formalization of PutnamBench corpus artifact putnam_1981_b3:
:: infinitely many natural numbers m have the property that every prime
:: divisor of m^2 + 3 divides k^2 + 3 for some k with k^2 < m.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, INT_1, INT_2, RELAT_1, XBOOLE_0,
    SUBSET_1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, NEWTON,
    ARYTM_1, ARYTM_3;
  notations XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, INT_1, INT_2, NEWTON, NAT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D, INT_1, INT_2, NEWTON, NUMBERS;
  registrations XBOOLE_0, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, INT_1, NEWTON, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
    ex m being Nat st
      m > n &
      for p being Nat st
        p is prime & p divides (m |^ 2) + 3
      holds
        ex k being Nat st
          k |^ 2 < m & p divides (k |^ 2) + 3
proof
end;
::$P+
