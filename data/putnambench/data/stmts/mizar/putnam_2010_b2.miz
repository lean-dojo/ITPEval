:: Statement-only formalization of PutnamBench corpus artifact putnam_2010_b2
:: (putnambench__mizar__putnam_2010_b2): the minimum distance AB among
:: noncollinear integer-coordinate plane triangles whose three side lengths
:: are integers is 3. This file contains no proof.

environ

 vocabularies ALGSTR_0, ARYTM_1, ARYTM_3, CARD_1, COMPLEX1, EUCLID,
      FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, INT_1, METRIC_1, NAT_1,
      NUMBERS, PRE_TOPC, REAL_1, RELAT_1, RLTOPSP1, RLVECT_1, RVSUM_1,
      SQUARE_1, STRUCT_0, SUBSET_1, TARSKI, TOPMETR, VALUED_0, VALUED_1,
      XBOOLE_0, XCMPLX_0, XREAL_0, XXREAL_0;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XREAL_0, REAL_1, COMPLEX1, XXREAL_0, INT_1, NAT_1, CARD_1,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, VALUED_0, FINSEQ_1, FINSEQ_2,
      SQUARE_1, STRUCT_0, PRE_TOPC, METRIC_1, RLVECT_1, RLTOPSP1,
      EUCLID, RVSUM_1, TOPMETR, TOPREAL6;
 constructors REAL_1, SQUARE_1, BINOP_2, COMPLEX1, INT_1, RELSET_1,
      FUNCT_2, FINSEQ_1, FINSEQ_2, FINSEQOP, MONOID_0, METRIC_1,
      RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, TOPREAL6;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XREAL_0, INT_1,
      NAT_1, CARD_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, STRUCT_0, PRE_TOPC, METRIC_1, RLTOPSP1, EUCLID,
      TOPMETR, BINOP_2, MEMBERED, MONOID_0, VALUED_0, VALUED_1,
      SQUARE_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;

begin

::$P-
theorem
  (ex A,B,C being Point of TOP-REAL 2 st
    A.1 in INT & A.2 in INT &
    B.1 in INT & B.2 in INT &
    C.1 in INT & C.2 in INT &
    dist(A,B) in INT & dist(A,C) in INT & dist(B,C) in INT &
    (B.1 - A.1) * (C.2 - A.2) <>
      (B.2 - A.2) * (C.1 - A.1) &
    dist(A,B) = 3) &
  (for A,B,C being Point of TOP-REAL 2 st
    A.1 in INT & A.2 in INT &
    B.1 in INT & B.2 in INT &
    C.1 in INT & C.2 in INT &
    dist(A,B) in INT & dist(A,C) in INT & dist(B,C) in INT &
    (B.1 - A.1) * (C.2 - A.2) <>
      (B.2 - A.2) * (C.1 - A.1)
  holds 3 <= dist(A,B))
proof
end;
::$P+
