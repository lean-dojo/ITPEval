:: Statement-only formalization of PutnamBench corpus artifact putnam_2020_a1:
:: exactly 508536 positive integers divisible by 2020, with at most 2020
:: decimal digits, consist of consecutive ones followed by consecutive zeros.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3,
    VALUED_0, VALUED_1, NEWTON, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, FINSET_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1,
    FUNCT_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NEWTON, NAT_1,
    NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FUNCT_2, FINSET_1, CARD_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, INT_2,
    FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1,
    MEMBERED, NEWTON, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  card {n where n is Element of NAT :
    2020 divides n &
    n < 10 |^ 2020 &
    ex k,l being Nat, terms being FinSequence of NAT st
      l <= k &
      len terms = k -' l + 1 &
      (for i being Nat st i in Seg len terms holds
        terms.i = 10 |^ ((i -' 1) + l)) &
      n = Sum terms}
  = 508536
proof
end;
::$P+
