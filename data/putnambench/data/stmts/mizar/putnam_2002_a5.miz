:: Statement-only formalization of PutnamBench corpus artifact putnam_2002_a5:
:: every positive rational occurs as a ratio of consecutive terms of the
:: rational sequence defined by the stated binary-index recurrence.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, INT_1, NAT_1, VALUED_1, RAT_1, ORDINAL1,
    BINOP_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, NAT_1,
    INT_1, COMPLEX1, SQUARE_1, XXREAL_0, RAT_1, NAT_D, BINOP_2;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, NAT_1, SQUARE_1,
    COMPLEX1, INT_1, XXREAL_0, RAT_1, NAT_D, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, RAT_1,
    BINOP_2;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a being Function of NAT,RAT st
    a.0 = 1 &
    (for n being Nat holds
      a.(2 * n + 1) = a.n &
      a.(2 * n + 2) = a.n + a.(n + 1))
  holds
    for q being Rational st q > 0 holds
      ex n being Nat st
        1 <= n &
        q = a.(n -' 1) / a.n
proof
end;
::$P+
