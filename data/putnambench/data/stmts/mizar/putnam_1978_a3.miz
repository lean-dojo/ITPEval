:: Statement-only formalization of PutnamBench artifact putnam_1978_a3:
:: among the integrals from zero to infinity of x^k divided by the given
:: reciprocal-symmetric sextic polynomial, for 1 <= k <= 4, the minimum
:: occurs at k = 2. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
      ARYTM_1, ARYTM_3, REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON,
      ORDINAL1, FINSEQ_1, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
      MEASUR12, INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      REAL_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_3, NEWTON, NAT_1,
      FINSEQ_1, VALUED_0, VALUED_1, SUPINF_2, MEASURE1, MESFUNC1,
      MESFUNC5, MESFUNC6, MEASUR12, INTEGRA5, EXTREAL1;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      XXREAL_0, NEWTON, NAT_1, BINOP_2, MESFUNC1, MESFUNC5, MESFUNC6,
      MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, FINSEQ_1,
      XXREAL_3, NEWTON, MEASURE1, MEASUR12;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, XBOOLE_0;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for A being Subset of REAL,
      I being Function of NAT,REAL st
    A = {x where x is Real : 0 < x} &
    (for k being Nat st k in Seg 4 holds
      ex f being Function of REAL,REAL st
        (for x being Real holds
          f.x = (x |^ k) /
            (2 * ((x |^ 6) + 1) +
             4 * ((x |^ 5) + x) +
             3 * ((x |^ 4) + (x |^ 2)) +
             5 * (x |^ 3))) &
        I.k = Integral(L-Meas,f|A))
  holds
    (2 qua Nat) in Seg 4 &
    for k being Nat st k in Seg 4 holds I.2 <= I.k
proof
end;
::$P+
