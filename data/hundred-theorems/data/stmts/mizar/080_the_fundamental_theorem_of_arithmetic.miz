:: Statement-only formalization of "The Fundamental Theorem of Arithmetic" for
:: corpus artifact hundred-theorems__mizar__080. Every nonzero natural number
:: has a unique nondecreasing finite sequence of prime factors whose product is
:: that number. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3, REALSET1,
    VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    INT_2;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat st n <> 0 holds
    ex factors being FinSequence of NAT st
      Product factors = n &
      (for i being Nat st i in dom factors holds factors.i is prime) &
      (for i, j being Nat st
        i in dom factors & j in dom factors & i < j
        holds factors.i <= factors.j) &
      (for other being FinSequence of NAT st
        Product other = n &
        (for i being Nat st i in dom other holds other.i is prime) &
        (for i, j being Nat st
          i in dom other & j in dom other & i < j
          holds other.i <= other.j)
       holds other = factors)
proof
end;
::$P+
