:: Statement-only formalization of "The Fundamental Theorem of Integral Calculus" for
:: corpus artifact hundred-theorems__mizar__015: a scalar derivative on a closed interval
:: has Henstock-Kurzweil integral equal to the endpoint difference. The epsilon-delta
:: hypothesis is exactly the derivative within the interval. Restriction gives it from
:: the two-sided source convention, while linear extension at both endpoints gives the
:: converse without changing the interval data or endpoint values. This file contains no proof.

environ

  vocabularies NUMBERS, XBOOLE_0, PARTFUN1, SUBSET_1, FUNCT_1, RELAT_1,
    XXREAL_2, COMPLEX1, ARYTM_1, XXREAL_0, SEQ_4, ARYTM_3, REAL_1, FDIFF_1,
    RCOMP_1, TARSKI, VALUED_1, CARD_1, INTEGRA5, INTEGRA1, XXREAL_1,
    SQUARE_1, ORDINAL2, FUNCOP_1, FCONT_1, REALSET1, SIN_COS, SEQ_1, SEQ_2,
    NAT_1, INTEGRA7, FUNCT_7, FUNCT_2, LIMFUNC3, JGRAPH_2, COUSIN, COUSIN2,
    FINSEQ_1, FINSEQ_2, PARTFUN3, MEASURE5, MEASURE7;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, XXREAL_2, COMPLEX1, FUNCT_1, RELAT_1, FUNCOP_1,
    RELSET_1, FUNCT_2, RCOMP_1, VALUED_1, SEQ_1, PARTFUN1, RFUNCT_1, SEQ_2,
    SEQ_4, SQUARE_1, FCONT_1, FDIFF_1, LIMFUNC3, RVSUM_1, SIN_COS, INTEGRA5,
    INTEGRA7, FINSEQ_1, FINSEQ_2, MEASURE5, INTEGRA1, PARTFUN3, COUSIN,
    COUSIN2;
  constructors REAL_1, FDIFF_1, PARTFUN2, RFUNCT_1, INTEGRA2, COMSEQ_2,
    FCONT_1, INTEGRA5, SIN_COS, SQUARE_1, RVSUM_1, SEQ_4, RELSET_1, SEQ_2,
    COMPLEX1, LIMFUNC3, INTEGRA7, COUSIN, COUSIN2;
  registrations XREAL_0, RELSET_1, INTEGRA1, RCOMP_1, VALUED_0, MEMBERED,
    XXREAL_0, XBOOLE_0, NUMBERS, VALUED_1, FUNCT_2, XXREAL_2, SEQ_2,
    SQUARE_1, RELAT_1, NAT_1, FCONT_1, SIN_COS, ORDINAL1, BORSUK_5, XCMPLX_0,
    COUSIN, MEASURE5;
  requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
  definitions TARSKI, FDIFF_1;
  equalities XCMPLX_0, INTEGRA5, VALUED_1, SQUARE_1, SIN_COS, RCOMP_1;
  expansions FCONT_1, TARSKI, FDIFF_1, INTEGRA7, FUNCT_2;
  theorems TARSKI, RFUNCT_1, FUNCT_1, SEQ_1, SEQ_2, FDIFF_1, ABSVALUE,
    XCMPLX_1, RCOMP_1, XBOOLE_0, FCONT_1, FDIFF_2, RELAT_1, XREAL_0,
    XXREAL_0, FUNCT_2, XBOOLE_1, SEQ_4, XREAL_1, COMPLEX1, INTEGRA5,
    SIN_COS, INTEGRA6, VALUED_1, FUNCOP_1, ORDINAL1, SQUARE_1, RELSET_1,
    LIMFUNC3, L_HOSPIT, INTEGRA7, ORDEQ_01, LEIBNIZ1, ROLLE, XXREAL_1,
    COMPTRIG;
  schemes FUNCT_2, PARTFUN1;

begin

::$P-
theorem
  for a,b being Real,
      I being non empty closed_interval Subset of REAL,
      f,F being Function of I,REAL st
    a <= b &
    I = [.a,b.] &
    (for x being Real st x in I holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in I & |.y-x.| < delta holds
            |.(F.y-F.x)-f.x*(y-x).| <= epsilon*|.y-x.|) holds
  f is HK-integrable &
  HK-integral(f) = F.b - F.a
proof
end;
::$P+
