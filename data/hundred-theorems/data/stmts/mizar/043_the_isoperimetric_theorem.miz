:: Statement-only formalization of "The Isoperimetric Theorem" from Hundred
:: Theorems item 043. A rectifiable simple closed plane path of length L
:: encloses area at most L^2/(4*PI), with equality only when its image is a
:: circle. This file contains no proof.

environ

 vocabularies MEASUR14, INTEGRA1, MEASUR13, FINSEQ_1, FINSEQ_2, NUMBERS,
      XXREAL_0, XXREAL_1, SUBSET_1, MESFUNC2, CARD_1, ARYTM_3, ARYTM_1,
      RELAT_1, REAL_1, FUNCT_1, XBOOLE_0, TARSKI, ZFMISC_1, PROB_1, SUPINF_2,
      VALUED_0, PARTFUN1, MEASURE1, MESFUNC5, MESFUNC1, MEASUR10, MEASUR11,
      MESFUN12, RFUNCT_3, ORDINAL2, INTEGRA5, NAT_1, ORDINAL4, FUNCT_2,
      FUNCOP_1, PBOOLE, CARD_3, FINSUB_1, SETFAM_1, PROB_2, MSSUBFAM, SEQ_2,
      SEQFUNC, XCMPLX_0, MEASURE5, EQREL_1, MESFUNC3, MEASUR12, METRIC_1,
      STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, SIN_COS, COMPLEX1,
      SQUARE_1, RCOMP_1, FCONT_1, RVSUM_1, TOPREAL1, TOPREAL2, JORDAN2C,
      TOPREALB;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1, FUNCT_1,
      ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, BINOP_1, FUNCT_3, FUNCOP_1,
      XXREAL_3, CARD_1, FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XREAL_0,
      VALUED_0, EXTREAL1, NAT_1, SUPINF_1, FINSEQ_1, FINSEQ_2, FINSEQOP,
      RVSUM_1, SQUARE_1, XXREAL_0, RCOMP_1, FCONT_1, STRUCT_0,
      METRIC_1, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, TOPMETR, TOPREAL1,
      TOPREAL2, JORDAN2C, TOPREAL9, SIN_COS, SUPINF_2, PROB_1, PROB_2,
      SEQFUNC, MEASURE1, MEASURE3, MEASURE4, MEASURE5, MEASUR12, MESFUNC1,
      MESFUNC2, MESFUNC3, MESFUNC5, MEASUR10, PROB_3, MEASUR11, MESFUN12,
      MEASUR13, MEASUR14;
 constructors EXTREAL1, SUPINF_1, MESFUNC2, MEASUR11, MESFUN12, DOMAIN_1,
      MESFUNC3, FINSEQOP, SEQFUNC, MEASURE3, PROB_3, MEASUR12, MEASUR13,
      SQUARE_1, RCOMP_1, FCONT_1, RVSUM_1, METRIC_1, EUCLID, TOPMETR,
      TOPREAL1, TOPREAL2, JORDAN2C, TOPREAL9, TOPREALB, SIN_COS, MEASUR14;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, FINSEQ_1, FINSEQ_2, FUNCT_1,
      FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9, MEMBERED, SRINGS_4,
      SETFAM_1, SQUARE_1, RCOMP_1, FCONT_1, STRUCT_0, PRE_TOPC, RLTOPSP1,
      EUCLID, TOPMETR, TOPREAL1, TOPREAL2, JORDAN2C, SIN_COS, MEASUR13,
      GLIBPRE1, MEASUR14;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0;
 equalities FINSEQ_1, MEASUR10, BINOP_1, SUBSET_1, MEASUR13, FINSEQ_2,
      XCMPLX_0, SQUARE_1, EUCLID, STRUCT_0;
 expansions TARSKI, XBOOLE_0, FINSEQ_1, FUNCT_1, RELAT_1, FCONT_1;
 theorems XBOOLE_0, FUNCT_1, XXREAL_0, XXREAL_1, XBOOLE_1, MEASURE1,
      VALUED_0, FUNCT_2, RELAT_1, PARTFUN1, FINSEQ_1, FINSEQ_2, TARSKI,
      ZFMISC_1, NAT_1, XREAL_1, ORDINAL1, RVSUM_1, SQUARE_1, RCOMP_1,
      FCONT_1, EUCLID, TOPREAL2, JORDAN2C, TOPREAL9, MEASUR13, MEASUR14;

begin

::$P-
theorem
  for L being Real,
      x,y being PartFunc of REAL,REAL,
      A being Subset of REAL,
      C being Simple_closed_curve,
      D being Element of XL-Field 2 st
    A = { t where t is Real : 0 <= t & t <= 1 } &
    dom x = A &
    dom y = A &
    x | A is continuous &
    y | A is continuous &
    x.0 = x.1 & y.0 = y.1 &
    (for s,t being Real st
      s in A & t in A & x.s = x.t & y.s = y.t
      holds s = t or (s = 0 & t = 1) or (s = 1 & t = 0)) &
    (for z being object holds
      z in C iff ex t being Real st
        t in A & z = |[x.t,y.t]|) &
    0 <= L &
    (for n being Nat, p,d being FinSequence of REAL st
      1 <= n &
      len p = n+1 &
      p.1 = 0 & p.(n+1) = 1 &
      (for i being Nat st 1 <= i & i <= n holds
        p.i < p.(i+1)) &
      len d = n &
      (for i being Nat st 1 <= i & i <= n holds
        d.i = sqrt ((x.(p.(i+1)) - x.(p.i))^2 +
                    (y.(p.(i+1)) - y.(p.i))^2))
      holds Sum d <= L) &
    (for e being Real st 0 < e holds
      ex n being Nat, p,d being FinSequence of REAL st
        1 <= n &
        len p = n+1 &
        p.1 = 0 & p.(n+1) = 1 &
        (for i being Nat st 1 <= i & i <= n holds
          p.i < p.(i+1)) &
        len d = n &
        (for i being Nat st 1 <= i & i <= n holds
          d.i = sqrt ((x.(p.(i+1)) - x.(p.i))^2 +
                      (y.(p.(i+1)) - y.(p.i))^2)) &
        L-e < Sum d) &
    D = BDD C
  holds
    (XL-Meas 2).D <= L^2 / (4*PI) &
    ((XL-Meas 2).D = L^2 / (4*PI) implies
      ex c being Point of TOP-REAL 2, r being Real st
        C = Sphere(c,r))
proof
end;
::$P+
