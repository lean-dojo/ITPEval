begin

::$P-
theorem
  for n being Nat,
      A being non empty convex Subset of TOP-REAL n,
      f being continuous Function of (TOP-REAL n) | A, (TOP-REAL n) | A st
    A is compact
  holds ex x being Point of (TOP-REAL n) | A st f.x = x
proof
end;
::$P+
