:: Statement-only formalization of Hundred Theorems artifact 092, "Pick's
:: Theorem": the area enclosed by a simple lattice polygon equals its number
:: of interior lattice points plus half its boundary lattice points minus one.
:: This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, REAL_1,
      FUNCT_1, XBOOLE_0, TARSKI, ZFMISC_1, PARTFUN1, NAT_1, FINSEQ_1,
      FINSEQ_6, FINSET_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID,
      TOPREAL1,
      TOPREAL2, GOBOARD5, JORDAN2C, MEASURE1, MEASUR13, MEASUR14, INT_1,
      XXREAL_0, XCMPLX_0, MCART_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
      PARTFUN1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, INT_1, MCART_1, NAT_1,
      FINSEQ_1,
      FINSEQ_6, FINSET_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID,
      TOPREAL1,
      TOPREAL2, GOBOARD5, JORDAN2C, MEASURE1, MEASUR13, MEASUR14, XXREAL_0;
 constructors FINSEQ_6, FINSET_1, INT_1, TOPREAL1, TOPREAL2, GOBOARD5,
      JORDAN2C, MEASUR13, MEASUR14, XXREAL_0;
 registrations ORDINAL1, XBOOLE_0, SUBSET_1, RELAT_1, NUMBERS, XREAL_0,
      NAT_1, INT_1, FINSEQ_1, FINSET_1, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1,
      EUCLID, TOPREAL1, TOPREAL2, MEASURE1, MEASUR13, MEASUR14;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FINSEQ_6, TOPREAL1, GOBOARD5;
 equalities FINSEQ_1, SUBSET_1, EUCLID, STRUCT_0;
 expansions TARSKI, XBOOLE_0, FINSEQ_1;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, FINSEQ_1, FINSEQ_6, EUCLID, TOPREAL1,
      TOPREAL2, GOBOARD5, JORDAN2C, CARD_1;

begin

::$P-
theorem
  for vts being FinSequence of TOP-REAL 2,
      I,B being Nat,
      InteriorLattice,BoundaryLattice being finite Subset of TOP-REAL 2,
      D being Element of XL-Field 2 st
    len vts >= 4 &
    vts is circular unfolded s.c.c. &
    (for i being Nat st 1 <= i & i+1 <= len vts holds
      vts/.i <> vts/.(i+1)) &
    L~vts is being_simple_closed_curve &
    (for i being Nat st i in dom vts holds
      (vts/.i)`1 in INT & (vts/.i)`2 in INT) &
    InteriorLattice =
      { p where p is Point of TOP-REAL 2 :
        p in BDD (L~vts) & p`1 in INT & p`2 in INT } &
    BoundaryLattice =
      { p where p is Point of TOP-REAL 2 :
        p in L~vts & p`1 in INT & p`2 in INT } &
    I = card InteriorLattice &
    B = card BoundaryLattice &
    D = BDD (L~vts)
  holds
    (XL-Meas 2).D = I + B/2 - 1
proof
end;
::$P+
