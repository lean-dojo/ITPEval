:: Statement-only formalization of Hundred Theorems artifact 054,
:: "Königsberg Bridges Problem": the seven bridges cannot all be traversed
:: exactly once in a single continuous trail. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, FINSEQ_1, CARD_1, ORDINAL1, XCMPLX_0, ARYTM_1,
    ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, NAT_1;
  constructors RELSET_1, FUNCT_2, NAT_1, FINSEQ_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, XCMPLX_0, NAT_1, FINSEQ_1;
  requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  not ex vertices being FinSequence of NAT,
         order being Permutation of Seg 7 st
    len vertices = 8 &
    (for i being Nat st i in Seg 7 holds
      (order.i = 1 & {vertices.i,vertices.(i+1)} = {0,1}) or
      (order.i = 2 & {vertices.i,vertices.(i+1)} = {0,2}) or
      (order.i = 3 & {vertices.i,vertices.(i+1)} = {0,3}) or
      (order.i = 4 & {vertices.i,vertices.(i+1)} = {1,2}) or
      (order.i = 5 & {vertices.i,vertices.(i+1)} = {1,2}) or
      (order.i = 6 & {vertices.i,vertices.(i+1)} = {2,3}) or
      (order.i = 7 & {vertices.i,vertices.(i+1)} = {2,3}))
proof
end;
::$P+
