:: Statement-only formalization of "The Prime Number Theorem" from Hundred Theorems item 005.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
    SQUARE_1, REAL_1, REALSET1, INT_1, INT_2, NAT_1, VALUED_0,
    VALUED_1, NEWTON, FINSEQ_1, FINSET_1, RAT_1, PREPOWER, SEQ_1,
    SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, INT_2, COMPLEX1, SQUARE_1, XXREAL_0, NEWTON, NAT_D,
    FINSET_1, FINSEQ_1, RAT_1, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3,
    SEQ_4, PREPOWER, ABIAN, XXREAL_2, POWER;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, SQUARE_1,
    COMPLEX1, INT_1, INT_2, XXREAL_0, NEWTON, NAT_D, FINSET_1,
    FINSEQ_1, SEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, BINOP_2,
    COMSEQ_2, POWER;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, FINSET_1, FINSEQ_1, XXREAL_0, MEMBERED,
    VALUED_0, VALUED_1, XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1,
    INT_1, NEWTON, PREPOWER, SEQ_4, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for s being Real_Sequence st
    (for n being Nat holds
      s.n =
        card ((Seg n) /\ SetPrimes) /
          ((n qua Real) / log(number_e,(n qua Real))))
  holds s is convergent & lim s = 1
proof
end;
::$P+
