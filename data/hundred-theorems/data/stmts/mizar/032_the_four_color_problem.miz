:: Statement-only formalization of "The Four Color Problem" from Hundred
:: Theorems item 032. This file contains no proof.

:: A simple graph is represented together with a topological embedding in the
:: real plane: vertices have distinct positions, every edge is a simple arc
:: between its endpoints, no other vertex lies on that arc, and distinct edge
:: arcs meet only at common endpoints. The conclusion uses Mizar's native
:: notion of a proper vertex coloring with at most four colors.

environ

 vocabularies NUMBERS, SUBSET_1, RELAT_1, FUNCT_1, XXREAL_0, TARSKI, ARYTM_3,
      CARD_1, XBOOLE_0, NAT_1, ARYTM_1, GLIB_000, PARTFUN1, FINSET_1, ZFMISC_1,
      FUNCOP_1, GLIB_009, MOD_4, GLIB_006, GLIB_007, FUNCT_4, CARD_2, SCMYCIEL,
      GLIB_010, SIMPLEX0, XCMPLX_0, MCART_1, SETFAM_1, FACIRC_1, ORDINAL1,
      PBOOLE, CHORD, RING_3, REWRITE1, GLIB_013, GLCOLO00, REAL_1, PRE_TOPC,
      EUCLID, BORSUK_1, TOPS_2, STRUCT_0, XXREAL_1, RLTOPSP1, SUPINF_2,
      RCOMP_1, PCOMPS_1, CONNSP_2, TOPMETR, METRIC_1, TOPS_1, COMPLEX1,
      ORDINAL2, FINSEQ_1, TOPREAL1;
 notations TARSKI, XBOOLE_0, XTUPLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, WELLORD2, FUNCT_2, BINOP_1,
      DOMAIN_1, FUNCT_3, FUNCOP_1, FUNCT_4, FINSET_1, CARD_1, PBOOLE, PARTFUN2,
      CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, VALUED_0,
      NAT_D, CARD_2, FINSEQ_1, EQREL_1, FINSEQ_2, NEWTON, FUNCT_7, GLIB_000,
      STRUCT_0, ALGSTR_0, ORDERS_2, GROUP_1, GROUP_2, GROUP_6, YELLOW_1,
      SGRAPH1, MATRIX11, GLIB_001, CHORD, AOFA_I00, GLIB_006, GLIB_007,
      GLIB_008, GLIB_009, GLIB_010, GLIB_013, REAL_1, COMPLEX1, TOPS_1,
      TOPS_2, CONNSP_2, COMPTS_1, RCOMP_1, FINSEQ_4, METRIC_1, TOPMETR,
      PCOMPS_1, RLVECT_1, RLTOPSP1, EUCLID, PRE_TOPC, TOPREAL1, GLCOLO00;
 constructors DOMAIN_1, FUNCT_4, XXREAL_0, NAT_1, NAT_D, BINOP_2, CARD_2,
      FINSEQ_4, PBOOLE, ORDINAL3, WELLORD2, PARTFUN1, RELSET_1, GLIB_000,
      STRUCT_0, RELAT_1, FUNCT_1, FUNCT_2, ALGSTR_0, GROUP_1, GLIB_001, ABIAN,
      CARD_3, FINSEQ_1, GLIB_002, GLIB_003, SETFAM_1, EQREL_1, GROUP_2,
      GROUP_6, GLIB_006, GLIB_007, PARTFUN2, CHORD, XTUPLE_0, MATRIX11,
      GLIB_008, FUNCT_7, GLIB_009, GLIB_010, SQUARE_1, NEWTON, YELLOW_1,
      VALUED_0, SGRAPH1, ORDERS_2, AOFA_I00, GLIB_013, FUNCT_3, REAL_1,
      COMPLEX1, FINSEQOP, RCOMP_1, TOPS_1, TOPS_2, COMPTS_1, EUCLID, TOPMETR,
      RVSUM_1, VALUED_1, FUNCSDOM, RLTOPSP1, CONVEX1, PCOMPS_1, RUSUB_4,
      TOPREAL1, GLCOLO00;
 registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, FUNCOP_1, FINSET_1,
      NUMBERS, XREAL_0, NAT_1, MEMBERED, FINSEQ_1, GLIB_000, GLIB_002,
      GLIB_003, INT_1, VALUED_0, CARD_1, FUNCT_2, PARTFUN1, RELSET_1, XTUPLE_0,
      CARD_3, GROUP_1, STRUCT_0, GLIB_001, ABIAN, FINSEQ_4, GROUP_2, GLIB_006,
      EQREL_1, GLIB_007, GLIB_008, CHORD, NECKLACE, FUNCT_7, GLIB_009,
      MATRIX11, GLIB_010, SQUARE_1, NEWTON, SETFAM_1, FINSEQ_2, CARD_2,
      GLIB_012, RAMSEY_1, MSAFREE5, GRFUNC_1, SGRAPH1, CARD_5, FUNCT_4,
      WELLORD2, GLIBPRE0, YELLOW_1, ORDINAL7, RVSUM_4, AOFA_I00, GLIB_013,
      FUNCT_3, GLIBPRE1, SUBSET_1, PRE_TOPC, METRIC_1, PCOMPS_1, BORSUK_1,
      EUCLID, TOPMETR, RLTOPSP1, GLCOLO00;
 requirements ARITHM, BOOLE, NUMERALS, REAL, SUBSET;
 definitions TARSKI, XBOOLE_0, PRE_TOPC, GLIB_000;
 equalities ORDINAL1, GLIB_000, GLIB_010, EUCLID, STRUCT_0, RLTOPSP1,
      RLVECT_1;
 expansions TARSKI, XBOOLE_0, FUNCT_1, PRE_TOPC;

begin

::$P-
theorem
  for G being simple _Graph,
      p being Function of the_Vertices_of G,
        the carrier of TOP-REAL 2,
      a being Function of the_Edges_of G,
        bool the carrier of TOP-REAL 2
  st p is one-to-one &
    (for e being Element of the_Edges_of G st
      e in the_Edges_of G holds
      ex v,w being Vertex of G, A being Subset of TOP-REAL 2 st
        e Joins v,w,G & A = a.e & A is_an_arc_of p.v,p.w) &
    (for e being Element of the_Edges_of G, v being Vertex of G,
        A being Subset of TOP-REAL 2 st
      e in the_Edges_of G & A = a.e & p.v in A holds
      ex w being Vertex of G st e Joins v,w,G) &
    (for e1,e2 being Element of the_Edges_of G,
        A1,A2 being Subset of TOP-REAL 2, x being object st
      e1 in the_Edges_of G & e2 in the_Edges_of G & e1 <> e2 &
      A1 = a.e1 & A2 = a.e2 & x in A1 & x in A2 holds
      ex v,w1,w2 being Vertex of G st
        x = p.v & e1 Joins v,w1,G & e2 Joins v,w2,G)
  holds G is 4-vcolorable
proof
end;
::$P+
