:: Statement-only formalization of Hundred Theorems artifact 021, "Green's
:: Theorem": the positively oriented boundary integral of a planar field equals
:: the area integral of its scalar curl over the curve's interior. This file
:: contains no proof.

environ

 vocabularies MEASUR12, NUMBERS, XXREAL_0, SUBSET_1, CARD_1, ARYTM_3,
      ARYTM_1, RELAT_1, REAL_1, FUNCT_1, XBOOLE_0, TARSKI, ZFMISC_1,
      PROB_1, SUPINF_2, VALUED_0, PARTFUN1, MEASURE1, MESFUNC5, MESFUNC1,
      MEASUR10, MEASUR11, COMPLEX1, MESFUN12, RFUNCT_3, ORDINAL2, INTEGRA1,
      INTEGRA5, MEASURE6, NAT_1, FUNCT_2, CARD_3, ORDINAL1, SUPINF_1, SEQ_2,
      MEASURE3, MEASURE5, XXREAL_1, SEQ_1, MEASURE8, XREAL_0, FUNCT_7,
      XXREAL_2, MEMBERED, SEQ_4, STRUCT_0, PRE_TOPC, NORMSP_1, NFCONT_2,
      SQUARE_1, FCONT_1, REALSET1, DUALSP02, RCOMP_1, CFCONT_1, RAT_1,
      METRIC_1, FCONT_2, FDIFF_1, SIN_COS, EUCLID, TOPREAL1, JORDAN2C,
      CONNSP_1, RLTOPSP1, FINSEQ_1, FINSEQ_2, RVSUM_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
      SETFAM_1,
      RELSET_1, PARTFUN1, MCART_1, FUNCT_2, BINOP_1, DOMAIN_1, CARD_3,
      NUMBERS, MEMBERED, XXREAL_3, XCMPLX_0, XXREAL_0, SQUARE_1, XREAL_0,
      VALUED_0, RAT_1, NAT_1, VALUED_1, XXREAL_1, XXREAL_2, EXTREAL1,
      COMPLEX1, MESFUNC1, FCONT_1, FCONT_2, SUPINF_1, SUPINF_2, PROB_1,
      RCOMP_1, FINSUB_1, MEASURE1, MEASURE3, MEASURE5, MEASUR12, MESFUNC2,
      MESFUNC5, MESFUNC6, INTEGRA5, MEASURE8, MEASUR10, MEASUR11, MESFUN12,
      SEQ_1, SEQ_2, SEQ_4, STRUCT_0, ALGSTR_0, PRE_TOPC, NORMSP_0, NORMSP_1,
      NFCONT_1, LOPBAN_1, LOPBAN_5, PRVECT_3, NFCONT_2, DUALSP02, FDIFF_1,
      SIN_COS, EUCLID, JORDAN2C, NDIFF_1;
 constructors EXTREAL1, SUPINF_1, MESFUNC2, MEASUR11, MESFUN12, MESFUNC6,
      DOMAIN_1, FCONT_1, FCONT_2, MEASUR12, INTEGRA1, COMSEQ_2, PROB_3,
      EUCLID, NEWTON, MEASURE3, INTEGRA5, SEQ_2, SEQ_4, BINOP_2, SQUARE_1,
      NFCONT_1, PRVECT_3, NFCONT_2, DUALSP02, LOPBAN_5, NDIFF_8, LPSPACE1,
      VFUNCT_1, FDIFF_1, SIN_COS, JORDAN2C, NDIFF_1, LOPBAN_1;
 registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
      NUMBERS, VALUED_0, RELSET_1, MEASURE1, XXREAL_3, MEMBERED, XXREAL_2,
      SQUARE_1, XXREAL_1, INTEGRA1, FINSUB_1, FCONT_1, TOPGEN_4, STRUCT_0,
      NORMSP_0, NORMSP_1, PRVECT_3, RAT_1, MEASURE3, COMPLEX1, MEASURE5,
      FOMODEL0, FDIFF_1, SIN_COS, EUCLID, TOPREAL1, NDIFF_1, LOPBAN_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, FDIFF_1;
 equalities RCOMP_1, MEASUR10, BINOP_1, MESFUNC6, INTEGRA5, ALGSTR_0,
      NORMSP_0, PRVECT_3, SQUARE_1, DUALSP02, LOPBAN_5;
 expansions TARSKI, XBOOLE_0, MESFUNC1, MEASURE1, FCONT_1, MESFUNC6,
      INTEGRA5, NORMSP_1, NFCONT_1, NFCONT_2, FDIFF_1;
 theorems XBOOLE_0, FUNCT_1, XXREAL_0, XBOOLE_1, XXREAL_3, MEASURE1,
      VALUED_0, FUNCT_2, RELAT_1, MESFUNC5, EXTREAL1, PARTFUN1, MESFUNC1,
      MESFUNC2, MEASUR10, SUBSET_1, MEASUR11, MESFUN11, MESFUN12, RELSET_1,
      MESFUNC6, TARSKI, ZFMISC_1, XREAL_1, PROB_1, ORDINAL1, MEASURE8,
      XTUPLE_0, CARD_3, PRVECT_3, XREAL_0, MESFUN13, MESFUN14, FINSUB_1,
      MEASUR12, NUMBERS, MEASUR13, EUCLID, COMPLEX1, FCONT_1, VALUED_1,
      INTEGRA5, RCOMP_1, ABSVALUE, INT_1, INTEGRA6, XCMPLX_1, MEASURE5,
      SEQ_2, NDIFF_8, SEQ_4, RLVECT_1, XXREAL_2, CARD_4, NORMSP_0, NORMSP_1,
      NFCONT_1, NFCONT_2, DUALSP03, NDIFF_9, NDIFF_1, MEMBERED, RAT_1,
      LOPBAN_3, SQUARE_1, XXREAL_1, INTEGR26, FCONT_2, FDIFF_1, SIN_COS,
      JORDAN2C;
 schemes FUNCT_2;

begin

::$P-
theorem
  for a,b being Real,
      I being Element of L-Field,
      x,y,dx,dy,boundary being PartFunc of REAL,REAL,
      CImg,R being Subset of TOP-REAL 2,
      Rxy being Subset of [:REAL,REAL:],
      U being Subset of [:RNS_Real,RNS_Real:],
      e1,e2 being Point of [:RNS_Real,RNS_Real:],
      P0,Q0 being PartFunc of [:RNS_Real,RNS_Real:],RNS_Real,
      P,Q,K being PartFunc of [:REAL,REAL:],REAL st
    a = 0 & b = 1 & I = [.a,b.] & e1 = [1,0] & e2 = [0,1] &
    I c= dom x & I c= dom y &
    I c= dom dx & I c= dom dy &
    dx|I is_integrable_on L-Meas &
    dy|I is_integrable_on L-Meas &
    (for t being Real st t in I holds
      x.t = x.a + Integral(L-Meas,dx| [.a,t.]) &
      y.t = y.a + Integral(L-Meas,dy| [.a,t.])) &
    x.a = x.b & y.a = y.b &
    (for z being object holds
      z in CImg iff
      ex t being Real st t in I & z = |[x.t,y.t]|) &
    R = BDD CImg &
    (for p,q being Real st |[p,q]| in R holds
      ex w being PartFunc of REAL,REAL st
        I c= dom w &
        (for t being Real st t in I holds
          w.t = ((x.t-p)*dy.t - (y.t-q)*dx.t) /
            ((x.t-p)^2 + (y.t-q)^2)) &
        w|I is_integrable_on L-Meas &
        Integral(L-Meas,w|I) = 2*PI) &
    (for p,q being Real holds
      [p,q] in Rxy iff |[p,q]| in R) &
    U is open &
    (for p,q being Real st |[p,q]| in R \/ CImg holds [p,q] in U) &
    P0 = P & Q0 = Q &
    U c= dom P & U c= dom Q & U c= dom K &
    P0 is_differentiable_on U &
    Q0 is_differentiable_on U &
    (for h,z being Point of [:RNS_Real,RNS_Real:], r being Real
      st z in U & 0 < r holds
      ex s being Real st 0 < s &
        for w being Point of [:RNS_Real,RNS_Real:]
          st w in U & ||.w-z.|| < s holds
          ||.diff(P0,w) . h - diff(P0,z) . h.|| < r) &
    (for h,z being Point of [:RNS_Real,RNS_Real:], r being Real
      st z in U & 0 < r holds
      ex s being Real st 0 < s &
        for w being Point of [:RNS_Real,RNS_Real:]
          st w in U & ||.w-z.|| < s holds
          ||.diff(Q0,w) . h - diff(Q0,z) . h.|| < r) &
    (for p,q being Real, z being Point of [:RNS_Real,RNS_Real:]
      st [p,q] in U & z = [p,q] holds
      K.([p,q]) =
        diff(Q0,z) . e1 - diff(P0,z) . e2) &
    I c= dom boundary &
    (for t being Real st t in I holds
      boundary.t =
        P.([x.t,y.t])*dx.t + Q.([x.t,y.t])*dy.t)
  holds
    (K|Rxy) is_integrable_on Prod_Measure(L-Meas,L-Meas) &
    boundary|I is_integrable_on L-Meas &
    Integral(L-Meas,boundary|I) =
      Integral(Prod_Measure(L-Meas,L-Meas),K|Rxy)
proof
end;
::$P+
