:: Statement-only formalization of Hundred Theorems artifact 100, "Descartes Rule of Signs": for a nonzero real polynomial, coefficient sign variations equal the number of positive real roots counted with multiplicity plus an even natural number. This file contains no proof.

environ

 vocabularies REAL_1, XXREAL_0, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, NAT_1,
      POLYNOM1, VECTSP_1, SUBSET_1, POLYNOM2, XCMPLX_0, POLYNOM3, FUNCT_4,
      STRUCT_0, XBOOLE_0, GROUP_1, ALGSTR_0, ALGSEQ_1, FUNCT_1, SUPINF_2,
      NUMBERS, VALUED_0, MESFUNC1, FINSEQ_1, AFINSQ_1, RLVECT_1, CARD_3,
      BINOP_1, TARSKI, POLYNOM5, PARTFUN1, LATTICES, ORDINAL4, RFINSEQ,
      FINSEQ_2, VECTSP_2, UPROOTS, ZFMISC_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
      VALUED_0, FINSEQ_1, FINSEQ_2, RVSUM_1, RFINSEQ, FUNCT_7, STRUCT_0,
      ALGSTR_0, ALGSTR_1, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2, ALGSEQ_1,
      POLYNOM3, POLYNOM4, POLYNOM5, UPROOTS;
 constructors ALGSEQ_1, POLYNOM4, FUNCT_7, POLYNOM5, BINOP_2, FINSEQ_4,
      UPROOTS, RFINSEQ, RVSUM_1, VECTSP_2, ALGSTR_1;
 registrations XREAL_0, RELAT_1, FUNCT_1, ORDINAL1, XXREAL_0, VECTSP_1,
      CARD_1, POLYNOM3, FUNCT_7, PRE_POLY, STRUCT_0, RLVECT_1, MEMBERED,
      RELSET_1, POLYNOM5, XCMPLX_0, NUMBERS, FUNCT_2, XBOOLE_0, NAT_1,
      VALUED_0, FINSEQ_1, FINSEQ_2, RVSUM_1, VECTSP_2, ALGSTR_1, UPROOTS;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RELAT_1, FUNCT_2, ALGSEQ_1;
 equalities XCMPLX_0, VECTSP_1, POLYNOM3, POLYNOM5, STRUCT_0, ALGSTR_0;
 expansions TARSKI, ALGSEQ_1, POLYNOM5, UPROOTS;
 theorems TARSKI, FUNCT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, POLYNOM3,
      POLYNOM4, POLYNOM5, UPROOTS, CARD_1, NAT_1, XREAL_0, XXREAL_0;
 schemes FINSEQ_1;

begin

::$P-
theorem
  for p being non-zero Polynomial of F_Real
  holds ex roots being FinSequence of the carrier of F_Real,
           mults being FinSequence of NAT,
           d being Nat st
    roots is one-to-one &
    (for x being Element of F_Real holds
      x in rng roots iff 0 < x & eval(p,x) = 0.F_Real) &
    len mults = len roots &
    (for i being Nat st i in dom roots holds
      mults.i = multiplicity(p,roots/.i)) &
    card { [i,j] where i,j is Nat :
      i < j & j < len p & p.i * p.j < 0 &
      (for k being Nat st i < k & k < j holds p.k = 0.F_Real) }
      = Sum mults + 2 * d
proof
end;
::$P+
