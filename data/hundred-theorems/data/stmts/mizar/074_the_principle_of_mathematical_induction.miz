:: Statement-only formalization of "The Principle of Mathematical Induction"
:: for corpus artifact hundred-theorems__mizar__074. Every subset of the
:: natural numbers that contains zero and is closed under successor contains
:: every natural number. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1;
 constructors NAT_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for P being Subset of NAT st
    {} in P &
    (for n being Nat st n in P holds n + 1 in P)
  holds for n being Nat holds n in P
proof
end;
::$P+
