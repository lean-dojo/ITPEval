:: Statement-only formalization of Hundred Theorems artifact 073,
:: "Ascending or Descending Sequences (Erdos-Szekeres)": every sequence of
:: m*n+1 elements of a linearly ordered set has a nondecreasing subsequence
:: of length m+1 or a strictly decreasing subsequence of length n+1.
:: This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, RELAT_1,
      RELAT_2, TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, XCMPLX_0, XREAL_0,
      XXREAL_0, ARYTM_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1,
      XREAL_0, RELAT_1, RELSET_1, FUNCT_1, FINSEQ_1, FINSEQ_2, CARD_1,
      FINSET_1, XXREAL_0, RELAT_2, NAT_D;
 constructors REAL_1, NAT_D, RELAT_1, RELSET_1, RELAT_2, FINSEQ_1, FINSEQ_2,
      NAT_1, CARD_1, FINSET_1, XXREAL_0;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, ORDINAL1, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, XCMPLX_0, XREAL_0;
 requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A being non empty set
  for R being Relation of A
  for f being FinSequence of A
  for m,n being Nat st
    R is_reflexive_in A &
    R is_antisymmetric_in A &
    R is_transitive_in A &
    R is_connected_in A &
    len f = m*n+1
  holds
    (ex S being finite Subset of dom f st
      card S = m+1 &
      (for i,j being Nat st i in S & j in S & i <= j
        holds [f.i,f.j] in R))
    or
    (ex T being finite Subset of dom f st
      card T = n+1 &
      (for i,j being Nat st i in T & j in T & i < j
        holds [f.j,f.i] in R & f.j <> f.i))
proof
end;
::$P+
