:: Statement-only formalization of "Minkowski's Fundamental Theorem" from
:: Hundred Theorems item 040. A convex origin-symmetric measurable subset of
:: Euclidean n-space with volume greater than 2^n contains a nonzero integer
:: lattice point. The measurable set and its volume use MML's completion of
:: the product Lebesgue measure, rather than only its underlying product
:: sigma-field. This file contains no proof.

environ

  vocabularies MEASUR14, MEASUR13, FINSEQ_1, FINSEQ_2, NUMBERS, XXREAL_0,
    SUBSET_1, CARD_1, ARYTM_3, ARYTM_1, RELAT_1, REAL_1, FUNCT_1, XBOOLE_0,
    TARSKI, ZFMISC_1, PROB_1, SUPINF_2, VALUED_0, PARTFUN1, MEASURE1,
    MEASURE3, MEASURE5, NAT_1, FUNCT_2, FUNCOP_1, CARD_3, FINSUB_1,
    SETFAM_1, PROB_2,
    XCMPLX_0, STRUCT_0, PRE_TOPC, RLVECT_1, RLTOPSP1, EUCLID, CONVEX1,
    MEMBERED, INT_1, NEWTON, POWER, RVSUM_1, ALGSTR_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
    FUNCT_1, ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, CARD_1,
    FINSUB_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0,
    VALUED_0,
    EXTREAL1, NAT_1, FINSEQ_1, FINSEQ_2, STRUCT_0, ALGSTR_0, PRE_TOPC,
    RLVECT_1, RLTOPSP1, EUCLID, SUPINF_2, PROB_1, PROB_2, MEASURE1,
    MEASURE3, MEASURE4, MEASURE5, MEASUR12, MEASUR13, MEASUR14, CONVEX1,
    INT_1, NEWTON, POWER;
  constructors EXTREAL1, SUPINF_1, DOMAIN_1, FINSEQOP, MEASURE3, PROB_3,
    MEASUR12, MEASUR13, MEASUR14, EUCLID, RLTOPSP1, CONVEX1, INT_1,
    NEWTON, POWER;
  registrations ORDINAL1, XBOOLE_0, RELAT_1, SUBSET_1, XREAL_0, NAT_1,
    NUMBERS, VALUED_0, RELSET_1, MEASURE1, FINSEQ_1, FINSEQ_2, FUNCT_1,
    FUNCT_2, FUNCOP_1, CARD_1, CARD_3, MEASURE9, MEMBERED, SRINGS_4,
    SETFAM_1, MEASUR13, MEASUR14, GLIBPRE1, EUCLID, STRUCT_0, RLVECT_1,
    RLTOPSP1, CONVEX1, INT_1, XXREAL_3, POWER;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI;
  equalities FINSEQ_1, BINOP_1, SUBSET_1, MEASUR13, FINSEQ_2, XCMPLX_0,
    STRUCT_0, ALGSTR_0, RLVECT_1, EUCLID;
  expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for n being non zero Nat,
      B being convex Subset of TOP-REAL n st
    B in COM(XL-Field n,XL-Meas n) &
    (for x being Element of REAL n st x in B holds -x in B) &
    ((2 to_power n) qua ExtReal) < (COM(XL-Meas n)).B
  holds ex u being Element of REAL n st
    u <> 0*n &
    (for i being Nat st i in Seg n holds u.i in INT) &
    u in B
proof
end;
::$P+
