:: Statement-only formalization of "The Perfect Number Theorem" for corpus
:: artifact hundred-theorems__mizar__070. It characterizes even perfect
:: natural numbers as powers of two multiplied by the corresponding prime
:: Mersenne factor. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3, MEMBERED,
    COMPLEX1, SQUARE_1, REAL_1, REALSET1, VALUED_1, NEWTON, ABIAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, MEMBERED, NAT_1,
    NAT_D, COMPLEX1, SQUARE_1, REAL_1, NEWTON, ABIAN;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    FUNCT_1, FUNCT_2, SQUARE_1, COMPLEX1, INT_1, XXREAL_0, NEWTON,
    ABIAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED, NEWTON,
    SQUARE_1, ABIAN;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
    (n is even &
      n <> 0 &
      Sum Sgm { d where d is Element of Seg n : d divides n } = 2 * n
    iff
      ex k being Nat st
        ((2 qua Nat) |^ (k + 1) -' 1) is prime &
        n = (2 |^ k) * ((2 |^ (k + 1)) -' 1))
proof
end;
::$P+
