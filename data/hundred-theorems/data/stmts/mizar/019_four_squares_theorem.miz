:: Statement-only formalization of "Four Squares Theorem" from Hundred Theorems item 019. This
:: file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, SQUARE_1, REAL_1,
    VALUED_0, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, RELAT_1,
    XXREAL_0;
  constructors REAL_1, SQUARE_1, NAT_1, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

:: Lagrange's Four Squares Theorem
::$P-
theorem
  for n being Nat ex a, b, c, d being Nat st
    n = a * a + b * b + c * c + d * d
proof
end;
::$P+
