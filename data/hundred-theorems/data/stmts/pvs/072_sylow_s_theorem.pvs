% Statement-only formalization of "Sylow's Theorem" from Hundred Theorems item 072:
% every prime power dividing the order of a finite group is the order of a
% subgroup. This file contains no proof.

sylow_s_theorem_072[Element: TYPE+]: THEORY
BEGIN
  IMPORTING finite_sets[Element]

  is_group(
      G: finite_set[Element],
      mul: [Element, Element -> Element],
      inv: [Element -> Element],
      one: Element): bool =
    G(one)
      AND (FORALL (x, y: Element):
        G(x) AND G(y) IMPLIES G(mul(x, y)))
      AND (FORALL (x, y, z: Element):
        G(x) AND G(y) AND G(z) IMPLIES
          mul(mul(x, y), z) = mul(x, mul(y, z)))
      AND (FORALL (x: Element):
        G(x) IMPLIES
          mul(one, x) = x AND mul(x, one) = x)
      AND (FORALL (x: Element):
        G(x) IMPLIES
          G(inv(x))
            AND mul(inv(x), x) = one
            AND mul(x, inv(x)) = one)

  is_subgroup(
      H, G: finite_set[Element],
      mul: [Element, Element -> Element],
      inv: [Element -> Element],
      one: Element): bool =
    (FORALL (x: Element): H(x) IMPLIES G(x))
      AND is_group(H, mul, inv, one)

  nat_divides(divisor, value: nat): bool =
    EXISTS (factor: nat): value = divisor * factor

  prime_nat(value: nat): bool =
    value >= 2
      AND (FORALL (divisor: posnat):
        nat_divides(divisor, value)
          IMPLIES divisor = 1 OR divisor = value)

  sylow_s_theorem: bool =
    FORALL (G: finite_set[Element]),
           (mul: [Element, Element -> Element]),
           (inv: [Element -> Element]),
           (one: Element),
           (p, exponent: nat):
      (is_group(G, mul, inv, one)
        AND prime_nat(p)
        AND nat_divides(p ^ exponent, card(G)))
      IMPLIES
        EXISTS (H: finite_set[Element]):
          is_subgroup(H, G, mul, inv, one)
            AND card(H) = p ^ exponent
END sylow_s_theorem_072
