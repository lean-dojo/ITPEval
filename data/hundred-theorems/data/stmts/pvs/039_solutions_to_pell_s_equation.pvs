% Statement-only formalization of Hundred Theorems item 039, "Solutions to Pell's Equation": every nonsquare
% natural parameter has a positive fundamental solution whose Pell recurrence
% generates exactly all integer solutions, up to independent signs.  The
% almost-square case D = a^2 - 1 uses (a, 1) as its generator.  This is a
% statement-only formalization and contains no proof.

solutions_to_pell_s_equation_039: THEORY
BEGIN

  pell_solution(D: nat, x, y: int): bool =
    x * x - (D :: int) * y * y = 1

  nonsquare(D: nat): bool =
    FORALL (k: nat): D /= k * k

  solutions_to_pell_s_equation: bool =
    FORALL (D: nat):
      nonsquare(D) IMPLIES
        EXISTS (x0, y0: nat):
          EXISTS (X, Y: [nat -> nat]):
            y0 > 0
              AND pell_solution(D, (x0 :: int), (y0 :: int))
              AND X(0) = 1
              AND Y(0) = 0
              AND (FORALL (n: nat):
                X(n + 1) =
                  X(n) * x0 + D * Y(n) * y0
                  AND Y(n + 1) =
                    X(n) * y0 + Y(n) * x0)
              AND (FORALL (x, y: int):
                pell_solution(D, x, y)
                  IFF
                    EXISTS (n: nat):
                      (x = (X(n) :: int)
                        OR x = - (X(n) :: int))
                        AND (y = (Y(n) :: int)
                          OR y = - (Y(n) :: int)))
              AND (FORALL (a: nat):
                (a > 1 AND D + 1 = a * a)
                  IMPLIES (x0 = a AND y0 = 1))

END solutions_to_pell_s_equation_039
