% Statement-only formalization of Hundred Theorems artifact 098, "Bertrand's
% Postulate": every natural number greater than one has a prime strictly between
% it and twice itself. This file contains no proof.

bertrand_s_postulate_098: THEORY
BEGIN

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  prime_nat(value: nat): bool =
    value >= 2
      AND FORALL (divisor: posnat):
        nat_divides(divisor, value)
          IMPLIES divisor = 1 OR divisor = value

  bertrand_s_postulate: bool =
    FORALL (n: nat):
      n > 1 IMPLIES
        EXISTS (p: nat):
          prime_nat(p)
            AND n < p
            AND p < 2 * n

END bertrand_s_postulate_098
