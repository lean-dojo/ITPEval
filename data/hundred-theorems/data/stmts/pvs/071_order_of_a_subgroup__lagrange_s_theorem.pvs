% Statement-only formalization of "Order of a Subgroup (Lagrange's Theorem)" from Hundred
% Theorems item 071: the order of a subgroup of a finite group divides the
% order of the group. This file contains no proof.

order_of_a_subgroup_lagrange_071[Element: TYPE+]: THEORY
BEGIN
  IMPORTING finite_sets[Element]

  is_group(
      G: finite_set[Element],
      mul: [Element, Element -> Element],
      inv: [Element -> Element],
      one: Element): bool =
    G(one)
      AND (FORALL (x, y: Element):
        G(x) AND G(y) IMPLIES G(mul(x, y)))
      AND (FORALL (x, y, z: Element):
        G(x) AND G(y) AND G(z) IMPLIES
          mul(mul(x, y), z) = mul(x, mul(y, z)))
      AND (FORALL (x: Element):
        G(x) IMPLIES
          mul(one, x) = x AND mul(x, one) = x)
      AND (FORALL (x: Element):
        G(x) IMPLIES
          G(inv(x))
            AND mul(inv(x), x) = one
            AND mul(x, inv(x)) = one)

  is_subgroup(
      H, G: finite_set[Element],
      mul: [Element, Element -> Element],
      inv: [Element -> Element],
      one: Element): bool =
    (FORALL (x: Element): H(x) IMPLIES G(x))
      AND is_group(H, mul, inv, one)

  finite_cardinality(S: finite_set[Element]): nat =
    card(S)

  nat_divides(divisor, value: nat): bool =
    EXISTS (factor: nat): value = divisor * factor

  order_of_a_subgroup_lagrange: bool =
    FORALL (G, H: finite_set[Element]),
           (mul: [Element, Element -> Element]),
           (inv: [Element -> Element]),
           (one: Element):
      is_group(G, mul, inv, one)
        AND is_subgroup(H, G, mul, inv, one)
        IMPLIES
          nat_divides(finite_cardinality(H), finite_cardinality(G))
END order_of_a_subgroup_lagrange_071
