% Statement-only formalization of "The Principle of Mathematical Induction" from Hundred
% Theorems item 074: a predicate on the natural numbers that holds at zero and is preserved
% by successor holds for every natural number. This file contains no proof.

the_principle_of_mathematical_induction_074: THEORY
BEGIN
  principle_of_mathematical_induction: bool =
    FORALL (P: [nat -> bool]):
      (P(0)
        AND (FORALL (n: nat): P(n) IMPLIES P(n + 1)))
      IMPLIES
        (FORALL (n: nat): P(n))
END the_principle_of_mathematical_induction_074
