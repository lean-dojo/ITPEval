% Statement-only formalization of "The Irrationality of the Square Root of 2" from Hundred
% Theorems item 001. This file contains no proof.

irrationality_sqrt_2: THEORY
BEGIN
  sqrt_value(root, radicand: real): bool =
    0 <= root AND root * root = radicand

  irrational(x: real): bool =
    NOT rational?(x)

  irrationality_sqrt_2: bool =
    EXISTS (sqrt_2: real):
      sqrt_value(sqrt_2, 2)
        AND irrational(sqrt_2)
END irrationality_sqrt_2
