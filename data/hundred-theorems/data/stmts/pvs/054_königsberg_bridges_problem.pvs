% Statement-only formalization of "Konigsberg Bridges Problem" from Hundred Theorems item 054.
% This file contains no proof.

konigsberg_bridges_problem_054: THEORY
BEGIN
  is_bridge(e: nat): bool =
    e = 10 OR e = 20 OR e = 30 OR e = 40
      OR e = 50 OR e = 60 OR e = 70

  connects(e, u, v: nat): bool =
    (e = 10 AND ((u = 0 AND v = 1) OR (u = 1 AND v = 0)))
      OR (e = 20 AND ((u = 0 AND v = 2) OR (u = 2 AND v = 0)))
      OR (e = 30 AND ((u = 0 AND v = 3) OR (u = 3 AND v = 0)))
      OR (e = 40 AND ((u = 1 AND v = 2) OR (u = 2 AND v = 1)))
      OR (e = 50 AND ((u = 1 AND v = 2) OR (u = 2 AND v = 1)))
      OR (e = 60 AND ((u = 2 AND v = 3) OR (u = 3 AND v = 2)))
      OR (e = 70 AND ((u = 2 AND v = 3) OR (u = 3 AND v = 2)))

  uses_every_bridge_once(edge_at: [nat -> nat]): bool =
    (FORALL (i: nat):
      i < 7 IMPLIES is_bridge(edge_at(i)))
      AND
    (FORALL (e: nat):
      is_bridge(e) IMPLIES
        (EXISTS (i: nat): i < 7 AND edge_at(i) = e))
      AND
    (FORALL (i, j: nat):
      i < 7 AND j < 7 AND edge_at(i) = edge_at(j)
        IMPLIES i = j)

  eulerian_trail(
      edge_at, vertex_at: [nat -> nat]): bool =
    uses_every_bridge_once(edge_at)
      AND
    (FORALL (i: nat):
      i < 7 IMPLIES
        connects(edge_at(i), vertex_at(i), vertex_at(i + 1)))

  konigsberg_bridges_problem: bool =
    NOT (EXISTS (edge_at: [nat -> nat]):
      EXISTS (vertex_at: [nat -> nat]):
        eulerian_trail(edge_at, vertex_at))
END konigsberg_bridges_problem_054
