% Statement-only formalization of "Wilson's Theorem" from Hundred Theorems item 051:
% for every natural number other than 1, primality is equivalent to its
% predecessor factorial being congruent to the predecessor modulo the number.
% This file contains no proof.

wilson_s_theorem_051: THEORY
BEGIN

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  prime_nat(value: nat): bool =
    value >= 2
      AND FORALL (divisor: posnat):
        nat_divides(divisor, value)
          IMPLIES divisor = 1 OR divisor = value

  nat_predecessor(value: nat): nat =
    IF value = 0 THEN 0 ELSE value - 1 ENDIF

  nat_factorial(value: nat): RECURSIVE nat =
    IF value = 0 THEN
      1
    ELSE
      value * nat_factorial(value - 1)
    ENDIF
  MEASURE value

  nat_congruent(left, right, modulus: nat): bool =
    EXISTS (offset: int):
      (left :: int) - (right :: int) = (modulus :: int) * offset

  wilson_s_theorem: bool =
    FORALL (n: nat):
      n /= 1 IMPLIES
        (prime_nat(n)
          IFF nat_congruent(
            nat_factorial(nat_predecessor(n)),
            nat_predecessor(n),
            n))

END wilson_s_theorem_051
