% Statement-only formalization of "The Triangle Inequality" from Hundred
% Theorems artifact 091: the norm of a sum in an arbitrary real inner-product
% space is at most the sum of the two norms. This file contains no proof.

triangle_inequality_091[
  V: TYPE+,
  zero: V,
  vadd: [V, V -> V],
  vneg: [V -> V],
  scale: [real, V -> V],
  inner: [V, V -> real],
  magnitude: [V -> real]
]: THEORY
BEGIN
  vector_space_laws: bool =
    (FORALL (u, v: V): vadd(u, v) = vadd(v, u))
      AND (FORALL (u, v, w: V):
        vadd(vadd(u, v), w) = vadd(u, vadd(v, w)))
      AND (FORALL (u: V): vadd(u, zero) = u)
      AND (FORALL (u: V): vadd(u, vneg(u)) = zero)
      AND (FORALL (a: real), (u, v: V):
        scale(a, vadd(u, v)) = vadd(scale(a, u), scale(a, v)))
      AND (FORALL (a, b: real), (u: V):
        scale(a + b, u) = vadd(scale(a, u), scale(b, u)))
      AND (FORALL (a, b: real), (u: V):
        scale(a * b, u) = scale(a, scale(b, u)))
      AND (FORALL (u: V): scale(1, u) = u)
      AND (FORALL (u: V): scale(0, u) = zero)
      AND (FORALL (u: V): vneg(u) = scale(-1, u))

  inner_product_laws: bool =
    (FORALL (u, v, w: V):
      inner(vadd(u, v), w) = inner(u, w) + inner(v, w))
      AND (FORALL (a: real), (u, v: V):
        inner(scale(a, u), v) = a * inner(u, v))
      AND (FORALL (u, v: V): inner(u, v) = inner(v, u))
      AND (FORALL (u: V): 0 <= inner(u, u))

  magnitude_laws: bool =
    FORALL (u: V):
      0 <= magnitude(u)
        AND magnitude(u) * magnitude(u) = inner(u, u)

  real_inner_product_space: bool =
    vector_space_laws AND inner_product_laws AND magnitude_laws

  triangle_inequality: bool =
    real_inner_product_space IMPLIES
      (FORALL (u, v: V):
        magnitude(vadd(u, v)) <= magnitude(u) + magnitude(v))
END triangle_inequality_091
