% Statement-only formalization of Hundred Theorems artifact 081, "Divergence
% of the Prime Reciprocal Series": the real partial sums of reciprocals of
% natural primes tend to positive infinity. This file contains no proof.

divergence_of_the_prime_reciprocal_series_081: THEORY
BEGIN

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN 0 ELSE numerator / denominator ENDIF

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  prime_nat(value: nat): bool =
    value >= 2
      AND FORALL (divisor: posnat):
        nat_divides(divisor, value)
          IMPLIES divisor = 1 OR divisor = value

  prime_reciprocal_partial_sum(limit: nat): RECURSIVE real =
    IF limit = 0 THEN
      0
    ELSE
      prime_reciprocal_partial_sum(limit - 1)
        + IF prime_nat(limit)
            THEN safe_div(1, limit :: real)
            ELSE 0
          ENDIF
    ENDIF
  MEASURE limit

  divergence_of_the_prime_reciprocal_series: bool =
    FORALL (bound: real):
      EXISTS (cutoff: nat):
        FORALL (limit: nat):
          cutoff <= limit IMPLIES
            bound <= prime_reciprocal_partial_sum(limit)

END divergence_of_the_prime_reciprocal_series_081
