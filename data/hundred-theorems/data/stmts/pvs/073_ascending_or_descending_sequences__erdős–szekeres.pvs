% Statement-only formalization of Hundred Theorems artifact 073,
% "Ascending or Descending Sequences (Erdős–Szekeres)": every sequence of
% m*n+1 terms in a linear order has a nondecreasing subsequence of length m+1
% or a strictly decreasing subsequence of length n+1. This file contains no proof.

ascending_or_descending_sequences_073[
  Value: TYPE+,
  le: [Value, Value -> bool]
]: THEORY
BEGIN
  linear_order_laws: bool =
    (FORALL (x: Value): le(x, x))
      AND
    (FORALL (x, y: Value):
      le(x, y) AND le(y, x) IMPLIES x = y)
      AND
    (FORALL (x, y, z: Value):
      le(x, y) AND le(y, z) IMPLIES le(x, z))
      AND
    (FORALL (x, y: Value):
      le(x, y) OR le(y, x))

  valid_subsequence(
      indices: [nat -> nat],
      count, bound: nat): bool =
    (FORALL (i: nat):
      i < count IMPLIES indices(i) < bound)
      AND
    (FORALL (i, j: nat):
      i < j AND j < count
        IMPLIES indices(i) < indices(j))

  nondecreasing_on(
      f: [nat -> Value],
      indices: [nat -> nat],
      count: nat): bool =
    FORALL (i, j: nat):
      i < j AND j < count
        IMPLIES le(f(indices(i)), f(indices(j)))

  strictly_decreasing_on(
      f: [nat -> Value],
      indices: [nat -> nat],
      count: nat): bool =
    FORALL (i, j: nat):
      i < j AND j < count
        IMPLIES
          le(f(indices(j)), f(indices(i)))
            AND NOT le(f(indices(i)), f(indices(j)))

  erdos_szekeres: bool =
    linear_order_laws IMPLIES
      FORALL (f: [nat -> Value]), (m, n: nat):
        (EXISTS (indices: [nat -> nat]):
          valid_subsequence(indices, m + 1, m * n + 1)
            AND nondecreasing_on(f, indices, m + 1))
          OR
        (EXISTS (indices: [nat -> nat]):
          valid_subsequence(indices, n + 1, m * n + 1)
            AND strictly_decreasing_on(f, indices, n + 1))
END ascending_or_descending_sequences_073
