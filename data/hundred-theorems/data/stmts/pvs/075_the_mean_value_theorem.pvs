% Statement-only formalization of Hundred Theorems item 075, "The Mean Value Theorem":
% a real function continuous on a closed interval and differentiable on its
% interior has an interior point whose derivative realizes the secant slope.
% This file contains no proof.

the_mean_value_theorem_075: THEORY
BEGIN
  real_function: TYPE = [real -> real]

  in_closed_interval(x, a, b: real): bool =
    a <= x AND x <= b

  strictly_between(x, a, b: real): bool =
    a < x AND x < b

  continuous_on_closed_interval(
      f: real_function,
      a, b: real): bool =
    FORALL (x: real):
      in_closed_interval(x, a, b)
        IMPLIES
          FORALL (epsilon: real):
            epsilon > 0 IMPLIES
              EXISTS (delta: real):
                delta > 0
                  AND FORALL (y: real):
                    (in_closed_interval(y, a, b)
                      AND abs(y - x) < delta)
                      IMPLIES
                        abs(f(y) - f(x)) < epsilon

  has_derivative_at(
      f: real_function,
      derivative, x: real): bool =
    FORALL (epsilon: real):
      epsilon > 0 IMPLIES
        EXISTS (delta: real):
          delta > 0
            AND FORALL (h: real):
              (NOT (h = 0) AND abs(h) < delta)
                IMPLIES
                  abs(
                    f(x + h) - f(x)
                      - derivative * h)
                    < epsilon * abs(h)

  mean_value_theorem: bool =
    FORALL
        (f, f_prime: real_function),
        (a, b: real):
      (a < b
        AND continuous_on_closed_interval(f, a, b)
        AND (FORALL (x: real):
          strictly_between(x, a, b)
            IMPLIES
              has_derivative_at(f, f_prime(x), x)))
      IMPLIES
        EXISTS (c: real):
          strictly_between(c, a, b)
            AND f(b) - f(a) = f_prime(c) * (b - a)
END the_mean_value_theorem_075
