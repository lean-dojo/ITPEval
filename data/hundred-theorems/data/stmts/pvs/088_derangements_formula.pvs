% Statement-only formalization of "Derangements Formula" from Hundred Theorems artifact
% hundred-theorems__pvs__088: the number of fixed-point-free permutations of a nonempty finite
% set is the nearest integer to its cardinality factorial divided by e. This file contains no proof.

derangements_formula_088[Element: TYPE+]: THEORY
BEGIN
  IMPORTING finite_sets[Element]

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  nat_factorial(n: nat): RECURSIVE nat =
    IF n = 0 THEN
      1
    ELSE
      n * nat_factorial(n - 1)
    ENDIF
  MEASURE n

  exponential_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        exponential_partial(x, count - 1)
          + safe_div(
              x ^ index,
              nat_factorial(index) :: real)
    ENDIF
  MEASURE count

  converges_to(sequence: [nat -> real], value: real): bool =
    FORALL (eps: posreal):
      EXISTS (cutoff: nat):
        FORALL (count: nat):
          cutoff <= count IMPLIES
            abs(sequence(count) - value) < eps

  real_exponential(x: real): real =
    epsilon(
      LAMBDA (value: real):
        converges_to(
          (LAMBDA (count: nat):
            exponential_partial(x, count)),
          value))

  e: real = real_exponential(1)

  permutation_on(
      S: finite_set[Element],
      p: [Element -> Element]): bool =
    (FORALL (x: Element):
      S(x) IMPLIES S(p(x)))
      AND
        (FORALL (x, y: Element):
          S(x) AND S(y) AND p(x) = p(y)
            IMPLIES x = y)
      AND
        (FORALL (y: Element):
          S(y) IMPLIES
            EXISTS (x: Element):
              S(x) AND p(x) = y)
      AND
        (FORALL (x: Element):
          NOT S(x) IMPLIES p(x) = x)

  deranges(
      S: finite_set[Element],
      p: [Element -> Element]): bool =
    permutation_on(S, p)
      AND
        (FORALL (x: Element):
          S(x) IMPLIES p(x) /= x)

  derangement_family(
      S: finite_set[Element],
      family: finite_set[[Element -> Element]]): bool =
    FORALL (p: [Element -> Element]):
      family(p) IFF deranges(S, p)

  nearest_natural(x: real, n: nat): bool =
    abs((n :: real) - x) < 1 / 2

  derangements_formula: bool =
    FORALL (S: finite_set[Element]):
      card(S) > 0 IMPLIES
        EXISTS (family: finite_set[[Element -> Element]]):
          derangement_family(S, family)
            AND nearest_natural(
              safe_div(
                nat_factorial(card(S)) :: real,
                e),
              card(family))
END derangements_formula_088
