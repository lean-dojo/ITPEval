% Statement-only formalization of "Law of Quadratic Reciprocity" from Hundred Theorems item 007.
% This file contains no proof.

law_of_quadratic_reciprocity: THEORY
BEGIN

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  prime_nat(n: nat): bool =
    n >= 2 AND
      FORALL (divisor: posnat):
        nat_divides(divisor, n) IMPLIES
          divisor = 1 OR divisor = n

  quadratic_residue(a: nat, p: posnat): bool =
    EXISTS (x: nat): mod(x ^ 2, p) = mod(a, p)

  legendre_symbol(a: nat, p: posnat): int =
    IF mod(a, p) = 0 THEN
      0
    ELSIF quadratic_residue(a, p) THEN
      1
    ELSE
      -1
    ENDIF

  law_of_quadratic_reciprocity: bool =
    FORALL (p, q: posnat):
      (prime_nat(p)
        AND prime_nat(q)
        AND mod(p, 2) = 1
        AND mod(q, 2) = 1
        AND p /= q)
      IMPLIES
        legendre_symbol(p, q) * legendre_symbol(q, p)
          = (-1 :: int) ^ (ndiv(p - 1, 2) * ndiv(q - 1, 2))

END law_of_quadratic_reciprocity
