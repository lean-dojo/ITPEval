% Statement-only formalization of "Fermat's Last Theorem" from Hundred Theorems item 033:
% for every natural exponent greater than two, no positive natural bases satisfy the Fermat
% equation. This file contains no proof.

fermat_s_last_theorem_033: THEORY
BEGIN
  fermat_s_last_theorem: bool =
    FORALL (n: nat):
      n > 2 IMPLIES
        NOT EXISTS (a, b, c: posnat):
          a ^ n + b ^ n = c ^ n
END fermat_s_last_theorem_033
