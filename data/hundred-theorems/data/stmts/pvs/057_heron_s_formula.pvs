% Statement-only formalization of "Heron's Formula" from Hundred Theorems item 057:
% in an arbitrary real inner-product space, a triangle's area is determined by its
% three side lengths and semiperimeter. This file contains no proof.

heron_s_formula_057[
  V: TYPE+,
  zero: V,
  vadd: [V, V -> V],
  vneg: [V -> V],
  scale: [real, V -> V],
  inner: [V, V -> real]
]: THEORY
BEGIN
  vector_space_laws: bool =
    (FORALL (u, v: V): vadd(u, v) = vadd(v, u))
      AND (FORALL (u, v, w: V):
        vadd(vadd(u, v), w) = vadd(u, vadd(v, w)))
      AND (FORALL (u: V): vadd(u, zero) = u)
      AND (FORALL (u: V): vadd(u, vneg(u)) = zero)
      AND (FORALL (a: real), (u, v: V):
        scale(a, vadd(u, v)) = vadd(scale(a, u), scale(a, v)))
      AND (FORALL (a, b: real), (u: V):
        scale(a + b, u) = vadd(scale(a, u), scale(b, u)))
      AND (FORALL (a, b: real), (u: V):
        scale(a * b, u) = scale(a, scale(b, u)))
      AND (FORALL (u: V): scale(1, u) = u)
      AND (FORALL (u: V): scale(0, u) = zero)
      AND (FORALL (u: V): vneg(u) = scale(-1, u))

  inner_product_laws: bool =
    (FORALL (u, v, w: V):
      inner(vadd(u, v), w) = inner(u, w) + inner(v, w))
      AND (FORALL (a: real), (u, v: V):
        inner(scale(a, u), v) = a * inner(u, v))
      AND (FORALL (u, v: V): inner(u, v) = inner(v, u))
      AND (FORALL (u: V): 0 <= inner(u, u))
      AND (FORALL (u: V): inner(u, u) = 0 IFF u = zero)

  real_inner_product_space: bool =
    vector_space_laws AND inner_product_laws

  displacement(P, Q: V): V =
    vadd(Q, vneg(P))

  squared_distance(P, Q: V): real =
    inner(displacement(P, Q), displacement(P, Q))

  sqrt_value(root, radicand: real): bool =
    0 <= root AND root * root = radicand

  gram_determinant(A, B, C: V): real =
    inner(displacement(A, B), displacement(A, B))
      * inner(displacement(A, C), displacement(A, C))
      - inner(displacement(A, B), displacement(A, C)) ^ 2

  triangle_area_value(area: real, A, B, C: V): bool =
    sqrt_value(area, gram_determinant(A, B, C) / 4)

  semiperimeter(a, b, c: real): real =
    (a + b + c) / 2

  heron_radicand(a, b, c: real): real =
    semiperimeter(a, b, c)
      * (semiperimeter(a, b, c) - a)
      * (semiperimeter(a, b, c) - b)
      * (semiperimeter(a, b, c) - c)

  herons_formula: bool =
    real_inner_product_space IMPLIES
      (FORALL (A, B, C: V):
        EXISTS (a, b, c, area: real):
          sqrt_value(a, squared_distance(C, B))
            AND sqrt_value(b, squared_distance(A, C))
            AND sqrt_value(c, squared_distance(B, A))
            AND triangle_area_value(area, A, B, C)
            AND sqrt_value(area, heron_radicand(a, b, c)))
END heron_s_formula_057
