% Statement-only formalization of "The Non-Denumerability of the Continuum" from Hundred
% Theorems item 022. This file contains no proof.

the_non_denumerability_of_the_continuum: THEORY
BEGIN
  the_non_denumerability_of_the_continuum: bool =
    FORALL (enumeration: [nat -> real]):
      EXISTS (missing: real):
        FORALL (n: nat): missing /= enumeration(n)
END the_non_denumerability_of_the_continuum
