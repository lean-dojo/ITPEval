% Statement-only formalization of "Pythagorean Theorem" from Hundred Theorems item 004. This
% file contains no proof.

pythagorean_theorem_004: THEORY
BEGIN
  point: TYPE = [# x_coord: real, y_coord: real #]

  displacement(P, Q: point): point =
    (# x_coord := x_coord(Q) - x_coord(P),
       y_coord := y_coord(Q) - y_coord(P) #)

  dot(u, v: point): real =
    x_coord(u) * x_coord(v) + y_coord(u) * y_coord(v)

  orthogonal(u, v: point): bool =
    dot(u, v) = 0

  squared_distance(P, Q: point): real =
    dot(displacement(P, Q), displacement(P, Q))

  pythagorean_theorem: bool =
    FORALL (A, B, C: point):
      orthogonal(displacement(B, A), displacement(B, C))
        IFF
      squared_distance(A, C) =
        squared_distance(A, B) + squared_distance(B, C)
END pythagorean_theorem_004
