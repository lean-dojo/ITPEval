% Statement-only formalization of "All Primes (1 mod 4) Equal the Sum of Two Squares" from
% Hundred Theorems item 020. This file contains no proof.

all_primes_1_mod_4_sum_of_two_squares_020: THEORY
BEGIN

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  prime_nat(p: nat): bool =
    p >= 2
      AND FORALL (divisor: posnat):
        nat_divides(divisor, p)
          IMPLIES divisor = 1 OR divisor = p

  all_primes_1_mod_4_equal_sum_of_two_squares: bool =
    FORALL (p: nat):
      (prime_nat(p) AND mod(p, 4) = 1)
        IMPLIES
          EXISTS (x, y: nat):
            p = x ^ 2 + y ^ 2

END all_primes_1_mod_4_sum_of_two_squares_020
