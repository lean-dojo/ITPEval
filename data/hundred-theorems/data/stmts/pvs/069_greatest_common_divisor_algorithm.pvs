% Statement-only formalization of Hundred Theorems artifact 069, "Greatest
% Common Divisor Algorithm": the subtraction-based Euclidean algorithm on
% natural numbers returns a common divisor divisible by every common divisor.
% This file contains no proof.

greatest_common_divisor_algorithm_069: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  subtractive_gcd(left, right: nat): RECURSIVE nat =
    IF left = 0 THEN
      right
    ELSIF right = 0 THEN
      left
    ELSIF left <= right THEN
      subtractive_gcd(left, right - left)
    ELSE
      subtractive_gcd(left - right, right)
    ENDIF
  MEASURE left + right

  greatest_common_divisor_algorithm: bool =
    FORALL (left, right: nat):
      nat_divides(subtractive_gcd(left, right), left)
        AND nat_divides(subtractive_gcd(left, right), right)
        AND (FORALL (common_divisor: nat):
          nat_divides(common_divisor, left)
            AND nat_divides(common_divisor, right)
            IMPLIES
              nat_divides(
                common_divisor,
                subtractive_gcd(left, right)))

END greatest_common_divisor_algorithm_069
