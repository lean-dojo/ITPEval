% Statement-only formalization of Hundred Theorems item 063, "Cantor's Theorem":
% no function from an arbitrary type onto its predicate powerset is surjective.
% This file contains no proof.

cantors_theorem_063[A: TYPE]: THEORY
BEGIN

  surjective_to_powerset(f: [A -> [A -> bool]]): bool =
    FORALL (subset: [A -> bool]):
      EXISTS (x: A): f(x) = subset

  cantors_theorem: bool =
    FORALL (f: [A -> [A -> bool]]):
      NOT surjective_to_powerset(f)

END cantors_theorem_063
