% Statement-only formalization of Hundred Theorems item 035, "Taylor's Theorem":
% a finite expansion about an arbitrary center under relative closed-interval
% regularity, with a factorial-scaled Lagrange remainder evaluated at a strict
% intermediate point. This file contains no proof.

taylor_s_theorem_035: THEORY
BEGIN
  real_function: TYPE = [real -> real]
  derivative_sequence: TYPE = [nat -> real_function]

  factorial(n: nat): RECURSIVE nat =
    IF n = 0 THEN
      1
    ELSE
      n * factorial(n - 1)
    ENDIF
  MEASURE n

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN 0 ELSE numerator / denominator ENDIF

  in_closed_interval(x, a, b: real): bool =
    (a <= x AND x <= b) OR (b <= x AND x <= a)

  strictly_between(x, a, b: real): bool =
    (a < x AND x < b) OR (b < x AND x < a)

  continuous_within_at(
      f: real_function,
      x, a, b: real): bool =
    FORALL (epsilon: real):
      epsilon > 0 IMPLIES
        EXISTS (delta: real):
          delta > 0
            AND FORALL (y: real):
              (in_closed_interval(y, a, b)
                AND abs(y - x) < delta)
                IMPLIES
                  abs(f(y) - f(x)) < epsilon

  has_derivative_within(
      f: real_function,
      derivative, x, a, b: real): bool =
    FORALL (epsilon: real):
      epsilon > 0 IMPLIES
        EXISTS (delta: real):
          delta > 0
            AND FORALL (y: real):
              (in_closed_interval(y, a, b)
                AND NOT (y = x)
                AND abs(y - x) < delta)
                IMPLIES
                  abs(
                    (f(y) - f(x)) / (y - x)
                      - derivative)
                    < epsilon

  has_derivative_at(f: real_function, derivative, x: real): bool =
    FORALL (epsilon: real):
      epsilon > 0 IMPLIES
        EXISTS (delta: real):
          delta > 0
            AND FORALL (h: real):
              (NOT (h = 0) AND abs(h) < delta)
                IMPLIES
                  abs((f(x + h) - f(x)) / h - derivative) < epsilon

  is_derivative_sequence_on(
      derivatives: derivative_sequence,
      degree: nat,
      a, b: real): bool =
    (FORALL (k: nat), (x: real):
      (k <= degree AND in_closed_interval(x, a, b))
        IMPLIES
          continuous_within_at(
            derivatives(k), x, a, b))
      AND (FORALL (k: nat), (x: real):
        (k < degree AND in_closed_interval(x, a, b))
          IMPLIES
            has_derivative_within(
              derivatives(k),
              derivatives(k + 1)(x),
              x,
              a,
              b))
      AND (FORALL (x: real):
        strictly_between(x, a, b)
          IMPLIES
            has_derivative_at(
              derivatives(degree),
              derivatives(degree + 1)(x),
              x))

  taylor_polynomial(
      derivatives: derivative_sequence,
      center, x: real,
      count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET k: nat = count - 1 IN
        taylor_polynomial(derivatives, center, x, count - 1)
          + safe_div(
              derivatives(k)(center) * (x - center) ^ k,
              factorial(k) :: real)
    ENDIF
  MEASURE count

  taylor_s_theorem: bool =
    FORALL
        (derivatives: derivative_sequence),
        (center, x: real),
        (degree: nat):
      (NOT (center = x)
        AND is_derivative_sequence_on(
          derivatives, degree, center, x))
      IMPLIES
        EXISTS (remainder_point: real):
          strictly_between(remainder_point, center, x)
            AND derivatives(0)(x)
              = taylor_polynomial(
                  derivatives, center, x, degree + 1)
                + derivatives(degree + 1)(remainder_point)
                    * safe_div(
                        (x - center) ^ (degree + 1),
                        factorial(degree + 1) :: real)
END taylor_s_theorem_035
