% Statement-only formalization of "Formula for the Number of Combinations" from
% Hundred Theorems item 058: for every finite set, the subsets of any fixed
% cardinality are counted by the corresponding binomial coefficient. This file
% contains no proof.

formula_for_the_number_of_combinations_058[Element: TYPE]: THEORY
BEGIN
  IMPORTING finite_sets[Element], finite_sets_of_sets[Element]

  binomial_coefficient(n, m: nat): RECURSIVE nat =
    IF m = 0 THEN
      1
    ELSIF n = 0 THEN
      0
    ELSE
      binomial_coefficient(n - 1, m - 1)
        + binomial_coefficient(n - 1, m)
    ENDIF
  MEASURE n

  subsets_of_cardinality(A: finite_set[Element], m: nat):
      finite_set[finite_set[Element]] =
    intersection(
      powerset(A),
      {B: finite_set[Element] | card(B) = m})

  formula_for_the_number_of_combinations: bool =
    FORALL (A: finite_set[Element]), (m: nat):
      card(subsets_of_cardinality(A, m))
        = binomial_coefficient(card(A), m)
END formula_for_the_number_of_combinations_058
