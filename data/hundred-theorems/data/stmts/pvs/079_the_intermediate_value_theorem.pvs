% Statement-only formalization of Hundred Theorems item 079, "The Intermediate Value Theorem":
% a real function continuous on a closed interval attains every real value
% lying between its endpoint values. This file contains no proof.

the_intermediate_value_theorem_079: THEORY
BEGIN
  real_function: TYPE = [real -> real]

  in_closed_interval(x, a, b: real): bool =
    a <= x AND x <= b

  continuous_on_closed_interval(
      f: real_function,
      a, b: real): bool =
    FORALL (x: real):
      in_closed_interval(x, a, b)
        IMPLIES
          FORALL (epsilon: real):
            epsilon > 0 IMPLIES
              EXISTS (delta: real):
                delta > 0
                  AND FORALL (z: real):
                    (in_closed_interval(z, a, b)
                      AND abs(z - x) < delta)
                      IMPLIES
                        abs(f(z) - f(x)) < epsilon

  lies_between(y, u, v: real): bool =
    (u <= y AND y <= v) OR (v <= y AND y <= u)

  intermediate_value_theorem: bool =
    FORALL
        (f: real_function),
        (a, b, y: real):
      (a <= b
        AND continuous_on_closed_interval(f, a, b)
        AND lies_between(y, f(a), f(b)))
      IMPLIES
        EXISTS (c: real):
          in_closed_interval(c, a, b)
            AND f(c) = y
END the_intermediate_value_theorem_079
