% Statement-only formalization of "Product of Segments of Chords" from Hundred Theorems
% artifact 055: two chords through a common point in a real inner-product space have equal
% products of segment lengths when their endpoints lie on one sphere. This file contains no
% proof.

product_of_segments_of_chords_055[
  V: TYPE+,
  zero: V,
  vadd: [V, V -> V],
  vneg: [V -> V],
  scale: [real, V -> V],
  inner: [V, V -> real]
]: THEORY
BEGIN
  vector_space_laws: bool =
    (FORALL (u, v: V): vadd(u, v) = vadd(v, u))
      AND (FORALL (u, v, w: V):
        vadd(vadd(u, v), w) = vadd(u, vadd(v, w)))
      AND (FORALL (u: V): vadd(u, zero) = u)
      AND (FORALL (u: V): vadd(u, vneg(u)) = zero)
      AND (FORALL (a: real), (u, v: V):
        scale(a, vadd(u, v)) = vadd(scale(a, u), scale(a, v)))
      AND (FORALL (a, b: real), (u: V):
        scale(a + b, u) = vadd(scale(a, u), scale(b, u)))
      AND (FORALL (a, b: real), (u: V):
        scale(a * b, u) = scale(a, scale(b, u)))
      AND (FORALL (u: V): scale(1, u) = u)
      AND (FORALL (u: V): scale(0, u) = zero)
      AND (FORALL (u: V): vneg(u) = scale(-1, u))

  inner_product_laws: bool =
    (FORALL (u, v, w: V):
      inner(vadd(u, v), w) = inner(u, w) + inner(v, w))
      AND (FORALL (a: real), (u, v: V):
        inner(scale(a, u), v) = a * inner(u, v))
      AND (FORALL (u, v: V): inner(u, v) = inner(v, u))
      AND (FORALL (u: V): 0 <= inner(u, u))
      AND (FORALL (u: V): inner(u, u) = 0 IFF u = zero)

  real_inner_product_space: bool =
    vector_space_laws AND inner_product_laws

  displacement(P, Q: V): V =
    vadd(Q, vneg(P))

  squared_distance(P, Q: V): real =
    inner(displacement(P, Q), displacement(P, Q))

  sqrt_value(root, radicand: real): bool =
    0 <= root AND root * root = radicand

  on_sphere(P, center: V, radius: real): bool =
    sqrt_value(radius, squared_distance(P, center))

  between(M, A, B: V): bool =
    EXISTS (u: real):
      0 <= u
        AND u <= 1
        AND M = vadd(scale(1 - u, A), scale(u, B))

  equal_segment_products(A, M, B, C, N, D: V): bool =
    EXISTS (AM, MB, CN, ND: real):
      sqrt_value(AM, squared_distance(A, M))
        AND sqrt_value(MB, squared_distance(M, B))
        AND sqrt_value(CN, squared_distance(C, N))
        AND sqrt_value(ND, squared_distance(N, D))
        AND AM * MB = CN * ND

  product_of_segments_of_chords: bool =
    real_inner_product_space IMPLIES
      (FORALL (center, q, r, s, t, b: V), (radius: real):
        (between(b, q, r)
          AND between(b, s, t)
          AND on_sphere(q, center, radius)
          AND on_sphere(r, center, radius)
          AND on_sphere(s, center, radius)
          AND on_sphere(t, center, radius))
        IMPLIES equal_segment_products(q, b, r, s, b, t))
END product_of_segments_of_chords_055
