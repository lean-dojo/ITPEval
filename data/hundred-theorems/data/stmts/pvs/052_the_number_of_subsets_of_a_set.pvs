% Statement-only formalization of "The Number of Subsets of a Set" from Hundred Theorems
% item 052: the powerset of every finite set has cardinality two raised to the
% cardinality of the set. This file contains no proof.

the_number_of_subsets_of_a_set_052[Element: TYPE]: THEORY
BEGIN
  IMPORTING finite_sets[Element], finite_sets_of_sets[Element]

  the_number_of_subsets_of_a_set: bool =
    FORALL (A: finite_set[Element]):
      card(powerset(A)) = 2 ^ card(A)
END the_number_of_subsets_of_a_set_052
