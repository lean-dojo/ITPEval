% Statement-only formalization of the Thousand Theorems artifact Q132469,
% "Fermat's Last Theorem": for every natural exponent at least 3, the Fermat
% equation has no solution in which all three natural numbers are nonzero.
% This file contains no proof.

Q132469_fermat_s_last_theorem: THEORY
BEGIN
  FermatLastTheorem: bool =
    FORALL (n: nat):
      n >= 3 IMPLIES
        FORALL (a, b, c: nat):
          (a /= 0 AND b /= 0 AND c /= 0)
            IMPLIES a ^ n + b ^ n /= c ^ n
END Q132469_fermat_s_last_theorem
