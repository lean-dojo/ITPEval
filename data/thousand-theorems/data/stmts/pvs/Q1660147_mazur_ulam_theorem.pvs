% Statement-only formalization of the Thousand Theorems corpus artifact Q1660147
% (thousand-theorems__pvs__Q1660147), "Mazur–Ulam theorem": every isometric
% equivalence between real normed affine spaces is an affine isometry
% equivalence with the same underlying map. This file contains no proof.

mazur_ulam_theorem_Q1660147[
  E: TYPE+,
  F: TYPE+,
  PE: TYPE+,
  PF: TYPE+,
  zeroE: E,
  addE: [E, E -> E],
  negE: [E -> E],
  smulE: [real, E -> E],
  normE: [E -> real],
  zeroF: F,
  addF: [F, F -> F],
  negF: [F -> F],
  smulF: [real, F -> F],
  normF: [F -> real],
  point_vaddE: [E, PE -> PE],
  vsubE: [PE, PE -> E],
  point_vaddF: [F, PF -> PF],
  vsubF: [PF, PF -> F],
  forward: [PE -> PF],
  inverse: [PF -> PE]
]: THEORY
BEGIN
  normed_real_vector_space_E: bool =
    (FORALL (x, y: E):
      addE(x, y) = addE(y, x))
      AND (FORALL (x, y, z: E):
        addE(addE(x, y), z) = addE(x, addE(y, z)))
      AND (FORALL (x: E):
        addE(x, zeroE) = x)
      AND (FORALL (x: E):
        addE(x, negE(x)) = zeroE)
      AND (FORALL (a: real), (x, y: E):
        smulE(a, addE(x, y)) =
          addE(smulE(a, x), smulE(a, y)))
      AND (FORALL (a, b: real), (x: E):
        smulE(a + b, x) =
          addE(smulE(a, x), smulE(b, x)))
      AND (FORALL (a, b: real), (x: E):
        smulE(a * b, x) = smulE(a, smulE(b, x)))
      AND (FORALL (x: E):
        smulE(1, x) = x)
      AND (FORALL (x: E):
        smulE(0, x) = zeroE)
      AND (FORALL (a: real):
        smulE(a, zeroE) = zeroE)
      AND (FORALL (x: E):
        negE(x) = smulE(-1, x))
      AND (FORALL (x: E):
        0 <= normE(x))
      AND (FORALL (x: E):
        normE(x) = 0 IFF x = zeroE)
      AND (FORALL (x: E):
        normE(negE(x)) = normE(x))
      AND (FORALL (x, y: E):
        normE(addE(x, y)) <= normE(x) + normE(y))
      AND (FORALL (a: real), (x: E):
        normE(smulE(a, x)) = abs(a) * normE(x))

  normed_real_vector_space_F: bool =
    (FORALL (x, y: F):
      addF(x, y) = addF(y, x))
      AND (FORALL (x, y, z: F):
        addF(addF(x, y), z) = addF(x, addF(y, z)))
      AND (FORALL (x: F):
        addF(x, zeroF) = x)
      AND (FORALL (x: F):
        addF(x, negF(x)) = zeroF)
      AND (FORALL (a: real), (x, y: F):
        smulF(a, addF(x, y)) =
          addF(smulF(a, x), smulF(a, y)))
      AND (FORALL (a, b: real), (x: F):
        smulF(a + b, x) =
          addF(smulF(a, x), smulF(b, x)))
      AND (FORALL (a, b: real), (x: F):
        smulF(a * b, x) = smulF(a, smulF(b, x)))
      AND (FORALL (x: F):
        smulF(1, x) = x)
      AND (FORALL (x: F):
        smulF(0, x) = zeroF)
      AND (FORALL (a: real):
        smulF(a, zeroF) = zeroF)
      AND (FORALL (x: F):
        negF(x) = smulF(-1, x))
      AND (FORALL (x: F):
        0 <= normF(x))
      AND (FORALL (x: F):
        normF(x) = 0 IFF x = zeroF)
      AND (FORALL (x: F):
        normF(negF(x)) = normF(x))
      AND (FORALL (x, y: F):
        normF(addF(x, y)) <= normF(x) + normF(y))
      AND (FORALL (a: real), (x: F):
        normF(smulF(a, x)) = abs(a) * normF(x))

  normed_add_torsor_E: bool =
    (FORALL (p: PE):
      point_vaddE(zeroE, p) = p)
      AND (FORALL (u, v: E), (p: PE):
        point_vaddE(addE(u, v), p) =
          point_vaddE(u, point_vaddE(v, p)))
      AND (FORALL (p, q: PE):
        point_vaddE(vsubE(p, q), q) = p)
      AND (FORALL (v: E), (p: PE):
        vsubE(point_vaddE(v, p), p) = v)

  normed_add_torsor_F: bool =
    (FORALL (p: PF):
      point_vaddF(zeroF, p) = p)
      AND (FORALL (u, v: F), (p: PF):
        point_vaddF(addF(u, v), p) =
          point_vaddF(u, point_vaddF(v, p)))
      AND (FORALL (p, q: PF):
        point_vaddF(vsubF(p, q), q) = p)
      AND (FORALL (v: F), (p: PF):
        vsubF(point_vaddF(v, p), p) = v)

  isometry_equivalence: bool =
    (FORALL (p: PE):
      inverse(forward(p)) = p)
      AND (FORALL (q: PF):
        forward(inverse(q)) = q)
      AND (FORALL (p, q: PE):
        normF(vsubF(forward(p), forward(q))) =
          normE(vsubE(p, q)))

  linear_isometry_equivalence(
      linear_part: [E -> F],
      linear_inverse: [F -> E]): bool =
    (FORALL (x, y: E):
      linear_part(addE(x, y)) =
        addF(linear_part(x), linear_part(y)))
      AND (FORALL (a: real), (x: E):
        linear_part(smulE(a, x)) =
          smulF(a, linear_part(x)))
      AND (FORALL (x: E):
        normF(linear_part(x)) = normE(x))
      AND (FORALL (x: E):
        linear_inverse(linear_part(x)) = x)
      AND (FORALL (y: F):
        linear_part(linear_inverse(y)) = y)

  coe_toRealAffineIsometryEquiv: bool =
    (normed_real_vector_space_E
      AND normed_real_vector_space_F
      AND normed_add_torsor_E
      AND normed_add_torsor_F
      AND isometry_equivalence)
    IMPLIES
      EXISTS
          (linear_part: [E -> F]),
          (linear_inverse: [F -> E]):
        linear_isometry_equivalence(
          linear_part,
          linear_inverse)
          AND FORALL (v: E), (p: PE):
            forward(point_vaddE(v, p)) =
              point_vaddF(linear_part(v), forward(p))
END mazur_ulam_theorem_Q1660147
