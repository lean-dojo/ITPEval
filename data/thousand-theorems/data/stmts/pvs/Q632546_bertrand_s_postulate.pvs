% Statement-only formalization of "Bertrand's postulate" from Thousand Theorems artifact Q632546:
% every nonzero natural number has a prime strictly above it and at most twice it.
% This file contains no proof.

Q632546_bertrand_s_postulate: THEORY
BEGIN

  nat_divides(divisor: posnat, value: nat): bool =
    EXISTS (quotient: nat): value = divisor * quotient

  prime_nat(value: nat): bool =
    value >= 2 AND
      FORALL (divisor: posnat):
        nat_divides(divisor, value) IMPLIES
          divisor = 1 OR divisor = value

  bertrand_s_postulate: bool =
    FORALL (n: nat):
      n /= 0 IMPLIES
        EXISTS (p: nat):
          prime_nat(p) AND n < p AND p <= 2 * n

END Q632546_bertrand_s_postulate
