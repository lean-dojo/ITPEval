% Statement-only formalization of Thousand Theorems corpus artifact Q189136,
% "Mean value theorem": Lagrange's and Cauchy's mean value theorems for real
% functions on a closed interval. This file contains no proof.

Q189136_mean_value_theorem: THEORY
BEGIN
  real_function: TYPE = [real -> real]

  in_closed_interval(x, a, b: real): bool =
    a <= x AND x <= b

  in_open_interval(x, a, b: real): bool =
    a < x AND x < b

  continuous_on_closed_interval(
      f: real_function,
      a, b: real): bool =
    FORALL (x: real):
      in_closed_interval(x, a, b)
        IMPLIES
          FORALL (epsilon_value: posreal):
            EXISTS (delta: posreal):
              FORALL (y: real):
                (in_closed_interval(y, a, b)
                  AND abs(y - x) < delta)
                  IMPLIES
                    abs(f(y) - f(x)) < epsilon_value

  has_derivative_at(
      f: real_function,
      derivative, x: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (delta: posreal):
        FORALL (h: real):
          (h /= 0 AND abs(h) < delta)
            IMPLIES
              abs(
                f(x + h) - f(x)
                  - derivative * h)
                < epsilon_value * abs(h)

  differentiable_at(f: real_function, x: real): bool =
    EXISTS (derivative: real):
      has_derivative_at(f, derivative, x)

  deriv(f: real_function, x: real): real =
    IF differentiable_at(f, x) THEN
      epsilon(
        LAMBDA (derivative: real):
          has_derivative_at(f, derivative, x))
    ELSE
      0
    ENDIF

  differentiable_on_open_interval(
      f: real_function,
      a, b: real): bool =
    FORALL (x: real):
      in_open_interval(x, a, b)
        IMPLIES differentiable_at(f, x)

  exists_deriv_eq_slope: bool =
    FORALL
        (f: real_function),
        (a, b: real):
      (a < b
        AND continuous_on_closed_interval(f, a, b)
        AND differentiable_on_open_interval(f, a, b))
      IMPLIES
        EXISTS (c: real):
          in_open_interval(c, a, b)
            AND deriv(f, c) = (f(b) - f(a)) / (b - a)

  exists_ratio_deriv_eq_ratio_slope: bool =
    FORALL
        (f, g: real_function),
        (a, b: real):
      (a < b
        AND continuous_on_closed_interval(f, a, b)
        AND continuous_on_closed_interval(g, a, b)
        AND differentiable_on_open_interval(f, a, b)
        AND differentiable_on_open_interval(g, a, b))
      IMPLIES
        EXISTS (c: real):
          in_open_interval(c, a, b)
            AND (g(b) - g(a)) * deriv(f, c)
              = (f(b) - f(a)) * deriv(g, c)

  mean_value_theorem: bool =
    exists_deriv_eq_slope
      AND exists_ratio_deriv_eq_ratio_slope
END Q189136_mean_value_theorem
