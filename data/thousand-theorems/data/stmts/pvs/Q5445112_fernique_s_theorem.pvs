% Statement-only formalization of the Thousand Theorems artifact Q5445112,
% "Fernique's theorem": every Gaussian measure on a complete second-countable
% real normed space integrates exp(C * norm(x)^2) for some C > 0.
% This file contains no proof.

fernique_s_theorem_Q5445112[
  E: TYPE+,
  zeroE: E,
  addE: [E, E -> E],
  negE: [E -> E],
  smulE: [real, E -> E],
  normE: [E -> real]
]: THEORY
BEGIN
  event: TYPE = [E -> bool]
  event_sequence: TYPE = [nat -> event]
  sigma_algebra: TYPE = [event -> bool]

  measure_value: TYPE =
    [# infinite_flag: bool, finite_part: real #]
  measure_value_sequence: TYPE = [nat -> measure_value]
  measure_map: TYPE = [event -> measure_value]

  real_sequence: TYPE = [nat -> real]
  e_sequence: TYPE = [nat -> E]
  scalar_real_function: TYPE = [real -> real]
  real_function: TYPE = [E -> real]
  real_function_sequence: TYPE = [nat -> real_function]
  nonnegative_function: TYPE = [E -> measure_value]

  safe_div(numerator, denominator: real): real =
    IF denominator = 0 THEN
      0
    ELSE
      numerator / denominator
    ENDIF

  nat_factorial(index: nat): RECURSIVE nat =
    IF index = 0 THEN
      1
    ELSE
      index * nat_factorial(index - 1)
    ENDIF
  MEASURE index

  exponential_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        exponential_partial(x, count - 1)
          + safe_div(
              x ^ index,
              nat_factorial(index) :: real)
    ENDIF
  MEASURE count

  sine_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        sine_partial(x, count - 1)
          + safe_div(
              (-1) ^ index * x ^ (2 * index + 1),
              nat_factorial(2 * index + 1) :: real)
    ENDIF
  MEASURE count

  cosine_partial(x: real, count: nat): RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      LET index: nat = count - 1 IN
        cosine_partial(x, count - 1)
          + safe_div(
              (-1) ^ index * x ^ (2 * index),
              nat_factorial(2 * index) :: real)
    ENDIF
  MEASURE count

  converges_to_real(values: real_sequence, limit: real): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            abs(values(index) - limit) < epsilon_value

  is_standard_exponential(
      exponential: scalar_real_function): bool =
    FORALL (x: real):
        converges_to_real(
          LAMBDA (count: nat):
            exponential_partial(x, count),
          exponential(x))

  is_standard_sine(
      sine: scalar_real_function): bool =
    FORALL (x: real):
        converges_to_real(
          LAMBDA (count: nat): sine_partial(x, count),
          sine(x))

  is_standard_cosine(
      cosine: scalar_real_function): bool =
    FORALL (x: real):
        converges_to_real(
          LAMBDA (count: nat): cosine_partial(x, count),
          cosine(x))

  subE(x, y: E): E =
    addE(x, negE(y))

  normed_real_vector_space: bool =
    (FORALL (x, y: E): addE(x, y) = addE(y, x))
      AND (FORALL (x, y, z: E):
        addE(addE(x, y), z) = addE(x, addE(y, z)))
      AND (FORALL (x: E): addE(x, zeroE) = x)
      AND (FORALL (x: E): addE(x, negE(x)) = zeroE)
      AND (FORALL (a: real), (x, y: E):
        smulE(a, addE(x, y)) =
          addE(smulE(a, x), smulE(a, y)))
      AND (FORALL (a, b: real), (x: E):
        smulE(a + b, x) =
          addE(smulE(a, x), smulE(b, x)))
      AND (FORALL (a, b: real), (x: E):
        smulE(a * b, x) = smulE(a, smulE(b, x)))
      AND (FORALL (x: E): smulE(1, x) = x)
      AND (FORALL (x: E): 0 <= normE(x))
      AND (FORALL (x: E): normE(x) = 0 IFF x = zeroE)
      AND (FORALL (a: real), (x: E):
        normE(smulE(a, x)) = abs(a) * normE(x))
      AND (FORALL (x, y: E):
        normE(addE(x, y)) <= normE(x) + normE(y))

  cauchy_e(values: e_sequence): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (left_index, right_index: nat):
          cutoff <= left_index AND cutoff <= right_index
            IMPLIES
              normE(
                subE(
                  values(left_index),
                  values(right_index)))
                < epsilon_value

  converges_to_e(values: e_sequence, limit: E): bool =
    FORALL (epsilon_value: posreal):
      EXISTS (cutoff: nat):
        FORALL (index: nat):
          cutoff <= index IMPLIES
            normE(subE(values(index), limit))
              < epsilon_value

  complete_space_e: bool =
    FORALL (values: e_sequence):
      cauchy_e(values) IMPLIES
        EXISTS (limit: E): converges_to_e(values, limit)

  full_event: event =
    LAMBDA (x: E): TRUE

  empty_event: event =
    LAMBDA (x: E): FALSE

  event_complement(A: event): event =
    LAMBDA (x: E): NOT A(x)

  countable_union(events: event_sequence): event =
    LAMBDA (x: E):
      EXISTS (index: nat): events(index)(x)

  event_subset(A, B: event): bool =
    FORALL (x: E): A(x) IMPLIES B(x)

  pairwise_disjoint(events: event_sequence): bool =
    FORALL (left_index, right_index: nat):
      left_index /= right_index IMPLIES
        FORALL (x: E):
          NOT (events(left_index)(x)
            AND events(right_index)(x))

  metric_open(A: event): bool =
    FORALL (x: E):
      A(x) IMPLIES
        EXISTS (epsilon_value: posreal):
          FORALL (y: E):
            normE(subE(y, x)) < epsilon_value
              IMPLIES A(y)

  second_countable_topology: bool =
    EXISTS (basis: event_sequence):
      (FORALL (index: nat): metric_open(basis(index)))
        AND (FORALL (A: event), (x: E):
          metric_open(A) AND A(x) IMPLIES
            EXISTS (index: nat):
              basis(index)(x)
                AND event_subset(basis(index), A))

  is_sigma_algebra(Sigma: sigma_algebra): bool =
    Sigma(full_event)
      AND (FORALL (A: event):
        Sigma(A) IMPLIES Sigma(event_complement(A)))
      AND (FORALL (events: event_sequence):
        (FORALL (index: nat): Sigma(events(index)))
          IMPLIES Sigma(countable_union(events)))

  borel_space(Sigma: sigma_algebra): bool =
    is_sigma_algebra(Sigma)
      AND (FORALL (A: event):
        metric_open(A) IMPLIES Sigma(A))
      AND (FORALL (candidate: sigma_algebra):
        (is_sigma_algebra(candidate)
          AND (FORALL (A: event):
            metric_open(A) IMPLIES candidate(A)))
        IMPLIES
          (FORALL (A: event):
            Sigma(A) IMPLIES candidate(A)))

  zero_measure_value: measure_value =
    (# infinite_flag := FALSE, finite_part := 0 #)

  infinite_measure_value: measure_value =
    (# infinite_flag := TRUE, finite_part := 0 #)

  finite_measure_value(value: real): measure_value =
    (# infinite_flag := FALSE, finite_part := value #)

  canonical_measure_value(value: measure_value): bool =
    IF infinite_flag(value) THEN
      finite_part(value) = 0
    ELSE
      finite_part(value) >= 0
    ENDIF

  measure_value_is_zero(value: measure_value): bool =
    NOT infinite_flag(value)
      AND finite_part(value) = 0

  measure_value_le(left, right: measure_value): bool =
    canonical_measure_value(left)
      AND canonical_measure_value(right)
      AND IF infinite_flag(right) THEN
        TRUE
      ELSIF infinite_flag(left) THEN
        FALSE
      ELSE
        finite_part(left) <= finite_part(right)
      ENDIF

  measure_value_add(left, right: measure_value): measure_value =
    IF infinite_flag(left) OR infinite_flag(right) THEN
      infinite_measure_value
    ELSE
      finite_measure_value(
        finite_part(left) + finite_part(right))
    ENDIF

  measure_value_product(left, right: measure_value):
      measure_value =
    IF measure_value_is_zero(left)
        OR measure_value_is_zero(right) THEN
      zero_measure_value
    ELSIF infinite_flag(left)
        OR infinite_flag(right) THEN
      infinite_measure_value
    ELSE
      finite_measure_value(
        finite_part(left) * finite_part(right))
    ENDIF

  finite_real_sum(values: real_sequence, count: nat):
      RECURSIVE real =
    IF count = 0 THEN
      0
    ELSE
      finite_real_sum(values, count - 1)
        + values(count - 1)
    ENDIF
  MEASURE count

  partial_measure_sum(
      values: measure_value_sequence,
      count: nat): real =
    finite_real_sum(
      LAMBDA (index: nat):
        finite_part(values(index)),
      count)

  unbounded_above(values: real_sequence): bool =
    FORALL (bound: real):
      EXISTS (index: nat):
        bound < values(index)

  extended_nonnegative_sum(
      values: measure_value_sequence,
      total: measure_value): bool =
    canonical_measure_value(total)
      AND (FORALL (index: nat):
        canonical_measure_value(values(index)))
      AND IF infinite_flag(total) THEN
        (EXISTS (index: nat):
          infinite_flag(values(index)))
          OR ((FORALL (index: nat):
                NOT infinite_flag(values(index)))
            AND unbounded_above(
              LAMBDA (count: nat):
                partial_measure_sum(values, count)))
      ELSE
        (FORALL (index: nat):
          NOT infinite_flag(values(index)))
          AND converges_to_real(
            LAMBDA (count: nat):
              partial_measure_sum(values, count),
            finite_part(total))
      ENDIF

  is_measure(M: measure_map, Sigma: sigma_algebra): bool =
    is_sigma_algebra(Sigma)
      AND measure_value_is_zero(M(empty_event))
      AND (FORALL (A: event):
        Sigma(A) IMPLIES canonical_measure_value(M(A)))
      AND (FORALL (events: event_sequence):
        ((FORALL (index: nat): Sigma(events(index)))
          AND pairwise_disjoint(events))
        IMPLIES
          extended_nonnegative_sum(
            LAMBDA (index: nat): M(events(index)),
            M(countable_union(events))))

  probability_measure(
      M: measure_map,
      Sigma: sigma_algebra): bool =
    is_measure(M, Sigma)
      AND M(full_event) = finite_measure_value(1)

  null_event(
      M: measure_map,
      Sigma: sigma_algebra,
      A: event): bool =
    EXISTS (measurable_cover: event):
      Sigma(measurable_cover)
        AND event_subset(A, measurable_cover)
        AND measure_value_is_zero(M(measurable_cover))

  almost_everywhere(
      M: measure_map,
      Sigma: sigma_algebra,
      property: [E -> bool]): bool =
    null_event(
      M,
      Sigma,
      LAMBDA (x: E): NOT property(x))

  canonical_nonnegative_function(
      function_value: nonnegative_function): bool =
    FORALL (x: E):
      canonical_measure_value(function_value(x))

  pairwise_disjoint_below(
      events: event_sequence,
      count: nat): bool =
    FORALL (left_index, right_index: nat):
      left_index < count
        AND right_index < count
        AND left_index /= right_index
      IMPLIES
        FORALL (x: E):
          NOT (events(left_index)(x)
            AND events(right_index)(x))

  finite_simple_nonnegative_value(
      coefficients: measure_value_sequence,
      pieces: event_sequence,
      count: nat,
      x: E): RECURSIVE measure_value =
    IF count = 0 THEN
      zero_measure_value
    ELSE
      measure_value_add(
        finite_simple_nonnegative_value(
          coefficients, pieces, count - 1, x),
        IF pieces(count - 1)(x) THEN
          coefficients(count - 1)
        ELSE
          zero_measure_value
        ENDIF)
    ENDIF
  MEASURE count

  measurable_simple_nonnegative(
      Sigma: sigma_algebra,
      coefficients: measure_value_sequence,
      pieces: event_sequence,
      count: nat): bool =
    pairwise_disjoint_below(pieces, count)
      AND (FORALL (index: nat):
        index < count IMPLIES
          canonical_measure_value(coefficients(index))
            AND NOT infinite_flag(coefficients(index))
            AND Sigma(pieces(index)))

  measurable_simple_minorant(
      Sigma: sigma_algebra,
      function_value: nonnegative_function,
      coefficients: measure_value_sequence,
      pieces: event_sequence,
      count: nat): bool =
    canonical_nonnegative_function(function_value)
      AND measurable_simple_nonnegative(
        Sigma, coefficients, pieces, count)
      AND (FORALL (x: E):
        measure_value_le(
          finite_simple_nonnegative_value(
            coefficients, pieces, count, x),
          function_value(x)))

  finite_simple_nonnegative_integral(
      M: measure_map,
      coefficients: measure_value_sequence,
      pieces: event_sequence,
      count: nat): RECURSIVE measure_value =
    IF count = 0 THEN
      zero_measure_value
    ELSE
      measure_value_add(
        finite_simple_nonnegative_integral(
          M, coefficients, pieces, count - 1),
        measure_value_product(
          coefficients(count - 1),
          M(pieces(count - 1))))
    ENDIF
  MEASURE count

  lower_integral_upper_bound(
      M: measure_map,
      Sigma: sigma_algebra,
      function_value: nonnegative_function,
      upper: measure_value): bool =
    canonical_measure_value(upper)
      AND FORALL
          (coefficients: measure_value_sequence),
          (pieces: event_sequence),
          (count: nat):
        measurable_simple_minorant(
          Sigma,
          function_value,
          coefficients,
          pieces,
          count)
        IMPLIES
          measure_value_le(
            finite_simple_nonnegative_integral(
              M, coefficients, pieces, count),
            upper)

  has_lower_lebesgue_integral(
      M: measure_map,
      Sigma: sigma_algebra,
      function_value: nonnegative_function,
      integral_value: measure_value): bool =
    is_measure(M, Sigma)
      AND canonical_nonnegative_function(function_value)
      AND canonical_measure_value(integral_value)
      AND lower_integral_upper_bound(
        M, Sigma, function_value, integral_value)
      AND (FORALL (upper: measure_value):
        lower_integral_upper_bound(
          M, Sigma, function_value, upper)
        IMPLIES
          measure_value_le(integral_value, upper))

  finite_simple_real_value(
      coefficients: real_sequence,
      pieces: event_sequence,
      count: nat,
      x: E): real =
    finite_real_sum(
      LAMBDA (index: nat):
        IF index < count AND pieces(index)(x) THEN
          coefficients(index)
        ELSE
          0
        ENDIF,
      count)

  measurable_simple_real(
      Sigma: sigma_algebra,
      function_value: real_function): bool =
    EXISTS
        (coefficients: real_sequence),
        (pieces: event_sequence),
        (count: nat):
      pairwise_disjoint_below(pieces, count)
        AND (FORALL (index: nat):
          index < count IMPLIES Sigma(pieces(index)))
        AND (FORALL (x: E):
          function_value(x) =
            finite_simple_real_value(
              coefficients, pieces, count, x))

  strongly_measurable_real(
      Sigma: sigma_algebra,
      function_value: real_function): bool =
    EXISTS (approximants: real_function_sequence):
      (FORALL (index: nat):
        measurable_simple_real(
          Sigma, approximants(index)))
        AND (FORALL (x: E):
          converges_to_real(
            LAMBDA (index: nat):
              approximants(index)(x),
            function_value(x)))

  ae_strongly_measurable_real(
      M: measure_map,
      Sigma: sigma_algebra,
      function_value: real_function): bool =
    EXISTS (measurable_version: real_function):
      strongly_measurable_real(Sigma, measurable_version)
        AND almost_everywhere(
          M,
          Sigma,
          LAMBDA (x: E):
            function_value(x)
              = measurable_version(x))

  positive_part(
      function_value: real_function):
      nonnegative_function =
    LAMBDA (x: E):
      finite_measure_value(
        IF function_value(x) >= 0 THEN
          function_value(x)
        ELSE
          0
        ENDIF)

  negative_part(
      function_value: real_function):
      nonnegative_function =
    LAMBDA (x: E):
      finite_measure_value(
        IF function_value(x) <= 0 THEN
          -function_value(x)
        ELSE
          0
        ENDIF)

  absolute_value_function(
      function_value: real_function):
      nonnegative_function =
    LAMBDA (x: E):
      finite_measure_value(abs(function_value(x)))

  has_finite_integral_real(
      M: measure_map,
      Sigma: sigma_algebra,
      function_value: real_function): bool =
    EXISTS (integral_value: measure_value):
      has_lower_lebesgue_integral(
        M,
        Sigma,
        absolute_value_function(function_value),
        integral_value)
        AND NOT infinite_flag(integral_value)

  integrable_real(
      M: measure_map,
      Sigma: sigma_algebra,
      function_value: real_function): bool =
    is_measure(M, Sigma)
      AND ae_strongly_measurable_real(
        M, Sigma, function_value)
      AND has_finite_integral_real(
        M, Sigma, function_value)

  has_integral_real_value(
      M: measure_map,
      Sigma: sigma_algebra,
      function_value: real_function,
      integral_value: real): bool =
    EXISTS
        (positive_integral, negative_integral: measure_value):
      has_lower_lebesgue_integral(
        M,
        Sigma,
        positive_part(function_value),
        positive_integral)
        AND has_lower_lebesgue_integral(
          M,
          Sigma,
          negative_part(function_value),
          negative_integral)
        AND NOT infinite_flag(positive_integral)
        AND NOT infinite_flag(negative_integral)
        AND integral_value =
          finite_part(positive_integral)
            - finite_part(negative_integral)

  continuous_linear_functional(L: real_function): bool =
    (FORALL (x, y: E):
      L(addE(x, y)) = L(x) + L(y))
      AND (FORALL (a: real), (x: E):
        L(smulE(a, x)) = a * L(x))
      AND EXISTS (bound: real):
        0 <= bound
          AND FORALL (x: E):
            abs(L(x)) <= bound * normE(x)

  is_gaussian_measure(
      M: measure_map,
      Sigma: sigma_algebra,
      exponential, sine, cosine:
        scalar_real_function): bool =
    probability_measure(M, Sigma)
      AND FORALL (L: real_function):
        continuous_linear_functional(L) IMPLIES
          EXISTS (mean, variance: real):
            0 <= variance
              AND FORALL (t: real):
                integrable_real(
                  M,
                  Sigma,
                  LAMBDA (x: E):
                    cosine(t * L(x)))
                  AND integrable_real(
                    M,
                    Sigma,
                    LAMBDA (x: E):
                      sine(t * L(x)))
                  AND EXISTS
                      (cosine_integral, sine_integral: real):
                    has_integral_real_value(
                      M,
                      Sigma,
                      LAMBDA (x: E):
                        cosine(t * L(x)),
                      cosine_integral)
                    AND has_integral_real_value(
                      M,
                      Sigma,
                      LAMBDA (x: E):
                        sine(t * L(x)),
                      sine_integral)
                    AND cosine_integral =
                      exponential(
                        -(variance * t ^ 2) / 2)
                        * cosine(mean * t)
                    AND sine_integral =
                      exponential(
                        -(variance * t ^ 2) / 2)
                        * sine(mean * t)

  fernique_s_theorem: bool =
    EXISTS
        (exponential, sine, cosine:
          scalar_real_function):
      is_standard_exponential(exponential)
        AND is_standard_sine(sine)
        AND is_standard_cosine(cosine)
        AND ((normed_real_vector_space
          AND complete_space_e
          AND second_countable_topology)
        IMPLIES
          FORALL
              (Sigma: sigma_algebra),
              (M: measure_map):
            (borel_space(Sigma)
              AND is_gaussian_measure(
                M,
                Sigma,
                exponential,
                sine,
                cosine))
            IMPLIES
              EXISTS (C: real):
                0 < C
                  AND integrable_real(
                    M,
                    Sigma,
                    LAMBDA (x: E):
                      exponential(C * normE(x) ^ 2)))
END fernique_s_theorem_Q5445112
