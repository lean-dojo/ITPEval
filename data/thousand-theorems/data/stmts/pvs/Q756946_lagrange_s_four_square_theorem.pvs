% Statement-only formalization of the Thousand Theorems artifact Q756946,
% "Lagrange's four-square theorem": every natural number is the sum of four
% squares of natural numbers. This file contains no proof.

Q756946_lagrange_s_four_square_theorem: THEORY
BEGIN
  lagrange_s_four_square_theorem: bool =
    FORALL (n: nat):
      EXISTS (a, b, c, d: nat):
        a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 = n
END Q756946_lagrange_s_four_square_theorem
