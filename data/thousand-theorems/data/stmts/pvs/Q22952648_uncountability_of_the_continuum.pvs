% Statement-only formalization of Thousand Theorems artifact Q22952648,
% "Uncountability of the continuum": no sequence enumerates all real numbers.
% This file contains no proof.

Q22952648_uncountability_of_the_continuum: THEORY
BEGIN
  uncountability_of_the_continuum: bool =
    FORALL (enumeration: [nat -> real]):
      EXISTS (missing: real):
        FORALL (n: nat): missing /= enumeration(n)
END Q22952648_uncountability_of_the_continuum
