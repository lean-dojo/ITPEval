% Statement-only formalization of the Thousand Theorems corpus artifact Q474881,
% "Cantor's theorem": for every type and every function from that type to its
% predicate powerset, the function is not surjective. This file contains no proof.

Q474881_cantor_s_theorem[A: TYPE]: THEORY
BEGIN

  cantor_surjective: bool =
    FORALL (f: [A -> [A -> bool]]):
      NOT (FORALL (subset: [A -> bool]):
        EXISTS (x: A): f(x) = subset)

END Q474881_cantor_s_theorem
