:: Statement-only formalization of thousand-theorems corpus artifact Q1050203,
:: "Cantor's intersection theorem": the intersection of a nonempty
:: downward-directed family of nonempty compact closed subsets of an
:: arbitrary topological space is nonempty. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, STRUCT_0, PRE_TOPC,
    TOPS_2, COMPTS_1, RCOMP_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, STRUCT_0, PRE_TOPC,
    TOPS_2, COMPTS_1;
  constructors SETFAM_1, TOPS_2, COMPTS_1;
  registrations XBOOLE_0, SUBSET_1, STRUCT_0, PRE_TOPC, TOPS_1, COMPTS_1;
  requirements SUBSET, BOOLE;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for T being TopSpace,
      S being non empty Subset-Family of T st
    (for U,V being Subset of T st U in S & V in S
      holds ex W being Subset of T st
        W in S & W c= U & W c= V) &
    (for U being Subset of T st U in S holds
      (U <> {}) & (U is compact) & (U is closed))
  holds meet S <> {}
proof
end;
::$P+
