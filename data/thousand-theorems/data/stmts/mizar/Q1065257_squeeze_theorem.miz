:: Statement-only formalization of thousand-theorems corpus artifact Q1065257,
:: "Squeeze theorem": for functions into a preordered space with its order
:: topology, eventual pointwise bounds by two functions converging to the same
:: limit imply convergence of the bounded function. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, ZFMISC_1;
  constructors SETFAM_1, RELSET_1, FUNCT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2;
  requirements SUBSET, BOOLE;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for A being non empty set,
      B being set,
      le being Relation of A,A,
      F being Subset-Family of B,
      f,g,h being Function of B,A,
      a being Element of A st
    (for x being Element of A holds [x,x] in le) &
    (for x,y,z being Element of A st
      [x,y] in le & [y,z] in le holds [x,z] in le) &
    B in F &
    (for U,V being Subset of B st
      U in F & U c= V holds V in F) &
    (for U,V being Subset of B st
      U in F & V in F holds U /\ V in F) &
    (for l being Element of A st
      [l,a] in le & not [a,l] in le holds
        {x where x is Element of B :
          x in B & [l,g.x] in le & not [g.x,l] in le} in F) &
    (for u being Element of A st
      [a,u] in le & not [u,a] in le holds
        {x where x is Element of B :
          x in B & [g.x,u] in le & not [u,g.x] in le} in F) &
    (for l being Element of A st
      [l,a] in le & not [a,l] in le holds
        {x where x is Element of B :
          x in B & [l,h.x] in le & not [h.x,l] in le} in F) &
    (for u being Element of A st
      [a,u] in le & not [u,a] in le holds
        {x where x is Element of B :
          x in B & [h.x,u] in le & not [u,h.x] in le} in F) &
    {x where x is Element of B : x in B & [g.x,f.x] in le} in F &
    {x where x is Element of B : x in B & [f.x,h.x] in le} in F
  holds
    (for l being Element of A st
      [l,a] in le & not [a,l] in le holds
        {x where x is Element of B :
          x in B & [l,f.x] in le & not [f.x,l] in le} in F) &
    (for u being Element of A st
      [a,u] in le & not [u,a] in le holds
        {x where x is Element of B :
          x in B & [f.x,u] in le & not [u,f.x] in le} in F)
proof
end;
::$P+
