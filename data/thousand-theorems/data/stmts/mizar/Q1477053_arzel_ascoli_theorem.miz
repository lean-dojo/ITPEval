:: Statement-only formalization of thousand-theorems artifact Q1477053
:: (thousand-theorems__mizar__Q1477053), "Arzelà–Ascoli theorem": an
:: equicontinuous family of bounded continuous
:: functions on a compact space, with values in a compact subset of a
:: Hausdorff pseudometric space, has compact closure in the uniform metric.
:: This file contains no proof.

environ

 vocabularies ASCOLI2, ASCOLI, STRUCT_0, NUMBERS, PRE_TOPC, ORDINAL2,
      PCOMPS_1, MONOID_0, XXREAL_1, RELAT_2, SUBSET_1, RCOMP_1, RELAT_1,
      XBOOLE_0, FUNCT_1, TARSKI, CARD_1, ARYTM_3, ARYTM_1, REAL_1, FUNCT_2,
      ZFMISC_1, XXREAL_2, XXREAL_0, REWRITE1, NAT_1, SEQ_2, TMAP_1,
      PARTFUN1, C0SP2, METRIC_1, SETFAM_1, FINSET_1, METRIC_6, SEQ_4,
      TBSP_1, TOPMETR4, BHSP_3, UPROOTS, FINSEQ_1, FUNCT_7, FUNCOP_1,
      PSCOMP_1, COMPLEX1, COMPTS_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, FUNCT_1, CARD_1,
      ORDINAL1, RELSET_1, PARTFUN1, FUNCT_2, BINOP_1, FINSET_1, NUMBERS,
      NAT_1, COMPLEX1, XCMPLX_0, XXREAL_0, XREAL_0, XXREAL_2, SEQ_2, SEQ_4,
      STRUCT_0, MONOID_0, RCOMP_1, PCOMPS_1, TBSP_1, PRE_TOPC, COMPTS_1,
      TOPS_2, METRIC_1, TMAP_1, TOPMETR, PSCOMP_1, LOPBAN_1, TOPMETR4,
      METRIC_6, FINSEQ_1, ASCOLI, ASCOLI2;
 constructors COMPLEX1, PCOMPS_1, TBSP_1, TOPMETR, SEQ_4, TMAP_1, TOPS_2,
      TOPMETR4, C0SP3, RCOMP_1, METRIC_6, ASCOLI, ASCOLI2, SEQ_2, COMSEQ_2,
      MONOID_0, PSCOMP_1, COMPTS_1;
 registrations XBOOLE_0, SUBSET_1, STRUCT_0, PRE_TOPC, XREAL_0, NUMBERS,
      ORDINAL1, MEMBERED, VALUED_0, COMPTS_1, XXREAL_0, FUNCT_2, XXREAL_2,
      PSCOMP_1, TOPMETR, RELSET_1, WAYBEL_2, XCMPLX_0, TOPS_1, MONOID_0,
      TBSP_1, PCOMPS_1, CARD_1, FINSEQ_1, FINSET_1, ASCOLI, ASCOLI2;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
 definitions TBSP_1, TARSKI, ASCOLI, ASCOLI2;
 equalities STRUCT_0, PCOMPS_1, METRIC_1;
 expansions TARSKI, STRUCT_0, XBOOLE_0, PRE_TOPC, TBSP_1, METRIC_1,
      PSCOMP_1, XXREAL_2, SEQ_2, MEMBERED;

begin

::$P-
theorem
  (for S being non empty compact TopSpace,
       T being non empty MetrSpace,
       U being compact Subset of TopSpaceMetr T,
       F being Subset of MetricSpace_of_ContinuousFunctions(S,T) st
    (for f being Function of S,TopSpaceMetr T st f in F holds rng f c= U) &
    (for x being Point of S, e being Real st 0 < e holds
      ex V being Subset of S st
        V is open & x in V &
        for f being Function of S,TopSpaceMetr T st f in F holds
          for y,z being Point of S st y in V & z in V holds
            dist(In(f.y,T),In(f.z,T)) < e)
    holds
      F is empty or
      ex G being non empty Subset of
          MetricSpace_of_ContinuousFunctions(S,T) st
        G = F &
        MetricSpace_of_ContinuousFunctions(S,T) | Cl(G) is compact)
  &
  (for S being compact TopSpace,
       T being MetrSpace,
       U being Subset of TopSpaceMetr T,
       F being Subset of 1TopSp Funcs(the carrier of S,the carrier of T) st
    U is compact & (S is empty or T is empty) &
    (for f being Function of S,TopSpaceMetr T st f in F holds rng f c= U) &
    (for x being Point of S, e being Real st 0 < e holds
      ex V being Subset of S st
        V is open & x in V &
        for f being Function of S,TopSpaceMetr T st f in F holds
          for y,z being Point of S st y in V & z in V holds
            dist(In(f.y,T),In(f.z,T)) < e)
    holds Cl F is compact)
proof
end;
::$P+
