:: Statement-only formalization of thousand-theorems artifact Q1186808,
:: "Lucas's theorem": for a prime p, a binomial coefficient is congruent
:: modulo p to the product of the binomial coefficients of corresponding
:: base-p digits. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, NEWTON, REALSET1, INT_1, INT_2, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NEWTON, RELAT_1,
    FUNCT_1, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, INT_2, WSIERP_1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, WSIERP_1, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for p being Prime, n, k, a being Nat st
    n < p |^ a & k < p |^ a
  holds
    ex factors being FinSequence of NAT st
      len factors = a &
      (for i being Nat st i < a holds
        factors.(i + 1) =
          ((n div (p |^ i)) mod p) choose
            ((k div (p |^ i)) mod p)) &
      (n choose k) mod p = (Product factors) mod p
proof
end;
::$P+
