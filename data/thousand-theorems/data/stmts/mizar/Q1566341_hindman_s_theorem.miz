:: Statement-only formalization of Thousand Theorems artifact Q1566341
:: (thousand-theorems__mizar__Q1566341), "Hindman's theorem": every finite
:: cover of the nonempty finite ordered products of a stream in a semigroup has
:: a member containing all such products of another stream. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, FUNCT_1,
      PARTFUN1, FUNCT_2, FINSET_1, NUMBERS, ARYTM_3, ARYTM_1, NAT_1,
      FINSEQ_1, CARD_1, XREAL_0, XXREAL_0, STRUCT_0, ALGSTR_0, GROUP_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, FUNCT_1,
      PARTFUN1, RELSET_1, FUNCT_2, FINSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, NAT_1, FINSEQ_1, CARD_1, XXREAL_0, STRUCT_0,
      ALGSTR_0, GROUP_1;
 constructors RELSET_1, FUNCT_2, FINSET_1, NAT_1, FINSEQ_1, GROUP_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      FINSET_1, ORDINAL1, XREAL_0, NAT_1, FINSEQ_1, STRUCT_0, GROUP_1;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for M being non empty multMagma,
      a being Function of NAT,the carrier of M,
      S being finite Subset-Family of the carrier of M st
    (for x,y,z being Element of M holds (x * y) * z = x * (y * z)) &
    (for x being Element of M st
      (ex p being FinSequence of NAT,
          r being Function of NAT,the carrier of M st
        0 < len p &
        (for i,j being Nat st
          i in dom p & j in dom p & i < j holds p/.i < p/.j) &
        r.1 = a.(p/.1) &
        (for i being Nat st 1 <= i & i < len p holds
          r.(i+1) = r.i * a.(p/.(i+1))) &
        x = r.(len p))
      holds x in union S)
  holds
    ex C being Subset of M,
       b being Function of NAT,the carrier of M st
      C in S &
      for x being Element of M st
        (ex p being FinSequence of NAT,
            r being Function of NAT,the carrier of M st
          0 < len p &
          (for i,j being Nat st
            i in dom p & j in dom p & i < j holds p/.i < p/.j) &
          r.1 = b.(p/.1) &
          (for i being Nat st 1 <= i & i < len p holds
            r.(i+1) = r.i * b.(p/.(i+1))) &
          x = r.(len p))
        holds x in C
proof
end;
::$P+
