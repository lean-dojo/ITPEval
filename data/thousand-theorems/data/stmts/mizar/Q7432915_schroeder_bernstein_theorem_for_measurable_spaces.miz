:: Statement-only formalization of thousand-theorems corpus artifact Q7432915,
:: "Schroeder–Bernstein theorem for measurable spaces": measurable embeddings
:: between arbitrary measurable spaces in both directions imply a measurable
:: equivalence. This file contains no proof.

environ
  vocabularies NUMBERS, XBOOLE_0, PROB_1, MEASURE1, SUBSET_1, MESFUNC5,
    PARTFUN1, XXREAL_0, RELAT_1, ARYTM_3, ARYTM_1, FUNCT_1, ORDINAL2,
    CARD_1, COMPLEX1, TARSKI, REAL_1, PBOOLE, MESFUNC1, MESFUNC2,
    VALUED_1, ZFMISC_1, FUNCT_2, SETFAM_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XXREAL_3, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, XXREAL_0, VALUED_0,
    RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1, PROB_1, MEASURE1,
    EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, SETFAM_1;
  constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, RELSET_1,
    COMPLEX1, SETFAM_1;
  registrations SUBSET_1, XREAL_0, MEMBERED, ORDINAL1, PARTFUN1, MEASURE1,
    FUNCT_2, RELAT_1, XBOOLE_0, NUMBERS, XXREAL_0, XCMPLX_0, FUNCT_1,
    VALUED_0, XXREAL_3, RELSET_1;
  requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, FUNCT_2, MESFUNC5;
  equalities XBOOLE_0;
  expansions TARSKI, XBOOLE_0, FUNCT_2;

begin

::$P-
theorem
  for X,Y being set,
      SX being SigmaField of X,
      SY being SigmaField of Y,
      f being Function of X,Y,
      g being Function of Y,X st
    f is one-to-one &
    (for B being Element of SY holds f"B in SX) &
    (for A being Element of SX holds f.:A in SY) &
    g is one-to-one &
    (for A being Element of SX holds g"A in SY) &
    (for B being Element of SY holds g.:B in SX)
  holds
    ex h being Function of X,Y st
      h is one-to-one &
      rng h = Y &
      (for B being Element of SY holds h"B in SX) &
      (for A being Element of SX holds h.:A in SY)
proof
end;
::$P+
