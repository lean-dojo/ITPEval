:: Statement-only formalization of thousand-theorems corpus artifact Q918099,
:: "Ramsey's theorem": every finite coloring of the r-element subsets of an
:: infinite subset of the natural numbers has an infinite monochromatic
:: subset. This file contains no proof.

environ

 vocabularies NUMBERS, ORDINAL1, FUNCT_1, SUBSET_1, EQREL_1, GROUP_10,
      TARSKI, FINSET_1, XBOOLE_0, CARD_1, RELAT_1, FUNCT_2, ARYTM_1,
      ARYTM_3, XXREAL_0, NAT_1, FINSEQ_1, CARD_3, RAMSEY_1, ZFMISC_1,
      FINSUB_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, XCMPLX_0, XXREAL_0,
      RELAT_1, RELSET_1, FUNCT_1, FINSEQ_1, CARD_1, ORDINAL1, NAT_1,
      NUMBERS, PARTFUN1, EQREL_1, FINSET_1, FUNCT_2, FUNCT_3, GROUP_10,
      NEWTON, NAT_D, FINSUB_1;
 constructors WELLORD2, GROUP_10, NEWTON, NAT_D, REAL_1, RVSUM_1, CARD_5,
      RELSET_1, NUMBERS, EQREL_1, FUNCT_3, FINSUB_1;
 registrations XBOOLE_0, SUBSET_1, XXREAL_0, XREAL_0, FINSEQ_1, RELAT_1,
      ORDINAL1, EQREL_1, CARD_3, NAT_1, CARD_1, MEMBERED, FINSET_1,
      FUNCT_1, FUNCT_2, RELSET_1, FINSUB_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI;
 equalities GROUP_10, ORDINAL1;
 expansions TARSKI;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, EQREL_1, CARD_1, WELLORD2, FUNCT_1,
      FUNCT_2, RELAT_1, GROUP_10, ZFMISC_1, CARD_2, NAT_1, XREAL_1,
      ORDINAL1, XXREAL_0, STIRL2_1, WAYBEL12, CARD_FIL, FINSEQ_1, NEWTON,
      ENUMSET1, NAT_D, XREAL_0, CARD_3, FUNCT_3;
 schemes NAT_1, FUNCT_2, RECDEF_2;

begin

::$P-
theorem
  for A being non empty set,
      K being finite Subset of A,
      r being Nat,
      M1 being infinite Subset of NAT,
      c being Function of Fin NAT,A st
    (for e being finite Subset of NAT st
      card e = r & e c= M1
    holds c.e in K)
  holds
    ex M2 being infinite Subset of M1,
       col being Element of A st
      col in K &
      for e being finite Subset of NAT st
        card e = r & e c= M2
      holds c.e = col
proof
end;
::$P+
