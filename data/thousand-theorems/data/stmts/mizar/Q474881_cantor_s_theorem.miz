:: Statement-only formalization of thousand-theorems corpus artifact Q474881
:: (thousand-theorems__mizar__Q474881), "Cantor's theorem": no function from
:: an arbitrary set onto its full powerset is surjective. This file contains
:: no proof.

environ
  vocabularies RELAT_1, FUNCT_1, FUNCT_2, ZFMISC_1;
  notations XBOOLE_0, ZFMISC_1, RELAT_1, FUNCT_1, FUNCT_2;
  constructors RELAT_1, FUNCT_1, FUNCT_2, ZFMISC_1;
  registrations RELAT_1, FUNCT_1, FUNCT_2;

begin

::$P-
theorem
  for X being set, f being Function of X,bool X holds
    rng f <> bool X
proof
end;
::$P+
