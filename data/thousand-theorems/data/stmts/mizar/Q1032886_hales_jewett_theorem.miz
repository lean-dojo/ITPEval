:: Statement-only formalization of thousand-theorems corpus artifact Q1032886,
:: "Hales–Jewett theorem": every coloring of sufficiently high-dimensional
:: words over a finite alphabet by a finite set has a monochromatic
:: combinatorial line. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      FUNCOP_1, FUNCT_4, FINSET_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, FUNCOP_1, FUNCT_4, FINSET_1;
 constructors RELSET_1, FUNCT_2, FUNCOP_1, FUNCT_4, FINSET_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, FUNCOP_1, FINSET_1;
 requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A,K being finite set holds
    ex I being finite set st
      for C being Function st
        dom C = Funcs(I,A) & rng C c= K
      holds
        ex V being set, fixed being Function, c being object st
          V c= I & V <> {} &
          dom fixed = I \ V & rng fixed c= A &
          c in K &
          for x being object st x in A holds
            C.(fixed +* (V --> x)) = c
proof
end;
::$P+
