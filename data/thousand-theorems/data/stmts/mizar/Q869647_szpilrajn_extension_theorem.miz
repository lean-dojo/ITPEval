:: Statement-only formalization of thousand-theorems corpus artifact Q869647,
:: "Szpilrajn extension theorem": every partial order on an arbitrary set
:: extends to a linear order on the same set. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELAT_2;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, RELAT_2;
 constructors RELSET_1, RELAT_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
 requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for A being set,
      R being Relation of A st
    R is_reflexive_in A &
    R is_transitive_in A &
    R is_antisymmetric_in A
  holds
    ex S being Relation of A st
      S is_reflexive_in A &
      S is_transitive_in A &
      S is_antisymmetric_in A &
      S is_connected_in A &
      R c= S
proof
end;
::$P+
