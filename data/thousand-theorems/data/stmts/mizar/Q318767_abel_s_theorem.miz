:: Statement-only formalization of thousand-theorems corpus artifact Q318767,
:: "Abel's theorem": a power series whose coefficient series converges at one
:: approaches that sum within every positive Stolz cone, and from the left in
:: the real specialization. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
      REAL_1, NAT_1, VALUED_0, VALUED_1, NEWTON, PREPOWER, SEQ_1,
      SEQ_2, ORDINAL2, XXREAL_2, SEQ_4, POWER, ABIAN, ORDINAL1,
      SERIES_1, COMSEQ_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
      COMPLEX1, XXREAL_0, NEWTON, NAT_1, SEQ_1, SEQ_2, COMSEQ_1,
      COMSEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, XXREAL_2, POWER,
      VALUED_0, VALUED_1, SERIES_1;
 constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
      NAT_1, NEWTON, SEQ_2, SEQM_3, SEQ_4, PREPOWER, ABIAN, BINOP_2,
      COMSEQ_2, COMSEQ_3, POWER, SERIES_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
      VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, NEWTON,
      PREPOWER, SEQ_4, ABIAN, COMSEQ_2, COMSEQ_3;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Complex_Sequence holds
  for l being Element of COMPLEX holds
  for s being Real st
    (for epsilon being Real st 0 < epsilon holds
      ex N being Nat st
        for n being Nat st N <= n holds
          |.Partial_Sums(f).n - l.| < epsilon) &
    0 < s
  holds
    for epsilon being Real st 0 < epsilon holds
      ex delta being Real st 0 < delta &
        for z being Element of COMPLEX st
          |.Im z.| < s * (1 - Re z) &
          |.z - 1.| < delta
        holds
          ex p being Complex_Sequence st
            (for n being Nat holds p.n = f.n * (z |^ n)) &
            ex y being Element of COMPLEX st
              |.y - l.| < epsilon &
              for eta being Real st 0 < eta holds
                ex N being Nat st
                  for n being Nat st N <= n holds
                    |.Partial_Sums(p).n - y.| < eta
proof
end;
::$P+

::$P-
theorem
  for f being Real_Sequence,
      l being Real st
    for epsilon being Real st 0 < epsilon holds
      ex N being Nat st
        for n being Nat st N <= n holds
          |.Partial_Sums(f).n - l.| < epsilon
  holds
    for epsilon being Real st 0 < epsilon holds
      ex delta being Real st 0 < delta &
        for x being Real st
          x < 1 & |.x - 1.| < delta
        holds
          ex p being Real_Sequence st
            (for n being Nat holds p.n = f.n * (x |^ n)) &
            ex y being Real st
              |.y - l.| < epsilon &
              for eta being Real st 0 < eta holds
                ex N being Nat st
                  for n being Nat st N <= n holds
                    |.Partial_Sums(p).n - y.| < eta
proof
end;
::$P+
