:: Statement-only formalization of thousand-theorems corpus artifact Q468391
:: (thousand-theorems__mizar__Q468391), "Bolzano–Weierstrass theorem": in a
:: proper pseudometric space, a sequence frequently lying in a bounded set has
:: a subsequence converging to a point of the set's closure; the
:: everywhere-contained case is also stated. This file contains no proof.

environ
  vocabularies XBOOLE_0, PRE_TOPC, RCOMP_1, TARSKI, NAT_1, NUMBERS,
      SUBSET_1, CARD_1, STRUCT_0, ORDINAL2, RELAT_1, SEQ_1, VALUED_0,
      XXREAL_0, FUNCT_1, METRIC_1, PCOMPS_1, REAL_1, ARYTM_1, ARYTM_3,
      FUNCT_2, FRECHET, FRECHET2, COMPTS_1, TOPMETR;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, REAL_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1,
      FUNCT_2, NAT_1, VALUED_0, STRUCT_0, PRE_TOPC, COMPTS_1, METRIC_1,
      PCOMPS_1, TOPMETR, FRECHET;
  constructors REAL_1, NAT_1, RELSET_1, COMPTS_1, METRIC_1, PCOMPS_1,
      TOPMETR, FRECHET, FRECHET2, VALUED_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, NUMBERS, XREAL_0, NAT_1, MEMBERED, STRUCT_0, PRE_TOPC,
      METRIC_1, PCOMPS_1, COMPTS_1, TOPMETR, VALUED_0;
  requirements NUMERALS, BOOLE, SUBSET, ARITHM, REAL;
  definitions TARSKI, PRE_TOPC, METRIC_1, FRECHET;
  equalities XBOOLE_0, ORDINAL1, STRUCT_0;
  expansions TARSKI, PRE_TOPC, FRECHET;

begin

::$P-
theorem
  for M being MetrStruct,
      A being Subset of TopSpaceMetr M,
      x being sequence of TopSpaceMetr M st
    (for p being Point of M holds dist(p,p) = 0) &
    (for p,q being Point of M holds dist(p,q) = dist(q,p)) &
    (for p,q,z being Point of M holds
       dist(p,z) <= dist(p,q) + dist(q,z)) &
    (for p being Point of M, r being Real,
         B being Subset of TopSpaceMetr M st B = cl_Ball(p,r)
       holds B is compact) &
    (ex R being Real st
       0 < R &
       for p,q being Point of M st p in A & q in A
         holds dist(p,q) <= R) &
    (for N being Nat holds
       ex n being Nat st N <= n & x.n in A)
  holds
    ex a being Point of TopSpaceMetr M,
       phi being increasing sequence of NAT st
      a in Cl A & x*phi is_convergent_to a
proof
end;
::$P+

::$P-
theorem
  for M being MetrStruct,
      A being Subset of TopSpaceMetr M,
      x being sequence of TopSpaceMetr M st
    (for p being Point of M holds dist(p,p) = 0) &
    (for p,q being Point of M holds dist(p,q) = dist(q,p)) &
    (for p,q,z being Point of M holds
       dist(p,z) <= dist(p,q) + dist(q,z)) &
    (for p being Point of M, r being Real,
         B being Subset of TopSpaceMetr M st B = cl_Ball(p,r)
       holds B is compact) &
    (ex R being Real st
       0 < R &
       for p,q being Point of M st p in A & q in A
         holds dist(p,q) <= R) &
    (for n being Nat holds x.n in A)
  holds
    ex a being Point of TopSpaceMetr M,
       phi being increasing sequence of NAT st
      a in Cl A & x*phi is_convergent_to a
proof
end;
::$P+
