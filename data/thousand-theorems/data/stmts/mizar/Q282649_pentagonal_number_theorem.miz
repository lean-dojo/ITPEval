:: Statement-only formalization of thousand-theorems corpus artifact Q282649,
:: "Pentagonal number theorem": over an arbitrary commutative ring with an
:: arbitrary coefficient topology, the finite-subset product net of
:: 1 - X^(n+1) converges coefficientwise to the signed generalized-pentagonal
:: power series. This file contains no proof.

environ

 vocabularies NUMBERS, XREAL_0, XXREAL_0, STRUCT_0, ALGSTR_0, VECTSP_1,
      FUNCSDOM, BINOP_1,
      SUBSET_1, FUNCT_1, ZFMISC_1, XBOOLE_0, CARD_1, FUNCOP_1, RELAT_1,
      GROUP_1, LATTICES, MESFUNC1, NAT_1, ARYTM_3, SUPINF_2, POLYNOM3,
      RLVECT_1, ARYTM_1, ALGSTR_1, FINSEQ_1, PARTFUN1, CARD_3, REALSET1,
      TARSKI, UNIALG_2, RLSUB_1, SETFAM_1, POLYNOM1, ALGSEQ_1, POLYALG1,
      AFINSQ_1, ORDINAL4, FINSOP_1, BINOP_2, INT_1, SERIES_1, VALUED_1,
      PREPOWER, NEWTON, POWER, NUMERAL1, ABIAN, FINSET_1, FINSUB_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, ORDINAL1,
      NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REALSET1, STRUCT_0, ALGSTR_0,
      RELAT_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCOP_1, FINSEQ_1, BINOP_1,
      NAT_1, NAT_D, INT_1, WSIERP_1, GROUP_1, RLVECT_1, VFUNCT_1,
      VECTSP_1, NORMSP_1, POLYNOM1, ALGSTR_1, ALGSEQ_1, POLYNOM3,
      POLYNOM5, VECTSP_4, AFINSQ_1, VALUED_1, RELSET_1, BINOP_2,
      RECDEF_1, SERIES_1, NEWTON, PREPOWER, POWER, AFINSQ_2, ABIAN,
      CARD_1, POLYALG1, NUMERAL1, FINSET_1, FINSUB_1;
 constructors BINOP_1, REALSET1, RFINSEQ, NAT_D, ALGSTR_1, VECTSP_4,
      POLYNOM3, POLYNOM5, REAL_1, RELSET_1, FUNCOP_1, FVSUM_1, VFUNCT_1,
      WSIERP_1, PREPOWER, SERIES_1, PARTFUN3, BINOM, SETWISEO, RECDEF_1,
      BINOP_2, AFINSQ_2, NEWTON, ABIAN, CARD_1, POLYALG1, NUMERAL1,
      FINSET_1, FINSUB_1;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XREAL_0, NAT_1, REALSET1,
      STRUCT_0, VECTSP_1, FVSUM_1, POLYNOM3, POLYNOM5, BINOM, ORDINAL1,
      VFUNCT_1, FUNCT_2, RELAT_1, XXREAL_0, CARD_1, NUMBERS, INT_1,
      BINOP_2, MEMBERED, NEWTON, AFINSQ_1, VALUED_1, POWER, FINSET_1,
      AFINSQ_2, VALUED_0, FUNCT_1, ALGSTR_0, ALGSTR_1, RLVECT_1,
      GROUP_1, POLYALG1, FINSUB_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLVECT_1, GROUP_1, VECTSP_1, ALGSTR_0;
 equalities XBOOLE_0, STRUCT_0, ALGSTR_0, VECTSP_1, BINOP_1, REALSET1;
 expansions TARSKI, VECTSP_1;

begin

::$P-
theorem
  for R being commutative Ring,
      tau being Subset-Family of R
  st
    the carrier of R in tau &
    (for U,V being Subset of R st U in tau & V in tau
      holds U /\ V in tau) &
    (for G being Subset-Family of R st G c= tau
      holds union G in tau)
  holds
    ex pent being Function of INT,NAT,
       X,P being Element of Formal-Series R,
       x,p being sequence of R,
       powers being Function of NAT,Formal-Series R,
       products being Function of Fin NAT,Formal-Series R,
       productCoeff being Function of [:Fin NAT,NAT:],R
    st
      X = x &
      P = p &
      (for k being Integer holds
        (0 <= k implies
          pent.k = (k * (3*k - 1)) div 2) &
        (k < 0 implies
          pent.k = ((-k) * (3*(-k) + 1)) div 2)) &
      (for n being Nat holds
        (n = 1 implies x.n = 1.R) &
        (n <> 1 implies x.n = 0.R)) &
      (for k being Integer holds
        (k is even implies p.(pent.k) = 1.R) &
        (k is odd implies p.(pent.k) = -1.R)) &
      (for n being Nat st
        not ex k being Integer st pent.k = n
        holds p.n = 0.R) &
      powers.0 = 1.(Formal-Series R) &
      (for n being Nat holds
        ex q,r being sequence of R st
          powers.n = q &
          powers.(n + 1) = r &
          for j being Nat holds
            ex terms being FinSequence of the carrier of R st
              len terms = j + 1 &
              r.j = Sum terms &
              for k being Nat st k in dom terms holds
                ex qk,xk being Element of R st
                  q.(k -' 1) = qk &
                  x.(j + 1 -' k) = xk &
                  terms.k = qk * xk) &
      products.{} = 1.(Formal-Series R) &
      (for A being Element of Fin NAT,
           n being Nat st not n in A
        holds
          ex a,q,f,b being sequence of R st
            products.A = a &
            powers.(n + 1) = q &
            products.(A \/ {n}) = b &
            (for i being Nat holds
              ex qi,fi being Element of R st
                q.i = qi &
                f.i = fi &
                (i = 0 implies fi = 1.R + -qi) &
                (i <> 0 implies fi = -qi)) &
            (for j being Nat holds
              ex terms being FinSequence of the carrier of R st
                len terms = j + 1 &
                b.j = Sum terms &
                for k being Nat st k in dom terms holds
                  ex ak,fk being Element of R st
                    a.(k -' 1) = ak &
                    f.(j + 1 -' k) = fk &
                    terms.k = ak * fk)) &
      (for A being Element of Fin NAT,
           n being Nat
        holds
          ex q being sequence of R st
            products.A = q & productCoeff.(A,n) = q.n) &
      for n being Nat,
          U being Subset of R st U in tau & p.n in U
      holds
        ex A0 being Element of Fin NAT st
          for A being Element of Fin NAT st A0 c= A
          holds productCoeff.(A,n) in U
proof
end;
::$P+
