:: Statement-only formalization of thousand-theorems corpus artifact Q22952648,
:: "Uncountability of the continuum": the set of all real numbers is not
:: countable. This file contains no proof.

environ
  vocabularies NUMBERS, CARD_1, CARD_3;
  notations NUMBERS, CARD_1, CARD_3;
  constructors NUMBERS, CARD_3;
  registrations NUMBERS, CARD_3;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  REAL is not countable
proof
end;
::$P+
