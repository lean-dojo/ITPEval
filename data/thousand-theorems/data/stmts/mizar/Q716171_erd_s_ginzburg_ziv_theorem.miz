:: Statement-only formalization of thousand-theorems corpus artifact Q716171,
:: "Erdős–Ginzburg–Ziv theorem": every sequence of at least 2*n-1 residue
:: classes modulo n has n positions whose values sum to zero modulo n. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FINSEQ_1,
    FINSEQ_2, NUMBERS, NAT_1, INT_1, INT_2, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0, VALUED_1,
    RVSUM_1, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, FINSET_1;
  constructors REAL_1, NAT_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED,
    FRAENKEL, FINSET_1, INT_6;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for n being Nat, a being FinSequence of INT st
    2 * n -' 1 <= len a
  holds
    ex T being Subset of Seg len a,
       selected being FinSequence of INT st
      card T = n &
      selected = a * Sgm T &
      (n qua Integer) divides Sum selected
proof
end;
::$P+
