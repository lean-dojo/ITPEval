:: Statement-only formalization of thousand-theorems corpus artifact Q5445112,
:: "Fernique's theorem": a Gaussian probability measure on a second-countable
:: real Banach space exponentially integrates a positive multiple of the
:: squared norm. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, RELAT_1,
      FUNCT_1, FUNCT_2, PARTFUN1, CARD_1, STRUCT_0, ALGSTR_0, RLVECT_1,
      NORMSP_0, NORMSP_1, NORMSP_2, PRE_TOPC, TOPS_1, TOPS_2, TOPGEN_4,
      PCOMPS_1, WAYBEL23, PROB_1,
      MEASURE1, MEASURE3, MEASURE6, MESFUNC1, MESFUNC2, MESFUNC5,
      XXREAL_0, XXREAL_2, SUPINF_1, SUPINF_2, REAL_1, ARYTM_1, ARYTM_3,
      SETFAM_1, VALUED_0, VALUED_1, COMPLEX1, SIN_COS, SQUARE_1,
      LOPBAN_1, HAHNBAN, HAHNBAN1, DUALSP01, RSSPACE3, FCONT_1, INTEGRA5;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XXREAL_2, XXREAL_3, XREAL_0, REAL_1,
      COMPLEX1, VALUED_0, VALUED_1, STRUCT_0, ALGSTR_0, PRE_TOPC,
      TOPS_1, TOPS_2, TOPGEN_4, PCOMPS_1, WAYBEL23, RLVECT_1, NORMSP_0,
      NORMSP_1, NORMSP_2, PROB_1,
      PROB_2, MEASURE1, MEASURE3, MEASURE6, MESFUNC1,
      MESFUNC2, MESFUNC5, MESFUNC6, SIN_COS, SQUARE_1, LOPBAN_1,
      HAHNBAN, HAHNBAN1, DUALSP01, RSSPACE3;
 constructors ZFMISC_1, RELSET_1, REAL_1, COMPLEX1, TOPS_1, TOPS_2,
      TOPGEN_4, PCOMPS_1, WAYBEL23, RLVECT_1, NORMSP_1, NORMSP_2,
      PROB_1, PROB_2, MEASURE1,
      MEASURE3, MEASURE6, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6,
      SIN_COS, SQUARE_1, LOPBAN_1, HAHNBAN, HAHNBAN1, DUALSP01,
      RSSPACE3;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1,
      ORDINAL1, NUMBERS, XREAL_0, XXREAL_0, XXREAL_3, MEMBERED,
      STRUCT_0, ALGSTR_0, RLVECT_1, NORMSP_0, NORMSP_1, NORMSP_2,
      PRE_TOPC, TOPS_1, PCOMPS_1, MEASURE1, MEASURE3, PROB_1,
      VALUED_0, RELSET_1,
      HAHNBAN, HAHNBAN1, DUALSP01, LOPBAN_1, RSSPACE3;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_1, FUNCT_2, RLVECT_1, NORMSP_0,
      NORMSP_1, MESFUNC1, MESFUNC5, MESFUNC6, LOPBAN_1, HAHNBAN,
      HAHNBAN1, DUALSP01;
 equalities XBOOLE_0, SUBSET_1, RELAT_1, STRUCT_0, ALGSTR_0, RLVECT_1,
      NORMSP_0, PROB_1;
 expansions TARSKI, XBOOLE_0, FUNCT_2, RLVECT_1, NORMSP_0, NORMSP_1;

begin

::$P-
theorem
  for E being RealBanachSpace,
      Sigma being SigmaField of the carrier of E,
      Mu being sigma_Measure of Sigma
  st
    TopSpaceNorm E is second-countable &
    Sigma = BorelSets(TopSpaceNorm E) &
    Mu.(the carrier of E) = 1 &
    (for L being linear-Functional of E st L is Lipschitzian holds
      ex m,v being Real st
        0 <= v &
        for t being Real holds
          ex fc,fs being Function of the carrier of E,REAL st
            (for x being Point of E holds
              fc.x = cos.(t * L.x) &
              fs.x = sin.(t * L.x)) &
            fc is_integrable_on Mu &
            fs is_integrable_on Mu &
            Integral(Mu,fc) =
              exp_R.(-(v * (t * t)) / 2) * cos.(m * t) &
            Integral(Mu,fs) =
              exp_R.(-(v * (t * t)) / 2) * sin.(m * t))
  holds
    ex C being Real,
       f being Function of the carrier of E,REAL st
      0 < C &
      (for x being Point of E holds
        f.x = exp_R.(C * (||.x.|| * ||.x.||))) &
      f is_integrable_on Mu
proof
end;
::$P+
