:: Statement-only formalization of thousand-theorems corpus artifact Q976607,
:: "Erdős–Szekeres theorem": an injective map from a sufficiently large
:: finite linearly ordered set into a linearly ordered set has a large subset
:: on which it is strictly increasing or a large subset on which it is
:: strictly decreasing. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, RELAT_1,
      RELAT_2, TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, XCMPLX_0, XREAL_0,
      XXREAL_0, ARYTM_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1,
      XREAL_0, RELAT_1, RELSET_1, FUNCT_1, FINSEQ_1, FINSEQ_2, CARD_1,
      FINSET_1, XXREAL_0, RELAT_2, NAT_D;
 constructors REAL_1, NAT_D, RELAT_1, RELSET_1, RELAT_2, FINSEQ_1, FINSEQ_2,
      NAT_1, CARD_1, FINSET_1, XXREAL_0;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, ORDINAL1, NAT_1,
      FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1, XCMPLX_0, XREAL_0;
 requirements NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for A being finite set
  for B being set
  for leA being Relation of A
  for leB being Relation of B
  for f being Function
  for r,s being Nat st
    leA is_reflexive_in A &
    leA is_antisymmetric_in A &
    leA is_transitive_in A &
    leA is_connected_in A &
    leB is_reflexive_in B &
    leB is_antisymmetric_in B &
    leB is_transitive_in B &
    leB is_connected_in B &
    dom f = A &
    rng f c= B &
    f is one-to-one &
    r*s < card A
  holds
    (ex T being finite Subset of A st
      r < card T &
      (for x,y being Element of A st
        x in T & y in T & [x,y] in leA & x <> y
      holds [f.x,f.y] in leB & f.x <> f.y))
    or
    (ex T being finite Subset of A st
      s < card T &
      (for x,y being Element of A st
        x in T & y in T & [x,y] in leA & x <> y
      holds [f.y,f.x] in leB & f.y <> f.x))
proof
end;
::$P+
