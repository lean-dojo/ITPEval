:: Statement-only formalization of thousand-theorems corpus artifact Q4116459
:: (thousand-theorems__mizar__Q4116459), "Niven's theorem": a rational value
:: of cosine at a rational multiple of PI is one of -1, -1/2, 0, 1/2, or 1.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_1, SIN_COS, SIN_COS4,
    RAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
    COMPLEX1, XXREAL_0, SIN_COS, SIN_COS4, RAT_1;
  constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, COMPLEX1, INT_1,
    XXREAL_0, SIN_COS, SIN_COS4, RAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, SIN_COS, RAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for theta being Real st
    (ex r being Rational st theta = r * PI) &
    (ex q being Rational st cos(theta) = q)
  holds
    cos(theta) = -1 or
    cos(theta) = -1 / 2 or
    cos(theta) = 0 or
    cos(theta) = 1 / 2 or
    cos(theta) = 1
proof
end;
::$P+
