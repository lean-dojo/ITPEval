:: Statement-only formalization of thousand-theorems corpus artifact Q258374,
:: "Carathéodory's theorem (measure theory)": the Carathéodory measurable
:: sets of an outer measure are exactly those satisfying its splitting
:: criterion. This file contains no proof.

environ

 vocabularies NUMBERS, SUPINF_1, PROB_1, XBOOLE_0, SETFAM_1, FUNCT_1,
      SUBSET_1, TARSKI, RELAT_1, CARD_1, ARYTM_3, NAT_1, XXREAL_0,
      ZFMISC_1, MEASURE1, SUPINF_2, VALUED_0, FUNCOP_1, XREAL_0,
      ARYTM_1, MEASURE2, MEASURE3, MEASURE4;
 notations TARSKI, XBOOLE_0, ENUMSET1, ZFMISC_1, SUBSET_1, ORDINAL1,
      NUMBERS, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, XXREAL_0, XREAL_0,
      VALUED_0, XXREAL_3, XCMPLX_0, FUNCOP_1, REAL_1, NAT_1, SETFAM_1,
      PROB_1, SUPINF_1, SUPINF_2, MEASURE1, MEASURE2, MEASURE3,
      MEASURE4;
 constructors ENUMSET1, PARTFUN1, REAL_1, NAT_1, PROB_2, MEASURE3,
      SUPINF_1, FUNCOP_1, RELSET_1, XREAL_0, MEASURE2, MEASURE4;
 registrations SUBSET_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS, XXREAL_0,
      XREAL_0, NAT_1, MEASURE1, VALUED_0, MEASURE4;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, MEASURE3, XBOOLE_0;
 equalities XBOOLE_0;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for X being set,
      C being C_Measure of X,
      A being Subset of X
  holds
    (A in sigma_Field(C) iff
      for T being Subset of X holds
        C.T = C.(T /\ A) + C.(T \ A))
proof
end;
::$P+
