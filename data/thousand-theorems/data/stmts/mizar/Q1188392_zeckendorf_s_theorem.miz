:: Statement-only formalization of thousand-theorems corpus artifact Q1188392,
:: "Zeckendorf's theorem": the Fibonacci-sum map gives a bijection between
:: natural numbers and finite sequences of indices at least two, decreasing
:: by gaps of at least two. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FINSEQ_1, FINSEQ_2, NUMBERS, NAT_1, INT_1,
    CARD_1, CARD_3, XCMPLX_0, XREAL_0, XXREAL_0, ORDINAL1, FINSET_1,
    PRE_FF, ARYTM_1, ARYTM_3, MEMBERED, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, INT_1, RELAT_1, FUNCT_1,
    RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, RVSUM_1,
    MEMBERED, NAT_1, NAT_D, FINSET_1, PRE_FF;
  constructors REAL_1, NAT_D, RELSET_1, PARTFUN1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP, FINSET_1, CARD_1, PRE_FF;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, INT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1,
    CARD_1, MEMBERED, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat holds
    ex p being FinSequence of NAT st
      (for i being Nat st i in dom p holds 2 <= p.i) &
      (for i,j being Nat st
        i in dom p & j in dom p & i < j
        holds p.j + 2 <= p.i) &
      (ex terms being FinSequence of NAT st
        len terms = len p &
        (for i being Nat st i in dom terms holds
          terms.i = Fib (p.i)) &
        Sum terms = n) &
      for q being FinSequence of NAT st
        (for i being Nat st i in dom q holds 2 <= q.i) &
        (for i,j being Nat st
          i in dom q & j in dom q & i < j
          holds q.j + 2 <= q.i) &
        (ex terms being FinSequence of NAT st
          len terms = len q &
          (for i being Nat st i in dom terms holds
            terms.i = Fib (q.i)) &
          Sum terms = n)
      holds q = p
proof
end;
::$P+
