:: Statement-only formalization of thousand-theorems corpus artifact Q1217677,
:: "Fundamental theorem of calculus": locally almost-everywhere convergent
:: Banach-space-valued integrands differentiate their oriented Bochner integral
:: primitives strictly, and an integrable right derivative of a continuous
:: Banach-space-valued function integrates to its endpoint difference.
:: This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, PROB_1, MEASURE1, SUBSET_1, SEQFUNC,
      MESFUNC5, PARTFUN1, XXREAL_0, XXREAL_1, XXREAL_2, NAT_1, RELAT_1,
      ARYTM_3, ARYTM_1, FUNCT_1, ORDINAL2, CARD_1, COMPLEX1, SEQ_2,
      TARSKI, REAL_1, PBOOLE, MESFUNC1, MESFUNC2, VALUED_1, ZFMISC_1,
      FUNCT_2, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1, NORMSP_0, NORMSP_1,
      HAHNBAN, HAHNBAN1, DUALSP01, FINSET_1, BINOP_1, INTEGRA5, LOPBAN_1,
      RSSPACE3, FCONT_1, MEASURE5, MEASUR12, RCOMP_1, REALSET1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XXREAL_3, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, XXREAL_0, XXREAL_1,
      XXREAL_2, VALUED_0, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1,
      NAT_1, PROB_1, MEASURE1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5,
      MESFUNC6, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1, NORMSP_0,
      NORMSP_1, HAHNBAN, HAHNBAN1, DUALSP01, FINSET_1, BINOP_1, RSSPACE3,
      LOPBAN_1, RCOMP_1, MEASURE5, MEASUR12, INTEGRA5;
 constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6,
      RELSET_1, COMPLEX1, NORMSP_1, HAHNBAN, HAHNBAN1, DUALSP01,
      FINSET_1, BINOP_1, RSSPACE3, LOPBAN_1, RCOMP_1, MEASURE5, MEASUR12,
      INTEGRA5;
 registrations SUBSET_1, NAT_1, XREAL_0, MEMBERED, ORDINAL1, PARTFUN1,
      MEASURE1, FUNCT_2, RELAT_1, XBOOLE_0, NUMBERS, XXREAL_0, XCMPLX_0,
      FUNCT_1, VALUED_0, XXREAL_3, XXREAL_1, XXREAL_2, RELSET_1, STRUCT_0,
      ALGSTR_0, RLVECT_1, NORMSP_0, NORMSP_1, HAHNBAN, HAHNBAN1,
      DUALSP01, FINSET_1, RSSPACE3, LOPBAN_1, MEASURE5, MEASUR12,
      INTEGRA1, RCOMP_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, MESFUNC5, MESFUNC6, NORMSP_0,
      NORMSP_1, HAHNBAN, HAHNBAN1, RSSPACE3, LOPBAN_1;
 equalities XBOOLE_0, RLVECT_1, STRUCT_0, ALGSTR_0, NORMSP_0, BINOP_1,
      RCOMP_1, INTEGRA5;
 expansions TARSKI, XBOOLE_0, FUNCT_2, NORMSP_0, NORMSP_1;

begin

::$P-
theorem
  for G being RealNormSpace,
      f being Function of REAL,the carrier of G,
      a,b being Element of REAL,
      c being Point of G
  st
    (for s being sequence of G st
      s is Cauchy_sequence_by_Norm holds s is convergent) &
    (ex I,N being Element of L-Field,
        Q being sequence of Funcs(REAL,the carrier of G),
        nf being Function of REAL,REAL
     st
       ((a <= b & I = [.a,b.]) or (b < a & I = [.b,a.])) &
       L-Meas.N = 0 &
       (for k being Nat holds
         ex q being Function of REAL,the carrier of G,
            R being finite Subset of the carrier of G
         st
           Q.k = q &
           (for x being Element of REAL holds q.x in R) &
           (for y being Point of G holds
             {x where x is Element of REAL: q.x = y} in L-Field)) &
       (for x being Element of REAL st x in I & not x in N holds
         for epsilon being Real st 0 < epsilon holds
           ex k0 being Nat st
             for k being Nat st k0 <= k holds
               ex q being Function of REAL,the carrier of G st
                 Q.k = q & ||.q.x - f.x.|| < epsilon) &
       (for x being Element of REAL holds nf.x = ||.f.x.||) &
       nf|I is_integrable_on L-Meas) &
    (ex r being Real,
        J,N being Element of L-Field,
        Q being sequence of Funcs(REAL,the carrier of G)
     st
       0 < r &
       J = [.b-r,b+r.] &
       L-Meas.N = 0 &
       (for k being Nat holds
         ex q being Function of REAL,the carrier of G,
            R being finite Subset of the carrier of G
         st
           Q.k = q &
           (for x being Element of REAL holds q.x in R) &
           (for y being Point of G holds
             {x where x is Element of REAL: q.x = y} in L-Field)) &
       for x being Element of REAL st x in J & not x in N holds
         for epsilon being Real st 0 < epsilon holds
           ex k0 being Nat st
             for k being Nat st k0 <= k holds
               ex q being Function of REAL,the carrier of G st
                 Q.k = q & ||.q.x - f.x.|| < epsilon) &
    (ex N being Element of L-Field st
       L-Meas.N = 0 &
       for epsilon being Real st 0 < epsilon holds
         ex delta being Real st
           0 < delta &
           for x being Element of REAL st
             not x in N & |.x-b.| < delta
           holds ||.f.x - c.|| < epsilon)
  holds
    ex P being Function of REAL,the carrier of G,
       rho being Real
    st
      0 < rho &
      (for u being Element of REAL st |.u-b.| < rho holds
        for L being Lipschitzian linear-Functional of G holds
          ex h being Function of REAL,REAL st
            (for x being Element of REAL holds h.x = L.(f.x)) &
            ((a <= u &
                Integral(L-Meas,h|[.a,u.]) = L.(P.u)) or
             (u < a &
                -Integral(L-Meas,h|[.u,a.]) = L.(P.u)))) &
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st
          0 < delta &
          for x,y being Element of REAL st
            |.x-b.| < delta & |.y-b.| < delta
          holds
            ||.(P.x - P.y) - (x-y)*c.|| <= epsilon*|.x-y.|
proof
end;
::$P+

::$P-
theorem
  for G being RealNormSpace,
      f,f9 being Function of REAL,the carrier of G,
      a,b being Element of REAL
  st
    (for s being sequence of G st
      s is Cauchy_sequence_by_Norm holds s is convergent) &
    a <= b &
    (for x being Element of REAL st x in [.a,b.] holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st
          0 < delta &
          for y being Element of REAL st
            y in [.a,b.] & |.y-x.| < delta holds
            ||.f.y - f.x.|| < epsilon) &
    (for x being Element of REAL st a < x & x < b holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st
          0 < delta &
          for y being Element of REAL st x < y & |.y-x.| < delta holds
            ||.(f.y - f.x) - (y-x)*(f9.x).||
              <= epsilon*|.y-x.|) &
    (ex I,N being Element of L-Field,
        Q being sequence of Funcs(REAL,the carrier of G),
        nf being Function of REAL,REAL
     st
       I = [.a,b.] &
       L-Meas.N = 0 &
       (for k being Nat holds
         ex q being Function of REAL,the carrier of G,
            R being finite Subset of the carrier of G
         st
           Q.k = q &
           (for x being Element of REAL holds q.x in R) &
           (for y being Point of G holds
             {x where x is Element of REAL: q.x = y} in L-Field)) &
       (for x being Element of REAL st x in I & not x in N holds
         for epsilon being Real st 0 < epsilon holds
           ex k0 being Nat st
             for k being Nat st k0 <= k holds
               ex q being Function of REAL,the carrier of G st
                 Q.k = q & ||.q.x - f9.x.|| < epsilon) &
       (for x being Element of REAL holds nf.x = ||.f9.x.||) &
       nf|I is_integrable_on L-Meas)
  holds
    for L being Lipschitzian linear-Functional of G holds
      ex h being Function of REAL,REAL st
        (for x being Element of REAL holds h.x = L.(f9.x)) &
        Integral(L-Meas,h|[.a,b.]) = L.(f.b - f.a)
proof
end;
::$P+
