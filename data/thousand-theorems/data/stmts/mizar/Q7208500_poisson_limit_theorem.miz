:: Statement-only formalization of thousand-theorems corpus artifact Q7208500,
:: "Poisson limit theorem": if n times a real sequence p(n) converges to r,
:: then its fixed-k binomial probability term converges to
:: exp(-r) times r^k divided by k!. This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, COMPLEX1, SQUARE_1,
    NEWTON, ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1,
    XXREAL_1, ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1,
    XBOOLE_0, SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, ORDINAL2,
    CARD_3, ABIAN, TAYLOR_2, NAT_1, POWER;
  notations TARSKI, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1, RFUNCT_2,
    RCOMP_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NUMBERS, COMPLEX1,
    SQUARE_1, REAL_1, NAT_1, FUNCT_2, VALUED_1, SEQ_1, COMSEQ_2,
    SEQ_2, SERIES_1, FDIFF_1, SEQFUNC, NEWTON, POWER, SIN_COS,
    TAYLOR_1, ABIAN, NAT_D;
  constructors ARYTM_0, REAL_1, SQUARE_1, NAT_1, SEQ_2, RCOMP_1,
    RFUNCT_2, LIMFUNC1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN, TAYLOR_1,
    SEQFUNC, SERIES_1, VALUED_1, RELSET_1, COMSEQ_2, POWER, NAT_D;
  registrations RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, SQUARE_1, NEWTON, SIN_COS,
    INT_1, ORDINAL1;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities VALUED_1, SUBSET_1;
  expansions TAYLOR_1;

begin

::$P-
theorem
  for k being Nat, p being Real_Sequence, r being Real st
    (for epsilon being Real st 0 < epsilon holds
      ex N being Nat st
        for n being Nat st N <= n holds
          |.(n qua Real) * p.n - r.| < epsilon)
  holds
    for epsilon being Real st 0 < epsilon holds
      ex N being Nat st
        for n being Nat st N <= n holds
          |.((n choose k) qua Real) * (p.n |^ k) *
              ((1 - p.n) |^ (n -' k)) -
            (exp_R.(-r) * (r |^ k) / ((k !) qua Real)).| < epsilon
proof
end;
::$P+
