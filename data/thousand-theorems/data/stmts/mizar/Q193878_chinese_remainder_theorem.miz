:: Statement-only formalization of thousand-theorems corpus artifact Q193878,
:: "Chinese remainder theorem": pairwise comaximal ideals in a commutative
:: ring identify the quotient by their intersection with the product of the
:: individual quotient rings. This file contains no proof.

environ

 vocabularies ARYTM_3, FUNCT_1, RELAT_1, CARD_3, XBOOLE_0, TARSKI, XCMPLX_0,
      STRUCT_0, SUBSET_1, SUPINF_2, NAT_1, CARD_1, MESFUNC1, GROUP_1, ARYTM_1,
      FINSEQ_1, SETFAM_1, INT_2, QUOFIELD, BINOP_1, GROUP_4, NUMBERS, IDEAL_1,
      ZFMISC_1, FUNCSDOM, CARD_FIL, RING_1, SQUARE_1, BCIALG_2, NEWTON, RING_2,
      XXREAL_0, TOPZARI1, ALGSTR_0, LATTICEA, RINGFRAC, EQREL_1, WAYBEL20,
      VECTSP10, PARTFUN1, IDEAL_2, ORDINAL4, RAMSEY_1, GCD_1, LATTICE3,
      VECTSP_1, CATALG_1, COHSP_1, FINSET_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, FUNCT_1, ORDINAL1,
      RELSET_1, PARTFUN1, FUNCT_2, DOMAIN_1, NUMBERS, XCMPLX_0, XXREAL_0,
      NAT_1, FINSEQ_1, FINSEQOP, EQREL_1, NEWTON, STRUCT_0, ALGSTR_0, RLVECT_1,
      GROUP_1, VECTSP_1, BINOM, VECTSP10, IDEAL_1, RING_1, RING_2, TOPZARI1,
      RINGFRAC, COHSP_1, CARD_3, FINSET_1, QUOFIELD;
 constructors RELSET_1, FINSEQOP, NEWTON, RINGCAT1, MOD_4, GCD_1, BINOM,
      COHSP_1, RINGFRAC, WSIERP_1, QUOFIELD;
 registrations XBOOLE_0, ORDINAL1, RELSET_1, XREAL_0, NAT_1, STRUCT_0, CARD_1,
      VECTSP_1, ALGSTR_1, SUBSET_1, ALGSTR_0, RLVECT_1, IDEAL_1, RING_2, MOD_4,
      RING_1, TOPZARI1, FINSEQ_1, INT_1, FINSET_1;
 requirements NUMERALS, SUBSET, BOOLE, ARITHM, REAL;
 definitions TARSKI, IDEAL_1;
 equalities STRUCT_0, FINSEQ_1, ALGSTR_0;
 expansions TARSKI, FUNCT_2, IDEAL_1, STRUCT_0, XBOOLE_0, SUBSET_1, TOPZARI1,
      RINGFRAC, FUNCT_1, RING_1;
 theorems GROUP_1, RLVECT_1, IDEAL_1, FUNCT_2, TARSKI, FUNCT_1, XREAL_1,
      NAT_1, RING_1, XBOOLE_0, FINSEQ_1, ORDINAL1, XBOOLE_1, BINOM, RING_2,
      RELAT_1, SETFAM_1, TOPZARI1, RINGFRAC, FIELD_1, VECTSP10, VECTSP_2,
      FINSEQ_5, PARTFUN1, FINSEQ_3, FINSEQ_2, TOPREALA, CARD_1, INT_1, COHSP_1;
 schemes NAT_1, RECDEF_1, INT_1, FUNCT_2;

begin

::$P-
theorem
  for R being commutative Ring, K being finite set,
      F being Function of K, bool the carrier of R,
      M being Ideal of R
  st (for i being object st i in K holds F.i is Ideal of R) &
     (for i,j being object st i in K & j in K & i <> j holds
        for I,J being Ideal of R st I = F.i & J = F.j
          holds I + J = the carrier of R) &
     (for x being Element of R holds
        (x in M iff for i being object st i in K holds x in F.i))
  holds ex C being Function, P being commutative Ring st
    dom C = K &
    (for i being object st i in K holds
       for I being Ideal of R st I = F.i
         holds C.i = the carrier of R/I) &
    the carrier of P = product C &
    (ex z being Function st z = 0.P &
       for i being object st i in K holds
         for I being Ideal of R st I = F.i
           holds z.i = 0.(R/I)) &
    (ex e being Function st e = 1.P &
       for i being object st i in K holds
         for I being Ideal of R st I = F.i
           holds e.i = 1.(R/I)) &
    (for a,b being Element of P holds
       ex x,y,z being Function st x = a & y = b & z = a + b &
         for i being object st i in K holds
           for I being Ideal of R st I = F.i holds
             for u,v being Element of R/I st u = x.i & v = y.i
               holds z.i = u + v) &
    (for a,b being Element of P holds
       ex x,y,z being Function st x = a & y = b & z = a * b &
         for i being object st i in K holds
           for I being Ideal of R st I = F.i holds
             for u,v being Element of R/I st u = x.i & v = y.i
               holds z.i = u * v) &
    ex h being Function of R/M,P st
      h is RingIsomorphism &
      for r being Element of R holds
        ex q being Function st q = h.((canHom M).r) &
          for i being object st i in K holds
            for I being Ideal of R st I = F.i
              holds q.i = (canHom I).r
proof
end;
::$P+
