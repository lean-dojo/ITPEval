:: Statement-only formalization of thousand-theorems corpus artifact Q2379132,
:: "Going-up and going-down theorems". It states the two indexed going-up
:: results, the prime-spectrum characterization of going-down, and the
:: localized-spectrum surjectivity criterion. This file contains no proof.

environ

 vocabularies ARYTM_3, VECTSP_1, ALGSTR_0, TARSKI, GROUP_6, NAT_1, MESFUNC1,
      VECTSP_2, STRUCT_0, SUBSET_1, SUPINF_2, GROUP_1, POLYNOM1, POLYNOM2,
      POLYNOM3, FUNCSDOM, HURWITZ, FINSEQ_1, QUOFIELD, ALGSEQ_1, FUNCT_1,
      RELAT_1, CARD_1, POLYNOM8, IDEAL_1, MOD_4, XBOOLE_0, NUMBERS, MSSUBFAM,
      CARD_3, POLYNOM5, YELLOW_8, WAYBEL20, EQREL_1, RING_1, RING_2, RLVECT_1,
      RING_3, AFINSQ_1, FUNCT_2, PARTFUN1, XXREAL_0, XCMPLX_0, ORDINAL4,
      POLYNOM4, RATFUNC1, CARD_FIL, NEWTON, ARYTM_1, CALCUL_2, FIELD_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, PARTFUN1,
      FUNCT_2, BINOP_1, FINSEQ_1, EQREL_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, NAT_1, NAT_D, GROUP_4, ALGSEQ_1, POLYDIFF, POLYNOM3, POLYNOM4,
      POLYNOM5, VECTSP_1, VECTSP_2, QUOFIELD, STRUCT_0, ALGSTR_0, GROUP_1,
      GROUP_6, RLVECT_1, GCD_1, BINOM, HURWITZ, RATFUNC1, IDEAL_1, MOD_4,
      RING_1, RING_2, RING_3, RING_4, FIELD_1;
 constructors HURWITZ, POLYNOM4, RELSET_1, ABIAN, NAT_D, RATFUNC1, GCD_1,
      BINOM, RINGCAT1, RING_3, ALGSEQ_1, RING_4, GROUP_4, POLYDIFF, FIELD_1;
 registrations XBOOLE_0, XXREAL_0, XREAL_0, CARD_1, ORDINAL1, RELSET_1, MOD_4,
      FUNCT_1, FUNCT_2, NAT_1, INT_1, INT_2, POLYDIFF, FINSEQ_1, STRUCT_0,
      RLVECT_1, VECTSP_1, ALGSTR_1, GROUP_6, RINGCAT1, GRCAT_1, RING_1, INT_3,
      RING_2, RING_3, RING_4, RING_5, POLYNOM3, POLYNOM4, POLYNOM5, RATFUNC1,
      FIELD_1;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI;
 equalities FINSEQ_1, XCMPLX_0, POLYNOM3, RING_4, POLYDIFF, HURWITZ;
 expansions STRUCT_0, GROUP_1, VECTSP_1, TARSKI, GROUP_6, FUNCT_2, RING_2,
      ALGSEQ_1;
 theorems GROUP_1, GROUP_6, VECTSP_1, RLVECT_1, IDEAL_1, POLYDIFF, GCD_1,
      PARTFUN1, FUNCT_2, TARSKI, FUNCT_1, POLYNOM4, RING_3, RATFUNC1, RING_5,
      ALGSEQ_1, RING_2, FUNCOP_1, POLYNOM3, NAT_1, INT_1, FINSEQ_1, NORMSP_1,
      RING_1, RING_4, XREAL_0, XREAL_1, STRUCT_0, ORDINAL1, UPROOTS, XXREAL_0,
      POLYNOM5, FINSEQ_2, GROUP_4, HURWITZ, BINOM, POLYNOM2, EC_PF_2, FINSEQ_3,
      FINSEQ_5, FIELD_1;
 schemes ALGSEQ_1, NAT_1, INT_1, FUNCT_2;

begin

::$P-
theorem
  for R being comRing,
      S being domRing,
      h being Function of R,S,
      P being Ideal of R
  st h is additive multiplicative unity-preserving &
     P <> the carrier of R &
     (for a,b being Element of R st a*b in P holds a in P or b in P) &
     (for x being Element of R st h.x = 0.S holds x in P) &
     (for s being Element of S holds
        ex p being Polynomial of R,
           q being Polynomial of S st
          LC p = 1.R &
          (for i being Nat holds q.i = h.(p.i)) &
          eval(q,s) = 0.S)
  holds ex Q being Ideal of S st
    Q <> the carrier of S &
    (for a,b being Element of S st a*b in Q holds a in Q or b in Q) &
    h"Q = P
proof
end;
::$P+

::$P-
theorem
  for R,S being comRing,
      h being Function of R,S,
      P being Ideal of R,
      I being Ideal of S
  st h is additive multiplicative unity-preserving &
     P <> the carrier of R &
     (for a,b being Element of R st a*b in P holds a in P or b in P) &
     I <> the carrier of S &
     (for a,b being Element of S st a*b in I holds a in I or b in I) &
     h"I c= P &
     (for s being Element of S holds
        ex p being Polynomial of R,
           q being Polynomial of S st
          LC p = 1.R &
          (for i being Nat holds q.i = h.(p.i)) &
          eval(q,s) = 0.S)
  holds ex Q being Ideal of S st
    I c= Q &
    Q <> the carrier of S &
    (for a,b being Element of S st a*b in Q holds a in Q or b in Q) &
    h"Q = P
proof
end;
::$P+

::$P-
theorem
  for R,S being comRing,
      h being Function of R,S
  st h is additive multiplicative unity-preserving
  holds
    ((for p,q being Ideal of R st
        p <> the carrier of R &
        (for a,b being Element of R st a*b in p holds a in p or b in p) &
        q <> the carrier of R &
        (for a,b being Element of R st a*b in q holds a in q or b in q) &
        p c= q
      holds
        for Q being Ideal of S st
          Q <> the carrier of S &
          (for a,b being Element of S st a*b in Q holds a in Q or b in Q) &
          h"Q = q
        holds
          ex P being Ideal of S st
            P <> the carrier of S &
            (for a,b being Element of S st a*b in P holds a in P or b in P) &
            P c= Q &
            h"P = p)
     iff
     (for Q being Ideal of S st
        Q <> the carrier of S &
        (for a,b being Element of S st a*b in Q holds a in Q or b in Q)
      holds
        for p being Ideal of R st
          p <> the carrier of R &
          (for a,b being Element of R st a*b in p holds a in p or b in p) &
          p c= h"Q
        holds
          ex P being Ideal of S st
            P <> the carrier of S &
            (for a,b being Element of S st a*b in P holds a in P or b in P) &
            P c= Q &
            h"P = p))
proof
end;
::$P+

::$P-
theorem
  for R,S being comRing,
      h being Function of R,S
  st h is additive multiplicative unity-preserving &
     (for Q being Ideal of S st
        Q <> the carrier of S &
        (for a,b being Element of S st a*b in Q holds a in Q or b in Q)
      holds
        for p being Ideal of R st
          p <> the carrier of R &
          (for a,b being Element of R st a*b in p holds a in p or b in p) &
          p c= h"Q
        holds
          ex P being Ideal of S st
            P <> the carrier of S &
            (for a,b being Element of S st a*b in P holds a in P or b in P) &
            P c= Q &
            h"P = p)
  holds
    for p,q being Ideal of R st
      p <> the carrier of R &
      (for a,b being Element of R st a*b in p holds a in p or b in p) &
      q <> the carrier of R &
      (for a,b being Element of R st a*b in q holds a in q or b in q) &
      p c= q
    holds
      for Q being Ideal of S st
        Q <> the carrier of S &
        (for a,b being Element of S st a*b in Q holds a in Q or b in Q) &
        h"Q = q
      holds
        ex P being Ideal of S st
          P <> the carrier of S &
          (for a,b being Element of S st a*b in P holds a in P or b in P) &
          P c= Q &
          h"P = p
proof
end;
::$P+
