:: Statement-only formalization of thousand-theorems artifact Q338886,
:: "Divergence theorem": the Bochner integral of the divergence of a
:: vector field on a finite-dimensional rectangular box equals the signed
:: sum of its component integrals over opposite faces, allowing a countable
:: exceptional set for Frechet differentiability. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, RELAT_1,
      FUNCT_1, FUNCT_2, PARTFUN1, CARD_1, CARD_3, STRUCT_0, ALGSTR_0,
      RLVECT_1, NORMSP_0, NORMSP_1, PRE_TOPC, XCMPLX_0, XXREAL_0, NAT_1,
      REAL_1,
      ARYTM_1, ARYTM_3, MEMBERED, BINOP_1, LOPBAN_1, FDIFF_1, NFCONT_1,
      FINSEQ_1,
      FINSEQ_2, FINSEQ_3, FINSEQ_5, FINSET_1, RVSUM_1, VALUED_0, VALUED_1,
      PROB_1, MEASURE1, MEASURE3, MEASURE5, MEASURE6, MEASUR10, MEASUR12,
      MEASUR13, MEASUR14, MESFUNC1, MESFUNC2, MESFUNC5, SEQFUNC, SEQ_2,
      COMPLEX1,
      HAHNBAN, HAHNBAN1, DUALSP01, RSSPACE3, FCONT_1, INTEGRA5, EUCLID,
      REAL_NS1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, CARD_3, NUMBERS,
      XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0, REAL_1, NAT_1, MEMBERED,
      VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_5,
      FINSET_1, RVSUM_1, EUCLID, BINOP_1, STRUCT_0, ALGSTR_0, PRE_TOPC,
      RLVECT_1,
      NORMSP_0, NORMSP_1, LOPBAN_1, FCONT_1, NFCONT_1, NDIFF_1, PROB_1,
      MEASURE1,
      MEASURE3, MEASURE5, MEASURE6, MEASUR10, MEASUR12, MEASUR13, MEASUR14,
      EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6, SEQFUNC,
      COMPLEX1, HAHNBAN, HAHNBAN1, DUALSP01, RSSPACE3, REAL_NS1;
 constructors RELSET_1, REAL_1, NAT_1, FINSEQ_2, FINSEQ_3, FINSEQ_5,
      FINSET_1, RVSUM_1, BINOP_1, NORMSP_1, LOPBAN_1, FCONT_1, NFCONT_1,
      NDIFF_1, MEASURE1,
      MEASURE3, MEASURE5, MEASURE6, MEASUR10, MEASUR12, MEASUR13, MEASUR14,
      EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6, SEQFUNC,
      SEQ_2, COMPLEX1, HAHNBAN, HAHNBAN1, DUALSP01, RSSPACE3,
      EUCLID, REAL_NS1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      ORDINAL1, CARD_1, CARD_3, NUMBERS, XREAL_0, NAT_1, MEMBERED,
      VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, STRUCT_0, ALGSTR_0,
      RLVECT_1, NORMSP_0, NORMSP_1, LOPBAN_1, PARTFUN1, MEASURE1,
      MEASURE3, MEASURE5, MEASURE6, MEASUR13, XXREAL_3, HAHNBAN, HAHNBAN1,
      DUALSP01, RSSPACE3, EUCLID, REAL_NS1, REAL_NS2;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, NORMSP_0, NORMSP_1, LOPBAN_1,
      MESFUNC5, MESFUNC6;
 equalities XBOOLE_0, SUBSET_1, STRUCT_0, ALGSTR_0, RLVECT_1, NORMSP_0,
      BINOP_1, EUCLID;
 expansions TARSKI, XBOOLE_0, FUNCT_2, NORMSP_0, NORMSP_1;

begin

::$P-
theorem
  for n being Nat,
      E being RealNormSpace,
      BI1 being Relation of
        Funcs(REAL (n+1),the carrier of E),XL-Field (n+1),
      BJ1 being Relation of
        [:Funcs(REAL (n+1),the carrier of E),XL-Field (n+1):],
        the carrier of E,
      S0 being SigmaField of REAL n,
      M0 being sigma_Measure of S0,
      BI0 being Relation of
        Funcs(REAL n,the carrier of E),S0,
      BJ0 being Relation of
        [:Funcs(REAL n,the carrier of E),S0:],
        the carrier of E,
      a,b being Element of REAL (n+1),
      F being FinSequence of
        Funcs(REAL (n+1),the carrier of E),
      D being FinSequence of
        Funcs(REAL (n+1),
          the carrier of
            R_NormSpace_of_BoundedLinearOperators(REAL-NS (n+1),E)),
      s being Subset of REAL (n+1),
      C being Element of XL-Field (n+1),
      O being Subset of REAL (n+1),
      div being Function of REAL (n+1),the carrier of E
  st
    (for f being Function of REAL (n+1),the carrier of E,
         A being Element of XL-Field (n+1) holds
      [f,A] in BI1 iff
        ex N being Element of XL-Field (n+1),
           Q being sequence of
             Funcs(REAL (n+1),the carrier of E),
           nf being Function of REAL (n+1),REAL st
          (XL-Meas (n+1)).N = 0 &
          (for k being Nat holds
            ex q being Function of REAL (n+1),the carrier of E,
               R being finite Subset of the carrier of E st
              Q.k = q &
              (for x being Element of REAL (n+1) holds q.x in R) &
              (for y being Point of E holds
                {x where x is Element of REAL (n+1) : q.x = y}
                  in XL-Field (n+1))) &
          (for x being Element of REAL (n+1)
             st x in A & not x in N holds
            for epsilon being Real st 0 < epsilon holds
              ex k0 being Nat st
                for k being Nat st k0 <= k holds
                  ex q being Function of
                    REAL (n+1),the carrier of E st
                    Q.k = q & ||.q.x-f.x.|| < epsilon) &
          (for x being Element of REAL (n+1) holds
            nf.x = ||.f.x.||) &
          nf|A is_integrable_on XL-Meas (n+1)) &
    (for f being Function of REAL (n+1),the carrier of E,
         A being Element of XL-Field (n+1),
         v being Point of E holds
      [[f,A],v] in BJ1 iff
        (((for t being sequence of E st
              t is Cauchy_sequence_by_Norm holds t is convergent) &
            [f,A] in BI1 &
            (for L being linear-Functional of E st L is Lipschitzian holds
              ex h being Function of REAL (n+1),REAL st
                (for x being Element of REAL (n+1) holds
                  h.x = L.(f.x)) &
                Integral(XL-Meas (n+1),h|A) = L.v))
          or
          ((not [f,A] in BI1 or
              ex t being sequence of E st
                t is Cauchy_sequence_by_Norm & not t is convergent) &
            v = the ZeroF of E))) &
    ((n = 0 & S0 = bool REAL n & M0.(REAL n) = 1) or
      ex m being non zero Nat st
        m = n & S0 = XL-Field m & M0 = XL-Meas m) &
    (for f being Function of REAL n,the carrier of E,
         A being Element of S0 holds
      [f,A] in BI0 iff
        ex N being Element of S0,
           Q being sequence of Funcs(REAL n,the carrier of E),
           nf being Function of REAL n,REAL st
          M0.N = 0 &
          (for k being Nat holds
            ex q being Function of REAL n,the carrier of E,
               R being finite Subset of the carrier of E st
              Q.k = q &
              (for x being Element of REAL n holds q.x in R) &
              (for y being Point of E holds
                {x where x is Element of REAL n : q.x = y}
                  in S0)) &
          (for x being Element of REAL n st x in A & not x in N holds
            for epsilon being Real st 0 < epsilon holds
              ex k0 being Nat st
                for k being Nat st k0 <= k holds
                  ex q being Function of REAL n,the carrier of E st
                    Q.k = q & ||.q.x-f.x.|| < epsilon) &
          (for x being Element of REAL n holds
            nf.x = ||.f.x.||) &
          nf|A is_integrable_on M0) &
    (for f being Function of REAL n,the carrier of E,
         A being Element of S0,
         v being Point of E holds
      [[f,A],v] in BJ0 iff
        (((for t being sequence of E st
              t is Cauchy_sequence_by_Norm holds t is convergent) &
            [f,A] in BI0 &
            (for L being linear-Functional of E st L is Lipschitzian holds
              ex h being Function of REAL n,REAL st
                (for x being Element of REAL n holds h.x = L.(f.x)) &
                Integral(M0,h|A) = L.v))
          or
          ((not [f,A] in BI0 or
              ex t being sequence of E st
                t is Cauchy_sequence_by_Norm & not t is convergent) &
            v = the ZeroF of E))) &
    len F = n+1 &
    len D = n+1 &
    s is countable &
    (for i being Nat st i in Seg (n+1) holds a.i <= b.i) &
    C = {x where x is Element of REAL (n+1) :
      for i being Nat st i in Seg (n+1) holds
        a.i <= x.i & x.i <= b.i} &
    O = {x where x is Element of REAL (n+1) :
      for i being Nat st i in Seg (n+1) holds
        a.i < x.i & x.i < b.i} &
    (for i being Nat st i in Seg (n+1) holds
      ex fi being Function of REAL (n+1),the carrier of E st
        fi = F/.i &
        for x being Point of REAL-NS (n+1) st x in C holds
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st
              0 < delta &
              for y being Point of REAL-NS (n+1)
                st y in C & ||.y-x.|| < delta holds
                ex u,v being Point of E st
                  u = fi.y & v = fi.x & ||.u-v.|| < epsilon) &
    (for x being Point of REAL-NS (n+1) st x in O \ s holds
      for i being Nat st i in Seg (n+1) holds
        ex fi being PartFunc of REAL-NS (n+1),E,
           L being Point of
             R_NormSpace_of_BoundedLinearOperators(REAL-NS (n+1),E) st
          fi = F/.i &
          L = (D/.i).x &
          fi is_differentiable_in x &
          diff(fi,x) = L) &
    (for x being Point of REAL-NS (n+1) holds
      ex z being FinSequence of E st
        len z = n+1 &
        (for i being Nat st i in Seg (n+1) holds
          ex e being Element of REAL (n+1),
             ep being Point of REAL-NS (n+1) st
            e = ep &
            (for j being Nat st j in Seg (n+1) holds
              (j = i implies e.j = 1) &
              (j <> i implies e.j = 0)) &
            z/.i =
              (modetrans((D/.i).x,REAL-NS (n+1),E)).ep) &
        div.x = Sum z) &
    [div,C] in BI1
  holds
    ex divInt being Point of E,
       frontInt,backInt,flux being FinSequence of E st
      len frontInt = n+1 &
      len backInt = n+1 &
      len flux = n+1 &
      [[div,C],divInt] in BJ1 &
      (for i being Nat st i in Seg (n+1) holds
        ex A being Element of S0,
           front,back being Function of REAL n,REAL (n+1),
           ff,bf being Function of REAL n,the carrier of E st
          A = {y where y is Element of REAL n :
            for j being Nat st j in Seg n holds
              (j < i & a.j <= y.j & y.j <= b.j) or
              (i <= j & a.(j+1) <= y.j & y.j <= b.(j+1))} &
          (for y being Element of REAL n holds
            (front.y).i = b.i &
            (back.y).i = a.i &
            (for j being Nat st j in Seg (n+1) & j <> i holds
              (j < i & (front.y).j = y.j & (back.y).j = y.j) or
              (i < j & (front.y).j = y.(j-'1) &
                (back.y).j = y.(j-'1))) &
            ff.y = (F/.i).(front.y) &
            bf.y = (F/.i).(back.y)) &
          [[ff,A],frontInt/.i] in BJ0 &
          [[bf,A],backInt/.i] in BJ0 &
          flux/.i = frontInt/.i - backInt/.i) &
      divInt = Sum flux
proof
end;
::$P+
