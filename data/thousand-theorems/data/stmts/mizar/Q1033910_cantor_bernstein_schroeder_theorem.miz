:: Statement-only formalization of thousand-theorems corpus artifact Q1033910,
:: "Cantor–Bernstein–Schroeder theorem": injections between two arbitrary sets
:: in both directions imply a bijection between them. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2;
  constructors RELSET_1, FUNCT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A,B being set,
      f,g being Function st
    dom f = A & rng f c= B & f is one-to-one &
    dom g = B & rng g c= A & g is one-to-one
  holds ex h being Function st
    dom h = A & rng h = B & h is one-to-one
proof
end;
::$P+
