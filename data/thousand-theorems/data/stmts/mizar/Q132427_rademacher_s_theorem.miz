:: Statement-only formalization of thousand-theorems corpus artifact Q132427,
:: "Rademacher's theorem": a map between finite-dimensional real normed
:: spaces that is Lipschitz on a measurable set is Frechet differentiable
:: within that set almost everywhere for additive Haar measure.
:: This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, RELAT_1,
      FUNCT_1, FUNCT_2, CARD_1, CARD_3, STRUCT_0, ALGSTR_0, RLVECT_1,
      RLVECT_5, NORMSP_0, NORMSP_1, NORMSP_2, PRE_TOPC, TOPS_1,
      TOPS_2, TOPGEN_4, COMPTS_1, RCOMP_1, PROB_1, MEASURE1,
      MEASURE3, MEASURE4, MEASURE8, XXREAL_0, XXREAL_2, SUPINF_1,
      SUPINF_2, NAT_1, REAL_1, ARYTM_1, ARYTM_3, SETFAM_1, REAL_NS1,
      MEMBERED, LOPBAN_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, CARD_3, ORDINAL1,
      NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_2, XXREAL_3, XREAL_0,
      REAL_1, EXTREAL1, NAT_1, SUPINF_1, SUPINF_2, STRUCT_0, ALGSTR_0,
      PRE_TOPC, TOPS_2, COMPTS_1, RLVECT_1, RLVECT_5, NORMSP_0,
      NORMSP_1, NORMSP_2, PROB_1, MEASURE1, MEASURE3, MEASURE4,
      MEASURE8, TOPGEN_4, REAL_NS1, LOPBAN_1, NDIFF_1;
 constructors RELSET_1, DOMAIN_1, REAL_1, EXTREAL1, NAT_1, TOPS_2,
      COMPTS_1, NORMSP_2, RLVECT_5, MEASURE1, MEASURE3, MEASURE4,
      MEASURE8, TOPGEN_4, REAL_NS1, SUPINF_1, LOPBAN_1, NDIFF_1;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, ORDINAL1, NUMBERS,
      XREAL_0, NAT_1, CARD_1, CARD_3, MEMBERED, STRUCT_0, RLVECT_1,
      RLVECT_5, NORMSP_1, PRE_TOPC, TOPS_1, COMPTS_1, MEASURE1,
      MEASURE3, MEASURE4, MEASURE8, XXREAL_3, REAL_NS1, REAL_NS2;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, RLVECT_1;
 equalities XBOOLE_0, SUBSET_1, STRUCT_0, ALGSTR_0, RLVECT_1,
      NORMSP_0;
 expansions TARSKI, XBOOLE_0, RLVECT_1;

begin

::$P-
theorem
  for E,F being finite-dimensional RealNormSpace,
      Sigma being SigmaField of the carrier of E,
      M being sigma_Measure of Sigma,
      s being Subset of E,
      f being Function of the carrier of E,the carrier of F,
      C being Real st
    0 <= C &
    Sigma = BorelSets(TopSpaceNorm E) &
    (for a being Point of E, A,B being Element of Sigma st
      B = {z where z is Point of E :
        ex y being Point of E st y in A & z = a + y}
      holds M.B = M.A) &
    (for K being compact Subset of TopSpaceNorm E,
         A being Element of Sigma st K = A holds M.A < +infty) &
    (for U being open Subset of TopSpaceNorm E,
         A being Element of Sigma st U = A & U <> {} holds 0. < M.A) &
    s in Sigma &
    (for x,y being Point of E st x in s & y in s holds
      ||.f.x - f.y.|| <= C * ||.x-y.||)
  holds
    ex N being Element of Sigma st
      M.N = 0. &
      for x being Point of E st x in s & not x in N holds
        ex L being Point of
          R_NormSpace_of_BoundedLinearOperators(E,F) st
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st
              0 < delta &
              for y being Point of E st
                y in s & ||.y-x.|| < delta
              holds
                ||.(f.y - f.x) -
                  (modetrans(L,E,F)).(y-x).||
                  <= epsilon * ||.y-x.||
proof
end;
::$P+
