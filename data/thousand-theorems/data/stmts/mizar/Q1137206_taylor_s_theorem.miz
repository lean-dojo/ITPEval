:: Statement-only formalization of thousand-theorems corpus artifact Q1137206,
:: "Taylor's theorem": the Lagrange and Cauchy remainder formulas for the
:: degree-n Taylor polynomial, using derivatives relative to a closed interval.
:: This file contains no proof.

environ

  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    PARTFUN1, NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, XXREAL_1,
    XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, NAT_1, INT_1, VALUED_0,
    VALUED_1, ORDINAL1, ORDINAL2, CARD_3, FINSEQ_1, FINSEQ_2, RVSUM_1,
    NEWTON, REALSET1, PREPOWER, SEQ_1, SEQ_2, SEQ_4, RCOMP_1, FCONT_1, FDIFF_1,
    FDIFF_3, FDIFF_12, TAYLOR_1, SUPINF_2, MEASURE1, MEASURE5,
    MESFUNC1, MESFUNC5,
    MEASUR12, INTEGRA1, INTEGRA5, INTEGRA7;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, XXREAL_1, XXREAL_2, XXREAL_3,
    NAT_1, NAT_D, VALUED_0, VALUED_1, NEWTON, FINSEQ_1, FINSEQ_2,
    RVSUM_1, PREPOWER, SEQ_1, SEQ_2, COMSEQ_2, SEQM_3, SEQ_4,
    PARTFUN2, RCOMP_1, FCONT_1, FDIFF_1, FDIFF_3, TAYLOR_1,
    SUPINF_2, MEASURE1, MEASURE5,
    MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA1, INTEGRA5,
    INTEGRA7, EXTREAL1, FDIFF_12;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, NEWTON, FINSEQOP, RVSUM_1,
    PREPOWER, SEQ_2, SEQM_3, SEQ_4, COMSEQ_2, PARTFUN2, RCOMP_1,
    RFUNCT_2, FCONT_1, FDIFF_1, FDIFF_3, FDIFF_12, TAYLOR_1,
    MEASURE5, MEASURE6,
    MESFUNC1, MESFUNC5, MESFUNC6, MEASUR12, INTEGRA2, INTEGRA5,
    INTEGRA7, EXTREAL1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0,
    VALUED_1, XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON,
    FINSEQ_1, FINSEQ_2, RVSUM_1, SEQ_4, RCOMP_1, FCONT_1, FDIFF_1,
    XXREAL_3, MEASURE1, MEASURE5, MEASUR12, INTEGRA1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0, TAYLOR_1;
  equalities INTEGRA5, VALUED_1, SUBSET_1;
  expansions TARSKI, XBOOLE_0, RELAT_1, FCONT_1, TAYLOR_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL,
      D being Function of NAT,Funcs(REAL,REAL),
      I being non empty Interval,
      x,x0 being Real,
      n being Nat st
    x0 < x &
    I = ['x0,x'] &
    (for D0 being Function of REAL,REAL st D0 = D.0 holds D0 = f) &
    (for i being Nat,
         Di being Function of REAL,REAL st
       i <= n & Di = D.i
     holds Di|I is continuous) &
    (for i being Nat,
         Di,Di1 being Function of REAL,REAL st
       i < n & Di = D.i & Di1 = D.(i+1)
     holds
       Di is_differentiable_on_interval I &
       for t being Real st t in I holds
         Di1.t = (Di`\I).t) &
    (for Dn,Dn1 being Function of REAL,REAL st
       Dn = D.n & Dn1 = D.(n+1)
     holds
       Dn is_differentiable_on ].x0,x.[ &
       for t being Real st t in ].x0,x.[ holds
         Dn1.t = diff(Dn,t))
  holds
    ex terms being FinSequence of REAL,
       c being Real,
       Dn1 being Function of REAL,REAL st
      len terms = n+1 &
      (for k being Nat st k <= n holds
        ex Dk being Function of REAL,REAL st
          Dk = D.k &
          terms.(k+1) =
            Dk.x0 * ((x-x0) |^ k) / ((k !) qua Real)) &
      Dn1 = D.(n+1) &
      c in ].x0,x.[ &
      f.x - Sum terms =
        Dn1.c * ((x-x0) |^ (n+1)) /
          (((n+1) !) qua Real)
proof
end;
::$P+

::$P-
theorem
  for f being Function of REAL,REAL,
      D being Function of NAT,Funcs(REAL,REAL),
      I being non empty Interval,
      x,x0 being Real,
      n being Nat st
    x0 < x &
    I = ['x0,x'] &
    (for D0 being Function of REAL,REAL st D0 = D.0 holds D0 = f) &
    (for i being Nat,
         Di being Function of REAL,REAL st
       i <= n & Di = D.i
     holds Di|I is continuous) &
    (for i being Nat,
         Di,Di1 being Function of REAL,REAL st
       i < n & Di = D.i & Di1 = D.(i+1)
     holds
       Di is_differentiable_on_interval I &
       for t being Real st t in I holds
         Di1.t = (Di`\I).t) &
    (for Dn,Dn1 being Function of REAL,REAL st
       Dn = D.n & Dn1 = D.(n+1)
     holds
       Dn is_differentiable_on ].x0,x.[ &
       for t being Real st t in ].x0,x.[ holds
         Dn1.t = diff(Dn,t))
  holds
    ex terms being FinSequence of REAL,
       c being Real,
       Dn1 being Function of REAL,REAL st
      len terms = n+1 &
      (for k being Nat st k <= n holds
        ex Dk being Function of REAL,REAL st
          Dk = D.k &
          terms.(k+1) =
            Dk.x0 * ((x-x0) |^ k) / ((k !) qua Real)) &
      Dn1 = D.(n+1) &
      c in ].x0,x.[ &
      f.x - Sum terms =
        Dn1.c * ((x-c) |^ n) /
          ((n !) qua Real) * (x-x0)
proof
end;
::$P+
