:: Statement-only formalization of thousand-theorems corpus artifact Q3527219,
:: "Weierstrass preparation theorem": over a local commutative ring complete
:: and separated for its maximal-ideal adic topology, every formal power
:: series nonzero modulo the maximal ideal is a distinguished polynomial
:: times a unit formal power series. This file contains no proof.

environ

 vocabularies NUMBERS, STRUCT_0, ALGSTR_0, VECTSP_1, FUNCSDOM, BINOP_1,
      SUBSET_1, FUNCT_1, ZFMISC_1, XBOOLE_0, CARD_1, FUNCOP_1, RELAT_1,
      GROUP_1, LATTICES, MESFUNC1, NAT_1, ARYTM_3, SUPINF_2, POLYNOM3,
      RLVECT_1, ARYTM_1, ALGSTR_1, FINSEQ_1, PARTFUN1, CARD_3, REALSET1,
      TARSKI, UNIALG_2, RLSUB_1, SETFAM_1, POLYNOM1, ALGSEQ_1, POLYALG1,
      IDEAL_1, IDEAL_2, TOPZARI1, RING_1, RING_2, VECTSP_2, XXREAL_0,
      ORDINAL4;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, ORDINAL1,
      NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, REALSET1, STRUCT_0, ALGSTR_0,
      RELAT_1, FUNCT_1, PARTFUN1, FUNCT_2, FUNCOP_1, FINSEQ_1, BINOP_1,
      NAT_1, NAT_D, WSIERP_1, GROUP_1, RLVECT_1, VFUNCT_1, VECTSP_1,
      VECTSP_2,
      NORMSP_1, POLYNOM1, ALGSTR_1, ALGSEQ_1, POLYNOM3, POLYNOM5,
      VECTSP_4, IDEAL_1, RING_1, RING_2, TOPZARI1, IDEAL_2, POLYALG1;
 constructors BINOP_1, REALSET1, RFINSEQ, NAT_D, ALGSTR_1, VECTSP_4,
      POLYNOM3, POLYNOM5, REAL_1, RELSET_1, FUNCOP_1, FVSUM_1, VFUNCT_1,
      WSIERP_1, POLYALG1, RINGCAT1, MOD_4, IDEAL_2;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, XREAL_0, NAT_1, REALSET1,
      STRUCT_0, VECTSP_1, FVSUM_1, POLYNOM3, POLYNOM5, BINOM, ORDINAL1,
      VFUNCT_1, FUNCT_2, RELAT_1, ALGSTR_0, ALGSTR_1, RLVECT_1, IDEAL_1,
      RING_1, RING_2, VECTSP_2, TOPZARI1, POLYALG1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, RLVECT_1, GROUP_1, VECTSP_1, ALGSTR_0, IDEAL_1;
 equalities VECTSP_1, BINOP_1, REALSET1, STRUCT_0, ALGSTR_0;
 expansions TARSKI, VECTSP_1, TOPZARI1;

begin

::$P-
theorem
  for R being non degenerated commutative Ring,
      m being non empty Subset of R,
      pows being Function of NAT,bool the carrier of R,
      G being Element of Formal-Series R,
      g being sequence of R
  st
    G = g &
    R is local & m in m-Spectrum R &
    pows.0 = the carrier of R &
    (for n being Nat holds
       ex q being Subset of R st
         q = pows.n & pows.(n + 1) = m *' q) &
    (for a being Element of R st
       for n being Nat holds a in pows.n
     holds a = 0.R) &
    (for s being sequence of R st
       for i,j being Nat st i <= j
       holds
         ex x,y being Element of R st
           x = s.i & y = s.j & x - y in pows.i
     holds
       ex a being Element of R st
         for n being Nat holds
           ex x being Element of R st
             x = s.n & x - a in pows.n) &
    (ex n being Nat st not g.n in m)
  holds
    ex f being Polynomial of R st
      ex F,H,U being Element of Formal-Series R st
        ex d being Nat st
          F = f &
          f.d = 1.R &
          (for i being Nat st d < i
           holds f.i = 0.R) &
          (for i being Nat st i < d
           holds f.i in m) &
          H * U = 1.(Formal-Series R) &
          G = F * H
proof
end;
::$P+
