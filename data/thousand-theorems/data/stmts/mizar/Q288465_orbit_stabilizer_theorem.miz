:: Statement-only formalization of thousand-theorems corpus artifact Q288465,
:: "Orbit-stabilizer theorem": for a group acting on an arbitrary nonempty set,
:: the orbit of a point is equipotent to the left cosets of its stabilizer.
:: This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, SUBSET_1, BINOP_1,
      ORDINAL4, GROUP_1, GROUP_2, GROUP_3, GROUP_10, ALGSTR_0, STRUCT_0,
      CARD_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, STRUCT_0, ALGSTR_0, GROUP_1, GROUP_2, GROUP_3, GROUP_10;
 constructors RELSET_1, GROUP_10;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, STRUCT_0,
      GROUP_1, GROUP_2, GROUP_3, FUNCT_2, GROUP_10;
 requirements SUBSET, BOOLE;
 definitions GROUP_10;
 equalities STRUCT_0, ALGSTR_0;
 expansions STRUCT_0, GROUP_10;

begin

::$P-
theorem
  for G being Group,
      E being non empty set,
      T being LeftOperation of G,E,
      a being Element of E
  holds the_orbit_of(a,T),
        Left_Cosets the_strict_stabilizer_of(a,T) are_equipotent
proof
end;
::$P+
