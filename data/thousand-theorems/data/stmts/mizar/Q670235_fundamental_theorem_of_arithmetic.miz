:: Statement-only formalization of Thousand Theorems artifact Q670235
:: (thousand-theorems__mizar__Q670235), "Fundamental theorem of arithmetic":
:: every prime's multiplicity in a finite prime-factor sequence is its
:: prime-adic multiplicity in the sequence's product. This file contains no
:: proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, INT_1, INT_2, ARYTM_1, ARYTM_3, CARD_3, REALSET1,
    VALUED_0, VALUED_1, CLASSES1, NAT_3, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, INT_2, RELAT_1, FUNCT_1,
    FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D, NAT_3, CLASSES1;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    INT_2, NAT_3, CLASSES1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, VALUED_0, VALUED_1, CARD_1, NAT_3;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat, factors being FinSequence of NAT st
    Product factors = n &
    (for i being Nat st i in dom factors holds factors.i is prime)
  holds
    for p being Prime holds
      card Coim(factors,p) = p |-count n
proof
end;
::$P+
