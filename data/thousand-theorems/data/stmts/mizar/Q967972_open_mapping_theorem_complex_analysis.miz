:: Statement-only formalization of thousand-theorems corpus artifact Q967972
:: (thousand-theorems__mizar__Q967972), "Open mapping theorem (complex
:: analysis)": an analytic complex-valued map on a preconnected subset of a
:: complex normed space is constant there or maps every ambient-open subset
:: of that set to an open subset of the complex plane. This file contains no
:: proof.

environ

 vocabularies NUMBERS, XBOOLE_0, FUNCT_1, ZFMISC_1, XCMPLX_0, FUNCOP_1,
      SUBSET_1, FUNCT_2, RELAT_1, PARTFUN1, CLVECT_1, STRUCT_0, RLVECT_1,
      LOPBAN_1, SUPINF_2, ARYTM_3, ARYTM_1, COMPLEX1, ALGSTR_0, MONOID_0,
      TARSKI, MSSUBFAM, UNIALG_1, RLSUB_1, RSSPACE, NAT_1, PRE_TOPC, SEQ_2,
      ORDINAL2, NORMSP_1, XXREAL_0, CARD_1, REAL_1, XXREAL_2, SEQ_4,
      REWRITE1, RSSPACE3, SEQ_1, VALUED_1, CLOPBAN1, METRIC_1, RELAT_2,
      FCONT_1, ASYMPT_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      PARTFUN1, FUNCT_2, FUNCT_3, PRE_TOPC, DOMAIN_1, FUNCOP_1, BINOP_1,
      XCMPLX_0, XXREAL_0, XXREAL_2, XREAL_0, COMPLEX1, REAL_1, ORDINAL1,
      NAT_1, STRUCT_0, ALGSTR_0, MONOID_0, NUMBERS, RLVECT_1, NORMSP_0,
      NORMSP_1, VALUED_1, SEQ_1, SEQ_2, SEQ_4, FUNCSDOM, CLVECT_1,
      CSSPACE, CSSPACE3, LOPBAN_1, VECTSP_1, CLOPBAN1;
 constructors DOMAIN_1, REAL_1, COMPLEX1, FUNCSDOM, MONOID_0, LOPBAN_1,
      CSSPACE3, SEQ_4, RELSET_1, BINOP_2, SEQ_2, COMSEQ_2, FUNCT_3,
      SEQ_1, CLOPBAN1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, MEMBERED, STRUCT_0, MONOID_0, CLVECT_1,
      CSSPACE3, VALUED_1, VALUED_0, SEQ_4, FUNCT_1, NAT_1, SEQ_1, SEQ_2,
      CLOPBAN1;
 requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
 definitions FUNCT_1, ALGSTR_0, VECTSP_1, XXREAL_2;
 equalities BINOP_1, STRUCT_0, ALGSTR_0, NORMSP_0;
 expansions FUNCT_1, BINOP_1, NORMSP_0;

begin

::$P-
theorem
  for E being ComplexNormSpace,
      U being Subset of E,
      g being Function of the carrier of E,COMPLEX st
    (for x being Point of E st x in U holds
      ex radius being Real st
        0 < radius &
        for z being Point of E st ||.z-x.|| < radius holds
          ex L being Function of the carrier of E,COMPLEX st
            (for u,v being Point of E holds
              L.(u+v) = L.u + L.v) &
            (for a being Complex, u being Point of E holds
              L.(a*u) = a*L.u) &
            (ex C being Real st
              0 <= C &
              for u being Point of E holds
                |.L.u.| <= C*||.u.||) &
            for epsilon being Real st 0 < epsilon holds
              ex delta being Real st
                0 < delta &
                for h being Point of E st
                  h <> 0.E & ||.h.|| < delta
                holds
                  |.g.(z+h) - g.z - L.h.| < epsilon*||.h.||) &
    not ex A,B being Subset of E st
      A c= U & B c= U & U = A \/ B & A misses B &
      A <> {} & B <> {} &
      (for x being Point of E st x in A holds
        ex radius being Real st
          0 < radius &
          for y being Point of E st
            y in U & ||.y-x.|| < radius
          holds
            y in A) &
      (for x being Point of E st x in B holds
        ex radius being Real st
          0 < radius &
          for y being Point of E st
            y in U & ||.y-x.|| < radius
          holds
            y in B)
  holds
    (ex w being Complex st
      for z being Point of E st z in U holds g.z = w)
    or
    for s being Subset of E st
      s c= U &
      (for x being Point of E st x in s holds
        ex radius being Real st
          0 < radius &
          for y being Point of E st ||.y-x.|| < radius holds
            y in s)
    holds
      for y being Complex st y in g.:s holds
        ex radius being Real st
          0 < radius &
          for v being Complex st |.v-y.| < radius holds
            v in g.:s
proof
end;
::$P+
