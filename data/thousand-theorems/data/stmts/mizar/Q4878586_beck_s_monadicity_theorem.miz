:: Statement-only formalization of thousand-theorems corpus artifact Q4878586,
:: "Beck's monadicity theorem": a right adjoint creating coequalizers of all
:: pairs whose image admits a split coequalizer has an Eilenberg--Moore
:: comparison functor that is an equivalence of categories.
:: This file contains no proof.

environ

 vocabularies XBOOLE_0, SUBSET_1, TARSKI, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ZFMISC_1, MCART_1, STRUCT_0, GRAPH_1, CAT_1, CAT_3,
      NATTRA_1, ISOCAT_1, PUA2MSS1, REWRITE1, GROEB_2;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
      PARTFUN1, FUNCT_1, FUNCT_2, STRUCT_0, GRAPH_1, CAT_1, CAT_2, CAT_3,
      NATTRA_1, ISOCAT_1;
 constructors RELSET_1, FUNCT_2, CAT_1, CAT_2, CAT_3, NATTRA_1, ISOCAT_1;
 registrations XBOOLE_0, RELSET_1, FUNCT_1, FUNCT_2, STRUCT_0, CAT_1;
 requirements SUBSET, BOOLE;
 definitions CAT_1, NATTRA_1, ISOCAT_1;
 equalities CAT_1;
 expansions CAT_1, NATTRA_1;

begin

definition
  let C,D be Category;
  let F be Functor of C,D;
  let G be Functor of D,C;
  let Eta be Function of the carrier of C,the carrier' of C;
  let Eps be Function of the carrier of D,the carrier' of D;
  :: The following overload says that Eta and Eps are the unit and counit
  :: exhibiting F as a left adjoint of G.
  pred Eta,Eps form_morphism_between F,G means
    (for X being Object of C holds Eta.X in Hom(X,G.(F.X))) &
    (for A being Object of D holds Eps.A in Hom(F.(G.A),A)) &
    (for X,Y being Object of C, f being Morphism of X,Y st
      Hom(X,Y) <> {}
    holds
      for etaX being Morphism of X,G.(F.X),
          etaY being Morphism of Y,G.(F.Y) st
        etaX = Eta.X & etaY = Eta.Y
      holds (G/.(F/.f))*etaX = etaY*f) &
    (for A,B being Object of D, f being Morphism of A,B st
      Hom(A,B) <> {}
    holds
      for epsA being Morphism of F.(G.A),A,
          epsB being Morphism of F.(G.B),B st
        epsA = Eps.A & epsB = Eps.B
      holds f*epsA = epsB*(F/.(G/.f))) &
    (for X being Object of C holds
      for etaX being Morphism of X,G.(F.X),
          epsFX being Morphism of F.(G.(F.X)),F.X st
        etaX = Eta.X & epsFX = Eps.(F.X)
      holds epsFX*(F/.etaX) = id(F.X)) &
    for A being Object of D holds
      for epsA being Morphism of F.(G.A),A,
          etaGA being Morphism of G.A,G.(F.(G.A)) st
        epsA = Eps.A & etaGA = Eta.(G.A)
      holds (G/.epsA)*etaGA = id(G.A);
end;

definition
  let C be Category;
  let A,B,P be Object of C;
  let f,g be Morphism of A,B;
  let p be Morphism of B,P;
  :: This overload is the universal property of a coequalizer arrow.
  pred p is_a_product_wrt f,g means
    Hom(A,B) <> {} & Hom(B,P) <> {} & p*f = p*g &
    for Z being Object of C, h being Morphism of B,Z st
      Hom(B,Z) <> {} & h*f = h*g
    holds ex u being Morphism of P,Z st
      Hom(P,Z) <> {} & u*p = h &
      for v being Morphism of P,Z st
        Hom(P,Z) <> {} & v*p = h
      holds v = u;
end;

definition
  let C,D be Category;
  let G be Functor of D,C;
  let A,B be Object of D;
  let f,g be Morphism of A,B;
  :: This overload says that the image parallel pair is split.
  pred f,g are_convertible_wrt G means
    Hom(A,B) <> {} &
    ex P being Object of C,
       p being Morphism of G.B,P,
       r being Morphism of P,G.B,
       s being Morphism of G.B,G.A st
      Hom(G.B,P) <> {} & Hom(P,G.B) <> {} & Hom(G.B,G.A) <> {} &
      p*(G/.f) = p*(G/.g) & p*r = id P &
      (G/.g)*s = id(G.B) & (G/.f)*s = r*p;
end;

definition
  let C,D be Category;
  let G be Functor of D,C;
  :: This overload is creation by lifting coequalizer cocones up to
  :: isomorphism and reflecting every mapped coequalizer.
  pred G is_a_product_wrt D,C means
    for A,B being Object of D, f,g being Morphism of A,B st
      f,g are_convertible_wrt G
    holds
      (for Q being Object of D, q being Morphism of B,Q st
        Hom(B,Q) <> {} & q*f = q*g &
        G/.q is_a_product_wrt G/.f,G/.g
      holds q is_a_product_wrt f,g) &
      for P being Object of C, p being Morphism of G.B,P st
        p is_a_product_wrt G/.f,G/.g
      holds
        ex Q being Object of D,
           q being Morphism of B,Q,
           i being Morphism of G.Q,P,
           j being Morphism of P,G.Q st
          q is_a_product_wrt f,g &
          G/.q is_a_product_wrt G/.f,G/.g &
          Hom(G.Q,P) <> {} & Hom(P,G.Q) <> {} &
          i*j = id P & j*i = id(G.Q) & i*(G/.q) = p;
end;

definition
  let C,D be Category;
  let F be Functor of C,D;
  let G be Functor of D,C;
  let Eta be Function of the carrier of C,the carrier' of C;
  let Eps be Function of the carrier of D,the carrier' of D;
  let X be Object of C;
  let a be Morphism of G.(F.X),X;
  :: This overload is the unit and multiplication law for an algebra over
  :: the monad induced by the displayed adjunction.
  pred a is_Standard_Representation_of F,G,Eta,Eps means
    Hom(G.(F.X),X) <> {} &
    for etaX being Morphism of X,G.(F.X),
        epsFX being Morphism of F.(G.(F.X)),F.X st
      etaX = Eta.X & epsFX = Eps.(F.X)
    holds
      a*etaX = id X &
      a*(G/.(F/.a)) = a*(G/.epsFX);
end;

definition
  let C,D be Category;
  let F be Functor of C,D;
  let G be Functor of D,C;
  let Eta be Function of the carrier of C,the carrier' of C;
  let Eps be Function of the carrier of D,the carrier' of D;
  let X,Y be Object of C;
  let a be Morphism of G.(F.X),X;
  let b be Morphism of G.(F.Y),Y;
  let f be Morphism of X,Y;
  :: This overload is the homomorphism equation between two such algebras.
  pred f is_Standard_Representation_of a,b,Eta,Eps means
    a is_Standard_Representation_of F,G,Eta,Eps &
    b is_Standard_Representation_of F,G,Eta,Eps &
    Hom(X,Y) <> {} &
    f*a = b*(G/.(F/.f));
end;

definition
  let C,D be Category;
  let F be Functor of C,D;
  let G be Functor of D,C;
  let Eta be Function of the carrier of C,the carrier' of C;
  let Eps be Function of the carrier of D,the carrier' of D;
  let EM be Category;
  :: This overload specifies the Eilenberg--Moore category exactly, including
  :: its objects, arrows, identities, domains, codomains, and composition.
  pred EM is_Standard_Representation_of F,G,Eta,Eps means
    (for O being object holds
      O in the carrier of EM iff
      ex X being Object of C,
         a being Morphism of G.(F.X),X st
        O = [X,a] & a is_Standard_Representation_of F,G,Eta,Eps) &
    (for m being object holds
      m in the carrier' of EM iff
      ex X,Y being Object of C,
         a being Morphism of G.(F.X),X,
         b being Morphism of G.(F.Y),Y,
         f being Morphism of X,Y st
        m = [[X,a],[[Y,b],f]] &
        f is_Standard_Representation_of a,b,Eta,Eps) &
    (for X being Object of C,
         a being Morphism of G.(F.X),X,
         O being Object of EM st
      a is_Standard_Representation_of F,G,Eta,Eps & O = [X,a]
    holds id O = [[X,a],[[X,a],id X]]) &
    (for X,Y being Object of C,
         a being Morphism of G.(F.X),X,
         b being Morphism of G.(F.Y),Y,
         f being Morphism of X,Y,
         m being Morphism of EM st
      f is_Standard_Representation_of a,b,Eta,Eps &
      m = [[X,a],[[Y,b],f]]
    holds dom m = [X,a] & cod m = [Y,b]) &
    for X,Y,Z being Object of C,
        a being Morphism of G.(F.X),X,
        b being Morphism of G.(F.Y),Y,
        c being Morphism of G.(F.Z),Z,
        f being Morphism of X,Y,
        g being Morphism of Y,Z,
        m,n being Morphism of EM st
      f is_Standard_Representation_of a,b,Eta,Eps &
      g is_Standard_Representation_of b,c,Eta,Eps &
      m = [[X,a],[[Y,b],f]] & n = [[Y,b],[[Z,c],g]]
    holds
      [n,m] in dom(the Comp of EM) &
      (the Comp of EM).[n,m] = [[X,a],[[Z,c],g*f]];
end;

definition
  let C,D be Category;
  let F be Functor of C,D;
  let G be Functor of D,C;
  let Eta be Function of the carrier of C,the carrier' of C;
  let Eps be Function of the carrier of D,the carrier' of D;
  let EM be Category;
  let K be Functor of D,EM;
  :: This overload fixes the comparison functor on every object and arrow.
  pred K is_Standard_Representation_of F,G,Eta,Eps means
    (for A being Object of D holds
      for epsA being Morphism of F.(G.A),A st epsA = Eps.A
      holds K.A = [G.A,G/.epsA]) &
    for A,B being Object of D, f being Morphism of A,B st
      Hom(A,B) <> {}
    holds
      for epsA being Morphism of F.(G.A),A,
          epsB being Morphism of F.(G.B),B st
        epsA = Eps.A & epsB = Eps.B
      holds K/.f = [[G.A,G/.epsA],[[G.B,G/.epsB],G/.f]];
end;

::$P-
theorem
  for C,D being Category,
      F being Functor of C,D,
      G being Functor of D,C,
      Eta being Function of the carrier of C,the carrier' of C,
      Eps being Function of the carrier of D,the carrier' of D st
    Eta,Eps form_morphism_between F,G &
    G is_a_product_wrt D,C
  holds
    ex EM being Category, K being Functor of D,EM st
      EM is_Standard_Representation_of F,G,Eta,Eps &
      K is_Standard_Representation_of F,G,Eta,Eps &
      ex L being Functor of EM,D st
        L*K ~= id D & K*L ~= id EM
proof
end;
::$P+
