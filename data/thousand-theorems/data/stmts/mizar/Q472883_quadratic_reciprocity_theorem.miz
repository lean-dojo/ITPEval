:: Statement-only formalization of Thousand Theorems artifact Q472883,
:: "Quadratic reciprocity theorem": the Legendre symbols of two distinct odd
:: primes and the Jacobi symbols of two odd natural numbers satisfy their
:: quadratic reciprocity sign formulas. This file contains no proof.

environ

 vocabularies NUMBERS, ORDINAL1, CARD_1, XXREAL_0, RELAT_1, ARYTM_3, NEWTON,
      INT_1, SUBSET_1, ARYTM_1, ABIAN, TARSKI, XBOOLE_0, INT_2, NAT_1, EC_PF_2,
      INT_7, INT_5, INT_3, PEPIN, SQUARE_1, ZFMISC_1, GRAPH_1, GROUP_1,
      ALGSTR_0, FUNCT_7, FUNCT_1, BINOP_2, XCMPLX_0, REAL_1, NAT_6, NAT_3,
      FINSEQ_1,
      FINSEQ_2, VALUED_0, PRE_POLY, PBOOLE, FINSET_1, CARD_3, ORDINAL4,
      UPROOTS, FUNCT_2, SETWISEO, FUNCOP_1;
 notations SUBSET_1, TARSKI, XBOOLE_0, ORDINAL1, STRUCT_0, NUMBERS, CARD_1,
      XCMPLX_0, XREAL_0, ALGSTR_0, GR_CY_1, INT_5, INT_1, ABIAN, SQUARE_1,
      GROUP_1, PEPIN, NAT_3, BINOP_1, MEMBERED, INT_2, INT_3, EC_PF_2, INT_7,
      NAT_D, XXREAL_0, NEWTON, FINSET_1, RELAT_1, FUNCT_1, FUNCT_2, FINSEQ_1,
      FINSEQ_2, VALUED_0, PBOOLE, RVSUM_1, FUNCOP_1, PRE_POLY;
 constructors REAL_1, NAT_D, POWER, DOMAIN_1, ABIAN, PEPIN, NAT_3, NUMBERS,
      NAT_4, NEWTON, EC_PF_2, SUBSET_1, ALGSTR_0, INT_5, INT_7, XXREAL_0,
      GROUP_1, GR_CY_1, BINOP_2, RELSET_1, XTUPLE_0, BINOP_1, INT_3,
      SETWISEO, FINSEQOP, FINSOP_1, PRE_POLY;
 registrations ORDINAL1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, MEMBERED,
      NEWTON, NAT_2, NAT_3, SQUARE_1, INT_7, ABIAN, STRUCT_0, WSIERP_1,
      INT_2, XBOOLE_0, RELAT_1, FUNCT_1, FINSET_1, NUMBERS, BINOP_2,
      VALUED_0, FINSEQ_1, CARD_1, FUNCT_2, RELSET_1, ZFMISC_1, FINSEQ_2,
      PRE_POLY, RVSUM_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
 equalities INT_1, SQUARE_1;
 expansions NAT_2, INT_1, INT_2, EC_PF_2, MEMBERED, ABIAN;
 theorems ABIAN, INT_1, INT_2, NAT_1, NAT_2, NEWTON, XREAL_1, XCMPLX_0,
      XCMPLX_1, XXREAL_0, NAT_4, ORDINAL1, PEPIN, SQUARE_1, EC_PF_2, INT_3,
      XBOOLE_0, NAT_D, INT_5, INT_7, GROUP_1, GR_CY_1, EULER_1, ALGSTR_0,
      TARSKI, NAGATA_2;
 schemes NAT_1;

begin

::$P-
theorem
  for p, q being Prime st
    p <> 2 & q <> 2 & p <> q
  holds Lege(q,p) * Lege(p,q) =
    (-1) |^ ((p div 2) * (q div 2))
proof
end;
::$P+

::$P-
theorem
  for a, b being odd Nat holds
    ex f, g being FinSequence of INT st
      len f = len canFS(support (pfexp b)) &
      len g = len canFS(support (pfexp a)) &
      (for i being Nat st i in dom f holds
        ex r being Prime st
          r = (canFS(support (pfexp b))).i &
          f.i = Lege(a,r) |^ ((pfexp b).r)) &
      (for i being Nat st i in dom g holds
        ex r being Prime st
          r = (canFS(support (pfexp a))).i &
          g.i = Lege(b,r) |^ ((pfexp a).r)) &
      Product f =
        (-1) |^ ((a div 2) * (b div 2)) * Product g
proof
end;
::$P+
