:: Statement-only formalization of thousand-theorems corpus artifact Q1057919,
:: "Sylow theorems": existence, conjugacy, index divisibility, and the
:: congruence for maximal p-subgroups. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, STRUCT_0, GROUP_9, SUBSET_1, ORDINAL4,
      FUNCT_1, RELAT_1, TARSKI, GROUP_1, ALGSTR_0, ZFMISC_1, FUNCT_2, BINOP_1,
      SETFAM_1, CARD_1, FINSET_1, ORDINAL1, CARD_FIN, GROUP_2, EQREL_1, INT_2,
      NEWTON, INT_1, XXREAL_0, ARYTM_3, FINSEQ_1, NAT_1, PARTFUN1, CQC_SIM1,
      CARD_3, FUNCOP_1, FINSEQ_2, NAT_3, GR_CY_1, BINOP_2, XCMPLX_0, ARYTM_1,
      RLSUB_1, GROUP_4, GRAPH_1, GROUP_3, REALSET1, GROUP_10, REAL_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, CARD_1, ORDINAL1, NUMBERS,
      XCMPLX_0, ZFMISC_1, XXREAL_0, XREAL_0, INT_2, NAT_1, NAT_D, FINSET_1,
      RELAT_1, REALSET1, FUNCT_1, RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
      RVSUM_1, STRUCT_0, ALGSTR_0, GROUP_1, GROUP_2, GROUP_3, EQREL_1,
      FUNCOP_1, WSIERP_1, NEWTON, DOMAIN_1, GR_CY_1, GROUP_4, CARD_FIN,
      PARTFUN1, NAT_3, TOPGRP_1;
 constructors WELLORD2, NAT_D, BINARITH, WSIERP_1, REALSET2, GR_CY_1, GROUP_4,
      CARD_FIN, NAT_3, TOPGRP_1, RELSET_1;
 registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, RELSET_1, FINSET_1,
      XXREAL_0, XREAL_0, NAT_1, INT_1, CARD_1, FINSEQ_1, NEWTON, STRUCT_0,
      GROUP_2, GROUP_1, GROUP_3, GR_CY_1, FUNCT_2, NAT_3, REALSET1, VALUED_0;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, WELLORD2, FUNCT_2;
 equalities GROUP_2, REALSET1, RELAT_1, STRUCT_0, ORDINAL1;
 expansions GROUP_2, TARSKI, WELLORD2, STRUCT_0, FUNCT_2;
 theorems FINSEQ_1, GROUP_2, GROUP_3, TARSKI, GROUP_6, FINSEQ_2, FUNCT_1,
      FUNCT_2, RELAT_1, XBOOLE_0, XBOOLE_1, NAT_1, GROUP_1, XREAL_1, RELSET_1,
      PARTFUN1, FINSEQ_3, INT_1, ZFMISC_1, CARD_1, CARD_2, FINSET_1, XCMPLX_1,
      ORDINAL1, FINSEQ_4, XXREAL_0, NAT_D, GR_CY_1, NEWTON, CARD_FIN, WEDDWITT,
      WELLORD2, EQREL_1, FUNCOP_1, RVSUM_1, PEPIN, NAT_4, GROUP_8, NAT_3,
      GROUP_9, GR_CY_2, TOPGRP_1, VALUED_1, XREAL_0, XTUPLE_0;
 schemes FUNCT_1, FINSEQ_1, NAT_1, FUNCT_2, SUBSET_1, CLASSES1;

begin

::$P-
theorem
  for G being finite Group, p being Prime, n being Nat st
    p |^ n divides card G
  holds ex K being strict Subgroup of G st
    card K = p |^ n
proof
end;
::$P+

::$P-
theorem
  for G being Group, p being Prime, S being finite set st
    S = {H where H is Element of Subgroups G:
      ex P being strict Subgroup of G st
        P = H &
        (for x being Element of P holds
          ex n being Nat st x |^ (p |^ n) = 1_P) &
        for Q being strict Subgroup of G st
          (for y being Element of Q holds
            ex m being Nat st y |^ (p |^ m) = 1_Q) &
          P is Subgroup of Q
        holds P = Q}
  holds
    for P1,P2 being strict Subgroup of G st
      ((for x being Element of P1 holds
          ex n being Nat st x |^ (p |^ n) = 1_P1) &
        for Q being strict Subgroup of G st
          (for y being Element of Q holds
            ex m being Nat st y |^ (p |^ m) = 1_Q) &
          P1 is Subgroup of Q
        holds P1 = Q) &
      ((for x being Element of P2 holds
          ex n being Nat st x |^ (p |^ n) = 1_P2) &
        for Q being strict Subgroup of G st
          (for y being Element of Q holds
            ex m being Nat st y |^ (p |^ m) = 1_Q) &
          P2 is Subgroup of Q
        holds P2 = Q)
    holds P1,P2 are_conjugated
proof
end;
::$P+

::$P-
theorem
  for G being Group, p being Prime, S being finite set st
    S = {H where H is Element of Subgroups G:
      ex Q being strict Subgroup of G st
        Q = H &
        (for x being Element of Q holds
          ex n being Nat st x |^ (p |^ n) = 1_Q) &
        for R being strict Subgroup of G st
          (for y being Element of R holds
            ex m being Nat st y |^ (p |^ m) = 1_R) &
          Q is Subgroup of R
        holds Q = R}
  holds
    for P being strict Subgroup of G st
      (for x being Element of P holds
        ex n being Nat st x |^ (p |^ n) = 1_P) &
      for Q being strict Subgroup of G st
        (for y being Element of Q holds
          ex m being Nat st y |^ (p |^ m) = 1_Q) &
        P is Subgroup of Q
      holds P = Q
    holds
      (Left_Cosets P is finite implies
        for C being finite set st C = Left_Cosets P holds
          card S divides card C) &
      (not Left_Cosets P is finite implies card S divides 0)
proof
end;
::$P+

::$P-
theorem
  for G being Group, p being Prime, S being finite set st
    S = {H where H is Element of Subgroups G:
      ex P being strict Subgroup of G st
        P = H &
        (for x being Element of P holds
          ex n being Nat st x |^ (p |^ n) = 1_P) &
        for Q being strict Subgroup of G st
          (for y being Element of Q holds
            ex m being Nat st y |^ (p |^ m) = 1_Q) &
          P is Subgroup of Q
        holds P = Q}
  holds card S mod p = 1
proof
end;
::$P+
