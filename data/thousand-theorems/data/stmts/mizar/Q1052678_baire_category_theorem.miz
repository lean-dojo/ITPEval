:: Statement-only formalization of thousand-theorems corpus artifact Q1052678,
:: "Baire category theorem": in a Baire topological space, the intersection
:: of a countable family of open dense subsets is dense. This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, STRUCT_0, PRE_TOPC,
    TOPS_1, RCOMP_1, CARD_1, CARD_3, NAT_1, FUNCT_1, RELAT_1, PROB_1,
    YELLOW_8;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, NAT_1, RELAT_1,
    FUNCT_1, FUNCT_2, CARD_3, SETFAM_1, STRUCT_0, PRE_TOPC, TOPS_1, PROB_1,
    YELLOW_8;
  constructors SETFAM_1, RELSET_1, FUNCT_2, CARD_3, TOPS_1, PROB_1,
    YELLOW_8;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, RELAT_1, FUNCT_1,
    FUNCT_2, CARD_3, STRUCT_0, PRE_TOPC, TOPS_1, YELLOW_8;
  requirements NUMERALS, SUBSET, BOOLE;
  definitions TARSKI, YELLOW_8;
  expansions TARSKI;

begin

::$P-
theorem
  (for T being empty TopSpace,
       F being Subset-Family of T st
     F is countable &
     (for S being Subset of T st S in F holds S is open & S is dense)
   holds Intersect F is dense) &
  (for T being non empty TopSpace,
       F being Subset-Family of T st
     T is Baire &
     F is countable &
     (for S being Subset of T st S in F holds S is open & S is dense)
   holds Intersect F is dense)
proof
end;
::$P+
