:: Statement-only formalization of thousand-theorems corpus artifact Q257387,
:: "Vitali theorem": choosing one real from each rational-difference
:: equivalence class in the interval [0,1] gives a nonmeasurable set. This
:: file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, RELAT_1,
      RELAT_2, EQREL_1, FUNCT_1, FUNCT_2, PARTFUN1, CARD_1, ORDINAL1,
      XXREAL_0, XXREAL_1, XXREAL_2, ARYTM_1, ARYTM_3, REAL_1, RAT_1,
      PROB_1, MEASURE1, RCOMP_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
      RELAT_2, EQREL_1, FUNCT_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1,
      NUMBERS, XCMPLX_0, XREAL_0, REAL_1, XXREAL_0, XXREAL_2, RAT_1,
      PROB_1, RCOMP_1;
 constructors RELSET_1, RELAT_2, EQREL_1, FUNCT_2, REAL_1, XXREAL_2,
      RAT_1, PROB_1, RCOMP_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XREAL_0, XXREAL_0, XXREAL_2, MEMBERED,
      EQREL_1, RCOMP_1;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, RELAT_1, RELAT_2, XBOOLE_0;
 equalities TARSKI, RELAT_1, SUBSET_1;
 expansions TARSKI, RELAT_1, RELAT_2, XBOOLE_0;

begin

::$P-
theorem
  for I being Subset of REAL,
      R being Equivalence_Relation of I,
      V being Subset of REAL st
    I = {x where x is Real : 0 <= x & x <= 1} &
    (for x,y being Element of I holds
      ([x,y] in R iff x-y in RAT)) &
    V = {the Element of C where C is Element of Class R : C = C}
  holds
    not V in Borel_Sets
proof
end;
::$P+
