:: Statement-only formalization of thousand-theorems corpus artifact Q476776
:: (thousand-theorems__mizar__Q476776), "Solutions of a general quartic
:: equation": a four-root characterization over a field of characteristic
:: not two using a cubic resolvent.
:: This file contains no proof.

environ
  vocabularies NUMBERS, CARD_1, FUNCT_1, RELAT_1, XBOOLE_0, ARYTM_3,
    SUBSET_1, ARYTM_1, XXREAL_0, INT_2, NAT_1, SUPINF_2, MESFUNC1,
    INT_1, VECTSP_1, STRUCT_0, RLVECT_1, ALGSTR_0, LATTICES, GROUP_1,
    BINOP_1, FUNCSDOM, VECTSP_2, TARSKI, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    BINOP_1, DOMAIN_1, NUMBERS, XREAL_0, XCMPLX_0, XXREAL_0, NAT_1,
    INT_1, INT_2, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1, VECTSP_1,
    VECTSP_2, NEWTON;
  constructors NAT_D, PEPIN, EUCLID, REALSET1, RELSET_1, BINOP_2,
    DOMAIN_1, BINOP_1, VECTSP_1, VECTSP_2, NEWTON;
  registrations STRUCT_0, XREAL_0, ORDINAL1, INT_1, RELAT_1, VECTSP_1,
    INT_3, SUBSET_1, XBOOLE_0, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities ALGSTR_0;

begin

::$P-
theorem
  for K being Field,
      a,b,c,d,e,p,q,r,s,u,v,w,x being Element of K st
    1.K + 1.K <> 0.K &
    a <> 0.K &
    p = ((1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) * a * c -
      (1.K + 1.K + 1.K) * (b * b)) /
      ((1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) * (a * a)) &
    q = (b * b * b -
      (1.K + 1.K) * (1.K + 1.K) * a * b * c +
      (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) * (a * a) * d) /
      ((1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) * (a * a * a)) &
    q <> 0.K &
    r = ((1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (1.K + 1.K) * a * (b * b) * c +
      (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (1.K + 1.K) * (1.K + 1.K) * (a * a * a) * e -
      (1.K + 1.K + 1.K) * (b * b * b * b) -
      (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (a * a) * b * d) /
      ((1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) *
        (1.K + 1.K) * (1.K + 1.K) * (a * a * a * a)) &
    u * u * u - p * (u * u) -
      (1.K + 1.K) * (1.K + 1.K) * r * u +
      (1.K + 1.K) * (1.K + 1.K) * p * r - q * q = 0.K &
    s * s = u - p &
    v * v = (1.K + 1.K) * (1.K + 1.K) * (s * s) -
      (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) * (u - q / s) &
    w * w = (1.K + 1.K) * (1.K + 1.K) * (s * s) -
      (1.K + 1.K) * (1.K + 1.K) * (1.K + 1.K) * (u + q / s)
  holds
    (a * (x * x * x * x) + b * (x * x * x) + c * (x * x) +
        d * x + e = 0.K iff
      x = (-((1.K + 1.K) * s) - v) /
          ((1.K + 1.K) * (1.K + 1.K)) -
        b / ((1.K + 1.K) * (1.K + 1.K) * a) or
      x = (-((1.K + 1.K) * s) + v) /
          ((1.K + 1.K) * (1.K + 1.K)) -
        b / ((1.K + 1.K) * (1.K + 1.K) * a) or
      x = ((1.K + 1.K) * s - w) /
          ((1.K + 1.K) * (1.K + 1.K)) -
        b / ((1.K + 1.K) * (1.K + 1.K) * a) or
      x = ((1.K + 1.K) * s + w) /
          ((1.K + 1.K) * (1.K + 1.K)) -
        b / ((1.K + 1.K) * (1.K + 1.K) * a))
proof
end;
::$P+
