:: Statement-only formalization of thousand-theorems corpus artifact Q4695203
:: (thousand-theorems__mizar__Q4695203), "Four functions theorem": the
:: Ahlswede-Daykin inequality for four nonnegative functions on an arbitrary
:: distributive lattice and two finite subsets. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, FINSET_1, FINSUB_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FINSET_1, FINSUB_1, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, FINSET_1, FINSUB_1,
    BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FINSET_1, FINSUB_1;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for L being set,
      latLe being Relation of L,L,
      meet,join being Function of [:L,L:],L,
      R being non empty set,
      zero,one being Element of R,
      add,mul being BinOp of R,
      le being Relation of R,R,
      f1,f2,f3,f4 being Function of L,R,
      s,t,infs,sups being finite Subset of L,
      sum1,sum2,sum3,sum4 being Function of Fin L,R st
    (for x being set st x in L holds [x,x] in latLe) &
    (for x,y being set st x in L & y in L &
      [x,y] in latLe & [y,x] in latLe holds x = y) &
    (for x,y,z being set st x in L & y in L & z in L &
      [x,y] in latLe & [y,z] in latLe holds [x,z] in latLe) &
    (for x,y,z being set st x in L & y in L & z in L holds
      ([z,meet.[x,y]] in latLe iff
        [z,x] in latLe & [z,y] in latLe)) &
    (for x,y,z being set st x in L & y in L & z in L holds
      ([join.[x,y],z] in latLe iff
        [x,z] in latLe & [y,z] in latLe)) &
    (for x,y,z being set st x in L & y in L & z in L
      holds meet.[x,join.[y,z]] =
        join.[meet.[x,y],meet.[x,z]]) &
    (for x,y,z being set st x in L & y in L & z in L
      holds join.[x,meet.[y,z]] =
        meet.[join.[x,y],join.[x,z]]) &
    (for x,y,z being Element of R
      holds add.[add.[x,y],z] = add.[x,add.[y,z]]) &
    (for x,y being Element of R holds add.[x,y] = add.[y,x]) &
    (for x being Element of R holds add.[zero,x] = x) &
    (for x,y,z being Element of R
      holds mul.[mul.[x,y],z] = mul.[x,mul.[y,z]]) &
    (for x,y being Element of R holds mul.[x,y] = mul.[y,x]) &
    (for x being Element of R holds mul.[one,x] = x) &
    (for x being Element of R holds mul.[zero,x] = zero) &
    (for x,y,z being Element of R
      holds mul.[x,add.[y,z]] =
        add.[mul.[x,y],mul.[x,z]]) &
    (for x being Element of R holds [x,x] in le) &
    (for x,y being Element of R st [x,y] in le & [y,x] in le
      holds x = y) &
    (for x,y,z being Element of R st [x,y] in le & [y,z] in le
      holds [x,z] in le) &
    (for x,y being Element of R holds [x,y] in le or [y,x] in le) &
    (for x,y,z being Element of R st [x,y] in le
      holds [add.[x,z],add.[y,z]] in le) &
    (for x,y,z being Element of R st
      [add.[x,z],add.[y,z]] in le holds [x,y] in le) &
    [zero,one] in le &
    (ex x,y being Element of R st x <> y) &
    (for a,b,c being Element of R st
      [zero,a] in le & zero <> a & [b,c] in le & b <> c
      holds [mul.[a,b],mul.[a,c]] in le & mul.[a,b] <> mul.[a,c]) &
    (for a,b,c being Element of R st
      [zero,c] in le & zero <> c & [a,b] in le & a <> b
      holds [mul.[a,c],mul.[b,c]] in le & mul.[a,c] <> mul.[b,c]) &
    (for x,y being Element of R st [x,y] in le
      ex z being Element of R st y = add.[x,z]) &
    (for x being set st x in L
      holds [zero,f1.x] in le & [zero,f2.x] in le &
        [zero,f3.x] in le & [zero,f4.x] in le) &
    (for x,y being set st x in L & y in L
      holds [mul.[f1.x,f2.y],
        mul.[f3.(meet.[x,y]),f4.(join.[x,y])]] in le) &
    (for z being set holds
      (z in infs iff
        ex x,y being set st x in s & y in t & z = meet.[x,y])) &
    (for z being set holds
      (z in sups iff
        ex x,y being set st x in s & y in t & z = join.[x,y])) &
    sum1.{} = zero &
    (for A being Element of Fin L, x being set st x in L & not x in A
      holds sum1.(A \/ {x}) = add.[sum1.A,f1.x]) &
    sum2.{} = zero &
    (for A being Element of Fin L, x being set st x in L & not x in A
      holds sum2.(A \/ {x}) = add.[sum2.A,f2.x]) &
    sum3.{} = zero &
    (for A being Element of Fin L, x being set st x in L & not x in A
      holds sum3.(A \/ {x}) = add.[sum3.A,f3.x]) &
    sum4.{} = zero &
    (for A being Element of Fin L, x being set st x in L & not x in A
      holds sum4.(A \/ {x}) = add.[sum4.A,f4.x])
  holds
    [mul.[sum1.s,sum2.t],mul.[sum3.infs,sum4.sups]] in le
proof
end;
::$P+
