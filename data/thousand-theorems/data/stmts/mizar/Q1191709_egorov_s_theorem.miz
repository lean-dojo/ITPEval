:: Statement-only formalization of thousand-theorems corpus artifact Q1191709,
:: "Egorov's theorem": an almost-everywhere convergent countable directed
:: family of strongly measurable functions on a measurable finite-measure set
:: converges uniformly outside an arbitrarily small measurable subset.
:: This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, PROB_1, MEASURE1, SUBSET_1, SEQFUNC,
      MESFUNC5, PARTFUN1, XXREAL_0, NAT_1, RELAT_1, ARYTM_3, ARYTM_1,
      FUNCT_1, ORDINAL2, CARD_1, COMPLEX1, SEQ_2, TARSKI, REAL_1, PBOOLE,
      MESFUNC1, MESFUNC2, VALUED_1, ZFMISC_1, FUNCT_2, SETFAM_1,
      FINSET_1, XTUPLE_0;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XXREAL_3, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, XXREAL_0, VALUED_0,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1, NAT_1, PROB_1,
      MEASURE1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, SETFAM_1,
      FINSET_1, XTUPLE_0;
 constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, RELSET_1,
      COMPLEX1, SETFAM_1, FINSET_1, XTUPLE_0;
 registrations SUBSET_1, NAT_1, XREAL_0, MEMBERED, ORDINAL1, PARTFUN1,
      MEASURE1, FUNCT_2, RELAT_1, XBOOLE_0, NUMBERS, XXREAL_0, XCMPLX_0,
      FUNCT_1, VALUED_0, XXREAL_3, RELSET_1, FINSET_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, MESFUNC5;
 equalities XBOOLE_0;
 expansions TARSKI, XBOOLE_0, FUNCT_2;

begin

::$P-
theorem
  (for X,B being empty set,
       I being non empty set,
       S being SigmaField of X,
       M being sigma_Measure of S,
       leq being Relation of I,I,
       join being Function of [:I,I:],I,
       d being Function of [:B,B:],ExtREAL,
       F being Function of I,Funcs(X,B),
       g being Function of X,B,
       s being Subset of X,
       epsilon being Real
   st
     (for i being Element of I holds [i,i] in leq) &
     (for i,j,k being Element of I st
        [i,j] in leq & [j,k] in leq holds [i,k] in leq) &
     (for i,j being Element of I st
        [i,j] in leq & [j,i] in leq holds i = j) &
     (for i,j being Element of I holds
        [i,join.[i,j]] in leq & [j,join.[i,j]] in leq) &
     (for i,j,k being Element of I st
        [i,k] in leq & [j,k] in leq holds [join.[i,j],k] in leq) &
     (ex code being Function of I,NAT st code is one-to-one) &
     0 < epsilon
   holds
     ex t being Element of S st
       t c= s &
       M.t <= epsilon &
       for delta being Real st 0 < delta holds
         ex j being Element of I st
           for i being Element of I,
               x being Element of X st
             [j,i] in leq & x in X & x in s & not x in t holds
               ex Fi being Function of X,B st
                 F.i = Fi & d.[Fi.x,g.x] < delta)
  &
  (for X being set,
      I,B being non empty set,
      S being SigmaField of X,
      M being sigma_Measure of S,
      leq being Relation of I,I,
      join being Function of [:I,I:],I,
      d being Function of [:B,B:],ExtREAL,
      F being Function of I,Funcs(X,B),
      g being Function of X,B,
      s being Subset of X,
      epsilon being Real
  st
    (for i being Element of I holds [i,i] in leq) &
    (for i,j,k being Element of I st
       [i,j] in leq & [j,k] in leq holds [i,k] in leq) &
    (for i,j being Element of I st
       [i,j] in leq & [j,i] in leq holds i = j) &
    (for i,j being Element of I holds
       [i,join.[i,j]] in leq & [j,join.[i,j]] in leq) &
    (for i,j,k being Element of I st
       [i,k] in leq & [j,k] in leq holds [join.[i,j],k] in leq) &
    (ex code being Function of I,NAT st code is one-to-one) &
    (for a,b being Element of B holds
       0 <= d.[a,b] &
       d.[a,a] = 0 &
       d.[a,b] = d.[b,a]) &
    (for a,b,c being Element of B holds
       d.[a,c] <= d.[a,b] + d.[b,c]) &
    (for i being Element of I holds
       ex Fi being Function of X,B,
          Q being sequence of Funcs(X,B)
       st
         F.i = Fi &
         (for n being Nat holds
           ex q being Function of X,B,
              R being finite Subset of B
           st
             Q.n = q &
             (for x being Element of X st x in X holds q.x in R) &
             (for y being Element of B holds
               {x where x is Element of X: x in X & q.x = y} in S)) &
         for x being Element of X st x in X holds
           for delta being Real st 0 < delta holds
             ex n0 being Nat st
               for n being Nat st n0 <= n holds
                 ex q being Function of X,B st
                   Q.n = q & d.[q.x,Fi.x] < delta) &
    (ex Q being sequence of Funcs(X,B) st
       (for n being Nat holds
         ex q being Function of X,B,
            R being finite Subset of B
         st
           Q.n = q &
           (for x being Element of X st x in X holds q.x in R) &
           (for y being Element of B holds
             {x where x is Element of X: x in X & q.x = y} in S)) &
       for x being Element of X st x in X holds
         for delta being Real st 0 < delta holds
           ex n0 being Nat st
             for n being Nat st n0 <= n holds
               ex q being Function of X,B st
                 Q.n = q & d.[q.x,g.x] < delta) &
    s in S &
    M.s <> +infty &
    (ex N being Element of S st
       M.N = 0 &
       for x being Element of X st
         x in X & x in s & not x in N holds
           for delta being Real st 0 < delta holds
             ex j being Element of I st
               for i being Element of I st [j,i] in leq holds
                 ex Fi being Function of X,B st
                   F.i = Fi & d.[Fi.x,g.x] < delta) &
    0 < epsilon
  holds
    ex t being Element of S st
      t c= s &
      M.t <= epsilon &
      for delta being Real st 0 < delta holds
        ex j being Element of I st
          for i being Element of I,
              x being Element of X st
            [j,i] in leq & x in X & x in s & not x in t holds
              ex Fi being Function of X,B st
                F.i = Fi & d.[Fi.x,g.x] < delta
  )
proof
end;
::$P+
