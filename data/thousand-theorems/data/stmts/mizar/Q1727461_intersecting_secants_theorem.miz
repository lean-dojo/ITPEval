:: Statement-only formalization of "Intersecting secants theorem" from
:: Thousand Theorems artifact Q1727461
:: (thousand-theorems__mizar__Q1727461). Four cospherical points in a real
:: inner-product affine space, forming two distinct endpoint pairs whose rays
:: from a common point have angle zero, satisfy equality of the two products
:: of distances from that point. This file contains no proof.

environ

 vocabularies NUMBERS, BHSP_1, PRE_TOPC, SUBSET_1, FINSEQ_1, FUNCT_1, RELAT_1,
      FUNCT_2, CARD_1, TARSKI, XBOOLE_0, BINOP_1, SETWISEO, FINSET_1, MEMBER_1,
      FINSOP_1, ALGSTR_0, SUPINF_2, NAT_1, DECOMP_1, REAL_1, STRUCT_0, BINOP_2,
      PROB_2, NORMSP_1, ARYTM_3, SQUARE_1, ARYTM_1, XXREAL_0, RVSUM_1,
      RLVECT_1, ORDINAL4, BHSP_5, SIN_COS, SIN_COS6;
 notations TARSKI, SUBSET_1, XBOOLE_0, CARD_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, STRUCT_0, ALGSTR_0, REAL_1, XREAL_0, FUNCT_2, FINSET_1, NAT_1,
      RELAT_1, BINOP_2, PRE_TOPC, RLVECT_1, BHSP_1, SQUARE_1, BINOP_1,
      SETWISEO, FUNCT_1, FINSEQ_1, FINSOP_1, SIN_COS, SIN_COS6;
 constructors BINOP_1, DOMAIN_1, SETWISEO, REAL_1, SQUARE_1, NAT_1, BINOP_2,
      MEMBERED, FINSOP_1, BHSP_1, RELSET_1, INT_1, SIN_COS, SIN_COS6;
 registrations XBOOLE_0, FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2, FINSET_1,
      NUMBERS, BINOP_2, STRUCT_0, CARD_1, XREAL_0, SQUARE_1, NAT_1, INT_1,
      SIN_COS, SIN_COS6;
 requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
 definitions TARSKI;
 equalities SQUARE_1, BINOP_1, RLVECT_1, ALGSTR_0;
 expansions TARSKI;

begin

::$P-
theorem
  for V being RealUnitarySpace,
      A,B,C,D,P being VECTOR of V st
    (ex O being VECTOR of V, radius being Real st
      ||.O-A.|| = radius & ||.O-B.|| = radius &
      ||.O-C.|| = radius & ||.O-D.|| = radius) &
    A <> B & C <> D &
    arccos (((A-P) .|. (B-P)) /
      (||.A-P.|| * ||.B-P.||)) = 0 &
    arccos (((C-P) .|. (D-P)) /
      (||.C-P.|| * ||.D-P.||)) = 0
  holds
    ||.A-P.|| * ||.B-P.|| = ||.C-P.|| * ||.D-P.||
proof
end;
::$P+
