:: Statement-only formalization of thousand-theorems corpus artifact Q191693,
:: "Lebesgue's decomposition theorem": every s-finite measure decomposes,
:: relative to a sigma-finite measure, into a mutually singular measure and
:: a measure with a nonnegative measurable density. This file contains no proof.

environ
  vocabularies NUMBERS, XBOOLE_0, PROB_1, PROB_2, MEASURE1, SUBSET_1,
      SEQFUNC, MESFUNC5, PARTFUN1, XXREAL_0, NAT_1, RELAT_1, ARYTM_3,
      ARYTM_1, FUNCT_1, ORDINAL2, CARD_1, CARD_3, COMPLEX1, SEQ_2, TARSKI,
      REAL_1, PBOOLE, MESFUNC1, MESFUNC2, VALUED_1, ZFMISC_1, FUNCT_2,
      SETFAM_1, SUPINF_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XXREAL_3, VALUED_0, FUNCT_1, RELSET_1, PARTFUN1,
      FUNCT_2, NAT_1, SETFAM_1, PROB_1, PROB_2, MEASURE1, EXTREAL1,
      MESFUNC1, MESFUNC2, MESFUNC5, SUPINF_2;
  constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, RELSET_1,
      COMPLEX1, SETFAM_1, PROB_2, SUPINF_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, FUNCT_2, NUMBERS, XREAL_0,
      MEMBERED, VALUED_0, XXREAL_0, XXREAL_3, RELSET_1, MEASURE1, MESFUNC1,
      MESFUNC5, NAT_1;
  requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
  definitions TARSKI, FUNCT_1, FUNCT_2, XBOOLE_0, PROB_1, MEASURE1,
      MESFUNC1, MESFUNC5;
  equalities XBOOLE_0, PROB_1, MESFUNC5, SUPINF_2;
  expansions TARSKI, FUNCT_1, PROB_1, MEASURE1;

begin

::$P-
theorem
  (for X being empty set,
       S being SigmaField of X,
       Mu,Nu being sigma_Measure of S
   st
     (ex Q being sequence of Funcs(S,ExtREAL) st
       (for n being Nat holds
         ex Mn being sigma_Measure of S st
           Q.n = Mn & Mn.X < +infty) &
       for A being Element of S holds
         ex a being sequence of ExtREAL st
           (for n being Nat holds
             ex Mn being sigma_Measure of S st
               Q.n = Mn & a.n = Mn.A) &
           Mu.A = SUM(a)) &
     (ex C being SetSequence of S st
       X = union rng C &
       for n being Nat holds Nu.(C.n) < +infty)
   holds
     ex Sing being sigma_Measure of S,
        f being Function of X,ExtREAL st
       f is nonnegative &
       (ex Z being Element of S st Sing.Z = 0 & Nu.(X \ Z) = 0) &
       for A being Element of S holds Mu.A = Sing.A + 0)
  &
  (for X being non empty set,
       S being SigmaField of X,
       Mu,Nu being sigma_Measure of S
   st
     (ex Q being sequence of Funcs(S,ExtREAL) st
       (for n being Nat holds
         ex Mn being sigma_Measure of S st
           Q.n = Mn & Mn.X < +infty) &
       for A being Element of S holds
         ex a being sequence of ExtREAL st
           (for n being Nat holds
             ex Mn being sigma_Measure of S st
               Q.n = Mn & a.n = Mn.A) &
           Mu.A = SUM(a)) &
     (ex C being SetSequence of S st
       X = union rng C &
       for n being Nat holds Nu.(C.n) < +infty)
   holds
     ex Sing being sigma_Measure of S,
        f being Function of X,ExtREAL st
       (ex E being Element of S st E = X & f is E-measurable) &
       f is nonnegative &
       (ex Z being Element of S st Sing.Z = 0 & Nu.(X \ Z) = 0) &
       for A being Element of S holds
         Mu.A = Sing.A + integral+(Nu,f|A))
proof
end;
::$P+
