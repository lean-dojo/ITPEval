:: Statement-only formalization of thousand-theorems corpus artifact Q303402
:: (thousand-theorems__mizar__Q303402), "Rank–nullity theorem": for a linear
:: map of modules over a ring satisfying rank-nullity, the cardinal ranks of
:: its range and kernel add to the rank of its domain. This file contains no
:: proof.

environ

 vocabularies FUNCT_1, RELAT_1, TARSKI, STRUCT_0, SUBSET_1, XBOOLE_0,
      VECTSP_1, RLVECT_5, FINSET_1, RLVECT_3, LOPBAN_1, ARYTM_3, SUPINF_2,
      CARD_1, RLSUB_1, FUNCT_2, ARYTM_1, MESFUNC1, VECTSP10, RLVECT_2,
      FUNCT_4, REALSET1, FUNCOP_1, QC_LANG1, CARD_3, RLSUB_2, FINSEQ_1,
      VALUED_1, NAT_1, XXREAL_0, PARTFUN1, PBOOLE, RANKNULL, MSSUBFAM,
      UNIALG_1, RLVECT_1, ALGSTR_0, FUNCSDOM, ORDINAL1, ORDINAL2, CARD_2,
      LMOD_7;
 notations TARSKI, XBOOLE_0, SUBSET_1, DOMAIN_1, RELAT_1, RELSET_1, FUNCT_1,
      ORDINAL1, ORDINAL2, NAT_1, NUMBERS, FUNCOP_1, PARTFUN1, FUNCT_2,
      FUNCT_4, XCMPLX_0, XXREAL_0, CARD_1, FINSET_1, FINSEQ_1, FINSEQOP,
      STRUCT_0, RLVECT_1, RLVECT_2, VECTSP_1, FUNCT_7, VECTSP_4, VECTSP_5,
      VECTSP_6, VECTSP_7, MOD_2, MATRLIN, VECTSP_9, LOPBAN_1, CARD_2,
      LMOD_7, RANKNULL;
 constructors NAT_1, FINSEQOP, HAHNBAN, VECTSP_6, VECTSP_7, MOD_2, VECTSP_9,
      REALSET1, RLVECT_2, WELLORD2, LOPBAN_1, VECTSP_5, FUNCT_7, FUNCT_4,
      XXREAL_0, MATRLIN, RELSET_1, ORDINAL2, CARD_2, LMOD_7, RANKNULL;
 registrations RELAT_1, FUNCT_1, STRUCT_0, CARD_1, FINSET_1, VECTSP_9,
      XBOOLE_0, MATRLIN, FUNCOP_1, ORDINAL1, XREAL_0, RELSET_1, VECTSP_4,
      LMOD_7;
 requirements BOOLE, SUBSET, NUMERALS, ARITHM;
 definitions TARSKI, FUNCT_1, XBOOLE_0, MATRLIN, FUNCT_2;
 equalities RELAT_1, FINSEQ_1, VECTSP_4, VECTSP_6, RLVECT_1, STRUCT_0,
      LOPBAN_1;
 expansions TARSKI, FUNCT_1, FINSEQ_1, VECTSP_4, XBOOLE_0, STRUCT_0;

begin

::$P-
theorem
  for R being Ring holds
  for M,M1 being VectSp of R,
      f being linear-transformation of M,M1,
      CR,CK,CM being Cardinal st
    R is non degenerated &
    (for V being VectSp of R holds
      ex C being Cardinal st
        (for A being Subset of V st A is linearly-independent
          holds card A c= C) &
        ex A being Subset of V st
          A is linearly-independent & card A = C) &
    (for V being VectSp of R, N being Subspace of V,
         CQ,CN,CV being Cardinal st
      ((for A being Subset of V/N st A is linearly-independent
          holds card A c= CQ) &
       (ex A being Subset of V/N st
          A is linearly-independent & card A = CQ)) &
      ((for A being Subset of N st A is linearly-independent
          holds card A c= CN) &
       (ex A being Subset of N st
          A is linearly-independent & card A = CN)) &
      ((for A being Subset of V st A is linearly-independent
          holds card A c= CV) &
       (ex A being Subset of V st
          A is linearly-independent & card A = CV))
     holds CQ +` CN = CV) &
    ((for A being Subset of im f st A is linearly-independent
        holds card A c= CR) &
     (ex A being Subset of im f st
        A is linearly-independent & card A = CR)) &
    ((for A being Subset of ker f st A is linearly-independent
        holds card A c= CK) &
     (ex A being Subset of ker f st
        A is linearly-independent & card A = CK)) &
    ((for A being Subset of M st A is linearly-independent
        holds card A c= CM) &
     (ex A being Subset of M st
        A is linearly-independent & card A = CM))
  holds CR +` CK = CM
proof
end;
::$P+
