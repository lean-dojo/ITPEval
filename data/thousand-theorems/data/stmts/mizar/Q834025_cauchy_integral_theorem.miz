:: Statement-only formalization of thousand-theorems corpus artifact Q834025
:: (thousand-theorems__mizar__Q834025), "Cauchy integral theorem": a
:: complex function continuous on a closed disc and complex differentiable
:: inside it off a countable set satisfies the Cauchy circle-integral formula
:: at every interior point. This file contains no proof.

environ

 vocabularies NUMBERS, SUBSET_1, FDIFF_1, SEQ_1, FUNCT_1, ZFMISC_1, MCART_1,
      ARYTM_3, RELAT_1, XCMPLX_0, REAL_1, PARTFUN1, INTEGRA1, COMPLEX1,
      VALUED_1, ARYTM_1, XBOOLE_0, TARSKI, XXREAL_0, XXREAL_1, RCOMP_1,
      ORDINAL2, SIN_COS, CARD_1, CARD_3, FDIFF_3, FUNCT_2, SEQ_2, TOPMETR,
      INTEGRA5,
      VFUNCT_1, XXREAL_2, INTEGR1C, MEASURE5, VALUED_0, NAT_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1, FUNCT_1,
      RELSET_1, VALUED_0, FUNCT_3, PARTFUN1, FUNCT_2, CARD_1, CARD_3,
      ORDINAL1, NUMBERS,
      XCMPLX_0, XREAL_0, XXREAL_0, COMPLEX1, REAL_1, BINOP_1, RCOMP_1, SEQ_1,
      SEQ_2, FCONT_1, FDIFF_1, COMSEQ_3, TOPMETR, MCART_1, MEASURE5, INTEGRA5,
      SIN_COS, VALUED_1, PRE_TOPC, FDIFF_3, STRUCT_0, XXREAL_2, INTEGR1C;
 constructors REAL_1, FDIFF_1, RFUNCT_3, FCONT_1, INTEGRA5, SIN_COS, TOPMETR,
      FDIFF_3, MESFUN6C, SEQ_2, RVSUM_1, COMSEQ_3, INTEGRA1, COMSEQ_2,
      XTUPLE_0, BINOP_2, BINOP_1, CARD_1, INTEGR1C;
 registrations XREAL_0, FUNCT_2, NUMBERS, ORDINAL1, MEMBERED, SIN_COS, FDIFF_1,
      SUBSET_1, XCMPLX_0, RELAT_1, XXREAL_0, XBOOLE_0, VALUED_0, VALUED_1,
      RELSET_1, MEASURE5, XTUPLE_0, CARD_1, CARD_3, INTEGR1C;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI;
 equalities INTEGRA5, VALUED_1;
 expansions TARSKI;

begin

::$P-
theorem
  for R being Real,
      c,w being Element of COMPLEX,
      s being countable Subset of COMPLEX,
      f being Function of COMPLEX,COMPLEX st
    |.w-c.| < R &
    (for z being Element of COMPLEX st |.z-c.| <= R holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st
          0 < delta &
          for v being Element of COMPLEX st
            |.v-c.| <= R & |.v-z.| < delta
          holds
            |.f.v-f.z.| < epsilon) &
    (for z being Element of COMPLEX st
        |.z-c.| < R & not z in s
      holds
        ex d being Element of COMPLEX st
          for epsilon being Real st 0 < epsilon holds
            ex delta being Real st
              0 < delta &
              for v being Element of COMPLEX st
                0 < |.v-z.| & |.v-z.| < delta
              holds
                |.f.v-f.z-d*(v-z).| < epsilon*|.v-z.|)
  holds
    ex x,y being Function of REAL,REAL st
      (for t being Real holds
        x.t = Re c + R*cos.t & y.t = Im c + R*sin.t) &
      ex C being C1-curve st
        C = (x+<i>(#)y) | [.0,2*PI.] &
        ex g being Function of COMPLEX,COMPLEX st
          (for z being Element of COMPLEX holds
            g.z = f.z/(z-w)) &
          integral(g,C) = 2*PI*<i>*f.w
proof
end;
::$P+
