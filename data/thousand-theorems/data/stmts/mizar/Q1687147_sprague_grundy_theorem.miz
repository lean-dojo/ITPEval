:: Statement-only formalization of thousand-theorems corpus artifact Q1687147
:: (thousand-theorems__mizar__Q1687147), "Sprague-Grundy theorem": every
:: well-founded impartial game is equivalent to the Nim game indexed by its
:: recursively defined Grundy value. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELAT_2,
      FUNCT_1, FUNCT_2, PARTFUN1, ORDINAL1, WELLORD1, NUMBERS;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
      FUNCT_1, FUNCT_2, PARTFUN1, ORDINAL1, WELLORD1, NUMBERS;
 constructors ZFMISC_1, RELAT_1, RELAT_2, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, PARTFUN1, WELLORD1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ORDINAL1;
 requirements BOOLE, SUBSET, NUMERALS;

begin

::$P-
theorem
  for V being non empty set,
      O being non empty set,
      W being set,
      G being Function of V,O,
      x being Element of V
  for A,B being Relation of V
  for ML,MR,LE being Relation of W st
    (A \/ B) is_well_founded_in V &
    O = rng G &
    (for z being Element of V holds
      G.z is ordinal &
      (for beta being Ordinal st beta in G.z holds
        ex y being Element of V st [y,z] in B & G.y = beta) &
      (for y being Element of V st [y,z] in B holds G.y <> G.z)) &
    W = [:{{}},V:] \/ [:{{{}}},V:] \/
      [:{{{{}}}},(rng G \/ union rng G):] &
    (for a,b being Element of W holds
      ([a,b] in ML iff
        (ex y,z being Element of V st
          a = [{},y] & b = [{},z] & [y,z] in A) or
        (ex y,z being Element of V st
          a = [{{}},y] & b = [{{}},z] & [y,z] in B) or
        (ex beta,alpha being Ordinal st
          a = [{{{}}},beta] & b = [{{{}}},alpha] & beta in alpha))) &
    (for a,b being Element of W holds
      ([a,b] in MR iff
        (ex y,z being Element of V st
          a = [{},y] & b = [{},z] & [y,z] in B) or
        (ex y,z being Element of V st
          a = [{{}},y] & b = [{{}},z] & [y,z] in A) or
        (ex beta,alpha being Ordinal st
          a = [{{{}}},beta] & b = [{{{}}},alpha] & beta in alpha))) &
    (for a,b being Element of W holds
      ([a,b] in LE iff
        (for c being Element of W st [c,a] in ML holds
          not [b,c] in LE) &
        (for c being Element of W st [c,b] in MR holds
          not [c,a] in LE))) &
    (for z being Element of V holds
      [[{},z],[{{}},z]] in LE & [[{{}},z],[{},z]] in LE)
  holds
    [[{{{}}},G.x],[{},x]] in LE & [[{},x],[{{{}}},G.x]] in LE
proof
end;
::$P+
