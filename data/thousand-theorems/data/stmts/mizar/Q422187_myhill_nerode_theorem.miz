:: Statement-only formalization of thousand-theorems corpus artifact Q422187
:: (thousand-theorems__mizar__Q422187), "Myhill–Nerode theorem": a language
:: over an arbitrary alphabet is accepted by a finite deterministic automaton
:: if and only if its set of left quotients is finite. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, FINSEQ_1, FINSEQ_2, FINSET_1, ORDINAL4;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, FINSEQ_1, FINSEQ_2, FINSET_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2,
    FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FINSEQ_1, FINSEQ_2, FINSET_1, FRAENKEL;
  requirements SUBSET, BOOLE;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for A being set, L being Subset of A* holds
    ((ex Q being non empty finite set,
         q0 being Element of Q,
         F being Subset of Q,
         delta being Function of [:Q,A:],Q,
         run being Function of [:Q,A*:],Q st
       (for q being Element of Q holds run.[q,<*>A] = q) &
       (for q being Element of Q,
            w being FinSequence of A,
            a being object st a in A holds
          run.[q,<*a*>^w] = run.[delta.[q,a],w]) &
       (for w being FinSequence of A holds
          (w in L iff run.[q0,w] in F)))
     iff
     ex quotients being finite set st
       quotients =
         {K where K is Subset of A* :
           ex x being Element of A* st
             for y being Element of A* holds
               (y in K iff x^y in L)})
proof
end;
::$P+
