:: Statement-only formalization of thousand-theorems corpus artifact Q2253746,
:: "Bertrand's ballot theorem": among sequences containing p votes for one
:: candidate and q votes for the other, with q < p, the proportion whose every
:: nonempty suffix has positive signed sum is (p-q)/(p+q). This file contains
:: no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FINSEQ_1,
    FINSEQ_2, NUMBERS, NAT_1, INT_1, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, ARYTM_1, ARYTM_3, CARD_3, VALUED_0,
    VALUED_1, RVSUM_1, RFINSEQ, FINSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NAT_1, NAT_D, RELAT_1,
    FUNCT_1, FINSEQ_1, FINSEQ_2, RVSUM_1, RFINSEQ, FINSET_1;
  constructors REAL_1, NAT_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1,
    FINSEQOP, RFINSEQ, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1,
    FINSEQ_2, RVSUM_1, VALUED_0, VALUED_1, CARD_1, MEMBERED,
    FRAENKEL, FINSET_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for p,q being Nat st q < p holds
    ex total,favorable being finite set st
      total = {s where s is FinSequence of INT :
        len s = p + q &
        (for i being Nat st i in Seg (p + q) holds
          s.i = 1 or s.i = -1) &
        card {i where i is Element of Seg (p + q) : s.i = 1} = p &
        card {i where i is Element of Seg (p + q) : s.i = -1} = q} &
      favorable = {s where s is FinSequence of INT :
        len s = p + q &
        (for i being Nat st i in Seg (p + q) holds
          s.i = 1 or s.i = -1) &
        card {i where i is Element of Seg (p + q) : s.i = 1} = p &
        card {i where i is Element of Seg (p + q) : s.i = -1} = q &
        (for k being Nat st k < len s holds 0 < Sum (s/^k))} &
      (p + q) * card favorable = (p -' q) * card total
proof
end;
::$P+
