:: Statement-only formalization of Thousand Theorems artifact Q1632433
:: (thousand-theorems__mizar__Q1632433), "Helly's theorem": for a finite
:: family of convex sets in a finite-dimensional vector space over a linearly
:: ordered field, intersection of every dimension-plus-one subfamily implies
:: intersection of the whole family. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, ORDINAL1, XBOOLE_0, ZFMISC_1, SUBSET_1, TARSKI,
      RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1, CARD_1, CARD_3, FINSET_1,
      STRUCT_0, ALGSTR_0, GROUP_1, RLVECT_1, RLVECT_5, VECTSP_1, REALALG1,
      ARYTM_1, ARYTM_3, SUPINF_2, XXREAL_0;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, RELAT_1, FUNCT_1,
      FUNCT_2, PARTFUN1, NUMBERS, NAT_1, CARD_1, FINSET_1, STRUCT_0,
      ALGSTR_0, GROUP_1, XXREAL_0, RLVECT_1, VECTSP_1, MATRLIN,
      VECTSP_9, REALALG1;
 constructors RELSET_1, FUNCT_2, PARTFUN1, CARD_1, FINSET_1, NAT_1,
      XXREAL_0, RLVECT_1, GROUP_1, VECTSP_1, MATRLIN, VECTSP_9, REALALG1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
      PARTFUN1, ORDINAL1, CARD_1, FINSET_1, NAT_1, XREAL_0, XXREAL_0,
      STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1, VECTSP_1, MATRLIN, VECTSP_9,
      REALALG1;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, REALALG1;
 equalities XBOOLE_0, STRUCT_0, ALGSTR_0, RLVECT_1;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for I being set, K being Field, P being Subset of K,
      V being finite-dimensional VectSp of K,
      s being finite Subset of I,
      F being Function of I, bool the carrier of V st
    P is positive_cone &
    dim V + 1 <= card s &
    (for i being Element of I st i in s holds
      for x,y being Element of V, a,b being Element of K st
        x in F/.i & y in F/.i & a in P & b in P & a + b = 1_K
      holds a * x + b * y in F/.i) &
    (for J being finite Subset of I st
        J c= s & card J = dim V + 1 holds
      ex x being Element of V st
        for i being Element of I st i in J holds x in F/.i)
  holds
    ex x being Element of V st
      for i being Element of I st i in s holds x in F/.i
proof
end;
::$P+
