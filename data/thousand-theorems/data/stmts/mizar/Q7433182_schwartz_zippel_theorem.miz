:: Statement-only formalization of thousand-theorems corpus artifact Q7433182,
:: "Schwartz-Zippel theorem": the density of zeros of a nonzero multivariate
:: polynomial on a finite product set is bounded by the maximum supported sum
:: of coordinate degrees divided by the corresponding set cardinalities.
:: This file contains no proof.

environ

 vocabularies ARYTM_3, VECTSP_1, ALGSTR_0, TARSKI, STRUCT_0, SUBSET_1,
      SUPINF_2, GROUP_6, NAT_1, MESFUNC1, C0SP1, FUNCT_2, UPROOTS, ORDERS_1,
      POLYNOM1, POLYNOM2, POLYNOM3, FUNCSDOM, HURWITZ, FINSEQ_1, QUOFIELD,
      CARD_3, FDIFF_1, FUNCT_1, RELAT_1, CARD_1, XBOOLE_0, NUMBERS, REAL_1,
      PRE_POLY, FINSUB_1,
      POLYNOM5, GROUP_1, ZFMISC_1, MOD_4, GLIB_000, REALSET1, PARTFUN1,
      ORDINAL1, YELLOW_8, RING_2, RING_3, MSSUBFAM, RLVECT_1, ALGNUM_1,
      ARYTM_1, FOMODEL1, FINSET_1, RFINSEQ, LATTICES, XXREAL_0, GAUSSINT,
      NEWTON, VECTSP_2, EC_PF_1, FUNCOP_1, XCMPLX_0, FIELD_6, FIELD_8, FUNCT_4,
      RING_5, FIELD_1, FIELD_4, FUNCT_7, BINOP_1, FIELD_9, FIELD_10, FIELD_12,
      CATALG_1, ORDINAL4, FIELD_13, FINSEQ_2, VALUED_0, RVSUM_1;
 notations TARSKI, XBOOLE_0, SUBSET_1, DOMAIN_1, RELAT_1, RELSET_1, FUNCT_1,
      ORDINAL1, FUNCT_2, ZFMISC_1, PARTFUN1, STRUCT_0, CARD_1, NUMBERS,
      ENUMSET1, BINOP_1, REALSET1, XCMPLX_0, XREAL_0, XXREAL_0, REAL_1,
      NAT_1, NAT_D, FUNCOP_1,
      ORDERS_1, FUNCT_4, FUNCT_7, FINSET_1, FINSUB_1, PRE_POLY, FINSEQ_1,
      RFINSEQ, ALGSEQ_1, POLYNOM1, POLYNOM2, POLYNOM3, POLYNOM4, POLYNOM5,
      POLYNOM7,
      UPROOTS, GROUP_1, GROUP_4, GROUP_6, RECDEF_1, MOD_4, BINOM, ALGSTR_0,
      QUOFIELD, RLVECT_1, VECTSP_2, HURWITZ, VECTSP_1, C0SP1, EC_PF_1,
      RATFUNC1, GAUSSINT, RING_2, RING_3, RING_4, RING_5, ALGNUM_1, FIELD_1,
      FIELD_4, FIELD_5, FIELD_6, FIELD_7, FIELD_8, FIELD_9, FIELD_11, FIELD_12,
      FIELD_10, FINSEQ_2, RVSUM_1, FIELD_13;
 constructors FINSOP_1, POLYNOM4, FUNCT_7, NAT_D, RATFUNC1, REALSET1, REAL_1,
      BINOM, RINGCAT1, ALGSEQ_1, GROUP_4, ALGNUM_1, RING_5, FIELD_8, FIELD_9,
      FIELD_11, FIELD_12, ORDERS_1, POLYNOM2, RFINSEQ, RECDEF_1, FIELD_10,
      FIELD_4, UPROOTS, RVSUM_1, FIELD_13;
 registrations XBOOLE_0, ORDINAL1, RELSET_1, FUNCOP_1, XCMPLX_0, XXREAL_0,
      XREAL_0, NAT_1, INT_1, MEMBERED, STRUCT_0, VECTSP_1, FINSEQ_1, ALGSTR_1,
      GCD_1, POLYNOM4, VALUED_0, FUNCT_2, ALGSTR_0, POLYNOM3, SUBSET_1,
      RLVECT_1, PRE_POLY, FUNCT_1, CARD_1, RINGCAT1, FINSET_1, FINSUB_1,
      RATFUNC1,
      POLYNOM2, GAUSSINT, RELAT_1, MOD_4, POLYNOM7, RING_2, RING_4, RING_5,
      REALSET1, POLYNOM1, POLYNOM5, FIELD_3, FIELD_4, FIELD_7, FIELD_8,
      FIELD_12, FIELD_9, FIELD_5, FIELD_6, FIELD_10, FIELD_13, FINSEQ_2,
      RVSUM_1, FRAENKEL;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI;
 equalities BINOP_1, REALSET1, XCMPLX_0, STRUCT_0, ALGSTR_0, POLYNOM3, FIELD_6,
      FUNCOP_1, FINSEQ_1, FINSEQ_2;
 expansions STRUCT_0, GROUP_1, ALGSTR_0, RLVECT_1, VECTSP_1, TARSKI, GROUP_6,
      FUNCT_1, RING_2, FUNCT_2, POLYNOM1;

begin

::$P-
theorem
  for n being Nat,
      R being domRing,
      p being Polynomial of n,R,
      S being Function of n,Fin the carrier of R st
    p <> 0_(n,R)
  holds
    ex sizes being FinSequence of REAL,
       zeros being finite set,
       bound being Element of REAL st
      len sizes = n &
      (for i being Nat st i in n holds
        sizes/.(i+1) = card (S.i)) &
      zeros =
        {x where x is Function of n,R :
          (for i being Nat st i in n holds x.i in S.i) &
          (hom_Ext_eval(x,R)).p = 0.R} &
      (ex b0 being bag of n,
          terms0 being FinSequence of REAL st
        b0 in Support p &
        len terms0 = n &
        (for i being Nat st i in n holds
          terms0/.(i+1) =
            (b0.i qua Real) / sizes/.(i+1)) &
        bound = Sum terms0) &
      (for b being bag of n st b in Support p holds
        ex terms being FinSequence of REAL st
          len terms = n &
          (for i being Nat st i in n holds
            terms/.(i+1) =
              (b.i qua Real) / sizes/.(i+1)) &
          Sum terms <= bound) &
      (card zeros qua Real) / Product sizes <= bound
proof
end;
::$P+
