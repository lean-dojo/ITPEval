:: Statement-only formalization of thousand-theorems corpus artifact Q1752621,
:: "Sylvester's law of inertia": every quadratic form on a finite-dimensional
:: real vector space is linearly equivalent to a diagonal weighted sum of
:: squares with weights -1, 0, or 1. This file contains no proof.

environ

  vocabularies NUMBERS, NAT_1, ORDINAL1, XBOOLE_0, ZFMISC_1, SUBSET_1,
    TARSKI, RELAT_1, FUNCT_1, FUNCT_2, PARTFUN1, CARD_1, CARD_3, FINSET_1,
    FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4, BINOP_1, STRUCT_0, ALGSTR_0,
    GROUP_1, RLVECT_1, RLVECT_5, VECTSP_1,
    REALALG1, MATRLIN, BILINEAR, HAHNBAN1, FVSUM_1, ARYTM_1, ARYTM_3,
    SUPINF_2, XXREAL_0, XCMPLX_0, XREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, RELAT_1,
    FUNCT_1, FUNCT_2, PARTFUN1, BINOP_1, NUMBERS, XCMPLX_0, XREAL_0,
    NAT_1, CARD_1, FINSET_1, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4,
    STRUCT_0, ALGSTR_0, GROUP_1, XXREAL_0, RLVECT_1, VECTSP_1, VECTSP_4,
    FVSUM_1, MATRLIN, VECTSP_9, REALALG1, HAHNBAN1,
    BILINEAR;
  constructors RELSET_1, FUNCT_2, PARTFUN1, CARD_1, FINSET_1, NAT_1,
    BINOP_1, FINSEQ_1, FINSEQ_2, FINSEQ_3, FINSEQ_4, XXREAL_0, RLVECT_1,
    GROUP_1, VECTSP_1, VECTSP_4, VECTSP_7, FVSUM_1, MATRLIN,
    VECTSP_9, REALALG1, HAHNBAN1, BILINEAR;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    PARTFUN1, ORDINAL1, CARD_1, FINSET_1, FINSEQ_1, FINSEQ_2, FINSEQ_3,
    FINSEQ_4, NAT_1, XREAL_0, XXREAL_0, STRUCT_0, ALGSTR_0, RLVECT_1,
    GROUP_1, VECTSP_1, VECTSP_4, VECTSP_7, FVSUM_1, MATRLIN,
    VECTSP_9, REALALG1, HAHNBAN1, BILINEAR;
  requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, REALALG1, HAHNBAN1, BILINEAR;
  equalities XBOOLE_0, BINOP_1, STRUCT_0, ALGSTR_0, RLVECT_1, FVSUM_1;
  expansions TARSKI, XBOOLE_0, BINOP_1, HAHNBAN1, BILINEAR;

begin

::$P-
theorem
  for V being finite-dimensional VectSp of F_Real,
      Q being Function of the carrier of V, the carrier of F_Real st
    (ex B being bilinear-Form of V,V st
      (for u,v being Element of V holds B.(u,v) = B.(v,u)) &
      for v being Element of V holds Q.v = B.(v,v))
  holds
    ex b being OrdBasis of V, w being FinSequence of F_Real st
      len w = dim V &
      (for i being Nat st i in dom w holds
        w/.i = -1_F_Real or w/.i = 0.F_Real or w/.i = 1_F_Real) &
      for v being Element of V holds
        ex s being FinSequence of F_Real st
          len s = dim V &
          (for i being Nat st i in dom s holds
            s/.i = w/.i * ((v |-- b)/.i) * ((v |-- b)/.i)) &
          Q.v = Sum s
proof
end;
::$P+
