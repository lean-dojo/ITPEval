:: Statement-only formalization of thousand-theorems corpus artifact Q1194053,
:: "Metrization theorems": every T_3 second-countable topological space is
:: metrizable. This file contains no proof.

environ
  vocabularies PRE_TOPC, PCOMPS_1, WAYBEL23, STRUCT_0;
  notations STRUCT_0, PRE_TOPC, PCOMPS_1, WAYBEL23;
  constructors PRE_TOPC, PCOMPS_1, WAYBEL23;
  registrations STRUCT_0, PRE_TOPC;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for T being TopSpace st T is T_3 & T is second-countable
  holds T is metrizable
proof
end;
::$P+
