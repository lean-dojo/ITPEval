:: Statement-only formalization of Thousand Theorems corpus artifact Q226014
:: (thousand-theorems__mizar__Q226014), "Poincaré recurrence theorem": for a
:: conservative nonsingular measurable self-map and a null-measurable set,
:: almost every point lying in the set returns to it at arbitrarily large
:: iteration times. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, RELAT_1, FUNCT_1,
      FUNCT_2, FUNCT_7, CARD_1, NAT_1, ORDINAL1, PROB_1, MEASURE1,
      MEASURE4, MEASURE8, XXREAL_0;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      PARTFUN1, FUNCT_2, ORDINAL1, NUMBERS, XXREAL_0, NAT_1, FUNCT_7,
      PROB_1, MEASURE1, MEASURE4, MEASURE8;
 constructors RELSET_1, NAT_1, FUNCT_7, PROB_1, MEASURE1, MEASURE4,
      MEASURE8;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, NUMBERS, NAT_1, MEMBERED, MEASURE1, MEASURE4, FUNCT_7;
 requirements NUMERALS, BOOLE, SUBSET, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2;
 equalities XBOOLE_0;
 expansions TARSKI, XBOOLE_0, FUNCT_2;

begin

::$P-
theorem
  for X being set,
      S being SigmaField of X,
      Mu being sigma_Measure of S,
      f being Function of X,X,
      s being Subset of X
  st
    (for A being Element of S holds f"A in S) &
    (for A being Subset of X st (C_Meas Mu).A = 0 holds
       (C_Meas Mu).(f"A) = 0) &
    (for A being Element of S st Mu.A <> 0 holds
       ex x being Element of X, m being Nat st
         x in X & x in A & m <> 0 & iter(f,m).x in A) &
    (ex A being Element of S st
       (C_Meas Mu).((s \ A) \/ (A \ s)) = 0)
  holds
    (C_Meas Mu).
      {x where x is Element of X :
        x in X & x in s &
        not (for N being Nat holds
          ex n being Nat st N c= n & iter(f,n).x in s)} = 0
proof
end;
::$P+
