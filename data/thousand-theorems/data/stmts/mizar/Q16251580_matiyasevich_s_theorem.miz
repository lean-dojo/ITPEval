:: Statement-only formalization of thousand-theorems corpus artifact Q16251580,
:: "Matiyasevich's theorem": a natural-number Pell-sequence pair is
:: characterized by Davis's Diophantine system of Pell equations,
:: congruences, inequalities, and divisibility. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      NUMBERS, XREAL_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1, ARYTM_3,
      SQUARE_1, REAL_1, INT_1, INT_2, NAT_1, VALUED_1, NEWTON;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1, INT_1,
      INT_2, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1, NEWTON, NAT_D;
 constructors FUNCT_1, RELSET_1, FUNCT_2, REAL_1, SQUARE_1, COMPLEX1,
      INT_1, INT_2, XXREAL_0, NAT_1, NEWTON, NAT_D;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
      FUNCT_2, NUMBERS, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
      XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, NEWTON;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,k,x,y being Nat holds
    ((1 < a &
      ex X,Y being Function of NAT,NAT st
        X.0 = 1 & Y.0 = 0 &
        (for n being Nat holds
          X.(n + 1) = X.n * a + (a * a -' 1) * Y.n &
          Y.(n + 1) = X.n + Y.n * a) &
        X.k = x & Y.k = y)
    iff
      1 < a & k <= y &
      ((x = 1 & y = 0) or
        ex u,v,s,t,b being Nat st
          x * x -' ((a * a -' 1) * y * y) = 1 &
          u * u -' ((a * a -' 1) * v * v) = 1 &
          s * s -' ((b * b -' 1) * t * t) = 1 &
          1 < b &
          b mod (4 * y) = 1 mod (4 * y) &
          b mod u = a mod u &
          0 < v &
          y * y divides v &
          s mod u = x mod u &
          t mod (4 * y) = k mod (4 * y)))
proof
end;
::$P+
