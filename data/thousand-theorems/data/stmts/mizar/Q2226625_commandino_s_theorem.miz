:: Statement-only formalization of Thousand Theorems corpus artifact Q2226625,
:: "Commandino's theorem": for a positive-dimensional simplex over a
:: characteristic-zero division ring, the vector from a vertex to the
:: centroid is the dimension times the vector from the centroid to the
:: opposite-face centroid. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_3, FINSEQ_4, RELAT_1, FUNCT_1,
      XBOOLE_0, SUBSET_1, TARSKI, STRUCT_0, ALGSTR_0, RLVECT_1, VECTSP_1,
      VECTSP_2, GROUP_1, PARTFUN1, ORDINAL1, RING_3, ARYTM_3, ARYTM_1,
      INT_1, XXREAL_0, XREAL_0, BINOP_1, FINSOP_1, MEMBERED, NEWTON, BINOM;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1,
      FUNCT_2, BINOP_1, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0,
      INT_1, NAT_1, FINSEQ_1, FINSEQ_3, FINSEQ_4, BINOM, STRUCT_0, ALGSTR_0,
      RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2, RING_3, FINSOP_1;
 constructors RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, NAT_1, FINSEQ_1,
      FINSEQ_3, FINSEQ_4, BINOP_1, BINOM, XREAL_0, XXREAL_0, STRUCT_0,
      ALGSTR_0, RLVECT_1, GROUP_1, VECTSP_1, VECTSP_2, RING_3, FINSOP_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1,
      RELSET_1, PARTFUN1, FINSEQ_1, FINSEQ_3, FINSEQ_4, NUMBERS, NAT_1,
      XREAL_0, XXREAL_0, MEMBERED, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1,
      VECTSP_1, VECTSP_2, BINOM, RING_3;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, STRUCT_0, RLVECT_1, ALGSTR_0, VECTSP_1,
      VECTSP_2, RING_3;
 equalities STRUCT_0, ALGSTR_0, FINSEQ_1;
 expansions TARSKI, STRUCT_0;

begin

::$P-
theorem
  for n being Nat, K being Skew-Field,
      V being LeftMod of K,
      p being FinSequence of the carrier of V, i being Nat st
    1 <= n &
    (for m being Nat, z being FinSequence of the carrier of K st
      1 <= m & len z = m &
      (for j being Nat st j in dom z holds z/.j = the OneF of K)
     holds (the addF of K) "**" z <> the ZeroF of K) &
    len p = n + 1 &
    (for w being FinSequence of the carrier of K,
         t being FinSequence of the carrier of V st
       len w = len p & len t = len p &
       (the addF of K) "**" w = the ZeroF of K &
       (for j being Nat st j in dom t holds
         t/.j = (w/.j) * (p/.j)) &
       (the addF of V) "**" t = the ZeroF of V
     holds
       for j being Nat st j in dom w holds w/.j = the ZeroF of K) &
    i in dom p
  holds
    ex a,b being Element of K,
       c,f being Element of V,
       r,s being FinSequence of the carrier of K,
       q,u,v being FinSequence of the carrier of V st
      len r = n + 1 &
      (for j being Nat st j in dom r holds r/.j = the OneF of K) &
      (the addF of K) "**" r = a &
      len s = n &
      (for j being Nat st j in dom s holds s/.j = the OneF of K) &
      (the addF of K) "**" s = b &
      q = Del(p,i) &
      len q = n &
      len u = len p &
      (for j being Nat st j in dom u holds
        u/.j = a" * (p/.j)) &
      (the addF of V) "**" u = c &
      len v = len q &
      (for j being Nat st j in dom v holds
        v/.j = b" * (q/.j)) &
      (the addF of V) "**" v = f &
      p/.i - c = b * (c - f)
proof
end;
::$P+
