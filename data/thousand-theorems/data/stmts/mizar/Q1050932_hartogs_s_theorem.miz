:: Statement-only formalization of thousand-theorems corpus artifact Q1050932
:: (thousand-theorems__mizar__Q1050932), "Hartogs's theorem": a separately
:: complex-analytic function on an open subset of the complex plane squared,
:: with values in a second-countable complex Banach space, is jointly
:: complex-analytic. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, FUNCT_1, ZFMISC_1, XCMPLX_0, FUNCOP_1,
      SUBSET_1, FUNCT_2, RELAT_1, PARTFUN1, CLVECT_1, STRUCT_0, RLVECT_1,
      LOPBAN_1, SUPINF_2, ARYTM_3, ARYTM_1, COMPLEX1, ALGSTR_0, MONOID_0,
      TARSKI, MSSUBFAM, UNIALG_1, RLSUB_1, RSSPACE, NAT_1, PRE_TOPC, SEQ_2,
      ORDINAL2, NORMSP_1, XXREAL_0, CARD_1, REAL_1, XXREAL_2, SEQ_4,
      REWRITE1, RSSPACE3, SEQ_1, VALUED_1, CLOPBAN1, METRIC_1, RELAT_2,
      FCONT_1, ASYMPT_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      PARTFUN1, FUNCT_2, FUNCT_3, PRE_TOPC, DOMAIN_1, FUNCOP_1, BINOP_1,
      XCMPLX_0, XXREAL_0, XXREAL_2, XREAL_0, COMPLEX1, REAL_1, ORDINAL1,
      NAT_1, STRUCT_0, ALGSTR_0, MONOID_0, NUMBERS, RLVECT_1, NORMSP_0,
      NORMSP_1, VALUED_1, SEQ_1, SEQ_2, SEQ_4, FUNCSDOM, CLVECT_1,
      CSSPACE, CSSPACE3, LOPBAN_1, VECTSP_1, CLOPBAN1;
 constructors DOMAIN_1, REAL_1, COMPLEX1, FUNCSDOM, MONOID_0, LOPBAN_1,
      CSSPACE3, SEQ_4, RELSET_1, BINOP_2, SEQ_2, COMSEQ_2, FUNCT_3,
      SEQ_1, CLOPBAN1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, RELSET_1, FUNCT_2, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, MEMBERED, STRUCT_0, MONOID_0, CLVECT_1,
      CSSPACE3, VALUED_1, VALUED_0, SEQ_4, FUNCT_1, NAT_1, SEQ_1, SEQ_2,
      CLOPBAN1;
 requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
 definitions FUNCT_1, ALGSTR_0, VECTSP_1, XXREAL_2;
 equalities BINOP_1, STRUCT_0, ALGSTR_0, NORMSP_0;
 expansions FUNCT_1, BINOP_1, NORMSP_0;

begin

reserve E for ComplexNormSpace;

::$P-
theorem
  for f being Function of [:COMPLEX,COMPLEX:], E,
      s being Subset of [:COMPLEX,COMPLEX:] st
    E is complete &
    (ex q being sequence of E st
      for x being Point of E, epsilon being Real st 0 < epsilon holds
        ex n being Nat st ||.q.n-x.|| < epsilon) &
    (for c0,c1 being Complex st [c0,c1] in s holds
      ex r being Real st 0 < r &
        for z0,z1 being Complex st
          max(|.z0-c0.|,|.z1-c1.|) < r holds [z0,z1] in s) &
    (for c0,c1 being Complex st [c0,c1] in s holds
      ex r being Real st 0 < r &
        for z0 being Complex st |.z0-c0.| < r holds
          ex d being Point of E st
            for epsilon being Real st 0 < epsilon holds
              ex delta being Real st 0 < delta &
                for h being Complex st h <> 0 & |.h.| < delta holds
                  ex y,y0 being Point of E st
                    y = f.(z0+h,c1) & y0 = f.(z0,c1) &
                    ||.y-y0-h*d.|| < epsilon*|.h.|) &
    (for c0,c1 being Complex st [c0,c1] in s holds
      ex r being Real st 0 < r &
        for z1 being Complex st |.z1-c1.| < r holds
          ex d being Point of E st
            for epsilon being Real st 0 < epsilon holds
              ex delta being Real st 0 < delta &
                for h being Complex st h <> 0 & |.h.| < delta holds
                  ex y,y0 being Point of E st
                    y = f.(c0,z1+h) & y0 = f.(c0,z1) &
                    ||.y-y0-h*d.|| < epsilon*|.h.|)
  holds
    for c0,c1 being Complex st [c0,c1] in s holds
      ex r being Real st 0 < r &
        for z0,z1 being Complex st
          max(|.z0-c0.|,|.z1-c1.|) < r holds
            ex d0,d1 being Point of E st
              for epsilon being Real st 0 < epsilon holds
                ex delta being Real st 0 < delta &
                  for h0,h1 being Complex st
                    (h0 <> 0 or h1 <> 0) &
                    max(|.h0.|,|.h1.|) < delta holds
                      ex y,y0 being Point of E st
                        y = f.(z0+h0,z1+h1) & y0 = f.(z0,z1) &
                        ||.y-y0-h0*d0-h1*d1.||
                          < epsilon*max(|.h0.|,|.h1.|)
proof
end;
::$P+
