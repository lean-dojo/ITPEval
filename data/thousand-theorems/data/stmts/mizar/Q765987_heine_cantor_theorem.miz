:: Statement-only formalization of thousand-theorems corpus artifact
:: thousand-theorems__mizar__Q765987, "Heine–Cantor theorem": every
:: continuous function from a compact uniform space to an arbitrary uniform
:: space is uniformly continuous. This file contains no proof.

environ

 vocabularies ORDERS_2, CONNSP_2, GROUP_1, YELLOW_6, FINTOPO7, FINTOPO2,
      RELAT_2, REAL_1, METRIC_1, PRE_TOPC, FUNCT_1, STRUCT_0, CARD_1,
      XBOOLE_0, SUBSET_1, SETFAM_1, TARSKI, ZFMISC_1, RELAT_1, XXREAL_0,
      WAYBEL_0, NUMBERS, ARYTM_3, CANTOR_1, FILTER_0, XXREAL_1, ARYTM_1,
      PCOMPS_1, RCOMP_1, FINSUB_1, TOPGRP_1, BINOP_1, POLYNOM1, GROUP_1A,
      RLVECT_1, FCONT_2, FUNCOP_1, UNIFORM2, UNIFORM3, EQREL_1, PARTFUN1,
      SIMPLEX0, CARD_3, SRINGS_4, CAT_4, PROB_1, QC_LANG1, TOLER_1,
      ROUGHS_4, LATTICE7, MEASURE1, TOPGEN_4, DYNKIN, PROB_2, FINSET_1,
      LOPCLSET, FINSEQ_1, TOPS_2, TMAP_1;
 notations CANTOR_1, EQREL_1, TOLER_1, SIMPLEX0, TOPGEN_4, DYNKIN,
      SRINGS_4, ORDINAL1, IDEAL_1, TARSKI, RELAT_1, SETFAM_1, XXREAL_0,
      XBOOLE_0, RELSET_1, XREAL_0, FUNCT_1, ZFMISC_1, SUBSET_1, XCMPLX_0,
      STRUCT_0, METRIC_1, DOMAIN_1, MCART_1, CARDFIL2, FINSUB_1, FINTOPO2,
      PARTFUN1, TOPGRP_1, CONNSP_2, GROUP_1, GROUP_2, ALGSTR_0, FINTOPO7,
      PCOMPS_1, COMPTS_1, GROUP_1A, RLVECT_1, PRE_TOPC, TOPS_2, TMAP_1,
      UNIFORM2, RELAT_2,
      ROUGHS_4, LATTICE7, PROB_1, MEASURE1, ORDERS_2, FINSET_1, LOPCLSET,
      UNIFORM3;
 constructors CARDFIL2, TOPMETR, COMPTS_1, GROUP_2, PCOMPS_1, GROUP_1A,
      UNIFORM2, UNIFORM3, COHSP_1, CANTOR_1, TOPGEN_4, DYNKIN, SRINGS_4,
      ROUGHS_4, LATTICE7, MEASURE1, LOPCLSET, TOPS_2, TMAP_1;
 registrations CARDFIL2, FIN_TOPO, RELAT_1, ZFMISC_1, METRIC_1, XBOOLE_0,
      SUBSET_1, ORDINAL1, RELSET_1, XREAL_0, STRUCT_0, XXREAL_0, FINTOPO7,
      TOPGRP_1, GROUP_1, PCOMPS_1, GROUP_1A, XCMPLX_0, UNIFORM2, UNIFORM3,
      PARTFUN1, TOPGEN_4, PRE_TOPC, TOPS_2, TMAP_1, MEASURE1, FINSET_1,
      CANTOR_1;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, PRE_TOPC, UNIFORM2, UNIFORM3;
 equalities FINTOPO7, GROUP_1A, UNIFORM2, SRINGS_4, IDEAL_1, SUBSET_1,
      STRUCT_0, FINTOPO2, GROUP_2, PCOMPS_1, LOPCLSET;
 expansions CARDFIL2, TARSKI, XBOOLE_0, FINTOPO7, UNIFORM2, SETFAM_1,
      FINSUB_1, PRE_TOPC, ROUGHS_4, PROB_1, MEASURE1;

begin

::$P-
theorem
  (for US1 being UniformSpace,
       US2 being UniformSpace,
       f being Function of US1,US2 st
     US1 is empty
   holds f is uniformly_continuous) &
  (for US1 being non empty UniformSpace,
       US2 being non empty UniformSpace,
       f being Function of US1,US2 st
     TopSpace_induced_by(US1) is compact &
     (ex T1,T2 being TopSpace,
         g being Function of T1,T2 st
       T1 = TopSpace_induced_by(US1) &
       T2 = TopSpace_induced_by(US2) &
       g = f &
       (for P being Subset of T2 st P is closed holds
         g"P is closed Subset of T1))
   holds f is uniformly_continuous)
proof
end;
::$P+
