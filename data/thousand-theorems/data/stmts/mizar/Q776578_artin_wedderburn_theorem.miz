:: Statement-only formalization of Thousand Theorems corpus artifact Q776578, "Artin–Wedderburn theorem": every semisimple algebra is isomorphic, as an algebra over its commutative base semiring, to a finite product of nonzero-size square matrix algebras over division algebras. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, VECTSP_1, SUBSET_1, MATRIX_1, FINSEQ_2, ZFMISC_1,
      RELAT_1, TARSKI, CARD_1, ARYTM_3, FUNCT_1, FREEALG, FINSET_1, FINSEQ_1,
      MESFUNC1, GROUP_1, SUPINF_2, LAPLACE, XBOOLE_0, ARYTM_1, XXREAL_0,
      POLYNOM1, POLYNOM2, MATRIX_3, CARD_3, AFINSQ_1, ORDINAL4, POLYNOM3,
      STRUCT_0, PARTFUN1, RANKNULL, RLSUB_1, RLVECT_5, PRVECT_1, RLVECT_3,
      ALGSTR_0, VECTSP10, MATRLIN, MATRLIN2, POLYNOM5, NEWTON, MONOID_0,
      BINOP_1, RLVECT_1, LATTICES, RLSUB_2, FINSEQ_4, MCART_1, RLVECT_2,
      VALUED_1, FUNCT_2, VECTSP11, MSSUBFAM, UNIALG_1, NUMBER09, RING_1,
      FUNCSDOM, IDEAL_1, VECTSP_2;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS, CARD_1,
      XCMPLX_0, ALGSTR_0, XXREAL_0, FINSET_1, RELAT_1, FUNCT_1, PARTFUN1,
      FUNCT_2, NAT_1, FINSEQ_1, BINOP_1, STRUCT_0, RLVECT_1, GROUP_1, VECTSP_1,
      FINSEQ_2, MATRIX_0, MATRIX_1, NAT_D, GROUP_4, MATRIX_3, DOMAIN_1,
      MEASURE6, PRVECT_1, VECTSP_4, VECTSP_5, VECTSP_6, VECTSP_7, VECTSP_9,
      FINSEQOP, MATRIX13, MATRLIN, LAPLACE, MOD_2, RANKNULL, POLYNOM3,
      MONOID_0, ALGSEQ_1, POLYNOM4, POLYNOM5, MATRLIN2, RING_1, IDEAL_1,
      VECTSP_2;
 constructors FINSOP_1, GROUP_4, VECTSP_7, VECTSP_9, MATRIX13, REALSET1,
      LAPLACE, VECTSP_5, RANKNULL, MONOID_0, POLYNOM4, POLYNOM5, MATRLIN2,
      BINOP_2, RELSET_1, MATRIX_1, ALGSEQ_1, RING_1, IDEAL_1;
 registrations XBOOLE_0, FUNCT_1, FINSET_1, STRUCT_0, VECTSP_1, FUNCT_2,
      ORDINAL1, XXREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, SEQM_3, MATRIX13, XREAL_0,
      VECTSP_9, RANKNULL, POLYNOM3, POLYNOM5, MONOID_0, CARD_1, RELSET_1,
      MOD_2, GRCAT_1, PRVECT_1, MATRLIN2, RING_1, IDEAL_1;
 requirements ARITHM, NUMERALS, REAL, BOOLE, SUBSET;
 definitions TARSKI, XBOOLE_0, RING_1, IDEAL_1, VECTSP_1, ALGSTR_0;
 equalities STRUCT_0, RLVECT_1, FINSEQ_1, VECTSP_4, FVSUM_1, LAPLACE, MATRIX13,
      RANKNULL, VECTSP_6, MATRLIN2;
 expansions STRUCT_0, TARSKI, XBOOLE_0, VECTSP_4, RING_1, IDEAL_1, VECTSP_1;
 theorems ZFMISC_1, RLVECT_1, MATRIX_0, MATRIX_3, VECTSP_1, NAT_1, FINSEQ_1,
      FINSEQ_3, FINSEQ_2, CARD_1, CARD_2, FINSEQOP, FINSOP_1, FUNCT_1, FUNCT_2,
      FVSUM_1, GROUP_1, LAPLACE, MATRIX13, MATRIXR2, MATRLIN, ORDINAL1,
      PARTFUN1, RELAT_1, STIRL2_1, STRUCT_0, TARSKI, VECTSP_4, VECTSP_5,
      VECTSP_6, VECTSP_7, VECTSP_9, VECTSP10, XBOOLE_0, XBOOLE_1, XREAL_1,
      XXREAL_0, MOD_2, RANKNULL, MONOID_0, GROUP_4, SYSREL, SUBSET_1, FINSEQ_5,
      ALGSEQ_1, POLYNOM4, POLYNOM5, HILBASIS, MATRIXJ1, MATRLIN2, VALUED_0,
      NAT_D, RLVECT_2, MATRIX_1, FINSEQ_4, RING_1, IDEAL_1;
 schemes NAT_1, FUNCT_2;

begin

::$P-
theorem
  for R0 being Abelian add-associative right_zeroed commutative associative
      well-unital distributive non empty doubleLoopStr,
      R being Ring, a being Function of R0,R
  st (for s being Element of R0 holds
        s*(0.R0) = 0.R0 & (0.R0)*s = 0.R0) &
     a.(0.R0) = 0.R & a.(1.R0) = 1.R &
     (for s,t being Element of R0 holds
        a.(s+t) = a.s + a.t & a.(s*t) = (a.s)*(a.t)) &
     (for s being Element of R0, x being Element of R holds
        (a.s)*x = x*(a.s)) &
     (for I being LeftIdeal of R
        ex J being LeftIdeal of R st
          I /\ J = {0.R} &
          (for x being Element of R
            ex y,z being Element of R st
              y in I & z in J & x = y+z))
  holds
    ex n being Nat st
    ex D,d,H being Function st
    ex X being set st
    ex e being Function of the carrier of R,X st
      dom D = Seg n & dom d = Seg n & dom H = Seg n &
      (for i being Nat st i in Seg n holds
        ex K being Skew-Field st
        ex m being Nat st
        ex h being Function of R0,K st
          D.i = K & d.i = m & H.i = h & m <> 0 &
          h.(0.R0) = 0.K & h.(1.R0) = 1.K &
          (for s,t being Element of R0 holds
            h.(s+t) = h.s + h.t & h.(s*t) = (h.s)*(h.t)) &
          (for s being Element of R0, x being Element of K holds
            (h.s)*x = x*(h.s))) &
      (for q being object holds
        q in X iff
          ex p being Function st
            q = p & dom p = Seg n &
            (for i being Nat st i in Seg n holds
              ex K being Skew-Field st
              ex m being Nat st
              ex A being Matrix of m,K st
                D.i = K & d.i = m & p.i = A)) &
      e is one-to-one & rng e = X &
      (for x,y being Element of R
        ex fx,fy,fs,fp being Function st
          fx = e.x & fy = e.y & fs = e.(x+y) & fp = e.(x*y) &
          (for i being Nat st i in Seg n holds
            ex K being Skew-Field st
            ex m being Nat st
            ex A,B,S,P being Matrix of m,K st
              D.i = K & d.i = m &
              fx.i = A & fy.i = B & fs.i = S & fp.i = P &
              S = A+B & P = A*B)) &
      (for s being Element of R0
        ex fs being Function st
          fs = e.(a.s) &
          (for i being Nat st i in Seg n holds
            ex K being non degenerated almost_left_invertible Ring st
            ex m being Nat st
            ex h being Function of R0,K st
            ex A being Matrix of m,K st
              D.i = K & d.i = m & H.i = h & fs.i = A &
              (for j,k being Nat st [j,k] in Indices A holds
                (j = k implies A*(j,k) = h.s) &
                (j <> k implies A*(j,k) = 0.K))))
proof
end;
::$P+
