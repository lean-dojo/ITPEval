:: Statement-only formalization of thousand-theorems corpus artifact Q5171652,
:: "Corners theorem": a sufficiently dense finite subset of the square
:: {0,...,n-1} x {0,...,n-1}, beyond the explicit regularity bound, contains
:: a nontrivial additive corner. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, REAL_1, INT_1, NAT_1, ORDINAL1, VALUED_0,
    VALUED_1, FINSET_1, SIN_COS, NEWTON, PREPOWER, POWER;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, COMPLEX1, XXREAL_0, NAT_1, NEWTON, PREPOWER,
    POWER, VALUED_0, FINSET_1, SIN_COS;
  constructors FUNCT_1, RELSET_1, FUNCT_2, CARD_1, REAL_1, INT_1,
    COMPLEX1, XXREAL_0, NAT_1, NEWTON, PREPOWER, POWER, FINSET_1,
    SIN_COS, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, NEWTON, PREPOWER,
    POWER, FINSET_1, SIN_COS;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for epsilon being Real, n being Nat,
      A being finite Subset of [:NAT,NAT:] st
    0 < epsilon &
    (ex c,f,t,i,u,r,q being Nat,
        s being Function of NAT,NAT,
        e5,d,ell,log4,triangleBound being Real st
      0 < c &
      (((c -' 1) qua Real) < 324 / epsilon &
        324 / epsilon <= (c qua Real)) &
      e5 = (epsilon / 648) * (epsilon / 648) *
        (epsilon / 648) * (epsilon / 648) * (epsilon / 648) &
      exp_R.ell = 100 / e5 &
      exp_R.log4 = 4 &
      ((f = 0 &
          ell / log4 < 1) or
        ((f qua Real) <= ell / log4 &
          ell / log4 <
            ((f + 1) qua Real))) &
      i = max(7,max(c,f + 1)) &
      ((t = 0 & 4 / e5 < 1) or
        ((t qua Real) <= 4 / e5 &
          4 / e5 < ((t + 1) qua Real))) &
      s.0 = i &
      (for j being Nat holds
        s.(j + 1) = s.j * (4 |^ s.j)) &
      u = s.t &
      r = u * (16 |^ u) &
      d = epsilon / (1296 * (r qua Real)) &
      triangleBound =
        min(1 / (2 * ((c * c * c) qua Real)),
          (1 - min(1,epsilon / 81) / 4) *
            d * d * d) &
      ((q = 0 & 1 / (triangleBound * 27) < 1) or
        ((q qua Real) <= 1 / (triangleBound * 27) &
          1 / (triangleBound * 27) < ((q + 1) qua Real))) &
      q + 1 <= n) &
    A c= [:Segm n,Segm n:] &
    epsilon * (n qua Real) * (n qua Real) <= (card A qua Real)
  holds
    ex x1,y1,x2,y2 being Nat st
      [x1,y1] in A &
      [x1,y2] in A &
      [x2,y1] in A &
      x1 + y2 = x2 + y1 &
      x1 <> x2
proof
end;
::$P+
