:: Statement-only formalization of thousand-theorems corpus artifact Q3527166,
:: "Steinhaus theorem": in a locally compact topological group, the quotient
:: set E / E of a measurable positive-measure set is a neighborhood of the
:: identity for an inner-regular Haar measure. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, RELAT_1,
      FUNCT_1, FUNCT_2, CARD_1, STRUCT_0, ALGSTR_0, GROUP_1, PRE_TOPC,
      TOPS_1, TOPS_2, CONNSP_2, COMPTS_1, RCOMP_1, COMPACT1, WAYBEL_3,
      TOPGRP_1,
      SETFAM_1,
      PROB_1, MEASURE1, MEASURE4, MEASURE8, TOPGEN_4, XXREAL_0, XXREAL_2,
      SUPINF_1, SUPINF_2, REAL_1, ARYTM_1, ARYTM_3, MEMBERED;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0, XXREAL_2, XXREAL_3, XREAL_0, REAL_1, EXTREAL1,
      STRUCT_0, ALGSTR_0, PRE_TOPC,
      GROUP_1, GROUP_2, TOPS_1, TOPS_2, COMPTS_1, WAYBEL_3,
      TOPGRP_1, PROB_1, MEASURE1, MEASURE4, MEASURE8, TOPGEN_4,
      SUPINF_1, SUPINF_2;
 constructors RELSET_1, REAL_1, EXTREAL1, TOPS_1, TOPS_2, CONNSP_2,
      COMPTS_1, GROUP_2, TOPGRP_1, COMPACT1, WAYBEL_3, PROB_1, MEASURE1,
      MEASURE4, MEASURE8, TOPGEN_4, SUPINF_1, SUPINF_2;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, ORDINAL1, NUMBERS, XREAL_0,
      MEMBERED, FUNCT_1, FUNCT_2, CARD_1, STRUCT_0, ALGSTR_0, PRE_TOPC,
      TOPS_1, GROUP_1, COMPTS_1, MEASURE1, MEASURE4, XXREAL_0, XXREAL_3;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, PRE_TOPC, GROUP_1, STRUCT_0, TOPS_1,
      TOPS_2;
 equalities STRUCT_0, ALGSTR_0, XBOOLE_0, SUBSET_1, GROUP_2;
 expansions TARSKI, XBOOLE_0, PRE_TOPC, TOPS_1, TOPS_2;

begin

::$P-
theorem
  for G being TopologicalGroup,
      Sigma being SigmaField of the carrier of G,
      M being sigma_Measure of Sigma,
      E being Subset of G st
    G is locally-compact &
    Sigma = BorelSets G &
    (for a being Element of G, A being Subset of G holds
      (C_Meas M).(a * A) = (C_Meas M).A) &
    (for K being Subset of G st K is compact holds
      (C_Meas M).K < +infty) &
    (for U being open Subset of G st U <> {} holds
      0. < (C_Meas M).U) &
    (for A being Element of Sigma, r being ExtReal st
      0. <= r & r < (C_Meas M).A holds
        ex K being Subset of G st
          K is compact & K c= A & r < (C_Meas M).K) &
    E in Sigma &
    0. < (C_Meas M).E
  holds 1_G in Int(E * E")
proof
end;
::$P+
