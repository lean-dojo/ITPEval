:: Statement-only formalization of Thousand Theorems corpus artifact Q510197
:: (thousand-theorems__mizar__Q510197), "Tutte theorem": a finite simple graph
:: has a perfect matching exactly when deleting any vertex subset leaves at
:: most that many odd connected components. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELAT_2,
    REWRITE1, EQREL_1, FINSET_1, CARD_1, NAT_1, NUMBERS, ORDINAL1,
    XCMPLX_0, ARYTM_1, ARYTM_3, ABIAN, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    RELAT_2, REWRITE1, EQREL_1, FINSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XXREAL_0, NAT_1, ABIAN;
  constructors RELAT_1, RELSET_1, RELAT_2, REWRITE1, EQREL_1, FINSET_1,
    NUMBERS, NAT_1, ABIAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FINSET_1, CARD_1,
    ORDINAL1, NUMBERS, XCMPLX_0, NAT_1, ABIAN;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for V being finite set, E being Relation of V st
    E is symmetric irreflexive
  holds
    (ex M being Relation of V st
      M c= E & M is symmetric &
      for x being object st x in V holds
        ex y being object st y in V & [x,y] in M &
          for z being object st z in V & [x,z] in M holds z = y)
    iff
    for U being Subset of V holds
      ex R being Equivalence_Relation of (V \ U) st
        (for x,y being object holds
          ([x,y] in R iff
            x in V \ U & y in V \ U &
            (E /\ [:(V \ U),(V \ U):]) reduces x,y)) &
        card {C where C is Element of Class R :
          ex n being Nat st card C = 2*n+1} c= card U
proof
end;
::$P+
