:: Statement-only formalization of "Friendship theorem" from Thousand
:: Theorems artifact Q5504427: every finite nonempty simple undirected graph
:: in which each pair of distinct vertices has exactly one common neighbor
:: has a vertex adjacent to every other vertex. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
      FINSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
      FUNCT_1, RELSET_1, FINSET_1;
  constructors RELAT_1, FUNCT_1, FINSET_1, RELSET_1, XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FINSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for V being non empty finite set, F being Relation of V st
    (for x being Element of V holds not [x,x] in F) &
    (for x,y being Element of V st [x,y] in F holds [y,x] in F) &
    (for x,y being Element of V st x <> y holds
      ex z being Element of V st
        [x,z] in F & [y,z] in F &
        (for w being Element of V st [x,w] in F & [y,w] in F holds
          w = z))
  holds ex u being Element of V st
    for v being Element of V st v <> u holds [u,v] in F
proof
end;
::$P+
