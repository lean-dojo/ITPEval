:: Statement-only formalization of thousand-theorems corpus artifact Q1568811,
:: "Hahn decomposition theorem": every real-valued signed measure on a
:: sigma-field admits complementary measurable positive and negative sets.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, ZFMISC_1, PROB_1,
    PROB_2, FUNCT_1, FUNCT_2, RELAT_1, NUMBERS, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, CARD_1, ORDINAL1, ORDINAL2, NAT_1, REAL_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SERIES_1, MEASURE1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, XXREAL_0, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NAT_1, VALUED_0, VALUED_1, SEQ_1, SEQ_2, COMSEQ_2,
    SETFAM_1, PROB_1, PROB_2, MEASURE1, SERIES_1;
  constructors ZFMISC_1, FUNCT_1, RELSET_1, FUNCT_2, REAL_1, XXREAL_0,
    NAT_1, SEQ_1, SEQ_2, COMSEQ_2, SETFAM_1, PROB_1, PROB_2,
    MEASURE1, SERIES_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, XXREAL_0, XREAL_0, ORDINAL1, NAT_1, VALUED_0,
    VALUED_1, SEQ_1, SEQ_2, PROB_1, MEASURE1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI, XBOOLE_0;
  equalities XBOOLE_0;
  expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for X being set,
      S being SigmaField of X,
      s being Function of S,REAL st
    s.{} = 0 &
    (for F being Sep_Sequence of S holds
      ex a being Real_Sequence st
        a = s*F &
        a is summable &
        s.(union rng F) = lim Partial_Sums(a))
  holds
    ex P,N being Element of S st
      P \/ N = X &
      P misses N &
      (for A being Element of S st A c= P holds 0 <= s.A) &
      (for A being Element of S st A c= N holds s.A <= 0)
proof
end;
::$P+
