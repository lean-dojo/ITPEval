:: Statement-only formalization of thousand-theorems corpus artifact Q1227702,
:: "Dirichlet's unit theorem": the units of the ring of integers of a number
:: field, modulo roots of unity, form a free abelian group whose rank is one
:: less than the number of infinite places. This file contains no proof.

environ

 vocabularies ARYTM_3, ARYTM_1, VECTSP_1, ALGSTR_0, TARSKI, STRUCT_0, SUBSET_1,
      GROUP_1, GROUP_4, GROUP_5, GROUP_6, NAT_1, INT_1, INT_3, FUNCT_1,
      FUNCT_2,
      RELAT_1,
      PARTFUN1, FINSEQ_1, CARD_1, CARD_3, XBOOLE_0, NUMBERS, ORDINAL1,
      ZFMISC_1, RLVECT_1, RING_2, RING_3, FIELD_1, FIELD_4, ALGNUM_1,
      COMPLEX1, COMPLFLD, UNIROOTS, XXREAL_0, FINSET_1, EQREL_1, RAT_1,
      GAUSSINT, FUNCSDOM, MSSUBFAM, XCMPLX_0, NEWTON;
 notations TARSKI, XBOOLE_0, SUBSET_1, DOMAIN_1, RELAT_1, RELSET_1, FUNCT_1,
      ORDINAL1, FUNCT_2, ZFMISC_1, PARTFUN1, STRUCT_0, CARD_1, NUMBERS,
      XCMPLX_0, XXREAL_0, NAT_1, INT_1, INT_3, RAT_1, FINSET_1, FINSEQ_1,
      COMPLEX1,
      ALGSTR_0, RLVECT_1, VECTSP_1, GROUP_1, GROUP_4, GROUP_5, RING_2,
      GROUP_6, RING_3, FIELD_1, FIELD_4, COMPLFLD, ALGNUM_1, UNIROOTS,
      GAUSSINT;
 constructors RELSET_1, NAT_1, FINSEQ_1, GROUP_4, GROUP_5, RING_2, RING_3,
      INT_3,
      FIELD_1, FIELD_4, COMPLFLD, ALGNUM_1, UNIROOTS, RAT_1, GAUSSINT;
 registrations XBOOLE_0, ORDINAL1, RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0,
      NAT_1, INT_1, INT_3, MEMBERED, STRUCT_0, VECTSP_1, FINSEQ_1, ALGSTR_0,
      RLVECT_1, FUNCT_1, FUNCT_2, CARD_1, FINSET_1, GROUP_1, GROUP_4, RAT_1,
      RING_2, RING_3, FIELD_1, FIELD_4, COMPLFLD, ALGNUM_1, UNIROOTS,
      GAUSSINT;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_1, FUNCT_2, GROUP_1, GROUP_6, RING_2;
 equalities STRUCT_0, ALGSTR_0, GROUP_1, GROUP_4, RING_2, INT_3;
 expansions TARSKI, XBOOLE_0, FUNCT_1, FUNCT_2, STRUCT_0, GROUP_1, GROUP_6,
      RING_2;

begin

::$P-
theorem
  for F being Field, K being FieldExtension of F
  st F = F_Rat & K is F-finite
  holds
    ex E,P being finite set,
      U being FinSequence of the carrier of MultGroup K st
      E = {f where f is Function of K,F_Complex :
        f is additive multiplicative unity-preserving} &
      P = {C where C is Subset of E :
        ex f being Function of K,F_Complex st f in E &
          C = {g where g is Function of K,F_Complex :
            g in E &
            (g = f or
              for a being Element of K holds g.a = (f.a)*')}} &
      len U = card P - 1 &
      (for j being Nat st j in dom U holds
        ex u being Element of K st u = U/.j &
          u is_integral_over INT.Ring & u" is_integral_over INT.Ring) &
      for x being Element of MultGroup K st
        ex a being Element of K st a = x &
          a is_integral_over INT.Ring & a" is_integral_over INT.Ring
      holds
        ex z being Element of MultGroup K,
           I being FinSequence of INT st
          (ex b being Element of K st b = z &
            b is_integral_over INT.Ring & b" is_integral_over INT.Ring) &
          (ex n being non zero Nat st
            z |^ n = 1_(MultGroup K)) &
          len I = len U &
          x = z * Product(U |^ I) &
          for z1 being Element of MultGroup K,
              I1 being FinSequence of INT st
            (ex b1 being Element of K st b1 = z1 &
              b1 is_integral_over INT.Ring &
              b1" is_integral_over INT.Ring) &
            (ex n1 being non zero Nat st
              z1 |^ n1 = 1_(MultGroup K)) &
            len I1 = len U &
            x = z1 * Product(U |^ I1)
          holds z1 = z & I1 = I
proof
end;
::$P+
