:: Statement-only formalization of Thousand Theorems artifact Q764287
:: (thousand-theorems__mizar__Q764287), "Van der Waerden's theorem": every
:: finite subset of a finitely colored additive commutative monoid has a
:: monochromatic homothetic copy with positive natural dilation. This file
:: contains no proof.

environ

 vocabularies NUMBERS, NAT_1, INT_1, CARD_1, REAL_1, XCMPLX_0, XXREAL_0,
      RLVECT_1, ALGSTR_0, BINOP_1, VECTSP_1, LATTICES, XBOOLE_0,
      SUBSET_1, ARYTM_1, RELAT_1, ARYTM_3, SUPINF_2, GROUP_1,
      STRUCT_0, TARSKI, REALSET1, ZFMISC_1, FUNCT_1, MESFUNC1,
      FINSET_1, NEWTON, ORDINAL1, BINOM;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, REALSET1,
      FUNCT_1, FUNCT_2, FINSET_1, CARD_1, ORDINAL1, NUMBERS, XCMPLX_0,
      XXREAL_0, XREAL_0, INT_1, NAT_1, STRUCT_0, ALGSTR_0, DOMAIN_1,
      BINOP_1, RLVECT_1, GROUP_1, VECTSP_1, INT_2, BINOM;
 constructors PARTFUN1, BINOP_1, REALSET1, ORDINAL1, NAT_1, FINSET_1,
      XXREAL_0, REAL_1, NAT_D, VECTSP_1, RLVECT_1, RELSET_1, GROUP_1,
      BINOM;
 registrations XBOOLE_0, SUBSET_1, FUNCT_1, REALSET1, ORDINAL1, NUMBERS,
      XREAL_0, INT_1, CARD_1, STRUCT_0, VECTSP_1, RELAT_1, ALGSTR_0,
      NAT_1, FINSET_1;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, RLVECT_1, XBOOLE_0, ALGSTR_0, VECTSP_1;
 equalities ORDINAL1, BINOP_1, REALSET1, STRUCT_0, ALGSTR_0, VECTSP_1;
 expansions TARSKI, XBOOLE_0, STRUCT_0;

begin

::$P-
theorem
  for M being Abelian add-associative right_zeroed non empty addLoopStr,
      K being non empty finite set,
      S being finite Subset of the carrier of M,
      C being Function of the carrier of M,K
  holds
    ex a being Nat st
      0 < a &
      ex b being Element of M, c being Element of K st
        for s being Element of M st s in S holds
          C.(a * s + b) = c
proof
end;
::$P+
