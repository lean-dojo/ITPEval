:: Statement-only formalization of thousand-theorems corpus artifact Q245098,
:: "Intermediate value theorem": a continuous map from a closed interval in a
:: densely ordered conditionally complete linear order to a linearly ordered
:: space with closed order takes every value between its endpoint values.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, FUNCT_1,
    FUNCT_2, ZFMISC_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, SETFAM_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, ZFMISC_1;
  constructors SETFAM_1, RELSET_1, FUNCT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2;
  requirements SUBSET, BOOLE;
  definitions TARSKI;
  expansions TARSKI;

begin

::$P-
theorem
  for A,D being non empty set,
      leA being Relation of A,A,
      leD being Relation of D,D,
      TA being Subset-Family of A,
      TD being Subset-Family of D,
      f being Function of A,D,
      a,b being Element of A st
    (for x being Element of A holds [x,x] in leA) &
    (for x,y being Element of A st
      [x,y] in leA & [y,x] in leA holds x = y) &
    (for x,y,z being Element of A st
      [x,y] in leA & [y,z] in leA holds [x,z] in leA) &
    (for x,y being Element of A holds
      [x,y] in leA or [y,x] in leA) &
    (for x,y being Element of A st
      [x,y] in leA & not [y,x] in leA holds
        ex z being Element of A st
          [x,z] in leA & not [z,x] in leA &
          [z,y] in leA & not [y,z] in leA) &
    (for S being Subset of A st
      S <> {} &
      (ex u being Element of A st
        for x being Element of A st x in S holds [x,u] in leA)
      holds ex m being Element of A st
        (for x being Element of A st x in S holds [x,m] in leA) &
        (for u being Element of A st
          (for x being Element of A st x in S holds [x,u] in leA)
          holds [m,u] in leA)) &
    (for S being Subset of A st
      S <> {} &
      (ex l being Element of A st
        for x being Element of A st x in S holds [l,x] in leA)
      holds ex m being Element of A st
        (for x being Element of A st x in S holds [m,x] in leA) &
        (for l being Element of A st
          (for x being Element of A st x in S holds [l,x] in leA)
          holds [l,m] in leA)) &
    {} in TA & A in TA &
    (for U,V being Subset of A st U in TA & V in TA holds U /\ V in TA) &
    (for G being Subset-Family of A st G c= TA holds union G in TA) &
    (for x being Element of A holds
      {z where z is Element of A :
        [z,x] in leA & not [x,z] in leA} in TA) &
    (for x being Element of A holds
      {z where z is Element of A :
        [x,z] in leA & not [z,x] in leA} in TA) &
    (for T being Subset-Family of A st
      {} in T & A in T &
      (for U,V being Subset of A st U in T & V in T holds U /\ V in T) &
      (for G being Subset-Family of A st G c= T holds union G in T) &
      (for x being Element of A holds
        {z where z is Element of A :
          [z,x] in leA & not [x,z] in leA} in T) &
      (for x being Element of A holds
        {z where z is Element of A :
          [x,z] in leA & not [z,x] in leA} in T)
      holds TA c= T) &
    (for x being Element of D holds [x,x] in leD) &
    (for x,y being Element of D st
      [x,y] in leD & [y,x] in leD holds x = y) &
    (for x,y,z being Element of D st
      [x,y] in leD & [y,z] in leD holds [x,z] in leD) &
    (for x,y being Element of D holds
      [x,y] in leD or [y,x] in leD) &
    {} in TD & D in TD &
    (for U,V being Subset of D st U in TD & V in TD holds U /\ V in TD) &
    (for G being Subset-Family of D st G c= TD holds union G in TD) &
    (for x,y being Element of D st not [x,y] in leD holds
      ex U,V being Subset of D st
        U in TD & V in TD & x in U & y in V &
        (for u,v being Element of D st u in U & v in V holds
          not [u,v] in leD)) &
    [a,b] in leA &
    (for x being Element of A st
      [a,x] in leA & [x,b] in leA holds
      for V being Subset of D st V in TD & f.x in V holds
        ex U being Subset of A st
          U in TA & x in U &
          (for z being Element of A st
            [a,z] in leA & [z,b] in leA & z in U holds f.z in V))
  holds
    for y being Element of D st
      [f.a,y] in leD & [y,f.b] in leD holds
      ex x being Element of A st
        [a,x] in leA & [x,b] in leA & f.x = y
proof
end;
::$P+
