:: Statement-only formalization of thousand-theorems corpus artifact Q530152
:: (thousand-theorems__mizar__Q530152), "Picard&ndash;Lindelöf theorem":
:: existence of a local solution to a
:: time-dependent ordinary differential equation on a real Banach space under
:: the Picard-Lindelöf Lipschitz, continuity, boundedness, and interval-size
:: hypotheses. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, PROB_1, MEASURE1, SUBSET_1, SEQFUNC,
      MESFUNC5, PARTFUN1, XXREAL_0, XXREAL_1, XXREAL_2, NAT_1, RELAT_1,
      ARYTM_3, ARYTM_1, FUNCT_1, ORDINAL2, CARD_1, COMPLEX1, SEQ_2,
      TARSKI, REAL_1, PBOOLE, MESFUNC1, MESFUNC2, VALUED_1, ZFMISC_1,
      FUNCT_2, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1, NORMSP_0, NORMSP_1,
      HAHNBAN, HAHNBAN1, DUALSP01, FINSET_1, BINOP_1, INTEGRA5, LOPBAN_1,
      RSSPACE3, FCONT_1, MEASURE5, MEASUR12, RCOMP_1, REALSET1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XXREAL_3, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, XXREAL_0, XXREAL_1,
      XXREAL_2, VALUED_0, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1,
      NAT_1, PROB_1, MEASURE1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5,
      MESFUNC6, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1, NORMSP_0,
      NORMSP_1, HAHNBAN, HAHNBAN1, DUALSP01, FINSET_1, BINOP_1, RSSPACE3,
      LOPBAN_1, RCOMP_1, MEASURE5, MEASUR12, INTEGRA5;
 constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6,
      RELSET_1, COMPLEX1, NORMSP_1, HAHNBAN, HAHNBAN1, DUALSP01,
      FINSET_1, BINOP_1, RSSPACE3, LOPBAN_1, RCOMP_1, MEASURE5, MEASUR12,
      INTEGRA5;
 registrations SUBSET_1, NAT_1, XREAL_0, MEMBERED, ORDINAL1, PARTFUN1,
      MEASURE1, FUNCT_2, RELAT_1, XBOOLE_0, NUMBERS, XXREAL_0, XCMPLX_0,
      FUNCT_1, VALUED_0, XXREAL_3, XXREAL_1, XXREAL_2, RELSET_1, STRUCT_0,
      ALGSTR_0, RLVECT_1, NORMSP_0, NORMSP_1, HAHNBAN, HAHNBAN1,
      DUALSP01, FINSET_1, RSSPACE3, LOPBAN_1, MEASURE5, MEASUR12,
      INTEGRA1, RCOMP_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, MESFUNC5, MESFUNC6, NORMSP_0,
      NORMSP_1, HAHNBAN, HAHNBAN1, RSSPACE3, LOPBAN_1;
 equalities XBOOLE_0, RLVECT_1, STRUCT_0, ALGSTR_0, NORMSP_0, BINOP_1,
      RCOMP_1, INTEGRA5;
 expansions TARSKI, XBOOLE_0, FUNCT_2, NORMSP_0, NORMSP_1;

begin

::$P-
theorem
  for X being RealBanachSpace,
      f being Function of [:REAL,the carrier of X:],the carrier of X,
      tmin,tmax,t0 being Real,
      x0,x being Point of X,
      a,r,L,K being Real st
    0 <= a & 0 <= r & 0 <= L & 0 <= K &
    tmin <= t0 & t0 <= tmax &
    (for t being Real st tmin <= t & t <= tmax holds
      for y,z being Point of X st
        ||.y-x0.|| <= a & ||.z-x0.|| <= a
      holds
        ||. f/.[t,y] - f/.[t,z] .|| <= K * ||.y-z.||) &
    (for y being Point of X st ||.y-x0.|| <= a holds
      for t being Real st tmin <= t & t <= tmax holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st
            0 < delta &
            for s being Real st
              tmin <= s & s <= tmax & |.s-t.| < delta
            holds
              ||. f/.[s,y] - f/.[t,y] .|| < epsilon) &
    (for t being Real st tmin <= t & t <= tmax holds
      for y being Point of X st ||.y-x0.|| <= a holds
        ||. f/.[t,y] .|| <= L) &
    L * max(tmax-t0,t0-tmin) <= a-r &
    ||.x-x0.|| <= r
  holds
    ex alpha being Function of REAL,the carrier of X st
      alpha.t0 = x &
      for t being Real st tmin <= t & t <= tmax holds
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st
            0 < delta &
            for s being Real st
              tmin <= s & s <= tmax & |.s-t.| < delta
            holds
              ||. (alpha/.s-alpha/.t) -
                (s-t)*(f/.[t,alpha/.t]) .|| <= epsilon * |.s-t.|
proof
end;
::$P+
