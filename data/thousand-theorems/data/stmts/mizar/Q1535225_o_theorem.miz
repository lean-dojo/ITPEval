:: Statement-only formalization of thousand-theorems corpus artifact Q1535225,
:: "Łoś' theorem": a first-order sentence holds in an ultraproduct exactly
:: when the set of indices whose factor structures satisfy it belongs to the
:: ultrafilter. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, NUMBERS, NAT_1, RELAT_1,
      RELAT_2, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2, PARTFUN1, CARD_1,
      CARD_3, ORDINAL1, ORDINAL4, ARYTM_1, ARYTM_3, XCMPLX_0, XXREAL_0,
      COMPLEX1, MONOID_0, EQREL_1, XBOOLEAN, MARGREL1, FUNCT_3, FUNCT_4,
      FUNCOP_1, FINSET_1, PRE_POLY, MATROID0, RELSET_2, STRUCT_0, LATTICES,
      LATTICE3, YELLOW_0, YELLOW_1, FILTER_0, WAYBEL_7, FOMODEL0, FOMODEL1,
      FOMODEL2, FOMODEL3;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, DOMAIN_1, RELAT_1, RELSET_1,
      RELSET_2, FUNCT_1, PARTFUN1, FUNCT_2, FUNCOP_1, FUNCT_4, ORDINAL1,
      CARD_1, CARD_3, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1, INT_2, FINSEQ_1,
      FINSEQ_2, FINSEQOP, EQREL_1, FINSET_1, MARGREL1, PRE_POLY, RELAT_2,
      MATROID0, MONOID_0, STRUCT_0, LATTICES, LATTICE3, YELLOW_0, YELLOW_1,
      FILTER_0, WAYBEL_7, XBOOLEAN, BVFUNC_1, FOMODEL0, FOMODEL1, FOMODEL2,
      FOMODEL3;
 constructors TARSKI, XBOOLE_0, ZFMISC_1, CARD_1, CARD_3, NAT_1, NUMBERS,
      INT_1, FINSEQ_1, XCMPLX_0, FUNCT_1, XXREAL_0, RELAT_2, FUNCT_2,
      FUNCT_4, FUNCOP_1, FINSEQ_2, EQREL_1, RELSET_1, MCART_1, PARTFUN1,
      FINSEQOP, MATRIX_1, FUNCT_3, SETFAM_1, FINSET_1, MARGREL1, RELSET_2,
      MATROID0, LEXBFS, BINOP_1, XBOOLEAN, FUNCT_5, MONOID_0, STRUCT_0,
      LATTICES, LATTICE3, YELLOW_0, YELLOW_1, FILTER_0, WAYBEL_7, FOMODEL0,
      FOMODEL1, FOMODEL2, FOMODEL3, BVFUNC_1;
 registrations ORDINAL1, NAT_1, RELAT_1, FUNCT_1, INT_1, FINSEQ_1, XREAL_0,
      FUNCT_2, FINSEQ_2, SUBSET_1, FUNCOP_1, RELSET_1, PARTFUN1, EQREL_1,
      CARD_1, CARD_3, XBOOLE_0, XXREAL_0, SETFAM_1, MARGREL1, FINSET_1,
      PRE_POLY, STRUCT_0, LATTICES, LATTICE3, YELLOW_0, YELLOW_1, FILTER_0,
      WAYBEL_7, FOMODEL0, FOMODEL1, FOMODEL2, FOMODEL3;
 requirements ARITHM, BOOLE, NUMERALS, REAL, SUBSET;
 definitions TARSKI, XBOOLE_0, RELAT_1, RELAT_2, FUNCT_1, EQREL_1, LATTICES,
      FOMODEL2, FOMODEL3;
 equalities TARSKI, XBOOLE_0, RELAT_1, FUNCOP_1, EQREL_1, XBOOLEAN,
      STRUCT_0, LATTICES, FOMODEL0, FOMODEL1, FOMODEL2, FOMODEL3, ORDINAL1;
 expansions TARSKI, XBOOLE_0, RELAT_1, RELAT_2, FOMODEL1, FOMODEL2;
 theorems TARSKI, XBOOLE_0, XBOOLE_1, ZFMISC_1, FUNCT_1, FUNCT_2, RELAT_1,
      RELAT_2, RELSET_1, PARTFUN1, FINSEQ_1, FINSEQ_2, CARD_1, CARD_3,
      ORDINAL1, EQREL_1, FUNCT_4, FUNCOP_1, FINSET_1, LATTICES, LATTICE3,
      YELLOW_0, YELLOW_1, FILTER_0, WAYBEL_7, FOMODEL0, FOMODEL1, FOMODEL2,
      FOMODEL3;
 schemes FUNCT_1, FUNCT_2, FRAENKEL;

begin

::$P-
theorem
  for A being non empty set,
      S being Language,
      U being non-empty Function,
      I being Function,
      F being set,
      E being Equivalence_Relation of product U,
      K being E-respecting (S,product U)-interpreter-like Function,
      Q being Element of (Class E)-InterpretersOf S,
      phi being wff string of S st
    dom U = A &
    (for i being Element of A holds U.i is non empty set) &
    dom I = A &
    (for i being Element of A holds
      ex V being non empty set,
         J being Element of V-InterpretersOf S st
        V = U.i & J = I.i) &
    F c= bool A &
    A in F &
    not {} in F &
    (for B,C being Subset of A st B in F & C in F holds B /\ C in F) &
    (for B,C being Subset of A st B in F & B c= C holds C in F) &
    (for B being Subset of A holds B in F or A \ B in F) &
    (for x,y being Element of product U holds
      [x,y] in E iff
      {i where i is Element of A: x.i = y.i} in F) &
    (for o being own Element of S,
         p being FinSequence st p in dom (K.o) holds
      (o is relational implies
        ((K.o).p = TRUE iff
          {i where i is Element of A:
            ex V being non empty set,
               J being Element of V-InterpretersOf S,
               q being FinSequence st
              V = U.i & J = I.i &
              q in dom (J.o) &
              (for j being Nat st j in dom p holds
                ex x being Element of product U st
                  x = p.j & q.j = x.i) &
              (J.o).q = TRUE} in F)) &
      (not o is relational implies
        ex z being Element of product U st
          z = (K.o).p &
          for i being Element of A,
              V being non empty set,
              J being Element of V-InterpretersOf S st
            V = U.i & J = I.i
          holds
            ex q being FinSequence,
               v being Element of V st
              q in dom (J.o) &
              (for j being Nat st j in dom p holds
                ex x being Element of product U st
                  x = p.j & q.j = x.i) &
              v = (J.o).q & z.i = v)) &
    (for W being non empty set,
         H being Element of W-InterpretersOf S,
         l being literal Element of S,
         w being Element of W holds
      H-TruthEval phi = ((l,w) ReassignIn H)-TruthEval phi) &
    (for o being Element of OwnSymbolsOf S holds
      Q.o =
        ((K.o) qua E-respecting Interpreter of o,product U) quotient E)
  holds
    Q-TruthEval phi = TRUE iff
    {i where i is Element of A:
      ex V being non empty set,
         J being Element of V-InterpretersOf S st
        V = U.i & J = I.i & J-TruthEval phi = TRUE} in F
proof
end;
::$P+
