:: Statement-only formalization of thousand-theorems artifact Q203565
:: (thousand-theorems__mizar__Q203565), "Solutions of a general cubic
:: equation": Cardano's root characterization over a field with invertible
:: two and three, a primitive cube root of unity, and radical witnesses.
:: This file contains no proof.

environ
  vocabularies NUMBERS, CARD_1, FUNCT_1, RELAT_1, XBOOLE_0, ARYTM_3,
    SUBSET_1, ARYTM_1, XXREAL_0, INT_2, NAT_1, SUPINF_2, MESFUNC1,
    INT_1, VECTSP_1, STRUCT_0, RLVECT_1, ALGSTR_0, LATTICES, GROUP_1,
    BINOP_1, FUNCSDOM, VECTSP_2, TARSKI, NEWTON;
  notations TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, FUNCT_2,
    BINOP_1, DOMAIN_1, NUMBERS, XREAL_0, XCMPLX_0, XXREAL_0, NAT_1,
    INT_1, INT_2, STRUCT_0, ALGSTR_0, RLVECT_1, GROUP_1, VECTSP_1,
    VECTSP_2, NEWTON;
  constructors NAT_D, PEPIN, EUCLID, REALSET1, RELSET_1, BINOP_2,
    DOMAIN_1, BINOP_1, VECTSP_1, VECTSP_2, NEWTON;
  registrations STRUCT_0, XREAL_0, ORDINAL1, INT_1, RELAT_1, VECTSP_1,
    INT_3, SUBSET_1, XBOOLE_0, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  equalities ALGSTR_0;

begin

::$P-
theorem
  for K being Field,
      a,b,c,d,p,q,r,s,t,w,x being Element of K st
    1.K + 1.K <> 0.K &
    1.K + 1.K + 1.K <> 0.K &
    a <> 0.K &
    w * w * w = 1.K &
    w <> 1.K &
    p = ((1.K + 1.K + 1.K) * a * c - b * b) /
      ((1.K + 1.K + 1.K) * (1.K + 1.K + 1.K) * (a * a)) &
    p <> 0.K &
    q = ((1.K + 1.K + 1.K) * (1.K + 1.K + 1.K) * a * b * c -
      (1.K + 1.K) * (b * b * b) -
      (1.K + 1.K + 1.K) * (1.K + 1.K + 1.K) *
        (1.K + 1.K + 1.K) * (a * a) * d) /
      ((1.K + 1.K) * (1.K + 1.K + 1.K) * (1.K + 1.K + 1.K) *
        (1.K + 1.K + 1.K) * (a * a * a)) &
    r * r = q * q + p * p * p &
    s * s * s = q + r &
    t * s = p
  holds
    (a * (x * x * x) + b * (x * x) + c * x + d = 0.K iff
      x = s - t - b / ((1.K + 1.K + 1.K) * a) or
      x = s * w - t * (w * w) -
        b / ((1.K + 1.K + 1.K) * a) or
      x = s * (w * w) - t * w -
        b / ((1.K + 1.K + 1.K) * a))
proof
end;
::$P+
