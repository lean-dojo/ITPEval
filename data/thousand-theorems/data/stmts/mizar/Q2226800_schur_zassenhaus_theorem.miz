:: Statement-only formalization of thousand-theorems corpus artifact Q2226800
:: (thousand-theorems__mizar__Q2226800), "Schur-Zassenhaus theorem": a normal
:: subgroup whose natural-valued order is coprime to its natural-valued index
:: admits a subgroup giving unique left-complement factorization. This file
:: contains no proof.

environ

 vocabularies TARSKI, BINOP_2, BINOP_1, XBOOLE_0, FUNCT_1, RELAT_1, ALGSTR_0,
      FUNCOP_1, SUBSET_1, FUNCT_2, STRUCT_0, ZFMISC_1, CARD_1, CARD_3,
      MONOID_0, GROUP_1, GROUP_2, FINSEQ_1, GROUP_6, MSSUBFAM, RLVECT_2,
      PRE_TOPC, WELLORD1, AUTGROUP, ARYTM_1, ARYTM_3, GRAPH_1, FINSET_1,
      GROUP_4, EQREL_1, NATTRA_1, NEWTON, REALSET1, ORDINAL1, NUMBERS, NAT_1,
      XCMPLX_0, XXREAL_0, ABIAN, COUNTERS, MOD_4, EXCHSORT, INT_1, GROUP_5,
      GR_CY_1, INT_2;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, ZFMISC_1, REALSET1,
      ORDINAL1, CARD_1, FINSET_1, CARD_3, FINSEQ_1, RELSET_1, PARTFUN1,
      FUNCT_2, NUMBERS, XCMPLX_0, XXREAL_0, ABIAN, COUNTERS, INT_1, INT_2,
      NAT_D,
      STRUCT_0, ALGSTR_0, MONOID_0, GROUP_1, GR_CY_1, GROUP_2, GROUP_3,
      GROUP_4, GROUP_5, GROUP_6, PRALG_1, BINOP_1, AUTGROUP, GROUP_7, GROUP_22;
 constructors BINOP_2, REALSET1, ABIAN, COUNTERS, GROUP_4, GROUP_5, MONOID_0,
      PRALG_1, RELSET_1, AUTGROUP, GROUP_7, NAT_D, GROUP_22;
 registrations XBOOLE_0, RELAT_1, FUNCT_1, FINSEQ_1, STRUCT_0, GROUP_1,
      GROUP_2, GROUP_3, MONOID_0, XREAL_0, ORDINAL1, INT_1, RELSET_1, FUNCT_2,
      NAT_1, NUMBERS, XXREAL_0, CARD_1, ABIAN, NEWTON03, COUNTERS, FUNCOP_1,
      GROUP_6, CARD_2, CARD_3, GROUP_7, GR_CY_1, GR_CY_2, TOPGRP_1, TOPALG_5,
      MOD_4, FOMODEL0, AUTGROUP;
 requirements NUMERALS, REAL, BOOLE, SUBSET, ARITHM;
 definitions GROUP_1;
 equalities STRUCT_0, ALGSTR_0, AUTGROUP, ORDINAL1, GROUP_2;
 expansions STRUCT_0, GROUP_1, TARSKI;
 theorems PRALG_1, FUNCT_1, CARD_3, FUNCT_2, BINOP_1, TARSKI, COUNTERS,
      GROUP_1, GROUP_2, GROUP_3, GROUP_4, GROUP_5, GROUP_6, FINSEQ_1, XBOOLE_0,
      MONOID_0, PARTFUN1, AUTGROUP, GROUP_7, GR_CY_1, GR_CY_2, XXREAL_0,
      ORDINAL3, ABIAN, NAT_1, NAT_2, XREAL_1, FINSET_1, NAT_D, GROUP_22,
      CARD_2, GROUP_17, PEPIN, INT_1, CARD_1;
 schemes BINOP_1, FUNCT_2, NAT_1, INT_1;

begin

::$P-
theorem
  for G being Group, N being normal Subgroup of G st
    ((ex B,C being finite set st
        B = the carrier of N & C = Left_Cosets N &
        card B, card C are_coprime) or
      (not N is finite &
        ex C being finite set st C = Left_Cosets N & card C = 1) or
      (not Left_Cosets N is finite &
        ex B being finite set st B = the carrier of N & card B = 1))
  holds ex H being Subgroup of G st
    for g being Element of G ex h,n being Element of G st
      h in H & n in N & g = h * n &
      for h1,n1 being Element of G st
        h1 in H & n1 in N & g = h1 * n1
      holds h1 = h & n1 = n
proof
end;
::$P+
