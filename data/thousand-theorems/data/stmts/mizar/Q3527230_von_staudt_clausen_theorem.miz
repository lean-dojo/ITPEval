:: Statement-only formalization of Thousand Theorems artifact Q3527230,
:: catalog title "Von Staudt–Clausen theorem": for every k, the Bernoulli
:: number B_(2k) plus the reciprocals of primes p with p - 1 dividing 2k is
:: an integer. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0,
    ARYTM_1, ARYTM_3, SQUARE_1, REAL_1, INT_1, INT_2, NAT_1,
    VALUED_0, VALUED_1, FINSEQ_1, FINSEQ_2, ORDINAL1, ORDINAL4,
    BINOP_1, BINOP_2, FUNCOP_1, FINSEQOP, CARD_3, SETWISEO, SETWOP_2,
    FINSOP_1, RVSUM_1, RAT_1, NEWTON, FINSET_1, MEMBERED;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    REAL_1, INT_1, INT_2, COMPLEX1, SQUARE_1, XXREAL_0, NAT_1,
    NAT_D, PARTFUN1, BINOP_2, SETWISEO, BINOP_1, FUNCOP_1, FINSEQ_1,
    FINSEQ_2, FINSEQ_4, VALUED_0, VALUED_1, FINSOP_1, FINSEQOP,
    SETWOP_2, RVSUM_1, RAT_1, NEWTON, FINSET_1, MEMBERED;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, CARD_1, REAL_1,
    SQUARE_1, COMPLEX1, INT_1, INT_2, XXREAL_0, NAT_1, NAT_D,
    BINOP_1, SETWISEO, BINOP_2, VALUED_1, FINSEQOP, FINSEQ_4,
    FINSOP_1, SETWOP_2, XXREAL_1, FINSEQ_2, RVSUM_1, ZFMISC_1,
    RAT_1, NEWTON, FINSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, SQUARE_1, ORDINAL1, NAT_1, INT_1, INT_2,
    FINSEQ_1, FINSEQ_2, FINSEQ_4, RVSUM_1, BINOP_2, FUNCOP_1, RAT_1,
    NEWTON, FINSET_1, FRAENKEL;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for bernoulli being Function of NAT,RAT st
    bernoulli.0 = 1 &
    (for r being Nat
      ex recurrence being FinSequence of RAT st
        len recurrence = r + 1 &
        (for j being Nat st j <= r holds
          recurrence.(j + 1) =
            ((r + 2) choose j) * bernoulli.j) &
        (r + 2) * bernoulli.(r + 1) = -(Sum recurrence))
  holds
    for k being Nat
      ex primes being finite Subset of NAT,
         terms being FinSequence of RAT,
         z being Integer st
        primes =
          {p where p is Element of Seg (2 * k + 1) :
            p is prime & (p -' 1) divides (2 * k)} &
        len terms = len Sgm primes &
        (for i being Nat st i in dom terms holds
          terms.i =
            (1 qua Rational) / (((Sgm primes).i) qua Rational)) &
        bernoulli.(2 * k) + Sum terms = z
proof
end;
::$P+
