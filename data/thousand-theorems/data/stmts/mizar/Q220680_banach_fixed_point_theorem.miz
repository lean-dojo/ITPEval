:: Statement-only formalization of thousand-theorems corpus artifact Q220680
:: (thousand-theorems__mizar__Q220680), "Banach fixed-point theorem": for a
:: contraction of a complete extended metric space and a point at finite
:: distance from its image, the iterates converge to a fixed point with the
:: standard geometric error bound. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, PROB_1, MEASURE1, SUBSET_1, SEQFUNC,
      MESFUNC5, PARTFUN1, XXREAL_0, NAT_1, RELAT_1, ARYTM_3, ARYTM_1,
      FUNCT_1, ORDINAL2, CARD_1, COMPLEX1, SEQ_2, TARSKI, REAL_1,
      PBOOLE, MESFUNC1, MESFUNC2, VALUED_1, ZFMISC_1, FUNCT_2,
      SETFAM_1, FINSET_1, XTUPLE_0, NEWTON;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XXREAL_3, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, XXREAL_0,
      VALUED_0, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1, NAT_1,
      PROB_1, MEASURE1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5,
      SETFAM_1, FINSET_1, XTUPLE_0, NEWTON;
 constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, RELSET_1,
      COMPLEX1, SETFAM_1, FINSET_1, XTUPLE_0, NEWTON;
 registrations SUBSET_1, NAT_1, XREAL_0, MEMBERED, ORDINAL1, PARTFUN1,
      MEASURE1, FUNCT_2, RELAT_1, XBOOLE_0, NUMBERS, XXREAL_0,
      XCMPLX_0, FUNCT_1, VALUED_0, XXREAL_3, RELSET_1, FINSET_1,
      NEWTON;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2;
 equalities XBOOLE_0;
 expansions TARSKI, XBOOLE_0, FUNCT_2;

begin

::$P-
theorem
  for X being non empty set,
      d being Function of [:X,X:],ExtREAL,
      f being Function of X,X,
      K being Real,
      x being Element of X st
    (for a,b being Element of X holds
      (0 qua ExtReal) <= d.[a,b] &
      (d.[a,b] = (0 qua ExtReal) iff a = b) &
      d.[a,b] = d.[b,a]) &
    (for a,b,c being Element of X holds
      d.[a,c] <= d.[a,b] + d.[b,c]) &
    (for s being sequence of X st
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m,n being Nat st N <= m & N <= n holds
            d.[s.m,s.n] < (epsilon qua ExtReal))
     holds ex z being Element of X st
       for epsilon being Real st 0 < epsilon holds
         ex N being Nat st
           for n being Nat st N <= n holds
             d.[s.n,z] < (epsilon qua ExtReal)) &
    0 <= K & K < 1 &
    (for a,b being Element of X holds
      d.[f.a,f.b] <= (K qua ExtReal) * d.[a,b]) &
    d.[x,f.x] <> +infty
  holds
    ex y being Element of X,
       u being sequence of X st
      f.y = y &
      u.0 = x &
      (for n being Nat holds u.(n+1) = f.(u.n)) &
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            d.[u.n,y] < (epsilon qua ExtReal)) &
      for n being Nat holds
        d.[u.n,y] <=
          (d.[x,f.x] * ((K |^ n) qua ExtReal)) /
            ((1-K) qua ExtReal)
proof
end;
::$P+
