:: Statement-only formalization of thousand-theorems corpus artifact Q1472120,
:: "Hellinger&ndash;Toeplitz theorem": every everywhere-defined symmetric
:: linear operator on a complete real or complex inner-product space is
:: continuous. This file contains no proof.

environ

 vocabularies RLSUB_1, HAHNBAN, UNIALG_1, DUALSP01, PROB_2, NFCONT_1,
      CFCONT_1, RLVECT_1, ARYTM_1, RELAT_1, FUNCT_1, RSSPACE, RSSPACE3,
      REAL_1, TARSKI, MSSUBFAM, STRUCT_0, REALSET1, SEQ_1, FUNCOP_1, FCONT_1,
      NORMSP_0, SEQ_2, LOPBAN_1, ORDINAL2, ARYTM_3, ALGSTR_0, NORMSP_1,
      FUNCT_2, PRE_TOPC, SUBSET_1, ZFMISC_1, ORDINAL1, NUMBERS, SEQ_4,
      XBOOLE_0, CARD_1, SUPINF_2, COMPLEX1, XXREAL_0, XXREAL_2, NAT_1,
      REWRITE1, VALUED_1, METRIC_1, RELAT_2, ASYMPT_1, FUNCT_7, PARTFUN1,
      RCOMP_1, BHSP_1, RSSPACE2, DUALSP04, RUSUB_5, SQUARE_1, RVSUM_1,
      BHSP_3, COMSEQ_1, CSSPACE, CSSPACE2, CLVECT_1, XCMPLX_0;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, FUNCT_1, ORDINAL1, RELSET_1,
      PARTFUN1, FUNCT_2, FUNCOP_1, REALSET1, NUMBERS, XCMPLX_0, SQUARE_1,
      XXREAL_0, XREAL_0, COMPLEX1, XXREAL_2, VALUED_1, SEQ_1, SEQ_2, SEQ_4,
      STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1, BHSP_1, BHSP_2, BHSP_3,
      RLSUB_1, RUSUB_1, RUSUB_5, NORMSP_0, NORMSP_1, HAHNBAN, RSSPACE,
      RSSPACE2, BHSP_6, RSSPACE3, LOPBAN_1, NFCONT_1, DUALSP01, CLVECT_1,
      CSSPACE, CSSPACE2;
 constructors REAL_1, REALSET1, RSSPACE3, LOPBAN_2, SEQ_1, NFCONT_1,
      DUALSP01, RELSET_1, SEQ_2, SEQ_4, HAHNBAN1, COMSEQ_2, BHSP_2, BHSP_3,
      RUSUB_5, SQUARE_1, BHSP_6, CLVECT_2;
 registrations STRUCT_0, XREAL_0, NUMBERS, ORDINAL1, MEMBERED, RELAT_1,
      XXREAL_0, VALUED_0, RLVECT_1, FUNCT_2, VALUED_1, FUNCOP_1, RELSET_1,
      NORMSP_3, XCMPLX_0, NAT_1, NORMSP_1, SEQ_2, DUALSP01, XBOOLE_0,
      SQUARE_1, RUSUB_1, CLVECT_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions ALGSTR_0, HAHNBAN, XXREAL_2, TARSKI, CLVECT_1;
 equalities RLVECT_1, STRUCT_0, ALGSTR_0, NORMSP_0, SEQ_1, BHSP_1, DUALSP01,
      CLVECT_1;
 expansions FUNCT_1, RLSUB_1, TARSKI, XBOOLE_0, FUNCT_2, SEQ_2, NORMSP_0,
      ORDINAL1, NORMSP_1, STRUCT_0, RLVECT_1, XXREAL_2, BHSP_1, MEMBERED,
      NFCONT_1, DUALSP01, CLVECT_1;
 theorems SEQ_4, FUNCT_1, SEQ_1, SEQ_2, ABSVALUE, COMPLEX1, TARSKI, RSSPACE3,
      XREAL_0, XXREAL_0, NORMSP_1, LOPBAN_1, FUNCT_2, XBOOLE_0, XREAL_1,
      XCMPLX_0, RLVECT_1, FUNCOP_1, HAHNBAN, RSSPACE, ORDINAL1, NAT_1,
      BHSP_1, BHSP_2, BHSP_3, SUBSET_1, NFCONT_1, XXREAL_2, DUALSP01,
      XCMPLX_1, RUSUB_5, SQUARE_1, RUSUB_1, BHSP_6, CLVECT_1, CSSPACE;
 schemes FUNCT_2, XBOOLE_0;

begin

::$P-
theorem
  (for X being RealHilbertSpace,
       T being Function of the carrier of X, the carrier of X
   st (for x,y being Point of X holds
         T.(x+y) = T.x + T.y)
    & (for a being Real, x being Point of X holds
         T.(a*x) = a*T.x)
    & (for x,y being Point of X holds
         (T.x) .|. y = x .|. (T.y))
   holds
     for x being Point of X, epsilon being Real st 0 < epsilon holds
       ex delta being Real st
         0 < delta
       & for y being Point of X st ||.y-x.|| < delta holds
           ||.T.y-T.x.|| < epsilon)
  &
  (for X being ComplexHilbertSpace,
       T being Function of the carrier of X, the carrier of X
   st (for x,y being Point of X holds
         T.(x+y) = T.x + T.y)
    & (for a being Complex, x being Point of X holds
         T.(a*x) = a*T.x)
    & (for x,y being Point of X holds
         (T.x) .|. y = x .|. (T.y))
   holds
     for x being Point of X, epsilon being Real st 0 < epsilon holds
       ex delta being Real st
         0 < delta
       & for y being Point of X st ||.y-x.|| < delta holds
           ||.T.y-T.x.|| < epsilon)
proof
end;
::$P+
