:: Statement-only formalization of Thousand Theorems corpus artifact Q978688,
:: "Gershgorin circle theorem": every eigenvalue of a finite square matrix
:: over a normed field lies in a closed Gershgorin ball determined by one
:: matrix row. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, INT_1, CARD_1, REAL_1, XCMPLX_0, XXREAL_0,
      COMPLEX1, RLVECT_1, ALGSTR_0, BINOP_1, VECTSP_1, LATTICES,
      XBOOLE_0, SUBSET_1, ARYTM_1, RELAT_1, ARYTM_3, RLSUB_1, SUPINF_2,
      GROUP_1, STRUCT_0, TARSKI, REALSET1, ZFMISC_1, FUNCT_1, FUNCT_2,
      MESFUNC1, FINSEQ_1, FINSEQ_2, FINSET_1, NEWTON, ORDINAL1, BINOM,
      PARTFUN1, CARD_3, VALUED_0, VALUED_1, RVSUM_1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, REALSET1,
      FUNCT_1, PARTFUN1, FUNCT_2, FINSEQ_1, FINSEQ_2, FINSET_1, CARD_1,
      ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, INT_1, NAT_1,
      STRUCT_0, ALGSTR_0, DOMAIN_1, BINOP_1, RLVECT_1, GROUP_1,
      VECTSP_1, INT_2, NEWTON, RVSUM_1, BINOM;
 constructors PARTFUN1, FUNCT_2, FINSEQ_4, FINSEQOP, BINOP_1, REALSET1,
      ORDINAL1, NAT_1, FINSET_1, XXREAL_0, REAL_1, NAT_D, NEWTON,
      RVSUM_1, VECTSP_1, RLVECT_1, RELSET_1, GROUP_1, BINOM;
 registrations XBOOLE_0, SUBSET_1, FUNCT_1, FUNCT_2, REALSET1, ORDINAL1,
      NUMBERS, XREAL_0, INT_1, CARD_1, STRUCT_0, VECTSP_1, RELAT_1,
      RELSET_1, ALGSTR_0, NAT_1, FINSEQ_1, FINSEQ_2, FINSET_1, NEWTON,
      VALUED_0, VALUED_1, RVSUM_1, MEMBERED, FRAENKEL;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, RLVECT_1, XBOOLE_0, ALGSTR_0, VECTSP_1;
 equalities FINSEQ_1, ORDINAL1, BINOP_1, REALSET1, STRUCT_0, ALGSTR_0,
      VECTSP_1;
 expansions TARSKI, XBOOLE_0, FINSEQ_1, STRUCT_0;

begin

::$P-
theorem
  for K being Field,
      norm being Function of the carrier of K,REAL,
      I being finite set,
      A being Function of [:I,I:],the carrier of K,
      mu being Element of K
  st
    (for a being Element of K holds 0 <= norm.a) &
    (for a being Element of K holds
      (norm.a = 0 iff a = 0.K)) &
    (for a,b being Element of K holds
      norm.(a + b) <= norm.a + norm.b) &
    (for a,b being Element of K holds
      norm.(a * b) = norm.a * norm.b) &
    (ex v being Function of I,the carrier of K st
      (ex i being Element of I st i in I & v.i <> 0.K) &
      (for i being Element of I st i in I holds
        ex e being one-to-one FinSequence of I,
           row being FinSequence of the carrier of K st
          rng e = I &
          len row = len e &
          (for t being Nat st t in dom row holds
            row/.t = A/.[i,e/.t] * v/.(e/.t)) &
          Sum row = mu * v/.i))
  holds
    ex k being Element of I st k in I &
      ex e being one-to-one FinSequence of I,
         radii being FinSequence of REAL st
        rng e = I \ {k} &
        len radii = len e &
        (for t being Nat st t in dom radii holds
          radii/.t = norm.(A/.[k,e/.t])) &
        norm.(A/.[k,k] - mu) <= Sum radii
proof
end;
::$P+
