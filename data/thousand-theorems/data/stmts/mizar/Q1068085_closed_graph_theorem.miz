:: Statement-only formalization of thousand-theorems corpus artifact Q1068085
:: (thousand-theorems__mizar__Q1068085), "Closed graph theorem": over a
:: nontrivially normed field, a linear map between Banach spaces whose graph
:: is closed is continuous. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, FUNCT_2, RELAT_1,
    ZFMISC_1, BINOP_1, NUMBERS, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3,
    NAT_1, REAL_1, COMPLEX1, CARD_1, VALUED_0, VALUED_1, ORDINAL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1;
  constructors ZFMISC_1, FUNCT_1, RELSET_1, FUNCT_2, BINOP_1, CARD_1,
    REAL_1, COMPLEX1, XXREAL_0, NAT_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    NUMBERS, CARD_1, XXREAL_0, MEMBERED, XCMPLX_0, XREAL_0, ORDINAL1,
    NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for R,E,F being non empty set,
      zeroR,oneR being Element of R,
      addR,mulR being BinOp of R,
      oppR,invR being UnOp of R,
      normR being Function of R,REAL,
      zeroE being Element of E,
      addE being BinOp of E,
      oppE being UnOp of E,
      smulE being Function of [:R,E:],E,
      normE being Function of E,REAL,
      zeroF being Element of F,
      addF being BinOp of F,
      oppF being UnOp of F,
      smulF being Function of [:R,F:],F,
      normF being Function of F,REAL,
      g being Function of E,F
  st
    zeroR <> oneR &
    (for a,b being Element of R holds
      addR.(a,b) = addR.(b,a)) &
    (for a,b,c being Element of R holds
      addR.(addR.(a,b),c) = addR.(a,addR.(b,c))) &
    (for a being Element of R holds
      addR.(a,zeroR) = a) &
    (for a being Element of R holds
      addR.(a,oppR.a) = zeroR) &
    (for a,b being Element of R holds
      mulR.(a,b) = mulR.(b,a)) &
    (for a,b,c being Element of R holds
      mulR.(mulR.(a,b),c) = mulR.(a,mulR.(b,c))) &
    (for a being Element of R holds
      mulR.(a,oneR) = a) &
    (for a being Element of R holds
      mulR.(a,zeroR) = zeroR) &
    (for a,b,c being Element of R holds
      mulR.(a,addR.(b,c)) =
        addR.(mulR.(a,b),mulR.(a,c))) &
    (for a being Element of R st a <> zeroR holds
      mulR.(a,invR.a) = oneR) &
    (for a being Element of R holds
      0 <= normR.a) &
    (for a being Element of R holds
      (normR.a = 0 iff a = zeroR)) &
    (for a,b being Element of R holds
      normR.(addR.(a,b)) <= normR.a + normR.b) &
    (for a,b being Element of R holds
      normR.(mulR.(a,b)) = normR.a * normR.b) &
    (ex a being Element of R st 1 < normR.a) &
    (for x,y being Element of E holds
      addE.(x,y) = addE.(y,x)) &
    (for x,y,z being Element of E holds
      addE.(addE.(x,y),z) = addE.(x,addE.(y,z))) &
    (for x being Element of E holds
      addE.(x,zeroE) = x) &
    (for x being Element of E holds
      addE.(x,oppE.x) = zeroE) &
    (for a being Element of R, x,y being Element of E holds
      smulE.(a,addE.(x,y)) =
        addE.(smulE.(a,x),smulE.(a,y))) &
    (for a,b being Element of R, x being Element of E holds
      smulE.(addR.(a,b),x) =
        addE.(smulE.(a,x),smulE.(b,x))) &
    (for a,b being Element of R, x being Element of E holds
      smulE.(mulR.(a,b),x) = smulE.(a,smulE.(b,x))) &
    (for x being Element of E holds
      smulE.(oneR,x) = x) &
    (for x being Element of E holds
      0 <= normE.x) &
    (for x being Element of E holds
      (normE.x = 0 iff x = zeroE)) &
    (for x,y being Element of E holds
      normE.(addE.(x,y)) <= normE.x + normE.y) &
    (for a being Element of R, x being Element of E holds
      normE.(smulE.(a,x)) = normR.a * normE.x) &
    (for y,z being Element of F holds
      addF.(y,z) = addF.(z,y)) &
    (for x,y,z being Element of F holds
      addF.(addF.(x,y),z) = addF.(x,addF.(y,z))) &
    (for y being Element of F holds
      addF.(y,zeroF) = y) &
    (for y being Element of F holds
      addF.(y,oppF.y) = zeroF) &
    (for a being Element of R, y,z being Element of F holds
      smulF.(a,addF.(y,z)) =
        addF.(smulF.(a,y),smulF.(a,z))) &
    (for a,b being Element of R, y being Element of F holds
      smulF.(addR.(a,b),y) =
        addF.(smulF.(a,y),smulF.(b,y))) &
    (for a,b being Element of R, y being Element of F holds
      smulF.(mulR.(a,b),y) = smulF.(a,smulF.(b,y))) &
    (for y being Element of F holds
      smulF.(oneR,y) = y) &
    (for y being Element of F holds
      0 <= normF.y) &
    (for y being Element of F holds
      (normF.y = 0 iff y = zeroF)) &
    (for y,z being Element of F holds
      normF.(addF.(y,z)) <= normF.y + normF.z) &
    (for a being Element of R, y being Element of F holds
      normF.(smulF.(a,y)) = normR.a * normF.y) &
    (for x,y being Element of E holds
      g.(addE.(x,y)) = addF.(g.x,g.y)) &
    (for a being Element of R, x being Element of E holds
      g.(smulE.(a,x)) = smulF.(a,g.x)) &
    (for u being Function of NAT,E st
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m,n being Nat st N <= m & N <= n holds
            normE.(addE.(u.m,oppE.(u.n))) < epsilon)
    holds ex x being Element of E st
      for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            normE.(addE.(u.n,oppE.x)) < epsilon) &
    (for v being Function of NAT,F st
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m,n being Nat st N <= m & N <= n holds
            normF.(addF.(v.m,oppF.(v.n))) < epsilon)
    holds ex y being Element of F st
      for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            normF.(addF.(v.n,oppF.y)) < epsilon) &
    (for u being Function of NAT,E,
         v being Function of NAT,F,
         x being Element of E,
         y being Element of F st
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            normE.(addE.(u.n,oppE.x)) < epsilon) &
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            normF.(addF.(v.n,oppF.y)) < epsilon) &
      (for n being Nat holds g.(u.n) = v.n)
    holds g.x = y)
  holds
    for x being Element of E,
        epsilon being Real st 0 < epsilon holds
      ex delta being Real st
        0 < delta &
        for z being Element of E st
          normE.(addE.(z,oppE.x)) < delta
        holds normF.(addF.(g.z,oppF.(g.x))) < epsilon
proof
end;
::$P+
