:: Statement-only formalization of thousand-theorems corpus artifact Q1966978,
:: "Lévy continuity theorem": weak convergence of probability measures on an
:: arbitrary finite-dimensional real inner-product space is equivalent to
:: pointwise convergence of their characteristic functions. This file contains
:: no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, TARSKI, ZFMISC_1, ORDINAL1, NAT_1, CARD_1, ARYTM_1,
      ARYTM_3, XXREAL_0, XCMPLX_0, COMPLEX1, REAL_1, VALUED_0,
      VALUED_1, SEQ_1, SEQ_2, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1,
      RLVECT_5, NORMSP_0, NORMSP_1, NORMSP_2, BHSP_1, DUALSP04, PROB_1,
      PROB_4,
      MEASURE1, MEASURE3, MEASURE6, MESFUNC1, MESFUNC2, MESFUNC5,
      INTEGRA5, SUPINF_1, SUPINF_2, SIN_COS, SETFAM_1, TOPS_1, TOPS_2,
      TOPGEN_4, MEMBERED;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS,
      XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0, COMPLEX1, REAL_1, NAT_1,
      VALUED_0, VALUED_1, SEQ_1, STRUCT_0, ALGSTR_0, PRE_TOPC,
      TOPS_1, TOPS_2, TOPGEN_4, RLVECT_1, RLVECT_5, NORMSP_0,
      NORMSP_1, NORMSP_2, BHSP_1, DUALSP04, PROB_1, PROB_2, PROB_4,
      MEASURE1, MEASURE3,
      MEASURE6, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6,
      SIN_COS, SUPINF_2;
 constructors ZFMISC_1, RELSET_1, FUNCT_2, REAL_1, COMPLEX1, SEQ_1,
      SEQ_2, TOPS_1, TOPS_2, TOPGEN_4, RLVECT_1, RLVECT_5, NORMSP_1,
      NORMSP_2, BHSP_1, DUALSP04, PROB_1, PROB_2, PROB_4, MEASURE1,
      MEASURE3, MEASURE6,
      MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6, EXTREAL1, SIN_COS,
      SUPINF_1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ORDINAL1, CARD_1, NUMBERS, NAT_1, XREAL_0, XXREAL_0,
      XXREAL_3, MEMBERED, VALUED_0, VALUED_1, STRUCT_0, ALGSTR_0,
      RLVECT_1, RLVECT_5, NORMSP_0, NORMSP_1, NORMSP_2, PRE_TOPC,
      TOPS_1, MEASURE1, MEASURE3, PROB_1, PROB_4;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_1, FUNCT_2, RLVECT_1, NORMSP_0,
      NORMSP_1, MESFUNC1, MESFUNC5, MESFUNC6;
 equalities XBOOLE_0, SUBSET_1, RELAT_1, STRUCT_0, ALGSTR_0, RLVECT_1,
      NORMSP_0, DUALSP04, PROB_1, PROB_4;
 expansions TARSKI, XBOOLE_0, FUNCT_2, RLVECT_1, NORMSP_0, NORMSP_1,
      DUALSP04;

begin

::$P-
theorem
  for V being RealUnitarySpace,
      S being SigmaField of the carrier of V,
      M being Function of NAT,Funcs(S,REAL),
      M0 being Probability of S
  st
    V is finite-dimensional &
    S = BorelSets(TopSpaceNorm RUSp2RNSp V) &
    (for n being Nat holds
      ex Mn being Probability of S st M.n = Mn)
  holds
    ((for f being Function of the carrier of V,REAL
        st
          (for x being Point of V, e being Real st 0 < e holds
            ex d being Real st 0 < d &
              for y being Point of V st ||.y-x.|| < d holds
                |.f.y-f.x.| < e) &
          (ex C being Real st
            for x being Point of V holds |.f.x.| <= C)
        holds
          ex a being Real_Sequence, b being Real st
            (for n being Nat holds
              ex Mn being Probability of S st
                M.n = Mn &
                f is_integrable_on P2M(Mn) &
                a.n = Integral(P2M(Mn),f)) &
            f is_integrable_on P2M(M0) &
            b = Integral(P2M(M0),f) &
            for e being Real st 0 < e holds
              ex N being Nat st
                for n being Nat st N <= n holds |.a.n-b.| < e)
     iff
     (for t being Point of V holds
        ex c,s being Function of the carrier of V,REAL st
        ex aCos,aSin being Real_Sequence st
        ex bCos,bSin being Real st
          (for x being Point of V holds
            c.x = cos.((the scalar of V).[x,t]) &
            s.x = sin.((the scalar of V).[x,t])) &
          (for n being Nat holds
            ex Mn being Probability of S st
              M.n = Mn &
              c is_integrable_on P2M(Mn) &
              s is_integrable_on P2M(Mn) &
              aCos.n = Integral(P2M(Mn),c) &
              aSin.n = Integral(P2M(Mn),s)) &
          c is_integrable_on P2M(M0) &
          s is_integrable_on P2M(M0) &
          bCos = Integral(P2M(M0),c) &
          bSin = Integral(P2M(M0),s) &
          (for e being Real st 0 < e holds
            ex N being Nat st
              for n being Nat st N <= n holds |.aCos.n-bCos.| < e) &
          (for e being Real st 0 < e holds
            ex N being Nat st
              for n being Nat st N <= n holds |.aSin.n-bSin.| < e)))
proof
end;
::$P+
