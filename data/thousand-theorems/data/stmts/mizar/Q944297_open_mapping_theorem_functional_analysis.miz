:: Statement-only formalization of thousand-theorems corpus artifact Q944297
:: (thousand-theorems__mizar__Q944297), "Open mapping theorem (functional
:: analysis)": a surjective continuous semilinear map between Banach spaces
:: over isometrically isomorphic nontrivially normed fields is open. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, FUNCT_2, RELAT_1,
    ZFMISC_1, BINOP_1, NUMBERS, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3,
    NAT_1, REAL_1, COMPLEX1, CARD_1, VALUED_0, VALUED_1, ORDINAL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, REAL_1, COMPLEX1, XXREAL_0, NAT_1;
  constructors ZFMISC_1, FUNCT_1, RELSET_1, FUNCT_2, BINOP_1, CARD_1,
    REAL_1, COMPLEX1, XXREAL_0, NAT_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2,
    NUMBERS, CARD_1, XXREAL_0, MEMBERED, XCMPLX_0, XREAL_0, ORDINAL1,
    NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for R,S,E,F being non empty set,
      zeroR,oneR being Element of R,
      addR,mulR being BinOp of R,
      oppR,invR being UnOp of R,
      normR being Function of R,REAL,
      zeroS,oneS being Element of S,
      addS,mulS being BinOp of S,
      oppS,invS being UnOp of S,
      normS being Function of S,REAL,
      sigma being Function of R,S,
      sigmaInv being Function of S,R,
      zeroE being Element of E,
      addE being BinOp of E,
      oppE being UnOp of E,
      smulE being Function of [:R,E:],E,
      normE being Function of E,REAL,
      zeroF being Element of F,
      addF being BinOp of F,
      oppF being UnOp of F,
      smulF being Function of [:S,F:],F,
      normF being Function of F,REAL,
      g being Function of E,F
  st
    zeroR <> oneR &
    (for a,b being Element of R holds
      addR.(a,b) = addR.(b,a)) &
    (for a,b,c being Element of R holds
      addR.(addR.(a,b),c) = addR.(a,addR.(b,c))) &
    (for a being Element of R holds
      addR.(a,zeroR) = a) &
    (for a being Element of R holds
      addR.(a,oppR.a) = zeroR) &
    (for a,b being Element of R holds
      mulR.(a,b) = mulR.(b,a)) &
    (for a,b,c being Element of R holds
      mulR.(mulR.(a,b),c) = mulR.(a,mulR.(b,c))) &
    (for a being Element of R holds
      mulR.(a,oneR) = a) &
    (for a being Element of R holds
      mulR.(a,zeroR) = zeroR) &
    (for a,b,c being Element of R holds
      mulR.(a,addR.(b,c)) =
        addR.(mulR.(a,b),mulR.(a,c))) &
    (for a being Element of R st a <> zeroR holds
      mulR.(a,invR.a) = oneR) &
    (for a being Element of R holds
      0 <= normR.a) &
    (for a being Element of R holds
      (normR.a = 0 iff a = zeroR)) &
    (for a,b being Element of R holds
      normR.(addR.(a,b)) <= normR.a + normR.b) &
    (for a,b being Element of R holds
      normR.(mulR.(a,b)) = normR.a * normR.b) &
    (ex a being Element of R st 1 < normR.a) &
    zeroS <> oneS &
    (for a,b being Element of S holds
      addS.(a,b) = addS.(b,a)) &
    (for a,b,c being Element of S holds
      addS.(addS.(a,b),c) = addS.(a,addS.(b,c))) &
    (for a being Element of S holds
      addS.(a,zeroS) = a) &
    (for a being Element of S holds
      addS.(a,oppS.a) = zeroS) &
    (for a,b being Element of S holds
      mulS.(a,b) = mulS.(b,a)) &
    (for a,b,c being Element of S holds
      mulS.(mulS.(a,b),c) = mulS.(a,mulS.(b,c))) &
    (for a being Element of S holds
      mulS.(a,oneS) = a) &
    (for a being Element of S holds
      mulS.(a,zeroS) = zeroS) &
    (for a,b,c being Element of S holds
      mulS.(a,addS.(b,c)) =
        addS.(mulS.(a,b),mulS.(a,c))) &
    (for a being Element of S st a <> zeroS holds
      mulS.(a,invS.a) = oneS) &
    (for a being Element of S holds
      0 <= normS.a) &
    (for a being Element of S holds
      (normS.a = 0 iff a = zeroS)) &
    (for a,b being Element of S holds
      normS.(addS.(a,b)) <= normS.a + normS.b) &
    (for a,b being Element of S holds
      normS.(mulS.(a,b)) = normS.a * normS.b) &
    (ex a being Element of S st 1 < normS.a) &
    (for a,b being Element of R holds
      sigma.(addR.(a,b)) = addS.(sigma.a,sigma.b)) &
    (for a,b being Element of R holds
      sigma.(mulR.(a,b)) = mulS.(sigma.a,sigma.b)) &
    sigma.oneR = oneS &
    (for a,b being Element of S holds
      sigmaInv.(addS.(a,b)) = addR.(sigmaInv.a,sigmaInv.b)) &
    (for a,b being Element of S holds
      sigmaInv.(mulS.(a,b)) = mulR.(sigmaInv.a,sigmaInv.b)) &
    sigmaInv.oneS = oneR &
    (for a being Element of R holds
      sigmaInv.(sigma.a) = a) &
    (for a being Element of S holds
      sigma.(sigmaInv.a) = a) &
    (for a being Element of R holds
      normS.(sigma.a) = normR.a) &
    (for a being Element of S holds
      normR.(sigmaInv.a) = normS.a) &
    (for x,y being Element of E holds
      addE.(x,y) = addE.(y,x)) &
    (for x,y,z being Element of E holds
      addE.(addE.(x,y),z) = addE.(x,addE.(y,z))) &
    (for x being Element of E holds
      addE.(x,zeroE) = x) &
    (for x being Element of E holds
      addE.(x,oppE.x) = zeroE) &
    (for a being Element of R, x,y being Element of E holds
      smulE.(a,addE.(x,y)) =
        addE.(smulE.(a,x),smulE.(a,y))) &
    (for a,b being Element of R, x being Element of E holds
      smulE.(addR.(a,b),x) =
        addE.(smulE.(a,x),smulE.(b,x))) &
    (for a,b being Element of R, x being Element of E holds
      smulE.(mulR.(a,b),x) = smulE.(a,smulE.(b,x))) &
    (for x being Element of E holds
      smulE.(oneR,x) = x) &
    (for x being Element of E holds
      0 <= normE.x) &
    (for x being Element of E holds
      (normE.x = 0 iff x = zeroE)) &
    (for x,y being Element of E holds
      normE.(addE.(x,y)) <= normE.x + normE.y) &
    (for a being Element of R, x being Element of E holds
      normE.(smulE.(a,x)) = normR.a * normE.x) &
    (for x,y being Element of F holds
      addF.(x,y) = addF.(y,x)) &
    (for x,y,z being Element of F holds
      addF.(addF.(x,y),z) = addF.(x,addF.(y,z))) &
    (for x being Element of F holds
      addF.(x,zeroF) = x) &
    (for x being Element of F holds
      addF.(x,oppF.x) = zeroF) &
    (for a being Element of S, x,y being Element of F holds
      smulF.(a,addF.(x,y)) =
        addF.(smulF.(a,x),smulF.(a,y))) &
    (for a,b being Element of S, x being Element of F holds
      smulF.(addS.(a,b),x) =
        addF.(smulF.(a,x),smulF.(b,x))) &
    (for a,b being Element of S, x being Element of F holds
      smulF.(mulS.(a,b),x) = smulF.(a,smulF.(b,x))) &
    (for x being Element of F holds
      smulF.(oneS,x) = x) &
    (for x being Element of F holds
      0 <= normF.x) &
    (for x being Element of F holds
      (normF.x = 0 iff x = zeroF)) &
    (for x,y being Element of F holds
      normF.(addF.(x,y)) <= normF.x + normF.y) &
    (for a being Element of S, x being Element of F holds
      normF.(smulF.(a,x)) = normS.a * normF.x) &
    (for x,y being Element of E holds
      g.(addE.(x,y)) = addF.(g.x,g.y)) &
    (for a being Element of R, x being Element of E holds
      g.(smulE.(a,x)) = smulF.(sigma.a,g.x)) &
    (for u being Function of NAT,E st
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m,n being Nat st N <= m & N <= n holds
            normE.(addE.(u.m,oppE.(u.n))) < epsilon)
    holds ex x being Element of E st
      for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            normE.(addE.(u.n,oppE.x)) < epsilon) &
    (for v being Function of NAT,F st
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m,n being Nat st N <= m & N <= n holds
            normF.(addF.(v.m,oppF.(v.n))) < epsilon)
    holds ex y being Element of F st
      for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for n being Nat st N <= n holds
            normF.(addF.(v.n,oppF.y)) < epsilon) &
    (for x being Element of E,
         epsilon being Real st 0 < epsilon holds
      ex delta being Real st
        0 < delta &
        for z being Element of E st
          normE.(addE.(z,oppE.x)) < delta
        holds normF.(addF.(g.z,oppF.(g.x))) < epsilon) &
    rng g = F
  holds
    for A being Subset of E st
      (for x being Element of E st x in A holds
        ex epsilon being Real st
          0 < epsilon &
          for z being Element of E st
            normE.(addE.(z,oppE.x)) < epsilon
          holds z in A)
    holds
      for y being Element of F st y in g.:A holds
        ex delta being Real st
          0 < delta &
          for z being Element of F st
            normF.(addF.(z,oppF.y)) < delta
          holds z in g.:A
proof
end;
::$P+
