:: Statement-only formalization of thousand-theorems corpus artifact Q3984053,
:: "Fourier inversion theorem": every continuous integrable complex
:: Banach-valued function on an arbitrary finite-dimensional real inner-product
:: space, whose Fourier transform is integrable, is recovered by inverse
:: Fourier transformation. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, TARSKI, ZFMISC_1, ORDINAL1, NAT_1, FINSEQ_1, CARD_1,
      ARYTM_1, ARYTM_3, XXREAL_0, XCMPLX_0, COMPLEX1, REAL_1, VALUED_0,
      VALUED_1, SEQ_1, SEQ_2, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1,
      RLVECT_5, NORMSP_0, NORMSP_1, NORMSP_2, CLVECT_1, CLOPBAN1,
      BHSP_1, PROB_1, MEASURE1, MESFUNC1, MESFUNC5, INTEGRA5, SUPINF_2,
      EUCLID, RVSUM_1, SIN_COS, FINSET_1, FUNCOP_1, PBOOLE, MEMBERED,
      SETFAM_1, TOPS_1, TOPS_2, TOPGEN_4, REAL_NS1, RUSUB_4;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, SETFAM_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1, NAT_1, FINSEQ_1,
      FINSEQ_2, VALUED_0, VALUED_1, SEQ_1, RVSUM_1, EUCLID, SIN_COS,
      STRUCT_0, ALGSTR_0, PRE_TOPC, TOPS_2, RLVECT_1, RLVECT_5,
      NORMSP_0, NORMSP_2, VECTSP_1, CLVECT_1, CLOPBAN1, BHSP_1, PROB_1,
      MEASURE1, EXTREAL1, MESFUNC1, MESFUNC5, MESFUNC6, SUPINF_2,
      TOPGEN_4, REAL_NS1, RUSUB_4;
 constructors REAL_1, COMPLEX1, SIN_COS, SEQ_2, FINSEQ_2, RVSUM_1, EUCLID,
      CLVECT_1, CLOPBAN1, MEASURE1, MESFUNC1, MESFUNC2, MESFUNC5,
      MESFUNC6, EXTREAL1, SUPINF_1, RELSET_1, FUNCOP_1, TOPS_2,
      NORMSP_2, RLVECT_5, TOPGEN_4, REAL_NS1, BHSP_1, RUSUB_4;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, ORDINAL1, NUMBERS, XREAL_0,
      MEMBERED, NAT_1, FINSEQ_1, FUNCT_1, FUNCT_2, PARTFUN1, VALUED_0,
      VALUED_1, XCMPLX_0, STRUCT_0, RLVECT_1, RLVECT_5, NORMSP_0,
      NORMSP_1, PRE_TOPC, TOPS_1, CLVECT_1, CLOPBAN1, MEASURE1, EUCLID,
      SIN_COS, REAL_NS1, REAL_NS2, RUSUB_4;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, RLVECT_1, CLVECT_1, NORMSP_0,
      MESFUNC1, MESFUNC5;
 equalities XBOOLE_0, RLVECT_1, CLVECT_1, STRUCT_0, ALGSTR_0, NORMSP_0,
      FINSEQ_1;
 expansions TARSKI, XBOOLE_0, FUNCT_2, RLVECT_1, CLVECT_1, NORMSP_0,
      MESFUNC1, FINSEQ_1;

begin

::$P-
theorem
  for V being RealUnitarySpace,
       S being SigmaField of the carrier of V,
       M being sigma_Measure of S,
       X being ComplexBanachSpace,
       J being Relation of Funcs(the carrier of V,the carrier of X),
                           the carrier of X,
       f,F,G being Function of the carrier of V,the carrier of X
  st
    V is finite-dimensional &
    (ex n being Nat,
        u being Function of the carrier of V,REAL n,
        B being Subset-Family of the carrier of V,
        C being Subset of V st
      u is one-to-one &
      rng u = REAL n &
      (for x,y being Point of V holds
        u.(x+y) = u.x+u.y) &
      (for a being Real, x being Point of V holds
        u.(a*x) = a*u.x) &
      (for x being Point of V holds
        ex z being Element of REAL n st
          z = u.x & |.z.| = ||.x.||) &
      (for A being Subset of the carrier of V holds
        A in B iff
          ex c being Point of V, r being Real st
            0 < r &
            A = {x where x is Point of V: ||.x-c.|| < r}) &
      S = sigma(B) &
      C in S &
      C = {x where x is Point of V:
        ex z being Element of REAL n st
          z = u.x &
          for i being Nat st i in Seg n holds
            0 <= z.i & z.i < 1} &
      M.C = 1 &
      (for A being Element of S, a being Point of V holds
        ex T being Element of S st
          T = {y where y is Point of V:
            ex x being Point of V st x in A & y = x+a} &
          M.T = M.A)) &
    (for g being Function of the carrier of V,the carrier of X,
         y being Point of X holds
      [g,y] in J iff
        ex Q being sequence of Funcs(the carrier of V,the carrier of X),
           I being sequence of X,
           E being Real_Sequence st
          (for k being Nat holds
            ex q being Function of the carrier of V,the carrier of X,
               A being FinSequence of S,
               z being sequence of X,
               r being Real_Sequence,
               p being sequence of X,
               e being Function of the carrier of V,REAL st
              Q.k = q &
              p.0 = 0.X &
              (for i being Nat st i < len A holds
                p.(i+1) = p.i + ((r.i) qua Complex)*z.i) &
              I.k = p.(len A) &
              (for i being Nat st i < len A holds
                0 <= r.i & M.(A.(i+1)) = r.i) &
              (for i,j being Nat st
                  i < len A & j < len A & i <> j
                holds A.(i+1) misses A.(j+1)) &
              (for x being Point of V holds
                (ex i being Nat st
                  i < len A & x in A.(i+1) & q.x = z.i) or
                ((for i being Nat st i < len A holds not x in A.(i+1)) &
                  q.x = 0.X)) &
              (for x being Point of V holds
                e.x = ||.g.x-q.x.||) &
              e is_integrable_on M &
              E.k = Integral(M,e)) &
          (for e being Real st 0 < e holds
            ex k0 being Nat st
              for k being Nat st k0 <= k holds |.E.k.| < e) &
          (for e being Real st 0 < e holds
            ex k0 being Nat st
              for k being Nat st k0 <= k holds ||.I.k-y.|| < e)) &
    (ex y being Point of X st [f,y] in J) &
    (ex y being Point of X st [F,y] in J) &
    (for w being Point of V holds
      ex h being Function of the carrier of V,the carrier of X st
        (for x being Point of V holds
          h.x = (cos(2*PI*((the scalar of V).[w,x])) -
            sin(2*PI*((the scalar of V).[w,x]))*<i>)*f.x) &
        [h,F.w] in J) &
    (for v being Point of V holds
      ex h being Function of the carrier of V,the carrier of X st
        (for w being Point of V holds
          h.w = (cos(2*PI*((the scalar of V).[w,v])) +
            sin(2*PI*((the scalar of V).[w,v]))*<i>)*F.w) &
        [h,G.v] in J) &
    (for v being Point of V holds
      for e being Real st 0 < e holds
        ex d being Real st 0 < d &
          for x being Point of V st
            ||.x-v.|| < d
          holds ||.f.x-f.v.|| < e)
  holds
    G = f
proof
end;
::$P+
