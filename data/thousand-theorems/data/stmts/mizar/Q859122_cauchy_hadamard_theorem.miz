:: Statement-only formalization of thousand-theorems corpus artifact Q859122
:: (thousand-theorems__mizar__Q859122), "Cauchy-Hadamard theorem": for a
:: formal multilinear series over an arbitrary nontrivially normed field, the
:: inverse radius equals the limsup of the nth roots of its coefficient
:: operator norms. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, FUNCT_1, FUNCT_2, RELAT_1,
    ZFMISC_1, BINOP_1, NUMBERS, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, NAT_1, REAL_1, CARD_1, FINSEQ_1, FINSEQ_2, PARTFUN1,
    VALUED_0, VALUED_1, ORDINAL2, POWER, SEQ_1, MESFUNC5, NEWTON;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, PARTFUN1, BINOP_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, REAL_1, XXREAL_0, XXREAL_3, NAT_1, FINSEQ_1,
    FINSEQ_2, FUNCOP_1, POWER, SEQ_1, MESFUNC5, NEWTON;
  constructors ZFMISC_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1, BINOP_1,
    CARD_1, REAL_1, XXREAL_0, XXREAL_3, NAT_1, FINSEQ_1, FINSEQ_2,
    FUNCOP_1, POWER, SEQ_1, MESFUNC5, NEWTON, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, PARTFUN1, NUMBERS, CARD_1, XXREAL_0, MEMBERED, XCMPLX_0,
    XREAL_0, ORDINAL1, NAT_1, FINSEQ_1, FINSEQ_2, VALUED_0, VALUED_1,
    XXREAL_3, NEWTON;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for R,E,F being non empty set,
      zeroR,oneR being Element of R,
      addR,mulR being BinOp of R,
      oppR,invR being UnOp of R,
      normR being Function of R,REAL,
      zeroE being Element of E,
      addE being BinOp of E,
      oppE being UnOp of E,
      smulE being Function of [:R,E:],E,
      normE being Function of E,REAL,
      zeroF being Element of F,
      addF being BinOp of F,
      oppF being UnOp of F,
      smulF being Function of [:R,F:],F,
      normF being Function of F,REAL,
      p being Function of [:NAT,E*:],F,
      normProduct being Function of E*,REAL,
      coeffNorm,rootNorm being Real_Sequence,
      radius,upperLimit being ExtReal,
      tailSup being ExtREAL_sequence
  st
    zeroR <> oneR &
    (for a,b being Element of R holds
      addR.(a,b) = addR.(b,a)) &
    (for a,b,c being Element of R holds
      addR.(addR.(a,b),c) = addR.(a,addR.(b,c))) &
    (for a being Element of R holds
      addR.(a,zeroR) = a) &
    (for a being Element of R holds
      addR.(a,oppR.a) = zeroR) &
    (for a,b being Element of R holds
      mulR.(a,b) = mulR.(b,a)) &
    (for a,b,c being Element of R holds
      mulR.(mulR.(a,b),c) = mulR.(a,mulR.(b,c))) &
    (for a being Element of R holds
      mulR.(a,oneR) = a) &
    (for a being Element of R holds
      mulR.(a,zeroR) = zeroR) &
    (for a,b,c being Element of R holds
      mulR.(a,addR.(b,c)) =
        addR.(mulR.(a,b),mulR.(a,c))) &
    (for a being Element of R st a <> zeroR holds
      mulR.(a,invR.a) = oneR) &
    (for a being Element of R holds
      0 <= normR.a) &
    (for a being Element of R holds
      (normR.a = 0 iff a = zeroR)) &
    (for a,b being Element of R holds
      normR.(addR.(a,b)) <= normR.a + normR.b) &
    (for a,b being Element of R holds
      normR.(mulR.(a,b)) = normR.a * normR.b) &
    (ex a being Element of R st 1 < normR.a) &
    (for x,y being Element of E holds
      addE.(x,y) = addE.(y,x)) &
    (for x,y,z being Element of E holds
      addE.(addE.(x,y),z) = addE.(x,addE.(y,z))) &
    (for x being Element of E holds
      addE.(x,zeroE) = x) &
    (for x being Element of E holds
      addE.(x,oppE.x) = zeroE) &
    (for a being Element of R, x,y being Element of E holds
      smulE.(a,addE.(x,y)) =
        addE.(smulE.(a,x),smulE.(a,y))) &
    (for a,b being Element of R, x being Element of E holds
      smulE.(addR.(a,b),x) =
        addE.(smulE.(a,x),smulE.(b,x))) &
    (for a,b being Element of R, x being Element of E holds
      smulE.(mulR.(a,b),x) = smulE.(a,smulE.(b,x))) &
    (for x being Element of E holds
      smulE.(oneR,x) = x) &
    (for x being Element of E holds
      0 <= normE.x) &
    (for x being Element of E holds
      (normE.x = 0 iff x = zeroE)) &
    (for x,y being Element of E holds
      normE.(addE.(x,y)) <= normE.x + normE.y) &
    (for a being Element of R, x being Element of E holds
      normE.(smulE.(a,x)) = normR.a * normE.x) &
    (for y,z being Element of F holds
      addF.(y,z) = addF.(z,y)) &
    (for x,y,z being Element of F holds
      addF.(addF.(x,y),z) = addF.(x,addF.(y,z))) &
    (for y being Element of F holds
      addF.(y,zeroF) = y) &
    (for y being Element of F holds
      addF.(y,oppF.y) = zeroF) &
    (for a being Element of R, y,z being Element of F holds
      smulF.(a,addF.(y,z)) =
        addF.(smulF.(a,y),smulF.(a,z))) &
    (for a,b being Element of R, y being Element of F holds
      smulF.(addR.(a,b),y) =
        addF.(smulF.(a,y),smulF.(b,y))) &
    (for a,b being Element of R, y being Element of F holds
      smulF.(mulR.(a,b),y) = smulF.(a,smulF.(b,y))) &
    (for y being Element of F holds
      smulF.(oneR,y) = y) &
    (for y being Element of F holds
      0 <= normF.y) &
    (for y being Element of F holds
      (normF.y = 0 iff y = zeroF)) &
    (for y,z being Element of F holds
      normF.(addF.(y,z)) <= normF.y + normF.z) &
    (for a being Element of R, y being Element of F holds
      normF.(smulF.(a,y)) = normR.a * normF.y) &
    (for n,i being Nat,
         x,y,z being FinSequence of E st
      len x = n & len y = n & len z = n & i in Seg n &
      (for j being Nat st j in Seg n & j <> i holds
        x.j = y.j & x.j = z.j) &
      z/.i = addE.(x/.i,y/.i)
    holds p.[n,z] = addF.(p.[n,x],p.[n,y])) &
    (for n,i being Nat,
         a being Element of R,
         x,z being FinSequence of E st
      len x = n & len z = n & i in Seg n &
      (for j being Nat st j in Seg n & j <> i holds
        x.j = z.j) &
      z/.i = smulE.(a,x/.i)
    holds p.[n,z] = smulF.(a,p.[n,x])) &
    normProduct.(<*> E) = 1 &
    (for x being FinSequence of E holds
      ex products being FinSequence of REAL st
        len products = len x + 1 &
        products/.1 = 1 &
        (for i being Nat st i in Seg len x holds
          products/.(i+1) = products/.i * normE.(x/.i)) &
        normProduct.x = products/.(len x + 1)) &
    (for n being Nat holds
      0 <= coeffNorm.n &
      (for x being FinSequence of E st len x = n holds
        normF.(p.[n,x]) <= coeffNorm.n * normProduct.x) &
      (for C being Real st 0 <= C &
        (for x being FinSequence of E st len x = n holds
          normF.(p.[n,x]) <= C * normProduct.x)
      holds coeffNorm.n <= C)) &
    0 <= radius &
    (for r being Real st
      0 <= r &
      (ex C being Real st
        for n being Nat holds coeffNorm.n * (r |^ n) <= C)
    holds (r qua ExtReal) <= radius) &
    (for B being ExtReal st
      (for r being Real st
        0 <= r &
        (ex C being Real st
          for n being Nat holds coeffNorm.n * (r |^ n) <= C)
      holds (r qua ExtReal) <= B)
    holds radius <= B) &
    (for n being Nat holds
      rootNorm.n =
        coeffNorm.n to_power ((1 qua Real) / (n qua Real))) &
    (for N being Nat holds
      (for n being Nat st N <= n holds
        (rootNorm.n qua ExtReal) <= tailSup.N) &
      (for B being ExtReal st
        (for n being Nat st N <= n holds
          (rootNorm.n qua ExtReal) <= B)
      holds tailSup.N <= B)) &
    (for N being Nat holds upperLimit <= tailSup.N) &
    (for B being ExtReal st
      (for N being Nat holds B <= tailSup.N)
    holds B <= upperLimit)
  holds
    (radius = 0 & upperLimit = +infty) or
    (radius = +infty & upperLimit = 0) or
    (ex r being Real st
      0 < r &
      radius = (r qua ExtReal) &
      upperLimit = ((1 / r) qua ExtReal))
proof
end;
::$P+
