:: Statement-only formalization of thousand-theorems corpus artifact Q1068283,
:: "Löwenheim–Skolem theorem": every infinite first-order structure has, in
:: either elementary-embedding direction, a structure of any prescribed
:: infinite cardinality at least that of its language. This file contains no proof.

environ

 vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, NUMBERS, NAT_1, RELAT_1,
      FUNCT_2, FINSEQ_1, FUNCT_1, ARYTM_3, XCMPLX_0, CARD_1, MONOID_0,
      ORDINAL1, ARYTM_1, XXREAL_0, ORDINAL4, PARTFUN1, FINSEQ_2, EQREL_1,
      COMPLEX1, FUNCT_3, FINSET_1, FUNCT_4, FUNCOP_1, MARGREL1, PRE_POLY,
      RELAT_2, RELSET_2, MATROID0, XBOOLEAN, FOMODEL0, FOMODEL1, FOMODEL2,
      FOMODEL3;
 notations TARSKI, FINSET_1, MARGREL1, PRE_POLY, RELAT_2, MATROID0, MONOID_0,
      XBOOLE_0, ZFMISC_1, SUBSET_1, DOMAIN_1, RELSET_2, RELAT_1, RELSET_1,
      FUNCT_1, PARTFUN1, FUNCT_2, FUNCOP_1, FUNCT_4, ORDINAL1, CARD_1, NUMBERS,
      XCMPLX_0, XXREAL_0, NAT_1, INT_2, FINSEQ_1, EQREL_1, FINSEQ_2, FINSEQOP,
      XBOOLEAN, BVFUNC_1, FOMODEL0, FOMODEL1, FOMODEL2;
 constructors TARSKI, XBOOLE_0, ZFMISC_1, CARD_1, NAT_1, NUMBERS, INT_1,
      FINSEQ_1, XCMPLX_0, FUNCT_1, MONOID_0, XXREAL_0, RELAT_2, FUNCT_2,
      FUNCT_4, FUNCOP_1, FINSEQ_2, EQREL_1, RELSET_1, MCART_1, PARTFUN1,
      FINSEQOP, MATRIX_1, FUNCT_3, SETFAM_1, FINSET_1, MARGREL1, RELSET_2,
      MATROID0, LEXBFS, BINOP_1, XBOOLEAN, FUNCT_5, FOMODEL0, FOMODEL1,
      FOMODEL2, BVFUNC_1;
 registrations ORDINAL1, NAT_1, RELAT_1, FUNCT_1, INT_1, FINSEQ_1, XREAL_0,
      FUNCT_2, FINSEQ_2, SUBSET_1, FUNCOP_1, RELSET_1, PARTFUN1, EQREL_1,
      CARD_1, XBOOLE_0, XXREAL_0, SETFAM_1, MARGREL1, FINSET_1, RAMSEY_1,
      PRE_POLY, FOMODEL0, FOMODEL1, FOMODEL2;
 requirements ARITHM, BOOLE, NUMERALS, REAL, SUBSET;
 definitions RELAT_2;
 equalities XBOOLE_0, FUNCOP_1, EQREL_1, XBOOLEAN, FOMODEL0, FOMODEL1,
      FOMODEL2, ORDINAL1;
 expansions XBOOLE_0, RELAT_2, FOMODEL1, FOMODEL2;
 theorems TARSKI, XBOOLE_0, FUNCT_1, FINSEQ_1, RELAT_1, XBOOLE_1, ZFMISC_1,
      FUNCT_2, XXREAL_0, NAT_1, ORDINAL1, EQREL_1, PARTFUN1, FINSEQ_2, XREAL_1,
      FUNCT_4, FUNCOP_1, FUNCT_5, RELAT_2, RELSET_1, RELSET_2, GRFUNC_1,
      ORDERS_1, CARD_1, XTUPLE_0, FINSET_1, FOMODEL0, FOMODEL1, FOMODEL2,
      PRE_POLY;
 schemes NAT_1, FUNCT_1, FUNCT_2, FRAENKEL, FINSEQ_1, FINSEQ_4;

begin

::$P-
theorem
  for S being Language,
      U being infinite non empty set,
      I being Element of U-InterpretersOf S,
      K being Cardinal st
    omega c= K &
    card (OwnSymbolsOf S \ LettersOf S) c= K
  holds
    ex V being non empty set,
       J being Element of V-InterpretersOf S st
      card V = K &
      ((ex f being Function of V,U st
          f is one-to-one &
          for J1 being Element of V-InterpretersOf S st
            J1|(OwnSymbolsOf S \ LettersOf S) =
              J|(OwnSymbolsOf S \ LettersOf S)
          holds
            ex I1 being Element of U-InterpretersOf S st
              I1|(OwnSymbolsOf S \ LettersOf S) =
                I|(OwnSymbolsOf S \ LettersOf S) &
              (for l being literal Element of S holds
                I1.l.{} = f.(J1.l.{})) &
              (for phi being wff string of S holds
                J1-TruthEval phi = I1-TruthEval phi))
       or
       (ex f being Function of U,V st
          f is one-to-one &
          for I1 being Element of U-InterpretersOf S st
            I1|(OwnSymbolsOf S \ LettersOf S) =
              I|(OwnSymbolsOf S \ LettersOf S)
          holds
            ex J1 being Element of V-InterpretersOf S st
              J1|(OwnSymbolsOf S \ LettersOf S) =
                J|(OwnSymbolsOf S \ LettersOf S) &
              (for l being literal Element of S holds
                J1.l.{} = f.(I1.l.{})) &
              (for phi being wff string of S holds
                I1-TruthEval phi = J1-TruthEval phi)))
proof
end;
::$P+
