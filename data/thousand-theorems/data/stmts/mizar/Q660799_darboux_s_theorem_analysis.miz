:: Statement-only formalization of thousand-theorems corpus artifact Q660799
:: (thousand-theorems__mizar__Q660799), "Darboux's theorem (analysis)":
:: relative derivatives of a real function take intermediate values on
:: intervals, and their images of order-connected or convex sets remain
:: order-connected or convex. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1, RCOMP_1,
    XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0, SEQ_2,
    VALUED_1, FUNCT_2, FUNCOP_1, FUNCT_7, NAT_1, COMPLEX1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XXREAL_0, XXREAL_2, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, COMPLEX1, FDIFF_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FDIFF_1, VALUED_1, XXREAL_2, COMPLEX1,
    RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0;
  expansions TARSKI;

begin

::$P-
theorem
  for a,b,m being Real,
      f,g being Function of REAL,REAL st
    a <= b &
    (for x being Real st x in [.a,b.] holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in [.a,b.] & |.y-x.| < delta holds
            |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|) &
    g.a < m & m < g.b
  holds ex c being Real st c in ].a,b.[ & g.c = m
proof
end;
::$P+

::$P-
theorem
  for a,b,m being Real,
      f,g being Function of REAL,REAL st
    a <= b &
    (for x being Real st x in [.a,b.] holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in [.a,b.] & |.y-x.| < delta holds
            |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|) &
    m < g.a & g.b < m
  holds ex c being Real st c in ].a,b.[ & g.c = m
proof
end;
::$P+

::$P-
theorem
  for s being Subset of REAL,
      f,g being Function of REAL,REAL st
    (for x,y,z being Real st
      x in s & y in s & x <= z & z <= y holds z in s) &
    (for x being Real st x in s holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in s & |.y-x.| < delta holds
            |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|)
  holds
    for p,q,r being Real st
      (ex x being Real st x in s & g.x = p) &
      (ex y being Real st y in s & g.y = q) &
      p <= r & r <= q
    holds ex z being Real st z in s & g.z = r
proof
end;
::$P+

::$P-
theorem
  for s being Subset of REAL,
      f being Function of REAL,REAL st
    (for x,y,z being Real st
      x in s & y in s & x <= z & z <= y holds z in s) &
    (for x being Real st x in s holds
      ex d being Real st
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for y being Real st y in s & |.y-x.| < delta holds
              |.(f.y-f.x)-d*(y-x).| <= epsilon*|.y-x.|)
  holds
    ex g being Function of REAL,REAL st
      (for x being Real st x in s holds
        (((for epsilon being Real st 0 < epsilon holds
              ex delta being Real st 0 < delta &
                for y being Real st y in s & |.y-x.| < delta holds
                  |.(f.y-f.x).| <= epsilon*|.y-x.|) &
          g.x = 0)
        or
        ((not (for epsilon being Real st 0 < epsilon holds
              ex delta being Real st 0 < delta &
                for y being Real st y in s & |.y-x.| < delta holds
                  |.(f.y-f.x).| <= epsilon*|.y-x.|)) &
          (for epsilon being Real st 0 < epsilon holds
            ex delta being Real st 0 < delta &
              for y being Real st y in s & |.y-x.| < delta holds
                |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|)))) &
      (for p,q,r being Real st
        (ex x being Real st x in s & g.x = p) &
        (ex y being Real st y in s & g.y = q) &
        p <= r & r <= q
      holds ex z being Real st z in s & g.z = r)
proof
end;
::$P+

::$P-
theorem
  for s being Subset of REAL,
      f being Function of REAL,REAL st
    (for x,y,z being Real st
      x in s & y in s & x <= z & z <= y holds z in s) &
    (for x being Real st x in s holds f is_differentiable_in x)
  holds
    for p,q,r being Real st
      (ex x being Real st x in s & diff(f,x) = p) &
      (ex y being Real st y in s & diff(f,y) = q) &
      p <= r & r <= q
    holds ex z being Real st z in s & diff(f,z) = r
proof
end;
::$P+

::$P-
theorem
  for s being Subset of REAL,
      f,g being Function of REAL,REAL st
    (for x,y,u,v being Real st
      x in s & y in s & 0 <= u & 0 <= v & u+v = 1
      holds u*x+v*y in s) &
    (for x being Real st x in s holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in s & |.y-x.| < delta holds
            |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|)
  holds
    for p,q,u,v being Real st
      (ex x being Real st x in s & g.x = p) &
      (ex y being Real st y in s & g.y = q) &
      0 <= u & 0 <= v & u+v = 1
    holds ex z being Real st z in s & g.z = u*p+v*q
proof
end;
::$P+

::$P-
theorem
  for s being Subset of REAL,
      f being Function of REAL,REAL st
    (for x,y,u,v being Real st
      x in s & y in s & 0 <= u & 0 <= v & u+v = 1
      holds u*x+v*y in s) &
    (for x being Real st x in s holds
      ex d being Real st
        for epsilon being Real st 0 < epsilon holds
          ex delta being Real st 0 < delta &
            for y being Real st y in s & |.y-x.| < delta holds
              |.(f.y-f.x)-d*(y-x).| <= epsilon*|.y-x.|)
  holds
    ex g being Function of REAL,REAL st
      (for x being Real st x in s holds
        (((for epsilon being Real st 0 < epsilon holds
              ex delta being Real st 0 < delta &
                for y being Real st y in s & |.y-x.| < delta holds
                  |.(f.y-f.x).| <= epsilon*|.y-x.|) &
          g.x = 0)
        or
        ((not (for epsilon being Real st 0 < epsilon holds
              ex delta being Real st 0 < delta &
                for y being Real st y in s & |.y-x.| < delta holds
                  |.(f.y-f.x).| <= epsilon*|.y-x.|)) &
          (for epsilon being Real st 0 < epsilon holds
            ex delta being Real st 0 < delta &
              for y being Real st y in s & |.y-x.| < delta holds
                |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|)))) &
      (for p,q,u,v being Real st
        (ex x being Real st x in s & g.x = p) &
        (ex y being Real st y in s & g.y = q) &
        0 <= u & 0 <= v & u+v = 1
      holds ex z being Real st z in s & g.z = u*p+v*q)
proof
end;
::$P+

::$P-
theorem
  for s being Subset of REAL,
      f being Function of REAL,REAL st
    (for x,y,u,v being Real st
      x in s & y in s & 0 <= u & 0 <= v & u+v = 1
      holds u*x+v*y in s) &
    (for x being Real st x in s holds f is_differentiable_in x)
  holds
    for p,q,u,v being Real st
      (ex x being Real st x in s & diff(f,x) = p) &
      (ex y being Real st y in s & diff(f,y) = q) &
      0 <= u & 0 <= v & u+v = 1
    holds ex z being Real st z in s & diff(f,z) = u*p+v*q
proof
end;
::$P+

::$P-
theorem
  for a,b,m being Real,
      f,g being Function of REAL,REAL st
    a <= b &
    (for x being Real st x in [.a,b.] holds
      for epsilon being Real st 0 < epsilon holds
        ex delta being Real st 0 < delta &
          for y being Real st y in [.a,b.] & |.y-x.| < delta holds
            |.(f.y-f.x)-g.x*(y-x).| <= epsilon*|.y-x.|) &
    g.a <= m & m <= g.b
  holds ex c being Real st c in [.a,b.] & g.c = m
