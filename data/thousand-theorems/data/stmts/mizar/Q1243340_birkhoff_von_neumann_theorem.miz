:: Statement-only formalization of the thousand-theorems artifact Q1243340,
:: "Birkhoff–Von Neumann theorem": over any ordered field, doubly stochastic
:: matrices on an arbitrary finite index set are exactly the finite convex
:: combinations of permutation matrices. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, XBOOLE_0, ALGSTR_0, FINSEQ_1, SUBSET_1,
      RLVECT_1, RELAT_1, FINSEQ_2, TARSKI, STRUCT_0, ZFMISC_1, FUNCT_1,
      SUPINF_2, MESFUNC1, ARYTM_1, ARYTM_3, VECTSP_1, BINOP_1, MATRIX_1,
      XXREAL_0, FUNCOP_1, CARD_1, FUNCT_2, GROUP_1, FINSET_1, FUNCSDOM,
      REALALG1, FVSUM_1, MATRIX_0, FINSEQ_4, PARTFUN1, FINSOP_1, SETWISEO,
      ALGSTR_1, SETWOP_2, CAYLEY;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      RELAT_1, NAT_1, FUNCT_1, FUNCT_2, FINSEQ_1, FINSEQ_2, CARD_3,
      MATRIX_0, STRUCT_0, ALGSTR_0, BINOP_1, FINSEQOP, RLVECT_1,
      VECTSP_1, XXREAL_0, PARTFUN1, NAT_D, GROUP_1, GROUP_4, FINSET_1,
      FINSUB_1, FINSEQ_3, FINSEQ_4, MATRIX_1, REALALG1, FVSUM_1,
      ALGSTR_1, SETWISEO, FINSOP_1, SETWOP_2, CAYLEY;
 constructors BINOP_1, XXREAL_0, FINSEQOP, VECTSP_1, RLVECT_1,
      RELSET_1, CARD_3, FUNCT_6, CARD_2, WELLORD2, NAT_1, MATRIX_0,
      STRUCT_0, PRE_POLY, GROUP_1, RELAT_2, PARTFUN1, FINSUB_1, NAT_D,
      FINSEQ_4, GROUP_4, MATRIX_1, REALALG1, FVSUM_1, SETWISEO, FINSOP_1,
      ALGSTR_1, VALUED_0, SETWOP_2, CAYLEY;
 registrations FINSEQ_2, STRUCT_0, VECTSP_1, ORDINAL1, XXREAL_0,
      XBOOLE_0, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FINSEQ_1,
      GROUP_1, CARD_1, MATRIX_0, REALALG1, FVSUM_1, ALGSTR_1, VALUED_0,
      CAYLEY;
 requirements NUMERALS, SUBSET, BOOLE, REAL, ARITHM;
 definitions TARSKI, RLVECT_1, ALGSTR_0, STRUCT_0, REALALG1;
 equalities FINSEQ_2, STRUCT_0, ALGSTR_0, FVSUM_1;
 expansions TARSKI, XBOOLE_0;

begin

::$P-
theorem
  for I being finite set, K being Field,
      P being Subset of K st P is positive_cone holds
  {M where M is Function of [:I,I:],the carrier of K :
    (for i,j being Element of I st i in I & j in I holds M/.[i,j] in P) &
    (for i being Element of I st i in I holds
      ex e being one-to-one FinSequence of I,
         r being FinSequence of the carrier of K st
        rng e = I & len r = len e &
        (for k being Nat st k in dom r holds
          r/.k = M/.[i,e/.k]) &
        (the addF of K) $$ r = 1.K) &
    (for j being Element of I st j in I holds
      ex e being one-to-one FinSequence of I,
         c being FinSequence of the carrier of K st
        rng e = I & len c = len e &
        (for k being Nat st k in dom c holds
          c/.k = M/.[e/.k,j]) &
        (the addF of K) $$ c = 1.K)}
  =
  {M where M is Function of [:I,I:],the carrier of K :
    ex m being Nat,
       p being FinSequence of permutations(I),
       w being FinSequence of the carrier of K st
      len p = m & len w = m &
      (for k being Nat st k in Seg m holds w.k in P) &
      (the addF of K) $$ w = 1.K &
      (for i,j being Element of I st i in I & j in I holds
        ex s being FinSequence of the carrier of K st
          len s = m &
          (for k being Nat st k in Seg m holds
            ex q being Permutation of I st q = p.k &
              (q.i = j implies s.k = w.k) &
              (q.i <> j implies s.k = 0.K)) &
          M/.[i,j] = (the addF of K) $$ s)}
proof
end;
::$P+
