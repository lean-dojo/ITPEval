:: Statement-only formalization of thousand-theorems corpus artifact Q1346677,
:: "Tietze extension theorem": a bounded continuous real-valued function on
:: a space closed-embedded in a normal space has a bounded continuous
:: extension with the same supremum norm. This file contains no proof.

environ

 vocabularies NUMBERS, VALUED_0, FUNCT_1, COMPLEX1, ARYTM_1, XXREAL_0,
      ARYTM_3, CARD_1, NAT_1, TARSKI, RELAT_1, XBOOLE_0, SERIES_1, SEQ_2,
      SEQ_1, FUNCOP_1, SUBSET_1, PRE_TOPC, ORDINAL2, CARD_3, POWER, REAL_1,
      PREPOWER, NEWTON, VALUED_1, SEQFUNC, PBOOLE, PARTFUN1, RCOMP_1,
      SETFAM_1, STRUCT_0, TOPMETR, LIMFUNC1, TOPS_2, XXREAL_1, TMAP_1,
      METRIC_1, FUNCT_2, PSCOMP_1, TIETZE, FUNCT_7, ASYMPT_1, COMPACT1;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, XCMPLX_0, NUMBERS,
      XXREAL_0, XREAL_0, COMPLEX1, REAL_1, NAT_1, NEWTON, PREPOWER, POWER,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, VALUED_0, VALUED_1, SEQ_1,
      SEQ_2, FUNCT_2, FUNCOP_1, SERIES_1, LIMFUNC1, RCOMP_1, SEQFUNC,
      STRUCT_0, PRE_TOPC, TOPS_2, BORSUK_1, TOPMETR, TSEP_1, TMAP_1,
      PSCOMP_1, TOPREALB, METRIC_1, COMPACT1;
 constructors PROB_1, LIMFUNC1, NEWTON, PREPOWER, SERIES_1, TMAP_1,
      TOPREALB, PARTFUN3, SEQFUNC, MEASURE6, PCOMPS_1, PSCOMP_1, WAYBEL18,
      COMSEQ_2, REAL_1, URYSOHN3, SUPINF_2, SEQ_1, COMPACT1;
 registrations XBOOLE_0, SUBSET_1, FUNCT_1, ORDINAL1, RELSET_1, FUNCT_2,
      NUMBERS, XXREAL_0, XREAL_0, MEMBERED, NEWTON, FCONT_3, STRUCT_0,
      PRE_TOPC, METRIC_1, BORSUK_1, TOPMETR, TOPREALB, VALUED_0, VALUED_1,
      SEQ_4, RELAT_1, TMAP_1, PARTFUN4, SERIES_1, SEQ_1, SEQ_2;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, SEQFUNC, PRE_TOPC, COMPTS_1;
 equalities STRUCT_0, LIMFUNC1, PROB_1;
 expansions TARSKI, XBOOLE_0, SEQFUNC, BORSUK_1;

begin

::$P-
theorem
  for X,Y being TopSpace,
      e being Function of X,Y,
      f being continuous Function of X,R^1 st
    Y is normal &
    (ex h being Function of X,Y|(rng e) st
      h = e & h is being_homeomorphism) &
    rng e is closed &
    (ex B being Real st
      0 <= B &
      for x being Point of X st x in the carrier of X holds
        |.f.x.| <= B)
  holds
    ex g being continuous Function of Y,R^1,
       N being Real st
      0 <= N &
      (for x being Point of X st x in the carrier of X holds
        |.f.x.| <= N) &
      (for r being Real st
        0 <= r &
        (for x being Point of X st x in the carrier of X holds
          |.f.x.| <= r)
        holds N <= r) &
      (for y being Point of Y st y in the carrier of Y holds
        |.g.y.| <= N) &
      (for r being Real st
        0 <= r &
        (for y being Point of Y st y in the carrier of Y holds
          |.g.y.| <= r)
        holds N <= r) &
      g*e = f
proof
end;
::$P+
