:: Statement-only formalization of thousand-theorems artifact Q1067156X,
:: "Bounded convergence theorem": lower integrals of nonnegative bounded
:: continuous functions converge to the lower integral of their given limit
:: under an almost-everywhere bound and convergence along a countably
:: generated filter; the pointwise sequential specialization is also stated.
:: This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, PROB_1, MEASURE1, SUBSET_1, SEQFUNC,
      MESFUNC5, PARTFUN1, XXREAL_0, NAT_1, RELAT_1, ARYTM_3,
      ARYTM_1, FUNCT_1, ORDINAL2, CARD_1, COMPLEX1, SEQ_2, TARSKI,
      REAL_1, PBOOLE, MESFUNC1, MESFUNC2, VALUED_1, ZFMISC_1, FUNCT_2,
      SETFAM_1, MEASURE3, MEASURE6;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
      XXREAL_3, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, XXREAL_0, VALUED_0,
      RELAT_1, FUNCT_1, RELSET_1, FUNCT_2, PARTFUN1, NAT_1, PROB_1,
      MEASURE1, MEASURE3, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6,
      SETFAM_1;
 constructors REAL_1, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5, MESFUNC6,
      RELSET_1, COMPLEX1, MEASURE3, SETFAM_1;
 registrations SUBSET_1, NAT_1, XREAL_0, MEMBERED, ORDINAL1, PARTFUN1,
      MEASURE1, MEASURE3, FUNCT_2, RELAT_1, XBOOLE_0, NUMBERS, XXREAL_0,
      XCMPLX_0, FUNCT_1, VALUED_0, XXREAL_3, RELSET_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, MESFUNC5, MESFUNC6;
 equalities XBOOLE_0;
 expansions TARSKI, XBOOLE_0, FUNCT_2;

begin

::$P-
theorem
  for X being empty set,
      I being set,
      tau being Subset-Family of X,
      S being SigmaField of X,
      M being sigma_Measure of S,
      L being Subset-Family of I,
      F being Function of I,Funcs(X,REAL),
      f being Function of X,REAL,
      c being Real
  st
    X in tau &
    (for A being Subset-Family of X st A c= tau holds union A in tau) &
    (for U,V being Subset of X st U in tau & V in tau
      holds U /\ V in tau) &
    (for U being Subset of X st U in tau holds U in S) &
    M.X < +infty &
    I in L &
    (for A,B being Subset of I st A in L & A c= B holds B in L) &
    (for A,B being Subset of I st A in L & B in L
      holds A /\ B in L) &
    (ex B being sequence of bool I st
      for A being Subset of I holds
        (A in L iff ex n being Nat st B.n c= A)) &
    0 <= c &
    (for i being Element of I st i in I holds
      ex Fi being Function of X,REAL,
         b being Real
      st
        F.i = Fi &
        (for x being Element of X st x in X holds
          0 <= Fi.x & Fi.x <= b) &
        for x being Element of X,
            eps being Real st x in X & 0 < eps holds
          ex U being Subset of X st
            U in tau & x in U &
            for y being Element of X st y in X & y in U holds
              |.Fi.y - Fi.x.| < eps) &
    (for x being Element of X st x in X holds 0 <= f.x) &
    {i where i is Element of I:
      i in I &
      ex Fi being Function of X,REAL,
         N being Element of S
      st
        F.i = Fi &
        M.N = 0 &
        for x being Element of X st x in X & not x in N holds
          Fi.x <= c} in L &
    (ex N being Element of S st
      M.N = 0 &
      for x being Element of X st x in X & not x in N holds
        for eps being Real st 0 < eps holds
          {i where i is Element of I:
            i in I &
            ex Fi being Function of X,REAL st
              F.i = Fi & |.Fi.x - f.x.| < eps} in L)
  holds
    ex J being Function of I,ExtREAL
    st
      (for i being Element of I st i in I holds J.i = 0) &
      for eps being Real st 0 < eps holds
        {i where i is Element of I:
          i in I & |.J.i - 0 qua ExtReal.| < eps} in L
proof
end;
::$P+

::$P-
theorem
  for X being non empty set,
      I being set,
      tau being Subset-Family of X,
      S being SigmaField of X,
      M being sigma_Measure of S,
      L being Subset-Family of I,
      F being Function of I,Funcs(X,REAL),
      f being Function of X,REAL,
      c being Real
  st
    X in tau &
    (for A being Subset-Family of X st A c= tau holds union A in tau) &
    (for U,V being Subset of X st U in tau & V in tau
      holds U /\ V in tau) &
    (for U being Subset of X st U in tau holds U in S) &
    M.X < +infty &
    I in L &
    (for A,B being Subset of I st A in L & A c= B holds B in L) &
    (for A,B being Subset of I st A in L & B in L
      holds A /\ B in L) &
    (ex B being sequence of bool I st
      for A being Subset of I holds
        (A in L iff ex n being Nat st B.n c= A)) &
    0 <= c &
    (for i being Element of I st i in I holds
      ex Fi being Function of X,REAL,
         b being Real
      st
        F.i = Fi &
        (for x being Element of X st x in X holds
          0 <= Fi.x & Fi.x <= b) &
        for x being Element of X,
            eps being Real st x in X & 0 < eps holds
          ex U being Subset of X st
            U in tau & x in U &
            for y being Element of X st y in X & y in U holds
              |.Fi.y - Fi.x.| < eps) &
    (for x being Element of X st x in X holds 0 <= f.x) &
    {i where i is Element of I:
      i in I &
      ex Fi being Function of X,REAL,
         N being Element of S
      st
        F.i = Fi &
        M.N = 0 &
        for x being Element of X st x in X & not x in N holds
          Fi.x <= c} in L &
    (ex N being Element of S st
      M.N = 0 &
      for x being Element of X st x in X & not x in N holds
        for eps being Real st 0 < eps holds
          {i where i is Element of I:
            i in I &
            ex Fi being Function of X,REAL st
              F.i = Fi & |.Fi.x - f.x.| < eps} in L)
  holds
    ex J being Function of I,ExtREAL
    st
      (for i being Element of I st i in I holds
        ex Fi being Function of X,REAL st
          F.i = Fi & J.i = integral+(COM(M),R_EAL Fi)) &
      ((integral+(COM(M),R_EAL f) < +infty &
        for eps being Real st 0 < eps holds
          {i where i is Element of I:
            i in I &
            |.J.i - integral+(COM(M),R_EAL f).| < eps} in L)
       or
       (integral+(COM(M),R_EAL f) = +infty &
        for b being Real holds
          {i where i is Element of I:
            i in I & b < J.i} in L))
proof
end;
::$P+

::$P-
theorem
  for X being empty set,
      tau being Subset-Family of X,
      S being SigmaField of X,
      M being sigma_Measure of S,
      F being sequence of Funcs(X,REAL),
      f being Function of X,REAL,
      c being Real
  st
    X in tau &
    (for A being Subset-Family of X st A c= tau holds union A in tau) &
    (for U,V being Subset of X st U in tau & V in tau
      holds U /\ V in tau) &
    (for U being Subset of X st U in tau holds U in S) &
    M.X < +infty &
    0 <= c &
    (for n being Nat holds
      ex Fn being Function of X,REAL
      st
        F.n = Fn &
        (for x being Element of X st x in X holds
          0 <= Fn.x & Fn.x <= c) &
        for x being Element of X,
            eps being Real st x in X & 0 < eps holds
          ex U being Subset of X st
            U in tau & x in U &
            for y being Element of X st y in X & y in U holds
              |.Fn.y - Fn.x.| < eps) &
    (for x being Element of X st x in X holds 0 <= f.x) &
    (for x being Element of X,
         eps being Real st x in X & 0 < eps holds
      ex n0 being Nat st
        for n being Nat st n0 <= n holds
          ex Fn being Function of X,REAL st
            F.n = Fn & |.Fn.x - f.x.| < eps)
  holds
    ex J being sequence of ExtREAL
    st
      (for n being Nat holds J.n = 0) &
      for eps being Real st 0 < eps holds
        ex n0 being Nat st
          for n being Nat st n0 <= n holds
            |.J.n - 0 qua ExtReal.| < eps
proof
end;
::$P+

::$P-
theorem
  for X being non empty set,
      tau being Subset-Family of X,
      S being SigmaField of X,
      M being sigma_Measure of S,
      F being sequence of Funcs(X,REAL),
      f being Function of X,REAL,
      c being Real
  st
    X in tau &
    (for A being Subset-Family of X st A c= tau holds union A in tau) &
    (for U,V being Subset of X st U in tau & V in tau
      holds U /\ V in tau) &
    (for U being Subset of X st U in tau holds U in S) &
    M.X < +infty &
    0 <= c &
    (for n being Nat holds
      ex Fn being Function of X,REAL
      st
        F.n = Fn &
        (for x being Element of X st x in X holds
          0 <= Fn.x & Fn.x <= c) &
        for x being Element of X,
            eps being Real st x in X & 0 < eps holds
          ex U being Subset of X st
            U in tau & x in U &
            for y being Element of X st y in X & y in U holds
              |.Fn.y - Fn.x.| < eps) &
    (for x being Element of X st x in X holds 0 <= f.x) &
    (for x being Element of X,
         eps being Real st x in X & 0 < eps holds
      ex n0 being Nat st
        for n being Nat st n0 <= n holds
          ex Fn being Function of X,REAL st
            F.n = Fn & |.Fn.x - f.x.| < eps)
  holds
    ex J being sequence of ExtREAL
    st
      (for n being Nat holds
        ex Fn being Function of X,REAL st
          F.n = Fn & J.n = integral+(COM(M),R_EAL Fn)) &
      ((integral+(COM(M),R_EAL f) < +infty &
        for eps being Real st 0 < eps holds
          ex n0 being Nat st
            for n being Nat st n0 <= n holds
              |.J.n - integral+(COM(M),R_EAL f).| < eps)
       or
       (integral+(COM(M),R_EAL f) = +infty &
        for b being Real holds
          ex n0 being Nat st
            for n being Nat st n0 <= n holds b < J.n))
proof
end;
::$P+
