:: Statement-only formalization of thousand-theorems corpus artifact Q5566491,
:: "Glaisher's theorem": for every natural n and positive natural m, the
:: number of partitions of n into parts not divisible by m equals the number
:: in which every part occurs fewer than m times. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, NUMBERS,
    NAT_1, FINSEQ_1, FINSEQ_2, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    ORDINAL1, VALUED_0, VALUED_1, ARYTM_1, ARYTM_3, CARD_3, CLASSES1,
    RFINSEQ;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, RELAT_1, FUNCT_1, FINSEQ_1, RVSUM_1,
    FINSEQ_2, NAT_1, NAT_D, CLASSES1;
  constructors REAL_1, NAT_D, RELSET_1, NUMBERS, RVSUM_1, FINSEQOP,
    CLASSES1;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, FINSEQ_1, FINSEQ_2, RVSUM_1,
    VALUED_0, VALUED_1, CARD_1, RFINSEQ;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,m being Nat st 0 < m holds
    card { p where p is FinSequence of NAT :
      Sum p = n &
      (for i being Nat st i in dom p holds
        0 < p.i & not m divides p.i) &
      (for i,j being Nat st
        i in dom p & j in dom p & i < j holds p.i >= p.j) } =
    card { p where p is FinSequence of NAT :
      Sum p = n &
      (for i being Nat st i in dom p holds 0 < p.i) &
      (for i,j being Nat st
        i in dom p & j in dom p & i < j holds p.i >= p.j) &
      (for a being Nat st a in rng p holds card Coim(p,a) < m) }
proof
end;
::$P+
