:: Statement-only formalization of thousand-theorems corpus artifact Q1144897,
:: "Brouwer fixed-point theorem": every continuous self-map of a nonempty
:: compact convex subset of a finite-dimensional real normed vector space has
:: a fixed point. This file contains no proof.

environ

  vocabularies NUMBERS, XBOOLE_0, SUBSET_1, TARSKI, ZFMISC_1, RELAT_1,
    FUNCT_1, FUNCT_2, CARD_1, CARD_3, STRUCT_0, ALGSTR_0, RLVECT_1,
    RLVECT_5, NORMSP_0, NORMSP_1, NORMSP_2, PRE_TOPC, TOPS_1, TOPS_2,
    TOPGEN_4, COMPTS_1, RCOMP_1, XXREAL_0, XXREAL_2, SUPINF_1, SUPINF_2,
    NAT_1, REAL_1, ARYTM_1, ARYTM_3, SETFAM_1, REAL_NS1, MEMBERED,
    CONVEX1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
    FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, CARD_1, CARD_3, ORDINAL1,
    NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0, REAL_1,
    EXTREAL1, NAT_1, SUPINF_1, SUPINF_2, STRUCT_0, ALGSTR_0, PRE_TOPC,
    TOPS_2, COMPTS_1, RLVECT_1, RLVECT_5, NORMSP_0, NORMSP_1, NORMSP_2,
    TOPGEN_4, REAL_NS1, CONVEX1;
  constructors RELSET_1, DOMAIN_1, REAL_1, EXTREAL1, NAT_1, PRE_TOPC,
    TOPS_2, COMPTS_1, NORMSP_2, RLVECT_5, TOPGEN_4, REAL_NS1, SUPINF_1,
    CONVEX1;
  registrations XBOOLE_0, SUBSET_1, RELSET_1, ORDINAL1, NUMBERS, XREAL_0,
    NAT_1, CARD_1, CARD_3, MEMBERED, STRUCT_0, RLVECT_1, RLVECT_5,
    NORMSP_1, PRE_TOPC, TOPS_1, COMPTS_1, XXREAL_3, REAL_NS1, REAL_NS2,
    CONVEX1;
  requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
  definitions TARSKI, XBOOLE_0, PRE_TOPC, RLVECT_1, CONVEX1;
  equalities XBOOLE_0, SUBSET_1, STRUCT_0, ALGSTR_0, RLVECT_1, NORMSP_0;
  expansions TARSKI, XBOOLE_0, RLVECT_1;

begin

::$P-
theorem
  for V being finite-dimensional RealNormSpace,
      s being non empty convex Subset of V,
      t being non empty Subset of TopSpaceNorm V,
      f being Function of
        (TopSpaceNorm V) | t, (TopSpaceNorm V) | t st
    s = t & (TopSpaceNorm V) | t is compact &
    (for P being Subset of (TopSpaceNorm V) | t st P is closed
      holds f"P is closed)
  holds ex x being Point of (TopSpaceNorm V) | t st f.x = x
proof
end;
::$P+
