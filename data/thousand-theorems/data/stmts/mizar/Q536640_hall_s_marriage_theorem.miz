:: Statement-only formalization of thousand-theorems corpus artifact Q536640,
:: "Hall's marriage theorem": a family of finite sets indexed by an arbitrary
:: set has an injective choice function exactly when every finite subfamily
:: has a union at least as large as its index set. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    FUNCT_2, CARD_1, CARD_2, FINSET_1, FINSUB_1, NUMBERS, NAT_1,
    ORDINAL1, XCMPLX_0, XXREAL_0, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FINSET_1, FINSUB_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XXREAL_0, NAT_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, FINSET_1, FINSUB_1,
    CARD_1, CARD_2, XXREAL_0, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FINSET_1, FINSUB_1, ORDINAL1, CARD_1, CARD_2, XCMPLX_0, XXREAL_0,
    NAT_1;
  requirements SUBSET, BOOLE, NUMERALS, ARITHM;

begin

::$P-
theorem
  for I,A being set, T being Function of I,Fin A holds
    ((for S being Element of Fin I holds
        ex U being Element of Fin A st
          U = union (T.:S) & card S <= card U)
      iff
      ex f being Function of I,A st
        f is one-to-one &
        for i being object st i in I holds f.i in T.i)
proof
end;
::$P+
