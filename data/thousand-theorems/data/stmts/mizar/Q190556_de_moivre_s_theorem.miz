:: Statement-only formalization of thousand-theorems corpus artifact Q190556
:: (thousand-theorems__mizar__Q190556), "De Moivre's theorem": for every
:: natural exponent and complex argument, the corresponding power of cosine
:: plus imaginary sine equals cosine plus imaginary sine at the multiplied
:: argument. This file contains no proof.

environ

 vocabularies SUBSET_1, NUMBERS, FUNCT_1, ORDINAL2, XCMPLX_0, RELAT_1,
      ARYTM_1, ARYTM_3, PARTFUN1, COMPLEX1, SIN_COS, CARD_1, SIN_COS2,
      PREPOWER, SIN_COS3, FUNCT_7, REAL_1, NEWTON, NAT_1;
 notations SUBSET_1, FUNCT_1, ORDINAL1, NUMBERS, XCMPLX_0, COMPLEX1,
      XREAL_0, REAL_1, NAT_1, PARTFUN1, FUNCT_2, COMSEQ_3, SIN_COS,
      SIN_COS2, SIN_COS3;
 constructors FUNCT_4, ARYTM_0, REAL_1, NAT_1, BINOP_2, PARTFUN1,
      COMSEQ_3, SIN_COS, SIN_COS2, RVSUM_1, XXREAL_0, FCONT_1, SIN_COS3;
 registrations NUMBERS, XCMPLX_0, MEMBERED, RELSET_1, XREAL_0, SIN_COS,
      VALUED_0, CFUNCT_1;
 requirements NUMERALS, SUBSET, ARITHM;
 definitions FUNCT_2;

begin

::$P-
theorem
  for n being Element of NAT, z being Complex holds
    (cos_C/.z + <i>*sin_C/.z) |^ n =
      cos_C/.(n*z) + <i>*sin_C/.(n*z)
proof
end;
::$P+
