:: Statement-only formalization of thousand-theorems corpus artifact Q3527215,
:: "Hilbert projection theorem": every point in a real inner-product space has
:: a nearest point in each nonempty complete convex subset. This file contains
:: no proof.

environ

 vocabularies NUMBERS, BHSP_1, PRE_TOPC, REAL_1, NAT_1, SUBSET_1, SUPINF_2,
      SEQ_2, XXREAL_0, CARD_1, METRIC_1, FUNCT_1, ARYTM_3, ARYTM_1,
      RELAT_1, COMPLEX1, NORMSP_1, ORDINAL2, SEQ_1, TARSKI, STRUCT_0,
      XBOOLE_0, CONVEX1;
 notations TARSKI, XBOOLE_0, ORDINAL1, SUBSET_1, NUMBERS, XCMPLX_0, XREAL_0,
      COMPLEX1, REAL_1, NAT_1, SEQ_1, COMSEQ_2, SEQ_2, RELAT_1, VALUED_0,
      STRUCT_0, PRE_TOPC, RLVECT_1, VFUNCT_1, BHSP_1, NORMSP_1, XXREAL_0,
      CONVEX1;
 constructors DOMAIN_1, XXREAL_0, REAL_1, NAT_1, COMPLEX1, SEQ_2, BHSP_1,
      VALUED_1, RELSET_1, VFUNCT_1, COMSEQ_2, CONVEX1;
 registrations ORDINAL1, RELSET_1, XREAL_0, STRUCT_0, VFUNCT_1, FUNCT_2,
      NAT_1, SUBSET_1;
 requirements REAL, NUMERALS, SUBSET, ARITHM, BOOLE;
 definitions TARSKI, CONVEX1;
 equalities STRUCT_0, RLVECT_1;
 expansions TARSKI;

begin

::$P-
theorem
  for X being RealUnitarySpace,
      K being Subset of X st
    K <> {} &
    K is convex &
    (for s being sequence of X st
      (for n being Nat holds s.n in K) &
      (for epsilon being Real st 0 < epsilon holds
        ex N being Nat st
          for m,n being Nat st N <= m & N <= n holds
            ||.s.m-s.n.|| < epsilon)
     holds
      ex v being Point of X st
        v in K &
        for epsilon being Real st 0 < epsilon holds
          ex N being Nat st
            for n being Nat st N <= n holds
              ||.s.n-v.|| < epsilon)
  holds
    for u being Point of X holds
      ex v being Point of X st
        v in K &
        for w being Point of X st w in K holds
          ||.u-v.|| <= ||.u-w.||
proof
end;
::$P+
