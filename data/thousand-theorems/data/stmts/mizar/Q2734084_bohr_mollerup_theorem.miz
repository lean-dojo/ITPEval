:: Statement-only formalization of "Bohr-Mollerup theorem" from Thousand
:: Theorems artifact Q2734084 (thousand-theorems__mizar__Q2734084): a positive
:: log-convex real function on the positive reals, normalized at one and
:: satisfying the Gamma recurrence, agrees there with Euler's Gamma function,
:: represented by Euler's limit formula. This file contains no proof.

environ

  vocabularies NUMBERS, RCOMP_1, SUBSET_1, REAL_1, COMPLEX1, SQUARE_1,
    NEWTON, ARYTM_3, RELAT_1, CARD_1, PARTFUN1, SEQ_1, TAYLOR_1,
    XXREAL_1, ARYTM_1, TARSKI, FDIFF_1, FUNCT_1, SERIES_1, REALSET1,
    XBOOLE_0, SIN_COS, XXREAL_0, VALUED_0, VALUED_1, SEQ_2, ORDINAL2,
    CARD_3, ABIAN, TAYLOR_2, NAT_1, POWER, PREPOWER;
  notations TARSKI, SUBSET_1, RELAT_1, FUNCT_1, PARTFUN1, RFUNCT_2,
    RCOMP_1, XXREAL_0, XCMPLX_0, XREAL_0, ORDINAL1, NUMBERS, COMPLEX1,
    SQUARE_1, REAL_1, NAT_1, FUNCT_2, VALUED_1, SEQ_1, COMSEQ_2, SEQ_2,
    SERIES_1, FDIFF_1, SEQFUNC, NEWTON, PREPOWER, POWER, SIN_COS,
    TAYLOR_1, ABIAN;
  constructors ARYTM_0, REAL_1, SQUARE_1, NAT_1, SEQ_2, RCOMP_1,
    RFUNCT_2, LIMFUNC1, FDIFF_1, COMSEQ_3, SIN_COS, ABIAN, TAYLOR_1,
    SEQFUNC, SERIES_1, VALUED_1, RELSET_1, COMSEQ_2, PREPOWER, POWER;
  registrations RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED, RCOMP_1,
    XBOOLE_0, VALUED_0, VALUED_1, FUNCT_2, SQUARE_1, NEWTON, SIN_COS,
    INT_1, ORDINAL1, PREPOWER;
  requirements SUBSET, REAL, BOOLE, NUMERALS, ARITHM;
  definitions TAYLOR_1;
  equalities VALUED_1, SUBSET_1;
  expansions TAYLOR_1;

begin

::$P-
theorem
  for f being Function of REAL,REAL st
    (for p,x,y being Real st
      0 <= p & p <= 1 & 0 < x & 0 < y
    holds
      ln.(f.(p*x + (1-p)*y)) <=
        p*ln.(f.x) + (1-p)*ln.(f.y)) &
    (for y being Real st 0 < y holds
      f.(y+1) = y*f.y) &
    (for y being Real st 0 < y holds
      0 < f.y) &
    f.1 = 1
  holds
    for x being Real st 0 < x holds
      ex p,s being Real_Sequence st
        p.0 = x &
        (for n being Nat holds
          p.(n+1) =
            p.n * (x + ((n+1) qua Real))) &
        (for n being Nat holds
          s.n =
            ((n!) qua Real) * ((n qua Real) #R x) / p.n) &
        s is convergent &
        f.x = lim s
proof
end;
::$P+
