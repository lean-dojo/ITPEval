:: Statement-only formalization of thousand-theorems corpus artifact Q189136,
:: "Mean value theorem": Lagrange's and Cauchy's mean value theorems for
:: real functions continuous on a closed interval and differentiable on its
:: interior. This file contains no proof.

environ

  vocabularies NUMBERS, REAL_1, SUBSET_1, SEQ_1, PARTFUN1, ARYTM_3,
    XXREAL_1, TARSKI, RELAT_1, ORDINAL2, FUNCT_1, FDIFF_1, CARD_1,
    RCOMP_1, XXREAL_2, SEQ_4, XXREAL_0, XBOOLE_0, ARYTM_1, VALUED_0,
    SEQ_2, VALUED_1, FUNCT_2, FUNCOP_1, FUNCT_7, NAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XXREAL_0, XXREAL_2, XCMPLX_0, REAL_1, RELSET_1,
    VALUED_0, VALUED_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN1, PARTFUN2,
    RCOMP_1, FCONT_1, FDIFF_1;
  constructors PARTFUN1, REAL_1, NAT_1, SEQ_2, SEQ_4, RCOMP_1,
    PARTFUN2, RFUNCT_2, FCONT_1, FDIFF_1, VALUED_1, XXREAL_2,
    COMPLEX1, RELSET_1, BINOP_2, COMSEQ_2;
  registrations XBOOLE_0, RELSET_1, NUMBERS, XREAL_0, NAT_1, MEMBERED,
    RCOMP_1, FDIFF_1, VALUED_0, VALUED_1, FUNCT_2, XXREAL_2, FCONT_1,
    ORDINAL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;
  definitions TARSKI;
  equalities XCMPLX_0;
  expansions TARSKI;
  theorems TARSKI, NAT_1, SEQ_1, SEQ_2, SEQ_4, PARTFUN2, RFUNCT_2,
    RCOMP_1, FCONT_1, FDIFF_1, ZFMISC_1, FUNCT_1, XREAL_0, XBOOLE_0,
    XBOOLE_1, XCMPLX_1, FUNCOP_1, XREAL_1, XXREAL_0, VALUED_1,
    XXREAL_2, XXREAL_1, FUNCT_2, VALUED_0, ORDINAL1;
  schemes SEQ_1;

begin

::$P-
theorem
  for a,b being Real st a < b holds
  for f being Function of REAL,REAL st
    f|[.a,b.] is continuous &
    f is_differentiable_on ].a,b.[ holds
  ex c being Real st
    c in ].a,b.[ &
    diff(f,c) = (f.b-f.a)/(b-a)
proof
end;
::$P+

::$P-
theorem
  for a,b being Real st a < b holds
  for f,g being Function of REAL,REAL st
    f|[.a,b.] is continuous &
    f is_differentiable_on ].a,b.[ &
    g|[.a,b.] is continuous &
    g is_differentiable_on ].a,b.[ holds
  ex c being Real st
    c in ].a,b.[ &
    (g.b-g.a)*diff(f,c) = (f.b-f.a)*diff(g,c)
proof
end;
::$P+
