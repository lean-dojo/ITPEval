:: Statement-only formalization of thousand-theorems corpus artifact Q2096184,
:: "Plancherel theorem": the Fourier transform preserves the integral of the
:: pointwise complex inner product of two Hilbert-valued Schwartz functions on
:: a finite-dimensional real inner-product space. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, TARSKI, ZFMISC_1, ORDINAL1, NAT_1, FINSEQ_1, FINSEQ_2, CARD_1,
      ARYTM_1, ARYTM_3, XXREAL_0, XCMPLX_0, COMPLEX1, REAL_1, VALUED_0,
      VALUED_1, SEQ_1, SEQ_2, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1,
      NORMSP_0, NORMSP_1, CLVECT_1, CLOPBAN1, PROB_1, MEASURE1,
      MESFUNC1, MESFUNC5, INTEGRA5, SUPINF_2, EUCLID,
      EUCLID_7, MATRIXR2, RVSUM_1, SIN_COS, FINSET_1, FUNCOP_1, PBOOLE,
      MEMBERED, SETFAM_1, NEWTON;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, SETFAM_1,
      RELAT_1, FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, FUNCOP_1, NUMBERS,
      XCMPLX_0, XXREAL_0, XREAL_0, COMPLEX1, REAL_1, NAT_1, FINSEQ_1,
      FINSEQ_2, VALUED_0, VALUED_1, SEQ_1, RVSUM_1, EUCLID, MATRIXR2,
      EUCLID_7, NEWTON, SIN_COS, STRUCT_0, ALGSTR_0, PRE_TOPC, RLVECT_1,
      NORMSP_0, VECTSP_1, CLVECT_1, CLOPBAN1, PROB_1, MEASURE1,
      EXTREAL1, MESFUNC1, MESFUNC5, MESFUNC6, MESFUN6C, SUPINF_2;
 constructors REAL_1, COMPLEX1, SIN_COS, SEQ_2, FINSEQ_2, RVSUM_1, EUCLID,
      MATRIXR2, EUCLID_7, NEWTON, CLVECT_1, CLOPBAN1, MEASURE1, MESFUNC1,
      MESFUNC2, MESFUNC5, MESFUNC6, MESFUN6C, EXTREAL1, SUPINF_1, RELSET_1,
      FUNCOP_1;
 registrations XBOOLE_0, SUBSET_1, RELSET_1, ORDINAL1, NUMBERS, XREAL_0,
      MEMBERED, NAT_1, FINSEQ_1, FINSEQ_2, FUNCT_1, FUNCT_2, PARTFUN1,
      VALUED_0, VALUED_1, XCMPLX_0, STRUCT_0, RLVECT_1, NORMSP_0,
      CLVECT_1, CLOPBAN1, MEASURE1, EUCLID, EUCLID_7, SIN_COS,
      NEWTON;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_2, RLVECT_1, CLVECT_1,
      NORMSP_0, MESFUNC1, MESFUNC5, MESFUNC6;
 equalities XBOOLE_0, RLVECT_1, CLVECT_1, STRUCT_0, ALGSTR_0,
      NORMSP_0, FINSEQ_1, FINSEQ_2;
 expansions TARSKI, XBOOLE_0, FUNCT_2, RLVECT_1, CLVECT_1,
      NORMSP_0, MESFUNC1, MESFUNC6, FINSEQ_1;

begin

::$P-
theorem
  for n being Nat,
      S being SigmaField of REAL n,
      M being sigma_Measure of S,
      H being ComplexBanachSpace,
      ip being Function of [:the carrier of H,the carrier of H:],COMPLEX,
      J being Relation of Funcs(REAL n,the carrier of H),
                          the carrier of H,
      W being Subset of Funcs(REAL n,the carrier of H),
      f,g,F,G being Function of REAL n,the carrier of H,
      cFG,cfg being Function of REAL n,COMPLEX
  st
    (for x,y,z being Point of H, a being Complex holds
      0 <= Re(ip.[x,x]) &
      Im(ip.[x,x]) = 0 &
      (ip.[x,x] = 0 iff x = 0.H) &
      ip.[x,y] = (ip.[y,x])*' &
      ip.[x,y+z] = ip.[x,y] + ip.[x,z] &
      ip.[x,a*y] = a*ip.[x,y] &
      ||.x.||*||.x.|| = Re(ip.[x,x])) &
    (ex B being Subset-Family of REAL n,
        C being Subset of REAL n st
      (for A being Subset of REAL n holds
        A in B iff
          ex c being Element of REAL n, r being Real st
            0 < r &
            A = {x where x is Element of REAL n: |.x-c.| < r}) &
      S = sigma(B) &
      C in S &
      C = {x where x is Element of REAL n:
        for i being Nat st i in Seg n holds 0 <= x.i & x.i < 1} &
      M.C = 1 &
      (for A being Element of S, a being Element of REAL n holds
        ex T being Element of S st
          T = {y where y is Element of REAL n:
            ex x being Element of REAL n st x in A & y = x+a} &
          M.T = M.A)) &
    (for u being Function of REAL n,the carrier of H holds
      u in W iff
        ex D being Function of NAT*,Funcs(REAL n,the carrier of H) st
          D.(<*>NAT) = u &
          (for s being FinSequence of NAT, i being Nat st
              rng s c= Seg n & i in Seg n holds
            ex q being FinSequence of NAT,
               ds,dq being Function of REAL n,the carrier of H st
              len q = len s + 1 &
              (for j being Nat st j in dom s holds q.j = s.j) &
              q.(len q) = i &
              D.s = ds &
              D.q = dq &
              for x being Element of REAL n, e being Real st 0 < e holds
                ex d being Real st 0 < d &
                  for t being Real st 0 < |.t.| & |.t.| < d holds
                    ||.dq.x -
                      ((1/t qua Complex)*
                        (ds.(x+t*Base_FinSeq(n,i))-ds.x)).|| < e) &
          (for s being FinSequence of NAT st rng s c= Seg n holds
            ex ds being Function of REAL n,the carrier of H st
              D.s = ds &
              (for x being Element of REAL n, e being Real st 0 < e holds
                ex d being Real st 0 < d &
                  for y being Element of REAL n st |.y-x.| < d holds
                    ||.ds.y-ds.x.|| < e) &
              for p being Nat holds
                ex C being Real st 0 <= C &
                  for x being Element of REAL n holds
                    ((1+|.x.|) |^ p)*||.ds.x.|| <= C)) &
    f in W &
    g in W &
    (for u being Function of REAL n,the carrier of H,
         y being Point of H holds
      [u,y] in J iff
        ex Q being sequence of Funcs(REAL n,the carrier of H),
           I being sequence of H,
           E being Real_Sequence st
          (for k being Nat holds
            ex q being Function of REAL n,the carrier of H,
               A being FinSequence of S,
               z being sequence of H,
               r being Real_Sequence,
               p being sequence of H,
               e being Function of REAL n,REAL st
              Q.k = q &
              p.0 = 0.H &
              (for i being Nat st i < len A holds
                p.(i+1) = p.i + ((r.i) qua Complex)*z.i) &
              I.k = p.(len A) &
              (for i being Nat st i < len A holds
                0 <= r.i & M.(A.(i+1)) = r.i) &
              (for i,j being Nat st
                  i < len A & j < len A & i <> j
                holds A.(i+1) misses A.(j+1)) &
              (for x being Element of REAL n holds
                (ex i being Nat st
                  i < len A & x in A.(i+1) & q.x = z.i) or
                ((for i being Nat st i < len A holds not x in A.(i+1)) &
                  q.x = 0.H)) &
              (for x being Element of REAL n holds
                e.x = ||.u.x-q.x.||) &
              e is_integrable_on M &
              E.k = Integral(M,e)) &
          (for e being Real st 0 < e holds
            ex k0 being Nat st
              for k being Nat st k0 <= k holds |.E.k.| < e) &
          (for e being Real st 0 < e holds
            ex k0 being Nat st
              for k being Nat st k0 <= k holds ||.I.k-y.|| < e)) &
    (for w being Element of REAL n holds
      ex hf,hg being Function of REAL n,the carrier of H st
        (for x being Element of REAL n holds
          hf.x = (cos(2*PI*|(w,x)|) -
                    sin(2*PI*|(w,x)|)*<i>)*f.x &
          hg.x = (cos(2*PI*|(w,x)|) -
                    sin(2*PI*|(w,x)|)*<i>)*g.x) &
        [hf,F.w] in J &
        [hg,G.w] in J) &
    (for x being Element of REAL n holds
      cFG.x = ip.[F.x,G.x] &
      cfg.x = ip.[f.x,g.x])
  holds
    Integral(M,cFG) = Integral(M,cfg)
proof
end;
::$P+
