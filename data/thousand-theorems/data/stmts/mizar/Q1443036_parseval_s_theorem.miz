:: Statement-only formalization of thousand-theorems corpus artifact Q1443036,
:: "Parseval's theorem": for every positive period, the sum over all integer
:: Fourier modes of the squared moduli of the normalized Fourier coefficients
:: of a complex L2 function on the additive circle equals its normalized
:: squared L2 norm. This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, CARD_1, ORDINAL1, NAT_1, INT_1, VALUED_0, VALUED_1,
      XCMPLX_0, COMPLEX1, XXREAL_0, XXREAL_1, ARYTM_1, ARYTM_3, REAL_1,
      SQUARE_1, SIN_COS, SEQ_1, SEQ_2, SERIES_1, SUPINF_2, MEASURE1,
      MESFUNC1, MESFUNC5, MEASUR12, INTEGRA5;
 notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
      PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
      XXREAL_0, XXREAL_1, XXREAL_3, NAT_1, INT_1, VALUED_0, VALUED_1,
      COMPLEX1, REAL_1, SQUARE_1, SIN_COS, SEQ_1, SEQ_2, SERIES_1,
      COMSEQ_2, COMSEQ_3, SUPINF_2, MEASURE1, MESFUNC1, MESFUNC5,
      MESFUNC6, MESFUN6C, MEASUR12, INTEGRA5, EXTREAL1;
 constructors RELSET_1, FUNCT_2, NAT_1, INT_1, REAL_1, SQUARE_1, COMPLEX1,
      SIN_COS, SEQ_1, SEQ_2, SERIES_1, COMSEQ_2, COMSEQ_3, MESFUNC1,
      MESFUNC5, MESFUNC6, MESFUN6C, MEASUR12, INTEGRA5, EXTREAL1;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      ORDINAL1, CARD_1, NUMBERS, XREAL_0, NAT_1, INT_1, VALUED_0,
      VALUED_1, XCMPLX_0, COMPLEX1, SQUARE_1, XXREAL_3, MEASURE1,
      MEASUR12;
 requirements BOOLE, SUBSET, NUMERALS, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, SERIES_1, MESFUN6C;
 equalities COMPLEX1, XCMPLX_0, SQUARE_1;
 expansions TARSKI, XBOOLE_0, RELAT_1;

begin

::$P-
theorem
  for T being positive Real,
      I being Element of L-Field,
      f being Function of REAL,COMPLEX,
      sqf being Function of REAL,REAL,
      coeff being Function of INT,COMPLEX,
      sqcoeff,partial being Real_Sequence,
      energy being Real
  st
    I = [.0,T.] &
    f is I-measurable &
    (for x being Real holds sqf.x = |.(f.x).|^2) &
    sqf|I is_integrable_on L-Meas &
    energy = Integral(L-Meas,sqf|I) &
    (for m being Integer holds
      ex h being Function of REAL,COMPLEX st
        (for x being Real holds
          h.x =
            (cos.(2*PI*(m qua Real)*x/T)
              - sin.(2*PI*(m qua Real)*x/T)*<i>) * f.x) &
        h|I is_integrable_on L-Meas &
        coeff.m = (1/T) * Integral(L-Meas,h|I)) &
    sqcoeff.0 = |.(coeff.0).|^2 &
    (for k being Nat holds
      sqcoeff.(2*k+1) = |.(coeff.(k+1)).|^2 &
      sqcoeff.(2*k+2) = |.(coeff.(-(k+1))).|^2) &
    partial.0 = sqcoeff.0 &
    (for n being Nat holds
      partial.(n+1) = partial.n + sqcoeff.(n+1))
  holds
    for e being positive Real
    ex N being Nat
    st for n being Nat st N <= n holds
      (partial.n - energy/T)^2 < e^2
proof
end;
::$P+
