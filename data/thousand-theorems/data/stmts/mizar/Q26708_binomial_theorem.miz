:: Statement-only formalization of thousand-theorems corpus artifact Q26708,
:: "Binomial theorem": over an arbitrary commutative semiring, the nth power
:: of x + y equals its finite binomial expansion. This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, INT_1, CARD_1, REAL_1, XCMPLX_0, XXREAL_0,
      COMPLEX1, RLVECT_1, ALGSTR_0, BINOP_1, VECTSP_1, LATTICES, XBOOLE_0,
      SUBSET_1, ARYTM_1, RELAT_1, ARYTM_3, RLSUB_1, SUPINF_2, GROUP_1,
      STRUCT_0, TARSKI, REALSET1, ZFMISC_1, FUNCT_1, MESFUNC1,
      FINSEQ_1, FINSET_1, NEWTON, ORDINAL1, BINOM, PARTFUN1;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, REALSET1, FUNCT_1,
      PARTFUN1, FUNCT_2, FINSEQ_1, FINSET_1, CARD_1, ORDINAL1, NUMBERS,
      XCMPLX_0, XXREAL_0,
      XREAL_0, INT_1, NAT_1, STRUCT_0, ALGSTR_0, DOMAIN_1, BINOP_1,
      RLVECT_1, GROUP_1, VECTSP_1, INT_2, NEWTON, BINOM;
 constructors PARTFUN1, BINOP_1, REALSET1, ORDINAL1, NAT_1, FINSET_1, NEWTON,
      XXREAL_0, REAL_1, NAT_D, VECTSP_1, RLVECT_1, RELSET_1, GROUP_1, BINOM;
 registrations XBOOLE_0, SUBSET_1, FUNCT_1, REALSET1, ORDINAL1, NUMBERS,
      XREAL_0, INT_1, CARD_1, STRUCT_0, VECTSP_1, RELAT_1, ALGSTR_0, NAT_1,
      FINSEQ_1, FINSET_1;
 requirements NUMERALS, REAL, SUBSET, BOOLE, ARITHM;
 definitions TARSKI, RLVECT_1, XBOOLE_0, ALGSTR_0, VECTSP_1;
 equalities ORDINAL1, BINOP_1, REALSET1, STRUCT_0, ALGSTR_0, VECTSP_1;
 expansions TARSKI, XBOOLE_0, STRUCT_0;

begin

::$P-
theorem
  for R being unital non empty doubleLoopStr,
      x,y being Element of R, n being Nat
  st
    (for a,b,c being Element of R holds
      (a + b) + c = a + (b + c) &
      a + b = b + a &
      a + 0.R = a &
      (a * b) * c = a * (b * c) &
      a * b = b * a &
      a * 1.R = a &
      1.R * a = a &
      a * (b + c) = a * b + a * c &
      (a + b) * c = a * c + b * c &
      a * 0.R = 0.R &
      0.R * a = 0.R)
  holds
    ex terms,partial being FinSequence of the carrier of R st
      len terms = n + 1 &
      (for k being Nat st k <= n holds
        ex nk being Nat, xk,ynk being Element of R st
          nk = n -' k &
          xk = x|^k &
          ynk = y|^nk &
          terms/.(k + 1) = (n choose k) * ynk * xk) &
      len partial = n + 2 &
      partial/.1 = 0.R &
      (for k being Nat st k <= n holds
        partial/.(k + 2) =
          partial/.(k + 1) + terms/.(k + 1)) &
      (x + y)|^n = partial/.(n + 2)
proof
end;
::$P+
