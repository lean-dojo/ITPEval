:: Statement-only formalization of thousand-theorems corpus artifact Q7249519
:: (thousand-theorems__mizar__Q7249519), "Prokhorov's theorem": for a
:: Hausdorff space with its Borel sigma-field, finite measures of bounded mass
:: whose masses outside a compact sequence tend uniformly to zero form a
:: compact set in the weak topology, assuming normality or monotonicity of the
:: compact sequence.  The weak topology below is its equivalent initial-
:: topology presentation using integrals of bounded continuous real functions.
:: This file contains no proof.

environ

 vocabularies NUMBERS, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
      PARTFUN1, TARSKI, ZFMISC_1, ORDINAL1, NAT_1, CARD_1, FINSET_1,
      ARYTM_1, ARYTM_3, XXREAL_0, XCMPLX_0, COMPLEX1, REAL_1, VALUED_0,
      VALUED_1, STRUCT_0, PRE_TOPC, TOPS_1, TOPS_2, COMPTS_1, RCOMP_1,
      CONNSP_2, TOPGEN_4, TOPMETR, EUCLID, PROB_1, MEASURE1, MEASURE3,
      MEASURE6,
      MESFUNC1, MESFUNC2, MESFUNC5, SUPINF_1, SUPINF_2, SETFAM_1,
      MEMBERED;
 notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, SETFAM_1, RELAT_1,
      FUNCT_1, RELSET_1, PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, FINSET_1,
      NUMBERS, XCMPLX_0, XXREAL_0, XXREAL_3, XREAL_0, COMPLEX1, REAL_1, NAT_1,
      VALUED_0, VALUED_1, STRUCT_0, PRE_TOPC, TOPS_1, TOPS_2,
      COMPTS_1, CONNSP_2, TOPGEN_4, TOPMETR, EUCLID, PROB_1, PROB_2, MEASURE1,
      MEASURE3, MEASURE6, EXTREAL1, MESFUNC1, MESFUNC2, MESFUNC5,
      MESFUNC6, SUPINF_1, SUPINF_2;
 constructors ZFMISC_1, RELSET_1, FUNCT_2, COMPLEX1, REAL_1, NAT_1, FINSET_1,
      TOPS_1, TOPS_2, COMPTS_1, CONNSP_2, TOPGEN_4, TOPMETR, EUCLID,
      PROB_1, PROB_2,
      MEASURE1, MEASURE3, MEASURE6, MESFUNC1, MESFUNC2, MESFUNC5,
      MESFUNC6, EXTREAL1, SUPINF_1, SUPINF_2;
 registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
      PARTFUN1, ORDINAL1, CARD_1, FINSET_1, NUMBERS, NAT_1, XREAL_0, COMPLEX1,
      XXREAL_0, XXREAL_3, MEMBERED, VALUED_0, VALUED_1, STRUCT_0,
      PRE_TOPC, TOPS_1, COMPTS_1, TOPMETR, EUCLID, MEASURE1, MEASURE3,
      PROB_1;
 requirements NUMERALS, BOOLE, SUBSET, REAL, ARITHM;
 definitions TARSKI, XBOOLE_0, FUNCT_1, FUNCT_2, PRE_TOPC, COMPTS_1,
      MESFUNC1, MESFUNC5, MESFUNC6;
 equalities XBOOLE_0, SUBSET_1, RELAT_1, STRUCT_0, PROB_1;
 expansions TARSKI, XBOOLE_0, FUNCT_1, FUNCT_2, COMPTS_1;

begin

::$P-
theorem
  (for T being empty T_2 TopSpace,
       S being SigmaField of the carrier of T,
       u being Function of NAT,REAL,
       K being Function of NAT,bool the carrier of T,
       C being Real,
       D being Subset of Funcs(S,ExtREAL),
       tau,P being set
   st
     S = {{}} &
     0 <= C &
     (for n being Nat holds 0 <= u.n) &
     (for epsilon being Real st 0 < epsilon holds
       ex N being Nat st
         for n being Nat st N <= n holds |.u.n.| < epsilon) &
     (for n being Nat holds
       ex Kn being Subset of T st Kn = K.n & Kn is compact) &
     (T is normal or
       for m,n being Nat st m <= n holds K.m c= K.n) &
     (for f being Function of S,ExtREAL holds
       f in D iff
       ex M being sigma_Measure of S st
         f = M & M.(the carrier of T) < +infty) &
     tau = {{},D} &
     P c= D &
     (for f being Function of S,ExtREAL holds
       f in P iff
       ex M being sigma_Measure of S st
         f = M &
         M.(the carrier of T) <= C &
         for n being Nat holds
           ex Kn being Subset of T,
              A being Element of S
           st
             Kn = K.n &
             A = (the carrier of T) \ Kn &
             M.A <= u.n)
   holds
     for G being set st G c= tau & P c= union G holds
       ex G0 being finite set st G0 c= G & P c= union G0) &
  (for T being non empty T_2 TopSpace,
       S being SigmaField of the carrier of T,
       u being Function of NAT,REAL,
       K being Function of NAT,bool the carrier of T,
       C being Real,
       D being Subset of Funcs(S,ExtREAL),
       tau,P being set
   st
     S = BorelSets T &
     0 <= C &
     (for n being Nat holds 0 <= u.n) &
     (for epsilon being Real st 0 < epsilon holds
       ex N being Nat st
         for n being Nat st N <= n holds |.u.n.| < epsilon) &
     (for n being Nat holds
       ex Kn being Subset of T st Kn = K.n & Kn is compact) &
     (T is normal or
       for m,n being Nat st m <= n holds K.m c= K.n) &
     (for f being Function of S,ExtREAL holds
       f in D iff
       ex M being sigma_Measure of S st
         f = M & M.(the carrier of T) < +infty) &
     (for U being set holds
       U in tau iff
       U c= D &
       for f being Function of S,ExtREAL st f in U holds
         ex M being sigma_Measure of S,
            F being finite Subset of Funcs(the carrier of T,REAL),
            epsilon being Function of Funcs(the carrier of T,REAL),REAL
         st
           f = M &
           (for h being Function of the carrier of T,REAL st h in F holds
             0 < epsilon.h &
             (for V being Subset of R^1
               st V in the topology of R^1
               holds h"V in the topology of T) &
             ex B being Real st
               for x being Element of T holds |.h.x.| <= B) &
           for g being Function of S,ExtREAL st g in D holds
             ex N being sigma_Measure of S st
               g = N &
               ((for h being Function of the carrier of T,REAL st h in F
                   holds
                     |.Integral(N,h) - Integral(M,h).| < epsilon.h)
                implies g in U)) &
     P c= D &
     (for f being Function of S,ExtREAL holds
       f in P iff
       ex M being sigma_Measure of S st
         f = M &
         M.(the carrier of T) <= C &
         for n being Nat holds
           ex Kn being Subset of T,
              A being Element of S
           st
             Kn = K.n &
             A = (the carrier of T) \ Kn &
             M.A <= u.n)
   holds
     for G being set st G c= tau & P c= union G holds
       ex G0 being finite set st G0 c= G & P c= union G0)
proof
end;
::$P+
