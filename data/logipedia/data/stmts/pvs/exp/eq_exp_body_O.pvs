% Statement-only formalization of Logipedia corpus artifact exp.eq_exp_body_O
% (catalog title "exp.eq_exp_body_O"): for every natural base, the
% exponentiation body at exponent zero is Leibniz-equal to successor zero
% (one). This file contains no proof.

exp_eq_exp_body_O: THEORY
BEGIN
  exp_body: [nat -> [nat -> nat]]

  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  eq_exp_body_O_statement: bool =
    FORALL (n: nat):
      leibniz(exp_body(n)(0))(1)
END exp_eq_exp_body_O
