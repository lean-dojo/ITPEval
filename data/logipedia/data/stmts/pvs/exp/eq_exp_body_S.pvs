% Statement-only formalization of Logipedia corpus artifact exp.eq_exp_body_S
% (catalog title "exp.eq_exp_body_S"): for every natural base and exponent,
% the exponentiation body at the successor exponent is Leibniz-equal to the
% exponentiation value multiplied by the base. This file contains no proof.

exp_eq_exp_body_S: THEORY
BEGIN
  exp_function, exp_body: [nat -> [nat -> nat]]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  eq_exp_body_S_statement: bool =
    FORALL (n, m: nat):
      leibniz(exp_body(n)(m + 1))(exp_function(n)(m) * n)
END exp_eq_exp_body_S
