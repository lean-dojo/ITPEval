% Statement-only formalization of Logipedia corpus artifact exp.eq_exp
% (catalog title "exp.eq_exp"): for every natural base and exponent,
% exponentiation is Leibniz-equal to the natural-type filter of its body.
% This file contains no proof.

exp_eq_exp: THEORY
BEGIN
  exp_function, exp_body: [nat -> [nat -> nat]]

  filter_nat_type: [[nat -> nat] -> [nat -> nat]]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  eq_exp_statement: bool =
    FORALL (n, m: nat):
      leibniz(exp_function(n)(m))(
        filter_nat_type(exp_body(n))(m))
END exp_eq_exp
