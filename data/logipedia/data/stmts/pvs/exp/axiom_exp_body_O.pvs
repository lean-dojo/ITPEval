% Statement-only formalization of Logipedia corpus artifact exp.axiom_exp_body_O
% (catalog title "exp.axiom_exp_body_O"): for every natural base, the
% exponentiation body at exponent zero is related by the source equality to
% successor zero (one). This file contains no proof.

exp_axiom_exp_body_O: THEORY
BEGIN
  connectives_equal: [nat -> [nat -> bool]]

  exp_body: [nat -> [nat -> nat]]
  axiom_exp_body_O_statement: bool =
    FORALL (n: nat):
      connectives_equal(exp_body(n)(0))(1)
END exp_axiom_exp_body_O
