% Statement-only formalization of the Logipedia corpus artifact exp.lt_O_exp
% (catalog title "exp.lt_O_exp"): every positive natural base has a positive
% natural power at every natural exponent. This file contains no proof.

exp_lt_O_exp: THEORY
BEGIN
  lt_O_exp_statement: bool =
    FORALL (n, m: nat):
      0 < n IMPLIES 0 < n ^ m
END exp_lt_O_exp
