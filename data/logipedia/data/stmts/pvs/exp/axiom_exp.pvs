% Statement-only formalization of Logipedia corpus artifact exp.axiom_exp
% (catalog title "exp.axiom_exp"): exponentiation at two natural arguments is
% related by the source equality to the natural-type filter of its body.
% This file contains no proof.

exp_axiom_exp: THEORY
BEGIN
  connectives_equal: [nat -> [nat -> bool]]

  exp_function, exp_body: [nat -> [nat -> nat]]

  filter_nat_type(body: [nat -> nat])(index: nat): nat =
    body(index)

  axiom_exp_statement: bool =
    FORALL (n, m: nat):
      connectives_equal(exp_function(n)(m))(
        filter_nat_type(exp_body(n))(m))
END exp_axiom_exp
