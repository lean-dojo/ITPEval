% Statement-only formalization of Logipedia corpus artifact exp.sym_eq_exp_body_S
% (catalog title "exp.sym_eq_exp_body_S"): for every natural base and exponent,
% the exponentiation value multiplied by the base is Leibniz-equal to the
% exponentiation body at the successor exponent. This file contains no proof.

exp_sym_eq_exp_body_S: THEORY
BEGIN
  exp_function, exp_body: [nat -> [nat -> nat]]

  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  sym_eq_exp_body_S_statement: bool =
    FORALL (n, m: nat):
      leibniz(exp_function(n)(m) * n)(exp_body(n)(m + 1))
END exp_sym_eq_exp_body_S
