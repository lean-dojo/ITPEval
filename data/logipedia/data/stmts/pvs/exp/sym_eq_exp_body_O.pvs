% Statement-only formalization of Logipedia corpus artifact exp.sym_eq_exp_body_O
% (catalog title "exp.sym_eq_exp_body_O"): for every natural base, successor
% zero (one) is Leibniz-equal to the exponentiation body at exponent zero.
% This file contains no proof.

exp_sym_eq_exp_body_O: THEORY
BEGIN
  exp_body: [nat -> [nat -> nat]]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  sym_eq_exp_body_O_statement: bool =
    FORALL (n: nat):
      leibniz(1)(exp_body(n)(0))
END exp_sym_eq_exp_body_O
