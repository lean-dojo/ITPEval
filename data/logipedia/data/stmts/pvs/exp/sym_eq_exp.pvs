% Statement-only formalization of Logipedia corpus artifact exp.sym_eq_exp
% (catalog title "exp.sym_eq_exp"): for every natural base and exponent, the
% natural-type filter of the exponentiation body is Leibniz-equal to the
% exponentiation value. This file contains no proof.

exp_sym_eq_exp: THEORY
BEGIN
  exp_function, exp_body: [nat -> [nat -> nat]]

  filter_nat_type(body: [nat -> nat])(index: nat): nat =
    body(index)

  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  sym_eq_exp_statement: bool =
    FORALL (n, m: nat):
      leibniz(filter_nat_type(exp_body(n))(m))(
        exp_function(n)(m))
END exp_sym_eq_exp
