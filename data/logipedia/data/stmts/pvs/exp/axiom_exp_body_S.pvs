% Statement-only formalization of Logipedia corpus artifact exp.axiom_exp_body_S
% (catalog title "exp.axiom_exp_body_S"): for every natural base and exponent,
% the exponentiation body at the successor exponent is related by the source
% equality to the exponentiation value multiplied by the base. This file
% contains no proof.

exp_axiom_exp_body_S: THEORY
BEGIN
  connectives_equal: [nat -> [nat -> bool]]

  exp_function, exp_body: [nat -> [nat -> nat]]
  axiom_exp_body_S_statement: bool =
    FORALL (n, m: nat):
      connectives_equal(exp_body(n)(m + 1))(exp_function(n)(m) * n)
END exp_axiom_exp_body_S
