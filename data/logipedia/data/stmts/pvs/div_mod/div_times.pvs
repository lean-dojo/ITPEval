% Statement-only formalization of Logipedia corpus artifact div_mod.div_times
% (catalog title "div_mod.div_times"): dividing a product of natural numbers by
% its positive second factor yields the first factor, using the source's total
% natural-number division operation. This file contains no proof.

div_times: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  div_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      0
    ELSE
      div_aux(p - 1, nat_subtract(n, m + 1), m) + 1
    ENDIF
  MEASURE p

  div(n, m: nat): nat =
    IF m = 0 THEN
      n + 1
    ELSE
      div_aux(n, n, m - 1)
    ENDIF

  div_times_statement: bool =
    FORALL (a, b: nat):
      0 < b IMPLIES div(a * b, b) = a

END div_times
