% Statement-only formalization of Logipedia corpus artifact
% div_mod.let_clause_1078 (catalog title "div_mod.let_clause_1078"):
% under two natural quotient-remainder specifications and ordered quotient
% hypotheses, the first division equation is preserved when its sum and
% product are written in commuted order. This file contains no proof.

let_clause_1078: THEORY
BEGIN

  div_mod_spec(a, b, q, r: nat): bool =
    r < b AND a = q * b + r

  let_clause_1078_statement: bool =
    FORALL (a, b, q, r, q1, r1: nat):
      div_mod_spec(a, b, q, r) IMPLIES
        (r < b IMPLIES
          (a = q * b + r IMPLIES
            (div_mod_spec(a, b, q1, r1) IMPLIES
              (r1 < b IMPLIES
                (a = q1 * b + r1 IMPLIES
                  (q <= q1 IMPLIES
                    (q < q1 IMPLIES
                      a = r + b * q)))))))

END let_clause_1078
