% Statement-only formalization of Logipedia corpus artifact
% div_mod.axiom_mod_aux_body_S (catalog title
% "div_mod.axiom_mod_aux_body_S"): at every successor natural index, the
% source connectives.equal relation relates the auxiliary remainder body to
% the curried function returning m when m <= n and otherwise the preceding
% auxiliary remainder value after truncated subtraction. This file contains
% no proof.

div_mod_axiom_mod_aux_body_S: THEORY
BEGIN
  connectives_equal: [[nat -> [nat -> nat]] -> [[nat -> [nat -> nat]] -> bool]]

  mod_aux, mod_aux_body: [nat -> [nat -> [nat -> nat]]]

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  axiom_mod_aux_body_S_statement: bool =
    FORALL (p: nat):
      connectives_equal(mod_aux_body(p + 1))
        (LAMBDA (m: nat):
          (LAMBDA (n: nat):
            IF m <= n THEN
              m
            ELSE
              mod_aux(p)(nat_subtract(m, n + 1))(n)
            ENDIF))

END div_mod_axiom_mod_aux_body_S
