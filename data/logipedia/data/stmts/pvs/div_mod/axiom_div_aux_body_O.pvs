% Statement-only formalization of Logipedia corpus artifact
% div_mod.axiom_div_aux_body_O (catalog title
% "div_mod.axiom_div_aux_body_O"): at natural-number index zero,
% connectives.equal relates the auxiliary division body to the constant-zero
% curried binary function on natural numbers. This file contains no proof.

div_mod_axiom_div_aux_body_O: THEORY
BEGIN
  connectives_equal: [[nat -> [nat -> nat]] -> [[nat -> [nat -> nat]] -> bool]]

  div_aux_body: [nat -> [nat -> [nat -> nat]]]
  axiom_div_aux_body_O_statement: bool =
    connectives_equal(div_aux_body(0))
      (LAMBDA (m: nat): (LAMBDA (n: nat): 0))
END div_mod_axiom_div_aux_body_O
