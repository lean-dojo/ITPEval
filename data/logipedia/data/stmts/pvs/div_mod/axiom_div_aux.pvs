% Statement-only formalization of Logipedia corpus artifact div_mod.axiom_div_aux
% (catalog title "div_mod.axiom_div_aux"): at every natural index, the auxiliary
% division function is related by the source equality to the natural-type filter
% of its body at that index. This file contains no proof.

div_mod_axiom_div_aux: THEORY
BEGIN
  connectives_equal: [[nat -> [nat -> nat]] -> [[nat -> [nat -> nat]] -> bool]]

  div_aux, div_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  axiom_div_aux_statement: bool =
    FORALL (p: nat):
      connectives_equal(div_aux(p))(filter_nat_type(div_aux_body)(p))
END div_mod_axiom_div_aux
