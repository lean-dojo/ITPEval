% Statement-only formalization of Logipedia corpus artifact div_mod.axiom_mod_aux
% (catalog title "div_mod.axiom_mod_aux"): at every natural index, the auxiliary
% remainder function is related by the source equality to the natural-type
% filter of its body at that index. This file contains no proof.

div_mod_axiom_mod_aux: THEORY
BEGIN
  connectives_equal: [[nat -> [nat -> nat]] -> [[nat -> [nat -> nat]] -> bool]]

  mod_aux, mod_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  axiom_mod_aux_statement: bool =
    FORALL (p: nat):
      connectives_equal(mod_aux(p))(filter_nat_type(mod_aux_body)(p))
END div_mod_axiom_mod_aux
