% Statement-only formalization of Logipedia corpus artifact
% div_mod.div_aux_mod_aux (catalog title "div_mod.div_aux_mod_aux"):
% for every recursion bound and natural inputs, the auxiliary quotient times
% the successor divisor plus the auxiliary remainder equals the input.
% This file contains no proof.

div_aux_mod_aux: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  div_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      0
    ELSE
      div_aux(p - 1, nat_subtract(n, m + 1), m) + 1
    ENDIF
  MEASURE p

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  div_aux_mod_aux_statement: bool =
    FORALL (p, n, m: nat):
      n = div_aux(p, n, m) * (m + 1) + mod_aux(p, n, m)

END div_aux_mod_aux
