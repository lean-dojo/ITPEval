% Statement-only formalization of Logipedia corpus artifact
% div_mod.let_clause_1062 (catalog title "div_mod.let_clause_1062"):
% natural quotient-remainder equations are preserved when the second
% product and sum are written in commuted order. This file contains no proof.

let_clause_1062: THEORY
BEGIN

  div_mod_spec(a, b, q, r: nat): bool =
    r < b AND a = q * b + r

  let_clause_1062_statement: bool =
    FORALL (a, b, q, r, q1, r1: nat):
      div_mod_spec(a, b, q, r) IMPLIES
        (r < b IMPLIES
          (a = q * b + r IMPLIES
            (div_mod_spec(a, b, q1, r1) IMPLIES
              (r1 < b IMPLIES
                (a = q1 * b + r1 IMPLIES
                  (NOT (q <= q1) IMPLIES
                    a = r1 + b * q1))))))

END let_clause_1062
