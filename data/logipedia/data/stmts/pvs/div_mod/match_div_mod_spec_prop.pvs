% Statement-only formalization of the Logipedia corpus artifact
% div_mod.match_div_mod_spec_prop (catalog title
% "div_mod.match_div_mod_spec_prop"): elimination of a natural quotient and
% bounded-remainder division specification into an arbitrary proposition.
% This file contains no proof.

match_div_mod_spec_prop: THEORY
BEGIN

  div_mod_spec(n, m, q, r: nat): bool =
    r < m AND n = q * m + r

  match_div_mod_spec_prop_statement: bool =
    FORALL (n, m, q, r: nat):
      FORALL (return_value: bool):
        (r < m IMPLIES
          (n = q * m + r IMPLIES return_value))
        IMPLIES
          (div_mod_spec(n, m, q, r) IMPLIES return_value)

END match_div_mod_spec_prop
