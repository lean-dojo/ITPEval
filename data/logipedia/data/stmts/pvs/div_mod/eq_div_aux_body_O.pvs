% Statement-only formalization of Logipedia corpus artifact
% div_mod.eq_div_aux_body_O (catalog title "div_mod.eq_div_aux_body_O"):
% Leibniz equality identifies the zero-indexed division auxiliary body with the
% constant-zero binary natural-number function. This file contains no proof.

div_mod_eq_div_aux_body_O: THEORY
BEGIN
  div_aux_body: [nat -> [nat -> [nat -> nat]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  eq_div_aux_body_O_statement: bool =
    leibniz(div_aux_body(0))
      (LAMBDA (m: nat): (LAMBDA (n: nat): 0))
END div_mod_eq_div_aux_body_O
