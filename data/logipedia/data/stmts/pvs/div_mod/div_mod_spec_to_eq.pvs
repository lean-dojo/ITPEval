% Statement-only formalization of Logipedia corpus artifact
% div_mod.div_mod_spec_to_eq (catalog title "div_mod.div_mod_spec_to_eq"):
% two bounded-remainder division specifications for the same natural dividend
% and divisor have equal quotients. This file contains no proof.

div_mod_spec_to_eq: THEORY
BEGIN

  div_mod_spec(a, b, q, r: nat): bool =
    r < b AND a = q * b + r

  div_mod_spec_to_eq_statement: bool =
    FORALL (a, b, q, r, q1, r1: nat):
      div_mod_spec(a, b, q, r) IMPLIES
        (div_mod_spec(a, b, q1, r1) IMPLIES q = q1)

END div_mod_spec_to_eq
