% Statement-only formalization of Logipedia corpus artifact div_mod.eq_div_aux
% (catalog title "div_mod.eq_div_aux"): at every natural index, the auxiliary
% division function is Leibniz-equal to the natural-type filter of its body at
% that index. This file contains no proof.

div_mod_eq_div_aux: THEORY
BEGIN
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  div_aux, div_aux_body: [nat -> binary_nat_function]

  filter_nat_type:
    [[nat -> binary_nat_function] -> [nat -> binary_nat_function]]

  eq_div_aux_statement: FORMULA
    FORALL (p: nat):
      div_aux(p) = filter_nat_type(div_aux_body)(p)
END div_mod_eq_div_aux
