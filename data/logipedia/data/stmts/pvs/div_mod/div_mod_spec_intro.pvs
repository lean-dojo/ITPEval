% Statement-only formalization of Logipedia corpus artifact
% div_mod.div_mod_spec_intro (catalog title
% "div_mod.div_mod_spec_intro"): natural quotient and remainder data satisfying
% the strict remainder bound and division equation satisfy the division
% specification. This file contains no proof.

div_mod_spec_intro: THEORY
BEGIN

  div_mod_spec(n, m, q, r: nat): bool =
    r < m AND n = q * m + r

  div_mod_spec_intro_statement: bool =
    FORALL (n, m, q, r: nat):
      r < m IMPLIES
        (n = q * m + r IMPLIES div_mod_spec(n, m, q, r))

END div_mod_spec_intro
