% Statement-only formalization of Logipedia corpus artifact div_mod.div_mod
% (catalog title "div_mod.div_mod"): every natural number equals its quotient
% times the divisor plus its remainder, for the source's total natural-number
% division and remainder operations. This file contains no proof.

div_mod: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  div_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      0
    ELSE
      div_aux(p - 1, nat_subtract(n, m + 1), m) + 1
    ENDIF
  MEASURE p

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  div(n, m: nat): nat =
    IF m = 0 THEN
      n + 1
    ELSE
      div_aux(n, n, m - 1)
    ENDIF

  mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  div_mod_statement: bool =
    FORALL (n, m: nat):
      n = div(n, m) * m + mod(n, m)

END div_mod
