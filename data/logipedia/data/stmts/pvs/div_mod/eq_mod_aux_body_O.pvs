% Statement-only formalization of Logipedia corpus artifact
% div_mod.eq_mod_aux_body_O (catalog title "div_mod.eq_mod_aux_body_O"):
% Leibniz equality identifies the zero-indexed remainder auxiliary body with
% the curried first-projection function on natural numbers. This file contains
% no proof.

div_mod_eq_mod_aux_body_O: THEORY
BEGIN
  mod_aux_body: [nat -> [nat -> [nat -> nat]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  eq_mod_aux_body_O_statement: bool =
    leibniz(mod_aux_body(0))
      (LAMBDA (m: nat): (LAMBDA (n: nat): m))
END div_mod_eq_mod_aux_body_O
