% Statement-only formalization of Logipedia corpus artifact div_mod.sym_eq_mod_aux
% (catalog title "div_mod.sym_eq_mod_aux"): at every natural index, the
% natural-type filter of the auxiliary remainder body is Leibniz-equal to the
% auxiliary remainder function at that index. This file contains no proof.

div_mod_sym_eq_mod_aux: THEORY
BEGIN
  mod_aux, mod_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  sym_eq_mod_aux_statement: bool =
    FORALL (p: nat):
      leibniz(filter_nat_type(mod_aux_body)(p))(mod_aux(p))
END div_mod_sym_eq_mod_aux
