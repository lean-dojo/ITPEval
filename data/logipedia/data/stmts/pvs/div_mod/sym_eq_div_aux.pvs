% Statement-only formalization of Logipedia corpus artifact div_mod.sym_eq_div_aux
% (catalog title "div_mod.sym_eq_div_aux"): at every natural index, the
% natural-type filter of the auxiliary division body is Leibniz-equal to the
% auxiliary division function at that index. This file contains no proof.

div_mod_sym_eq_div_aux: THEORY
BEGIN
  div_aux, div_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  sym_eq_div_aux_statement: bool =
    FORALL (p: nat):
      leibniz(filter_nat_type(div_aux_body)(p))(div_aux(p))
END div_mod_sym_eq_div_aux
