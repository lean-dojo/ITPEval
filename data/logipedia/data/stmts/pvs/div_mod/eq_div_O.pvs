% Statement-only formalization of Logipedia corpus artifact div_mod.eq_div_O
% (catalog title "div_mod.eq_div_O"): dividing a natural number by a strictly
% larger natural number yields zero, using the source's total natural-number
% division operation. This file contains no proof.

eq_div_O: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  div_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      0
    ELSE
      div_aux(p - 1, nat_subtract(n, m + 1), m) + 1
    ENDIF
  MEASURE p

  div(n, m: nat): nat =
    IF m = 0 THEN
      n + 1
    ELSE
      div_aux(n, n, m - 1)
    ENDIF

  eq_div_O_statement: bool =
    FORALL (n, m: nat):
      n < m IMPLIES div(n, m) = 0

END eq_div_O
