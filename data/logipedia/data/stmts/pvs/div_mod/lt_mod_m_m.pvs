% Statement-only formalization of Logipedia corpus artifact
% div_mod.lt_mod_m_m (catalog title "div_mod.lt_mod_m_m"): for all natural
% numbers n and m, a positive m makes the source remainder of n modulo m
% strictly less than m. This file contains no proof.

lt_mod_m_m: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  lt_mod_m_m_statement: bool =
    FORALL (n, m: nat):
      0 < m IMPLIES mod(n, m) < m

END lt_mod_m_m
