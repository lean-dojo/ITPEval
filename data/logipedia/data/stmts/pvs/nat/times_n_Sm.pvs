% Statement-only formalization of the Logipedia corpus artifact nat.times_n_Sm
% (catalog title "nat.times_n_Sm"): for all natural numbers n and m, adding n
% to n times m equals n times the successor of m. This file contains no proof.

nat_times_n_Sm: THEORY
BEGIN

  source_successor(n: nat): nat = n + 1

  times_n_Sm_statement: bool =
    FORALL (n, m: nat):
      n + n * m = n * source_successor(m)

END nat_times_n_Sm
