% Statement-only formalization of the Logipedia corpus artifact nat.injective_S
% (catalog title "nat.injective_S"): the successor function on natural numbers
% is injective. This file contains no proof.

nat_injective_S: THEORY
BEGIN

  injective_S_statement: bool =
    FORALL (x, y: nat):
      x + 1 = y + 1 IMPLIES x = y

END nat_injective_S
