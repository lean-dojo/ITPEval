% Statement-only formalization of the Logipedia corpus artifact nat.eq_minus_O
% (catalog title "nat.eq_minus_O"): if one natural number is at most another,
% their truncated natural subtraction is zero. This file contains no proof.

nat_eq_minus_O: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  eq_minus_O_statement: bool =
    FORALL (n, m: nat):
      n <= m IMPLIES source_minus(n, m) = 0

END nat_eq_minus_O
