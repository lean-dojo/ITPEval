% Statement-only formalization of the Logipedia corpus artifact
% nat.le_plus_to_le_r (catalog title "nat.le_plus_to_le_r"): cancelling the
% same natural-number addend on the right preserves less-than-or-equal.
% This file contains no proof.

nat_le_plus_to_le_r: THEORY
BEGIN

  le_plus_to_le_r_statement: bool =
    FORALL (a, n, m: nat):
      n + a <= m + a IMPLIES n <= m

END nat_le_plus_to_le_r
