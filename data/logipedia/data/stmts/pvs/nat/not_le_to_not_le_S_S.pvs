% Statement-only formalization of the Logipedia corpus artifact
% nat.not_le_to_not_le_S_S (catalog title "nat.not_le_to_not_le_S_S"):
% if two natural numbers are not ordered by <=, then their successors are
% also not ordered by <=. This file contains no proof.

nat_not_le_to_not_le_S_S: THEORY
BEGIN

  not_le_to_not_le_S_S_statement: bool =
    FORALL (n, m: nat):
      NOT (n <= m) IMPLIES NOT (n + 1 <= m + 1)

END nat_not_le_to_not_le_S_S
