% Statement-only formalization of the Logipedia corpus artifact
% nat.minus_le_minus_minus_comm (catalog title
% "nat.minus_le_minus_minus_comm"): under c <= b, subtracting the truncated
% difference b - c from a equals subtracting b from a + c, with all values
% natural numbers. This file contains no proof.

nat_minus_le_minus_minus_comm: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  minus_le_minus_minus_comm_statement: bool =
    FORALL (b, c, a: nat):
      c <= b IMPLIES
        truncated_subtraction(a, truncated_subtraction(b, c)) =
          truncated_subtraction(a + c, b)

END nat_minus_le_minus_minus_comm
