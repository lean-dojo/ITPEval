% Statement-only formalization of the Logipedia corpus artifact nat.sym_eq_plus
% (catalog title "nat.sym_eq_plus"): for every source natural input, the
% natural-type filter of plus_body is Leibniz-equal to addition at that input.
% This file contains no proof.

nat_sym_eq_plus: THEORY
BEGIN
  sttfa_nat: TYPE+

  plus, plus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  filter_nat_type:
    [[sttfa_nat -> [sttfa_nat -> sttfa_nat]] ->
    [sttfa_nat -> [sttfa_nat -> sttfa_nat]]]

  leibniz(
      x: [sttfa_nat -> sttfa_nat])(
      y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_plus_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(filter_nat_type(plus_body)(n))(plus(n))

END nat_sym_eq_plus
