% Statement-only formalization of the Logipedia corpus artifact
% nat.not_le_to_leb_false (catalog title "nat.not_le_to_leb_false"): for all
% natural numbers n and m, if n is not less than or equal to m, then the
% source Boolean less-or-equal test on n and m is false. This file contains no proof.

nat_not_le_to_leb_false: THEORY
BEGIN

  source_leb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      TRUE
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_leb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  not_le_to_leb_false_statement: bool =
    FORALL (n, m: nat):
      NOT (n <= m) IMPLIES source_leb(n, m) = FALSE

END nat_not_le_to_leb_false
