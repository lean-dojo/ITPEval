% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_lt_plus_l (catalog title "nat.monotonic_lt_plus_l"):
% adding a fixed natural number on the right is strictly monotone for the
% strict natural order. This file contains no proof.

nat_monotonic_lt_plus_l: THEORY
BEGIN

  monotonic_lt_plus_l_statement: bool =
    FORALL (n, x, y: nat):
      x < y IMPLIES x + n < y + n

END nat_monotonic_lt_plus_l
