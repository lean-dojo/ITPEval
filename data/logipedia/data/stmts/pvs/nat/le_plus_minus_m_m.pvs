% Statement-only formalization of the Logipedia corpus artifact
% nat.le_plus_minus_m_m (catalog title "nat.le_plus_minus_m_m"): every
% natural number is at most the sum of its truncated difference by another
% natural number and that other number. This file contains no proof.

nat_le_plus_minus_m_m: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  le_plus_minus_m_m_statement: bool =
    FORALL (n, m: nat):
      n <= truncated_subtraction(n, m) + m

END nat_le_plus_minus_m_m
