% Statement-only formalization of the Logipedia corpus artifact nat.le_plus_n_r
% (catalog title "nat.le_plus_n_r"): every natural number m is less than or
% equal to m + n for every natural number n. This file contains no proof.

nat_le_plus_n_r: THEORY
BEGIN

  le_plus_n_r_statement: bool =
    FORALL (n: nat):
      FORALL (m: nat):
        m <= m + n

END nat_le_plus_n_r
