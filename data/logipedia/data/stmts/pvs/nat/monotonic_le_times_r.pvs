% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_le_times_r (catalog title "nat.monotonic_le_times_r"):
% multiplication by a fixed natural number on the left is monotone for the
% natural-number order. This file contains no proof.

nat_monotonic_le_times_r: THEORY
BEGIN

  monotonic_le_times_r_statement: bool =
    FORALL (n, x, y: nat):
      x <= y IMPLIES n * x <= n * y

END nat_monotonic_le_times_r
