% Statement-only formalization of the Logipedia corpus artifact nat.plus_n_Sm
% (catalog title "nat.plus_n_Sm"): for all natural numbers n and m, the
% successor of their sum equals n plus the successor of m. This file contains
% no proof.

nat_plus_n_Sm: THEORY
BEGIN

  source_successor(n: nat): nat = n + 1

  plus_n_Sm_statement: bool =
    FORALL (n, m: nat):
      source_successor(n + m) = n + source_successor(m)

END nat_plus_n_Sm
