% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_leb_body_O (catalog title "nat.axiom_leb_body_O"): the source
% equality relates the less-than-or-equal body at natural zero to the
% constant-true function on natural numbers. This file contains no proof.

nat_axiom_leb_body_O: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_bool: TYPE+

  sttfa_O: sttfa_nat

  sttfa_true: sttfa_bool

  connectives_equal: [[sttfa_nat -> sttfa_bool] -> [[sttfa_nat -> sttfa_bool] -> bool]]

  leb_body: [sttfa_nat -> [sttfa_nat -> sttfa_bool]]

  axiom_leb_body_O_statement: bool =
    connectives_equal(leb_body(sttfa_O))
      (LAMBDA (m: sttfa_nat): sttfa_true)

END nat_axiom_leb_body_O
