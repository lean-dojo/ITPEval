% Statement-only formalization of the Logipedia corpus artifact nat.minus_n_n
% (catalog title "nat.minus_n_n"): subtracting any natural number from itself
% using truncated natural subtraction equals zero. This file contains no proof.

nat_minus_n_n: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  minus_n_n_statement: bool =
    FORALL (n: nat):
      0 = source_minus(n, n)

END nat_minus_n_n
