% Statement-only formalization of the Logipedia corpus artifact
% nat.le_to_le_to_eq (catalog title "nat.le_to_le_to_eq"): antisymmetry of
% natural-number less-than-or-equal, where mutual inequalities imply equality.
% This file contains no proof.

nat_le_to_le_to_eq: THEORY
BEGIN

  le_to_le_to_eq_statement: bool =
    FORALL (n, m: nat):
      n <= m IMPLIES (m <= n IMPLIES n = m)

END nat_le_to_le_to_eq
