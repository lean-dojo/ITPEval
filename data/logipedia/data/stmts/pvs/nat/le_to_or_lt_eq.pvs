% Statement-only formalization of the Logipedia corpus artifact
% nat.le_to_or_lt_eq (catalog title "nat.le_to_or_lt_eq"): for all natural
% numbers n and m, n <= m implies that n < m or n = m.
% This file contains no proof.

nat_le_to_or_lt_eq: THEORY
BEGIN

  le_to_or_lt_eq_statement: bool =
    FORALL (n, m: nat):
      n <= m IMPLIES ((n < m) OR (n = m))

END nat_le_to_or_lt_eq
