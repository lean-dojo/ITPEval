% Statement-only formalization of the Logipedia corpus artifact nat.le_S
% (catalog title "nat.le_S"): the source natural-number order is preserved
% when the upper bound is replaced by its successor. This file contains no
% proof.

nat_le_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  le_S_statement: bool =
    FORALL (n, m: sttfa_nat):
      sttfa_le(n)(m) IMPLIES sttfa_le(n)(sttfa_S(m))

END nat_le_S
