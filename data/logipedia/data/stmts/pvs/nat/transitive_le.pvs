% Statement-only formalization of the Logipedia corpus artifact
% nat.transitive_le (catalog title "nat.transitive_le"): transitivity of
% less-than-or-equal on natural numbers. This file contains no proof.

nat_transitive_le: THEORY
BEGIN

  transitive_le_statement: bool =
    FORALL (a, b, c: nat):
      a <= b IMPLIES (b <= c IMPLIES a <= c)

END nat_transitive_le
