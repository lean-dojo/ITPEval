% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_filter_nat_type_O (catalog title "nat.axiom_filter_nat_type_O"):
% for every result type and natural-indexed function, the source equality
% relates filtering that function at zero to its value at zero. This file
% contains no proof.

nat_axiom_filter_nat_type_O[
  return_type: TYPE+
]: THEORY
BEGIN
  connectives_equal: [return_type -> [return_type -> bool]]

  filter_nat_type: [[nat -> return_type] -> [nat -> return_type]]

  axiom_filter_nat_type_O_statement: bool =
    FORALL (return_function: [nat -> return_type]):
      connectives_equal(filter_nat_type(return_function)(0))
        (return_function(0))

END nat_axiom_filter_nat_type_O
