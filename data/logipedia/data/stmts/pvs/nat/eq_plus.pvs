% Statement-only formalization of the Logipedia corpus artifact nat.eq_plus
% (catalog title "nat.eq_plus"): for every source natural number, addition
% at that input is Leibniz-equal to the natural-type filter of plus_body.
% This file contains no proof.

nat_eq_plus: THEORY
BEGIN
  sttfa_nat: TYPE+

  plus, plus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  filter_nat_type:
    [[sttfa_nat -> [sttfa_nat -> sttfa_nat]] ->
    [sttfa_nat -> [sttfa_nat -> sttfa_nat]]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_plus_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(plus(n))(filter_nat_type(plus_body)(n))

END nat_eq_plus
