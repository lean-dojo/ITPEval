% Statement-only formalization of the Logipedia corpus artifact nat.axiom_minus
% (catalog title "nat.axiom_minus"): for every natural input, the source
% equality relates minus at that input to the natural-type filter of
% minus_body. This file contains no proof.

nat_axiom_minus: THEORY
BEGIN
  connectives_equal: [[nat -> nat] -> [[nat -> nat] -> bool]]

  minus, minus_body: [nat -> [nat -> nat]]

  filter_nat_type: [[nat -> [nat -> nat]] -> [nat -> [nat -> nat]]]

  axiom_minus_statement: bool =
    FORALL (n: nat):
      connectives_equal(minus(n))(filter_nat_type(minus_body)(n))

END nat_axiom_minus
