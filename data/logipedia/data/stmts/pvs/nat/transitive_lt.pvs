% Statement-only formalization of the Logipedia corpus artifact
% nat.transitive_lt (catalog title "nat.transitive_lt"): transitivity of
% strict less-than on natural numbers. This file contains no proof.

nat_transitive_lt: THEORY
BEGIN

  transitive_lt_statement: bool =
    FORALL (a, b, c: nat):
      a < b IMPLIES (b < c IMPLIES a < c)

END nat_transitive_lt
