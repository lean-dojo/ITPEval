% Statement-only formalization of the Logipedia corpus artifact
% nat.associative_plus (catalog title "nat.associative_plus"): natural-number
% addition is associative. This file contains no proof.

nat_associative_plus: THEORY
BEGIN

  associative_plus_statement: bool =
    FORALL (x, y, z: nat):
      (x + y) + z = x + (y + z)

END nat_associative_plus
