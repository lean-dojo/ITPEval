% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_leb_body_O (catalog title "nat.eq_leb_body_O"): leb_body at natural
% zero is Leibniz-equal to the constant-true function on natural numbers.
% This file contains no proof.

nat_eq_leb_body_O: THEORY
BEGIN
  leb_body: [nat -> [nat -> bool]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  eq_leb_body_O_statement: bool =
    leibniz(leb_body(0))(LAMBDA (m: nat): TRUE)
END nat_eq_leb_body_O
