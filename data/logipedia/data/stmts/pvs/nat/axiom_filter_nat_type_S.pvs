% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_filter_nat_type_S (catalog title "nat.axiom_filter_nat_type_S"):
% for every result type and natural-indexed function, the source equality
% relates filtering that function at a successor to its value at the same
% successor. This file contains no proof.

nat_axiom_filter_nat_type_S[
  return_type: TYPE+
]: THEORY
BEGIN
  connectives_equal: [return_type -> [return_type -> bool]]

  filter_nat_type: [[nat -> return_type] -> [nat -> return_type]]

  axiom_filter_nat_type_S_statement: bool =
    FORALL (return_function: [nat -> return_type]), (n: nat):
      connectives_equal(filter_nat_type(return_function)(n + 1))
        (return_function(n + 1))

END nat_axiom_filter_nat_type_S
