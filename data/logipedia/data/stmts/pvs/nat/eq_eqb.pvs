% Statement-only formalization of the Logipedia corpus artifact nat.eq_eqb
% (catalog title "nat.eq_eqb"): for every natural number, the Boolean equality
% test at that number is Leibniz-equal to the natural-type filter of eqb_body.
% This file contains no proof.

nat_eq_eqb: THEORY
BEGIN
  eqb, eqb_body: [nat -> [nat -> bool]]

  filter_nat_type: [[nat -> [nat -> bool]] -> [nat -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  eq_eqb_statement: bool =
    FORALL (n: nat):
      leibniz(eqb(n))(filter_nat_type(eqb_body)(n))
END nat_eq_eqb
