% Statement-only formalization of the Logipedia corpus artifact
% nat.distributive_times_plus (catalog title "nat.distributive_times_plus"):
% natural-number multiplication distributes on the left over addition.
% This file contains no proof.

nat_distributive_times_plus: THEORY
BEGIN

  distributive_times_plus_statement: bool =
    FORALL (x, y, z: nat):
      x * (y + z) = (x * y) + (x * z)

END nat_distributive_times_plus
