% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_match_nat_type_S (catalog title "nat.sym_eq_match_nat_type_S"):
% for every nonempty result type, pair of natural-number match branches, and
% source natural n, the successor branch at n is Leibniz-equal to matching
% the source successor S(n). This file contains no proof.

nat_sym_eq_match_nat_type_S[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  match_nat_type:
    [return_type ->
    [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]]

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  sym_eq_match_nat_type_S_statement: bool =
    FORALL (case_O: return_type),
           (case_S: [sttfa_nat -> return_type]),
           (n: sttfa_nat):
      leibniz(
        case_S(n),
        match_nat_type(case_O)(case_S)(sttfa_S(n)))

END nat_sym_eq_match_nat_type_S
