% Statement-only formalization of the Logipedia corpus artifact nat.axiom_times
% (catalog title "nat.axiom_times"): for every source natural input, the source
% equality relates multiplication at that input to the natural-type filter of
% its multiplication body, under the source equality-substitution and filter
% equations. This file contains no proof.

nat_axiom_times: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  sttfa_S: [sttfa_nat -> sttfa_nat]

  connectives_equal: [[sttfa_nat -> sttfa_nat] -> [[sttfa_nat -> sttfa_nat] -> bool]]

  times, times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  filter_nat_type:
    [[sttfa_nat -> [sttfa_nat -> sttfa_nat]] ->
    [sttfa_nat -> [sttfa_nat -> sttfa_nat]]]

  equal_leibniz_assumption: bool =
    FORALL (x, y: [sttfa_nat -> sttfa_nat]):
      connectives_equal(x)(y) IMPLIES
        (FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
          P(x) IMPLIES P(y))

  filter_nat_type_O_assumption: bool =
    FORALL
      (return_function:
        [sttfa_nat -> [sttfa_nat -> sttfa_nat]]):
      connectives_equal(filter_nat_type(return_function)(sttfa_O))(
        return_function(sttfa_O))

  filter_nat_type_S_assumption: bool =
    FORALL
      (return_function:
        [sttfa_nat -> [sttfa_nat -> sttfa_nat]]),
      (n: sttfa_nat):
      connectives_equal(filter_nat_type(return_function)(sttfa_S(n)))(
        return_function(sttfa_S(n)))

  axiom_times_statement: bool =
    (equal_leibniz_assumption
      AND filter_nat_type_O_assumption
      AND filter_nat_type_S_assumption)
    IMPLIES
      (FORALL (n: sttfa_nat):
        connectives_equal(times(n))(filter_nat_type(times_body)(n)))

END nat_axiom_times
