% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_leb_body_O (catalog title "nat.sym_eq_leb_body_O"): the
% constant-true Boolean function on natural numbers is Leibniz-equal to
% leb_body at natural zero. This file contains no proof.

nat_sym_eq_leb_body_O: THEORY
BEGIN
  leb_body: [nat -> [nat -> bool]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_leb_body_O_statement: bool =
    leibniz(LAMBDA (m: nat): TRUE)(leb_body(0))
END nat_sym_eq_leb_body_O
