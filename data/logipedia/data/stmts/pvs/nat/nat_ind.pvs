% Statement-only formalization of Logipedia corpus artifact nat.nat_ind
% (catalog title "nat.nat_ind"): induction for every Boolean predicate on the
% source natural type from its zero and successor objects. This file contains
% no proof.

nat_nat_ind: THEORY
BEGIN

  nat_ind_statement: bool =
    FORALL (Q: [nat -> bool]):
      Q(0) IMPLIES
        ((FORALL (x: nat):
            Q(x) IMPLIES Q(x + 1))
          IMPLIES
            (FORALL (x: nat): Q(x)))

END nat_nat_ind
