% Statement-only formalization of the Logipedia corpus artifact nat.le_S_S
% (catalog title "nat.le_S_S"): applying successor to two natural numbers
% preserves their less-than-or-equal ordering. This file contains no proof.

nat_le_S_S: THEORY
BEGIN

  le_S_S_statement: bool =
    FORALL (n, m: nat):
      n <= m IMPLIES n + 1 <= m + 1

END nat_le_S_S
