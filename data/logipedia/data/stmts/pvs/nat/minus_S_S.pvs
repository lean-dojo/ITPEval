% Statement-only formalization of the Logipedia corpus artifact nat.minus_S_S
% (catalog title "nat.minus_S_S"): subtracting two successor natural numbers
% gives the same result as subtracting their predecessors. This file contains
% no proof.

nat_minus_S_S: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  minus_S_S_statement: bool =
    FORALL (n, m: nat):
      source_minus(n + 1, m + 1) = source_minus(n, m)

END nat_minus_S_S
