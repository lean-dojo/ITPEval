% Statement-only formalization of the Logipedia corpus artifact nat.lt_O_S
% (catalog title "nat.lt_O_S"): zero is less than the successor of every
% natural number. This file contains no proof.

nat_lt_O_S: THEORY
BEGIN

  lt_O_S_statement: bool =
    FORALL (n: nat):
      0 < n + 1

END nat_lt_O_S
