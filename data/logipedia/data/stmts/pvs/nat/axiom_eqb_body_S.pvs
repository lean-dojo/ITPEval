% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_eqb_body_S (catalog title "nat.axiom_eqb_body_S"): for every
% natural n, connectives.equal relates eqb_body at the successor of n to the
% natural case function returning false at zero and eqb n q at successor q.
% This file contains no proof.

nat_axiom_eqb_body_S: THEORY
BEGIN
  connectives_equal: [[nat -> bool] -> [[nat -> bool] -> bool]]

  eqb, eqb_body: [nat -> [nat -> bool]]

  match_nat_type: [bool -> [[nat -> bool] -> [nat -> bool]]]

  axiom_eqb_body_S_statement: bool =
    FORALL (n: nat):
      connectives_equal(eqb_body(n + 1))
        (LAMBDA (m: nat):
          match_nat_type(FALSE)(LAMBDA (q: nat): eqb(n)(q))(m))

END nat_axiom_eqb_body_S
