% Statement-only formalization of the Logipedia corpus artifact
% nat.eqb_false_to_not_eq (catalog title "nat.eqb_false_to_not_eq"): a false
% Boolean equality test on two natural numbers implies that they are unequal.
% This file contains no proof.

nat_eqb_false_to_not_eq: THEORY
BEGIN

  source_eqb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      m = 0
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_eqb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  eqb_false_to_not_eq_statement: bool =
    FORALL (n, m: nat):
      source_eqb(n, m) = FALSE IMPLIES NOT (n = m)

END nat_eqb_false_to_not_eq
