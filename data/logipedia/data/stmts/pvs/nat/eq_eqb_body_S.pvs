% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_eqb_body_S (catalog title "nat.eq_eqb_body_S"): for every natural n,
% eqb_body at the successor of n is Leibniz-equal to the natural case function
% returning false at zero and eqb n q at successor q. This file contains no
% proof.

nat_eq_eqb_body_S: THEORY
BEGIN
  eqb, eqb_body: [nat -> [nat -> bool]]

  match_nat_type: [bool -> [[nat -> bool] -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  eq_eqb_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(eqb_body(n + 1))
        (LAMBDA (m: nat):
          match_nat_type(FALSE)(LAMBDA (q: nat): eqb(n)(q))(m))
END nat_eq_eqb_body_S
