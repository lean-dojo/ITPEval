% Statement-only formalization of the Logipedia corpus artifact
% nat.le_S_S_to_le (catalog title "nat.le_S_S_to_le"): cancelling successor
% from both sides of a natural-number less-than-or-equal relation preserves
% the underlying order. This file contains no proof.

nat_le_S_S_to_le: THEORY
BEGIN

  le_S_S_to_le_statement: bool =
    FORALL (n, m: nat):
      n + 1 <= m + 1 IMPLIES n <= m

END nat_le_S_S_to_le
