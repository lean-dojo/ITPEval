% Statement-only formalization of the Logipedia corpus artifact nat.times_O_n
% (catalog title "nat.times_O_n"): multiplying zero on the left by any natural
% number yields zero. This file contains no proof.

nat_times_O_n: THEORY
BEGIN

  times_O_n_statement: bool =
    FORALL (n: nat):
      0 = 0 * n

END nat_times_O_n
