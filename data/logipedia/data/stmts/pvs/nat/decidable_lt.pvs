% Statement-only formalization of the Logipedia corpus artifact nat.decidable_lt
% (catalog title "nat.decidable_lt"): strict order on natural numbers is
% decidable for every pair of natural numbers. This file contains no proof.

nat_decidable_lt: THEORY
BEGIN

  decidable_lt_statement: bool =
    FORALL (n, m: nat):
      (n < m) OR NOT (n < m)

END nat_decidable_lt
