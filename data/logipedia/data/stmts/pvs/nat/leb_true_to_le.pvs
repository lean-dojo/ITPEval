% Statement-only formalization of the Logipedia corpus artifact
% nat.leb_true_to_le (catalog title "nat.leb_true_to_le"): for all natural
% numbers n and m, if the source Boolean less-or-equal test on n and m is
% true, then n is less than or equal to m. This file contains no proof.

nat_leb_true_to_le: THEORY
BEGIN

  source_leb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      TRUE
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_leb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  leb_true_to_le_statement: bool =
    FORALL (n, m: nat):
      source_leb(n, m) = TRUE IMPLIES n <= m

END nat_leb_true_to_le
