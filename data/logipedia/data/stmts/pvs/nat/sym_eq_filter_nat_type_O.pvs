% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_filter_nat_type_O (catalog title "nat.sym_eq_filter_nat_type_O"):
% for every result type and function on the source natural type, the function's
% value at zero is Leibniz-equal to filtering that function at zero. This file
% contains no proof.

nat_sym_eq_filter_nat_type_O[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  filter_nat_type: [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]
  leibniz(x: return_type)(y: return_type): bool =
    FORALL (P: [return_type -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_filter_nat_type_O_statement: bool =
    FORALL (return_function: [sttfa_nat -> return_type]):
      leibniz(return_function(sttfa_O))
        (filter_nat_type(return_function)(sttfa_O))
END nat_sym_eq_filter_nat_type_O
