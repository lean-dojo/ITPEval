% Statement-only formalization of the Logipedia corpus artifact
% nat.lt_to_le_to_lt (catalog title "nat.lt_to_le_to_lt"): for natural
% numbers, strict order followed by non-strict order implies strict order.
% This file contains no proof.

nat_lt_to_le_to_lt: THEORY
BEGIN

  lt_to_le_to_lt_statement: bool =
    FORALL (n, m, p: nat):
      n < m IMPLIES (m <= p IMPLIES n < p)

END nat_lt_to_le_to_lt
