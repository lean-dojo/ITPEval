% Statement-only formalization of the Logipedia corpus artifact nat.decidable_le
% (catalog title "nat.decidable_le"): order on natural numbers is decidable for
% every pair of natural numbers. This file contains no proof.

nat_decidable_le: THEORY
BEGIN

  decidable_le_statement: bool =
    FORALL (n, m: nat):
      (n <= m) OR NOT (n <= m)

END nat_decidable_le
