% Statement-only formalization of the Logipedia corpus artifact nat.lt_S_to_lt
% (catalog title "nat.lt_S_to_lt"): if the successor of a natural number is
% strictly less than another natural number, then the original number is also
% strictly less than it. This file contains no proof.

nat_lt_S_to_lt: THEORY
BEGIN

  lt_S_to_lt_statement: bool =
    FORALL (n, m: nat):
      n + 1 < m IMPLIES n < m

END nat_lt_S_to_lt
