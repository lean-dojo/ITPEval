% Statement-only formalization of the Logipedia corpus artifact
% nat.not_eq_to_le_to_lt (catalog title "nat.not_eq_to_le_to_lt"): for all
% natural numbers n and m, n /= m and n <= m imply n < m. This file contains
% no proof.

nat_not_eq_to_le_to_lt: THEORY
BEGIN

  not_eq_to_le_to_lt_statement: bool =
    FORALL (n, m: nat):
      NOT (n = m) IMPLIES
        ((n <= m) IMPLIES (n < m))

END nat_not_eq_to_le_to_lt
