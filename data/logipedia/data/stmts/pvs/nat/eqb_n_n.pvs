% Statement-only formalization of the Logipedia corpus artifact nat.eqb_n_n
% (catalog title "nat.eqb_n_n"): the Boolean equality test of every natural
% number with itself is true. This file contains no proof.

nat_eqb_n_n: THEORY
BEGIN

  source_eqb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      m = 0
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_eqb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  eqb_n_n_statement: bool =
    FORALL (n: nat):
      source_eqb(n, n) = TRUE

END nat_eqb_n_n
