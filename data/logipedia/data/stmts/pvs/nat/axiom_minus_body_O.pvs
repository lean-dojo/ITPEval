% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_minus_body_O (catalog title "nat.axiom_minus_body_O"):
% the source equality relates minus_body at natural zero to the constant-zero
% function on natural numbers. This file contains no proof.

nat_axiom_minus_body_O: THEORY
BEGIN
  connectives_equal: [[nat -> nat] -> [[nat -> nat] -> bool]]

  minus_body: [nat -> [nat -> nat]]

  axiom_minus_body_O_statement: bool =
    connectives_equal(minus_body(0))
      (LAMBDA (m: nat): 0)

END nat_axiom_minus_body_O
