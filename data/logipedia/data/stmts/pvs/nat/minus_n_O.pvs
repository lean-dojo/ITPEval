% Statement-only formalization of the Logipedia corpus artifact nat.minus_n_O
% (catalog title "nat.minus_n_O"): subtracting zero from any natural number
% returns that natural number. This file contains no proof.

nat_minus_n_O: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  minus_n_O_statement: bool =
    FORALL (n: nat):
      n = source_minus(n, 0)

END nat_minus_n_O
