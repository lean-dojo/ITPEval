% Statement-only formalization of the Logipedia corpus artifact nat.sym_eq_leb
% (catalog title "nat.sym_eq_leb"): for every natural number, the natural-type
% filter of leb_body is Leibniz-equal to the Boolean less-than-or-equal test at
% that number. This file contains no proof.

nat_sym_eq_leb: THEORY
BEGIN
  leb, leb_body: [nat -> [nat -> bool]]

  filter_nat_type: [[nat -> [nat -> bool]] -> [nat -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_leb_statement: bool =
    FORALL (n: nat):
      leibniz(filter_nat_type(leb_body)(n))(leb(n))
END nat_sym_eq_leb
