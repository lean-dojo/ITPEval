% Statement-only formalization of the Logipedia corpus artifact nat.lt_to_le
% (catalog title "nat.lt_to_le"): every strict inequality between natural
% numbers implies the corresponding non-strict inequality. This file contains
% no proof.

nat_lt_to_le: THEORY
BEGIN

  lt_to_le_statement: bool =
    FORALL (x, y: nat):
      x < y IMPLIES x <= y

END nat_lt_to_le
