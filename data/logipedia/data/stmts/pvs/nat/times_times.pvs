% Statement-only formalization of the Logipedia corpus artifact nat.times_times
% (catalog title "nat.times_times"): for all natural numbers x, y, and z,
% x times (y times z) equals y times (x times z). This file contains no proof.

nat_times_times: THEORY
BEGIN

  times_times_statement: bool =
    FORALL (x, y, z: nat):
      x * (y * z) = y * (x * z)

END nat_times_times
