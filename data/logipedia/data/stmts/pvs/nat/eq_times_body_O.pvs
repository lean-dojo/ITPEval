% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_times_body_O (catalog title "nat.eq_times_body_O"): times_body at
% natural zero is Leibniz-equal to the constant-zero function on the source
% natural type. This file contains no proof.

nat_eq_times_body_O: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_times_body_O_statement: bool =
    leibniz(times_body(sttfa_O))
      (LAMBDA (m: sttfa_nat): sttfa_O)

END nat_eq_times_body_O
