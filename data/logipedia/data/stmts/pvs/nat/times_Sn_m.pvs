% Statement-only formalization of the Logipedia corpus artifact nat.times_Sn_m
% (catalog title "nat.times_Sn_m"): for all natural numbers n and m, adding m
% to n times m equals the successor of n multiplied by m. This file contains
% no proof.

nat_times_Sn_m: THEORY
BEGIN

  source_successor(n: nat): nat = n + 1

  times_Sn_m_statement: bool =
    FORALL (n, m: nat):
      m + n * m = source_successor(n) * m

END nat_times_Sn_m
