% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_eqb_body_O (catalog title "nat.axiom_eqb_body_O"):
% connectives.equal relates eqb_body at natural zero to the natural case
% function that returns true at zero and false at every successor.
% This file contains no proof.

nat_axiom_eqb_body_O: THEORY
BEGIN
  eqb_body: [nat -> [nat -> bool]]

  axiom_eqb_body_O_statement: FORMULA
    eqb_body(0) =
      (LAMBDA (m: nat):
        IF m = 0 THEN TRUE ELSE FALSE ENDIF)

END nat_axiom_eqb_body_O
