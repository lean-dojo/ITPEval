% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_le_minus_l (catalog title "nat.monotonic_le_minus_l"):
% truncated natural subtraction is monotone in its left argument.
% This file contains no proof.

nat_monotonic_le_minus_l: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  monotonic_le_minus_l_statement: bool =
    FORALL (p, q, n: nat):
      q <= p IMPLIES source_minus(q, n) <= source_minus(p, n)

END nat_monotonic_le_minus_l
