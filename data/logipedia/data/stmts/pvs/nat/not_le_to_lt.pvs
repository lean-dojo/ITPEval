% Statement-only formalization of the Logipedia corpus artifact
% nat.not_le_to_lt (catalog title "nat.not_le_to_lt"): for all natural
% numbers n and m, if n is not less than or equal to m, then m is less than n.
% This file contains no proof.

nat_not_le_to_lt: THEORY
BEGIN

  not_le_to_lt_statement: bool =
    FORALL (n, m: nat):
      NOT (n <= m) IMPLIES (m < n)

END nat_not_le_to_lt
