% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_lt_times_r (catalog title "nat.monotonic_lt_times_r"):
% multiplication by a fixed positive natural number on the left is strictly
% monotone for the natural-number order. This file contains no proof.

nat_monotonic_lt_times_r: THEORY
BEGIN

  monotonic_lt_times_r_statement: bool =
    FORALL (c, x, y: nat):
      0 < c IMPLIES
        (x < y IMPLIES c * x < c * y)

END nat_monotonic_lt_times_r
