% Statement-only formalization of the Logipedia corpus artifact
% nat.plus_minus_m_m (catalog title "nat.plus_minus_m_m"): when one natural
% number is at most another, adding it back after truncated subtraction
% returns the larger natural number. This file contains no proof.

nat_plus_minus_m_m: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  plus_minus_m_m_statement: bool =
    FORALL (n, m: nat):
      m <= n IMPLIES n = source_minus(n, m) + m

END nat_plus_minus_m_m
