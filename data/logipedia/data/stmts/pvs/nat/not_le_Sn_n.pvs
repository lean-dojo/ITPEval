% Statement-only formalization of the Logipedia corpus artifact
% nat.not_le_Sn_n (catalog title "nat.not_le_Sn_n"): the successor of a
% natural number is never less than or equal to that number. This file
% contains no proof.

nat_not_le_Sn_n: THEORY
BEGIN

  not_le_Sn_n_statement: bool =
    FORALL (n: nat):
      NOT (n + 1 <= n)

END nat_not_le_Sn_n
