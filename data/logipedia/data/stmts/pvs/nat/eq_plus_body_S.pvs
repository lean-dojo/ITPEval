% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_plus_body_S (catalog title "nat.eq_plus_body_S"): for every source
% natural n, plus_body at its successor is Leibniz-equal to the function
% mapping m to the successor of plus n m. This file contains no proof.

nat_eq_plus_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  plus, plus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_plus_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(plus_body(sttfa_S(n)))
        (LAMBDA (m: sttfa_nat): sttfa_S(plus(n)(m)))

END nat_eq_plus_body_S
