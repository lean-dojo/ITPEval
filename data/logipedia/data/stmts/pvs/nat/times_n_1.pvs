% Statement-only formalization of the Logipedia corpus artifact nat.times_n_1
% (catalog title "nat.times_n_1"): multiplying any natural number by one on
% the right leaves it unchanged. This file contains no proof.

nat_times_n_1: THEORY
BEGIN

  times_n_1_statement: bool =
    FORALL (n: nat):
      n = n * 1

END nat_times_n_1
