% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_leb_body_S (catalog title "nat.axiom_leb_body_S"): for every
% source natural n, connectives.equal relates leb_body at its successor to
% the natural case function returning false at zero and leb n q at successor
% q. This file contains no proof.

nat_axiom_leb_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_bool: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  sttfa_false: sttfa_bool

  connectives_equal: [[sttfa_nat -> sttfa_bool] -> [[sttfa_nat -> sttfa_bool] -> bool]]

  leb, leb_body: [sttfa_nat -> [sttfa_nat -> sttfa_bool]]

  match_nat_type:
    [sttfa_bool ->
    [[sttfa_nat -> sttfa_bool] -> [sttfa_nat -> sttfa_bool]]]

  axiom_leb_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      connectives_equal(leb_body(sttfa_S(n)))
        (LAMBDA (m: sttfa_nat):
          match_nat_type(sttfa_false)
            (LAMBDA (q: sttfa_nat): leb(n)(q))(m))

END nat_axiom_leb_body_S
