% Statement-only formalization of the Logipedia corpus artifact nat.eq_minus
% (catalog title "nat.eq_minus"): for every natural number, minus at that
% input is Leibniz-equal to the natural-type filter of minus_body.
% This file contains no proof.

nat_eq_minus: THEORY
BEGIN
  minus, minus_body: [nat -> [nat -> nat]]

  filter_nat_type: [[nat -> [nat -> nat]] -> [nat -> [nat -> nat]]]
  leibniz(x: [nat -> nat])(y: [nat -> nat]): bool =
    FORALL (P: [[nat -> nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_minus_statement: bool =
    FORALL (n: nat):
      leibniz(minus(n))(filter_nat_type(minus_body)(n))
END nat_eq_minus
