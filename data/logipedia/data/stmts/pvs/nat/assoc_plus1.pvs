% Statement-only formalization of the Logipedia corpus artifact nat.assoc_plus1
% (catalog title "nat.assoc_plus1"): for all natural numbers, c + (b + a)
% equals (b + c) + a. This file contains no proof.

nat_assoc_plus1: THEORY
BEGIN

  assoc_plus1_statement: bool =
    FORALL (a, b, c: nat):
      c + (b + a) = (b + c) + a

END nat_assoc_plus1
