% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_minus_body_S (catalog title "nat.sym_eq_minus_body_S"): for every
% source natural n, the natural case function with successor n at zero and
% minus n q at successor q is Leibniz-equal to minus_body at the successor of
% n. This file contains no proof.

nat_sym_eq_minus_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  minus, minus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  match_nat_type:
    [sttfa_nat ->
    [[sttfa_nat -> sttfa_nat] -> [sttfa_nat -> sttfa_nat]]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_minus_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(
        LAMBDA (m: sttfa_nat):
          match_nat_type(sttfa_S(n))
            (LAMBDA (q: sttfa_nat): minus(n)(q))(m))
        (minus_body(sttfa_S(n)))

END nat_sym_eq_minus_body_S
