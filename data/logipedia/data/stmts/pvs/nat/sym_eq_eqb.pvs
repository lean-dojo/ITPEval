% Statement-only formalization of the Logipedia corpus artifact nat.sym_eq_eqb
% (catalog title "nat.sym_eq_eqb"): for every natural number, the natural-type
% filter of eqb_body is Leibniz-equal to the Boolean equality test at that
% number. This file contains no proof.

nat_sym_eq_eqb: THEORY
BEGIN
  eqb, eqb_body: [nat -> [nat -> bool]]

  filter_nat_type: [[nat -> [nat -> bool]] -> [nat -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_eqb_statement: bool =
    FORALL (n: nat):
      leibniz(filter_nat_type(eqb_body)(n))(eqb(n))
END nat_sym_eq_eqb
