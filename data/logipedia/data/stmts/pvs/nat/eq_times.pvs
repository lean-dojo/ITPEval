% Statement-only formalization of the Logipedia corpus artifact nat.eq_times
% (catalog title "nat.eq_times"): for every source natural input,
% multiplication at that input is Leibniz-equal to the natural-type filter
% of its multiplication body. This file contains no proof.

nat_eq_times: THEORY
BEGIN
  sttfa_nat: TYPE+

  times, times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  filter_nat_type:
    [[sttfa_nat -> [sttfa_nat -> sttfa_nat]] ->
    [sttfa_nat -> [sttfa_nat -> sttfa_nat]]]

  leibniz(
      x: [sttfa_nat -> sttfa_nat])(
      y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_times_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(times(n))(filter_nat_type(times_body)(n))

END nat_eq_times
