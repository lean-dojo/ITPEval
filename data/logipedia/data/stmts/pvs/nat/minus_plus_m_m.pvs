% Statement-only formalization of the Logipedia corpus artifact
% nat.minus_plus_m_m (catalog title "nat.minus_plus_m_m"): adding a natural
% number and then subtracting it with truncated natural subtraction returns
% the original natural number. This file contains no proof.

nat_minus_plus_m_m: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  minus_plus_m_m_statement: bool =
    FORALL (n, m: nat):
      n = source_minus(n + m, m)

END nat_minus_plus_m_m
