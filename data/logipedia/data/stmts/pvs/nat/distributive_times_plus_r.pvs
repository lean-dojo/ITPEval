% Statement-only formalization of the Logipedia corpus artifact
% nat.distributive_times_plus_r (catalog title "nat.distributive_times_plus_r"):
% natural-number multiplication distributes on the right over addition.
% This file contains no proof.

nat_distributive_times_plus_r: THEORY
BEGIN

  distributive_times_plus_r_statement: bool =
    FORALL (a, b, c: nat):
      (b + c) * a = (b * a) + (c * a)

END nat_distributive_times_plus_r
