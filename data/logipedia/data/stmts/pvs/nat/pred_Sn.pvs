% Statement-only formalization of the Logipedia corpus artifact nat.pred_Sn
% (catalog title "nat.pred_Sn"): every natural number is equal to the
% predecessor of its successor. This file contains no proof.

nat_pred_Sn: THEORY
BEGIN

  source_pred(value: nat): nat =
    IF value = 0 THEN 0 ELSE value - 1 ENDIF

  pred_Sn_statement: bool =
    FORALL (n: nat):
      n = source_pred(n + 1)

END nat_pred_Sn
