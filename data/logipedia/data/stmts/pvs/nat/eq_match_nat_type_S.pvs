% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_match_nat_type_S (catalog title "nat.eq_match_nat_type_S"):
% for every result type, pair of natural-number match branches, and natural
% number n, matching at S(n) is Leibniz-equal to the successor branch at n.
% This file contains no proof.

nat_eq_match_nat_type_S[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  match_nat_type:
    [return_type ->
    [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]]

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  eq_match_nat_type_S_statement: bool =
    FORALL (case_O: return_type),
           (case_S: [sttfa_nat -> return_type]),
           (n: sttfa_nat):
      leibniz(
        match_nat_type(case_O)(case_S)(sttfa_S(n)),
        case_S(n))

END nat_eq_match_nat_type_S
