% Statement-only formalization of the Logipedia corpus artifact nat.nat_elim2
% (catalog title "nat.nat_elim2"): two-dimensional induction on natural
% numbers using the zero row, positive zero column, and simultaneous successor.
% This file contains no proof.

nat_nat_elim2: THEORY
BEGIN

  nat_elim2_statement: bool =
    FORALL (R: [nat -> [nat -> bool]]):
      (FORALL (n: nat): R(0)(n)) IMPLIES
        (FORALL (n: nat): R(n + 1)(0)) IMPLIES
          (FORALL (n, m: nat):
            R(n)(m) IMPLIES R(n + 1)(m + 1)) IMPLIES
              (FORALL (n, m: nat): R(n)(m))

END nat_nat_elim2
