% Statement-only formalization of the Logipedia corpus artifact
% nat.commutative_plus (catalog title "nat.commutative_plus"): natural-number
% addition is commutative. This file contains no proof.

nat_commutative_plus: THEORY
BEGIN

  commutative_plus_statement: bool =
    FORALL (x, y: nat):
      x + y = y + x

END nat_commutative_plus
