% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_match_nat_type_O (catalog title "nat.sym_eq_match_nat_type_O"):
% for every nonempty result type and pair of natural-number match branches,
% the supplied zero branch is Leibniz-equal to matching the source natural
% zero constructor. This file contains no proof.

nat_sym_eq_match_nat_type_O[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  match_nat_type:
    [return_type ->
    [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]]

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  sym_eq_match_nat_type_O_statement: bool =
    FORALL (case_O: return_type):
      FORALL (case_S: [sttfa_nat -> return_type]):
        leibniz(case_O, match_nat_type(case_O)(case_S)(sttfa_O))

END nat_sym_eq_match_nat_type_O
