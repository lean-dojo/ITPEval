% Statement-only formalization of the Logipedia corpus artifact nat.le_plus_b
% (catalog title "nat.le_plus_b"): if n + b is at most m for natural numbers,
% then n is at most m. This file contains no proof.

nat_le_plus_b: THEORY
BEGIN

  le_plus_b_statement: bool =
    FORALL (b, n, m: nat):
      n + b <= m IMPLIES n <= m

END nat_le_plus_b
