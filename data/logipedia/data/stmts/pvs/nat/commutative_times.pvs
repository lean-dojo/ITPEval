% Statement-only formalization of the Logipedia corpus artifact
% nat.commutative_times (catalog title "nat.commutative_times"):
% natural-number multiplication is commutative. This file contains no proof.

nat_commutative_times: THEORY
BEGIN

  commutative_times_statement: bool =
    FORALL (x, y: nat):
      x * y = y * x

END nat_commutative_times
