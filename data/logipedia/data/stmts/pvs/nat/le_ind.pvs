% Statement-only formalization of Logipedia corpus artifact nat.le_ind
% (catalog title "nat.le_ind"): induction for predicates over the module's
% abstract natural numbers from an arbitrary lower bound in its source order.
% This file contains no proof.

nat_le_ind: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  le_ind_statement: bool =
    FORALL (n: sttfa_nat):
      FORALL (Q: [sttfa_nat -> bool]):
        Q(n) IMPLIES
          ((FORALL (m: sttfa_nat):
              sttfa_le(n)(m) IMPLIES
                (Q(m) IMPLIES Q(sttfa_S(m))))
           IMPLIES
             (FORALL (m: sttfa_nat):
                sttfa_le(n)(m) IMPLIES Q(m)))

END nat_le_ind
