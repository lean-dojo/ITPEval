% Statement-only formalization of the Logipedia corpus artifact nat.minus_plus
% (catalog title "nat.minus_plus"): two successive truncated natural
% subtractions equal subtraction by the sum. This file contains no proof.

nat_minus_plus: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  minus_plus_statement: bool =
    FORALL (n, m, p: nat):
      truncated_subtraction(truncated_subtraction(n, m), p) =
        truncated_subtraction(n, m + p)

END nat_minus_plus
