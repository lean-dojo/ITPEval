% Statement-only formalization of the Logipedia corpus artifact nat.minus_O_n
% (catalog title "nat.minus_O_n"): zero minus any natural number, using
% truncated natural subtraction, equals zero. This file contains no proof.

nat_minus_O_n: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  minus_O_n_statement: bool =
    FORALL (n: nat):
      0 = source_minus(0, n)

END nat_minus_O_n
