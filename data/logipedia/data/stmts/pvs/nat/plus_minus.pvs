% Statement-only formalization of the Logipedia corpus artifact nat.plus_minus
% (catalog title "nat.plus_minus"): if m is at most n, adding p to the
% truncated natural difference n - m equals subtracting m from n + p.
% This file contains no proof.

nat_plus_minus: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  plus_minus_statement: bool =
    FORALL (m, n, p: nat):
      m <= n IMPLIES
        truncated_subtraction(n, m) + p =
          truncated_subtraction(n + p, m)

END nat_plus_minus
