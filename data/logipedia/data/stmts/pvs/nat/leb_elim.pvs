% Statement-only formalization of the Logipedia corpus artifact nat.leb_elim
% (catalog title "nat.leb_elim"): elimination for the Boolean natural-number
% less-than-or-equal test by its true and false order cases. This file contains no proof.

nat_leb_elim: THEORY
BEGIN

  source_leb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      TRUE
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_leb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  leb_elim_statement: bool =
    FORALL (n: nat):
      FORALL (m: nat):
        FORALL (P: [bool -> bool]):
          ((n <= m) IMPLIES P(TRUE)) IMPLIES
            ((NOT (n <= m)) IMPLIES P(FALSE)) IMPLIES
              P(source_leb(n, m))

END nat_leb_elim
