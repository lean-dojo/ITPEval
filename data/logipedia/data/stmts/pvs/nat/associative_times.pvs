% Statement-only formalization of the Logipedia corpus artifact
% nat.associative_times (catalog title "nat.associative_times"):
% natural-number multiplication is associative. This file contains no proof.

nat_associative_times: THEORY
BEGIN

  associative_times_statement: bool =
    FORALL (x, y, z: nat):
      (x * y) * z = x * (y * z)

END nat_associative_times
