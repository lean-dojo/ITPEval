% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_leb_body_S (catalog title "nat.sym_eq_leb_body_S"): for every
% natural n, the natural case function returning false at zero and leb n q
% at successor q is Leibniz-equal to leb_body at the successor of n. This
% file contains no proof.

nat_sym_eq_leb_body_S: THEORY
BEGIN
  leb, leb_body: [nat -> [nat -> bool]]

  match_nat_type: [bool -> [[nat -> bool] -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_leb_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(
        (LAMBDA (m: nat):
          match_nat_type(FALSE)(LAMBDA (q: nat): leb(n)(q))(m)))
        (leb_body(n + 1))
END nat_sym_eq_leb_body_S
