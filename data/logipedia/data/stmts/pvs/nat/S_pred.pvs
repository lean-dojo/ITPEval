% Statement-only formalization of the Logipedia corpus artifact nat.S_pred
% (catalog title "nat.S_pred"): every positive natural number is the successor
% of its predecessor. This file contains no proof.

nat_S_pred: THEORY
BEGIN

  source_pred(value: nat): nat =
    IF value = 0 THEN 0 ELSE value - 1 ENDIF

  S_pred_statement: bool =
    FORALL (n: nat):
      0 < n IMPLIES
        source_pred(n) + 1 = n

END nat_S_pred
