% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_filter_nat_type_S (catalog title "nat.sym_eq_filter_nat_type_S"):
% for every result type, function on the source natural type, and natural n,
% the function's value at S(n) is Leibniz-equal to filtering that function at
% S(n). This file contains no proof.

nat_sym_eq_filter_nat_type_S[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  filter_nat_type: [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]
  leibniz(x: return_type)(y: return_type): bool =
    FORALL (P: [return_type -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_filter_nat_type_S_statement: bool =
    FORALL (return_function: [sttfa_nat -> return_type]),
           (n: sttfa_nat):
      leibniz(return_function(sttfa_S(n)))
        (filter_nat_type(return_function)(sttfa_S(n)))
END nat_sym_eq_filter_nat_type_S
