% Statement-only formalization of the Logipedia corpus artifact
% nat.plus_to_minus (catalog title "nat.plus_to_minus"): if a natural number
% equals m plus p, subtracting m with truncated natural subtraction yields p.
% This file contains no proof.

nat_plus_to_minus: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  plus_to_minus_statement: bool =
    FORALL (n, m, p: nat):
      n = m + p IMPLIES source_minus(n, m) = p

END nat_plus_to_minus
