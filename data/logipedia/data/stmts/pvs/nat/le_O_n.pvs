% Statement-only formalization of the Logipedia corpus artifact nat.le_O_n
% (catalog title "nat.le_O_n"): zero is below every element of the source
% natural-number type under its less-than-or-equal relation. This file contains
% no proof.

nat_le_O_n: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  le_O_n_statement: bool =
    FORALL (n: sttfa_nat):
      sttfa_le(sttfa_O)(n)

END nat_le_O_n
