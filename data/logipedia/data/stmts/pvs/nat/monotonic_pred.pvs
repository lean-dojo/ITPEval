% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_pred (catalog title "nat.monotonic_pred"): predecessor is
% monotone with respect to the natural-number order. This file contains no proof.

nat_monotonic_pred: THEORY
BEGIN

  source_pred(value: nat): nat =
    IF value = 0 THEN 0 ELSE value - 1 ENDIF

  monotonic_pred_statement: bool =
    FORALL (x, y: nat):
      x <= y IMPLIES source_pred(x) <= source_pred(y)

END nat_monotonic_pred
