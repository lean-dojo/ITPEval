% Statement-only formalization of the Logipedia corpus artifact nat.le_n
% (catalog title "nat.le_n"): every element of the source natural-number type
% is related to itself by the source less-than-or-equal relation. This file
% contains no proof.

nat_le_n: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  le_n_statement: bool =
    FORALL (n: sttfa_nat):
      sttfa_le(n)(n)

END nat_le_n
