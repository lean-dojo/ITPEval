% Statement-only formalization of the Logipedia corpus artifact
% nat.injective_plus_r (catalog title "nat.injective_plus_r"): for every
% natural number n, addition of n on the left is injective on natural numbers.
% This file contains no proof.

nat_injective_plus_r: THEORY
BEGIN

  injective_plus_r_statement: bool =
    FORALL (n, x, y: nat):
      n + x = n + y IMPLIES x = y

END nat_injective_plus_r
