% Statement-only formalization of the Logipedia corpus artifact nat.lt_times
% (catalog title "nat.lt_times"): strict natural-number inequalities in both
% factors imply a strict inequality between their products. This file contains
% no proof.

nat_lt_times: THEORY
BEGIN

  lt_times_statement: bool =
    FORALL (n, m, p, q: nat):
      n < m IMPLIES
        p < q IMPLIES
          n * p < m * q

END nat_lt_times
