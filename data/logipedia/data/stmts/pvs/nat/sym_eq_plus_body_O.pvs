% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_plus_body_O (catalog title "nat.sym_eq_plus_body_O"): the
% identity function on the source natural type is Leibniz-equal to plus_body
% at natural zero. This file contains no proof.

nat_sym_eq_plus_body_O: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  plus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_plus_body_O_statement: bool =
    leibniz(LAMBDA (m: sttfa_nat): m)
      (plus_body(sttfa_O))

END nat_sym_eq_plus_body_O
