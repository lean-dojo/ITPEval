% Statement-only formalization of the Logipedia corpus artifact nat.le_times
% (catalog title "nat.le_times"): natural-number multiplication preserves
% less-than-or-equal relations in both arguments. This file contains no proof.

nat_le_times: THEORY
BEGIN

  le_times_statement: bool =
    FORALL (n1, n2, m1, m2: nat):
      n1 <= n2 IMPLIES
        m1 <= m2 IMPLIES
          n1 * m1 <= n2 * m2

END nat_le_times
