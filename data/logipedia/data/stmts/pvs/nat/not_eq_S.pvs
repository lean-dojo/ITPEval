% Statement-only formalization of the Logipedia corpus artifact
% nat.not_eq_S (catalog title "nat.not_eq_S"): unequal natural numbers have
% unequal successors. This file contains no proof.

nat_not_eq_S: THEORY
BEGIN

  not_eq_S_statement: bool =
    FORALL (n, m: nat):
      NOT (n = m) IMPLIES NOT (n + 1 = m + 1)

END nat_not_eq_S
