% Statement-only formalization of the Logipedia corpus artifact nat.le_plus_n
% (catalog title "nat.le_plus_n"): every natural number m is less than or
% equal to n + m for every natural number n. This file contains no proof.

nat_le_plus_n: THEORY
BEGIN

  le_plus_n_statement: bool =
    FORALL (n, m: nat):
      m <= n + m

END nat_le_plus_n
