% Statement-only formalization of the Logipedia corpus artifact nat.eqb_elim
% (catalog title "nat.eqb_elim"): elimination for the Boolean equality test on
% natural numbers by its equal and unequal cases. This file contains no proof.

nat_eqb_elim: THEORY
BEGIN

  source_eqb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      m = 0
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_eqb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  eqb_elim_statement: bool =
    FORALL (n, m: nat), (P: [bool -> bool]):
      (n = m IMPLIES P(TRUE)) IMPLIES
        (NOT (n = m) IMPLIES P(FALSE)) IMPLIES
          P(source_eqb(n, m))

END nat_eqb_elim
