% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_times_body_O (catalog title "nat.axiom_times_body_O"): the source
% equality relates times_body at natural zero to the constant-zero function
% on the source natural type. This file contains no proof.

nat_axiom_times_body_O: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  connectives_equal: [[sttfa_nat -> sttfa_nat] -> [[sttfa_nat -> sttfa_nat] -> bool]]

  times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  axiom_times_body_O_statement: bool =
    connectives_equal(times_body(sttfa_O))
      (LAMBDA (m: sttfa_nat): sttfa_O)

END nat_axiom_times_body_O
