% Statement-only formalization of the Logipedia corpus artifact nat.axiom_leb
% (catalog title "nat.axiom_leb"): for every natural input, the source
% equality relates leb at that input to the natural-type filter of leb_body.
% This file contains no proof.

nat_axiom_leb: THEORY
BEGIN
  connectives_equal: [[nat -> bool] -> [[nat -> bool] -> bool]]

  leb, leb_body: [nat -> [nat -> bool]]

  filter_nat_type: [[nat -> [nat -> bool]] -> [nat -> [nat -> bool]]]

  axiom_leb_statement: bool =
    FORALL (n: nat):
      connectives_equal(leb(n))(filter_nat_type(leb_body)(n))

END nat_axiom_leb
