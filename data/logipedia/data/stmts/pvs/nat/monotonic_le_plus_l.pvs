% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_le_plus_l (catalog title "nat.monotonic_le_plus_l"):
% adding a fixed natural number on the right is monotone for natural order.
% This file contains no proof.

nat_monotonic_le_plus_l: THEORY
BEGIN

  monotonic_le_plus_l_statement: bool =
    FORALL (m, x, y: nat):
      x <= y IMPLIES x + m <= y + m

END nat_monotonic_le_plus_l
