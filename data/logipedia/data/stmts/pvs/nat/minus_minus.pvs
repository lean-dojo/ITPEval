% Statement-only formalization of the Logipedia corpus artifact
% nat.minus_minus (catalog title "nat.minus_minus"): for natural numbers
% p <= m <= n, adding p to n minus m equals n minus (m minus p).
% This file contains no proof.

nat_minus_minus: THEORY
BEGIN

  minus_minus_statement: bool =
    FORALL (n, m, p: nat):
      p <= m IMPLIES
        (m <= n IMPLIES
          p + (n - m) = n - (m - p))

END nat_minus_minus
