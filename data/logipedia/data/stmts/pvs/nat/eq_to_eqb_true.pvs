% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_to_eqb_true (catalog title "nat.eq_to_eqb_true"): equality of two
% natural numbers implies that their Boolean equality test is true. This file
% contains no proof.

nat_eq_to_eqb_true: THEORY
BEGIN

  source_eqb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      m = 0
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_eqb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  eq_to_eqb_true_statement: bool =
    FORALL (n, m: nat):
      n = m IMPLIES source_eqb(n, m) = TRUE

END nat_eq_to_eqb_true
