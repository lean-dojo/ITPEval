% Statement-only formalization of the Logipedia corpus artifact
% nat.le_plus_to_le (catalog title "nat.le_plus_to_le"): cancelling a common
% left addend from a natural-number less-than-or-equal relation preserves the
% underlying order. This file contains no proof.

nat_le_plus_to_le: THEORY
BEGIN

  le_plus_to_le_statement: bool =
    FORALL (a, n, m: nat):
      a + n <= a + m IMPLIES n <= m

END nat_le_plus_to_le
