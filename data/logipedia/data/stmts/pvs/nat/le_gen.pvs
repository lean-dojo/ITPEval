% Statement-only formalization of the Logipedia corpus artifact nat.le_gen
% (catalog title "nat.le_gen"): if a predicate holds for every natural number
% less than or equal to a given natural number, then it holds at that number.
% This file contains no proof.

nat_le_gen: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  le_gen_statement: bool =
    FORALL (P: [sttfa_nat -> bool], n: sttfa_nat):
      (FORALL (i: sttfa_nat): sttfa_le(i)(n) IMPLIES P(i))
        IMPLIES P(n)

END nat_le_gen
