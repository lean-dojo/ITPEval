% Statement-only formalization of the Logipedia corpus artifact
% nat.le_to_leb_true (catalog title "nat.le_to_leb_true"): for all natural
% numbers n and m, n less than or equal to m implies that the source Boolean
% less-or-equal test on n and m is true. This file contains no proof.

nat_le_to_leb_true: THEORY
BEGIN

  source_leb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      TRUE
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_leb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  le_to_leb_true_statement: bool =
    FORALL (n, m: nat):
      n <= m IMPLIES source_leb(n, m) = TRUE

END nat_le_to_leb_true
