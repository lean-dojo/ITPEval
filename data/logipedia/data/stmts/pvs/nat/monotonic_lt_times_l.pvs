% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_lt_times_l (catalog title "nat.monotonic_lt_times_l"):
% multiplication by a fixed positive natural number on the right is strictly
% monotone for the natural-number order. This file contains no proof.

nat_monotonic_lt_times_l: THEORY
BEGIN

  monotonic_lt_times_l_statement: bool =
    FORALL (c, x, y: nat):
      0 < c IMPLIES
        (x < y IMPLIES x * c < y * c)

END nat_monotonic_lt_times_l
