% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_eqb_body_S (catalog title "nat.sym_eq_eqb_body_S"): for every
% natural n, the natural case function returning false at zero and eqb n q
% at successor q is Leibniz-equal to eqb_body at the successor of n. This
% file contains no proof.

nat_sym_eq_eqb_body_S: THEORY
BEGIN
  eqb, eqb_body: [nat -> [nat -> bool]]

  match_nat_type: [bool -> [[nat -> bool] -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_eqb_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(
        (LAMBDA (m: nat):
          match_nat_type(FALSE)(LAMBDA (q: nat): eqb(n)(q))(m)))
        (eqb_body(n + 1))
END nat_sym_eq_eqb_body_S
