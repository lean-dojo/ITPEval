% Statement-only formalization of the Logipedia corpus artifact
% nat.lt_to_le_to_lt_times (catalog title "nat.lt_to_le_to_lt_times"):
% increasing the first natural factor strictly, while increasing the second
% weakly to a positive value, strictly increases the product. This file
% contains no proof.

nat_lt_to_le_to_lt_times: THEORY
BEGIN
  lt_to_le_to_lt_times_statement: bool =
    FORALL (n, m, p, q: nat):
      n < m IMPLIES
        (p <= q IMPLIES
          (0 < q IMPLIES
            n * p < m * q))
END nat_lt_to_le_to_lt_times
