% Statement-only formalization of the Logipedia corpus artifact nat.match_le_prop
% (catalog title "nat.match_le_prop"): a predicate holding at a natural number
% and at every successor holds at every source natural above that number in
% the source less-than-or-equal relation. This file contains no proof.

nat_match_le_prop: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  match_le_prop_statement: bool =
    FORALL (n: sttfa_nat):
      FORALL (return_: [sttfa_nat -> bool]):
        return_(n) IMPLIES
          ((FORALL (m: sttfa_nat):
              return_(sttfa_S(m)))
           IMPLIES
             (FORALL (m: sttfa_nat):
                sttfa_le(n)(m) IMPLIES return_(m)))

END nat_match_le_prop
