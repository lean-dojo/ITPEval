% Statement-only formalization of the Logipedia corpus artifact nat.le_plus
% (catalog title "nat.le_plus"): natural-number addition preserves
% less-than-or-equal relations in both arguments. This file contains no proof.

nat_le_plus: THEORY
BEGIN

  le_plus_statement: bool =
    FORALL (n1, n2, m1, m2: nat):
      n1 <= n2 IMPLIES
        m1 <= m2 IMPLIES
          n1 + m1 <= n2 + m2

END nat_le_plus
