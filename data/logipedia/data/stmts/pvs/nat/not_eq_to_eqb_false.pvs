% Statement-only formalization of the Logipedia corpus artifact
% nat.not_eq_to_eqb_false (catalog title "nat.not_eq_to_eqb_false"):
% inequality of two natural numbers implies that their Boolean equality test
% is false. This file contains no proof.

nat_not_eq_to_eqb_false: THEORY
BEGIN

  source_eqb(n, m: nat): RECURSIVE bool =
    IF n = 0 THEN
      m = 0
    ELSE
      IF m = 0 THEN
        FALSE
      ELSE
        source_eqb(n - 1, m - 1)
      ENDIF
    ENDIF
  MEASURE n

  not_eq_to_eqb_false_statement: bool =
    FORALL (n, m: nat):
      NOT (n = m) IMPLIES source_eqb(n, m) = FALSE

END nat_not_eq_to_eqb_false
