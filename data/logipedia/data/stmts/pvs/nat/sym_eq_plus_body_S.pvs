% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_plus_body_S (catalog title "nat.sym_eq_plus_body_S"): for every
% source natural n, the function mapping m to the successor of plus n m is
% Leibniz-equal to plus_body at the successor of n. This file contains no proof.

nat_sym_eq_plus_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  plus, plus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_plus_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(LAMBDA (m: sttfa_nat): sttfa_S(plus(n)(m)))
        (plus_body(sttfa_S(n)))

END nat_sym_eq_plus_body_S
