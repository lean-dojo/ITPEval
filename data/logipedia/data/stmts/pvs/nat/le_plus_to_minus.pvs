% Statement-only formalization of the Logipedia corpus artifact
% nat.le_plus_to_minus (catalog title "nat.le_plus_to_minus"): if a natural
% number is at most p + m, subtracting m leaves a value at most p.
% This file contains no proof.

nat_le_plus_to_minus: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  le_plus_to_minus_statement: bool =
    FORALL (n, m, p: nat):
      n <= p + m IMPLIES source_minus(n, m) <= p

END nat_le_plus_to_minus
