% Statement-only formalization of the Logipedia corpus artifact
% nat.not_le_S_S_to_not_le (catalog title "nat.not_le_S_S_to_not_le"):
% if the successors of two natural numbers are not ordered by <=, then the
% original numbers are not ordered by <=. This file contains no proof.

nat_not_le_S_S_to_not_le: THEORY
BEGIN

  not_le_S_S_to_not_le_statement: bool =
    FORALL (n, m: nat):
      NOT (n + 1 <= m + 1) IMPLIES NOT (n <= m)

END nat_not_le_S_S_to_not_le
