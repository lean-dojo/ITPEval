% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_match_nat_type_S (catalog title "nat.axiom_match_nat_type_S"):
% for every result type, pair of natural-number match branches, and natural
% number n, the source equality relates matching at S(n) to the successor
% branch at n. This file contains no proof.

nat_axiom_match_nat_type_S[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  connectives_equal: [return_type -> [return_type -> bool]]

  match_nat_type:
    [return_type ->
    [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]]

  axiom_match_nat_type_S_statement: bool =
    FORALL (case_O: return_type),
           (case_S: [sttfa_nat -> return_type]),
           (n: sttfa_nat):
      connectives_equal(
        match_nat_type(case_O)(case_S)(sttfa_S(n)))(case_S(n))

END nat_axiom_match_nat_type_S
