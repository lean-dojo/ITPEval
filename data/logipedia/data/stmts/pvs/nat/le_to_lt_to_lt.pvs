% Statement-only formalization of the Logipedia corpus artifact
% nat.le_to_lt_to_lt (catalog title "nat.le_to_lt_to_lt"): for all natural
% numbers n, m, and p, n <= m and m < p imply n < p. This file contains no
% proof.

le_to_lt_to_lt: THEORY
BEGIN

  le_to_lt_to_lt_statement: bool =
    FORALL (n, m, p: nat):
      (n <= m) IMPLIES ((m < p) IMPLIES (n < p))

END le_to_lt_to_lt
