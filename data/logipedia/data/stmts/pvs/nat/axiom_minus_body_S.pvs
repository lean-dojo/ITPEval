% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_minus_body_S (catalog title "nat.axiom_minus_body_S"): for every
% source natural n, the source equality relates minus_body at its successor
% to the natural case function with successor n at zero and minus n q at
% successor q. This file contains no proof.

nat_axiom_minus_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  connectives_equal: [[sttfa_nat -> sttfa_nat] -> [[sttfa_nat -> sttfa_nat] -> bool]]

  minus, minus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  match_nat_type:
    [sttfa_nat ->
    [[sttfa_nat -> sttfa_nat] -> [sttfa_nat -> sttfa_nat]]]

  axiom_minus_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      connectives_equal(minus_body(sttfa_S(n)))
        (LAMBDA (m: sttfa_nat):
          match_nat_type(sttfa_S(n))
            (LAMBDA (q: sttfa_nat): minus(n)(q))(m))

END nat_axiom_minus_body_S
