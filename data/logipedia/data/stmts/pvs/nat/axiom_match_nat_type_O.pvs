% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_match_nat_type_O (catalog title "nat.axiom_match_nat_type_O"):
% for every result type and pair of natural-number match branches, the source
% equality relates matching at zero to the supplied zero branch. This file
% contains no proof.

nat_axiom_match_nat_type_O[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  connectives_equal: [return_type -> [return_type -> bool]]

  match_nat_type:
    [return_type ->
    [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]]

  axiom_match_nat_type_O_statement: bool =
    FORALL (case_O: return_type),
           (case_S: [sttfa_nat -> return_type]):
      connectives_equal(
        match_nat_type(case_O)(case_S)(sttfa_O))(case_O)

END nat_axiom_match_nat_type_O
