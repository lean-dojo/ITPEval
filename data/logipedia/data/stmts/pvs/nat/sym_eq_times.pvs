% Statement-only formalization of the Logipedia corpus artifact nat.sym_eq_times
% (catalog title "nat.sym_eq_times"): for every source natural input, the
% natural-type filter of times_body is Leibniz-equal to multiplication at that
% input. This file contains no proof.

nat_sym_eq_times: THEORY
BEGIN
  sttfa_nat: TYPE+

  times, times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  filter_nat_type:
    [[sttfa_nat -> [sttfa_nat -> sttfa_nat]] ->
    [sttfa_nat -> [sttfa_nat -> sttfa_nat]]]

  leibniz(
      x: [sttfa_nat -> sttfa_nat])(
      y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_times_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(filter_nat_type(times_body)(n))(times(n))

END nat_sym_eq_times
