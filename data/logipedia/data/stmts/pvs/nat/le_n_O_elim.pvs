% Statement-only formalization of the Logipedia corpus artifact nat.le_n_O_elim
% (catalog title "nat.le_n_O_elim"): a source natural number below zero satisfies
% every predicate that holds at zero. This file contains no proof.

nat_le_n_O_elim: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  sttfa_le: [sttfa_nat -> [sttfa_nat -> bool]]

  le_n_O_elim_statement: bool =
    FORALL (n: sttfa_nat):
      sttfa_le(n)(sttfa_O) IMPLIES
        (FORALL (P: [sttfa_nat -> bool]):
          P(sttfa_O) IMPLIES P(n))

END nat_le_n_O_elim
