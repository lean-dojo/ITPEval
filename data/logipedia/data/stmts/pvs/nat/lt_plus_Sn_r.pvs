% Statement-only formalization of the Logipedia corpus artifact
% nat.lt_plus_Sn_r (catalog title "nat.lt_plus_Sn_r"): for all natural
% numbers a, x, and n, a is less than (a + x) plus the successor of n.
% This file contains no proof.

nat_lt_plus_Sn_r: THEORY
BEGIN

  lt_plus_Sn_r_statement: bool =
    FORALL (a, x, n: nat):
      a < (a + x) + (n + 1)

END nat_lt_plus_Sn_r
