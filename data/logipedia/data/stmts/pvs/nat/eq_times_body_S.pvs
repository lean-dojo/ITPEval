% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_times_body_S (catalog title "nat.eq_times_body_S"): for every source
% natural n, times_body at its successor is Leibniz-equal to the function
% mapping m to plus m (times n m). This file contains no proof.

nat_eq_times_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  plus, times, times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_times_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(times_body(sttfa_S(n)))
        (LAMBDA (m: sttfa_nat): plus(m)(times(n)(m)))

END nat_eq_times_body_S
