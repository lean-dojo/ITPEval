% Statement-only formalization of the Logipedia corpus artifact
% nat.minus_to_plus (catalog title "nat.minus_to_plus"): if subtracting one
% natural number from a greater or equal natural number yields a third, then
% the original number is their sum. This file contains no proof.

nat_minus_to_plus: THEORY
BEGIN

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  minus_to_plus_statement: bool =
    FORALL (n, m, p: nat):
      m <= n IMPLIES
        source_minus(n, m) = p IMPLIES
          n = m + p

END nat_minus_to_plus
