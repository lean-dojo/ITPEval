% Statement-only formalization of the Logipedia corpus artifact
% nat.le_plus_to_minus_r (catalog title "nat.le_plus_to_minus_r"): if the
% sum of two natural numbers is at most a third, the first is at most the
% third minus the second using truncated natural subtraction.
% This file contains no proof.

nat_le_plus_to_minus_r: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  le_plus_to_minus_r_statement: bool =
    FORALL (a, b, c: nat):
      a + b <= c IMPLIES a <= truncated_subtraction(c, b)

END nat_le_plus_to_minus_r
