% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_le_minus_r (catalog title "nat.monotonic_le_minus_r"):
% truncated natural subtraction is antitone in its right argument.
% This file contains no proof.

nat_monotonic_le_minus_r: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  monotonic_le_minus_r_statement: bool =
    FORALL (p, q, n: nat):
      q <= p IMPLIES
        truncated_subtraction(n, p) <= truncated_subtraction(n, q)

END nat_monotonic_le_minus_r
