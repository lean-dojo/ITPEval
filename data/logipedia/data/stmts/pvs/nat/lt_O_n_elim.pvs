% Statement-only formalization of the Logipedia corpus artifact
% nat.lt_O_n_elim (catalog title "nat.lt_O_n_elim"): for a positive natural
% number, any predicate true of every successor is true of that number. This
% file contains no proof.

nat_lt_O_n_elim: THEORY
BEGIN

  lt_O_n_elim_statement: bool =
    FORALL (n: nat):
      0 < n IMPLIES
        FORALL (P: [nat -> bool]):
          (FORALL (m: nat): P(m + 1)) IMPLIES P(n)

END nat_lt_O_n_elim
