% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_times_body_O (catalog title "nat.sym_eq_times_body_O"): the
% constant-zero function on the source natural type is Leibniz-equal to
% times_body at the source natural zero. This file contains no proof.

nat_sym_eq_times_body_O: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_times_body_O_statement: bool =
    leibniz(LAMBDA (m: sttfa_nat): sttfa_O)
      (times_body(sttfa_O))

END nat_sym_eq_times_body_O
