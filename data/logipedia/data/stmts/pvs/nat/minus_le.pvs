% Statement-only formalization of the Logipedia corpus artifact nat.minus_le
% (catalog title "nat.minus_le"): truncated subtraction of any natural number
% from another is at most the minuend. This file contains no proof.

nat_minus_le: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  minus_le_statement: bool =
    FORALL (x, y: nat):
      truncated_subtraction(x, y) <= x

END nat_minus_le
