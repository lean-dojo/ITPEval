% Statement-only formalization of the Logipedia corpus artifact
% nat.minus_minus_comm (catalog title "nat.minus_minus_comm"): successive
% truncated natural subtraction is unchanged when the two subtrahends are
% exchanged. This file contains no proof.

nat_minus_minus_comm: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  minus_minus_comm_statement: bool =
    FORALL (a, b, c: nat):
      truncated_subtraction(truncated_subtraction(a, b), c) =
        truncated_subtraction(truncated_subtraction(a, c), b)

END nat_minus_minus_comm
