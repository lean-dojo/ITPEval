% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_filter_nat_type_O (catalog title "nat.eq_filter_nat_type_O"):
% for every nonempty result type and natural-indexed function, applying the
% natural-type filter at zero is Leibniz-equal to the function's value at
% zero. This file contains no proof.

nat_eq_filter_nat_type_O_context[return_type: TYPE+]: THEORY
BEGIN
  filter_nat_type:
    [[nat -> return_type] -> [nat -> return_type]]
END nat_eq_filter_nat_type_O_context

nat_eq_filter_nat_type_O[return_type: TYPE+]: THEORY
BEGIN
  IMPORTING nat_eq_filter_nat_type_O_context[return_type]

  leibniz(x: return_type)(y: return_type): bool =
    FORALL (P: [return_type -> bool]):
      P(x) IMPLIES P(y)

  eq_filter_nat_type_O_statement: bool =
    FORALL (return_function: [nat -> return_type]):
      leibniz(filter_nat_type(return_function)(0))
        (return_function(0))
END nat_eq_filter_nat_type_O
