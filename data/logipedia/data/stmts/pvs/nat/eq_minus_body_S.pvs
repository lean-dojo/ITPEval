% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_minus_body_S (catalog title "nat.eq_minus_body_S"): for every natural
% n, minus_body at the successor of n is Leibniz-equal to the natural case
% function with successor n at zero and minus n q at successor q. This file
% contains no proof.

nat_eq_minus_body_S: THEORY
BEGIN
  minus, minus_body: [nat -> [nat -> nat]]

  match_nat_type: [nat -> [[nat -> nat] -> [nat -> nat]]]

  leibniz(x: [nat -> nat])(y: [nat -> nat]): bool =
    FORALL (P: [[nat -> nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_minus_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(minus_body(n + 1))
        (LAMBDA (m: nat):
          match_nat_type(n + 1)
            (LAMBDA (q: nat): minus(n)(q))(m))

END nat_eq_minus_body_S
