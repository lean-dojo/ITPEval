% Statement-only formalization of the Logipedia corpus artifact nat.ltn_to_ltO
% (catalog title "nat.ltn_to_ltO"): if one natural number is strictly below
% another, then zero is strictly below the greater number. This file contains
% no proof.

nat_ltn_to_ltO: THEORY
BEGIN

  ltn_to_ltO_statement: bool =
    FORALL (n: nat):
      FORALL (m: nat):
        n < m IMPLIES 0 < m

END nat_ltn_to_ltO
