% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_eqb_body_O (catalog title "nat.sym_eq_eqb_body_O"): the natural
% case function returning true at zero and false at every successor is
% Leibniz-equal to eqb_body at natural zero. This file contains no proof.

nat_sym_eq_eqb_body_O: THEORY
BEGIN
  eqb_body: [nat -> [nat -> bool]]

  match_nat_type: [bool -> [[nat -> bool] -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_eqb_body_O_statement: bool =
    leibniz(
      (LAMBDA (m: nat):
        match_nat_type(TRUE)(LAMBDA (q: nat): FALSE)(m)))
      (eqb_body(0))
END nat_sym_eq_eqb_body_O
