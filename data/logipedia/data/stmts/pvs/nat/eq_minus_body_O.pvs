% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_minus_body_O (catalog title "nat.eq_minus_body_O"): minus_body at
% natural zero is Leibniz-equal to the constant-zero function on natural
% numbers. This file contains no proof.

nat_eq_minus_body_O: THEORY
BEGIN
  minus_body: [nat -> [nat -> nat]]
  leibniz(x: [nat -> nat])(y: [nat -> nat]): bool =
    FORALL (P: [[nat -> nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_minus_body_O_statement: bool =
    leibniz(minus_body(0))(LAMBDA (m: nat): 0)
END nat_eq_minus_body_O
