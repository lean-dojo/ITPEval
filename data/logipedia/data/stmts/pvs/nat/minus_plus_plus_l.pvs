% Statement-only formalization of the Logipedia corpus artifact
% nat.minus_plus_plus_l (catalog title "nat.minus_plus_plus_l"): adding the
% same natural number to both arguments of truncated natural subtraction
% leaves the result unchanged. This file contains no proof.

nat_minus_plus_plus_l: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  minus_plus_plus_l_statement: bool =
    FORALL (x, y, h: nat):
      truncated_subtraction(x + h, y + h) =
        truncated_subtraction(x, y)

END nat_minus_plus_plus_l
