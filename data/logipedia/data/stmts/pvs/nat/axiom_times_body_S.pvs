% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_times_body_S (catalog title "nat.axiom_times_body_S"): for every
% source natural n, the source equality relates times_body at its successor
% to the function mapping m to plus m (times n m). This file contains no proof.

nat_axiom_times_body_S: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_S: [sttfa_nat -> sttfa_nat]

  connectives_equal: [[sttfa_nat -> sttfa_nat] -> [[sttfa_nat -> sttfa_nat] -> bool]]

  plus, times, times_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  axiom_times_body_S_statement: bool =
    FORALL (n: sttfa_nat):
      connectives_equal(times_body(sttfa_S(n)))
        (LAMBDA (m: sttfa_nat): plus(m)(times(n)(m)))

END nat_axiom_times_body_S
