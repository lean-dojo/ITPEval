% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_plus_body_O (catalog title "nat.eq_plus_body_O"): plus_body at
% natural zero is Leibniz-equal to the identity function on the source
% natural type. This file contains no proof.

nat_eq_plus_body_O: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  plus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  leibniz(x: [sttfa_nat -> sttfa_nat])
         (y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  eq_plus_body_O_statement: bool =
    leibniz(plus_body(sttfa_O))
      (LAMBDA (m: sttfa_nat): m)

END nat_eq_plus_body_O
