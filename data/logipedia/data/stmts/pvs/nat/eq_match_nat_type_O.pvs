% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_match_nat_type_O (catalog title "nat.eq_match_nat_type_O"):
% matching the source natural zero constructor is Leibniz-equal to the
% supplied zero branch for every nonempty return type. This file contains no proof.

nat_eq_match_nat_type_O[
  return_type: TYPE+
]: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  match_nat_type:
    [return_type ->
    [[sttfa_nat -> return_type] -> [sttfa_nat -> return_type]]]

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  eq_match_nat_type_O_statement: bool =
    FORALL (case_O: return_type):
      FORALL (case_S: [sttfa_nat -> return_type]):
        leibniz(match_nat_type(case_O)(case_S)(sttfa_O), case_O)

END nat_eq_match_nat_type_O
