% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_eqb_body_O (catalog title "nat.eq_eqb_body_O"): eqb_body at natural
% zero is Leibniz-equal to the natural case function returning true at zero
% and false at every successor. This file contains no proof.

nat_eq_eqb_body_O_context: THEORY
BEGIN
  eqb_body: [nat -> [nat -> bool]]
  match_nat_type: [bool -> [[nat -> bool] -> [nat -> bool]]]
END nat_eq_eqb_body_O_context

nat_eq_eqb_body_O: THEORY
BEGIN
  IMPORTING nat_eq_eqb_body_O_context

  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  eq_eqb_body_O_statement: bool =
    leibniz(eqb_body(0))
      (LAMBDA (m: nat):
        match_nat_type(TRUE)(LAMBDA (q: nat): FALSE)(m))
END nat_eq_eqb_body_O
