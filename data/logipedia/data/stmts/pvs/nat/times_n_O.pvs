% Statement-only formalization of the Logipedia corpus artifact nat.times_n_O
% (catalog title "nat.times_n_O"): multiplying any natural number by zero on
% the right yields zero. This file contains no proof.

nat_times_n_O: THEORY
BEGIN

  times_n_O_statement: bool =
    FORALL (n: nat):
      0 = n * 0

END nat_times_n_O
