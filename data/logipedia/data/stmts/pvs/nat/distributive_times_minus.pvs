% Statement-only formalization of the Logipedia corpus artifact
% nat.distributive_times_minus (catalog title "nat.distributive_times_minus"):
% natural-number multiplication distributes on the left over truncated
% natural-number subtraction. This file contains no proof.

nat_distributive_times_minus: THEORY
BEGIN

  truncated_subtraction(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  distributive_times_minus_statement: bool =
    FORALL (a, b, c: nat):
      a * truncated_subtraction(b, c) =
        truncated_subtraction(a * b, a * c)

END nat_distributive_times_minus
