% Statement-only formalization of the Logipedia corpus artifact
% nat.axiom_plus_body_O (catalog title "nat.axiom_plus_body_O"): the source
% equality relates plus_body at natural zero to the identity function on
% natural numbers. This file contains no proof.

nat_axiom_plus_body_O: THEORY
BEGIN
  connectives_equal: [[nat -> nat] -> [[nat -> nat] -> bool]]

  plus_body: [nat -> [nat -> nat]]

  axiom_plus_body_O_statement: bool =
    connectives_equal(plus_body(0))
      (LAMBDA (m: nat): m)

END nat_axiom_plus_body_O
