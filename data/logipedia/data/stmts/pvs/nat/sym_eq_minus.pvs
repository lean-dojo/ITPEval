% Statement-only formalization of the Logipedia corpus artifact
% nat.sym_eq_minus (catalog title "nat.sym_eq_minus"): for every source
% natural input, the natural-type filter of minus_body is Leibniz-equal to
% minus at that input. This file contains no proof.

nat_sym_eq_minus: THEORY
BEGIN
  sttfa_nat: TYPE+

  minus, minus_body: [sttfa_nat -> [sttfa_nat -> sttfa_nat]]

  filter_nat_type:
    [[sttfa_nat -> [sttfa_nat -> sttfa_nat]] ->
    [sttfa_nat -> [sttfa_nat -> sttfa_nat]]]

  leibniz(
      x: [sttfa_nat -> sttfa_nat])(
      y: [sttfa_nat -> sttfa_nat]): bool =
    FORALL (P: [[sttfa_nat -> sttfa_nat] -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_minus_statement: bool =
    FORALL (n: sttfa_nat):
      leibniz(filter_nat_type(minus_body)(n))(minus(n))

END nat_sym_eq_minus
