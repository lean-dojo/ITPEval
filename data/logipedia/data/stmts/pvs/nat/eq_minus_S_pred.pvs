% Statement-only formalization of the Logipedia corpus artifact
% nat.eq_minus_S_pred (catalog title "nat.eq_minus_S_pred"): subtracting the
% successor of a natural number equals taking the predecessor after subtracting
% that natural number. This file contains no proof.

nat_eq_minus_S_pred: THEORY
BEGIN

  source_pred(value: nat): nat =
    IF value = 0 THEN 0 ELSE value - 1 ENDIF

  source_minus(n, m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = 0 THEN
      n
    ELSE
      source_minus(n - 1, m - 1)
    ENDIF
  MEASURE n

  eq_minus_S_pred_statement: bool =
    FORALL (n, m: nat):
      source_minus(n, m + 1) = source_pred(source_minus(n, m))

END nat_eq_minus_S_pred
