% Statement-only formalization of the Logipedia corpus artifact nat.nat_case
% (catalog title "nat.nat_case"): case analysis for the source natural type,
% using its zero, successor, and equality objects. This file contains no proof.

nat_nat_case: THEORY
BEGIN

  nat_case_statement: bool =
    FORALL (n: nat):
      FORALL (P: [nat -> bool]):
        (n = 0 IMPLIES P(0))
          IMPLIES
            ((FORALL (m: nat):
                n = m + 1 IMPLIES P(m + 1))
              IMPLIES P(n))

END nat_nat_case
