% Statement-only formalization of the Logipedia corpus artifact
% nat.plus_O_n (catalog title "nat.plus_O_n"): zero added on the left leaves
% every natural number unchanged. This file contains no proof.

nat_plus_O_n: THEORY
BEGIN

  plus_O_n_statement: bool =
    FORALL (n: nat):
      n = 0 + n

END nat_plus_O_n
