% Statement-only formalization of the Logipedia corpus artifact nat.plus_n_O
% (catalog title "nat.plus_n_O"): adding zero on the right leaves every
% natural number unchanged. This file contains no proof.

nat_plus_n_O: THEORY
BEGIN

  plus_n_O_statement: bool =
    FORALL (n: nat):
      n = n + 0

END nat_plus_n_O
