% Statement-only formalization of the Logipedia corpus artifact nat.axiom_eqb
% (catalog title "nat.axiom_eqb"): for every natural input, the source
% equality relates eqb at that input to the natural-type filter of eqb_body.
% This file contains no proof.

nat_axiom_eqb: THEORY
BEGIN
  connectives_equal: [[nat -> bool] -> [[nat -> bool] -> bool]]

  eqb, eqb_body: [nat -> [nat -> bool]]

  filter_nat_type: [[nat -> [nat -> bool]] -> [nat -> [nat -> bool]]]

  axiom_eqb_statement: bool =
    FORALL (n: nat):
      connectives_equal(eqb(n))(filter_nat_type(eqb_body)(n))

END nat_axiom_eqb
