% Statement-only formalization of the Logipedia corpus artifact nat.eq_leb
% (catalog title "nat.eq_leb"): for every natural number, the Boolean
% less-than-or-equal test at that number is Leibniz-equal to the natural-type
% filter of leb_body. This file contains no proof.

nat_eq_leb: THEORY
BEGIN
  leb, leb_body: [nat -> [nat -> bool]]

  filter_nat_type: [[nat -> [nat -> bool]] -> [nat -> [nat -> bool]]]
  leibniz(x: [nat -> bool])(y: [nat -> bool]): bool =
    FORALL (P: [[nat -> bool] -> bool]):
      P(x) IMPLIES P(y)

  eq_leb_statement: bool =
    FORALL (n: nat):
      leibniz(leb(n))(filter_nat_type(leb_body)(n))
END nat_eq_leb
