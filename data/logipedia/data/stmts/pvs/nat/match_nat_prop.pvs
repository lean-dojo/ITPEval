% Statement-only formalization of Logipedia corpus artifact nat.match_nat_prop
% (catalog title "nat.match_nat_prop"): every predicate on the source natural
% type that holds at zero and at every successor holds at every natural value.
% This file contains no proof.

nat_match_nat_prop: THEORY
BEGIN
  sttfa_nat: TYPE+

  sttfa_O: sttfa_nat

  sttfa_S: [sttfa_nat -> sttfa_nat]
  match_nat_prop: bool =
    FORALL (return_predicate: [sttfa_nat -> bool]):
      return_predicate(sttfa_O) IMPLIES
        ((FORALL (n: sttfa_nat): return_predicate(sttfa_S(n)))
          IMPLIES
            (FORALL (z: sttfa_nat): return_predicate(z)))
END nat_match_nat_prop
