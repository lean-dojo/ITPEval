% Statement-only formalization of the Logipedia corpus artifact
% nat.monotonic_lt_plus_r (catalog title "nat.monotonic_lt_plus_r"):
% adding a fixed natural number on the left is strictly monotone for the
% strict natural order. This file contains no proof.

nat_monotonic_lt_plus_r: THEORY
BEGIN

  monotonic_lt_plus_r_statement: bool =
    FORALL (n, x, y: nat):
      x < y IMPLIES n + x < n + y

END nat_monotonic_lt_plus_r
