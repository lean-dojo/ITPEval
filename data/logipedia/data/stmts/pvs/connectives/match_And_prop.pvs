% Statement-only formalization of Logipedia corpus artifact connectives.match_And_prop
% (catalog title "connectives.match_And_prop"): elimination for the module's
% abstract binary conjunction connective. This file contains no proof.

connectives_match_And_prop: THEORY
BEGIN
  sttfa_And: [bool -> [bool -> bool]]
  match_And_prop_statement: bool =
    FORALL (A, B, return_value: bool):
      (A IMPLIES (B IMPLIES return_value))
        IMPLIES (sttfa_And(A)(B) IMPLIES return_value)
END connectives_match_And_prop
