% Statement-only formalization of Logipedia corpus artifact connectives.nmk
% (catalog title "connectives.nmk"): introduction of the module's abstract
% negation connective from implication to its abstract falsity proposition.
% This file contains no proof.

connectives_nmk: THEORY
BEGIN
  sttfa_False: bool

  sttfa_Not: [bool -> bool]
  nmk_statement: bool =
    FORALL (A: bool):
      (A IMPLIES sttfa_False) IMPLIES sttfa_Not(A)
END connectives_nmk
