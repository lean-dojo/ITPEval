% Statement-only formalization of Logipedia corpus artifact connectives.Not_ind
% (catalog title "connectives.Not_ind"): elimination for the module's abstract
% negation connective into an arbitrary proposition. This file contains no proof.

connectives_Not_ind: THEORY
BEGIN
  sttfa_False: bool

  sttfa_Not: [bool -> bool]
  Not_ind_statement: bool =
    FORALL (A, Q: bool):
      (((A IMPLIES sttfa_False) IMPLIES Q)
        IMPLIES (sttfa_Not(A) IMPLIES Q))
END connectives_Not_ind
