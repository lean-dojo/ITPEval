% Statement-only formalization of Logipedia corpus artifact connectives.falsity
% (catalog title "connectives.falsity"): elimination from the module's abstract
% falsity proposition into an arbitrary proposition. This file contains no proof.

connectives_falsity: THEORY
BEGIN
  sttfa_False: bool
  falsity_statement: bool =
    FORALL (t: bool):
      sttfa_False IMPLIES t
END connectives_falsity
