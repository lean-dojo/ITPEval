% Statement-only formalization of Logipedia corpus artifact connectives.match_ex_prop
% (catalog title "connectives.match_ex_prop"): elimination for the module's
% abstract existential connective into an arbitrary proposition. This file
% contains no proof.

connectives_match_ex_prop[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_ex: [[A -> bool] -> bool]
  match_ex_prop_statement: bool =
    FORALL (P: [A -> bool]):
      FORALL (return_value: bool):
        (FORALL (x: A): P(x) IMPLIES return_value)
          IMPLIES (sttfa_ex(P) IMPLIES return_value)
END connectives_match_ex_prop
