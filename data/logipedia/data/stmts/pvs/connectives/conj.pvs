% Statement-only formalization of Logipedia corpus artifact connectives.conj
% (catalog title "connectives.conj"): conjunction introduction for the module's
% abstract binary conjunction connective. This file contains no proof.

connectives_conj: THEORY
BEGIN
  sttfa_And: [bool -> [bool -> bool]]
  conj_statement: bool =
    FORALL (A, B: bool):
      A IMPLIES (B IMPLIES sttfa_And(A)(B))
END connectives_conj
