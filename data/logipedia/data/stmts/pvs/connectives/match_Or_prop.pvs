% Statement-only formalization of Logipedia corpus artifact connectives.match_Or_prop
% (catalog title "connectives.match_Or_prop"): elimination for the module's
% abstract binary disjunction connective. This file contains no proof.

connectives_match_Or_prop: THEORY
BEGIN
  sttfa_Or: [bool -> [bool -> bool]]

  match_Or_prop_statement: bool =
    FORALL (A, B, return_value: bool):
      (A IMPLIES return_value)
        IMPLIES ((B IMPLIES return_value)
          IMPLIES (sttfa_Or(A)(B) IMPLIES return_value))
END connectives_match_Or_prop
