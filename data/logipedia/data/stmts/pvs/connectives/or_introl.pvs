% Statement-only formalization of Logipedia corpus artifact connectives.or_introl
% (catalog title "connectives.or_introl"): left introduction for the module's
% abstract binary disjunction connective. This file contains no proof.

connectives_or_introl: THEORY
BEGIN
  sttfa_Or: [bool -> [bool -> bool]]
  or_introl_statement: bool =
    FORALL (A, B: bool):
      A IMPLIES sttfa_Or(A)(B)
END connectives_or_introl
