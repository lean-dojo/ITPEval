% Statement-only formalization of Logipedia corpus artifact connectives.or_intror
% (catalog title "connectives.or_intror"): right introduction for the module's
% abstract binary disjunction connective. This file contains no proof.

connectives_or_intror: THEORY
BEGIN
  sttfa_Or: [bool -> [bool -> bool]]
  or_intror_statement: bool =
    FORALL (A, B: bool):
      B IMPLIES sttfa_Or(A)(B)
END connectives_or_intror
