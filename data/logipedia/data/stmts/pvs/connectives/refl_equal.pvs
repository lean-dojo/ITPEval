% Statement-only formalization of Logipedia corpus artifact connectives.refl_equal
% (catalog title "connectives.refl_equal"): reflexivity of the module's abstract
% equality relation on an arbitrary nonempty type. This file contains no proof.

connectives_refl_equal[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_equal: [A -> [A -> bool]]
  refl_equal_statement: bool =
    FORALL (x: A):
      sttfa_equal(x)(x)
END connectives_refl_equal
