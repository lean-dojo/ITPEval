% Statement-only formalization of Logipedia corpus artifact connectives.ex_intro
% (catalog title "connectives.ex_intro"): introduction from an internal witness
% for the module's abstract existential connective. This file contains no proof.

connectives_ex_intro[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_ex: [[A -> bool] -> bool]

  ex_intro_statement: bool =
    FORALL (P: [A -> bool]):
      FORALL (x: A):
        P(x) IMPLIES sttfa_ex(P)
END connectives_ex_intro
