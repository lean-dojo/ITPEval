% Statement-only formalization of Logipedia corpus artifact
% connectives.equal_leibniz (catalog title "connectives.equal_leibniz"):
% Leibniz substitution for the module's abstract equality relation on an
% arbitrary nonempty type. This file contains no proof.

connectives_equal_leibniz[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_equal: [A -> [A -> bool]]
  equal_leibniz_statement: bool =
    FORALL (x, y: A):
      sttfa_equal(x)(y) IMPLIES
        FORALL (P: [A -> bool]):
          P(x) IMPLIES P(y)
END connectives_equal_leibniz
