% Statement-only formalization of Logipedia corpus artifact logic.rewrite_l
% (catalog title "logic.rewrite_l"): left-to-right transport of a predicate
% along the logic module's abstract equality relation on an arbitrary
% nonempty type. This file contains no proof.

logic_rewrite_l[
  A: TYPE+
]: THEORY
BEGIN
  rewrite_l_statement: FORMULA
    FORALL (x: A):
      FORALL (P: [A -> bool]):
        P(x) IMPLIES
          FORALL (y: A):
            x = y IMPLIES P(y)
END logic_rewrite_l
