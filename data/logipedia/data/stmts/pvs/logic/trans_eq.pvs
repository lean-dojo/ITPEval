% Statement-only formalization of Logipedia corpus artifact logic.trans_eq
% (catalog title "logic.trans_eq"): transitivity of the logic module's abstract
% equality relation on an arbitrary nonempty type. This file contains no proof.

logic_trans_eq[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_eq: [A -> [A -> bool]]
  trans_eq_statement: bool =
    FORALL (x, y, z: A):
      sttfa_eq(x)(y) IMPLIES
        sttfa_eq(y)(z) IMPLIES sttfa_eq(x)(z)
END logic_trans_eq
