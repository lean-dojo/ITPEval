% Statement-only formalization of Logipedia corpus artifact logic.sym_not_eq
% (catalog title "logic.sym_not_eq"): symmetry of inequality formed from the
% logic module's abstract equality and negation on an arbitrary nonempty type.
% This file contains no proof.

logic_sym_not_eq[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_Not: [bool -> bool]
  sttfa_eq: [A -> [A -> bool]]

  sym_not_eq_statement: bool =
    FORALL (x, y: A):
      sttfa_Not(sttfa_eq(x)(y)) IMPLIES
        sttfa_Not(sttfa_eq(y)(x))
END logic_sym_not_eq
