% Statement-only formalization of Logipedia corpus artifact logic.eq_ind
% (catalog title "logic.eq_ind"): induction for the logic module's abstract
% equality relation on an arbitrary nonempty type. This file contains no proof.

logic_eq_ind[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_eq: [A -> [A -> bool]]
  eq_ind_statement: bool =
    FORALL (x: A):
      FORALL (P: [A -> bool]):
        P(x) IMPLIES
          FORALL (y: A):
            sttfa_eq(x)(y) IMPLIES P(y)
END logic_eq_ind
