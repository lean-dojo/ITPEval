% Statement-only formalization of Logipedia corpus artifact logic.not_to_not
% (catalog title "logic.not_to_not"): contraposition from an implication using
% the module's abstract negation connective. This file contains no proof.

logic_not_to_not: THEORY
BEGIN
  sttfa_Not: [bool -> bool]

  not_to_not_statement: bool =
    FORALL (A, B: bool):
      (A IMPLIES B) IMPLIES
        (sttfa_Not(B) IMPLIES sttfa_Not(A))
END logic_not_to_not
