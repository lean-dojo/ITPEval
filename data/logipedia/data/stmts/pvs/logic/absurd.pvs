% Statement-only formalization of Logipedia corpus artifact logic.absurd
% (catalog title "logic.absurd"): deriving the module's abstract falsity
% proposition from a proposition and its abstract negation. This file contains no proof.

logic_absurd: THEORY
BEGIN
  sttfa_False: bool

  sttfa_Not: [bool -> bool]
  absurd_statement: bool =
    FORALL (A: bool):
      A IMPLIES (sttfa_Not(A) IMPLIES sttfa_False)
END logic_absurd
