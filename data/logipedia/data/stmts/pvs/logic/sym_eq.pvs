% Statement-only formalization of Logipedia corpus artifact logic.sym_eq
% (catalog title "logic.sym_eq"): symmetry of the logic module's abstract
% equality relation on an arbitrary nonempty type. This file contains no proof.

logic_sym_eq[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_eq: [A -> [A -> bool]]
  sym_eq_statement: bool =
    FORALL (x, y: A):
      sttfa_eq(x)(y) IMPLIES sttfa_eq(y)(x)
END logic_sym_eq
