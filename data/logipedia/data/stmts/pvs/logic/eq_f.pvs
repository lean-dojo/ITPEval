% Statement-only formalization of Logipedia corpus artifact logic.eq_f
% (catalog title "logic.eq_f"): preservation of the logic module's abstract
% equality by a function. This file contains no proof.

logic_eq_f[
  A: TYPE+,
  B: TYPE+
]: THEORY
BEGIN
  sttfa_eq_A: [A -> [A -> bool]]
  sttfa_eq_B: [B -> [B -> bool]]

  eq_f_statement: bool =
    FORALL (f: [A -> B]):
      FORALL (x, y: A):
        sttfa_eq_A(x)(y) IMPLIES
          sttfa_eq_B(f(x))(f(y))
END logic_eq_f
