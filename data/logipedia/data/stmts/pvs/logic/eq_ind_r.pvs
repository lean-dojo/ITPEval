% Statement-only formalization of Logipedia corpus artifact logic.eq_ind_r
% (catalog title "logic.eq_ind_r"): reverse induction for the logic module's
% abstract equality relation on an arbitrary nonempty type. This file contains no proof.

logic_eq_ind_r[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_eq: [A -> [A -> bool]]
  eq_ind_r_statement: bool =
    FORALL (a: A):
      FORALL (P: [A -> bool]):
        P(a) IMPLIES
          FORALL (x: A):
            sttfa_eq(x)(a) IMPLIES P(x)
END logic_eq_ind_r
