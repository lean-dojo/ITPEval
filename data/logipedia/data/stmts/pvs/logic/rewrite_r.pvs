% Statement-only formalization of Logipedia corpus artifact logic.rewrite_r
% (catalog title "logic.rewrite_r"): right-to-left transport of a predicate
% along the logic module's abstract equality relation on an arbitrary
% nonempty type. This file contains no proof.

logic_rewrite_r[
  A: TYPE+
]: THEORY
BEGIN
  rewrite_r_statement: FORMULA
    FORALL (x: A):
      FORALL (P: [A -> bool]):
        P(x) IMPLIES
          FORALL (y: A):
            y = x IMPLIES P(y)
END logic_rewrite_r
