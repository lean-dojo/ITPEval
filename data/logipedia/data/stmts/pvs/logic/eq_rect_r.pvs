% Statement-only formalization of Logipedia corpus artifact logic.eq_rect_r
% (catalog title "logic.eq_rect_r"): transport of a predicate along the logic
% module's abstract equality relation. This file contains no proof.

logic_eq_rect_r[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_eq: [A -> [A -> bool]]
  eq_rect_r_statement: bool =
    FORALL (a: A):
      FORALL (x: A):
        sttfa_eq(x)(a) IMPLIES
          FORALL (P: [A -> bool]):
            P(a) IMPLIES P(x)
END logic_eq_rect_r
