% Statement-only formalization of Logipedia corpus artifact logic.refl
% (catalog title "logic.refl"): reflexivity of the logic module's abstract
% equality relation on an arbitrary nonempty type. This file contains no proof.

logic_refl[
  A: TYPE+
]: THEORY
BEGIN
  sttfa_eq: [A -> [A -> bool]]
  refl_statement: bool =
    FORALL (x: A):
      sttfa_eq(x)(x)
END logic_refl
