% Statement-only formalization of Logipedia corpus artifact logic.eq_coerc
% (catalog title "logic.eq_coerc"): transport of truth between propositions
% related by the logic module's abstract equality. This file contains no proof.

logic_eq_coerc: THEORY
BEGIN
  sttfa_eq: [bool -> [bool -> bool]]

  eq_coerc_statement: bool =
    FORALL (A, B: bool):
      A IMPLIES (sttfa_eq(A)(B) IMPLIES B)
END logic_eq_coerc
