% Statement-only formalization of Logipedia corpus artifact logic.eq_f2
% (catalog title "logic.eq_f2"): preservation of the logic module's abstract
% equality in both arguments of a curried binary function. This file contains no proof.

logic_eq_f2[
  A: TYPE+,
  B: TYPE+,
  C: TYPE+
]: THEORY
BEGIN
  eq_f2_statement: FORMULA
    FORALL (f: [A -> [B -> C]]):
      FORALL (x1, x2: A):
        FORALL (y1, y2: B):
          x1 = x2 IMPLIES
            (y1 = y2 IMPLIES
              f(x1)(y1) = f(x2)(y2))
END logic_eq_f2
