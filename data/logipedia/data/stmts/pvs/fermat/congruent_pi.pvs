% Statement-only formalization of Logipedia corpus artifact fermat.congruent_pi
% (catalog title "fermat.congruent_pi"): the product of a finite prefix of
% natural numbers is congruent modulo a positive natural p to the product of
% their remainders modulo p. This file contains no proof.

fermat_congruent_pi: THEORY
BEGIN

  source_mod(value, modulus: nat): nat =
    epsilon(
      LAMBDA (remainder: nat):
        (modulus = 0 AND remainder = value)
          OR (0 < modulus AND remainder < modulus
            AND EXISTS (quotient: nat):
              value = quotient * modulus + remainder))

  prefix_product(count: nat, value: [nat -> nat]): RECURSIVE nat =
    IF count = 0 THEN
      1
    ELSE
      value(count - 1) * prefix_product(count - 1, value)
    ENDIF
  MEASURE count

  congruent(left, right, modulus: nat): bool =
    source_mod(left, modulus) = source_mod(right, modulus)

  congruent_pi_statement: bool =
    FORALL (f: [nat -> nat]), (n, p: nat):
      0 < p IMPLIES
        congruent(
          prefix_product(n, f),
          prefix_product(
            n,
            LAMBDA (i: nat): source_mod(f(i), p)),
          p)

END fermat_congruent_pi
