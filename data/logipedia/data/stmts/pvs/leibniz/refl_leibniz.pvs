% Statement-only formalization of Logipedia corpus artifact leibniz.refl_leibniz
% (catalog title "leibniz.refl_leibniz"): reflexivity of Leibniz equality on an
% arbitrary nonempty type. This file contains no proof.

leibniz_refl_leibniz[A: TYPE+]: THEORY
BEGIN
  leibniz(x, y: A): bool =
    FORALL (P: [A -> bool]):
      P(x) IMPLIES P(y)

  refl_leibniz_statement: bool =
    FORALL (x: A):
      leibniz(x, x)
END leibniz_refl_leibniz
