% Statement-only formalization of Logipedia corpus artifact leibniz.sym_leibniz
% (catalog title "leibniz.sym_leibniz"): symmetry of Leibniz equality on an
% arbitrary nonempty type. This file contains no proof.

leibniz_sym_leibniz[A: TYPE+]: THEORY
BEGIN
  leibniz(x, y: A): bool =
    FORALL (P: [A -> bool]):
      P(x) IMPLIES P(y)

  sym_leibniz_statement: bool =
    FORALL (x, y: A):
      leibniz(x, y) IMPLIES leibniz(y, x)
END leibniz_sym_leibniz
