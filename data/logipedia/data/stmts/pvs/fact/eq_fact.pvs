% Statement-only formalization of Logipedia corpus artifact fact.eq_fact
% (catalog title "fact.eq_fact"): for every natural number, the factorial
% value is Leibniz-equal to the natural-type filter of its body.
% This file contains no proof.

fact_eq_fact: THEORY
BEGIN
  fact_function, fact_body: [nat -> nat]

  filter_nat_type(body: [nat -> nat])(index: nat): nat =
    body(index)

  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  eq_fact_statement: bool =
    FORALL (n: nat):
      leibniz(fact_function(n))(filter_nat_type(fact_body)(n))
END fact_eq_fact
