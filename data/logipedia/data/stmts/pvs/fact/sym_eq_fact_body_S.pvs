% Statement-only formalization of Logipedia corpus artifact
% fact.sym_eq_fact_body_S (catalog title "fact.sym_eq_fact_body_S"): for every
% natural number, the factorial value at that number multiplied by its
% successor is Leibniz-equal to the factorial body at that successor. This
% file contains no proof.

fact_sym_eq_fact_body_S: THEORY
BEGIN
  fact_function, fact_body: [nat -> nat]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  sym_eq_fact_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(fact_function(n) * (n + 1))(fact_body(n + 1))
END fact_sym_eq_fact_body_S
