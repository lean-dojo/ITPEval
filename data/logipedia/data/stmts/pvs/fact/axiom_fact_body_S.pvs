% Statement-only formalization of Logipedia corpus artifact
% fact.axiom_fact_body_S (catalog title "fact.axiom_fact_body_S"): for every
% natural number, the factorial body at its successor is related by the source
% equality to the factorial value times that successor. This file contains no
% proof.

fact_axiom_fact_body_S: THEORY
BEGIN
  connectives_equal: [nat -> [nat -> bool]]

  fact_function, fact_body: [nat -> nat]
  axiom_fact_body_S_statement: bool =
    FORALL (n: nat):
      connectives_equal(fact_body(n + 1))(fact_function(n) * (n + 1))
END fact_axiom_fact_body_S
