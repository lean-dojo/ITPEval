% Statement-only formalization of Logipedia corpus artifact
% fact.eq_fact_body_O (catalog title "fact.eq_fact_body_O"): the factorial
% body at natural-number zero is Leibniz-equal to successor zero (one).
% This file contains no proof.

fact_eq_fact_body_O: THEORY
BEGIN
  fact_body: [nat -> nat]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  eq_fact_body_O_statement: bool =
    leibniz(fact_body(0))(1)
END fact_eq_fact_body_O
