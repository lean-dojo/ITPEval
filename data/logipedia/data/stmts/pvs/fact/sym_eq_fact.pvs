% Statement-only formalization of Logipedia corpus artifact fact.sym_eq_fact
% (catalog title "fact.sym_eq_fact"): for every natural number, the natural-type
% filter of the factorial body is Leibniz-equal to the factorial value.
% This file contains no proof.

fact_sym_eq_fact: THEORY
BEGIN
  fact_function, fact_body: [nat -> nat]

  filter_nat_type(body: [nat -> nat])(index: nat): nat =
    body(index)

  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  sym_eq_fact_statement: bool =
    FORALL (n: nat):
      leibniz(filter_nat_type(fact_body)(n))(fact_function(n))
END fact_sym_eq_fact
