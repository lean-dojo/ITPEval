% Statement-only formalization of Logipedia corpus artifact
% fact.axiom_fact_body_O (catalog title "fact.axiom_fact_body_O"): the
% factorial body at natural-number zero is related by the source equality to
% successor zero (one). This file contains no proof.

fact_axiom_fact_body_O: THEORY
BEGIN
  connectives_equal: [nat -> [nat -> bool]]

  fact_body: [nat -> nat]
  axiom_fact_body_O_statement: bool =
    connectives_equal(fact_body(0))(1)
END fact_axiom_fact_body_O
