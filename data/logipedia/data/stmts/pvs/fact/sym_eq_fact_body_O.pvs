% Statement-only formalization of Logipedia corpus artifact
% fact.sym_eq_fact_body_O (catalog title "fact.sym_eq_fact_body_O"): successor
% zero (one) is Leibniz-equal to the factorial body at natural-number zero.
% This file contains no proof.

fact_sym_eq_fact_body_O: THEORY
BEGIN
  fact_body: [nat -> nat]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  sym_eq_fact_body_O_statement: bool =
    leibniz(1)(fact_body(0))
END fact_sym_eq_fact_body_O
