% Statement-only formalization of Logipedia corpus artifact
% fact.eq_fact_body_S (catalog title "fact.eq_fact_body_S"): for every natural
% number, the factorial body at its successor is Leibniz-equal to the
% factorial value times that successor. This file contains no proof.

fact_eq_fact_body_S: THEORY
BEGIN
  fact_function, fact_body: [nat -> nat]
  leibniz(x: nat)(y: nat): bool =
    FORALL (P: [nat -> bool]): P(x) IMPLIES P(y)

  eq_fact_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(fact_body(n + 1))(fact_function(n) * (n + 1))
END fact_eq_fact_body_S
