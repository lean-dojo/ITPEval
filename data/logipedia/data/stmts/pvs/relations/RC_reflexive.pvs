% Statement-only formalization of Logipedia corpus artifact relations.RC_reflexive
% (catalog title "relations.RC_reflexive"): adjoining equality to an arbitrary
% binary relation yields a reflexive relation. This file contains no proof.

relations_RC_reflexive[A: TYPE]: THEORY
BEGIN
  relation_t: TYPE = [A -> [A -> bool]]

  logipedia_reflexive(R: relation_t): bool =
    FORALL (x: A):
      R(x)(x)

  logipedia_RC(R: relation_t): relation_t =
    LAMBDA (x: A):
      LAMBDA (y: A):
        R(x)(y) OR x = y

  RC_reflexive_statement: bool =
    FORALL (R: relation_t):
      logipedia_reflexive(logipedia_RC(R))
END relations_RC_reflexive
