% Statement-only formalization of the Logipedia corpus artifact
% gcd.let_clause_15491 (catalog title "gcd.let_clause_15491"): for all
% natural numbers m and n, if n is zero, then subtracting n from any natural
% number x1106 leaves x1106 unchanged. This file contains no proof.

let_clause_15491: THEORY
BEGIN

  source_minus(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  let_clause_15491_statement: bool =
    FORALL (m, n: nat):
      n = 0 IMPLIES
        FORALL (x1106: nat):
          x1106 = source_minus(x1106, n)

END let_clause_15491
