% Statement-only formalization of Logipedia corpus artifact
% gcd.axiom_gcd_aux_body_O (catalog title "gcd.axiom_gcd_aux_body_O"):
% at natural-number index zero, connectives.equal relates the auxiliary gcd
% body to the curried binary function returning its first natural argument.
% This file contains no proof.

gcd_axiom_gcd_aux_body_O: THEORY
BEGIN
  connectives_equal:
    [[nat -> [nat -> nat]] -> [[nat -> [nat -> nat]] -> bool]]

  gcd_aux_body: [nat -> [nat -> [nat -> nat]]]

  axiom_gcd_aux_body_O_statement: bool =
    connectives_equal(gcd_aux_body(0))
      (LAMBDA (m: nat): (LAMBDA (n: nat): m))
END gcd_axiom_gcd_aux_body_O
