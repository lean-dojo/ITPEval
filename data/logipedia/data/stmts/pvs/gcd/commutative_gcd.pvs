% Statement-only formalization of the Logipedia corpus artifact
% gcd.commutative_gcd (catalog title "gcd.commutative_gcd"): the source
% natural-number gcd wrapper is commutative for all pairs of natural numbers.
% This file contains no proof.

commutative_gcd: THEORY
BEGIN

  gcd_aux: [nat -> [nat -> [nat -> nat]]]

  source_gcd(n, m: nat): nat =
    IF n <= m THEN
      gcd_aux(n)(m)(n)
    ELSE
      gcd_aux(m)(n)(m)
    ENDIF

  commutative_gcd_statement: bool =
    FORALL (n, m: nat):
      source_gcd(n, m) = source_gcd(m, n)

END commutative_gcd
