% Statement-only formalization of the Logipedia corpus artifact
% gcd.divides_times_to_divides (catalog title "gcd.divides_times_to_divides"):
% a prime natural number dividing a product divides at least one factor.
% This file contains no proof.

gcd_divides_times_to_divides: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  prime_nat(value: nat): bool =
    1 < value
      AND (FORALL (divisor: nat):
        nat_divides(divisor, value) IMPLIES
          (1 < divisor IMPLIES divisor = value))

  divides_times_to_divides_statement: bool =
    FORALL (p, n, m: nat):
      prime_nat(p) IMPLIES
        (nat_divides(p, n * m) IMPLIES
          (nat_divides(p, n) OR nat_divides(p, m)))

END gcd_divides_times_to_divides
