% Statement-only formalization of the Logipedia corpus artifact
% gcd.let_clause_1551 (catalog title "gcd.let_clause_1551"): if a natural
% number n is zero, then n equals its product with any natural multiplier.
% This file contains no proof.

gcd_let_clause_1551: THEORY
BEGIN

  let_clause_1551_statement: bool =
    FORALL (m, n: nat):
      0 = n IMPLIES
        FORALL (x347: nat):
          n = x347 * n

END gcd_let_clause_1551
