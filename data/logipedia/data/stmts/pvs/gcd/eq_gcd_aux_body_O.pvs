% Statement-only formalization of Logipedia corpus artifact
% gcd.eq_gcd_aux_body_O (catalog title "gcd.eq_gcd_aux_body_O"): at
% natural-number index zero, the auxiliary gcd body is Leibniz-equal, as a
% curried binary natural-number function, to the function returning its first
% argument. This file contains no proof.

gcd_eq_gcd_aux_body_O: THEORY
BEGIN
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  gcd_aux_body: [nat -> binary_nat_function]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  eq_gcd_aux_body_O_statement: bool =
    leibniz(gcd_aux_body(0))
      (LAMBDA (m: nat): (LAMBDA (n: nat): m))
END gcd_eq_gcd_aux_body_O
