% Statement-only formalization of the Logipedia corpus artifact
% gcd.divides_mod_to_divides (catalog title "gcd.divides_mod_to_divides"):
% a natural number dividing both a positive modulus and a remainder modulo
% that modulus also divides the original number. This file contains no proof.

gcd_divides_mod_to_divides: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  divides_mod_to_divides_statement: bool =
    FORALL (p, m, n: nat):
      0 < n IMPLIES
        (nat_divides(p, source_mod(m, n)) IMPLIES
          (nat_divides(p, n) IMPLIES nat_divides(p, m)))

END gcd_divides_mod_to_divides
