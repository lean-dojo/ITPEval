% Statement-only formalization of the Logipedia corpus artifact
% gcd.let_clause_1571 (catalog title "gcd.let_clause_1571"): for natural
% numbers m and n, the source gcd being zero together with both numbers
% being zero implies that m equals n. This file contains no proof.

gcd_let_clause_1571: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  dividesb(divisor, value: nat): bool =
    source_mod(value, divisor) = 0

  gcd_aux(p, m, n: nat): RECURSIVE nat =
    IF p = 0 THEN
      m
    ELSIF dividesb(n, m) THEN
      n
    ELSE
      gcd_aux(p - 1, n, source_mod(m, n))
    ENDIF
  MEASURE p

  source_gcd(n, m: nat): nat =
    IF n <= m THEN
      gcd_aux(n, m, n)
    ELSE
      gcd_aux(m, n, m)
    ENDIF

  let_clause_1571_statement: bool =
    FORALL (m, n: nat):
      0 < n IMPLIES
        source_gcd(m, n) = 0 IMPLIES
          m = 0 IMPLIES
            n = 0 IMPLIES
              m = n

END gcd_let_clause_1571
