% Statement-only formalization of the Logipedia corpus artifact
% gcd.eq_minus_gcd_aux (catalog title "gcd.eq_minus_gcd_aux"): for natural
% p, m, and positive n with n bounded by m and p, natural coefficients exist
% whose truncated difference, in one of the two orders, equals the source
% fuel-recursive auxiliary gcd value. This file contains no proof.

gcd_eq_minus_gcd_aux: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  dividesb(divisor, value: nat): bool =
    source_mod(value, divisor) = 0

  gcd_aux(p, m, n: nat): RECURSIVE nat =
    IF p = 0 THEN
      m
    ELSIF dividesb(n, m) THEN
      n
    ELSE
      gcd_aux(p - 1, n, source_mod(m, n))
    ENDIF
  MEASURE p

  eq_minus_gcd_aux_statement: bool =
    FORALL (p, m, n: nat):
      0 < n IMPLIES
        n <= m IMPLIES
          n <= p IMPLIES
            EXISTS (a, b: nat):
              nat_subtract(a * n, b * m) = gcd_aux(p, m, n)
                OR nat_subtract(b * m, a * n) = gcd_aux(p, m, n)

END gcd_eq_minus_gcd_aux
