% Statement-only formalization of Logipedia corpus artifact
% gcd.axiom_gcd_aux (catalog title "gcd.axiom_gcd_aux"): at every natural
% index, the auxiliary gcd function is related by the source equality to the
% natural-type filter of its body at that index, under the imported equality
% substitution and filter equations. This file contains no proof.

gcd_axiom_gcd_aux: THEORY
BEGIN
  connectives_equal: [[nat -> [nat -> nat]] -> [[nat -> [nat -> nat]] -> bool]]

  gcd_aux, gcd_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  equal_leibniz_assumption: bool =
    FORALL (x, y: [nat -> [nat -> nat]]):
      connectives_equal(x)(y) IMPLIES
        (FORALL (P: [[nat -> [nat -> nat]] -> bool]):
          P(x) IMPLIES P(y))

  filter_nat_type_O_assumption: bool =
    FORALL (return_function: [nat -> [nat -> [nat -> nat]]]):
      connectives_equal(filter_nat_type(return_function)(0))(
        return_function(0))

  filter_nat_type_S_assumption: bool =
    FORALL (return_function: [nat -> [nat -> [nat -> nat]]]), (n: nat):
      connectives_equal(filter_nat_type(return_function)(n + 1))(
        return_function(n + 1))

  axiom_gcd_aux_statement: bool =
    (equal_leibniz_assumption
      AND filter_nat_type_O_assumption
      AND filter_nat_type_S_assumption)
    IMPLIES
      (FORALL (p: nat):
        connectives_equal(gcd_aux(p))(filter_nat_type(gcd_aux_body)(p)))
END gcd_axiom_gcd_aux
