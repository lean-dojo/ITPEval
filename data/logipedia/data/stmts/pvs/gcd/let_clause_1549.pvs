% Statement-only formalization of the Logipedia corpus artifact
% gcd.let_clause_1549 (catalog title "gcd.let_clause_1549"): for natural m
% and positive n, if m is zero then every natural number equals its truncated
% difference by m. This file contains no proof.

gcd_let_clause_1549: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  let_clause_1549_statement: bool =
    FORALL (m, n: nat):
      0 < n IMPLIES
        (m = 0 IMPLIES
          (FORALL (x1106: nat):
            x1106 = nat_subtract(x1106, m)))

END gcd_let_clause_1549
