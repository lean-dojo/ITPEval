% Statement-only formalization of Logipedia corpus artifact
% gcd.eq_gcd_aux (catalog title "gcd.eq_gcd_aux"): for every natural recursion
% index, the auxiliary greatest-common-divisor function is Leibniz-equal, as a
% binary natural-number function, to the natural-type filter of its body at
% that index. This file contains no proof.

gcd_eq_gcd_aux: THEORY
BEGIN
  gcd_aux, gcd_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  eq_gcd_aux_statement: bool =
    FORALL (p: nat):
      leibniz(gcd_aux(p))(filter_nat_type(gcd_aux_body)(p))
END gcd_eq_gcd_aux
