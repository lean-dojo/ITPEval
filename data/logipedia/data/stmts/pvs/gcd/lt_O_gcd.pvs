% Statement-only formalization of the Logipedia corpus artifact
% gcd.lt_O_gcd (catalog title "gcd.lt_O_gcd"): if the second natural
% number is positive, then the source natural-number gcd is positive.
% This file contains no proof.

gcd_lt_O_gcd: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  dividesb(divisor, value: nat): bool =
    source_mod(value, divisor) = 0

  gcd_aux(p, m, n: nat): RECURSIVE nat =
    IF p = 0 THEN
      m
    ELSIF dividesb(n, m) THEN
      n
    ELSE
      gcd_aux(p - 1, n, source_mod(m, n))
    ENDIF
  MEASURE p

  source_gcd(n, m: nat): nat =
    IF n <= m THEN
      gcd_aux(n, m, n)
    ELSE
      gcd_aux(m, n, m)
    ENDIF

  lt_O_gcd_statement: bool =
    FORALL (m, n: nat):
      0 < n IMPLIES
        0 < source_gcd(m, n)

END gcd_lt_O_gcd
