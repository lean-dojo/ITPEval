% Statement-only formalization of Logipedia corpus artifact
% gcd.sym_eq_gcd_aux (catalog title "gcd.sym_eq_gcd_aux"): for every natural
% recursion index, the natural-type filter of the auxiliary greatest-common-
% divisor body is Leibniz-equal, as a binary natural-number function, to the
% auxiliary greatest-common-divisor function at that index. This file contains
% no proof.

gcd_sym_eq_gcd_aux: THEORY
BEGIN
  gcd_aux, gcd_aux_body: [nat -> [nat -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [nat -> [nat -> nat]]] ->
    [nat -> [nat -> [nat -> nat]]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  sym_eq_gcd_aux_statement: bool =
    FORALL (p: nat):
      leibniz(filter_nat_type(gcd_aux_body)(p))(gcd_aux(p))
END gcd_sym_eq_gcd_aux
