% Statement-only formalization of Logipedia corpus artifact
% gcd.sym_eq_gcd_aux_body_O (catalog title "gcd.sym_eq_gcd_aux_body_O"): at
% natural-number index zero, the curried binary function returning its first
% natural argument is Leibniz-equal to the auxiliary gcd body. This file
% contains no proof.

gcd_sym_eq_gcd_aux_body_O: THEORY
BEGIN
  gcd_aux_body: [nat -> [nat -> [nat -> nat]]]
  binary_nat_function: TYPE = [nat -> [nat -> nat]]

  leibniz(x: binary_nat_function)(y: binary_nat_function): bool =
    FORALL (P: [binary_nat_function -> bool]): P(x) IMPLIES P(y)

  sym_eq_gcd_aux_body_O_statement: bool =
    leibniz
      (LAMBDA (m: nat): (LAMBDA (n: nat): m))
      (gcd_aux_body(0))
END gcd_sym_eq_gcd_aux_body_O
