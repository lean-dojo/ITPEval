% Statement-only formalization of the Logipedia artifact cong.mod_times,
% catalog title "cong.mod_times": modulo a positive natural modulus, the
% remainder of a product equals the remainder of the product of the factors'
% remainders. This file contains no proof.

mod_times: THEORY
BEGIN

  mod_times_statement: bool =
    FORALL (n, m, p: nat):
      0 < p IMPLIES
        mod(n * m, p) = mod(mod(n, p) * mod(m, p), p)

END mod_times
