% Statement-only formalization of the Logipedia artifact
% cong.divides_to_congruent, catalog title "cong.divides_to_congruent":
% divisibility of a truncated natural-number difference by a positive modulus,
% with the smaller term first, implies congruence modulo that modulus.
% This file contains no proof.

divides_to_congruent: THEORY
BEGIN

  source_mod(n, p: nat): nat =
    epsilon(
      LAMBDA (r: nat):
        (p = 0 AND r = n)
          OR (0 < p AND r < p
            AND EXISTS (q: nat): n = q * p + r))

  congruent(n, m, p: nat): bool =
    source_mod(n, p) = source_mod(m, p)

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  divides_to_congruent_statement: bool =
    FORALL (n, m, p: nat):
      0 < p IMPLIES
        (m <= n IMPLIES
          (nat_divides(p, nat_subtract(n, m)) IMPLIES
            congruent(n, m, p)))

END divides_to_congruent
