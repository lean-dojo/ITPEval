% Statement-only formalization of the Logipedia artifact cong.congruent_times,
% catalog title "cong.congruent_times": congruence modulo a positive natural
% modulus is preserved by multiplication. This file contains no proof.

congruent_times: THEORY
BEGIN

  source_mod(n, p: nat): nat =
    epsilon(
      LAMBDA (r: nat):
        (p = 0 AND r = n)
          OR (0 < p AND r < p
            AND EXISTS (q: nat): n = q * p + r))

  congruent(n, m, p: nat): bool =
    source_mod(n, p) = source_mod(m, p)

  congruent_times_statement: bool =
    FORALL (n, m, n1, m1, p: nat):
      0 < p IMPLIES
        (congruent(n, n1, p) IMPLIES
          (congruent(m, m1, p) IMPLIES
            congruent(n * m, n1 * m1, p)))

END congruent_times
