% Statement-only formalization of the Logipedia artifact cong.let_clause_73,
% catalog title "cong.let_clause_73": under the stated positive-parameter
% assumption, swapping the first two natural-number summands preserves their
% nested sum. This file contains no proof.

let_clause_73: THEORY
BEGIN

  let_clause_73_statement: bool =
    FORALL (n, m, p: nat):
      0 < p IMPLIES
        FORALL (x134, x135, x136: nat):
          x134 + (x135 + x136) = x135 + (x134 + x136)

END let_clause_73
