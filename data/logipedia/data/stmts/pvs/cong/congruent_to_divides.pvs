% Statement-only formalization of the Logipedia artifact
% cong.congruent_to_divides, catalog title "cong.congruent_to_divides":
% congruence modulo a positive natural modulus implies that the modulus
% divides the truncated natural-number difference. This file contains no proof.

congruent_to_divides: THEORY
BEGIN

  source_mod(n, p: nat): nat =
    epsilon(
      LAMBDA (r: nat):
        (p = 0 AND r = n)
          OR (0 < p AND r < p
            AND EXISTS (q: nat): n = q * p + r))

  congruent(n, m, p: nat): bool =
    source_mod(n, p) = source_mod(m, p)

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  congruent_to_divides_statement: bool =
    FORALL (n, m, p: nat):
      0 < p IMPLIES
        (congruent(n, m, p) IMPLIES
          nat_divides(p, nat_subtract(n, m)))

END congruent_to_divides
