% Statement-only formalization of the Logipedia artifact
% cong.eq_times_plus_to_congruent, catalog title
% "cong.eq_times_plus_to_congruent": a natural number equal to a multiple of
% a positive modulus plus another natural number is congruent to that number
% modulo the modulus. This file contains no proof.

eq_times_plus_to_congruent: THEORY
BEGIN

  source_mod(n, p: nat): nat =
    epsilon(
      LAMBDA (remainder: nat):
        (p = 0 AND remainder = n)
          OR (0 < p AND remainder < p
            AND EXISTS (quotient: nat):
              n = quotient * p + remainder))

  congruent(n, m, p: nat): bool =
    source_mod(n, p) = source_mod(m, p)

  eq_times_plus_to_congruent_statement: bool =
    FORALL (n, m, p, r: nat):
      0 < p IMPLIES
        (n = r * p + m IMPLIES
          congruent(n, m, p))

END eq_times_plus_to_congruent
