% Statement-only formalization of the Logipedia artifact cong.mod_mod,
% catalog title "cong.mod_mod": taking a natural-number remainder modulo a
% positive modulus twice gives the same remainder as taking it once.
% This file contains no proof.

mod_mod: THEORY
BEGIN

  mod_mod_statement: bool =
    FORALL (n, p: nat):
      0 < p IMPLIES mod(n, p) = mod(mod(n, p), p)

END mod_mod
