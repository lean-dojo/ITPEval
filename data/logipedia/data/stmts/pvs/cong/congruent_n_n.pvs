% Statement-only formalization of the Logipedia artifact cong.congruent_n_n,
% catalog title "cong.congruent_n_n": every natural number is congruent to
% itself modulo every natural modulus. This file contains no proof.

congruent_n_n: THEORY
BEGIN

  source_mod(n, p: nat): nat =
    epsilon(
      LAMBDA (r: nat):
        (p = 0 AND r = n)
          OR (0 < p AND r < p
            AND EXISTS (q: nat): n = q * p + r))

  congruent(n, m, p: nat): bool =
    source_mod(n, p) = source_mod(m, p)

  congruent_n_n_statement: bool =
    FORALL (n, p: nat):
      congruent(n, n, p)

END congruent_n_n
