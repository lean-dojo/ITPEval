% Statement-only formalization of the Logipedia artifact cong.transitive_congruent,
% catalog title "cong.transitive_congruent": congruence modulo each natural
% modulus is a transitive relation on natural numbers. This file contains no proof.

transitive_congruent: THEORY
BEGIN

  source_mod(n, p: nat): nat =
    epsilon(
      LAMBDA (r: nat):
        (p = 0 AND r = n)
          OR (0 < p AND r < p
            AND EXISTS (q: nat): n = q * p + r))

  congruent(n, m, p: nat): bool =
    source_mod(n, p) = source_mod(m, p)

  transitive_congruent_statement: bool =
    FORALL (p, x, y, z: nat):
      congruent(x, y, p) IMPLIES
        congruent(y, z, p) IMPLIES
          congruent(x, z, p)

END transitive_congruent
