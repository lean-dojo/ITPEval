% Statement-only formalization of the Logipedia artifact cong.congruent_n_mod_n,
% catalog title "cong.congruent_n_mod_n": every natural number is congruent
% modulo a positive natural modulus to its remainder. This file contains no proof.

congruent_n_mod_n: THEORY
BEGIN

  congruent_n_mod_n_statement: bool =
    FORALL (n, p: nat):
      0 < p IMPLIES mod(n, p) = mod(mod(n, p), p)

END congruent_n_mod_n
