% Statement-only formalization of the Logipedia corpus artifact
% permutation.transpose_i_j_j (catalog title "permutation.transpose_i_j_j"):
% transposing two natural numbers sends the second one to the first. This file
% contains no proof.

permutation_transpose_i_j_j: THEORY
BEGIN

  transpose(i, j: nat): [nat -> nat] =
    LAMBDA (n: nat):
      IF n = i THEN j
      ELSIF n = j THEN i
      ELSE n
      ENDIF

  transpose_i_j_j_statement: bool =
    FORALL (i, j: nat):
      transpose(i, j)(j) = i

END permutation_transpose_i_j_j
