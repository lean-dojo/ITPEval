% Statement-only formalization of the Logipedia corpus artifact
% permutation.injective_transpose (catalog title
% "permutation.injective_transpose"): transposing any two natural numbers
% defines an injective function on the natural numbers. This file contains
% no proof.

permutation_injective_transpose: THEORY
BEGIN

  transpose(i, j: nat): [nat -> nat] =
    LAMBDA (n: nat):
      IF n = i THEN j
      ELSIF n = j THEN i
      ELSE n
      ENDIF

  injective_transpose_statement: bool =
    FORALL (i, j, x, y: nat):
      transpose(i, j)(x) = transpose(i, j)(y) IMPLIES x = y

END permutation_injective_transpose
