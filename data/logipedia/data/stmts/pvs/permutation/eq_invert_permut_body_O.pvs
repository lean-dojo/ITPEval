% Statement-only formalization of Logipedia corpus artifact
% permutation.eq_invert_permut_body_O (catalog title
% "permutation.eq_invert_permut_body_O"): at natural-number index zero, the
% inverse-permutation body is Leibniz-equal to the curried function that returns
% zero after testing whether its second argument equals the first function's
% value at zero. This file contains no proof.

permutation_eq_invert_permut_body_O: THEORY
BEGIN
  invert_permut_body: [nat -> [[nat -> nat] -> [nat -> nat]]]
  inverse_permutation_function: TYPE = [[nat -> nat] -> [nat -> nat]]

  leibniz(x: inverse_permutation_function)
         (y: inverse_permutation_function): bool =
    FORALL (P: [inverse_permutation_function -> bool]):
      P(x) IMPLIES P(y)

  eq_invert_permut_body_O_statement: bool =
    leibniz(invert_permut_body(0))
      (LAMBDA (f: [nat -> nat]):
        (LAMBDA (m: nat):
          IF m = f(0) THEN 0 ELSE 0 ENDIF))
END permutation_eq_invert_permut_body_O
