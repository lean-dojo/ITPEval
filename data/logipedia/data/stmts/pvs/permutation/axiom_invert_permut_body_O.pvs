% Statement-only formalization of Logipedia corpus artifact
% permutation.axiom_invert_permut_body_O (catalog title
% "permutation.axiom_invert_permut_body_O"): the inverse-permutation body at
% natural-number zero is related by the source equality to the function that
% returns zero after testing its input against the function's value at zero.
% This file contains no proof.

permutation_axiom_invert_permut_body_O: THEORY
BEGIN
  invert_permut_body: [nat -> [[nat -> nat] -> [nat -> nat]]]

  match_bool_type(case_true, case_false: nat)(b: bool): nat =
    IF b THEN case_true ELSE case_false ENDIF

  nat_eqb(left, right: nat): bool =
    left = right

  axiom_invert_permut_body_O_statement: FORMULA
    invert_permut_body(0) =
      (LAMBDA (f: [nat -> nat]):
        (LAMBDA (m: nat):
          match_bool_type(0, 0)(nat_eqb(m, f(0)))))

END permutation_axiom_invert_permut_body_O
