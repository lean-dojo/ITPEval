% Statement-only formalization of the Logipedia corpus artifact
% permutation.transpose_transpose, catalog title
% "permutation.transpose_transpose": applying the same transposition of two
% natural numbers twice returns every natural number unchanged. This file
% contains no proof.

transpose_transpose: THEORY
BEGIN

  transpose(i, j, n: nat): nat =
    IF n = i THEN
      j
    ELSIF n = j THEN
      i
    ELSE
      n
    ENDIF

  transpose_transpose_statement: bool =
    FORALL (i, j, n: nat):
      transpose(i, j, transpose(i, j, n)) = n

END transpose_transpose
