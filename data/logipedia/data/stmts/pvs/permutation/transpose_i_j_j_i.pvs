% Statement-only formalization of the Logipedia corpus artifact
% permutation.transpose_i_j_j_i (catalog title
% "permutation.transpose_i_j_j_i"): swapping the two natural-number endpoints
% of a transposition does not change its value at any natural number. This file
% contains no proof.

permutation_transpose_i_j_j_i: THEORY
BEGIN

  transpose(i, j: nat): [nat -> nat] =
    LAMBDA (n: nat):
      IF n = i THEN j
      ELSIF n = j THEN i
      ELSE n
      ENDIF

  transpose_i_j_j_i_statement: bool =
    FORALL (i, j, n: nat):
      transpose(i, j)(n) = transpose(j, i)(n)

END permutation_transpose_i_j_j_i
