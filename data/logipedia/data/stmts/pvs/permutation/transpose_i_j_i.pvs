% Statement-only formalization of the Logipedia corpus artifact
% permutation.transpose_i_j_i (catalog title "permutation.transpose_i_j_i"):
% transposing two natural numbers sends the first one to the second. This file
% contains no proof.

permutation_transpose_i_j_i: THEORY
BEGIN

  transpose(i, j: nat): [nat -> nat] =
    LAMBDA (n: nat):
      IF n = i THEN j
      ELSIF n = j THEN i
      ELSE n
      ENDIF

  transpose_i_j_i_statement: bool =
    FORALL (i, j: nat):
      transpose(i, j)(i) = j

END permutation_transpose_i_j_i
