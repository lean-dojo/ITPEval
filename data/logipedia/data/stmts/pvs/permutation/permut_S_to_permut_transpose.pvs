% Statement-only formalization of the Logipedia corpus artifact
% permutation.permut_S_to_permut_transpose, catalog title
% "permutation.permut_S_to_permut_transpose": a permutation of the natural
% prefix through m + 1 remains a permutation through m after its values are
% transposed with the value at m + 1. This file contains no proof.

permutation_permut_S_to_permut_transpose: THEORY
BEGIN

  injn(f: [nat -> nat], upper: nat): bool =
    FORALL (i, j: nat):
      i <= upper IMPLIES
        (j <= upper IMPLIES
          (f(i) = f(j) IMPLIES i = j))

  permut(f: [nat -> nat], upper: nat): bool =
    (FORALL (i: nat):
      i <= upper IMPLIES f(i) <= upper)
    AND injn(f, upper)

  transpose(i, j: nat): [nat -> nat] =
    LAMBDA (n: nat):
      IF n = i THEN j
      ELSIF n = j THEN i
      ELSE n
      ENDIF

  permut_S_to_permut_transpose_statement: bool =
    FORALL (f: [nat -> nat]):
      FORALL (m: nat):
        permut(f, m + 1) IMPLIES
          permut(
            LAMBDA (n: nat):
              transpose(f(m + 1), m + 1)(f(n)),
            m)

END permutation_permut_S_to_permut_transpose
