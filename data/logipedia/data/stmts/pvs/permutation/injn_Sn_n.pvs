% Statement-only formalization of the Logipedia corpus artifact
% permutation.injn_Sn_n, catalog title "permutation.injn_Sn_n": injectivity
% on the natural prefix through n + 1 implies injectivity on the prefix
% through n. This file contains no proof.

permutation_injn_Sn_n: THEORY
BEGIN

  injn(f: [nat -> nat], n: nat): bool =
    FORALL (i, j: nat):
      i <= n IMPLIES
        (j <= n IMPLIES
          (f(i) = f(j) IMPLIES i = j))

  injn_Sn_n_statement: bool =
    FORALL (f: [nat -> nat], n: nat):
      injn(f, n + 1) IMPLIES injn(f, n)

END permutation_injn_Sn_n
