% Statement-only formalization of the Logipedia corpus artifact
% permutation.eq_to_bijn, catalog title "permutation.eq_to_bijn": bounded
% surjectivity on a natural-number prefix transfers between functions that
% agree at every input in that prefix. This file contains no proof.

permutation_eq_to_bijn: THEORY
BEGIN

  bijn(f: [nat -> nat], n: nat): bool =
    FORALL (m: nat):
      m <= n IMPLIES
        EXISTS (p: nat):
          p <= n AND f(p) = m

  eq_to_bijn_statement: bool =
    FORALL (f, g: [nat -> nat]):
      FORALL (n: nat):
        (FORALL (i: nat):
          i <= n IMPLIES f(i) = g(i))
        IMPLIES
          (bijn(f, n) IMPLIES bijn(g, n))

END permutation_eq_to_bijn
