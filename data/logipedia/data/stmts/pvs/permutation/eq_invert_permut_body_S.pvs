% Statement-only formalization of Logipedia corpus artifact
% permutation.eq_invert_permut_body_S (catalog title
% "permutation.eq_invert_permut_body_S"): at every successor natural index,
% the inverse-permutation body is Leibniz-equal to the curried function that
% returns that successor when the input matches the function's value there,
% and otherwise returns the preceding inverse-permutation result. This file
% contains no proof.

permutation_eq_invert_permut_body_S: THEORY
BEGIN
  invert_permut, invert_permut_body: [nat -> [[nat -> nat] -> [nat -> nat]]]
  inverse_permutation_function: TYPE =
    [[nat -> nat] -> [nat -> nat]]

  leibniz(x: inverse_permutation_function)
         (y: inverse_permutation_function): bool =
    FORALL (P: [inverse_permutation_function -> bool]):
      P(x) IMPLIES P(y)

  eq_invert_permut_body_S_statement: bool =
    FORALL (n: nat):
      leibniz(invert_permut_body(n + 1))
        (LAMBDA (f: [nat -> nat]):
          (LAMBDA (m: nat):
            IF m = f(n + 1)
            THEN n + 1
            ELSE invert_permut(n)(f)(m)
            ENDIF))
END permutation_eq_invert_permut_body_S
