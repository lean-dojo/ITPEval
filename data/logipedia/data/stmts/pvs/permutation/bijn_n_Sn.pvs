% Statement-only formalization of the Logipedia corpus artifact
% permutation.bijn_n_Sn, catalog title "permutation.bijn_n_Sn": a function
% surjective on the natural prefix through n remains prefix-surjective through
% n + 1 when it fixes n + 1. This file contains no proof.

permutation_bijn_n_Sn: THEORY
BEGIN

  bijn(f: [nat -> nat], n: nat): bool =
    FORALL (m: nat):
      m <= n IMPLIES
        (EXISTS (p: nat):
          p <= n AND f(p) = m)

  bijn_n_Sn_statement: bool =
    FORALL (f: [nat -> nat], n: nat):
      bijn(f, n) IMPLIES
        (f(n + 1) = n + 1 IMPLIES
          bijn(f, n + 1))

END permutation_bijn_n_Sn
