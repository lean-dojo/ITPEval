% Statement-only formalization of Logipedia corpus artifact
% permutation.axiom_invert_permut (catalog title
% "permutation.axiom_invert_permut"): at every natural index, the inverse
% permutation operator is related by the source equality to the natural-type
% filter of its defining body. This file contains no proof.

permutation_axiom_invert_permut: THEORY
BEGIN
  connectives_equal:
    [[[nat -> nat] -> [nat -> nat]] ->
    [[[nat -> nat] -> [nat -> nat]] -> bool]]

  invert_permut, invert_permut_body: [nat -> [[nat -> nat] -> [nat -> nat]]]

  filter_nat_type:
    [[nat -> [[nat -> nat] -> [nat -> nat]]] ->
    [nat -> [[nat -> nat] -> [nat -> nat]]]]

  axiom_invert_permut_statement: bool =
    FORALL (n: nat):
      connectives_equal(invert_permut(n))(
        filter_nat_type(invert_permut_body)(n))

END permutation_axiom_invert_permut
