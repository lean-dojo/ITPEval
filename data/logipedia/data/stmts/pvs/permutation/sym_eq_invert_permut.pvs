% Statement-only formalization of the Logipedia corpus artifact
% permutation.sym_eq_invert_permut (catalog title
% "permutation.sym_eq_invert_permut"): at every source natural index, the
% natural-type filter of the inverse-permutation defining body is
% Leibniz-equal to the inverse-permutation function. This file contains no
% proof.

permutation_sym_eq_invert_permut: THEORY
BEGIN
  invert_permut, invert_permut_body:
    [nat ->
    [[nat -> nat] -> [nat -> nat]]]

  filter_nat_type:
    [[nat ->
    [[nat -> nat] -> [nat -> nat]]] ->
    [nat ->
    [[nat -> nat] -> [nat -> nat]]]]
  inverse_function: TYPE =
    [[nat -> nat] -> [nat -> nat]]

  leibniz(x: inverse_function)(y: inverse_function): bool =
    FORALL (P: [inverse_function -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_invert_permut_statement: bool =
    FORALL (n: nat):
      leibniz(filter_nat_type(invert_permut_body)(n))
        (invert_permut(n))
END permutation_sym_eq_invert_permut
