% Statement-only formalization of the Logipedia corpus artifact
% permutation.let_clause_1063 (catalog title "permutation.let_clause_1063"):
% equality of two bounded preimages transfers the second image value to the
% first under the stated bounded-permutation hypotheses. This file contains
% no proof.

permutation_let_clause_1063: THEORY
BEGIN

  injn(f: [nat -> nat], n: nat): bool =
    FORALL (i, j: nat):
      i <= n IMPLIES
        (j <= n IMPLIES
          (f(i) = f(j) IMPLIES i = j))

  permut(f: [nat -> nat], n: nat): bool =
    (FORALL (i: nat):
      i <= n IMPLIES f(i) <= n)
    AND injn(f, n)

  let_clause_1063_statement: bool =
    FORALL (f: [nat -> nat]):
      FORALL (n: nat):
        permut(f, n) IMPLIES
          FORALL (i, j: nat):
            i <= n IMPLIES
              (j <= n IMPLIES
                FORALL (a: nat):
                  (a <= n AND f(a) = i) IMPLIES
                    (a <= n IMPLIES
                      (f(a) = i IMPLIES
                        FORALL (b: nat):
                          (b <= n AND f(b) = j) IMPLIES
                            (b <= n IMPLIES
                              (f(b) = j IMPLIES
                                ((FORALL (i0: nat):
                                  i0 <= n IMPLIES f(i0) <= n)
                                IMPLIES
                                  (injn(f, n) IMPLIES
                                    (a = b IMPLIES f(a) = j))))))))

END permutation_let_clause_1063
