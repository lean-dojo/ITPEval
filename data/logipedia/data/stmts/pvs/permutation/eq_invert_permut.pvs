% Statement-only formalization of the Logipedia corpus artifact
% permutation.eq_invert_permut (catalog title
% "permutation.eq_invert_permut"): at every source natural index, the
% inverse-permutation function is Leibniz-equal to the natural-type filter
% of its defining body at that index. This file contains no proof.

permutation_eq_invert_permut: THEORY
BEGIN
  invert_permut, invert_permut_body:
    [nat ->
    [[nat -> nat] -> [nat -> nat]]]

  filter_nat_type:
    [[nat ->
    [[nat -> nat] -> [nat -> nat]]] ->
    [nat ->
    [[nat -> nat] -> [nat -> nat]]]]
  inverse_function: TYPE =
    [[nat -> nat] -> [nat -> nat]]

  leibniz(x: inverse_function)(y: inverse_function): bool =
    FORALL (P: [inverse_function -> bool]):
      P(x) IMPLIES P(y)

  eq_invert_permut_statement: bool =
    FORALL (n: nat):
      leibniz(invert_permut(n))
        (filter_nat_type(invert_permut_body)(n))
END permutation_eq_invert_permut
