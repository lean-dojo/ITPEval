% Statement-only formalization of the Logipedia corpus artifact
% permutation.invert_permut_f (catalog title
% "permutation.invert_permut_f"): a bounded-injective natural-number
% function's recursively computed permutation inverse returns each index
% m at most n when applied to f(m). This file contains no proof.

permutation_invert_permut_f: THEORY
BEGIN

  injn(f: [nat -> nat], n: nat): bool =
    FORALL (i, j: nat):
      i <= n IMPLIES
        (j <= n IMPLIES
          (f(i) = f(j) IMPLIES i = j))

  invert_permut(
      n: nat,
      f: [nat -> nat],
      m: nat): RECURSIVE nat =
    IF n = 0 THEN
      0
    ELSIF m = f(n) THEN
      n
    ELSE
      invert_permut(n - 1, f, m)
    ENDIF
  MEASURE n

  invert_permut_f_statement: bool =
    FORALL (f: [nat -> nat]):
      FORALL (n, m: nat):
        m <= n IMPLIES
          (injn(f, n) IMPLIES
            invert_permut(n, f, f(m)) = m)

END permutation_invert_permut_f
