% Statement-only formalization of the Logipedia corpus artifact
% permutation.axiom_invert_permut_body_S (catalog title
% "permutation.axiom_invert_permut_body_S"): at every successor natural
% index, the inverse-permutation body is related by the source equality to
% the function selecting that successor or the preceding inverse-permutation
% result according to the source equality test. This file contains no proof.

permutation_axiom_invert_permut_body_S: THEORY
BEGIN
  connectives_equal:
    [[[nat -> nat] -> [nat -> nat]] ->
    [[[nat -> nat] -> [nat -> nat]] -> bool]]

  invert_permut, invert_permut_body: [nat -> [[nat -> nat] -> [nat -> nat]]]

  match_bool_type: [nat -> [nat -> [bool -> nat]]]

  nat_eqb: [nat -> [nat -> bool]]

  axiom_invert_permut_body_S_statement: bool =
    FORALL (n: nat):
      connectives_equal(invert_permut_body(n + 1))
        (LAMBDA (f: [nat -> nat]):
          (LAMBDA (m: nat):
            match_bool_type(n + 1)
              (invert_permut(n)(f)(m))
              (nat_eqb(m)(f(n + 1)))))

END permutation_axiom_invert_permut_body_S
