% Statement-only formalization of Logipedia corpus artifact
% permutation.sym_eq_invert_permut_body_O (catalog title
% "permutation.sym_eq_invert_permut_body_O"): at natural-number index zero,
% the curried function that returns zero after testing whether its second
% argument equals the first function's value at zero is Leibniz-equal to the
% inverse-permutation body. This file contains no proof.

permutation_sym_eq_invert_permut_body_O: THEORY
BEGIN
  invert_permut_body: [nat -> [[nat -> nat] -> [nat -> nat]]]
  inverse_permutation_function: TYPE = [[nat -> nat] -> [nat -> nat]]

  leibniz(x: inverse_permutation_function)
         (y: inverse_permutation_function): bool =
    FORALL (P: [inverse_permutation_function -> bool]):
      P(x) IMPLIES P(y)

  sym_eq_invert_permut_body_O_statement: bool =
    leibniz
      (LAMBDA (f: [nat -> nat]):
        (LAMBDA (m: nat):
          IF m = f(0) THEN 0 ELSE 0 ENDIF))
      (invert_permut_body(0))
END permutation_sym_eq_invert_permut_body_O
