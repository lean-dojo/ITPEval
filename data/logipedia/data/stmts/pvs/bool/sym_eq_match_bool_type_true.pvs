% Statement-only formalization of Logipedia corpus artifact bool.sym_eq_match_bool_type_true
% (catalog title "bool.sym_eq_match_bool_type_true"): the supplied true case is
% Leibniz-equal to the result of Boolean IF-elimination at true for every nonempty return type.
% This file contains no proof.

bool_sym_eq_match_bool_type_true[
  return_type: TYPE+
]: THEORY
BEGIN
  match_bool_type(case_true, case_false: return_type)(z: bool): return_type =
    IF z THEN case_true ELSE case_false ENDIF

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  sym_eq_match_bool_type_true: bool =
    FORALL (case_true, case_false: return_type):
      leibniz(
        case_true,
        match_bool_type(case_true, case_false)(TRUE))
END bool_sym_eq_match_bool_type_true
