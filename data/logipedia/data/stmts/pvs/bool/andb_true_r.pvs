% Statement-only formalization of Logipedia artifact bool.andb_true_r:
% if a Boolean conjunction is true, then its right operand is true.
% This file contains no proof.

bool_andb_true_r: THEORY
BEGIN
  andb(b1, b2: bool): bool = b1 AND b2

  andb_true_r: bool =
    FORALL (b1, b2: bool):
      andb(b1, b2) = TRUE IMPLIES b2 = TRUE
END bool_andb_true_r
