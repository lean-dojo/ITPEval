% Statement-only formalization of Logipedia artifact bool.bool_discr:
% equality of two Boolean values selects the corresponding reflexive branch
% of the nested Boolean eliminator. This file contains no proof.

bool_bool_discr: THEORY
BEGIN
  match_bool_type(case_true: bool)(case_false: bool)(z: bool): bool =
    IF z THEN case_true ELSE case_false ENDIF

  bool_discr: bool =
    FORALL (x, y: bool):
      x = y IMPLIES
        match_bool_type(
          match_bool_type(
            (FORALL (P: bool): P IMPLIES P))(
            (FORALL (P: bool): P))(y))(
          match_bool_type(
            (FORALL (P: bool): P))(
            (FORALL (P: bool): P IMPLIES P))(y))(x)
END bool_bool_discr
