% Statement-only formalization of Logipedia corpus artifact bool.not_eq_true_false
% (catalog title "bool.not_eq_true_false"): Boolean true and false are unequal.
% This file contains no proof.

bool_not_eq_true_false: THEORY
BEGIN
  not_eq_true_false: bool = TRUE /= FALSE

  not_eq_true_false_holds: TYPE+ =
    {value: bool | not_eq_true_false}
END bool_not_eq_true_false
