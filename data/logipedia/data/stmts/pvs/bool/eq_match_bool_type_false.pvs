% Statement-only formalization of Logipedia corpus artifact bool.eq_match_bool_type_false
% (catalog title "bool.eq_match_bool_type_false"): matching the Boolean false
% branch is Leibniz-equal to the supplied false case for every nonempty return type.
% This file contains no proof.

bool_eq_match_bool_type_false[
  return_type: TYPE+
]: THEORY
BEGIN
  match_bool_type: [return_type -> [return_type -> [bool -> return_type]]]
  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  eq_match_bool_type_false: bool =
    FORALL (case_true, case_false: return_type):
      leibniz(
        match_bool_type(case_true)(case_false)(FALSE),
        case_false)
END bool_eq_match_bool_type_false
