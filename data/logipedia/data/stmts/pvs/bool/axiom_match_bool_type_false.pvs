% Statement-only formalization of Logipedia artifact bool.axiom_match_bool_type_false:
% matching a Boolean false value is related by the source equality relation
% to the supplied false branch.
% This file contains no proof.

bool_axiom_match_bool_type_false[
  return_type: TYPE+
]: THEORY
BEGIN
  connectives_equal: [return_type -> [return_type -> bool]]

  match_bool_type: [return_type -> [return_type -> [bool -> return_type]]]

  axiom_match_bool_type_false: bool =
    FORALL (case_true, case_false: return_type):
      connectives_equal(
        match_bool_type(case_true)(case_false)(FALSE))(case_false)
END bool_axiom_match_bool_type_false
