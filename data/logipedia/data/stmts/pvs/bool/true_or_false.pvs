% Statement-only formalization of Logipedia corpus artifact bool.true_or_false
% (catalog title "bool.true_or_false"): every Boolean value is either true or false.
% This file contains no proof.

bool_true_or_false: THEORY
BEGIN
  true_or_false: FORMULA
    FORALL (b: bool):
      b = TRUE OR b = FALSE
END bool_true_or_false
