% Statement-only formalization of Logipedia artifact bool.andb_true_l:
% if a Boolean conjunction is true, then its left operand is true.
% This file contains no proof.

bool_andb_true_l: THEORY
BEGIN
  andb(b1, b2: bool): bool = b1 AND b2

  andb_true_l: bool =
    FORALL (b1, b2: bool):
      andb(b1, b2) = TRUE IMPLIES b1 = TRUE
END bool_andb_true_l
