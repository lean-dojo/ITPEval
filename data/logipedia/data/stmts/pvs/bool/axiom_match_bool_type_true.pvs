% Statement-only formalization of Logipedia artifact bool.axiom_match_bool_type_true:
% matching a Boolean true value is related by the source equality relation
% to the supplied true branch.
% This file contains no proof.

bool_axiom_match_bool_type_true[
  return_type: TYPE+
]: THEORY
BEGIN
  connectives_equal: [return_type -> [return_type -> bool]]

  match_bool_type: [return_type -> [return_type -> [bool -> return_type]]]
  axiom_match_bool_type_true: bool =
    FORALL (case_true, case_false: return_type):
      connectives_equal(
        match_bool_type(case_true)(case_false)(TRUE))(case_true)
END bool_axiom_match_bool_type_true
