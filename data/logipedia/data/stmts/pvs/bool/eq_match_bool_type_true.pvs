% Statement-only formalization of Logipedia corpus artifact bool.eq_match_bool_type_true
% (catalog title "bool.eq_match_bool_type_true"): matching PVS Boolean TRUE by
% IF-elimination is Leibniz-equal to the supplied true case for every nonempty return type.
% This file contains no proof.

bool_eq_match_bool_type_true[
  return_type: TYPE+
]: THEORY
BEGIN
  match_bool_type(case_true, case_false: return_type)(z: bool): return_type =
    IF z THEN case_true ELSE case_false ENDIF

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  eq_match_bool_type_true: bool =
    FORALL (case_true, case_false: return_type):
      leibniz(
        match_bool_type(case_true, case_false)(TRUE),
        case_true)
END bool_eq_match_bool_type_true
