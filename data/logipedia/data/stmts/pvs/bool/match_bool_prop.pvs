% Statement-only formalization of Logipedia corpus artifact bool.match_bool_prop
% (catalog title "bool.match_bool_prop"): every predicate on the source Boolean
% type that holds at the designated true and false values holds at every value.
% This file contains no proof.

bool_match_bool_prop: THEORY
BEGIN
  match_bool_prop: bool =
    FORALL (return_predicate: [bool -> bool]):
      return_predicate(TRUE) IMPLIES
        (return_predicate(FALSE) IMPLIES
          (FORALL (z: bool): return_predicate(z)))
END bool_match_bool_prop
