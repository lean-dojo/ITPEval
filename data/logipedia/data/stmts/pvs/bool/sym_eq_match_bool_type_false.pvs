% Statement-only formalization of Logipedia corpus artifact bool.sym_eq_match_bool_type_false
% (catalog title "bool.sym_eq_match_bool_type_false"): the supplied false case is
% Leibniz-equal to the result of Boolean IF-elimination at false for every nonempty return type.
% This file contains no proof.

bool_sym_eq_match_bool_type_false[
  return_type: TYPE+
]: THEORY
BEGIN
  match_bool_type(case_true, case_false: return_type)(z: bool): return_type =
    IF z THEN case_true ELSE case_false ENDIF

  leibniz(x, y: return_type): bool =
    FORALL (P: [return_type -> bool]): P(x) IMPLIES P(y)

  sym_eq_match_bool_type_false: bool =
    FORALL (case_true, case_false: return_type):
      leibniz(
        case_false,
        match_bool_type(case_true, case_false)(FALSE))
END bool_sym_eq_match_bool_type_false
