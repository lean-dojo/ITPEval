% Statement-only formalization of the Logipedia corpus artifact
% primes.mod_O_to_divides (catalog title "primes.mod_O_to_divides"): a
% natural number with zero remainder modulo a positive natural divisor is
% divisible by that divisor. This file contains no proof.

primes_mod_O_to_divides: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  mod_O_to_divides_statement: bool =
    FORALL (n, m: nat):
      0 < n IMPLIES
        source_mod(m, n) = 0 IMPLIES nat_divides(n, m)

END primes_mod_O_to_divides
