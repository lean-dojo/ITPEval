% Statement-only formalization of the Logipedia corpus artifact
% primes.divides_to_mod_O (catalog title "primes.divides_to_mod_O"): a
% positive natural divisor of a natural number gives zero as that number's
% remainder modulo the divisor. This file contains no proof.

primes_divides_to_mod_O: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  divides_to_mod_O_statement: bool =
    FORALL (n, m: nat):
      0 < n IMPLIES
        nat_divides(n, m) IMPLIES source_mod(m, n) = 0

END primes_divides_to_mod_O
