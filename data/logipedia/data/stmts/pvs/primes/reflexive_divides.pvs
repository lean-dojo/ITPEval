% Statement-only formalization of the Logipedia corpus artifact
% primes.reflexive_divides, catalog title "primes.reflexive_divides":
% natural-number divisibility is a reflexive relation. This file contains no
% proof.

primes_reflexive_divides: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  reflexive_divides_statement: bool =
    FORALL (n: nat):
      nat_divides(n, n)

END primes_reflexive_divides
