% Statement-only formalization of the Logipedia corpus artifact
% primes.not_divides_to_dividesb_false (catalog title
% "primes.not_divides_to_dividesb_false"): for natural numbers n and m,
% positivity of n and failure of n to divide m imply that the Boolean
% divisibility test is false. This file contains no proof.

primes_not_divides_to_dividesb_false: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  dividesb(divisor, value: nat): bool =
    source_mod(value, divisor) = 0

  not_divides_to_dividesb_false_statement: bool =
    FORALL (n, m: nat):
      0 < n IMPLIES
        NOT nat_divides(n, m) IMPLIES dividesb(n, m) = FALSE

END primes_not_divides_to_dividesb_false
