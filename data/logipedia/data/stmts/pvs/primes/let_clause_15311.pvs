% Statement-only formalization of the Logipedia corpus artifact
% primes.let_clause_15311 (catalog title "primes.let_clause_15311"):
% a natural multiple with successor quotient equals the divisor plus the
% multiple with the predecessor quotient. This file contains no proof.

primes_let_clause_15311: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  let_clause_15311_statement: bool =
    FORALL (n, m: nat):
      0 < m IMPLIES
        nat_divides(n, m) IMPLIES
          FORALL (d, p: nat):
            m = n * (p + 1) IMPLIES
              m = n + n * p

END primes_let_clause_15311
