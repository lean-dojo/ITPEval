% Statement-only formalization of the Logipedia corpus artifact
% primes.eq_mod_to_divides, catalog title "primes.eq_mod_to_divides":
% equality of two natural-number remainders modulo a positive natural q
% implies that q divides their truncated natural difference. This file
% contains no proof.

primes_eq_mod_to_divides: THEORY
BEGIN

  source_mod(n, q: nat): nat =
    epsilon(
      LAMBDA (remainder: nat):
        (q = 0 AND remainder = n)
          OR (0 < q AND remainder < q
            AND EXISTS (quotient: nat):
              n = quotient * q + remainder))

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  eq_mod_to_divides_statement: bool =
    FORALL (n, m, q: nat):
      0 < q IMPLIES
        (source_mod(n, q) = source_mod(m, q) IMPLIES
          nat_divides(q, nat_subtract(n, m)))

END primes_eq_mod_to_divides
