% Statement-only formalization of the Logipedia corpus artifact
% primes.divides_n_n, catalog title "primes.divides_n_n": every natural
% number divides itself. This file contains no proof.

primes_divides_n_n: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  divides_n_n_statement: bool =
    FORALL (n: nat):
      nat_divides(n, n)

END primes_divides_n_n
