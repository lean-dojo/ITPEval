% Statement-only formalization of the Logipedia corpus artifact
% primes.prime_to_lt_SO (catalog title "primes.prime_to_lt_SO"): every natural
% number satisfying the source prime predicate is strictly greater than one.
% This file contains no proof.

primes_prime_to_lt_SO: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  prime_nat(value: nat): bool =
    1 < value
      AND (FORALL (divisor: nat):
        nat_divides(divisor, value) IMPLIES
          (1 < divisor IMPLIES divisor = value))

  prime_to_lt_SO_statement: bool =
    FORALL (p: nat):
      prime_nat(p) IMPLIES 1 < p

END primes_prime_to_lt_SO
