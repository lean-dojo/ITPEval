% Statement-only formalization of the Logipedia corpus artifact
% primes.divides_n_O (catalog title "primes.divides_n_O"): every natural
% number divides zero. This file contains no proof.

primes_divides_n_O: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  divides_n_O_statement: bool =
    FORALL (n: nat):
      nat_divides(n, 0)

END primes_divides_n_O
