% Statement-only formalization of the Logipedia corpus artifact
% primes.match_divides_prop (catalog title "primes.match_divides_prop"):
% the elimination principle for natural-number divisibility via a
% factorization witness. This file contains no proof.

primes_match_divides_prop: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  match_divides_prop_statement: bool =
    FORALL (n, m: nat), (return_type: bool):
      (FORALL (q: nat):
        m = n * q IMPLIES return_type)
      IMPLIES
        (nat_divides(n, m) IMPLIES return_type)

END primes_match_divides_prop
