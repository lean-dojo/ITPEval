% Statement-only formalization of the Logipedia corpus artifact
% primes.let_clause_1531 (catalog title "primes.let_clause_1531"):
% a positive natural multiple represented with zero as its quotient is zero.
% This file contains no proof.

primes_let_clause_1531: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  let_clause_1531_statement: bool =
    FORALL (n, m: nat):
      0 < m IMPLIES
        nat_divides(n, m) IMPLIES
          FORALL (d: nat):
            m = n * 0 IMPLIES
              m = 0

END primes_let_clause_1531
