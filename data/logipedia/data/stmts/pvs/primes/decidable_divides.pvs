% Statement-only formalization of the Logipedia corpus artifact
% primes.decidable_divides (catalog title "primes.decidable_divides"):
% divisibility is decidable for every pair of natural numbers. This file
% contains no proof.

primes_decidable_divides: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  decidable_divides_statement: bool =
    FORALL (n, m: nat):
      nat_divides(n, m) OR NOT nat_divides(n, m)

END primes_decidable_divides
