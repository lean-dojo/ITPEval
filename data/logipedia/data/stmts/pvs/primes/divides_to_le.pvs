% Statement-only formalization of the Logipedia corpus artifact
% primes.divides_to_le (catalog title "primes.divides_to_le"): a natural
% divisor of a positive natural number is at most that number.
% This file contains no proof.

primes_divides_to_le: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  divides_to_le_statement: bool =
    FORALL (n, m: nat):
      0 < m IMPLIES
        (nat_divides(n, m) IMPLIES n <= m)

END primes_divides_to_le
