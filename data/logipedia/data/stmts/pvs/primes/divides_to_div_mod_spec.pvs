% Statement-only formalization of the Logipedia corpus artifact
% primes.divides_to_div_mod_spec (catalog title
% "primes.divides_to_div_mod_spec"): a positive natural divisor that divides
% a natural number yields the source quotient and zero remainder satisfying
% the division specification. This file contains no proof.

primes_divides_to_div_mod_spec: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  div_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      0
    ELSE
      div_aux(p - 1, nat_subtract(n, m + 1), m) + 1
    ENDIF
  MEASURE p

  source_div(n, m: nat): nat =
    IF m = 0 THEN
      n + 1
    ELSE
      div_aux(n, n, m - 1)
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  div_mod_spec(n, m, q, r: nat): bool =
    r < m AND n = q * m + r

  divides_to_div_mod_spec_statement: bool =
    FORALL (n, m: nat):
      0 < n IMPLIES
        nat_divides(n, m) IMPLIES
          div_mod_spec(m, n, source_div(m, n), 0)

END primes_divides_to_div_mod_spec
