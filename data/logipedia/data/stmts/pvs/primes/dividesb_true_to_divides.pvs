% Statement-only formalization of the Logipedia corpus artifact
% primes.dividesb_true_to_divides (catalog title
% "primes.dividesb_true_to_divides"): for natural numbers n and m, a true
% dividesb(n, m) test implies that n divides m. This file contains no proof.

primes_dividesb_true_to_divides: THEORY
BEGIN

  nat_subtract(minuend, subtrahend: nat): nat =
    IF subtrahend <= minuend THEN
      minuend - subtrahend
    ELSE
      0
    ENDIF

  mod_aux(p, n, m: nat): RECURSIVE nat =
    IF p = 0 OR n <= m THEN
      n
    ELSE
      mod_aux(p - 1, nat_subtract(n, m + 1), m)
    ENDIF
  MEASURE p

  source_mod(n, m: nat): nat =
    IF m = 0 THEN
      n
    ELSE
      mod_aux(n, n, m - 1)
    ENDIF

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  dividesb(divisor, value: nat): bool =
    source_mod(value, divisor) = 0

  dividesb_true_to_divides_statement: bool =
    FORALL (n, m: nat):
      dividesb(n, m) = TRUE IMPLIES nat_divides(n, m)

END primes_dividesb_true_to_divides
