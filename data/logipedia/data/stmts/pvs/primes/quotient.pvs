% Statement-only formalization of the Logipedia corpus artifact
% primes.quotient (catalog title "primes.quotient"): for natural n, m, and q,
% if m equals n times q, then n divides m. This file contains no proof.

primes_quotient: THEORY
BEGIN

  nat_divides(divisor, value: nat): bool =
    EXISTS (quotient: nat):
      value = divisor * quotient

  quotient_statement: bool =
    FORALL (n, m, q: nat):
      m = n * q IMPLIES nat_divides(n, m)

END primes_quotient
