% Statement-only formalization of Logipedia corpus artifact bigops.eq_bigop_O:
% the zero-indexed big operation equals its body as a higher-order operator.
% This file contains no proof.

bigops_eq_bigop_O[
  H: TYPE+
]: THEORY
BEGIN
  bigop, bigop_body:
    [nat ->
      [[nat -> bool] ->
        [H ->
          [[H -> [H -> H]] ->
            [[nat -> H] -> H]]]]]

  eq_bigop_O: bool =
    bigop(0) = bigop_body(0)
END bigops_eq_bigop_O
