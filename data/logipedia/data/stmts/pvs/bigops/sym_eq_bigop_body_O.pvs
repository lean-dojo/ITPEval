% Statement-only formalization of Logipedia corpus artifact bigops.sym_eq_bigop_body_O
% (catalog title "bigops.sym_eq_bigop_body_O"): at index zero, the constant
% operator returning the neutral value is Leibniz-equal to the big-operation body.
% This file contains no proof.

bigops_sym_eq_bigop_body_O[
  H: TYPE+
]: THEORY
BEGIN
  bigop_body:
    [nat ->
    [[nat -> bool] ->
    [H ->
    [[H -> [H -> H]] ->
    [[nat -> H] -> H]]]]]
  sym_eq_bigop_body_O: bool =
    (LAMBDA (p: [nat -> bool]):
      (LAMBDA (nil: H):
        (LAMBDA (op: [H -> [H -> H]]):
          (LAMBDA (f: [nat -> H]): nil)))) =
      bigop_body(0)
END bigops_sym_eq_bigop_body_O
