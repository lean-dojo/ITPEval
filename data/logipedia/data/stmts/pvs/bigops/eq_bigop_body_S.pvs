% Statement-only formalization of Logipedia corpus artifact bigops.eq_bigop_body_S:
% the successor-indexed big-operation body conditionally combines the current
% value with the preceding big operation. This file contains no proof.

bigops_eq_bigop_body_S[
  H: TYPE+
]: THEORY
BEGIN
  bigop, bigop_body:
    [nat ->
    [[nat -> bool] ->
    [H ->
    [[H -> [H -> H]] ->
    [[nat -> H] -> H]]]]]
  eq_bigop_body_S: bool =
    FORALL (n: nat):
      bigop_body(n + 1) =
        (LAMBDA (p: [nat -> bool]):
          (LAMBDA (nil: H):
            (LAMBDA (op: [H -> [H -> H]]):
              (LAMBDA (f: [nat -> H]):
                IF p(n) THEN
                  op(f(n))(bigop(n)(p)(nil)(op)(f))
                ELSE
                  bigop(n)(p)(nil)(op)(f)
                ENDIF))))
END bigops_eq_bigop_body_S
