% Statement-only formalization of Logipedia corpus artifact bigops.eq_bigop_S:
% the successor-indexed big operation equals its body as a higher-order operator.
% This file contains no proof.

bigops_eq_bigop_S[
  H: TYPE+
]: THEORY
BEGIN
  bigop, bigop_body:
    [nat ->
    [[nat -> bool] ->
    [H ->
    [[H -> [H -> H]] ->
    [[nat -> H] -> H]]]]]
  eq_bigop_S: bool =
    FORALL (n: nat):
      bigop(n + 1) = bigop_body(n + 1)
END bigops_eq_bigop_S
