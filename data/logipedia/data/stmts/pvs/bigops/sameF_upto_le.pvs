% Statement-only formalization of Logipedia corpus artifact bigops.sameF_upto_le:
% agreement of two functions through a natural bound is preserved when the
% bound is decreased. This file contains no proof.

bigops_sameF_upto_le[A: TYPE+]: THEORY
BEGIN
  sameF_upto(k: nat, f, g: [nat -> A]): bool =
    FORALL (i: nat):
      i < k IMPLIES f(i) = g(i)

  sameF_upto_le: bool =
    FORALL (f, g: [nat -> A]), (n, m: nat):
      n <= m IMPLIES
        (sameF_upto(m, f, g) IMPLIES sameF_upto(n, f, g))
END bigops_sameF_upto_le
