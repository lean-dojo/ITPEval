% Statement-only formalization of Logipedia artifact bigops.axiom_bigop_body_O:
% at index zero, the big-operation body returns the supplied neutral value,
% independently of the predicate, operation, and input function. This file contains no proof.

bigops_axiom_bigop_body_O[
  H: TYPE+
]: THEORY
BEGIN
  bigop_body:
    [nat ->
      [[nat -> bool] ->
        [H ->
          [[H -> [H -> H]] ->
            [[nat -> H] -> H]]]]]

  axiom_bigop_body_O: bool =
    bigop_body(0) =
      (LAMBDA (p: [nat -> bool]):
        (LAMBDA (nil: H):
          (LAMBDA (op: [H -> [H -> H]]):
            (LAMBDA (f: [nat -> H]): nil))))
END bigops_axiom_bigop_body_O
