% Statement-only formalization of Logipedia corpus artifact bigops.sub0_to_false:
% a selected bounded correspondence into a zero-length target prefix forces
% the source predicate to be false throughout its prefix. This file contains no proof.

bigops_sub0_to_false: THEORY
BEGIN
  sub_hk(
      h, k: [nat -> nat],
      n1, n2: nat,
      p1, p2: [nat -> bool],
      f1, f2: [nat -> nat]): bool =
    FORALL (i: nat):
      i < n1 IMPLIES
        p1(i) = TRUE IMPLIES
          (h(i) < n2 AND p2(h(i)) = TRUE)
            AND k(h(i)) = i

  sub0_to_false: bool =
    FORALL (h, k: [nat -> nat]),
        (n1, n2: nat),
        (p1, p2: [nat -> bool]),
        (f1, f2: [nat -> nat]):
      n1 = 0 IMPLIES
        sub_hk(h, k, n2, n1, p2, p1, f2, f1) IMPLIES
          FORALL (i: nat):
            i < n2 IMPLIES p2(i) = FALSE
END bigops_sub0_to_false
