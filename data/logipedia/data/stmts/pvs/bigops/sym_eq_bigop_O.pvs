% Statement-only formalization of Logipedia corpus artifact bigops.sym_eq_bigop_O
% (catalog title "bigops.sym_eq_bigop_O"): at index zero, the polymorphic
% big-operation body is Leibniz-equal to the big-operation function.
% This file contains no proof.

bigops_sym_eq_bigop_O[
  H: TYPE+
]: THEORY
BEGIN
  bigop, bigop_body:
    [nat ->
    [[nat -> bool] ->
    [H ->
    [[H -> [H -> H]] ->
    [[nat -> H] -> H]]]]]
  sym_eq_bigop_O: FORMULA
    bigop_body(0) = bigop(0)
END bigops_sym_eq_bigop_O
