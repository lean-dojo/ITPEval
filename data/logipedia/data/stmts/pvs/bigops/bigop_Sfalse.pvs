% Statement-only formalization of Logipedia artifact bigops.bigop_Sfalse:
% a predicate-filtered big operation is unchanged at a successor bound when
% the newly included predicate value is false. This file contains no proof.

bigops_bigop_Sfalse[B: TYPE+]: THEORY
BEGIN
  bigop(
      count: nat,
      p: [nat -> bool],
      nil: B,
      op: [B -> [B -> B]],
      f: [nat -> B]): RECURSIVE B =
    IF count = 0 THEN
      nil
    ELSIF p(count - 1) THEN
      op(f(count - 1))(bigop(count - 1, p, nil, op, f))
    ELSE
      bigop(count - 1, p, nil, op, f)
    ENDIF
  MEASURE count

  bigop_Sfalse: bool =
    FORALL (k: nat), (p: [nat -> bool]), (nil: B),
        (op: [B -> [B -> B]]), (f: [nat -> B]):
      p(k) = FALSE IMPLIES
        bigop(k + 1, p, nil, op, f) = bigop(k, p, nil, op, f)
END bigops_bigop_Sfalse
