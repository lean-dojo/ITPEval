% Statement-only formalization of Logipedia corpus artifact bigops.timesAC
% (catalog title "bigops.timesAC"): the source module's polymorphic ACop
% predicate holds at the successor of zero in the natural-number domain.
% This file contains no proof.

bigops_sttfa[A: TYPE+]: THEORY
BEGIN
  ACop: [A -> bool]
END bigops_sttfa

bigops_timesAC: THEORY
BEGIN
  IMPORTING bigops_sttfa[nat]

  timesAC: FORMULA
    ACop(1)
END bigops_timesAC
