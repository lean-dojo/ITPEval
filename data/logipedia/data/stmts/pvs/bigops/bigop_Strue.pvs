% Statement-only formalization of Logipedia artifact bigops.bigop_Strue:
% a predicate-filtered big operation adds the newly included value at a
% successor bound when its predicate value is true. This file contains no proof.

bigops_bigop_Strue[B: TYPE+]: THEORY
BEGIN
  bigop(
      count: nat,
      p: [nat -> bool],
      nil: B,
      op: [B -> [B -> B]],
      f: [nat -> B]): RECURSIVE B =
    IF count = 0 THEN
      nil
    ELSIF p(count - 1) THEN
      op(f(count - 1))(bigop(count - 1, p, nil, op, f))
    ELSE
      bigop(count - 1, p, nil, op, f)
    ENDIF
  MEASURE count

  bigop_Strue: bool =
    FORALL (k: nat), (p: [nat -> bool]), (nil: B),
        (op: [B -> [B -> B]]), (f: [nat -> B]):
      p(k) = TRUE IMPLIES
        bigop(k + 1, p, nil, op, f) =
          op(f(k))(bigop(k, p, nil, op, f))
END bigops_bigop_Strue
