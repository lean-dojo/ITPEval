% Statement-only formalization of Logipedia corpus artifact bigops.bigop_diff:
% an included factor can be extracted from a predicate-filtered prefix product
% of natural numbers. This file contains no proof.

bigops_bigop_diff: THEORY
BEGIN
  bigop_nat(
      count: nat,
      predicate: [nat -> bool],
      value: [nat -> nat]): RECURSIVE nat =
    IF count = 0 THEN
      1
    ELSIF predicate(count - 1) THEN
      value(count - 1)
        * bigop_nat(count - 1, predicate, value)
    ELSE
      bigop_nat(count - 1, predicate, value)
    ENDIF
  MEASURE count

  bigop_diff: bool =
    FORALL (p: [nat -> bool]), (f: [nat -> nat]), (i, n: nat):
      i < n IMPLIES
        p(i) = TRUE IMPLIES
          bigop_nat(n, p, f)
          =
          f(i)
            * bigop_nat(
                n,
                (LAMBDA (x: nat): NOT (i = x) AND p(x)),
                f)
END bigops_bigop_diff
