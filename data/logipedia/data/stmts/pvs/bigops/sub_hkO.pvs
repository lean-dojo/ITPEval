% Statement-only formalization of Logipedia corpus artifact bigops.sub_hkO:
% an empty source prefix satisfies the selected-index correspondence for
% arbitrary maps, predicates, and value functions. This file contains no proof.

bigops_sub_hkO: THEORY
BEGIN
  sub_hk(
      h, k: [nat -> nat],
      n1, n2: nat,
      p1, p2: [nat -> bool],
      f1, f2: [nat -> nat]): bool =
    FORALL (i: nat):
      i < n1 IMPLIES
        p1(i) = TRUE IMPLIES
          (h(i) < n2 AND p2(h(i)) = TRUE)
            AND k(h(i)) = i

  sub_hkO: FORMULA
    FORALL (h, k: [nat -> nat]),
        (n1, n2: nat),
        (p1, p2: [nat -> bool]),
        (f1, f2: [nat -> nat]):
      n1 = 0 IMPLIES
        sub_hk(h, k, n1, n2, p1, p2, f1, f2)
END bigops_sub_hkO
