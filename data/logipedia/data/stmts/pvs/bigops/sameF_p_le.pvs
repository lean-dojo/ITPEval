% Statement-only formalization of Logipedia corpus artifact bigops.sameF_p_le:
% predicate-selected agreement of two functions through a natural bound is
% preserved when the bound is decreased. This file contains no proof.

bigops_sameF_p_le[A: TYPE+]: THEORY
BEGIN
  sameF_p(
      k: nat,
      p: [nat -> bool],
      f, g: [nat -> A]): bool =
    FORALL (i: nat):
      i < k IMPLIES
        (p(i) = TRUE IMPLIES f(i) = g(i))

  sameF_p_le: bool =
    FORALL (p: [nat -> bool]), (f, g: [nat -> A]), (n, m: nat):
      n <= m IMPLIES
        (sameF_p(m, p, f, g) IMPLIES sameF_p(n, p, f, g))
END bigops_sameF_p_le
