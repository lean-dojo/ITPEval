% Statement-only formalization of Logipedia corpus artifact bigops.transitive_sub
% (catalog title bigops.transitive_sub): transitivity of the source-defined
% sub_hk relation on Boolean-selected bounded natural-number indices, with its
% forward and reverse maps composed in source order. This file contains no proof.

bigops_sttfa: THEORY
BEGIN
  % This is the source module's sub_hk definition. Its f1 and f2 arguments are
  % formal parameters that intentionally do not occur in the defining body.
  sub_hk(
      h, k: [nat -> nat],
      n1, n2: nat,
      p1, p2: [nat -> bool],
      f1, f2: [nat -> nat]): bool =
    FORALL (i: nat):
      i < n1 IMPLIES
        p1(i) = TRUE IMPLIES
          (h(i) < n2 AND p2(h(i)) = TRUE)
            AND k(h(i)) = i
END bigops_sttfa

bigops_transitive_sub: THEORY
BEGIN
  IMPORTING bigops_sttfa

  transitive_sub: bool =
    FORALL (h1, k1, h2, k2: [nat -> nat]),
        (n1, n2, n3: nat),
        (p1, p2, p3: [nat -> bool]),
        (f1, f2, f3: [nat -> nat]):
      sub_hk(h1, k1, n1, n2, p1, p2, f1, f2) IMPLIES
        sub_hk(h2, k2, n2, n3, p2, p3, f2, f3) IMPLIES
          sub_hk(
            (LAMBDA (x: nat): h2(h1(x))),
            (LAMBDA (x: nat): k1(k2(x))),
            n1, n3, p1, p3, f1, f3)
END bigops_transitive_sub
