% Statement-only formalization of Logipedia corpus artifact bigops.sym_eq_bigop_S
% (catalog title "bigops.sym_eq_bigop_S"): at every successor index, the
% polymorphic big-operation body is Leibniz-equal to the big-operation function.
% This file contains no proof.

bigops_sym_eq_bigop_S[
  H: TYPE+
]: THEORY
BEGIN
  bigop, bigop_body:
    [nat ->
      [[nat -> bool] ->
        [H ->
          [[H -> [H -> H]] ->
            [[nat -> H] -> H]]]]]

  sym_eq_bigop_S: bool =
    FORALL (n: nat):
      bigop_body(n + 1) = bigop(n + 1)
END bigops_sym_eq_bigop_S
