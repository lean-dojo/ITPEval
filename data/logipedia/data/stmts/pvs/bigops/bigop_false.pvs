% Statement-only formalization of Logipedia artifact bigops.bigop_false:
% a predicate-filtered big operation with the constantly false predicate
% returns the supplied neutral value. This file contains no proof.

bigops_bigop_false[B: TYPE+]: THEORY
BEGIN
  bigop(
      count: nat,
      p: [nat -> bool],
      nil: B,
      op: [B -> [B -> B]],
      f: [nat -> B]): RECURSIVE B =
    IF count = 0 THEN
      nil
    ELSIF p(count - 1) THEN
      op(f(count - 1))(bigop(count - 1, p, nil, op, f))
    ELSE
      bigop(count - 1, p, nil, op, f)
    ENDIF
  MEASURE count

  bigop_false: bool =
    FORALL (n: nat), (nil: B), (op: [B -> [B -> B]]),
        (f: [nat -> B]):
      bigop(n, (LAMBDA (i: nat): FALSE), nil, op, f) = nil
END bigops_bigop_false
