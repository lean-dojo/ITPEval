:: Statement-only formalization of Logipedia corpus artifact
:: permutation.bijn_fg (logipedia__mizar__permutation.bijn_fg), catalog title
:: "permutation.bijn_fg": bounded surjectivity of natural-number functions
:: through a fixed natural bound is preserved by composition.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, REAL_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f,g being Function of NAT,NAT,
      n being Nat st
    (for m being Nat st m <= n holds
      ex p being Nat st p <= n & f.p = m) &
    (for m being Nat st m <= n holds
      ex p being Nat st p <= n & g.p = m)
  holds
    for m being Nat st m <= n holds
      ex p being Nat st p <= n & f.(g.p) = m
proof
end;
::$P+
