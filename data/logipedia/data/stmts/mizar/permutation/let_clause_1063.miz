:: Statement-only formalization of Logipedia corpus artifact
:: permutation.let_clause_1063
:: (logipedia__mizar__permutation.let_clause_1063), catalog title
:: "permutation.let_clause_1063": equality of two bounded inputs transports
:: the prescribed value of a natural-number permutation between them.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, REAL_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT,
      n,i,j,a,b being Nat st
    (for k being Nat st k <= n holds f.k <= n) &
    (for x,y being Nat st
      x <= n & y <= n & f.x = f.y holds x = y) &
    i <= n & j <= n &
    (a <= n & f.a = i) &
    a <= n & f.a = i &
    (b <= n & f.b = j) &
    b <= n & f.b = j &
    (for k being Nat st k <= n holds f.k <= n) &
    (for x,y being Nat st
      x <= n & y <= n & f.x = f.y holds x = y) &
    a = b
  holds
    f.a = j
proof
end;
::$P+
