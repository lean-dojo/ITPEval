:: Statement-only formalization of Logipedia corpus artifact
:: permutation.permut_S_to_permut_transpose
:: (logipedia__mizar__permutation.permut_S_to_permut_transpose), catalog title
:: "permutation.permut_S_to_permut_transpose": a permutation of the natural
:: segment through m+1 remains a permutation through m after its values are
:: transposed at f.(m+1) and m+1. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCOP_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, REAL_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT,
      m being Nat st
    (for i being Nat st i <= m + 1 holds f.i <= m + 1) &
    (for i,j being Nat st
      i <= m + 1 & j <= m + 1 & f.i = f.j holds i = j)
  holds
    (for i being Nat st i <= m holds
      IFEQ(f.i,f.(m+1),m+1,IFEQ(f.i,m+1,f.(m+1),f.i)) <= m) &
    (for i,j being Nat st
      i <= m & j <= m &
      IFEQ(f.i,f.(m+1),m+1,IFEQ(f.i,m+1,f.(m+1),f.i)) =
        IFEQ(f.j,f.(m+1),m+1,IFEQ(f.j,m+1,f.(m+1),f.j))
    holds i = j)
proof
end;
::$P+
