:: Statement-only formalization of Logipedia corpus artifact
:: permutation.injective_invert_permut
:: (logipedia__mizar__permutation.injective_invert_permut), catalog title
:: "permutation.injective_invert_permut": the recursively constructed inverse
:: of a permutation of a natural-number initial segment is injective on that
:: initial segment. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, REAL_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT,
      n being Nat st
    (for i being Nat st i <= n holds f.i <= n) &
    (for i,j being Nat st
      i <= n & j <= n & f.i = f.j holds i = j)
  holds
    ex r being Function of NAT,Funcs(NAT,NAT) st
      (for m being Nat holds (r.0).m = 0) &
      (for k,m being Nat holds
        (m = f.(k + 1) & (r.(k + 1)).m = k + 1) or
        (m <> f.(k + 1) & (r.(k + 1)).m = (r.k).m)) &
      (for i,j being Nat st
        i <= n & j <= n & (r.n).i = (r.n).j
      holds i = j)
proof
end;
::$P+
