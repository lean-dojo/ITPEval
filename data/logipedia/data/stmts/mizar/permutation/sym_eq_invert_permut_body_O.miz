:: Statement-only formalization of Logipedia corpus artifact
:: permutation.sym_eq_invert_permut_body_O
:: (logipedia__mizar__permutation.sym_eq_invert_permut_body_O), catalog title
:: "permutation.sym_eq_invert_permut_body_O": the curried constant-zero
:: function on natural-valued natural functions and natural arguments is
:: Leibniz-equal to the fixed inverse-permutation body at natural zero.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1,
    WAYBEL_4;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, NAT_1,
    ZFMISC_1, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, ORDINAL1, CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: This conservative definition represents the source's fixed opaque
:: declaration invert_permut_body at its full higher-order function type.
definition
  func AuxBottom ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    the Element of
      Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)));
  coherence;
end;

::$P-
theorem
  for P being
      Subset of Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
  holds
    (Funcs(NAT,NAT) --> (NAT --> 0)) in P
      iff AuxBottom.0 in P
proof
end;
::$P+
