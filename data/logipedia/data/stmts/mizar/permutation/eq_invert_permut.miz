:: Statement-only formalization of Logipedia corpus artifact
:: permutation.eq_invert_permut
:: (logipedia__mizar__permutation.eq_invert_permut):
:: the fixed inverse-permutation function at every natural index directionally
:: Leibniz-implies the fixed inverse-permutation body after the source
:: natural-type filter.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2,
    FUNCOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1, MARGREL1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1,
    XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin


:: These projections preserve the independently fixed source
:: declarations invert_permut and invert_permut_body. The source
:: equations for filter_nat_type make its natural-index specialization
:: extensionally identical to invert_permut_body.
definition
  func Aux ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat,
      P being Subset of
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) st
    Aux.n in P
  holds AuxBottom.n in P
proof
end;
::$P+
