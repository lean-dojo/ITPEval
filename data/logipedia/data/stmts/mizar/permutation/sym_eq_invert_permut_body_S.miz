:: Statement-only formalization of Logipedia corpus artifact
:: permutation.sym_eq_invert_permut_body_S
:: (logipedia__mizar__permutation.sym_eq_invert_permut_body_S):
:: the exact conditional successor step using the fixed inverse-permutation
:: function directionally Leibniz-implies the fixed inverse-permutation body
:: at that successor.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, FUNCT_3, FUNCT_4, FUNCT_7, PARTFUN1, NAT_1, NUMBERS,
    CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, NAT_1, FUNCT_4, FUNCT_7;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, FUNCT_4, FUNCT_7, NAT_1, NAT_D, ZFMISC_1, MCART_1,
    XTUPLE_0, CARD_1, SUBSET_1, REAL_1, MEMBERED;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, FUNCT_4, FUNCT_7, ORDINAL1, CARD_1,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, XTUPLE_0;
  schemes FUNCT_2;
  theorems FUNCT_2, FUNCT_4, FUNCT_7;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin


:: These projections preserve the two independently fixed source
:: declarations without adding defining equations.
definition
  func Aux ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;
end;

definition
  let n be Nat;
  let h be Element of Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT));
  let f be Element of Funcs(NAT,NAT);
  :: One-point update is the exact source conditional:
  :: n+1 at f.(n+1), and h.f everywhere else.
  func Aux(n,h,f) -> Element of Funcs(NAT,NAT) equals
    (h.f) +* (f.(n+1),n+1);
  coherence
  proof
    reconsider p = h.f as Function of NAT,NAT by FUNCT_2:66;
    reconsider a = f.(n+1) as Element of NAT;
    reconsider v = n+1 as Element of NAT;
    reconsider g = p +* (a,v) as Function of NAT,NAT;
    reconsider g as Element of Funcs(NAT,NAT) by FUNCT_2:8;
    (h.f) +* (f.(n+1),n+1) = g;
    hence thesis;
  end;
end;

definition
  let n be Nat;
  let h be Element of Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT));
  :: Curry the exact pointwise source lambda over f.
  func Aux(n,h) ->
      Element of Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) means
  :DefStep:
    for f being Element of Funcs(NAT,NAT) holds
      it.f = Aux(n,h,f);
  existence
  proof
    deffunc F(Element of Funcs(NAT,NAT)) =
      Aux(n,h,$1);
    consider k being
        Function of Funcs(NAT,NAT),Funcs(NAT,NAT) such that
A1:   for f being Element of Funcs(NAT,NAT) holds k.f = F(f)
      from FUNCT_2:sch 4;
    reconsider k as Element of
      Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) by FUNCT_2:8;
    take k;
    thus thesis by A1;
  end;
  uniqueness
  proof
    let k1,k2 be Element of
      Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) such that
A1: for f being Element of Funcs(NAT,NAT) holds
      k1.f = Aux(n,h,f) and
A2: for f being Element of Funcs(NAT,NAT) holds
      k2.f = Aux(n,h,f);
    for f being Element of Funcs(NAT,NAT) holds k1.f = k2.f
    proof
      let f be Element of Funcs(NAT,NAT);
      thus k1.f = Aux(n,h,f) by A1
        .= k2.f by A2;
    end;
    hence thesis by FUNCT_2:63;
  end;
end;

::$P-
theorem
  for n being Nat,
      P being Subset of
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) st
    Aux(n,Aux.n) in P
  holds AuxBottom.(n+1) in P
proof
end;
::$P+
