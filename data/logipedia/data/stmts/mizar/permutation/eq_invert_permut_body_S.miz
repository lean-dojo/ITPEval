:: Statement-only formalization of Logipedia corpus artifact
:: permutation.eq_invert_permut_body_S
:: (logipedia__mizar__permutation.eq_invert_permut_body_S), catalog title
:: "permutation.eq_invert_permut_body_S": at every successor natural index,
:: the inverse-permutation body is Leibniz-equal to the curried function that
:: returns the successor when its argument equals the input function's value
:: there, and otherwise returns the preceding inverse-permutation value. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1,
    ARYTM_3, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

:: These projections conservatively represent the fixed, independently
:: unconstrained source declarations invert_permut and invert_permut_body.
definition
  func Aux ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
      ),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
      )
    )).(
      the Element of
        [:Funcs(
            NAT,
            Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
          ),
          Funcs(
            NAT,
            Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
          ):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
      ),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
      )
    )).(
      the Element of
        [:Funcs(
            NAT,
            Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
          ),
          Funcs(
            NAT,
            Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
          ):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat holds
    ex result being
        Function of Funcs(NAT,NAT),Funcs(NAT,NAT) st
      (for f being Function of NAT,NAT holds
        ex invertAtN,resultAtF being Function of NAT,NAT st
          invertAtN = (Aux.n).f &
          resultAtF = result.f &
          (for m being Nat holds
            resultAtF.m =
              IFEQ(m,f.(n+1),n+1,invertAtN.m))) &
      (for P being
          Subset of Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) st
        AuxBottom.(n+1) in P
      holds result in P)
proof
end;
::$P+
