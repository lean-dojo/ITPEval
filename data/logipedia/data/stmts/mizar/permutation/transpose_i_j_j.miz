:: Statement-only formalization of Logipedia corpus artifact
:: permutation.transpose_i_j_j
:: (logipedia__mizar__permutation.transpose_i_j_j), catalog title
:: "permutation.transpose_i_j_j": for any two natural numbers, the
:: transposition exchanging them maps the second number to the first.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0,
    ARYTM_1, ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, FUNCOP_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, REAL_1,
    NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for i,j being Nat holds
    IFEQ(j,i,j,IFEQ(j,j,i,j)) = i
proof
end;
::$P+
