:: Statement-only formalization of Logipedia corpus artifact
:: permutation.invert_permut_f
:: (logipedia__mizar__permutation.invert_permut_f), catalog title
:: "permutation.invert_permut_f": the recursively constructed inverse of a
:: natural-number function sends f(m) back to m when m is in the bounded
:: interval on which f is injective. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, REAL_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT,
      n,m being Nat st
    m <= n &
    (for i,j being Nat st
      i <= n & j <= n & f.i = f.j holds i = j)
  holds
    ex r being Function of NAT,Funcs(NAT,NAT) st
      (for q being Nat holds (r.0).q = 0) &
      (for k,q being Nat holds
        (q = f.(k + 1) & (r.(k + 1)).q = k + 1) or
        (q <> f.(k + 1) & (r.(k + 1)).q = (r.k).q)) &
      (r.n).(f.m) = m
proof
end;
::$P+
