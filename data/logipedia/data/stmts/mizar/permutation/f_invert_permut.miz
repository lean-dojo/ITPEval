:: Statement-only formalization of Logipedia corpus artifact
:: permutation.f_invert_permut
:: (logipedia__mizar__permutation.f_invert_permut), catalog title
:: "permutation.f_invert_permut": a bounded permutation maps its bounded
:: reverse-search inverse value back to the requested natural number.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, REAL_1, NAT_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for f being Function of NAT,NAT,
      n,m being Nat st
    m <= n &
    (for i being Nat st i <= n holds f.i <= n) &
    (for i,j being Nat st
      i <= n & j <= n & f.i = f.j holds i = j)
  holds ex p being Nat st
    p <= n & f.p = m &
    for q being Nat st q <= n & f.q = m holds q <= p
proof
end;
::$P+
