:: Statement-only formalization of Logipedia corpus artifact
:: permutation.axiom_invert_permut
:: (logipedia__mizar__permutation.axiom_invert_permut), catalog title
:: "permutation.axiom_invert_permut": for every natural index, the
:: fixed inverse-permutation function is related by the fixed source equality
:: predicate to the fixed natural-type filter applied to its fixed body, at
:: the full curried function type (NAT -> NAT) -> NAT -> NAT.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: The projections represent the source's fixed invert_permut and
:: invert_permut_body declarations. Pairing keeps them independent while
:: preserving their complete domains. elementary_filter separately represents
:: filter_nat_type specialized to the full curried result type. The
:: definite-description relation in the theorem is the fixed connectives.equal
:: instance at that result type.
definition
  func Aux ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func elementary_filter ->
      Function of
        Funcs(
          NAT,
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
        ),
        Funcs(
          NAT,
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
        ) equals
    the Element of
      Funcs(
        Funcs(
          NAT,
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
        ),
        Funcs(
          NAT,
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
        )
      );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat holds
    [Aux.n,(elementary_filter.AuxBottom).n]
      in the Relation of
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)),
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
proof
end;
::$P+
