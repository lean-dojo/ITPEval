:: Statement-only formalization of Logipedia corpus artifact
:: permutation.axiom_invert_permut_body_S
:: (logipedia__mizar__permutation.axiom_invert_permut_body_S):
:: the fixed inverse-permutation body at every successor is related by the
:: fixed source equality predicate to its exact conditional step using the
:: fixed inverse-permutation function.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2,
    FUNCOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1, MARGREL1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1,
    XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin


:: These projections preserve the two independently fixed
:: source declarations without adding defining equations.
definition
  func Aux ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom ->
      Function of
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
      Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))),
          Funcs(
        NAT,
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat holds
    ex result being
        Function of Funcs(NAT,NAT),Funcs(NAT,NAT) st
      (for f being Function of NAT,NAT holds
        ex invertAtN,resultAtF being Function of NAT,NAT st
          invertAtN = (Aux.n).f &
          resultAtF = result.f &
          (for m being Nat holds
            resultAtF.m =
              IFEQ(m,f.(n+1),n+1,invertAtN.m))) &
      [AuxBottom.(n+1),result] in
        the Relation of
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)),
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
proof
end;
::$P+
