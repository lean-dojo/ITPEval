:: Statement-only formalization of Logipedia corpus artifact
:: gcd.axiom_gcd_aux_body_O. At zero fuel the source auxiliary body returns
:: its first natural argument. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    NAT_1, RELAT_1, XXREAL_0;
  constructors REAL_1, NAT_1, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, ORDINAL1,
    CARD_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for m,n being Nat holds m = m
proof
end;
::$P+
