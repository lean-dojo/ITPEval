:: Statement-only formalization of Logipedia corpus artifact
:: gcd.let_clause_15441
:: (logipedia__mizar__gcd.let_clause_15441):
:: under the bounded induction hypothesis, commutativity rewrites the final
:: natural multiple from b*n to n*b in the second truncated difference.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, FUNCT_3, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, XXREAL_0, XCMPLX_0, COMPLEX1, SQUARE_1, REAL_1, INT_1,
    INT_2, MCART_1, PARTFUN1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, SQUARE_1, XXREAL_0,
    NAT_1, INT_1, INT_2, NAT_D, XTUPLE_0, MCART_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, NAT_D, ZFMISC_1, CARD_1, XTUPLE_0, MCART_1,
    REAL_1, SQUARE_1, COMPLEX1, INT_1, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, XTUPLE_0,
    MEMBERED, SQUARE_1, INT_1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin


:: Aux represents the source module's fixed gcd_aux declaration.
:: Choice selection fixes one interpretation without adding equations,
:: recursion laws, or any other assumptions about that interpretation.
definition
  func Aux -> Function of [:NAT,NAT,NAT:],NAT equals
    (pr1(
      Funcs([:NAT,NAT,NAT:],NAT),
      Funcs([:NAT,NAT,NAT:],NAT)
    )).(
      the Element of
        [:Funcs([:NAT,NAT,NAT:],NAT),
          Funcs([:NAT,NAT,NAT:],NAT):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for p,q being Nat st
    (for m,n being Nat st
      0 < n &
      n <= m &
      n <= q
    holds ex a,b being Nat st
      a * n -' b * m = Aux/.[q,m,n] or
      b * m -' a * n = Aux/.[q,m,n])
  holds for m,n being Nat st
    0 < n &
    n <= m &
    n <= q+1 &
    not n divides m
  holds for a being Nat st
    (ex b being Nat st
      a * (m mod n) -' b * n = Aux/.[q,n,m mod n] or
      b * n -' a * (m mod n) = Aux/.[q,n,m mod n])
  holds for b being Nat st
    (a * (m mod n) -' b * n = Aux/.[q,n,m mod n] or
     b * n -' a * (m mod n) = Aux/.[q,n,m mod n])
  holds
    b * n -' a * (m mod n) = Aux/.[q,n,m mod n]
  implies
    n * b -' a * (m mod n) = Aux/.[q,n,m mod n]
proof
end;
::$P+
