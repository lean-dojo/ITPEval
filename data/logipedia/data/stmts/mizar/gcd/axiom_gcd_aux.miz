:: Statement-only formalization of Logipedia corpus artifact gcd.axiom_gcd_aux
:: (logipedia__mizar__gcd.axiom_gcd_aux), catalog title
:: "gcd.axiom_gcd_aux": at every natural index, the abstract gcd auxiliary
:: function is related by the source equality predicate to the natural-type
:: filter applied to its auxiliary body. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: Aux and AuxBottom are independent fixed representatives of gcd_aux and
:: gcd_aux_body. The source filter equations make the specialized filter
:: extensionally the identity.
definition
  func Aux -> Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func elementary_filter ->
      Function of
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))) equals
    id Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)));
  coherence;
end;

::$P-
theorem
  for p being Nat holds
    [Aux.p,(elementary_filter.AuxBottom).p] in
      the Relation of Funcs(NAT,Funcs(NAT,NAT)),
                      Funcs(NAT,Funcs(NAT,NAT))
proof
end;
::$P+
