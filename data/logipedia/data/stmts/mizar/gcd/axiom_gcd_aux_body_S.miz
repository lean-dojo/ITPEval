:: Statement-only formalization of Logipedia corpus artifact
:: gcd.axiom_gcd_aux_body_S
:: (logipedia__mizar__gcd.axiom_gcd_aux_body_S), catalog title
:: "gcd.axiom_gcd_aux_body_S": at every successor natural index, the fixed
:: gcd auxiliary body equals the curried function returning n when the
:: source Boolean zero-remainder divisibility test succeeds, and otherwise
:: the preceding auxiliary value at n and the source remainder of m by n.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1,
    ARYTM_3, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2, XXREAL_0, XCMPLX_0,
    INT_1, INT_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, INT_2, NAT_D;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, NAT_D, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1,
    INT_1, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, XTUPLE_0, INT_1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

:: These projections conservatively represent the fixed, independently
:: unconstrained source declarations gcd_aux and gcd_aux_body. The relation
:: is the fixed opaque instance of connectives.equal at the binary-function
:: type; it is deliberately not replaced with Mizar equality.
definition
  func Aux -> Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;
end;

:: The witness is exactly the source right-hand-side function. The first two
:: branches encode remainder at divisor zero; the other two use Mizar's
:: coincident positive-divisor remainder.
::$P-
theorem
  for p being Nat holds
  ex rhs being Function of NAT,Funcs(NAT,NAT) st
    (for m,n being Nat holds
      ex rhsAtM,auxAtPN being Function of NAT,NAT,
         auxAtP being Function of NAT,Funcs(NAT,NAT) st
        rhsAtM = rhs.m &
        auxAtP = Aux.p &
        auxAtPN = auxAtP.n &
        ((n = 0 & m = 0 & rhsAtM.n = n) or
         (n = 0 & m <> 0 & rhsAtM.n = auxAtPN.m) or
         (n <> 0 & m mod n = 0 & rhsAtM.n = n) or
         (n <> 0 & m mod n <> 0 & rhsAtM.n = auxAtPN.(m mod n)))) &
    [AuxBottom.(p+1),rhs] in
      the Relation of Funcs(NAT,Funcs(NAT,NAT)),
                      Funcs(NAT,Funcs(NAT,NAT))
proof
end;
::$P+
