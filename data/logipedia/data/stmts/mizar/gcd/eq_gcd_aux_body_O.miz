:: Statement-only formalization of Logipedia corpus artifact
:: gcd.eq_gcd_aux_body_O
:: (logipedia__mizar__gcd.eq_gcd_aux_body_O), catalog title
:: "gcd.eq_gcd_aux_body_O": at natural index zero, the fixed gcd auxiliary
:: body is Leibniz-equal to the curried first-projection function on two
:: natural arguments. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, FUNCT_6, NAT_1, NUMBERS, CARD_1, ARYTM_1,
    ARYTM_3, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCT_5, ORDINAL1,
    CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCT_5,
    FUNCT_6, NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, FUNCT_3, FUNCT_5, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: AuxBottom is the target name for the fixed, opaque source constant
:: gcd_aux_body; this conservative definition imposes no equations on it.
definition
  func AuxBottom ->
      Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  AuxBottom.0 = curry pr1(NAT,NAT)
proof
end;
::$P+
