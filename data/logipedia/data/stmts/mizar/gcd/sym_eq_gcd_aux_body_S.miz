:: Statement-only formalization of Logipedia corpus artifact
:: gcd.sym_eq_gcd_aux_body_S
:: (logipedia__mizar__gcd.sym_eq_gcd_aux_body_S), catalog title
:: "gcd.sym_eq_gcd_aux_body_S": at every successor natural index, the
:: curried function selected by the source Boolean zero-remainder test is
:: Leibniz-equal to the fixed gcd auxiliary body. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1,
    ARYTM_3, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2, XXREAL_0, XCMPLX_0,
    INT_1, INT_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3,
    ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1,
    INT_1, INT_2, NAT_D;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, NAT_D, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1,
    INT_1, INT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, NAT_1, XTUPLE_0, INT_1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

:: These projections conservatively name the fixed, independently
:: unconstrained source declarations gcd_aux and gcd_aux_body. Tuple
:: application is the uncurried form of their source function types.
definition
  func Aux -> Function of [:NAT,NAT,NAT:],NAT equals
    (pr1(
      Funcs([:NAT,NAT,NAT:],NAT),
      Funcs([:NAT,NAT,NAT:],NAT)
    )).(
      the Element of
        [:Funcs([:NAT,NAT,NAT:],NAT),
          Funcs([:NAT,NAT,NAT:],NAT):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of [:NAT,NAT,NAT:],NAT equals
    (pr2(
      Funcs([:NAT,NAT,NAT:],NAT),
      Funcs([:NAT,NAT,NAT:],NAT)
    )).(
      the Element of
        [:Funcs([:NAT,NAT,NAT:],NAT),
          Funcs([:NAT,NAT,NAT:],NAT):]
    );
  coherence by FUNCT_2:66;
end;

:: Pointwise equality is the extensional Mizar rendering of the source
:: Leibniz equality between total curried functions. At divisor zero the
:: source remainder is m; for positive divisors it is Mizar's remainder.
::$P-
theorem
  for p,m,n being Nat holds
    (n = 0 & m = 0 &
      n = AuxBottom/.[p+1,m,n]) or
    (n = 0 & m <> 0 &
      Aux/.[p,n,m] = AuxBottom/.[p+1,m,n]) or
    (n <> 0 & m mod n = 0 &
      n = AuxBottom/.[p+1,m,n]) or
    (n <> 0 & m mod n <> 0 &
      Aux/.[p,n,m mod n] = AuxBottom/.[p+1,m,n])
proof
end;
::$P+
