:: Statement-only formalization of Logipedia corpus artifact
:: bool.axiom_match_bool_type_true
:: (logipedia__mizar__bool.axiom_match_bool_type_true), catalog title
:: "bool.axiom_match_bool_type_true": for every result carrier and branch
:: values, the fixed polymorphic Boolean matcher at true is related to its
:: true branch by the source module's fixed opaque equality relation.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, MARGREL1, XBOOLEAN,
    ZFMISC_1, MCART_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1, XTUPLE_0, MCART_1,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, MARGREL1,
    ZFMISC_1, XTUPLE_0, MCART_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NAT_1, XTUPLE_0, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for T being non empty set,
      caseTrue,caseFalse being Element of T
  holds
    [(the Function of [:T,T,BOOLEAN:],T).
      [caseTrue,caseFalse,TRUE],caseTrue] in
      the Relation of T,T
proof
end;
::$P+
