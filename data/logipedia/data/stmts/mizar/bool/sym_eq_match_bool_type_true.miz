:: Statement-only formalization of Logipedia corpus artifact
:: bool.sym_eq_match_bool_type_true, catalog title
:: "bool.sym_eq_match_bool_type_true": for every result type and branch
:: values, the true branch equals the polymorphic Boolean matcher at true.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, MARGREL1,
    XBOOLEAN, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, NAT_1,
    XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, NAT_1,
    MARGREL1, ZFMISC_1, CARD_1, XBOOLEAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NAT_1, XBOOLEAN, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for T being non empty set,
      caseTrue,caseFalse being Element of T
  holds caseTrue = IFEQ(TRUE,TRUE,caseTrue,caseFalse)
proof
end;
::$P+
