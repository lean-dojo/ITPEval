:: Statement-only formalization of Logipedia corpus artifact
:: bool.axiom_match_bool_type_false
:: (logipedia__mizar__bool.axiom_match_bool_type_false):
:: the fixed polymorphic Boolean matcher at false is related by the fixed
:: source equality predicate to its false branch.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2,
    FUNCOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1, MARGREL1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1,
    XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin


::$P-
theorem
  for T being non empty set,
      caseTrue,caseFalse being Element of T
  holds
    [(the Function of [:T,T,BOOLEAN:],T).
      [caseTrue,caseFalse,FALSE],caseFalse] in
      the Relation of T,T
proof
end;
::$P+
