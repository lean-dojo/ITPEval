:: Statement-only formalization of Logipedia corpus artifact
:: bool.not_eq_true_false, catalog title "bool.not_eq_true_false": the Boolean
:: values true and false are unequal. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, MARGREL1;
  constructors MARGREL1;
  registrations XBOOLE_0, SUBSET_1, MARGREL1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  TRUE <> FALSE
proof
end;
::$P+
