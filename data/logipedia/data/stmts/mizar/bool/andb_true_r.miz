:: Statement-only formalization of Logipedia corpus artifact
:: bool.andb_true_r, catalog title "bool.andb_true_r": Boolean conjunction
:: being true implies that its right operand is true. This file contains no
:: proof.

environ
  vocabularies TARSKI, RELAT_1, FUNCT_1, FUNCT_2, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, MARGREL1, XBOOLEAN, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, MARGREL1,
    ZFMISC_1, CARD_1, XBOOLEAN;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ORDINAL1,
    CARD_1, NAT_1, XBOOLEAN, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for b1,b2 being boolean object st
    b1 '&' b2 = TRUE
  holds b2 = TRUE
proof
end;
::$P+
