:: Statement-only formalization of Logipedia corpus artifact
:: bool.match_bool_prop, catalog title "bool.match_bool_prop": a predicate
:: holding for both Boolean values holds for every Boolean value.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, MARGREL1;
  constructors MARGREL1;
  registrations XBOOLE_0, SUBSET_1, MARGREL1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for P being Subset of BOOLEAN st
    TRUE in P & FALSE in P
  holds for z being Element of BOOLEAN holds z in P
proof
end;
::$P+
