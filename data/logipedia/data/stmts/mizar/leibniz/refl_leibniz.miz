:: Statement-only formalization of Logipedia corpus artifact
:: leibniz.refl_leibniz (logipedia__mizar__leibniz.refl_leibniz),
:: catalog title "leibniz.refl_leibniz": Leibniz equality, defined by
:: preservation of every predicate on an arbitrary type, is reflexive.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
  constructors RELAT_1, RELSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set, x being object st x in A holds
    for P being Subset of A st x in P holds x in P
proof
end;
::$P+
