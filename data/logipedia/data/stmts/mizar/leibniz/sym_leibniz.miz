:: Statement-only formalization of Logipedia corpus artifact
:: leibniz.sym_leibniz (logipedia__mizar__leibniz.sym_leibniz),
:: catalog title "leibniz.sym_leibniz": Leibniz equality, defined by
:: preservation of every predicate on an arbitrary type, is symmetric.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
  constructors RELAT_1, RELSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set, x,y being object st x in A & y in A holds
    (for P being Subset of A st x in P holds y in P) implies
    (for P being Subset of A st y in P holds x in P)
proof
end;
::$P+
