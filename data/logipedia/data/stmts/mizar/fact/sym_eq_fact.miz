:: Statement-only formalization of Logipedia corpus artifact fact.sym_eq_fact
:: (logipedia__mizar__fact.sym_eq_fact), catalog title "fact.sym_eq_fact": for
:: every natural number, the natural-type filter applied to the abstract
:: factorial body is Leibniz-equal to the factorial function. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, FUNCT_3,
    PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1,
    MCART_1, WAYBEL_4, CARDFIL2, SUBSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1,
    FUNCT_3, ORDINAL1, CARD_1, NAT_1, SUBSET_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: These three definitions conservatively represent the fixed source
:: declarations fact, fact_body, and filter_nat_type specialized to NAT.
definition
  func Aux -> Function of NAT,NAT equals
    (pr1(
      Funcs(NAT,NAT),
      [:Funcs(NAT,NAT),
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]
    )).(
      the Element of
        [:Funcs(NAT,NAT),
          [:Funcs(NAT,NAT),
            Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]:]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,NAT equals
    (pr1(
      Funcs(NAT,NAT),
      Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
    )).(
      (pr2(
        Funcs(NAT,NAT),
        [:Funcs(NAT,NAT),
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]
      )).(
        the Element of
          [:Funcs(NAT,NAT),
            [:Funcs(NAT,NAT),
              Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]:]
      )
    );
  coherence by FUNCT_2:66;

  func elementary_filter ->
      Function of Funcs(NAT,NAT),Funcs(NAT,NAT) equals
    (pr2(
      Funcs(NAT,NAT),
      Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
    )).(
      (pr2(
        Funcs(NAT,NAT),
        [:Funcs(NAT,NAT),
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]
      )).(
        the Element of
          [:Funcs(NAT,NAT),
            [:Funcs(NAT,NAT),
              Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]:]
      )
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat holds
    for P being Subset of NAT st (elementary_filter.AuxBottom).n in P
    holds Aux.n in P
proof
end;
::$P+
