:: Statement-only formalization of Logipedia corpus artifact
:: fact.sym_eq_fact_body_O (logipedia__mizar__fact.sym_eq_fact_body_O),
:: catalog title "fact.sym_eq_fact_body_O": the successor of zero, namely
:: one, is Leibniz-equal to the fixed abstract factorial body at zero. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1, WAYBEL_4;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, ZFMISC_1,
    CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NAT_1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: This conservative definition represents the fixed source declaration
:: fact_body without imposing any equations beyond the statement below.
definition
  func AuxBottom -> Function of NAT,NAT equals
    the Element of Funcs(NAT,NAT);
  coherence
  proof
    set X = Funcs(NAT,NAT);
    X is non empty;
    then the Element of X in X;
    hence thesis by FUNCT_2:66;
  end;
end;

::$P-
theorem
  for P being Subset of NAT st 1 in P holds AuxBottom.0 in P
proof
end;
::$P+
