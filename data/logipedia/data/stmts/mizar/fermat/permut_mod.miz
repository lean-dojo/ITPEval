:: Statement-only formalization of Logipedia corpus artifact fermat.permut_mod
:: (logipedia__mizar__fermat.permut_mod), catalog title
:: "fermat.permut_mod": multiplication by a natural number not divisible by
:: a prime, followed by reduction modulo that prime, maps the natural segment
:: through the prime's predecessor into itself and is injective there.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1, INT_2, NEWTON,
    ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, NAT_D, NEWTON;
  constructors REAL_1, NAT_1, NAT_D, NEWTON;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1, NEWTON;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for p,a being Nat st
    p is prime &
    not p divides a
  holds
    (for i being Nat st i <= p -' 1 holds
      (a * i) mod p <= p -' 1) &
    (for i,j being Nat st
      i <= p -' 1 &
      j <= p -' 1 &
      (a * i) mod p = (a * j) mod p
    holds i = j)
proof
end;
::$P+
