:: Statement-only formalization of Logipedia corpus artifact
:: "fermat.congruent_exp_pred_SO", catalog title
:: "fermat.congruent_exp_pred_SO": Fermat's little theorem in congruence form
:: for a prime natural modulus and a natural base not divisible by that prime.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1, INT_2, NEWTON,
    ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, NAT_D, NEWTON;
  constructors REAL_1, NAT_1, NAT_D, NEWTON;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1, NEWTON;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for p, a being Nat st
    p is prime &
    not p divides a
  holds (a |^ (p -' 1)) mod p = 1 mod p
proof
end;
::$P+
