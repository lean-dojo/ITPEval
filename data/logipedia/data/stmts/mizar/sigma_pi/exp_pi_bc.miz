:: Statement-only formalization of Logipedia corpus artifact
:: "sigma_pi.exp_pi_bc", catalog title "sigma_pi.exp_pi_bc": a natural
:: power times a finite product of consecutive function values equals the
:: product obtained by multiplying each value by the base. This file contains
:: no proof.

environ
  vocabularies NUMBERS, NAT_1, FINSEQ_1, FINSEQ_2, RELAT_1, FUNCT_1,
    FUNCT_2, XBOOLE_0, SUBSET_1, TARSKI, CARD_1, XCMPLX_0, XREAL_0,
    XXREAL_0, ORDINAL1, NEWTON, REALSET1, INT_1, ARYTM_1, ARYTM_3,
    CARD_3, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, INT_1, NEWTON, RELAT_1, FUNCT_1,
    FUNCT_2, FINSEQ_1, RVSUM_1, FINSEQ_2, NAT_1, NAT_D;
  constructors REAL_1, NAT_D, NEWTON, RELSET_1, FUNCT_2, NUMBERS,
    RVSUM_1, FINSEQOP;
  registrations XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, ORDINAL1, NUMBERS,
    XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, NEWTON, VALUED_0, VALUED_1, CARD_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b,c being Nat,
      f being Function of NAT,NAT,
      original,scaled being FinSequence of NAT st
    len original = c -' b &
    len scaled = c -' b &
    (for i being Nat st i < c -' b holds
      original.(i + 1) = f.(i + b) &
      scaled.(i + 1) = a * f.(i + b))
  holds
    (a |^ (c -' b)) * Product original = Product scaled
proof
end;
::$P+
