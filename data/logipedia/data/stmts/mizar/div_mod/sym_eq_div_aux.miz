:: Statement-only formalization of Logipedia corpus artifact
:: div_mod.sym_eq_div_aux (logipedia__mizar__div_mod.sym_eq_div_aux), catalog
:: title "div_mod.sym_eq_div_aux": at every natural index, the fixed
:: natural-type filter applied to the fixed division auxiliary body equals
:: the fixed division auxiliary function as a curried function on two natural
:: arguments. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, FUNCT_3,
    PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1,
    MCART_1, WAYBEL_4, CARDFIL2, SUBSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1,
    FUNCT_3, ORDINAL1, CARD_1, NAT_1, SUBSET_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: Aux, AuxBottom, and elementary_filter respectively represent the fixed
:: source declarations div_aux, div_aux_body, and filter_nat_type specialized
:: to functions of type NAT -> NAT -> NAT. They remain independent here:
:: their equality is the proposition being stated, not a target definition.
definition
  func Aux -> Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        Funcs(
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))):]
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
            Funcs(
              Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
              Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))):]:]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,Funcs(NAT,NAT)) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))))
    )).(
      (pr2(
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(
            Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
            Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))):]
      )).(
        the Element of
          [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
            [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
              Funcs(
                Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
                Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))):]:]
      )
    );
  coherence by FUNCT_2:66;

  func elementary_filter ->
      Function of
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
      Funcs(
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))))
    )).(
      (pr2(
        Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
        [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
          Funcs(
            Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
            Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))):]
      )).(
        the Element of
          [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
            [:Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
              Funcs(
                Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT))),
                Funcs(NAT,Funcs(NAT,Funcs(NAT,NAT)))):]:]
      )
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for p being Nat holds
    (elementary_filter.AuxBottom).p = Aux.p
proof
end;
::$P+
