:: Statement-only formalization of Logipedia corpus artifact
:: div_mod.div_mod. Positive divisors use Mizar's Euclidean div/mod; the
:: explicit zero branch preserves the source conventions div n 0 = n+1 and
:: mod n 0 = n. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, NUMBERS, NAT_1, ARYTM_3, CARD_1, XXREAL_0, XCMPLX_0,
    COMPLEX1, ARYTM_1, SQUARE_1, SIN_COS, REAL_1, VALUED_0, INT_1,
    INT_2, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, FUNCT_3, ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, COMPLEX1,
    REAL_1, SQUARE_1, NAT_1, INT_1, INT_2, NAT_D, SIN_COS, XXREAL_0;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, REAL_1,
    SQUARE_1, NAT_1, NAT_D, SIN_COS;
  registrations RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1, MEMBERED, SIN_COS, VALUED_0, SQUARE_1, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

definition
  let n,m be Nat;
  func Aux(n,m) -> Nat equals
    n+1 if m = 0 otherwise n div m;
  correctness;

  func AuxBottom(n,m) -> Nat equals
    n if m = 0 otherwise n mod m;
  correctness;
end;

::$P-
theorem
  for n,m being Nat holds
    n = Aux(n,m) * m + AuxBottom(n,m)
proof
end;
::$P+
