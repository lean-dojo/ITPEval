:: Statement-only formalization of Logipedia corpus artifact
:: div_mod.le_mod_aux_m_m
:: (logipedia__mizar__div_mod.le_mod_aux_m_m):
:: if n is bounded by fuel p, the fixed modulo auxiliary value at p, n, and m
:: is bounded by m.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, XXREAL_0, XCMPLX_0, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, XTUPLE_0, MCART_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, NAT_D, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin


:: Choice-selected definitions preserve the source module's fixed declarations
:: without adding equations or assumptions about their interpretations.
:: Aux represents the fixed source declaration mod_aux.
definition
  func Aux ->
      Function of [:NAT,NAT,NAT:],NAT equals
    the Element of
      Funcs([:NAT,NAT,NAT:],NAT);
  coherence by FUNCT_2:66;
end;


::$P-
theorem
  for p,n,m being Nat st n <= p holds
    Aux/.[p,n,m] <= m
proof
end;
::$P+
