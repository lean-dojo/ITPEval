:: Statement-only formalization of Logipedia corpus artifact
:: exp.eq_exp_body_O (logipedia__mizar__exp.eq_exp_body_O), catalog title
:: "exp.eq_exp_body_O": for every natural base, the exponentiation body at
:: zero is Leibniz-equal to the successor of zero, namely one. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1, WAYBEL_4;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, ZFMISC_1,
    CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: The definite description is a fixed, unconstrained representative of the
:: source declaration exp_body, rather than a theorem-level quantifier.
definition
  func AuxBottom -> Function of NAT,Funcs(NAT,NAT) equals
    the Function of NAT,Funcs(NAT,NAT);
  coherence;
end;

::$P-
theorem
  for n being Nat holds
  for P being Subset of NAT st
    (AuxBottom.n).0 in P
  holds 1 in P
proof
end;
::$P+
