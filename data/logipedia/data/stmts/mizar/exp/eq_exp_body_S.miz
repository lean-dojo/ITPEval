:: Statement-only formalization of Logipedia corpus artifact
:: exp.eq_exp_body_S (logipedia__mizar__exp.eq_exp_body_S):
:: the successor exponentiation body is extensionally the previous power
:: multiplied by the base. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, RELAT_1, ARYTM_3, CARD_1, XXREAL_0,
    SUBSET_1, ARYTM_1, XBOOLE_0, ORDINAL1, NEWTON;
  notations ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, NEWTON;
  constructors REAL_1, XXREAL_0, NAT_1, NEWTON;
  registrations NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, ORDINAL1,
    NEWTON;
  requirements REAL, NUMERALS, SUBSET, ARITHM;

begin

::$P-
theorem
  for n,m being Nat holds n |^ (m+1) = (n |^ m) * n
proof
end;
::$P+
