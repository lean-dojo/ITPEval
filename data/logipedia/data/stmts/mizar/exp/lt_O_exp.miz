:: Statement-only formalization of Logipedia corpus artifact exp.lt_O_exp
:: (logipedia__mizar__exp.lt_O_exp), catalog title "exp.lt_O_exp": every
:: positive natural base has a positive natural power at every natural
:: exponent. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, RELAT_1, ARYTM_3, CARD_1, XXREAL_0,
    SUBSET_1, ARYTM_1, XBOOLE_0, ORDINAL1, NEWTON;
  notations ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0,
    NAT_1, NEWTON;
  constructors REAL_1, XXREAL_0, NAT_1, NEWTON;
  registrations NUMBERS, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, ORDINAL1,
    NEWTON;
  requirements REAL, NUMERALS, SUBSET, ARITHM;

begin

::$P-
theorem
  for n,m being Nat st 0 < n holds 0 < (n |^ m)
proof
end;
::$P+
