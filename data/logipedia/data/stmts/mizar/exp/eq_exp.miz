:: Statement-only formalization of Logipedia corpus artifact exp.eq_exp
:: (logipedia__mizar__exp.eq_exp), catalog title "exp.eq_exp": at every pair
:: of natural arguments, the fixed exponentiation function equals the fixed
:: natural-type filter applied to its fixed exponentiation body. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, FUNCT_3,
    PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1,
    MCART_1, WAYBEL_4, CARDFIL2, SUBSET_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: These definitions conservatively represent the three fixed source
:: declarations exp, exp_body, and filter_nat_type specialized to NAT.
definition
  func Aux -> Function of NAT,Funcs(NAT,NAT) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,NAT)),
      [:Funcs(NAT,Funcs(NAT,NAT)),
        Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,NAT)),
          [:Funcs(NAT,Funcs(NAT,NAT)),
            Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]:]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,NAT) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
    )).(
      (pr2(
        Funcs(NAT,Funcs(NAT,NAT)),
        [:Funcs(NAT,Funcs(NAT,NAT)),
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]
      )).(
        the Element of
          [:Funcs(NAT,Funcs(NAT,NAT)),
            [:Funcs(NAT,Funcs(NAT,NAT)),
              Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]:]
      )
    );
  coherence by FUNCT_2:66;

  func elementary_filter ->
      Function of Funcs(NAT,NAT),Funcs(NAT,NAT) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT))
    )).(
      (pr2(
        Funcs(NAT,Funcs(NAT,NAT)),
        [:Funcs(NAT,Funcs(NAT,NAT)),
          Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]
      )).(
        the Element of
          [:Funcs(NAT,Funcs(NAT,NAT)),
            [:Funcs(NAT,Funcs(NAT,NAT)),
              Funcs(Funcs(NAT,NAT),Funcs(NAT,NAT)):]:]
      )
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n,m being Nat holds
    (Aux.n).m = (elementary_filter.(AuxBottom.n)).m
proof
end;
::$P+
