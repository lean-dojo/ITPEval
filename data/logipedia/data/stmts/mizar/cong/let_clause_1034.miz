:: Statement-only formalization of Logipedia corpus artifact
:: "cong.let_clause_1034", catalog title "cong.let_clause_1034": Euclidean
:: quotient-remainder decomposition for arbitrary natural numbers, under the
:: source's positive-parameter assumption. The source quotient and remainder
:: are totalized at a zero divisor. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, SQUARE_1, SIN_COS,
    REAL_1, VALUED_0, INT_1, INT_2, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, INT_2, NAT_D,
    RELAT_1, SIN_COS, XXREAL_0;
  constructors REAL_1, SQUARE_1, NAT_1, NAT_D, SIN_COS, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    SIN_COS, VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

definition
  let n,m be Nat;
  func Aux(n,m) -> Nat equals
    n+1 if m = 0 otherwise n div m;
  correctness;

  func AuxBottom(n,m) -> Nat equals
    n if m = 0 otherwise n mod m;
  correctness;
end;

::$P-
theorem
  for n, m, p being Nat st 0 < p holds
    for x2515, x2516 being Nat holds
      x2515 =
        AuxBottom(x2515,x2516) +
        x2516 * Aux(x2515,x2516)
proof
end;
::$P+
