:: Statement-only formalization of Logipedia corpus artifact
:: primes.dividesb_false_to_not_divides
:: (logipedia__mizar__primes.dividesb_false_to_not_divides), catalog title
:: "primes.dividesb_false_to_not_divides": if the Boolean zero-remainder
:: divisibility test on natural numbers returns false, the proposed divisor
:: does not divide the number. The remainder branch at divisor zero follows
:: the source definition mod(m,0) = m. This file contains no proof.

environ
  vocabularies TARSKI, NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1,
    SUBSET_1, XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, SQUARE_1, SIN_COS, REAL_1, VALUED_0,
    INT_1, INT_2, MARGREL1, XBOOLEAN, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, ORDINAL1, NUMBERS,
    XCMPLX_0, XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1,
    INT_2, NAT_D, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1,
    SIN_COS, XXREAL_0, XBOOLEAN, MARGREL1;
  constructors REAL_1, SQUARE_1, NAT_1, NAT_D, SIN_COS, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, MARGREL1, ZFMISC_1, CARD_1, XBOOLEAN;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    SIN_COS, VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1, XBOOLE_0,
    SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2, XBOOLEAN, MARGREL1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for n,m being Nat st
    IFEQ(IFEQ(n,0,m,m mod n),0,TRUE,FALSE) = FALSE
  holds not n divides m
proof
end;
::$P+
