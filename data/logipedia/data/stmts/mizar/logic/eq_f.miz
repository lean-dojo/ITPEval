:: Statement-only formalization of Logipedia corpus artifact logic.eq_f
:: (logipedia__mizar__logic.eq_f), catalog title "logic.eq_f": every
:: function preserves Leibniz equality of its inputs. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A,B being set,
      f being Function of A,B,
      x,y being object st
    x in A & y in A
  holds
    (for P being Subset of A st x in P holds y in P)
    implies
    (for Q being Subset of B st f.x in Q holds f.y in Q)
proof
end;
::$P+
