:: Statement-only formalization of Logipedia corpus artifact logic.absurd,
:: catalog title "logic.absurd": every proposition together with the module's
:: abstract negation of it entails the module's abstract falsity proposition.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    MARGREL1, XBOOLEAN, ZFMISC_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, SUBSET_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, MARGREL1,
    ZFMISC_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, MARGREL1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET;
  equalities XBOOLEAN;

begin

:: These fixed choice terms reify the source module's opaque False proposition
:: and Not connective; neither is quantified as a theorem parameter.
definition
  func AuxBottom -> Element of BOOLEAN equals
    the Element of BOOLEAN;
  coherence;

  func Aux -> Function of BOOLEAN,BOOLEAN equals
    the Function of BOOLEAN,BOOLEAN;
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for A being Element of BOOLEAN holds
    A = TRUE implies
      (Aux.A = TRUE implies AuxBottom = TRUE)
proof
end;
::$P+
