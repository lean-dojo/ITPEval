:: Statement-only formalization of Logipedia corpus artifact logic.trans_eq
:: (logipedia__mizar__logic.trans_eq), catalog title "logic.trans_eq":
:: the logic module's polymorphic equality, represented by its equivalent
:: Leibniz predicate, is transitive. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1;
  constructors TARSKI, XBOOLE_0, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set, x,y,z being object st
    x in A & y in A & z in A
  holds
    (for P being Subset of A st x in P holds y in P) implies
    ((for P being Subset of A st y in P holds z in P) implies
     (for P being Subset of A st x in P holds z in P))
proof
end;
::$P+
