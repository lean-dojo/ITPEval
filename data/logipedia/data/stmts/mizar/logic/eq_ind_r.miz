:: Statement-only formalization of Logipedia corpus artifact logic.eq_ind_r
:: (logipedia__mizar__logic.eq_ind_r), catalog title "logic.eq_ind_r":
:: right-oriented equality induction transports an arbitrary unary predicate
:: from an element to any element equal to it. This file contains no proof.

environ
  vocabularies XBOOLE_0, SUBSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1;
  constructors TARSKI, XBOOLE_0, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set,
      a being Element of A,
      P being Subset of A st
    a in P
  holds for x being Element of A st x = a holds x in P
proof
end;
::$P+
