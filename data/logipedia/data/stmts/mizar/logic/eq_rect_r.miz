:: Statement-only formalization of Logipedia corpus artifact logic.eq_rect_r
:: (logipedia__mizar__logic.eq_rect_r), catalog title "logic.eq_rect_r":
:: equality from an element to a reference element transports an arbitrary
:: unary predicate from the reference element back to it. This file contains
:: no proof.

environ
  vocabularies XBOOLE_0, SUBSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1;
  constructors TARSKI, XBOOLE_0, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set,
      a,x being Element of A st
    x = a
  holds for P being Subset of A st a in P holds x in P
proof
end;
::$P+
