:: Statement-only formalization of Logipedia corpus artifact logic.rewrite_r
:: (logipedia__mizar__logic.rewrite_r), catalog title "logic.rewrite_r":
:: right-to-left equality substitution transports an arbitrary unary predicate
:: from one element to an equal element. This file contains no proof.

environ
  vocabularies XBOOLE_0, SUBSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1;
  constructors TARSKI, XBOOLE_0, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set,
      x being Element of A,
      P being Subset of A st
    x in P
  holds for y being Element of A st y = x holds y in P
proof
end;
::$P+
