:: Statement-only formalization of Logipedia corpus artifact logic.eq_f2
:: (logipedia__mizar__logic.eq_f2), catalog title "logic.eq_f2": every
:: curried binary function preserves Leibniz equality in both inputs. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ZFMISC_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A,B,C being set,
      f being Function of A,Funcs(B,C),
      x1,x2,y1,y2 being object st
    x1 in A & x2 in A & y1 in B & y2 in B
  holds
    (for P being Subset of A st x1 in P holds x2 in P)
    implies
    ((for Q being Subset of B st y1 in Q holds y2 in Q)
     implies
     (for R being Subset of C st (f.x1).y1 in R holds (f.x2).y2 in R))
proof
end;
::$P+
