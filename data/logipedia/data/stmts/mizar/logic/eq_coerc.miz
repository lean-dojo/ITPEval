:: Statement-only formalization of Logipedia corpus artifact logic.eq_coerc
:: (logipedia__mizar__logic.eq_coerc), catalog title "logic.eq_coerc":
:: equality of propositions transports truth from the first proposition to
:: the second. This file contains no proof.

environ
begin

::$P-
scheme LogicEqCoerc { SourceA[], SourceB[] } :
  SourceA[] implies
  ((SourceA[] iff SourceB[]) implies SourceB[])
proof
end;
::$P+
