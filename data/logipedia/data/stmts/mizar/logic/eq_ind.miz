:: Statement-only formalization of Logipedia corpus artifact logic.eq_ind
:: (logipedia__mizar__logic.eq_ind), catalog title "logic.eq_ind": equality
:: transports an arbitrary unary predicate from one element to an equal
:: element. This file contains no proof.

environ
  vocabularies XBOOLE_0, SUBSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1;
  constructors TARSKI, XBOOLE_0, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set,
      x being Element of A,
      P being Subset of A st
    x in P
  holds for y being Element of A st x = y holds y in P
proof
end;
::$P+
