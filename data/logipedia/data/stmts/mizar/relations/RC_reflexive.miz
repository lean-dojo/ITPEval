:: Statement-only formalization of Logipedia corpus artifact
:: relations.RC_reflexive (logipedia__mizar__relations.RC_reflexive), catalog
:: title "relations.RC_reflexive": adjoining equality to an arbitrary binary
:: relation yields a reflexive relation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
  constructors RELAT_1, RELSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set, R being Relation of A,A holds
    for x being object st x in A holds
      [x,x] in R or x = x
proof
end;
::$P+
