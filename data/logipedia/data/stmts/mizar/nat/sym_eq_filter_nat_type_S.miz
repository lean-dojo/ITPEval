:: Statement-only formalization of Logipedia corpus artifact
:: nat.sym_eq_filter_nat_type_S
:: (logipedia__mizar__nat.sym_eq_filter_nat_type_S), catalog title
:: "nat.sym_eq_filter_nat_type_S": for every result type, function on natural
:: numbers, and natural n, the function's value at the successor of n is
:: Leibniz-equal to the value there of the natural-type filter, represented
:: by the identity on the function space. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, NAT_1,
    NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, ZFMISC_1,
    CARD_1;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ORDINAL1,
    CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for A being set,
      returnFunc being Function of NAT,A,
      n being Nat
  holds returnFunc.(n+1) = ((id Funcs(NAT,A)).returnFunc).(n+1)
proof
end;
::$P+
