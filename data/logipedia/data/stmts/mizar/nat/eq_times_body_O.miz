:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_times_body_O (logipedia__mizar__nat.eq_times_body_O), catalog title
:: "nat.eq_times_body_O": the natural multiplication body at zero is
:: Leibniz-equal to the constant-zero function on natural numbers. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, FUNCT_6, PARTFUN1, FUNCOP_1, NAT_1, NUMBERS,
    CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1, MCART_1, BINOP_1, BINOP_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, FUNCT_5,
    FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, NAT_1, BINOP_1, BINOP_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    FUNCT_5, FUNCT_6, FUNCOP_1, NAT_1, ZFMISC_1, MCART_1, XTUPLE_0,
    CARD_1, SUBSET_1, BINOP_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, FUNCT_5, FUNCOP_1, ORDINAL1, CARD_1, NAT_1,
    XTUPLE_0;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  (curry multnat).0 = (NAT --> 0)
proof
end;
::$P+
