:: Statement-only formalization of Logipedia corpus artifact
:: nat.axiom_minus_body_S
:: (logipedia__mizar__nat.axiom_minus_body_S):
:: at every successor natural index, the fixed subtraction body is related by
:: the fixed source equality predicate to the natural matcher with successor
:: value at zero and the fixed subtraction function on successors.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, MARGREL1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin


:: Choice-selected definitions preserve the source module's fixed declarations
:: without adding equations or other assumptions about their interpretations.
:: Aux represents minus, AuxBottom represents minus_body, and
:: elementary_filter represents match_nat_type specialized to NAT.
definition
  func Aux -> Function of NAT,Funcs(NAT,NAT) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(NAT,Funcs(NAT,NAT))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,NAT)),
        Funcs(NAT,Funcs(NAT,NAT)):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,NAT) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(NAT,Funcs(NAT,NAT))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,NAT)),
        Funcs(NAT,Funcs(NAT,NAT)):]
    );
  coherence by FUNCT_2:66;
end;

definition
  func elementary_filter ->
      Function of [:NAT,Funcs(NAT,NAT),NAT:],NAT equals
    the Element of
      Funcs([:NAT,Funcs(NAT,NAT),NAT:],NAT);
  coherence by FUNCT_2:66;
end;


::$P-
theorem
  for n being Nat holds
    ex result being Function of NAT,NAT st
      (for m being Nat
        holds result.m = elementary_filter.[n+1,Aux.n,m]) &
      [AuxBottom.(n+1),result]
        in the Relation of Funcs(NAT,NAT),Funcs(NAT,NAT)
proof
end;
::$P+
