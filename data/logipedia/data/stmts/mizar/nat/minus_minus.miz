:: Statement-only formalization of Logipedia corpus artifact "nat.minus_minus",
:: catalog title "nat.minus_minus": for natural numbers p <= m <= n,
:: p + (n - m) equals n - (m - p), with truncated natural subtraction.
:: This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, REAL_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, NAT_1, INT_1, NAT_D, RELAT_1, XXREAL_0;
  constructors REAL_1, NAT_1, NAT_D, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    ORDINAL1, CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for n,m,p being Nat st
    p <= m & m <= n
  holds p + (n -' m) = n -' (m -' p)
proof
end;
::$P+
