:: Statement-only formalization of Logipedia corpus artifact nat.nat_elim2
:: (logipedia__mizar__nat.nat_elim2), catalog title "nat.nat_elim2":
:: two-dimensional natural-number elimination from the zero row, the
:: positive zero column, and simultaneous-successor closure. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, ORDINAL1,
    CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, NAT_1, ZFMISC_1, CARD_1;
  registrations XBOOLE_0, RELAT_1, RELSET_1, ORDINAL1, CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for R being Relation of NAT,NAT st
    (for n being Nat holds [0,n] in R) &
    (for n being Nat holds [n + 1,0] in R) &
    (for n,m being Nat st [n,m] in R holds [n + 1,m + 1] in R)
  holds for n,m being Nat holds [n,m] in R
proof
end;
::$P+
