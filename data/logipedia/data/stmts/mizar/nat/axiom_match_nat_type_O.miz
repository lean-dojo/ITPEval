:: Statement-only formalization of Logipedia corpus artifact
:: nat.axiom_match_nat_type_O. The polymorphic natural matcher selects its
:: zero branch at zero. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, FUNCT_3, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCOP_1,
    NAT_1, CARD_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCT_3, ORDINAL1, CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for T being non empty set,
      caseO being Element of T,
      caseS being Function of NAT,T
  holds IFEQ(0,0,caseO,caseS.0) = caseO
proof
end;
::$P+
