:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_eqb_body_O. The zero equality body and zero matcher are represented
:: pointwise by Mizar's native equality test. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, MARGREL1,
    XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, FUNCT_3, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, NAT_1, XBOOLEAN,
    MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCOP_1,
    NAT_1, MARGREL1, CARD_1, XBOOLEAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCT_3, ORDINAL1, CARD_1, NAT_1, XBOOLEAN, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for m being Nat holds
    IFEQ(0,m,TRUE,FALSE) = IFEQ(m,0,TRUE,FALSE)
proof
end;
::$P+
