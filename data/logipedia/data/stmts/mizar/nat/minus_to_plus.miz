:: Statement-only formalization of Logipedia corpus artifact nat.minus_to_plus:
:: for natural numbers n, m, and p, if m <= n and n minus m equals p, then
:: n equals m plus p. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XREAL_0, XXREAL_0, ARYTM_1, ARYTM_3;
  notations ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D;
  constructors NAT_1, NAT_D;
  registrations ORDINAL1, NUMBERS, XCMPLX_0, XREAL_0, XXREAL_0, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n, m, p being Nat st
    m <= n & n -' m = p
  holds n = m + p
proof
end;
::$P+
