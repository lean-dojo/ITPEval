:: Statement-only formalization of Logipedia corpus artifact nat.sym_eq_eqb
:: (logipedia__mizar__nat.sym_eq_eqb), catalog title "nat.sym_eq_eqb": for
:: every natural number, filtering the recursive Boolean equality body yields
:: the corresponding Boolean equality function. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, FUNCT_6, PARTFUN1, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1,
    WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, FUNCT_5,
    ORDINAL1, CARD_1, NUMBERS, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    FUNCT_5, FUNCT_6, NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0,
    CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, FUNCT_5, ORDINAL1, CARD_1, NAT_1, MARGREL1,
    XTUPLE_0;
  theorems FUNCT_2, FUNCT_6;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for n being Nat,
      P being Subset of Funcs(NAT,BOOLEAN)
    st chi({n},NAT) in P
  holds (curry chi(id NAT,[:NAT,NAT:])).n in P
proof
end;
::$P+
