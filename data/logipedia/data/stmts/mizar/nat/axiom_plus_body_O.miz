:: Statement-only formalization of Logipedia corpus artifact
:: nat.axiom_plus_body_O (logipedia__mizar__nat.axiom_plus_body_O),
:: catalog title "nat.axiom_plus_body_O": the natural addition body at zero
:: equals the identity function on natural numbers. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, FUNCT_6, PARTFUN1, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, ZFMISC_1, MCART_1, BINOP_1, BINOP_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, FUNCT_5,
    ORDINAL1, CARD_1, NUMBERS, NAT_1, BINOP_1, BINOP_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    FUNCT_5, FUNCT_6, NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1, BINOP_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, FUNCT_5, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  (curry addnat).0 = id NAT
proof
end;
::$P+
