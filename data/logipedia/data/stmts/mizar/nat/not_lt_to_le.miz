:: Statement-only formalization of Logipedia corpus artifact nat.not_lt_to_le
:: (logipedia__mizar__nat.not_lt_to_le), catalog title "nat.not_lt_to_le":
:: for arbitrary natural numbers n and m, if n is not strictly less than m,
:: then m is at most n. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    NAT_1;
  constructors NAT_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,m being Nat st not n < m holds m <= n
proof
end;
::$P+
