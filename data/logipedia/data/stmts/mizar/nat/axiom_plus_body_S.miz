:: Statement-only formalization of Logipedia corpus artifact
:: nat.axiom_plus_body_S (logipedia__mizar__nat.axiom_plus_body_S),
:: catalog title "nat.axiom_plus_body_S": at every successor natural index,
:: the addition body equals the function sending each natural m to the
:: successor of plus n m. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, XCMPLX_0, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XREAL_0, XXREAL_0,
    NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

:: These conservative definitions represent the fixed, independently
:: unconstrained source declarations plus and plus_body.
definition
  func Aux -> Function of NAT,Funcs(NAT,NAT) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(NAT,Funcs(NAT,NAT))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,NAT)),
          Funcs(NAT,Funcs(NAT,NAT)):]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,NAT) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(NAT,Funcs(NAT,NAT))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,NAT)),
          Funcs(NAT,Funcs(NAT,NAT)):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat holds
    ex plusAtN,result being Function of NAT,NAT st
      plusAtN = Aux.n &
      (for m being Nat holds result.m = plusAtN.m + 1) &
      AuxBottom.(n+1) = result
proof
end;
::$P+
