:: Statement-only formalization of Logipedia corpus artifact nat.lt_to_not_eq
:: (logipedia__mizar__nat.lt_to_not_eq), catalog title "nat.lt_to_not_eq":
:: strict inequality between natural numbers implies that they are unequal.
:: This file contains no proof.

environ

  vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    NAT_1;
  constructors NAT_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n,m being Nat st n < m holds n <> m
proof
end;
::$P+
