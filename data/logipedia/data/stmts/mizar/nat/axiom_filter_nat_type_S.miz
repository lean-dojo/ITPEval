:: Statement-only formalization of Logipedia corpus artifact
:: nat.axiom_filter_nat_type_S. For every result type and natural-indexed
:: function, the source natural-type filter preserves the value at each
:: successor. Mizar's definite-description term represents the fixed opaque
:: filter at each result type; it is not identified with the identity function.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, RELAT_1, FUNCT_1, FUNCT_2, NAT_1,
    NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, ZFMISC_1,
    CARD_1;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ORDINAL1,
    CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for A being set,
      returnFunc being Function of NAT,A,
      n being Nat
  holds
    ((the Function of Funcs(NAT,A),Funcs(NAT,A)).returnFunc).(n+1)
      = returnFunc.(n+1)
proof
end;
::$P+
