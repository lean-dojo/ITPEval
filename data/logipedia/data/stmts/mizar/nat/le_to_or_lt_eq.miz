:: Statement-only formalization of Logipedia corpus artifact
:: "nat.le_to_or_lt_eq" (logipedia__mizar__nat.le_to_or_lt_eq), catalog title
:: "nat.le_to_or_lt_eq": if two natural numbers satisfy n <= m, then
:: n < m or n = m. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, COMPLEX1, ARYTM_1, RELAT_1, SQUARE_1,
    REAL_1, VALUED_0, INT_1, INT_2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, COMPLEX1, REAL_1, SQUARE_1, NAT_1, INT_1, INT_2, NAT_D,
    RELAT_1, XXREAL_0;
  constructors REAL_1, SQUARE_1, NAT_1, NAT_D, RELSET_1;
  registrations RELSET_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    VALUED_0, SQUARE_1, ORDINAL1, CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for n,m being Nat st n <= m holds
    n < m or n = m
proof
end;
::$P+
