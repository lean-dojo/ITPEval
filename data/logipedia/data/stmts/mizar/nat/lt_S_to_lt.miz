:: Statement-only formalization of Logipedia corpus artifact nat.lt_S_to_lt
:: (logipedia__mizar__nat.lt_S_to_lt), catalog title "nat.lt_S_to_lt":
:: if the successor of one natural number is strictly less than another,
:: then the original natural number is strictly less. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for n, m being Nat st n + 1 < m holds n < m
proof
end;
::$P+
