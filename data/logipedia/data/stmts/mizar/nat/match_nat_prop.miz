:: Statement-only formalization of Logipedia corpus artifact
:: "nat.match_nat_prop". A predicate on the natural numbers that holds at zero
:: and at every successor holds for every natural number. This file contains
:: no proof.

environ

 vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1;
 constructors NAT_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for P being Subset of NAT st
    {} in P &
    (for n being Nat holds n + 1 in P)
  holds for z being Nat holds z in P
proof
end;
::$P+
