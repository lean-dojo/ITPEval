:: Statement-only formalization of Logipedia corpus artifact
:: nat.sym_eq_leb
:: (logipedia__mizar__nat.sym_eq_leb):
:: the fixed natural-type filter applied to the fixed less-than-or-equal body
:: is Leibniz-equal to the fixed less-than-or-equal function at every natural
:: index.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2,
    FUNCOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1, MARGREL1, SUBSET_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, PARTFUN1,
    FUNCT_3, NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1,
    XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin


:: Choice-selected definitions preserve the source module's
:: three independently fixed declarations without equations.
definition
  func Aux ->
      Function of NAT,Funcs(NAT,BOOLEAN) equals
    the Element of
      Funcs(NAT,Funcs(NAT,BOOLEAN));
  coherence by FUNCT_2:66;
end;

definition
  func AuxBottom ->
      Function of NAT,Funcs(NAT,BOOLEAN) equals
    the Element of
      Funcs(NAT,Funcs(NAT,BOOLEAN));
  coherence by FUNCT_2:66;
end;

definition
  func elementary_filter ->
      Function of
        Funcs(NAT,Funcs(NAT,BOOLEAN)),
        Funcs(NAT,Funcs(NAT,BOOLEAN)) equals
    the Element of
      Funcs(
        Funcs(NAT,Funcs(NAT,BOOLEAN)),
        Funcs(NAT,Funcs(NAT,BOOLEAN)));
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat,
      P being Subset of Funcs(NAT,BOOLEAN) st
    (elementary_filter.AuxBottom).n in P
  holds Aux.n in P
proof
end;
::$P+
