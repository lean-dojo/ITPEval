:: Statement-only formalization of Logipedia corpus artifact
:: nat.sym_eq_eqb_body_S (logipedia__mizar__nat.sym_eq_eqb_body_S), catalog
:: title "nat.sym_eq_eqb_body_S": for every natural n, the successor matcher
:: with false at zero and the Boolean equality test for n on predecessors is
:: Leibniz-equal to the Boolean natural-equality body at n+1. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCT_5, ORDINAL1,
    CARD_1, NUMBERS, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCT_5,
    NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, ORDINAL1, CARD_1, NAT_1, MARGREL1, XTUPLE_0;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for n being Nat,
      P being Subset of Funcs(NAT,BOOLEAN)
    st (curry chi(id NAT,[:NAT,NAT:])).(n+1) in P
  holds chi({n+1},NAT) in P
proof
end;
::$P+
