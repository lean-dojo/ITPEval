:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_leb_body_O (logipedia__mizar__nat.eq_leb_body_O), catalog title
:: "nat.eq_leb_body_O": the Boolean less-than-or-equal body at natural
:: zero is Leibniz-equal to the constant-true Boolean function on natural
:: numbers. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, MARGREL1,
    XBOOLEAN, XXREAL_0, XCMPLX_0, REAL_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, FUNCT_3, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XXREAL_0,
    NAT_1, INT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, NAT_1,
    MARGREL1, CARD_1, SUBSET_1, REAL_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1, XCMPLX_0, XXREAL_0,
    XREAL_0, INT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  chi({m where m is Nat : 0 <= m},NAT) = chi(NAT,NAT)
proof
end;
::$P+
