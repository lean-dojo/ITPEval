:: Statement-only formalization of Logipedia corpus artifact "nat.nat_ind",
:: catalog title "nat.nat_ind": every predicate on the natural numbers that
:: holds at zero and is preserved by successor holds for every natural number.
:: This file contains no proof.

environ

 vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3;
 notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1;
 constructors NAT_1;
 registrations XBOOLE_0, SUBSET_1, ORDINAL1, NAT_1;
 requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for Q being Subset of NAT st
    {} in Q &
    (for n being Nat st n in Q holds n + 1 in Q)
  holds for n being Nat holds n in Q
proof
end;
::$P+
