:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_minus_body_O (logipedia__mizar__nat.eq_minus_body_O), catalog title
:: "nat.eq_minus_body_O": Leibniz equality transports every predicate from
:: the abstract natural subtraction body at zero to the constant-zero natural
:: function. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: This conservative definition represents the fixed, opaque source
:: declaration minus_body.
definition
  func AuxBottom -> Function of NAT,Funcs(NAT,NAT) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,NAT)),
      Funcs(NAT,Funcs(NAT,NAT))
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,NAT)),
          Funcs(NAT,Funcs(NAT,NAT)):]
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  ex constantZero being Function of NAT,NAT st
    (for m being Nat holds constantZero.m = 0) &
    for P being Subset of Funcs(NAT,NAT) st AuxBottom.0 in P
    holds constantZero in P
proof
end;
::$P+
