:: Statement-only formalization of Logipedia corpus artifact
:: nat.sym_eq_minus_body_S (logipedia__mizar__nat.sym_eq_minus_body_S),
:: catalog title "nat.sym_eq_minus_body_S": at every successor natural
:: index, the zero/successor matcher built from truncated subtraction is
:: Leibniz-equal to the successor subtraction body. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1,
    XCMPLX_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, NAT_D;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, REAL_1,
    NAT_1, NAT_D, ZFMISC_1, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

:: The two witnesses are target-native lambda encodings. Their pointwise
:: equations expand match_nat_type, minus, and minus_body on standard
:: natural numbers; they are not additional unconstrained parameters.
::$P-
theorem
  for n being Nat holds
    ex matcher,minusBodyAtSuccessor being Function of NAT,NAT st
      (for m being Nat holds
        matcher.m = IFEQ(m,0,n+1,n -' (m -' 1))) &
      (for m being Nat holds
        minusBodyAtSuccessor.m = (n+1) -' m) &
      for P being Subset of Funcs(NAT,NAT) st matcher in P
      holds minusBodyAtSuccessor in P
proof
end;
::$P+
