:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_eqb_body_S (logipedia__mizar__nat.eq_eqb_body_S), catalog title
:: "nat.eq_eqb_body_S": at every successor natural index, the Boolean
:: equality body is Leibniz-equal to the natural matcher with false zero
:: branch and the preceding equality function as successor branch. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1,
    CARD_1, NUMBERS, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, MARGREL1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, MARGREL1, XTUPLE_0;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  equalities XBOOLEAN;

begin

:: Aux, AuxBottom, and elementary_filter are the Mizar names for the fixed
:: source constants eqb, eqb_body, and match_nat_type specialized to Boolean
:: results. The curried target type makes the final matcher application the
:: same function of the matched natural as the source lambda.
definition
  func Aux -> Function of NAT,Funcs(NAT,BOOLEAN) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,BOOLEAN)),
      [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
        Funcs(
          BOOLEAN,
          Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
        ):]
    )).(
      the Element of
        [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
          [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
            Funcs(
              BOOLEAN,
              Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
            ):]:]
    );
  coherence by FUNCT_2:66;

  func AuxBottom -> Function of NAT,Funcs(NAT,BOOLEAN) equals
    (pr1(
      Funcs(NAT,Funcs(NAT,BOOLEAN)),
      Funcs(
        BOOLEAN,
        Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
      )
    )).(
      (pr2(
        Funcs(NAT,Funcs(NAT,BOOLEAN)),
        [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
          Funcs(
            BOOLEAN,
            Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
          ):]
      )).(
        the Element of
          [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
            [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
              Funcs(
                BOOLEAN,
                Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
              ):]:]
      )
    );
  coherence by FUNCT_2:66;

  func elementary_filter ->
      Function of BOOLEAN,
        Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN)) equals
    (pr2(
      Funcs(NAT,Funcs(NAT,BOOLEAN)),
      Funcs(
        BOOLEAN,
        Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
      )
    )).(
      (pr2(
        Funcs(NAT,Funcs(NAT,BOOLEAN)),
        [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
          Funcs(
            BOOLEAN,
            Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
          ):]
      )).(
        the Element of
          [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
            [:Funcs(NAT,Funcs(NAT,BOOLEAN)),
              Funcs(
                BOOLEAN,
                Funcs(Funcs(NAT,BOOLEAN),Funcs(NAT,BOOLEAN))
              ):]:]
      )
    );
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for n being Nat,
      P being Subset of Funcs(NAT,BOOLEAN)
    st AuxBottom.(n+1) in P
  holds (elementary_filter.FALSE).(Aux.n) in P
proof
end;
::$P+
