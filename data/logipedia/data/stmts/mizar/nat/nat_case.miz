:: Statement-only formalization of Logipedia corpus artifact nat.nat_case
:: (logipedia__mizar__nat.nat_case), catalog title "nat.nat_case":
:: case analysis for a natural number, where zero and successor hypotheses
:: for an arbitrary predicate imply the predicate at that number. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, NAT_1;
  constructors NAT_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for n being Nat, P being Subset of NAT st
    (n = {} implies {} in P) &
    (for m being Nat holds n = m + 1 implies m + 1 in P)
  holds n in P
proof
end;
::$P+
