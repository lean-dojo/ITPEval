:: Statement-only formalization of Logipedia corpus artifact "nat.pred_Sn",
:: catalog title "nat.pred_Sn": the predecessor of the successor of every
:: natural number is that number. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1, INT_2, ORDINAL1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, INT_2, NAT_D;
  constructors REAL_1, NAT_1, NAT_D;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for n being Nat holds
    n = (n + 1) -' 1
proof
end;
::$P+
