:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_minus_body_S. The source successor subtraction body is unfolded
:: pointwise using Mizar's natural matcher and truncated subtraction.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1,
    XCMPLX_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCT_3, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, NAT_D;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCOP_1,
    REAL_1, NAT_1, NAT_D, ZFMISC_1, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for n,m being Nat holds
    (n+1) -' m = IFEQ(m,0,n+1,n -' (m-'1))
proof
end;
::$P+
