:: Statement-only formalization of Logipedia corpus artifact nat.minus_plus
:: (logipedia__mizar__nat.minus_plus), catalog title "nat.minus_plus":
:: for natural numbers, subtracting p after subtracting m from n equals
:: subtracting m + p from n, using truncated subtraction. This file contains
:: no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for n, m, p being Nat holds
    (n -' m) -' p = n -' (m + p)
proof
end;
::$P+
