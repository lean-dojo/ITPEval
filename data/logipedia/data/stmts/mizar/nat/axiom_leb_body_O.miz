:: Statement-only formalization of Logipedia corpus artifact
:: nat.axiom_leb_body_O. The zero less-than-or-equal body is constantly true.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, ZFMISC_1, XCMPLX_0, XXREAL_0;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCT_3, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS,
    XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, NAT_D, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCT_3, FUNCOP_1,
    REAL_1, NAT_1, NAT_D, MARGREL1, ZFMISC_1, CARD_1, XBOOLEAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCT_3, ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1,
    XBOOLEAN, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for m being Nat holds IFEQ(0-'m,0,TRUE,FALSE) = TRUE
proof
end;
::$P+
