:: Statement-only formalization of Logipedia corpus artifact
:: nat.le_plus_to_minus_r (logipedia__mizar__nat.le_plus_to_minus_r),
:: catalog title "nat.le_plus_to_minus_r": if a sum of natural numbers is at
:: most a third natural number, then the first summand is at most the
:: truncated difference of the third number and the second summand. This file
:: contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for a, b, c being Nat st a + b <= c holds
    a <= c -' b
proof
end;
::$P+
