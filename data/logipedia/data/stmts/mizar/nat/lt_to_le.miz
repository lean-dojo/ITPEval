:: Statement-only formalization of Logipedia corpus artifact nat.lt_to_le:
:: for all natural numbers x and y, x < y implies x <= y. This file contains
:: no proof.

environ

  vocabularies NUMBERS, NAT_1, XBOOLE_0, SUBSET_1, ORDINAL1, ARYTM_3,
    XCMPLX_0, XREAL_0, XXREAL_0;
  notations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0, XXREAL_0,
    NAT_1;
  constructors NAT_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, XCMPLX_0, XXREAL_0,
    XREAL_0, NAT_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for x,y being Nat st x < y holds x <= y
proof
end;
::$P+
