:: Statement-only formalization of Logipedia corpus artifact nat.plus_minus
:: (logipedia__mizar__nat.plus_minus), catalog title "nat.plus_minus":
:: for natural numbers m <= n, adding p to n - m equals subtracting m from
:: n + p, with truncated natural subtraction. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for m, n, p being Nat st m <= n holds
    (n -' m) + p = (n + p) -' m
proof
end;
::$P+
