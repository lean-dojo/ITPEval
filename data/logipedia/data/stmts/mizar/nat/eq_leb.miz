:: Statement-only formalization of Logipedia corpus artifact nat.eq_leb
:: (logipedia__mizar__nat.eq_leb), catalog title "nat.eq_leb": for every
:: pair of natural numbers, the Boolean less-than-or-equal function agrees
:: pointwise with its zero/successor recursive body after the natural-type
:: filter is unfolded as the identity. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, MARGREL1,
    XBOOLEAN, ZFMISC_1, XXREAL_0, XCMPLX_0, INT_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NAT_D, XBOOLEAN, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, REAL_1,
    NAT_1, NAT_D, MARGREL1, ZFMISC_1, CARD_1, XBOOLEAN;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED,
    INT_1, XBOOLEAN, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for n,m being Nat holds
    IFEQ(n -' m,0,TRUE,FALSE) =
      IFEQ(n,0,TRUE,
        IFEQ(m,0,FALSE,
          IFEQ((n -' 1) -' (m -' 1),0,TRUE,FALSE)))
proof
end;
::$P+
