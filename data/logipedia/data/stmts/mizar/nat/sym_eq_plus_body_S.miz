:: Statement-only formalization of Logipedia corpus artifact
:: nat.sym_eq_plus_body_S (logipedia__mizar__nat.sym_eq_plus_body_S),
:: catalog title "nat.sym_eq_plus_body_S": for every natural n, the function
:: sending m to the successor of n plus m is Leibniz-equal to the natural
:: addition body at the successor of n. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, FUNCT_6, PARTFUN1, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, ZFMISC_1, MCART_1, BINOP_1, BINOP_2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, FUNCT_5,
    ORDINAL1, CARD_1, NUMBERS, NAT_1, BINOP_1, BINOP_2;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    FUNCT_5, FUNCT_6, NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1, BINOP_1, BINOP_2;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, FUNCT_5, ORDINAL1, CARD_1, NAT_1, XTUPLE_0;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: Curried addnat is the target-native counterpart of the fixed source
:: constants plus and plus_body. Its section at n is m |-> n+m, while the
:: section of curry' addnat at 1 is the successor function. Native equality
:: of these total functions is equivalent to their directed Leibniz equality.
::$P-
theorem
  for n being Nat holds
    ((curry' addnat).1) * ((curry addnat).n)
      = (curry addnat).(n + 1)
proof
end;
::$P+
