:: Statement-only formalization of Logipedia corpus artifact
:: nat.eq_match_nat_type_O
:: (logipedia__mizar__nat.eq_match_nat_type_O), catalog title
:: "nat.eq_match_nat_type_O": for every result type, zero branch, and
:: successor branch, the polymorphic natural matcher at zero is
:: Leibniz-equal to the zero branch. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, FUNCOP_1, ORDINAL1, CARD_1, NUMBERS, NAT_1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, NAT_1,
    ZFMISC_1, CARD_1, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NAT_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

::$P-
theorem
  for T being non empty set,
      caseO being Element of T,
      caseS being Function of NAT,T
  holds
    for P being Subset of T st
      IFEQ(0,0,caseO,caseS.0) in P
    holds caseO in P
proof
end;
::$P+
