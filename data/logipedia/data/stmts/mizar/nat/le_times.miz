:: Statement-only formalization of Logipedia corpus artifact nat.le_times
:: (logipedia__mizar__nat.le_times), catalog title "nat.le_times":
:: multiplication on natural numbers preserves the less-than-or-equal order
:: in both arguments. This file contains no proof.

environ
  vocabularies NUMBERS, NAT_1, XBOOLE_0, ARYTM_3, CARD_1, SUBSET_1,
    XXREAL_0, XCMPLX_0, ARYTM_1, RELAT_1, INT_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, NAT_D;
  constructors REAL_1, NAT_1, NAT_D;
  registrations XCMPLX_0, XXREAL_0, XREAL_0, NAT_1, MEMBERED, ORDINAL1,
    CARD_1, INT_1;
  requirements NUMERALS, SUBSET, REAL, ARITHM, BOOLE;

begin

::$P-
theorem
  for n1, n2, m1, m2 being Nat st
    n1 <= n2 & m1 <= m2
  holds n1 * m1 <= n2 * m2
proof
end;
::$P+
