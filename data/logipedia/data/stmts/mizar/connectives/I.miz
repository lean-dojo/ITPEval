  requirements BOOLE, SUBSET;
  equalities XBOOLEAN;

begin

:: This Boolean is one fixed representative of the source module's opaque
:: proposition True; it is not a theorem-level parameter.
definition
  func AuxBottom -> Element of BOOLEAN equals
    the Element of BOOLEAN;
  coherence;
end;

::$P-
theorem
  AuxBottom = TRUE
proof
end;
::$P+
