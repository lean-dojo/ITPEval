:: Statement-only formalization of Logipedia corpus artifact
:: connectives.match_Or_prop, catalog title "connectives.match_Or_prop":
:: disjunction elimination derives an arbitrary return proposition from
:: handlers for each disjunct. This file contains no proof.

environ
begin

::$P-
scheme ConnectivesMatchOrProp {
  SourceA[], SourceB[], SourceReturn[]
} :
  (SourceA[] implies SourceReturn[]) implies
  ((SourceB[] implies SourceReturn[]) implies
    ((SourceA[] or SourceB[]) implies SourceReturn[]))
proof
end;
::$P+
