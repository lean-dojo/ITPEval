:: Statement-only formalization of Logipedia corpus artifact
:: connectives.match_And_prop, catalog title "connectives.match_And_prop":
:: the conjunction-elimination rule applies a continuation consuming both
:: conjuncts to their conjunction. This file contains no proof.

environ
begin

::$P-
scheme ConnectivesMatchAndProp {
  SourceA[], SourceB[], SourceReturn[]
} :
  (SourceA[] implies (SourceB[] implies SourceReturn[])) implies
  ((SourceA[] & SourceB[]) implies SourceReturn[])
proof
end;
::$P+
