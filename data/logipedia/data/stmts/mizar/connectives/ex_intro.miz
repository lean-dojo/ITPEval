:: Statement-only formalization of Logipedia corpus artifact connectives.ex_intro
:: (logipedia__mizar__connectives.ex_intro), catalog title
:: "connectives.ex_intro": existential introduction for an arbitrary predicate
:: on an arbitrary type. This file contains no proof.

environ
  vocabularies XBOOLE_0, SUBSET_1;
  notations TARSKI, XBOOLE_0, SUBSET_1;
  constructors TARSKI, XBOOLE_0, SUBSET_1;
  registrations XBOOLE_0, SUBSET_1;
  requirements BOOLE, SUBSET;

begin

::$P-
theorem
  for A being set, P being Subset of A, x being object st x in P
  holds ex y being object st y in P
proof
end;
::$P+
