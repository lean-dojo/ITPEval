:: Statement-only formalization of Logipedia corpus artifact connectives.Not_ind,
:: catalog title "connectives.Not_ind": the source's fixed opaque False
:: proposition and Not connective support elimination into any proposition.
:: Boolean truth values reify source propositions without identifying the
:: opaque Not connective with Mizar's native negation. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    MARGREL1, XBOOLEAN, ZFMISC_1, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, SUBSET_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, MARGREL1, ZFMISC_1,
    SUBSET_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    MARGREL1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET;
  equalities XBOOLEAN;

begin

:: Mizar has no standalone declaration form for an uninterpreted proposition
:: or propositional operator. These choice terms denote one fixed Boolean and
:: one fixed Boolean endofunction, matching the source module's fixed opaque
:: False and Not symbols without imposing any truth table on them.
definition
  func AuxBottom -> Element of BOOLEAN equals
    the Element of BOOLEAN;
  coherence;

  func Aux -> Function of BOOLEAN,BOOLEAN equals
    the Function of BOOLEAN,BOOLEAN;
  coherence by FUNCT_2:66;
end;

::$P-
theorem
  for A,Q being Element of BOOLEAN holds
    (((A = TRUE implies AuxBottom = TRUE) implies Q = TRUE)
      implies
      (Aux.A = TRUE implies Q = TRUE))
proof
end;
::$P+
