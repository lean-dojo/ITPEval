:: Statement-only formalization of Logipedia corpus artifact
:: connectives.equal_leibniz, catalog title "connectives.equal_leibniz":
:: the module's abstract equality relation transports every unary predicate
:: from its first related element to its second. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, ZFMISC_1, WAYBEL_4,
    CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, SUBSET_1, RELAT_1,
    RELSET_1;
  constructors ZFMISC_1, RELAT_1, RELSET_1, XTUPLE_0;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, XTUPLE_0;
  requirements BOOLE, SUBSET;

begin

:: One fixed choice-selected relation on each carrier represents the source
:: module's opaque polymorphic equal symbol. The statement below supplies its
:: directed Leibniz law; it does not identify the relation with native
:: equality or quantify over arbitrary relations.
definition
  let A be non empty set;
  func Aux(A) -> Relation of A equals
    the Relation of A;
  coherence;
end;

::$P-
theorem
  for A being non empty set,
      x,y being Element of A st
    [x,y] in Aux(A)
  holds for P being Subset of A st x in P holds y in P
proof
end;
::$P+
