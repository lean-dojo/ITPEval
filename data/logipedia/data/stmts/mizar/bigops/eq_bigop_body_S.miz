:: Statement-only formalization of Logipedia corpus artifact
:: bigops.eq_bigop_body_S (logipedia__mizar__bigops.eq_bigop_body_S),
:: catalog title "bigops.eq_bigop_body_S": at every successor natural
:: index, the fixed big-operation body equals the Boolean-controlled
:: recursive curried function built from the fixed big operation.
:: This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0, MARGREL1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for H being set, n being Nat holds ex z being set st
    z in Funcs(
      Funcs(NAT,BOOLEAN),
      Funcs(H,
        Funcs(
          Funcs(H,Funcs(H,H)),
          Funcs(Funcs(NAT,H),H)
        )
      )
    ) &
    (for p,nil,op,f being set st
      p in Funcs(NAT,BOOLEAN) &
      nil in H &
      op in Funcs(H,Funcs(H,H)) &
      f in Funcs(NAT,H)
    holds ex zp,zpn,zpno,b,bp,bpn,bpno,fn,opfn,r,y being set st
      [p,zp] in z &
      [nil,zpn] in zp &
      [op,zpno] in zpn &
      [n,b] in
        (pr1(
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          )
        )).(
          the Element of
            [:Funcs(NAT,
                Funcs(
                  Funcs(NAT,BOOLEAN),
                  Funcs(H,
                    Funcs(
                      Funcs(H,Funcs(H,H)),
                      Funcs(Funcs(NAT,H),H)
                    )
                  )
                )
              ),
              Funcs(NAT,
                Funcs(
                  Funcs(NAT,BOOLEAN),
                  Funcs(H,
                    Funcs(
                      Funcs(H,Funcs(H,H)),
                      Funcs(Funcs(NAT,H),H)
                    )
                  )
                )
              ):]
        ) &
      [p,bp] in b &
      [nil,bpn] in bp &
      [op,bpno] in bpn &
      [f,r] in bpno &
      [n,fn] in f &
      [fn,opfn] in op &
      (([n,TRUE] in p & [r,y] in opfn) or
       ([n,FALSE] in p & y = r)) &
      [f,y] in zpno) &
    ((pr2(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    )).(n+1) = z
proof
end;
::$P+
