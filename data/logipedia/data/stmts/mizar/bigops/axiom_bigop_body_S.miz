:: Statement-only formalization of Logipedia corpus artifact
:: bigops.axiom_bigop_body_S, catalog title "bigops.axiom_bigop_body_S":
:: at every successor natural index, the fixed big-operation body equals
:: the Boolean-controlled recursive curried function built from the fixed
:: big operation. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0, MARGREL1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;
  equalities XBOOLEAN;

begin

:: These conservative definitions name the two fixed source declarations
:: bigop and bigop_body at their exact H-indexed higher-order type.
definition
  let H be set;
  func Aux(H) -> Function of NAT,
      Funcs(
        Funcs(NAT,BOOLEAN),
        Funcs(H,
          Funcs(
            Funcs(H,Funcs(H,H)),
            Funcs(Funcs(NAT,H),H)
          )
        )
      ) equals
    (pr1(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    );
  coherence
  proof
    set X =
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      );
    A1: X is non empty
    proof
      per cases;
      suppose H = {};
        then reconsider H as empty set;
        set E = Funcs(NAT,H);
        reconsider E as empty set;
        E = H;
        then reconsider C = Funcs(E,H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
      suppose H <> {};
        then reconsider H as non empty set;
        reconsider C = Funcs(Funcs(NAT,H),H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
    end;
    reconsider X as non empty set by A1;
    reconsider p = the Element of [:X,X:] as Element of [:X,X:];
    reconsider f = (pr1(X,X)).p as Element of X;
    f in X;
    hence thesis by FUNCT_2:66;
  end;

  func AuxBottom(H) -> Function of NAT,
      Funcs(
        Funcs(NAT,BOOLEAN),
        Funcs(H,
          Funcs(
            Funcs(H,Funcs(H,H)),
            Funcs(Funcs(NAT,H),H)
          )
        )
      ) equals
    (pr2(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    );
  coherence
  proof
    set X =
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      );
    A1: X is non empty
    proof
      per cases;
      suppose H = {};
        then reconsider H as empty set;
        set E = Funcs(NAT,H);
        reconsider E as empty set;
        E = H;
        then reconsider C = Funcs(E,H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
      suppose H <> {};
        then reconsider H as non empty set;
        reconsider C = Funcs(Funcs(NAT,H),H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
    end;
    reconsider X as non empty set by A1;
    reconsider p = the Element of [:X,X:] as Element of [:X,X:];
    reconsider f = (pr2(X,X)).p as Element of X;
    f in X;
    hence thesis by FUNCT_2:66;
  end;
end;

:: Every relation traversed below is an element of a Funcs space.  Thus each
:: pair-membership witness is the unique value of a total function application,
:: rather than an unconstrained existential.  Universally quantifying all four
:: curried inputs is the Mizar graph form of the source functional equality.
::$P-
theorem
  for H being set,
      n being Nat,
      p,nil,op,f being set st
    p in Funcs(NAT,BOOLEAN) &
    nil in H &
    op in Funcs(H,Funcs(H,H)) &
    f in Funcs(NAT,H)
  holds ex sbp,sbpn,sbpno,bp,bpn,bpno,r,fn,opfn,y being set st
    [p,sbp] in (AuxBottom(H)).(n+1) &
    [nil,sbpn] in sbp &
    [op,sbpno] in sbpn &
    [f,y] in sbpno &
    [p,bp] in (Aux(H)).n &
    [nil,bpn] in bp &
    [op,bpno] in bpn &
    [f,r] in bpno &
    [n,fn] in f &
    [fn,opfn] in op &
    (([n,TRUE] in p & [r,y] in opfn) or
     ([n,FALSE] in p & y = r))
proof
end;
::$P+
