:: Statement-only formalization of Logipedia corpus artifact
:: bigops.sym_eq_bigop_S, catalog title "bigops.sym_eq_bigop_S": for every
:: carrier type and successor index, the designated polymorphic bigop_body
:: and bigop constants are Leibniz-equal as whole curried functions. This
:: file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2, MARGREL1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: For each H, the two projections of this single fixed choice pair represent
:: the designated constants bigop and bigop_body at their exact H-indexed
:: higher-order type; they are not theorem variables.
::$P-
theorem
  for H being set, n being Nat holds
    ((pr2(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    )).(n+1)
    =
    ((pr1(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    )).(n+1)
proof
end;
::$P+
