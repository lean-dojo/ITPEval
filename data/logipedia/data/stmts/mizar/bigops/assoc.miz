:: Statement-only formalization of Logipedia corpus artifact bigops.assoc,
:: catalog title "bigops.assoc". Multiplication on natural numbers is
:: associative. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, NAT_1, ORDINAL1, XCMPLX_0, XREAL_0, XXREAL_0, ARYTM_1,
    ARYTM_3, CARD_1, INT_1, BINOP_1, BINOP_2, VALUED_0, VALUED_1;
  notations TARSKI, XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NAT_D, BINOP_1, BINOP_2, VALUED_0, VALUED_1;
  constructors XCMPLX_0, XREAL_0, XXREAL_0, NAT_1, INT_1, RELSET_1,
    FUNCT_2, NAT_D, BINOP_1, BINOP_2, VALUED_1;
  registrations XBOOLE_0, SUBSET_1, ORDINAL1, NUMBERS, XCMPLX_0,
    XREAL_0, XXREAL_0, NAT_1, INT_1, FUNCT_1, RELSET_1, FUNCT_2,
    MEMBERED, VALUED_0, VALUED_1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a, b, c being Nat holds
    a * (b * c) = (a * b) * c
proof
end;
::$P+
