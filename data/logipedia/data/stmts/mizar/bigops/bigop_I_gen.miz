:: Statement-only formalization of Logipedia corpus artifact
:: bigops.bigop_I_gen, catalog title "bigops.bigop_I_gen": shifting a
:: Boolean-filtered finite product from an initial segment to the half-open
:: natural interval from a to b preserves its value. This file contains no
:: proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NUMBERS, XREAL_0, XCMPLX_0, COMPLEX1, CARD_1, XXREAL_0, ARYTM_1,
    ARYTM_3, REAL_1, INT_1, NAT_1, VALUED_0, VALUED_1, FINSEQ_1,
    FINSEQ_2, ORDINAL1, CARD_3, RVSUM_1, MARGREL1, XBOOLEAN;
  notations TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0, REAL_1,
    INT_1, COMPLEX1, XXREAL_0, PARTFUN1, FINSEQ_1, FINSEQ_2,
    VALUED_0, VALUED_1, NAT_1, NAT_D, RVSUM_1, MARGREL1;
  constructors FUNCT_1, PARTFUN1, RELSET_1, FUNCT_2, REAL_1, COMPLEX1,
    INT_1, XXREAL_0, NAT_1, NAT_D, FINSEQ_2, RVSUM_1, FINSEQOP,
    MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1,
    FUNCT_2, NUMBERS, CARD_1, XXREAL_0, MEMBERED, VALUED_0, VALUED_1,
    XCMPLX_0, XREAL_0, ORDINAL1, NAT_1, INT_1, FINSEQ_1, FINSEQ_2,
    RVSUM_1, MARGREL1;
  requirements REAL, NUMERALS, SUBSET, BOOLE, ARITHM;

begin

::$P-
theorem
  for a,b being Nat,
      p being Function of NAT,BOOLEAN,
      f being Function of NAT,NAT,
      left,right being FinSequence of REAL st
    a <= b &
    len left = b-'a &
    (for k being Nat st k in dom left holds
      (p.((k-'1)+a) = TRUE implies
        left.k = f.((k-'1)+a)) &
      (p.((k-'1)+a) = FALSE implies
        left.k = 1)) &
    len right = b &
    (for k being Nat st k in dom right holds
      ((a <= k-'1 & p.(k-'1) = TRUE) implies
        right.k = f.(k-'1)) &
      ((k-'1 < a or p.(k-'1) = FALSE) implies
        right.k = 1))
  holds
    (Product left) = (Product right)
proof
end;
::$P+
