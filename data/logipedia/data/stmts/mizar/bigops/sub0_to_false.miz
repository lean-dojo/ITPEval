:: Statement-only formalization of Logipedia corpus artifact
:: bigops.sub0_to_false, catalog title "bigops.sub0_to_false": if a
:: Boolean-selected index embedding targets a zero-sized range, then the
:: selector is false below its bound. This file contains no proof.

environ
  vocabularies TARSKI, RELAT_1, FUNCT_1, FUNCT_2, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, MARGREL1, XBOOLEAN, XXREAL_0;
  notations TARSKI, XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XXREAL_0, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, MARGREL1,
    CARD_1, XXREAL_0;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ORDINAL1,
    CARD_1, XXREAL_0, NAT_1, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for h,k,f1,f2 being Function of NAT,NAT,
      n1,n2 being Nat,
      p1,p2 being Function of NAT,BOOLEAN st
    n1 = 0 &
    (for i being Nat st i < n2 & p2.i = TRUE holds
      h.i < n1 & p1.(h.i) = TRUE & k.(h.i) = i)
  holds for i being Nat st i < n2 holds p2.i = FALSE
proof
end;
::$P+
