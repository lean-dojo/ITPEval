:: Statement-only formalization of Logipedia corpus artifact bigops.mk_ACop,
:: catalog title "bigops.mk_ACop": a binary operation with a two-sided
:: identity, associativity, and commutativity implies that the identity has
:: the source's fixed opaque ACop predicate. The definite-description subset
:: is Mizar's representative of that predicate. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    ZFMISC_1, BINOP_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, SUBSET_1, RELAT_1, FUNCT_1,
    RELSET_1, FUNCT_2, BINOP_1;
  constructors ZFMISC_1, RELSET_1, FUNCT_1, FUNCT_2, BINOP_1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, RELSET_1, FUNCT_2;
  requirements SUBSET, BOOLE;

begin

::$P-
theorem
  for A being non empty set,
      nil being Element of A,
      op being BinOp of A st
    (for a being Element of A holds op.(nil,a) = a) &
    (for a being Element of A holds op.(a,nil) = a) &
    (for a,b,c being Element of A holds
      op.(a,op.(b,c)) = op.(op.(a,b),c)) &
    (for a,b being Element of A holds op.(a,b) = op.(b,a))
  holds nil in the Subset of A
proof
end;
::$P+
