:: Statement-only formalization of Logipedia corpus artifact
:: bigops.transitive_sub, catalog title "bigops.transitive_sub": transitivity
:: of Boolean-selected natural-number index embeddings under composition of
:: their forward and backward maps. This file contains no proof.

environ
  vocabularies TARSKI, RELAT_1, FUNCT_1, FUNCT_2, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, MARGREL1, XBOOLEAN, XXREAL_0;
  notations TARSKI, XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NUMBERS, XXREAL_0, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, MARGREL1,
    CARD_1, XXREAL_0;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ORDINAL1,
    CARD_1, XXREAL_0, NAT_1, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

::$P-
theorem
  for h1,k1,h2,k2 being Function of NAT,NAT,
      n1,n2,n3 being Nat,
      p1,p2,p3 being Function of NAT,BOOLEAN,
      f1,f2,f3 being Function of NAT,NAT st
    (for i being Nat st i < n1 holds
      p1.i = TRUE implies
        h1.i < n2 &
        p2.(h1.i) = TRUE &
        k1.(h1.i) = i) &
    (for i being Nat st i < n2 holds
      p2.i = TRUE implies
        h2.i < n3 &
        p3.(h2.i) = TRUE &
        k2.(h2.i) = i)
  holds
    for i being Nat st i < n1 holds
      p1.i = TRUE implies
        h2.(h1.i) < n3 &
        p3.(h2.(h1.i)) = TRUE &
        k1.(k2.(h2.(h1.i))) = i
proof
end;
::$P+
