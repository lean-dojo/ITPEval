:: Statement-only formalization of Logipedia corpus artifact
:: bigops.sym_eq_bigop_O, catalog title "bigops.sym_eq_bigop_O": directed
:: Leibniz equality at natural index zero from the fixed Boolean-filtered
:: big-operation body to the fixed big-operation function. Their zero clauses
:: are the common curried function returning the nil argument. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, FUNCT_5, FUNCT_6, FUNCOP_1, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, ZFMISC_1, MCART_1, MARGREL1, WAYBEL_4,
    CARDFIL2;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, SUBSET_1,
    RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, FUNCT_3, FUNCT_5,
    ORDINAL1, CARD_1, NUMBERS, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, FUNCOP_1, FUNCT_3,
    FUNCT_5, FUNCT_6, NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1,
    SUBSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    FUNCOP_1, FUNCT_3, FUNCT_5, ORDINAL1, CARD_1, NAT_1, XTUPLE_0,
    MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: The repeated target-native term is the exact zero clause of each fixed
:: source family. The inner curried projection returns nil and ignores the
:: operation and sequence arguments; the outer constant function ignores the
:: Boolean predicate argument.
::$P-
theorem
  for H being set,
      P being Subset of
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(
            H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        ) st
    (Funcs(NAT,BOOLEAN) -->
      curry(
        (curry pr1(H,Funcs(NAT,H))) *
          pr1(H,Funcs(H,Funcs(H,H)))
      )) in P
  holds
    (Funcs(NAT,BOOLEAN) -->
      curry(
        (curry pr1(H,Funcs(NAT,H))) *
          pr1(H,Funcs(H,Funcs(H,H)))
      )) in P
proof
end;
::$P+
