:: Statement-only formalization of Logipedia corpus artifact
:: bigops.sym_eq_bigop_body_S, catalog title "bigops.sym_eq_bigop_body_S":
:: at each successor index, the fixed big-operation body is the direct
:: Boolean-controlled recursive step of the fixed big operation.
:: This file contains no proof of the stated theorem.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3, MARGREL1, XBOOLEAN,
    CARDFIL2, WAYBEL_4, BINOP_1, XXREAL_0, INT_1, XCMPLX_0, REAL_1,
    ZFMISC_1, PARTFUN1, POWER;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    PARTFUN1, FUNCT_2, ORDINAL1, CARD_1, NUMBERS, XCMPLX_0, XREAL_0,
    INT_1, NAT_1, NAT_D, SUBSET_1, MARGREL1, BINOP_1, XXREAL_0;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, SUBSET_1,
    MARGREL1, BINOP_1, XXREAL_0, REAL_1, NAT_D, MEMBERED;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    ORDINAL1, CARD_1, NAT_1, MARGREL1, XXREAL_0, XREAL_0, INT_1;
  schemes NAT_1, RECDEF_1;
  theorems FUNCT_2, SUBSET_1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

definition
  let H be non empty set;
  let b be Element of BOOLEAN;
  let x,y be Element of H;
  func Aux(b,x,y) -> Element of H equals
    x if b = TRUE otherwise y;
  correctness;
end;

:: Mizar's BinOp is the uncurried representation of the source operation
:: H -> H -> H. BigOp is a fixed recursively defined sequence, rather than
:: an arbitrary function selected from a nonempty function space.
definition
  let H be non empty set;
  let p be Function of NAT,BOOLEAN;
  let nil be Element of H;
  let op be BinOp of H;
  let f be Function of NAT,H;
  func Aux(p,nil,op,f) -> sequence of H means
  :DefBigOp:
    it.0 = nil &
    for n being Nat holds
      it.(n+1) = Aux(p.n,op.(f.n,it.n),it.n);
  existence
  proof
    defpred P[Nat,Element of H,Element of H] means
      $3 = Aux(p.$1,op.(f.$1,$2),$2);
A0: for n being Nat for x being Element of H
      ex y being Element of H st P[n,x,y]
    proof
      let n be Nat;
      let x be Element of H;
      take Aux(p.n,op.(f.n,x),x);
      thus thesis;
    end;
    consider g being sequence of H such that
A1: g.0 = nil and
A2: for n being Nat holds P[n,g.n,g.(n+1)]
      from RECDEF_1:sch 2(A0);
    take g;
    thus g.0 = nil by A1;
    let n be Nat;
    thus thesis by A2;
  end;
  uniqueness
  proof
    let g1,g2 be sequence of H such that
A1: g1.0 = nil and
A2: for n being Nat holds
      g1.(n+1) = Aux(p.n,op.(f.n,g1.n),g1.n) and
A3: g2.0 = nil and
A4: for n being Nat holds
      g2.(n+1) = Aux(p.n,op.(f.n,g2.n),g2.n);
    defpred Q[Nat] means g1.$1 = g2.$1;
A5: Q[0] by A1,A3;
A6: for n being Nat st Q[n] holds Q[n+1]
    proof
      let n be Nat;
      assume
A7:   g1.n = g2.n;
      thus g1.(n+1) = Aux(p.n,op.(f.n,g1.n),g1.n) by A2
        .= Aux(p.n,op.(f.n,g2.n),g2.n) by A7
        .= g2.(n+1) by A4;
    end;
A8: for n being Nat holds Q[n] from NAT_1:sch 2(A5,A6);
    for n being Element of NAT holds g1.n = g2.n by A8;
    hence g1 = g2 by FUNCT_2:63;
  end;
end;

:: The five-argument overload is the fixed indexed BigOpBody representation.
:: The source axioms identify bigop_body extensionally with bigop, so this
:: definitional form preserves that constant without an external witness.
definition
  let H be non empty set;
  let p be Function of NAT,BOOLEAN;
  let nil be Element of H;
  let op be BinOp of H;
  let f be Function of NAT,H;
  let n be Nat;
  func Aux(p,nil,op,f,n) -> Element of H equals
    (Aux(p,nil,op,f)).n;
  coherence;
end;

::$P-
theorem
  for H being non empty set,
      n being Nat,
      p being Function of NAT,BOOLEAN,
      nil being Element of H,
      op being BinOp of H,
      f being Function of NAT,H
  holds
    Aux(p.n,
      op.(f.n,(Aux(p,nil,op,f)).n),
      (Aux(p,nil,op,f)).n)
    = Aux(p,nil,op,f,n+1)
proof
end;
::$P+
