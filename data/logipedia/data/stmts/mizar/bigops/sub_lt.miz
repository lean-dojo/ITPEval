:: Statement-only formalization of Logipedia corpus artifact bigops.sub_lt
:: (logipedia__mizar__bigops.sub_lt), catalog title "bigops.sub_lt":
:: inclusion of natural-number bounds preserves Boolean-selected indices
:: under both identity index maps in the source sub_hk relation. This file
:: contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, FUNCT_1,
    FUNCT_2, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    MARGREL1, XBOOLEAN, XXREAL_0, WAYBEL_4, CARDFIL2;
  notations TARSKI, XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, RELSET_1,
    FUNCT_1, FUNCT_2, PARTFUN1, ORDINAL1, CARD_1, NUMBERS, XXREAL_0,
    NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, SUBSET_1,
    ZFMISC_1, NAT_1, MARGREL1, CARD_1, XXREAL_0;
  registrations XBOOLE_0, SUBSET_1, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, PARTFUN1, ORDINAL1, CARD_1, XXREAL_0, NAT_1, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;
  equalities XBOOLEAN;

begin

definition
  func Aux -> Function of NAT,NAT equals
    id NAT;
  coherence;
end;

:: This is the exact unfolding of the authoritative source definition of
:: sub_hk with h = k = id. Its final two natural-valued function arguments
:: are retained as the quantified e,e below, although the source definition
:: itself intentionally does not inspect those two arguments.
::$P-
theorem
  for e being Function of NAT,NAT,
      p being Function of NAT,BOOLEAN,
      n,m being Nat st
    n <= m
  holds
    for i being Nat st i < n holds
      p.i = TRUE implies
        (Aux.i < m & p.(Aux.i) = TRUE) &
          Aux.(Aux.i) = i
proof
end;
::$P+
