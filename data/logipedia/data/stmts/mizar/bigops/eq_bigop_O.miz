:: Statement-only formalization of Logipedia corpus artifact
:: bigops.eq_bigop_O (logipedia__mizar__bigops.eq_bigop_O): for every
:: carrier type, the fixed polymorphic big-operation function at natural
:: index zero directionally Leibniz-implies its independently fixed body
:: function at zero. This file contains no proof.

environ
  vocabularies TARSKI, XBOOLE_0, SUBSET_1, RELAT_1, FUNCT_1, FUNCT_2,
    FUNCT_3, PARTFUN1, NAT_1, NUMBERS, CARD_1, ARYTM_1, ARYTM_3,
    ZFMISC_1, MCART_1, WAYBEL_4, CARDFIL2, MARGREL1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, XTUPLE_0, MCART_1, RELAT_1,
    RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3, ORDINAL1, CARD_1,
    NUMBERS, NAT_1, SUBSET_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, PARTFUN1, FUNCT_3,
    NAT_1, ZFMISC_1, MCART_1, XTUPLE_0, CARD_1, SUBSET_1, MARGREL1;
  registrations XBOOLE_0, SUBSET_1, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2,
    PARTFUN1, FUNCT_3, ORDINAL1, CARD_1, NAT_1, XTUPLE_0, MARGREL1;
  theorems FUNCT_2;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM;

begin

:: Mizar has no standalone declaration form for an uninterpreted constant.
:: The projections of one fixed choice-selected pair therefore represent the
:: source module's two independently fixed opaque declarations, bigop and
:: bigop_body. The choice adds no algebraic or computational definition.
definition
  let H be set;
  func Aux(H) -> Function of NAT,
      Funcs(
        Funcs(NAT,BOOLEAN),
        Funcs(H,
          Funcs(
            Funcs(H,Funcs(H,H)),
            Funcs(Funcs(NAT,H),H)
          )
        )
      ) equals
    (pr1(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    );
  coherence
  proof
    set X =
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      );
    A1: X is non empty
    proof
      per cases;
      suppose H = {};
        then reconsider H as empty set;
        set E = Funcs(NAT,H);
        reconsider E as empty set;
        E = H;
        then reconsider C = Funcs(E,H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
      suppose H <> {};
        then reconsider H as non empty set;
        reconsider C = Funcs(Funcs(NAT,H),H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
    end;
    reconsider X as non empty set by A1;
    reconsider p = the Element of [:X,X:] as Element of [:X,X:];
    reconsider f = (pr1(X,X)).p as Element of X;
    f in X;
    hence thesis by FUNCT_2:66;
  end;

  func AuxBottom(H) -> Function of NAT,
      Funcs(
        Funcs(NAT,BOOLEAN),
        Funcs(H,
          Funcs(
            Funcs(H,Funcs(H,H)),
            Funcs(Funcs(NAT,H),H)
          )
        )
      ) equals
    (pr2(
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      ),
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      )
    )).(
      the Element of
        [:Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ),
          Funcs(NAT,
            Funcs(
              Funcs(NAT,BOOLEAN),
              Funcs(H,
                Funcs(
                  Funcs(H,Funcs(H,H)),
                  Funcs(Funcs(NAT,H),H)
                )
              )
            )
          ):]
    );
  coherence
  proof
    set X =
      Funcs(NAT,
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
      );
    A1: X is non empty
    proof
      per cases;
      suppose H = {};
        then reconsider H as empty set;
        set E = Funcs(NAT,H);
        reconsider E as empty set;
        E = H;
        then reconsider C = Funcs(E,H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
      suppose H <> {};
        then reconsider H as non empty set;
        reconsider C = Funcs(Funcs(NAT,H),H) as non empty set;
        reconsider D =
          Funcs(Funcs(H,Funcs(H,H)),C) as non empty set;
        reconsider R = Funcs(H,D) as non empty set;
        reconsider T =
          Funcs(Funcs(NAT,BOOLEAN),R) as non empty set;
        reconsider Y = Funcs(NAT,T) as non empty set;
        X = Y;
        hence thesis;
      end;
    end;
    reconsider X as non empty set by A1;
    reconsider p = the Element of [:X,X:] as Element of [:X,X:];
    reconsider f = (pr2(X,X)).p as Element of X;
    f in X;
    hence thesis by FUNCT_2:66;
  end;
end;

::$P-
theorem
  for H being set,
      P being Subset of
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(
            H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        ) st
    (Aux(H)).0 in P
  holds
    (AuxBottom(H)).0 in P
proof
end;
::$P+
