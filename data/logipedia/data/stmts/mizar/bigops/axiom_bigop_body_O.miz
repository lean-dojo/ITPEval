:: Statement-only formalization of Logipedia corpus artifact
:: bigops.axiom_bigop_body_O, catalog title "bigops.axiom_bigop_body_O":
:: for every carrier type, the fixed polymorphic big-operation body at
:: natural index zero is related by the source module's fixed opaque equality
:: relation to the curried function returning its nil argument. This file
:: contains no proof.

environ
  vocabularies TARSKI, RELAT_1, FUNCT_1, FUNCT_2, NAT_1, NUMBERS, CARD_1,
    ARYTM_1, ARYTM_3, MARGREL1, ZFMISC_1;
  notations TARSKI, XBOOLE_0, ZFMISC_1, RELAT_1, RELSET_1, FUNCT_1,
    FUNCT_2, ORDINAL1, CARD_1, NUMBERS, NAT_1, MARGREL1;
  constructors RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, NAT_1, MARGREL1,
    ZFMISC_1, CARD_1;
  registrations XBOOLE_0, RELAT_1, RELSET_1, FUNCT_1, FUNCT_2, ORDINAL1,
    CARD_1, NAT_1, MARGREL1;
  requirements BOOLE, SUBSET, NUMERALS, ARITHM, REAL;

begin

::$P-
theorem
  for H being set holds ex z being set st
    z in Funcs(
      Funcs(NAT,BOOLEAN),
      Funcs(H,
        Funcs(
          Funcs(H,Funcs(H,H)),
          Funcs(Funcs(NAT,H),H)
        )
      )
    ) &
    (for p,nil,op,f being set st
      p in Funcs(NAT,BOOLEAN) &
      nil in H &
      op in Funcs(H,Funcs(H,H)) &
      f in Funcs(NAT,H)
    holds ex zp,zpn,zpno being set st
      [p,zp] in z &
      [nil,zpn] in zp &
      [op,zpno] in zpn &
      [f,nil] in zpno) &
    [(the Function of NAT,
      Funcs(
        Funcs(NAT,BOOLEAN),
        Funcs(H,
          Funcs(
            Funcs(H,Funcs(H,H)),
            Funcs(Funcs(NAT,H),H)
          )
        )
      )).0,z] in
      the Relation of
        Funcs(
          Funcs(NAT,BOOLEAN),
          Funcs(H,
            Funcs(
              Funcs(H,Funcs(H,H)),
              Funcs(Funcs(NAT,H),H)
            )
          )
        )
proof
end;
::$P+
